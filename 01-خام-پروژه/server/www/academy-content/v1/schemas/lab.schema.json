{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fam-academy-v1/lab",
  "title": "FAM Academy Lab",
  "type": "object",
  "required": [
    "id",
    "title",
    "scenario",
    "objectives",
    "executionMode",
    "realDeviceConnection",
    "topology",
    "addressingTable",
    "equipment",
    "steps",
    "expectedOutput",
    "reviewQuestions",
    "failureScenario",
    "troubleshooting",
    "successCriteria",
    "lessonIds"
  ],
  "properties": {
    "executionMode": {
      "const": "internal-simulator"
    },
    "realDeviceConnection": {
      "const": false
    },
    "steps": {
      "type": "array",
      "minItems": 5
    }
  }
}
