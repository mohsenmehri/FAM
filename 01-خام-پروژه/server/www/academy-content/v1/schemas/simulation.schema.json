{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fam-academy-v1/simulation",
  "title": "FAM Academy Simulation",
  "type": "object",
  "required": [
    "id",
    "title",
    "logic",
    "objective",
    "parameters",
    "steps",
    "limitations",
    "references",
    "diagramPath",
    "lessonIds"
  ],
  "properties": {
    "parameters": {
      "type": "array",
      "minItems": 3
    },
    "steps": {
      "type": "array",
      "minItems": 4
    },
    "logic": {
      "enum": [
        "arpResolve",
        "vlanForward",
        "ospfAdjacency"
      ]
    }
  }
}
