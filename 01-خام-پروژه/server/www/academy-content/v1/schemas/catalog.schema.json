{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fam-academy-v1/catalog",
  "title": "FAM Academy v2 Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentVersion",
    "language",
    "direction",
    "paths",
    "courses",
    "lessons",
    "simulations",
    "labs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "fam-academy-v1"
    },
    "contentVersion": {
      "type": "string"
    },
    "language": {
      "const": "fa"
    },
    "direction": {
      "const": "rtl"
    },
    "paths": {
      "type": "array",
      "minItems": 23
    },
    "courses": {
      "type": "array",
      "minItems": 23
    },
    "lessons": {
      "type": "array",
      "minItems": 10
    },
    "simulations": {
      "type": "array",
      "minItems": 3
    },
    "labs": {
      "type": "array",
      "minItems": 2
    }
  }
}
