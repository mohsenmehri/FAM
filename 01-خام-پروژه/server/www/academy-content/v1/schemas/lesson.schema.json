{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fam-academy-v1/lesson",
  "title": "FAM Academy Lesson",
  "type": "object",
  "required": [
    "id",
    "title",
    "level",
    "durationMinutes",
    "objectives",
    "prerequisites",
    "sections",
    "references",
    "quiz",
    "diagramPath",
    "simulationIds",
    "labIds",
    "exerciseId",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "level": {
      "enum": [
        "پایه",
        "متوسط",
        "پیشرفته"
      ]
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 20
    },
    "objectives": {
      "type": "array",
      "minItems": 3
    },
    "sections": {
      "type": "object",
      "minProperties": 16
    },
    "quiz": {
      "type": "array",
      "minItems": 3
    }
  }
}
