{
  "id": "sim-vlan-trunk",
  "title": "VLAN و Trunk 802.1Q",
  "logic": "vlanForward",
  "objective": "مشاهده اثر VLAN مبدأ/مقصد، Allowed List، Native VLAN و Tag بر تحویل فریم.",
  "lessonIds": [
    "l03-vlan-access-ports",
    "l04-trunk-8021q"
  ],
  "parameters": [
    {
      "id": "sourceVlan",
      "label": "VLAN مبدأ",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 4094
    },
    {
      "id": "destinationVlan",
      "label": "VLAN مقصد",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 4094
    },
    {
      "id": "trunkAllowed",
      "label": "VLANهای مجاز",
      "type": "text",
      "default": "10,20,99"
    },
    {
      "id": "nativeVlan",
      "label": "Native VLAN سر مبدأ",
      "type": "number",
      "default": 99,
      "min": 1,
      "max": 4094
    },
    {
      "id": "remoteNativeVlan",
      "label": "Native VLAN سر مقصد",
      "type": "number",
      "default": 99,
      "min": 1,
      "max": 4094
    },
    {
      "id": "tagNative",
      "label": "Tag کردن Native VLAN",
      "type": "checkbox",
      "default": false
    }
  ],
  "steps": [
    "دریافت فریم از پورت Access",
    "بررسی Allowed List",
    "تصمیم Tag/Untagged",
    "عبور از Trunk",
    "تحویل در VLAN مقصد"
  ],
  "limitations": [
    "فقط یک لینک Trunk و یک Broadcast Domain مدل شده؛ STP، DTP و VTP مدل نشدهاند.",
    "Inter-VLAN Routing بهعنوان نیاز خارجی گزارش میشود، ولی پیادهسازی نشده است."
  ],
