{
  "id": "sim-arp-discovery",
  "title": "ARP و فرایند کشف MAC",
  "logic": "arpResolve",
  "objective": "نشان دادن تفاوت مقصد محلی/remote، اثر Cache و ساخت Ethernet Frame.",
  "lessonIds": [
    "l01-osi-tcpip-encapsulation",
    "l02-ethernet-arp"
  ],
  "parameters": [
    {
      "id": "sourceIp",
      "label": "IP مبدأ",
      "type": "text",
      "default": "192.0.2.10"
    },
    {
      "id": "targetIp",
      "label": "IP مقصد",
      "type": "text",
      "default": "192.0.2.20"
    },
    {
      "id": "mask",
      "label": "Prefix طول",
      "type": "number",
      "default": 24,
      "min": 8,
      "max": 30
    },
    {
      "id": "gatewayIp",
      "label": "Default Gateway",
      "type": "text",
      "default": "192.0.2.1"
    },
    {
      "id": "cacheHit",
      "label": "ورودی از قبل در Cache",
      "type": "checkbox",
      "default": false
    },
    {
      "id": "vlanId",
      "label": "VLAN",
      "type": "number",
      "default": 10,
      "min": 1,
      "max": 4094
    }
  ],
  "steps": [
    "بررسی سابنت",
    "تصمیم مقصد ARP",
    "ارسال درخواست یا استفاده از Cache",
    "دریافت پاسخ",
    "ساخت Frame نهایی"
  ],
  "limitations": [
    "مدل ساده /8 تا /30 IPv4؛ Proxy ARP، Gratuitous ARP و VLAN ACL مدل نشدهاند.",
    "MACها و زمانها نمونهاند و خروجی واقعی دستگاه نیستند."
  ],
  "references": [
    "RFC826",
    "IEEE8023",
    "RFC4861"
  ],
  "schemaVersion": "fam-academy-v1",
  "status": "live",
