{
  "schemaVersion": "1.0",
  "paths": [
    {
      "id": "ccna",
      "code": "200-301",
      "title": "CCNA — Cisco Certified Network Associate",
      "level": "Associate",
      "estimatedHours": 45,
      "description": "مسیر جامع شبکه از مبانی تا Switching، Routing، امنیت پایه و اتوماسیون.",
      "courses": [
        {
          "id": "ccna-net-fund",
          "title": "1. Network Fundamentals",
          "lessons": [
            {
              "id": "ccna-osi-tcpip",
              "title": "مدل‌های OSI و TCP/IP و کپسوله‌سازی",
              "blueprint": "/academy-assets/blueprint-osi-tcpip.json",
              "prerequisites": []
            },
            {
              "id": "ccna-ipv4-subnet",
              "title": "آدرس‌دهی IPv4 و Subnetting",
              "blueprint": "/academy-assets/blueprint-ipv4-subnet.json",
              "prerequisites": [
                "ccna-osi-tcpip"
              ]
            }
          ]
        },
        {
          "id": "ccna-net-access",
          "title": "2. Network Access (Switching)",
          "lessons": [
            {
              "id": "ccna-vlan-l2-01",
              "title": "مبانی VLAN و جداسازی Broadcast Domain",
              "blueprint": "/academy-assets/blueprint-vlan-l2.json",
              "prerequisites": [
                "ccna-osi-tcpip"
              ]
            },
            {
              "id": "ccna-trunk-8021q",
              "title": "Trunking و تگ‌گذاری 802.1Q",
              "blueprint": "/academy-assets/blueprint-trunk-8021q.json",
              "prerequisites": [
                "ccna-vlan-l2-01"
              ]
            },
            {
              "id": "ccna-stp-rstp",
              "title": "STP / RSTP و جلوگیری از Loop",
              "blueprint": "/academy-assets/blueprint-stp-rstp.json",
              "prerequisites": [
                "ccna-trunk-8021q"
              ]
            }
          ]
        },
        {
          "id": "ccna-ip-conn",
          "title": "3. IP Connectivity (Routing)",
          "lessons": [
            {
              "id": "ccna-static-routing",
              "title": "مسیریابی استاتیک و Default Route",
              "blueprint": "/academy-assets/blueprint-static-routing.json",
              "prerequisites": [
                "ccna-ipv4-subnet"
              ]
            },
            {
              "id": "ccna-ospfv2",
              "title": "OSPFv2 تک‌ناحیه‌ای",
              "blueprint": "/academy-assets/blueprint-ospfv2.json",
              "prerequisites": [
                "ccna-static-routing"
              ]
            }
          ]
        },
        {
          "id": "ccna-ip-svc",
          "title": "4. IP Services",
          "lessons": [
            {
              "id": "ccna-nat-pat",
              "title": "NAT و PAT Overload",
              "blueprint": "/academy-assets/blueprint-nat-pat.json",
              "prerequisites": [
                "ccna-static-routing"
              ]
            },
            {
              "id": "ccna-dhcp-ntp",
              "title": "DHCP Server/Relay و NTP",
              "blueprint": "/academy-assets/blueprint-dhcp-ntp.json",
              "prerequisites": [
                "ccna-ipv4-subnet",
                "ccna-vlan-l2-01"
              ]
            }
          ]
        },
        {
          "id": "ccna-sec-fund",
          "title": "5. Security Fundamentals",
          "lessons": [
            {
              "id": "ccna-acl",
              "title": "Standard و Extended ACL",
              "blueprint": "/academy-assets/blueprint-acl.json",
              "prerequisites": [
                "ccna-static-routing"
              ]
            },
            {
              "id": "ccna-port-sec",
              "title": "Port Security و DHCP Snooping",
              "blueprint": "/academy-assets/blueprint-port-sec.json",
              "prerequisites": [
                "ccna-vlan-l2-01"
              ]
            }
          ]
        },
        {
          "id": "ccna-auto",
          "title": "6. Automation & Programmability",
          "lessons": [
            {
              "id": "ccna-rest-json",
              "title": "REST API، JSON و مدل‌های SDN",
              "blueprint": "/academy-assets/blueprint-rest-json.json",
              "prerequisites": [
                "ccna-osi-tcpip",
                "ccna-ipv4-subnet"
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "ccnp-enterprise",
      "code": "ENCOR + ENARSI",
      "title": "CCNP Enterprise",
      "level": "Professional",
      "estimatedHours": 80,
      "description": "شامل آزمون هسته (ENCOR 350-401) و گرایش تخصصی مسیریابی پیشرفته (ENARSI 300-410).",
      "courses": [
        {
          "id": "encor-core",
          "title": "ENCOR (350-401) — Implementing Cisco Enterprise Network Core",
          "lessons": [
            {
              "id": "encor-arch",
              "title": "معماری شبکه سازمانی (Three-Tier, Spine-Leaf, SD-Access)",
              "blueprint": "/academy-assets/blueprint-encor-arch.json",
              "prerequisites": [
                "ccna-stp-rstp",
                "ccna-ospfv2",
                "ccna-rest-json"
              ]
            },
            {
              "id": "encor-bgp-ospf",
              "title": "OSPF Multi-Area و eBGP/iBGP",
              "blueprint": "/academy-assets/blueprint-encor-bgp-ospf.json",
              "prerequisites": [
                "ccna-ospfv2"
              ]
            }
          ]
        },
        {
          "id": "enarsi-spec",
          "title": "ENARSI (300-410) — Advanced Routing & Services (Concentration)",
          "lessons": [
            {
              "id": "enarsi-redist",
              "title": "Route Redistribution و Route-Maps",
              "blueprint": "/academy-assets/blueprint-enarsi-redist.json",
              "prerequisites": [
                "encor-bgp-ospf"
              ]
            },
            {
              "id": "enarsi-vpn-dmvpn",
              "title": "شبکه‌های امن WAN: IPsec VPN و DMVPN",
              "blueprint": "/academy-assets/blueprint-enarsi-vpn-dmvpn.json",
              "prerequisites": [
                "encor-bgp-ospf",
                "ccna-nat-pat"
              ]
            }
          ]
        }
      ]
    }
  ]
}
