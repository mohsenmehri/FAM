  <script id="fam-academy-fam-bridge" nonce="__FAM_CSP_NONCE__">
    window.FAM_ACADEMY_BOOTSTRAP = __FAM_ACADEMY_BOOTSTRAP__;
    (() => {
      'use strict';
      const boot = window.FAM_ACADEMY_BOOTSTRAP || {};
      const csrf = boot.csrf || '';
      window.FamAcademyBridge = {
        user: boot.user || null,
        progress: boot.progress || { completed: [], labs: {} },
        async saveProgress(payload) {
          try {
            await fetch('/api/academy/progress', {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json', 'X-FAM-CSRF': csrf },
              body: JSON.stringify(payload)
            });
          } catch (e) {}
        }
      };
    })();
  </script>
  <style nonce="__FAM_CSP_NONCE__">
    :root {
      --bg: #0b101b; --panel: #121a2b; --panel2: #182338; --border: #25334d;
      --text: #e6edf7; --muted: #93a4c3; --accent: #38bdf8; --accent2: #a78bfa;
      --ok: #22c55e; --warn: #f59e0b; --err: #ef4444;
      --font: system-ui, -apple-system, "Segoe UI", Tahoma, sans-serif;
      --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }
    html[data-theme="light"] {
      --bg: #f4f7fb; --panel: #ffffff; --panel2: #eef3f9; --border: #d5dfec;
      --text: #0f172a; --muted: #475569; --accent: #0284c7; --accent2: #7c3aed;
    }
    * { box-sizing: border-box; }
    body { margin: 0; font-family: var(--font); background: var(--bg); color: var(--text); line-height: 1.65; }
    button { font-family: inherit; cursor: pointer; }
    .topbar {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 12px 20px; background: var(--panel); border-bottom: 1px solid var(--border);
      position: sticky; top: 0; z-index: 20;
    }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 16px; }
    .badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: var(--panel2); border: 1px solid var(--border); color: var(--accent); }
    .badge-ok { color: var(--ok); border-color: var(--ok); }
    .nav-actions { display: flex; align-items: center; gap: 8px; }
    .btn {
      padding: 7px 13px; border-radius: 8px; border: 1px solid var(--border);
      background: var(--panel2); color: var(--text); font-size: 13px; transition: .15s;
    }
    .btn:hover { border-color: var(--accent); }
    .btn-primary { background: var(--accent); color: #06121e; border-color: var(--accent); font-weight: 600; }
    .container { max-width: 1260px; margin: 0 auto; padding: 24px 20px 60px; }
    .hero h1 { margin: 0 0 6px; font-size: 24px; }
    .hero p { margin: 0; color: var(--muted); font-size: 14px; }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 22px; }
    .chip {
      padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border);
      background: var(--panel); color: var(--muted); font-size: 12px;
    }
    .chip.active { background: var(--accent); color: #06121e; border-color: var(--accent); font-weight: 600; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
    .card {
      background: var(--panel); border: 1px solid var(--border); border-radius: 12px;
      padding: 18px; display: flex; flex-direction: column; gap: 10px;
    }
    .card-meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); }
    .card h3 { margin: 0; font-size: 17px; }
    .card p { margin: 0; font-size: 13px; color: var(--muted); flex: 1; }
    .progress-bar { height: 6px; background: var(--panel2); border-radius: 999px; overflow: hidden; }
    .progress-fill { height: 100%; background: var(--ok); width: 0%; transition: width .3s; }
    .course-box { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; margin-bottom: 16px; overflow: hidden; }
    .course-head { padding: 14px 18px; background: var(--panel2); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
    .lesson-row { padding: 12px 18px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .lesson-row:last-child { border-bottom: 0; }
    .lesson-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 10px; }
    .split { display: grid; grid-template-columns: 1fr 360px; gap: 16px; }
    @media (max-width: 960px) { .split { grid-template-columns: 1fr; } }
    .canvas-box { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
    .step-item {
      padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border);
      background: var(--panel); text-align: right; color: var(--text); font-size: 13px; width: 100%;
    }
    .step-item.active { border-color: var(--accent); background: var(--panel2); }
    .terminal {
      background: #06090f; color: #e2e8f0; font-family: var(--mono); font-size: 13px;
      border-radius: 10px; border: 1px solid var(--border); padding: 14px;
      height: 360px; display: flex; flex-direction: column; direction: ltr; text-align: left;
    }
    .term-out { flex: 1; overflow-y: auto; white-space: pre-wrap; margin-bottom: 8px; }
    .term-in { display: flex; align-items: center; gap: 6px; border-top: 1px solid #1e293b; padding-top: 8px; }
    .term-in input { flex: 1; background: transparent; border: 0; outline: 0; color: #38bdf8; font-family: var(--mono); font-size: 13px; }
    .task-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; background: var(--panel2); margin-bottom: 8px; font-size: 13px; }
    .task-item.done { border: 1px solid var(--ok); color: var(--ok); }
    .sec-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .code-inline { font-family: var(--mono); background: var(--panel2); padding: 2px 6px; border-radius: 4px; font-size: 12px; direction: ltr; display: inline-block; }
  </style>
