        id: 'ccnp-cyber', category: 'ccnp', level: 'مرحله ۳ · CCNP',
        title: 'CCNP Cybersecurity — دفاع سایبری و SOC',
        desc: 'Threat Hunting، Incident Response، SIEM، تحلیل بدافزار و NDR.',
        courses: []
      },
      {
        id: 'ccie-expert', category: 'ccie', level: 'مرحله ۴ · Expert',
        title: 'سطح Expert — مدارک CCIE و CCDE',
        desc: 'طراحی، پیاده‌سازی و عیب‌یابی شبکه‌های پیچیده: CCIE Enterprise، Security، Data Center، SP، Wireless و CCDE.',
        courses: []
      },
      {
        id: 'net-architect', category: 'architect', level: 'مرحله ۵ · Architect',
        title: 'مهندس ارشد و Network Architect',
        desc: 'معماری شبکه‌های بانکی و اپراتوری، SDN/SD-WAN، Cloud (AWS/Azure/GCP)، Kubernetes، Zero Trust و Observability.',
        courses: []
      },
      {
        id: 'cisco-platforms', category: 'platforms', level: 'مرحله ۶ · تکمیلی',
        title: 'پلتفرم‌های تکمیلی سیسکو',
        desc: 'Cisco Catalyst Center (DNA)، Cisco SD-WAN (Viptela)، Cisco ACI، Meraki، ThousandEyes و Cisco ISE.',
        courses: []
      }
    ];

    const state = {
      view: 'paths',
      filter: 'all',
      pathId: null,
      lessonId: null,
      tab: 'visual',
      stepIdx: 0,
      playing: false,
      timer: null,
      completed: new Set((window.FamAcademyBridge?.progress?.completed) || []),
      labDone: new Set(),
      termLines: ['Cisco IOS Simulator — Type "help" for supported commands.'],
      priv: false,
      conf: false
    };

    const root = document.getElementById('app-root');
    document.getElementById('btn-back-paths').onclick = () => { stopPlay(); state.view = 'paths'; render(); };

    function markComplete(id) {
      if (!state.completed.has(id)) {
        state.completed.add(id);
        window.FamAcademyBridge?.saveProgress([...state.completed]);
      }
    }

    function stopPlay() {
      state.playing = false;
      if (state.timer) { clearInterval(state.timer); state.timer = null; }
    }

    function render() {
      if (state.view === 'paths') return renderPaths();
      if (state.view === 'path') return renderPathDetail();
      if (state.view === 'lesson') return renderLesson();
    }

    function renderPaths() {
      const list = PATHS.filter(p => state.filter === 'all' || p.category === state.filter);
      root.innerHTML = `
        <section class="hero">
          <h1>مسیرهای یادگیری سیسکو</h1>
          <p>آموزش کامل CCNA و CCNP (OSPF، EIGRP، BGP، امنیت و دیتاسنتر) همراه با ماژول بصری و آزمایشگاه CLI</p>
        </section>
        <div class="filters">
          ${[['all','همهٔ مراحل'],['foundation','۱. مبانی زیرساخت'],['ccna','۲. CCNA'],['ccnp','۳. شاخه‌های CCNP'],['ccie','۴. CCIE / Expert'],['architect','۵. معمار شبکه'],['platforms','۶. پلتفرم‌های سیسکو']].map(([k,l]) =>
            `<button class="chip ${state.filter===k?'active':''}" data-filter="${k}">${l}</button>`).join('')}
        </div>
        <div class="grid">
          ${list.map(p => {
            const total = p.courses.reduce((a,c)=>a+c.lessons.length,0) || 1;
            const done = p.courses.reduce((a,c)=>a+c.lessons.filter(l=>state.completed.has(l.id)).length,0);
            const pct = Math.round((done/total)*100);
            return `<article class="card">
              <div class="card-meta"><span>${p.level}</span><span>${p.courses.length} دوره</span></div>
              <h3>${p.title}</h3>
              <p>${p.desc}</p>
              <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>
              <button class="btn btn-primary" data-open-path="${p.id}">ورود به مسیر (${pct}%)</button>
            </article>`;
          }).join('')}
        </div>`;
      root.querySelectorAll('[data-filter]').forEach(b => b.onclick = () => { state.filter = b.dataset.filter; render(); });
      root.querySelectorAll('[data-open-path]').forEach(b => b.onclick = () => { state.pathId = b.dataset.openPath; state.view = 'path'; render(); });
    }

    function renderPathDetail() {
      const p = PATHS.find(x => x.id === state.pathId);
      if (!p) { state.view = 'paths'; return render(); }
      root.innerHTML = `
        <section class="hero">
          <h1>${p.title}</h1>
          <p>${p.desc}</p>
        </section>
        ${p.courses.length === 0 ? '<div class="card"><p>سرفصل‌های این مسیر در حال تکمیل است.</p></div>' :
          p.courses.map(c => `
            <div class="course-box">
              <div class="course-head"><strong>${c.title}</strong><span class="badge">${c.lessons.length} درس</span></div>
              ${c.lessons.map(l => `
                <div class="lesson-row">
                  <div>
                    <strong>${l.title}</strong>
                    <div style="font-size:12px;color:var(--muted)">${l.duration} ${state.completed.has(l.id)?'· ✅ تکمیل‌شده':''}</div>
                  </div>
                  <button class="btn btn-primary" data-open-lesson="${l.id}">شروع درس</button>
                </div>
              `).join('')}
            </div>`).join('')}`;
      root.querySelectorAll('[data-open-lesson]').forEach(b => b.onclick = () => {
        state.lessonId = b.dataset.openLesson; state.view = 'lesson'; state.tab = 'visual';
        state.stepIdx = 0; state.labDone = new Set(); state.priv = false; state.conf = false;
        stopPlay(); render();
      });
    }

    function runIosCommand(host, cmd) {
      if (/^help$/i.test(cmd)) return 'Commands: enable, conf t, end, show ip interface brief, show ip route, show vlan brief, show spanning-tree, show ip ospf neighbor, show ip eigrp neighbors, show ip bgp summary, show port-security, ping 10.4.86.1, clear';
      if (/^en(able)?$/i.test(cmd)) { state.priv = true; return ''; }
      if (/^conf(igure)?\s+t(erminal)?$/i.test(cmd)) { if (!state.priv) return '% Invalid input'; state.conf = true; return 'Enter configuration commands, one per line. End with CNTL/Z.'; }
      if (/^(end|exit)$/i.test(cmd)) { if (state.conf) { state.conf = false; return ''; } state.priv = false; return ''; }
      if (/^sh(ow)?\s+ip\s+int(erface)?\s+br(ief)?$/i.test(cmd)) return 'Interface              IP-Address      OK? Method Status                Protocol\nVlan100                10.4.86.2       YES NVRAM  up                    up\nGigabitEthernet0/1     192.168.190.134 YES NVRAM  up                    up';
      if (/^sh(ow)?\s+ip\s+route$/i.test(cmd)) return 'Codes: C - connected, O - OSPF, D - EIGRP, B - BGP\nC    10.4.86.0/26 is directly connected, GigabitEthernet0/0\nO    10.2.15.0/26 [110/2] via 192.168.190.141, 00:12:04, GigabitEthernet0/1';
      if (/^sh(ow)?\s+vlan\s+br(ief)?$/i.test(cmd)) return 'VLAN Name                             Status    Ports\n1    default                          active    Gi0/2, Gi0/3\n100  BRANCH-DATA                      active    Gi0/0, Gi0/1';
      if (/^sh(ow)?\s+spanning-tree/i.test(cmd)) return 'VLAN0100\n  Root ID    Priority 24676\n  Bridge ID  Priority 32868\n  Gi1/3      Root FWD 4 128.4';
      if (/^sh(ow)?\s+ip\s+ospf\s+nei(ghbor)?$/i.test(cmd)) return 'Neighbor ID     Pri   State           Dead Time   Address         Interface\n192.168.190.141   1   FULL/DR         00:00:34    192.168.190.141 Gi0/1';
      if (/^sh(ow)?\s+ip\s+eigrp\s+nei(ghbors)?$/i.test(cmd)) return 'H   Address         Interface       Hold Uptime   SRTT   RTO  Q  Seq\n0   192.168.190.141 Gi0/1           12   01:05:22 12     100  0  42';
      if (/^sh(ow)?\s+ip\s+bgp\s+sum(mary)?$/i.test(cmd)) return 'Neighbor        V    AS MsgRcvd MsgSent   TblVer  InQ OutQ Up/Down  State/PfxRcd\n192.168.190.141 4 65215     120     118        4    0    0 01:10:05        3';
      if (/^sh(ow)?\s+port-security/i.test(cmd)) return 'Secure Port  MaxSecureAddr  CurrentAddr  SecurityViolation  Security Action\nGi0/0        2              1            0                  Shutdown';
      if (/^ping\s+10\.4\.86\.1$/i.test(cmd)) return 'Sending 5, 100-byte ICMP Echos to 10.4.86.1:\n!!!!!\nSuccess rate is 100 percent (5/5), round-trip min/avg/max = 1/2/3 ms';
      return '% Invalid input detected at "^" marker.';
    }

    function renderLesson() {
      const p = PATHS.find(x => x.id === state.pathId);
      const lesson = p?.courses.flatMap(c => c.lessons).find(l => l.id === state.lessonId);
      if (!lesson) { state.view = 'path'; return render(); }
      const step = lesson.steps[state.stepIdx];

      root.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px;">
          <h2 style="margin:0;font-size:20px">${lesson.title}</h2>
          <button class="btn" id="btn-back-path">بازگشت به سرفصل</button>
        </div>
        <div class="lesson-tabs">
          <button class="chip ${state.tab==='visual'?'active':''}" data-tab="visual">۱. ماژول بصری</button>
          <button class="chip ${state.tab==='lab'?'active':''}" data-tab="lab">۲. آزمایشگاه CLI</button>
          <button class="chip ${state.tab==='quiz'?'active':''}" data-tab="quiz">۳. آزمون</button>
        </div>
        <div id="tab-body"></div>`;

      document.getElementById('btn-back-path').onclick = () => { stopPlay(); state.view = 'path'; render(); };
      root.querySelectorAll('[data-tab]').forEach(b => b.onclick = () => { stopPlay(); state.tab = b.dataset.tab; render(); });

      const body = document.getElementById('tab-body');
      if (state.tab === 'visual') {
        body.innerHTML = `
          <div class="split">
            <div class="canvas-box">
              <div class="canvas-controls">
                <div>
                  <button class="btn btn-primary" id="v-play">${state.playing?'توقف':'پخش خودکار'}</button>
                  <button class="btn" id="v-replay">شروع مجدد</button>
                </div>
                <span class="badge">گام ${state.stepIdx+1} از ${lesson.steps.length} · ${step.hop} (${step.ms})</span>
              </div>
              <svg viewBox="0 0 850 240" style="width:100%;height:auto;background:#070b14;border-radius:10px;border:1px solid var(--border)">
                <line x1="90" y1="120" x2="760" y2="120" stroke="#334155" stroke-width="4" stroke-dasharray="6 6"/>
                ${lesson.steps.map((s,i)=>`
                  <g>
                    <circle cx="${s.x}" cy="${s.y}" r="24" fill="${i===state.stepIdx?'#0ea5e9':'#1e293b'}" stroke="#38bdf8" stroke-width="2"/>
                    <text x="${s.x}" y="${s.y+45}" fill="#cbd5e1" font-size="12" text-anchor="middle">${s.hop}</text>
                  </g>`).join('')}
                <circle cx="${step.x}" cy="${step.y}" r="10" fill="#22c55e">
                  <animate attributeName="r" values="8;13;8" dur="1.2s" repeatCount="indefinite"/>
                </circle>
              </svg>
              <p style="margin:12px 0 0;font-size:14px">${step.desc}</p>
            </div>
            <div class="step-list">
              ${lesson.steps.map((s,i)=>`
                <button class="step-item ${i===state.stepIdx?'active':''}" data-step="${i}">
                  <strong>${s.title}</strong>
                  <small>${s.hop} · ${s.ms}</small>
                </button>`).join('')}
            </div>
          </div>`;
        document.getElementById('v-replay').onclick = () => { stopPlay(); state.stepIdx = 0; render(); };
        document.getElementById('v-play').onclick = () => {
          if (state.playing) { stopPlay(); render(); return; }
          state.playing = true;
          state.timer = setInterval(() => {
            if (state.stepIdx < lesson.steps.length - 1) { state.stepIdx++; render(); }
            else { stopPlay(); render(); }
          }, 1800);
          render();
        };
        body.querySelectorAll('[data-step]').forEach(b => b.onclick = () => { stopPlay(); state.stepIdx = Number(b.dataset.step); render(); });
      } else if (state.tab === 'lab') {
        const host = lesson.lab.host || 'Router';
        const prompt = state.conf ? `${host}(config)#` : (state.priv ? `${host}#` : `${host}>`);
        body.innerHTML = `
          <div class="split">
            <div class="terminal">
              <div class="term-out">${state.termLines.join('\n')}</div>
              <div class="term-in">
                <span>${prompt}</span>
                <input id="term-cmd" autocomplete="off" placeholder="Type command (help for list)">
              </div>
            </div>
            <div class="canvas-box">
              <h3 style="margin-top:0">وظایف آزمایشگاه</h3>
              ${lesson.lab.tasks.map(t => `<div class="task-item ${state.labDone.has(t.id)?'done':''}">${state.labDone.has(t.id)?'✅':'⬜'} ${t.label}</div>`).join('')}
            </div>
          </div>`;
        const inp = document.getElementById('term-cmd');
        inp.focus();
        inp.onkeydown = (e) => {
          if (e.key !== 'Enter') return;
          const cmd = inp.value.trim();
          if (!cmd) return;
          state.termLines.push(`${prompt} ${cmd}`);
          if (/^clear$/i.test(cmd)) { state.termLines = []; }
          else {
            const out = runIosCommand(host, cmd);
            if (out) state.termLines.push(out);
          }
          lesson.lab.tasks.forEach(t => { if (t.match.test(cmd)) state.labDone.add(t.id); });
          if (state.labDone.size === lesson.lab.tasks.length) markComplete(lesson.id);
          render();
        };
      } else if (state.tab === 'quiz') {
        body.innerHTML = `
          <div class="canvas-box">
            <h3>${lesson.quiz.q}</h3>
            <div style="display:flex;flex-direction:column;gap:8px;margin-top:12px">
              ${lesson.quiz.options.map((o,i)=>`<button class="step-item" data-ans="${i}">${o}</button>`).join('')}
            </div>
            <p id="quiz-msg" style="margin-top:12px;font-weight:600"></p>
          </div>`;
        body.querySelectorAll('[data-ans]').forEach(b => b.onclick = () => {
          const ok = Number(b.dataset.ans) === lesson.quiz.answer;
          const msg = document.getElementById('quiz-msg');
          msg.textContent = ok ? '✅ درست است! درس تکمیل شد.' : '❌ نادرست است؛ دوباره تلاش کنید.';
          msg.style.color = ok ? 'var(--ok)' : 'var(--err)';
          if (ok) markComplete(lesson.id);
        });
      }
    }

    document.addEventListener('keydown', (e) => {
      if (state.view !== 'lesson' || state.tab !== 'visual') return;
      const p = PATHS.find(x => x.id === state.pathId);
      const lesson = p?.courses.flatMap(c => c.lessons).find(l => l.id === state.lessonId);
      if (!lesson) return;
      if (e.key === 'ArrowDown' && state.stepIdx < lesson.steps.length - 1) { stopPlay(); state.stepIdx++; render(); }
      if (e.key === 'ArrowUp' && state.stepIdx > 0) { stopPlay(); state.stepIdx--; render(); }
      if (e.key === 'Escape') { stopPlay(); state.view = 'path'; render(); }
    });

    render();
  })();
  </script>
</body>
</html>
