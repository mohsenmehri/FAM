u0631\u0631\u0633\u06CC \u06A9\u0646."]}],debug:["\u0646\u0634\u0627\u0646\u0647\u060C \u0632\u0645\u0627\u0646 \u0648 \u062F\u0627\u0645\u0646\u0647 \u0627\u062B\u0631 \u0631\u0627 \u062B\u0628\u062A \u06A9\u0646.","\u0645\u062F\u0644\u060C \u0646\u0633\u062E\u0647\u060C \u0631\u0627\u0628\u0637\u060C VLAN \u0648 \u0645\u0633\u06CC\u0631 \u062F\u0633\u062A\u0631\u0633\u06CC \u0631\u0627 \u0628\u0627 \u0645\u0648\u062C\u0648\u062F\u06CC \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646.","\u0648\u0636\u0639\u06CC\u062A \u067E\u0648\u0631\u062A\u060C \u062C\u062F\u0648\u0644 MAC \u0648 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u0641\u0642\u0637\u200C\u062E\u0648\u0627\u0646\u062F\u0646\u06CC \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646.","\u0628\u0627 \u06CC\u06A9 \u0641\u0631\u0636\u06CC\u0647 \u0645\u0634\u062E\u0635\u060C \u0631\u0641\u062A \u0648 \u0628\u0631\u06AF\u0634\u062A \u0648 \u0633\u0631\u0648\u06CC\u0633 \u0631\u0627 \u062C\u062F\u0627\u06AF\u0627\u0646\u0647 \u0622\u0632\u0645\u0627\u06CC\u0634 \u06A9\u0646.","\u067E\u06CC\u0634 \u0627\u0632 \u0647\u0631 \u062A\u063A\u06CC\u06CC\u0631\u060C \u062A\u0623\u06CC\u06CC\u062F\u060C \u0646\u0633\u062E\u0647 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u060C \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0627\u0632\u06AF\u0634\u062A \u0648 \u067E\u0646\u062C\u0631\u0647 \u0645\u0646\u0627\u0633\u0628 \u0628\u06AF\u06CC\u0631.","\u067E\u0633 \u0627\u0632 \u0627\u0642\u062F\u0627\u0645\u060C \u0622\u0632\u0645\u0627\u06CC\u0634 \u0631\u0627 \u062A\u06A9\u0631\u0627\u0631 \u0648 \u0639\u062F\u0645 \u0642\u0637\u0639\u06CC\u062A \u0648 \u0646\u062A\u06CC\u062C\u0647 \u0631\u0627 \u062B\u0628\u062A \u06A9\u0646."],scenarios:[{q:"\u067E\u0648\u0631\u062A err-disabled \u0627\u0633\u062A\u061B \u0622\u06CC\u0627 \u0641\u0648\u0631\u0627\u064B \u0622\u0646 \u0631\u0627 \u0628\u0627\u0632 \u06A9\u0646\u0645\u061F",a:"\u062E\u06CC\u0631. \u0639\u0644\u062A\u060C \u0645\u062E\u0627\u0637\u0631\u0647 \u062A\u06A9\u0631\u0627\u0631 \u0648 \u0627\u062B\u0631 \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. \u0628\u0627\u0632\u06CC\u0627\u0628\u06CC \u0645\u062D\u062F\u0648\u062F FAM \u0641\u0642\u0637 \u0628\u0627 \u0645\u062C\u0648\u0632\u060C \u0628\u0631\u0631\u0633\u06CC \u062A\u0627\u0632\u0647 \u0648 \u062A\u0623\u06CC\u06CC\u062F \u0627\u0646\u0633\u0627\u0646 \u0642\u0627\u0628\u0644 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0627\u0633\u062A."},{q:"DAI \u06CC\u06A9 \u0631\u062F \u0642\u062F\u06CC\u0645\u06CC \u0628\u0631\u0627\u06CC MAC \u06A9\u0627\u0631\u0628\u0631 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F\u061B \u0622\u06CC\u0627 \u06A9\u0627\u0631\u0628\u0631 \u062D\u062A\u0645\u0627\u064B \u062C\u0627\u0628\u0647\u200C\u062C\u0627 \u0634\u062F\u0647 \u0627\u0633\u062A\u061F",a:"\u062E\u06CC\u0631. \u0632\u0645\u0627\u0646 \u0648 \u0645\u0646\u0627\u0628\u0639 \u062F\u06CC\u06AF\u0631 \u0645\u062B\u0644 \u062C\u062F\u0648\u0644 MAC \u0648 binding \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u061B \u0644\u0627\u06AF \u062A\u0627\u0631\u06CC\u062E\u06CC \u0628\u0647 \u062A\u0646\u0647\u0627\u06CC\u06CC \u062C\u0627\u0628\u0647\u200C\u062C\u0627\u06CC\u06CC \u0631\u0627 \u062B\u0627\u0628\u062A \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F."},{q:"\u0645\u062F\u0644 \u0645\u062D\u0644\u06CC \u06CC\u06A9 \u062F\u0633\u062A\u0648\u0631 \u067E\u06CC\u0634\u0646\u0647\u0627\u062F \u062F\u0627\u062F\u0647\u061B \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062E\u0648\u062F\u06A9\u0627\u0631 \u0627\u062C\u0631\u0627 \u0634\u0648\u062F\u061F",a:"\u062E\u06CC\u0631. \u0645\u062F\u0644 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0627\u0634\u062A\u0628\u0627\u0647 \u06A9\u0646\u062F. \u067E\u06CC\u0634\u0646\u0647\u0627\u062F \u0628\u0627\u06CC\u062F \u0628\u0627 \u0646\u0633\u062E\u0647 \u062A\u062C\u0647\u06CC\u0632 \u0648 \u0634\u0648\u0627\u0647\u062F \u0648\u0627\u0642\u0639\u06CC \u0648 \u0633\u06CC\u062