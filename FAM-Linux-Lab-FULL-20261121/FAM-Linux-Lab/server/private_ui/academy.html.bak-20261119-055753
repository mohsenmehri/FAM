u0646 \u062D\u0644\u0642\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F. Successor \u0645\u0633\u06CC\u0631 \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647 \u0648 Feasible Successor \u0645\u0633\u06CC\u0631 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0634\u0631\u0637 \u0627\u0645\u06A9\u0627\u0646\u200C\u067E\u0630\u06CC\u0631\u06CC \u0631\u0627 \u0628\u0631\u0622\u0648\u0631\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0648\u062C\u0648\u062F \u0686\u0646\u06CC\u0646 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0628\u0631\u0627\u06CC \u0647\u0631 \u0645\u0642\u0635\u062F \u062A\u0636\u0645\u06CC\u0646\u200C\u0634\u062F\u0647 \u0646\u06CC\u0633\u062A.","\u0628\u0631\u0627\u06CC \u06CC\u06A9 \u0645\u0642\u0635\u062F\u060C Reported Distance \u06CC\u0627 RD \u0641\u0627\u0635\u0644\u0647 \u0627\u0639\u0644\u0627\u0645\u06CC \u0647\u0645\u0633\u0627\u06CC\u0647 \u0648 Feasible Distance \u06CC\u0627 FD \u0645\u0642\u062F\u0627\u0631 \u0645\u0631\u062C\u0639 \u062B\u0628\u062A\u200C\u0634\u062F\u0647 DUAL \u0627\u0633\u062A. \u0627\u06AF\u0631 RD \u0647\u0645\u0633\u0627\u06CC\u0647 \u0627\u0632 FD \u06A9\u0645\u062A\u0631 \u0628\u0627\u0634\u062F\u060C \u0622\u0646 \u0647\u0645\u0633\u0627\u06CC\u0647 \u0634\u0631\u0637 \u0644\u0627\u0632\u0645 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0631\u0627 \u062F\u0627\u0631\u062F. \u0646\u0628\u0648\u062F \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0628\u0647\u200C\u0645\u0639\u0646\u0627\u06CC \u062D\u0644\u0642\u0647\u200C\u062F\u0627\u0631 \u0628\u0648\u062F\u0646 \u0642\u0637\u0639\u06CC \u0622\u0646 \u0645\u0633\u06CC\u0631 \u0646\u06CC\u0633\u062A\u061B \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0634\u0631\u0637 \u06A9\u0627\u0641\u06CC \u0645\u062D\u0627\u0641\u0638\u0647\u200C\u06A9\u0627\u0631\u0627\u0646\u0647 \u0631\u0627 \u0646\u06AF\u0630\u0631\u0627\u0646\u062F\u0647 \u0628\u0627\u0634\u062F.","\u0628\u