\u0626\u06CC\u0686\u200C\u0647\u0627 \u0631\u0648\u06CC \u0627\u0648\u0644\u0648\u06CC\u062A \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 `32768`: \u062F\u0631 \u062A\u0633\u0627\u0648\u06CC \u0627\u0648\u0644\u0648\u06CC\u062A\u060C \u06A9\u0645\u062A\u0631\u06CC\u0646 MAC \u0631\u06CC\u0634\u0647 \u0631\u0627 \u062A\u0639\u06CC\u06CC\u0646 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0646\u0647 \u0642\u062F\u0645\u062A \u06CC\u0627 \u062A\u0648\u0627\u0646 \u062A\u062C\u0647\u06CC\u0632. \u0631\u06CC\u0634\u0647 \u0646\u0627\u0645\u0646\u0627\u0633\u0628 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u0644\u0627\u06CC\u0647 \u06F2 \u0631\u0627 \u0646\u0627\u0645\u0637\u0644\u0648\u0628 \u06A9\u0646\u062F\u061B \u0647\u0645\u0647 \u062C\u0631\u06CC\u0627\u0646\u200C\u0647\u0627 \u0627\u0644\u0632\u0627\u0645\u0627\u064B \u0627\u0632 \u062E\u0648\u062F \u0631\u06CC\u0634\u0647 \u0639\u0628\u0648\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u0646\u062F.","\u0639\u062F\u0645 \u0647\u0645\u0627\u0647\u0646\u06AF\u06CC Root Bridge \u0628\u0627 \u0631\u0648\u062A\u0631 Active \u062F\u0631 \u067E\u0631\u0648\u062A\u06A9\u0644 [[fhrp|HSRP / VRRP]]: \u0627\u06AF\u0631 \u0633\u0648\u0626\u06CC\u0686 \u062A\u0648\u0632\u06CC\u0639 \u0627\u0648\u0644 Active HSRP \u0628\u0627\u0634\u062F \u0648\u0644\u06CC \u0633\u0648\u0626\u06CC\u0686 \u062A\u0648\u0632\u06CC\u0639 \u062F\u0648\u0645 Root Bridge \u0628\u0627\u0634\u062F\u060C \u062A\u0631\u0627\u0641\u06CC\u06A9 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u0632\u06CC\u06AF\u0632\u0627\u06AF \u0627\u0636\u0627\u0641\u0647 \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9 \u0628\u06CC\u0646 \u062F\u0648 \u0633\u0648\u0626\u06CC\u0686 \u062A\u0648\u0632\u06CC\u0639 \u0637\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 `bpdufilter` \u0631\u0648\u06CC \u067E\u0648\u0631\u062A \u0628\u0647 \u062C\u0627\u0