  <style id="fam-design-system">
/* FAM Academy v4 — design tokens.
   Brand colours come from the FAM mark (blue + green). Every colour used anywhere in the new
   UI is one of these tokens; themes only swap token values. */
:root {
  color-scheme: dark;
  /* surfaces */
  --fam-beam: #f3e2b8; --fam-beam-glow: #e8c47a;
  --c-bg: #0b1017;
  --c-surface: #121923;
  --c-surface-2: #19222e;
  --c-surface-3: #212c3b;
  --c-border: #263243;
  --c-border-strong: #384760;
  /* text */
  --c-text: #e9eef5;
  --c-text-2: #aab6c6;
  --c-text-3: #8492a6;
  /* brand */
  --c-brand: #6ea8ff;
  --c-primary: #2f6fe4;
  --c-primary-hover: #3f7df0;
  --c-on-primary: #ffffff;
  --c-brand-soft: rgba(110, 168, 255, .13);
  --c-accent: #35c992;
  /* status */
  --c-done: #3bcf96;
  --c-done-soft: rgba(59, 207, 150, .14);
  --c-progress: #6ea8ff;
  --c-progress-soft: rgba(110, 168, 255, .14);
  --c-review: #f2b445;
  --c-review-soft: rgba(242, 180, 69, .15);
  --c-locked: #8492a6;
  --c-locked-soft: rgba(132, 146, 166, .14);
  --c-danger: #f4706c;
  --c-danger-soft: rgba(244, 112, 108, .14);
  --c-code-bg: #080c12;
  --c-code-text: #d7e3f4;
  --c-overlay: rgba(4, 7, 12, .66);
  /* type */
  --font: Vazirmatn, "Segoe UI", Tahoma, system-ui, sans-serif;
  --font-mono: ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, "DejaVu Sans Mono", monospace;
  --fs-xs: .78rem;
  --fs-sm: .86rem;
  --fs-md: .95rem;
  --fs-lg: 1.08rem;
  --fs-xl: 1.3rem;
  --fs-2xl: 1.65rem;
  --lh: 1.85;
  --lh-tight: 1.4;
  /* space */
  --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px; --s-5: 20px; --s-6: 24px; --s-7: 32px; --s-8: 48px;
  /* shape */
  --r-sm: 8px; --r-md: 12px; --r-lg: 16px; --r-pill: 999px;
  --sh-1: 0 1px 2px rgba(0, 0, 0, .3);
  --sh-2: 0 10px 30px rgba(0, 0, 0, .35);
  --focus: 0 0 0 3px var(--c-bg), 0 0 0 5px var(--c-brand);
  /* layout */
  --side-w: 268px;
  --top-h: 60px;
  --bottom-h: 62px;
  --page-w: 1080px;
  --page-w-wide: 1440px;
  --tap: 44px;
}

:root[data-theme="light"] {
  color-scheme: light;
  --fam-beam: #087f83; --fam-beam-glow: rgba(8, 127, 131, .7);
  --c-bg: #f3f5f8;
  --c-surface: #ffffff;
  --c-surface-2: #f1f4f8;
  --c-surface-3: #e5eaf1;
  --c-border: #dce2ea;
  --c-border-strong: #bcc6d3;
  --c-text: #111a27;
  --c-text-2: #4a5769;
  --c-text-3: #647184;
  --c-brand: #1c5bc9;
  --c-primary: #1c5bc9;
  --c-primary-hover: #174ead;
  --c-on-primary: #ffffff;
  --c-brand-soft: rgba(28, 91, 201, .09);
  --c-accent: #0d8a5f;
  --c-done: #0b7d55;
  --c-done-soft: rgba(11, 125, 85, .1);
  --c-progress: #1c5bc9;
  --c-progress-soft: rgba(28, 91, 201, .09);
  --c-review: #9a5a00;
  --c-review-soft: rgba(196, 122, 0, .13);
  --c-locked: #5f6c80;
  --c-locked-soft: rgba(95, 108, 128, .11);
  --c-danger: #c2332d;
  --c-danger-soft: rgba(194, 51, 45, .09);
  --c-code-bg: #0f1722;
  --c-code-text: #dbe6f5;
  --c-overlay: rgba(17, 26, 39, .45);
  --sh-1: 0 1px 2px rgba(17, 26, 39, .07);
  --sh-2: 0 12px 32px rgba(17, 26, 39, .12);
}

/* Names the reused simulator screens (console, topology, packet viewer…) were written against.
   They resolve to the tokens above, so those screens follow the same theme. */
:root {
  --bg: var(--c-bg); --panel: var(--c-surface); --panel2: var(--c-surface-2); --panel3: var(--c-surface-3);
  --text: var(--c-text); --muted: var(--c-text-2); --faint: var(--c-text-3);
  --line: var(--c-border); --line2: var(--c-border-strong);
  --accent: var(--c-brand); --accent2: var(--c-accent);
  --green: var(--c-done); --amber: var(--c-review); --red: var(--c-danger); --purple: #a990ff;
  --radius: var(--r-md); --shadow: var(--sh-2); --mono: var(--font-mono); --nav-h: var(--top-h);
}
:root[data-theme="light"] { --purple: #6a4bd1; }

/* Base: reset, typography, focus, helpers. */
*, *::before, *::after { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-padding-top: calc(var(--top-h) + 12px); }
body {
  margin: 0; min-height: 100dvh; background: var(--c-bg); color: var(--c-text);
  font-family: var(--font); font-size: var(--fs-md); line-height: var(--lh);
  -webkit-font-smoothing: antialiased; overflow-wrap: break-word;
}
h1, h2, h3, h4 { margin: 0; line-height: var(--lh-tight); font-weight: 700; text-wrap: balance; }
h1 { font-size: var(--fs-2xl); }
h2 { font-size: var(--fs-xl); }
h3 { font-size: var(--fs-lg); }
h4 { font-size: var(--fs-md); }
p { margin: 0 0 var(--s-3); }
p:last-child { margin-bottom: 0; }
a { color: var(--c-brand); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 3px; }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; }
ul, ol { margin: 0; padding: 0; list-style: none; }
dl, dd { margin: 0; }
img, svg { max-width: 100%; }
svg.icon { flex: none; display: block; }
:focus { outline: none; }
:focus-visible { outline: 2px solid var(--c-brand); outline-offset: 2px; border-radius: 4px; }
::selection { background: var(--c-brand); color: var(--c-on-primary); }
code, kbd, pre { font-family: var(--font-mono); }
code.inline { direction: ltr; unicode-bidi: isolate; background: var(--c-surface-3); border-radius: 5px; padding: .08em .4em; font-size: .88em; }
kbd { font-size: var(--fs-xs); border: 1px solid var(--c-border-strong); border-radius: 5px; padding: 0 5px; color: var(--c-text-3); }
strong, b { font-weight: 700; }
small { font-size: var(--fs-sm); }

.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.muted { color: var(--c-text-2); }
.small { font-size: var(--fs-sm); }
.ltr { direction: ltr; unicode-bidi: isolate; text-align: left; }
bdi, .ltr-mixed { unicode-bidi: plaintext; }
.lead { font-size: var(--fs-lg); color: var(--c-text); }
.skip-link { position: fixed; top: -100px; inset-inline-start: 12px; z-index: 200; background: var(--c-primary); color: var(--c-on-primary); padding: 10px 16px; border-radius: var(--r-sm); }
.skip-link:focus { top: 12px; }

.boot { min-height: 100dvh; display: grid; place-content: center; justify-items: center; gap: var(--s-2); text-align: center; padding: var(--s-6); }
.boot-logo, .brand-logo { width: 44px; height: 44px; flex: none; border-radius: 50%; background: #fff var(--fam-brand-logo) center / 86% no-repeat; box-shadow: var(--sh-1); }
.boot-logo { width: 64px; height: 64px; animation: fam4-pulse 1.4s ease-in-out infinite; }
.boot-title { font-size: var(--fs-xl); font-weight: 700; }
.boot-sub { color: var(--c-text-2); }
.boot pre { max-width: min(92vw, 720px); text-align: left; }
@keyframes fam4-pulse { 50% { transform: scale(.94); opacity: .75; } }
@keyframes fam4-spin { to { transform: rotate(360deg); } }
@keyframes fam4-in { from { opacity: 0; transform: translateY(6px); } }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
}

/* Components. One definition each, used by every screen. */

/* ---- buttons ---- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: var(--s-2);
  min-height: var(--tap); padding: 8px 16px; border-radius: var(--r-sm);
  border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text);
  font-size: var(--fs-md); font-weight: 700; line-height: 1.4; text-decoration: none; white-space: nowrap;
  transition: background .15s, border-color .15s, color .15s;
}
.btn:hover { background: var(--c-surface-2); border-color: var(--c-text-3); text-decoration: none; }
.btn.primary { background: var(--c-primary); border-color: var(--c-primary); color: var(--c-on-primary); }
.btn.primary:hover { background: var(--c-primary-hover); border-color: var(--c-primary-hover); }
.btn.ghost { background: transparent; }
.btn.subtle { background: transparent; border-color: transparent; color: var(--c-text-2); }
.btn.subtle:hover { background: var(--c-surface-2); color: var(--c-text); }
.btn.ok { background: var(--c-done-soft); border-color: var(--c-done); color: var(--c-done); }
.btn.warn { background: var(--c-review-soft); border-color: var(--c-review); color: var(--c-review); }
.btn.danger { background: var(--c-danger-soft); border-color: var(--c-danger); color: var(--c-danger); }
.btn.sm { min-height: 36px; padding: 5px 12px; font-size: var(--fs-sm); }
.btn.lg { min-height: 50px; padding: 10px 22px; font-size: var(--fs-lg); }
.btn:disabled { opacity: .5; }
.btn .icon { margin-block: -2px; }
[dir="rtl"] .btn .icon:is([data-flip]) { transform: scaleX(-1); }
.icon-btn { display: inline-grid; place-items: center; width: var(--tap); height: var(--tap); border-radius: var(--r-sm); border: 1px solid transparent; background: transparent; color: var(--c-text-2); }
.icon-btn:hover { background: var(--c-surface-2); color: var(--c-text); text-decoration: none; }
.actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
.link-more { background: none; border: 0; padding: 4px 2px; color: var(--c-brand); font-size: var(--fs-sm); font-weight: 700; }
.link-more:hover { text-decoration: underline; }
.back-link { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; color: var(--c-text-2); font-size: var(--fs-sm); margin-bottom: var(--s-2); }
.back-link:hover { color: var(--c-text); }

/* ---- cards ---- */
.card { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--r-lg); padding: var(--s-5); }
.card-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-3); }
.card-head h2 { font-size: var(--fs-lg); }

/* ---- status ---- */
.status { display: inline-flex; align-items: center; gap: 5px; padding: 2px 10px; border-radius: var(--r-pill); font-size: var(--fs-xs); font-weight: 700; line-height: 1.7; white-space: nowrap; border: 1px solid transparent; }
.status-compact { padding: 4px; }
.status-done { color: var(--c-done); background: var(--c-done-soft); }
.status-progress { color: var(--c-progress); background: var(--c-progress-soft); }
.status-review { color: var(--c-review); background: var(--c-review-soft); }
.status-locked { color: var(--c-locked); background: var(--c-locked-soft); }
.status-idle { color: var(--c-text-2); background: var(--c-surface-3); }
.step-dot { flex: none; display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--c-border-strong); color: var(--c-text-3); background: var(--c-surface); }
.dot-done { background: var(--c-done); border-color: var(--c-done); color: var(--c-bg); }
.dot-progress { border-color: var(--c-progress); box-shadow: inset 0 0 0 4px var(--c-surface), inset 0 0 0 12px var(--c-progress); }
.dot-review { border-color: var(--c-review); color: var(--c-review); }
.dot-locked { border-style: dashed; color: var(--c-locked); }
.tag { display: inline-flex; align-items: center; padding: 1px 9px; border-radius: var(--r-pill); border: 1px solid var(--c-border-strong); color: var(--c-text-2); font-size: var(--fs-xs); font-weight: 700; white-space: nowrap; }
.tag-brand { border-color: transparent; background: var(--c-brand-soft); color: var(--c-brand); }
.tag-warn { border-color: transparent; background: var(--c-review-soft); color: var(--c-review); }
.tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }

/* ---- progress ---- */
.meter { height: 8px; border-radius: var(--r-pill); background: var(--c-surface-3); overflow: hidden; }
.meter > i { display: block; height: 100%; border-radius: inherit; background: var(--c-progress); transition: width .3s; }
.meter-done > i { background: var(--c-done); }
.meter-review > i { background: var(--c-review); }
.ring { --ring: 0; position: relative; flex: none; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(var(--c-accent) calc(var(--ring) * 1%), var(--c-surface-3) 0); }
.ring::before { content: ""; position: absolute; inset: 9px; border-radius: 50%; background: var(--c-surface); }
.ring-value { position: relative; font-weight: 700; font-size: var(--fs-lg); }

/* ---- page header ---- */
.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; margin-bottom: var(--s-5); }
.page-sub { color: var(--c-text-2); max-width: 70ch; margin: var(--s-2) 0 0; }
.kicker { color: var(--c-brand); font-size: var(--fs-sm); font-weight: 700; margin-bottom: 4px; }
.meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin-top: var(--s-3); }
.meta-item { display: inline-flex; align-items: center; gap: 6px; color: var(--c-text-2); font-size: var(--fs-sm); }
.section-title { font-size: var(--fs-xl); margin: var(--s-7) 0 var(--s-3); }
.section-sub { margin-top: calc(var(--s-2) * -1); }

/* ---- notices (success / info / warning / error messages) ---- */
.notice { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-3); padding: var(--s-4); border-radius: var(--r-md); border: 1px solid var(--c-border); border-inline-start: 4px solid var(--c-progress); background: var(--c-progress-soft); margin: var(--s-4) 0; }
.notice-icon { color: var(--c-progress); padding-top: 3px; }
.notice-copy h4 { margin-bottom: 4px; }
.notice-copy .btn { margin-top: var(--s-2); }
.notice-success { border-inline-start-color: var(--c-done); background: var(--c-done-soft); }
.notice-success .notice-icon { color: var(--c-done); }
.notice-warn { border-inline-start-color: var(--c-review); background: var(--c-review-soft); }
.notice-warn .notice-icon { color: var(--c-review); }
.notice-danger { border-inline-start-color: var(--c-danger); background: var(--c-danger-soft); }
.notice-danger .notice-icon { color: var(--c-danger); }
.notice-tip { border-inline-start-color: var(--c-accent); background: var(--c-surface-2); }
.notice-tip .notice-icon { color: var(--c-accent); }
.snack { position: fixed; z-index: 300; inset-inline: 0; bottom: calc(var(--bottom-h) + 18px); margin-inline: auto; width: fit-content; max-width: min(92vw, 520px); padding: 10px 18px; border-radius: var(--r-md); background: var(--c-text); color: var(--c-bg); font-weight: 700; box-shadow: var(--sh-2); opacity: 0; transform: translateY(10px); pointer-events: none; transition: opacity .2s, transform .2s; }
.snack.show { opacity: 1; transform: none; }
.snack-success { background: var(--c-done); }
.snack-error { background: var(--c-danger); }
.empty-state { display: grid; justify-items: center; gap: var(--s-2); text-align: center; padding: var(--s-7) var(--s-4); color: var(--c-text-2); }
.empty-state h3 { color: var(--c-text); }
.empty-icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--c-surface-3); color: var(--c-text-3); }
.loading { display: flex; align-items: center; justify-content: center; gap: var(--s-3); padding: var(--s-8); color: var(--c-text-2); }
.spinner { width: 20px; height: 20px; border-radius: 50%; border: 3px solid var(--c-surface-3); border-top-color: var(--c-brand); animation: fam4-spin .8s linear infinite; }

/* ---- tabs, segmented control, search ---- */
.tabbar { display: flex; gap: var(--s-1); overflow-x: auto; border-bottom: 1px solid var(--c-border); margin-bottom: var(--s-5); scrollbar-width: none; }
.tabbar::-webkit-scrollbar { display: none; }
.tab { display: inline-flex; align-items: center; gap: 7px; min-height: var(--tap); padding: 8px 14px; color: var(--c-text-2); font-weight: 700; white-space: nowrap; border-bottom: 3px solid transparent; margin-bottom: -1px; }
.tab:hover { color: var(--c-text); text-decoration: none; }
.tab.active { color: var(--c-brand); border-bottom-color: var(--c-brand); }
.tab-count { font-size: var(--fs-xs); padding: 0 7px; border-radius: var(--r-pill); background: var(--c-surface-3); color: var(--c-text-2); }
.tab-intro { color: var(--c-text-2); margin-top: calc(var(--s-2) * -1); margin-bottom: var(--s-4); max-width: 75ch; }
.segmented { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: var(--r-md); background: var(--c-surface-2); border: 1px solid var(--c-border); }
.segmented button { min-height: 36px; padding: 4px 13px; border: 0; border-radius: var(--r-sm); background: transparent; color: var(--c-text-2); font-size: var(--fs-sm); font-weight: 700; }
.segmented button:hover { color: var(--c-text); }
.segmented button.active { background: var(--c-surface); color: var(--c-text); box-shadow: var(--sh-1); outline: 1px solid var(--c-border-strong); }
.search-box { display: flex; align-items: center; gap: var(--s-2); min-height: var(--tap); padding: 0 12px; flex: 1 1 240px; max-width: 420px; border-radius: var(--r-sm); border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text-3); }
.search-box:focus-within { border-color: var(--c-brand); box-shadow: 0 0 0 3px var(--c-brand-soft); }
.search-box input { flex: 1; min-width: 0; border: 0; background: none; outline: none; color: var(--c-text); }
.toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin-bottom: var(--s-4); }
.field { display: grid; gap: 6px; font-weight: 700; }
.field input, .find-input { min-height: var(--tap); padding: 8px 12px; border-radius: var(--r-sm); border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text); width: 100%; }
.field input:focus, .find-input:focus { border-color: var(--c-brand); box-shadow: 0 0 0 3px var(--c-brand-soft); outline: none; }

/* ---- collapsible ---- */
.fold { border: 1px solid var(--c-border); border-radius: var(--r-md); background: var(--c-surface); margin: var(--s-2) 0; }
.fold > summary { display: flex; align-items: center; gap: var(--s-3); min-height: 52px; padding: 10px 16px; cursor: pointer; list-style: none; font-weight: 700; border-radius: var(--r-md); }
.fold > summary::-webkit-details-marker { display: none; }
.fold > summary:hover { background: var(--c-surface-2); }
.fold > summary > .icon { margin-inline-start: auto; color: var(--c-text-3); transition: transform .2s; }
.fold[open] > summary > .icon { transform: rotate(180deg); }
.fold-title { display: flex; align-items: center; gap: var(--s-3); flex: 1; min-width: 0; flex-wrap: wrap; }
.fold-body { padding: 4px 16px 16px; }
.fold-num { flex: none; display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--c-surface-3); color: var(--c-text-2); font-size: var(--fs-sm); }
.fold-quiet { border-style: dashed; background: transparent; }
.fold-quiet > summary { min-height: 44px; font-weight: 400; color: var(--c-text-2); font-size: var(--fs-sm); }
.fold-reveal { border-color: var(--c-border-strong); border-inline-start: 4px solid var(--c-accent); }
.accordion-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-top: var(--s-4); }

/* ---- rich text, code, tables ---- */
.prose > * + * { margin-top: var(--s-3); }
.prose h4 { margin-top: var(--s-4); }
.rich-list { display: grid; gap: 6px; padding-inline-start: 1.4em; margin: var(--s-3) 0; }
ul.rich-list { list-style: disc; }
ol.rich-list { list-style: decimal; }
.rich-list li::marker { color: var(--c-text-3); }
.xref { font-weight: 700; }
.code-figure { margin: var(--s-3) 0; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--c-border); background: var(--c-code-bg); }
.code-figure figcaption { display: flex; align-items: center; gap: var(--s-2); padding: 6px 12px; font-size: var(--fs-xs); color: #b5c2d6; background: rgba(255, 255, 255, .04); border-bottom: 1px solid rgba(255, 255, 255, .07); }
.code-figure figcaption .segmented { background: transparent; border: 0; padding: 0; }
.code-figure figcaption .segmented button { color: #b5c2d6; min-height: 30px; font-family: var(--font-mono); }
.code-figure figcaption .segmented button.active { background: rgba(255, 255, 255, .12); color: #fff; outline: 0; box-shadow: none; }
pre.code { margin: 0; padding: 14px 16px; direction: ltr; text-align: left; overflow-x: auto; background: var(--c-code-bg); color: var(--c-code-text); font-size: .84rem; line-height: 1.7; tab-size: 2; white-space: pre; border-radius: var(--r-md); }
.code-figure pre.code { border-radius: 0; }
.table-scroll { overflow-x: auto; border: 1px solid var(--c-border); border-radius: var(--r-md); margin: var(--s-3) 0; }
table.data { width: 100%; border-collapse: collapse; font-size: var(--fs-sm); }
table.data th { text-align: start; padding: 10px 14px; background: var(--c-surface-2); color: var(--c-text-2); font-weight: 700; white-space: nowrap; border-bottom: 1px solid var(--c-border); }
table.data td { padding: 10px 14px; border-bottom: 1px solid var(--c-border); vertical-align: top; }
table.data tr:last-child td { border-bottom: 0; }
table.data.compact th, table.data.compact td { padding: 6px 10px; }
.state { font-family: var(--font-mono); font-weight: 700; }
.state.up { color: var(--c-done); }
.state.down { color: var(--c-danger); }
.link-list { display: grid; gap: var(--s-2); }
.link-list a { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; }

/* ---- rows and key/value ---- */
.row-list { display: grid; gap: var(--s-2); }
.row-link, .activity a { display: flex; align-items: center; gap: var(--s-3); min-height: 56px; padding: 8px 14px; border-radius: var(--r-md); border: 1px solid var(--c-border); background: var(--c-surface); color: var(--c-text); }
.row-link:hover, .activity a:hover { border-color: var(--c-border-strong); background: var(--c-surface-2); text-decoration: none; }
.row-link > .icon:last-child, .activity a > .icon:last-child, .map-item > .icon:last-child, .tool-tile > .icon:last-child { color: var(--c-text-3); transform: scaleX(-1); }
.row-copy { flex: 1; min-width: 0; display: grid; }
.row-copy b { font-weight: 700; }
.row-copy small { color: var(--c-text-2); }
.row-icon { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--r-sm); background: var(--c-surface-3); color: var(--c-text-2); }
.row-icon.warn { background: var(--c-review-soft); color: var(--c-review); }
.row-num { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--c-surface-3); color: var(--c-text-2); font-weight: 700; font-size: var(--fs-sm); }
.activity { display: grid; gap: var(--s-2); }
.kv { display: grid; gap: 0; }
.kv > div { display: flex; justify-content: space-between; gap: var(--s-4); padding: 9px 0; border-bottom: 1px solid var(--c-border); }
.kv > div:last-child { border-bottom: 0; }
.kv dt { color: var(--c-text-2); }
.kv dd { font-weight: 700; text-align: end; }
.spec { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s-3); margin: var(--s-4) 0; }
.spec > div { padding: 10px 12px; border-radius: var(--r-sm); background: var(--c-surface-2); }
.spec dt { font-size: var(--fs-xs); color: var(--c-text-2); }
.spec dd { font-weight: 700; }
.spec-compact { grid-template-columns: 1fr; gap: 0; margin: var(--s-3) 0 0; }
.spec-compact > div { display: flex; gap: var(--s-3); background: none; padding: 5px 0; border-top: 1px dashed var(--c-border); }
.spec-compact dt { flex: none; width: 9.5em; font-size: var(--fs-sm); }
.spec-compact dd { font-weight: 400; font-size: var(--fs-sm); }
.spec a.met { color: var(--c-done); }
.chip-row { display: flex; flex-wrap: wrap; gap: var(--s-2); }
.chip-link { display: inline-flex; align-items: center; gap: 6px; min-height: 34px; padding: 3px 12px; border-radius: var(--r-pill); border: 1px solid var(--c-border-strong); color: var(--c-text); font-size: var(--fs-sm); }
.chip-link:hover { background: var(--c-surface-2); text-decoration: none; }
.chip-link.met { color: var(--c-done); border-color: var(--c-done); }
.check-mark { flex: none; display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--c-border-strong); color: var(--c-bg); }

/* ---- dialog ---- */
.dialog-back { position: fixed; inset: 0; z-index: 250; display: grid; place-items: center; padding: var(--s-4); background: var(--c-overlay); }
.dialog { width: min(100%, 460px); max-height: min(88dvh, 720px); display: flex; flex-direction: column; border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border-strong); box-shadow: var(--sh-2); animation: fam4-in .18s ease-out; }
.dialog-wide { width: min(100%, 640px); }
.dialog-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); padding: var(--s-3) var(--s-3) var(--s-3) var(--s-5); border-bottom: 1px solid var(--c-border); }
[dir="rtl"] .dialog-head { padding: var(--s-3) var(--s-5) var(--s-3) var(--s-3); }
.dialog-head h2 { font-size: var(--fs-lg); }
.dialog-body { padding: var(--s-5); overflow-y: auto; display: grid; gap: var(--s-3); }
.dialog-foot { display: flex; justify-content: flex-end; gap: var(--s-2); padding: var(--s-3) var(--s-5); border-top: 1px solid var(--c-border); }

/* Application shell: sidebar (desktop), top bar, content column, bottom bar (phone). */
.app-shell { display: grid; grid-template-columns: var(--side-w) minmax(0, 1fr); min-height: 100dvh; transition: grid-template-columns .48s cubic-bezier(.2,.8,.2,1); }
.app-main { min-width: 0; display: flex; flex-direction: column; }

.sidebar { position: sticky; top: 0; height: 100dvh; display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-4); background: var(--c-surface); border-inline-end: 1px solid var(--c-border); overflow-y: auto; }
.brand { display: flex; align-items: center; gap: var(--s-3); padding: 4px 6px; color: var(--c-text); border-radius: var(--r-md); }
.brand:hover { text-decoration: none; }
.brand-copy { display: grid; line-height: 1.35; }
.brand-copy b { font-size: var(--fs-lg); letter-spacing: .01em; }
.brand-copy small { color: var(--c-text-2); font-size: var(--fs-xs); }
.brand-mobile { display: none; padding: 0; }
.brand-mobile .brand-logo { width: 36px; height: 36px; }

.side-nav { display: grid; gap: 2px; }
.side-link { position: relative; display: flex; align-items: center; gap: var(--s-3); min-height: 52px; padding: 6px 12px; border-radius: var(--r-md); color: var(--c-text-2); }
.side-link:hover { background: var(--c-surface-2); color: var(--c-text); text-decoration: none; }
.side-icon { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--r-sm); }
.side-copy { display: grid; min-width: 0; line-height: 1.4; }
.side-label { font-weight: 700; color: var(--c-text); }
.side-hint { font-size: var(--fs-xs); color: var(--c-text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.side-link.active { background: var(--c-brand-soft); }
.side-link.active .side-icon { background: var(--c-primary); color: var(--c-on-primary); }
.side-link.active .side-label { color: var(--c-brand); }
.side-link.active::before { content: ""; position: absolute; inset-block: 12px; inset-inline-start: -16px; width: 4px; border-radius: 0 4px 4px 0; background: var(--c-brand); }
[dir="rtl"] .side-link.active::before { border-radius: 4px 0 0 4px; }

.side-path { margin-top: auto; display: grid; gap: 6px; padding: var(--s-3); border-radius: var(--r-md); border: 1px solid var(--c-border); background: var(--c-surface-2); }
.side-path-head { display: flex; justify-content: space-between; font-size: var(--fs-xs); color: var(--c-text-3); }
.side-path-name { font-weight: 700; color: var(--c-text); line-height: 1.5; }
.side-path-meta { font-size: var(--fs-xs); color: var(--c-text-2); }
.side-foot { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-xs); color: var(--c-text-3); padding-inline: 6px; }
.live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--c-done); }

.topbar { position: sticky; top: 0; z-index: 50; display: flex; align-items: center; gap: var(--s-3); height: var(--top-h); padding-inline: var(--s-6); background: var(--c-bg); border-bottom: 1px solid var(--c-border); }
.crumbs { flex: 1; min-width: 0; display: flex; align-items: center; gap: 6px; font-size: var(--fs-sm); white-space: nowrap; overflow: hidden; }
.crumb { color: var(--c-text-2); overflow: hidden; text-overflow: ellipsis; flex: 0 1 auto; min-width: 2.5em; }
a.crumb:hover { color: var(--c-text); }
.crumb.current { color: var(--c-text); font-weight: 700; flex-shrink: 1; }
.crumb-sep { flex: none; color: var(--c-text-3); transform: scaleX(-1); }
.top-actions { flex: none; display: flex; align-items: center; gap: var(--s-1); }
.search-trigger { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 0 12px; margin-inline-end: var(--s-2); border-radius: var(--r-sm); border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text-2); font-size: var(--fs-sm); }
.search-trigger:hover { border-color: var(--c-text-3); color: var(--c-text); }
.top-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px; margin-inline-end: var(--s-1); border-radius: var(--r-pill); background: var(--c-surface-2); color: var(--c-text-2); font-size: var(--fs-sm); font-weight: 700; white-space: nowrap; }
.top-chip:hover { text-decoration: none; color: var(--c-text); }
.top-chip.lit { background: var(--c-review-soft); color: var(--c-review); }

.page { flex: 1; padding: var(--s-6) var(--s-6) var(--s-8); outline: none; }
.view { max-width: var(--page-w); margin-inline: auto; animation: fam4-in .2s ease-out; }
.view-wide { max-width: var(--page-w-wide); }

.bottom-nav { display: none; }

/* search dialog */
.find-results { display: grid; gap: 2px; max-height: 50dvh; overflow-y: auto; }
.find-item { display: grid; grid-template-columns: 5.5em minmax(0, 1fr); align-items: center; column-gap: var(--s-3); min-height: 48px; padding: 6px 10px; border-radius: var(--r-sm); color: var(--c-text); }
.find-item:hover, .find-item:focus-visible { background: var(--c-surface-2); text-decoration: none; }
.find-kind { grid-row: span 2; font-size: var(--fs-xs); color: var(--c-text-3); }
.find-title { font-weight: 700; }
.find-sub { grid-column: 2; font-size: var(--fs-xs); color: var(--c-text-2); }
.find-empty { padding: var(--s-5); text-align: center; color: var(--c-text-2); }
.help-list { display: grid; gap: var(--s-2); }
.help-list li { display: flex; align-items: center; gap: var(--s-3); }
.sheet-list { display: grid; gap: var(--s-1); }
.sheet-link { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 58px; padding: 8px 10px; border: 0; border-radius: var(--r-md); background: none; color: var(--c-text); text-align: start; }
.sheet-link:hover { background: var(--c-surface-2); text-decoration: none; }
.sheet-link span:last-child { display: grid; line-height: 1.5; }
.sheet-link small { color: var(--c-text-2); }
.sheet-icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--r-sm); background: var(--c-surface-3); color: var(--c-text-2); }

/* first-run setup */
.onboard { display: grid; place-items: center; padding: var(--s-4); }
.onboard-page { min-height: 100dvh; padding-top: 84px; }
.academy-first-run-bar { position: fixed; top: 0; inset-inline: 0; z-index: 300; margin: 0; border-radius: 0 0 var(--r-md) var(--r-md); }
.onboard-overlay { position: fixed; inset: 0; z-index: 260; background: var(--c-overlay); overflow-y: auto; }
.onboard-card { width: min(100%, 720px); display: grid; gap: var(--s-5); padding: var(--s-6); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); box-shadow: var(--sh-2); }
.onboard-head { display: flex; align-items: center; gap: var(--s-4); }
.onboard-head h1 { font-size: var(--fs-xl); }
.onboard-head .brand-logo { width: 52px; height: 52px; }
.onboard-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; }
.choice-group { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--s-2); }
.choice-group legend { padding: 0; margin-bottom: var(--s-2); font-weight: 700; }
.choice { position: relative; display: block; cursor: pointer; }
.choice input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.choice-body { display: flex; align-items: center; gap: var(--s-3); min-height: 60px; padding: 8px 12px; border-radius: var(--r-md); border: 1px solid var(--c-border-strong); background: var(--c-surface); }
.choice:hover .choice-body { background: var(--c-surface-2); }
.choice input:checked + .choice-body { border-color: var(--c-brand); background: var(--c-brand-soft); box-shadow: inset 0 0 0 1px var(--c-brand); }
.choice input:focus-visible + .choice-body { outline: 2px solid var(--c-brand); outline-offset: 2px; }
.choice-icon { flex: none; color: var(--c-brand); }
.choice-copy { display: grid; line-height: 1.5; }
.choice-copy small { color: var(--c-text-2); font-size: var(--fs-xs); }

@media (max-width: 1100px) {
  :root { --side-w: 224px; }
  .side-hint { display: none; }
  .side-link { min-height: 46px; }
  .search-trigger kbd { display: none; }
}
@media (max-width: 860px) {
  .app-shell { grid-template-columns: minmax(0, 1fr); }
  .sidebar { display: none; }
  .brand-mobile { display: flex; }
  .topbar { padding-inline: var(--s-3); gap: var(--s-2); }
  .page { padding: var(--s-4) var(--s-3) calc(var(--bottom-h) + var(--s-7) + env(safe-area-inset-bottom)); }
  .search-trigger { display: none; }
  .crumbs > :not(:nth-last-child(-n+3)) { display: none; }
  .crumb { min-width: 0; }
  .top-chip span { display: none; }
  .top-chip { padding: 0 10px; margin: 0; }
  .top-chip:not(.lit) { display: none; }
  .top-actions a.icon-btn { display: none; }
  .bottom-nav { position: fixed; z-index: 60; inset-inline: 0; bottom: 0; display: grid; grid-template-columns: repeat(5, 1fr); height: calc(var(--bottom-h) + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); background: var(--c-surface); border-top: 1px solid var(--c-border); }
  .bottom-nav a, .bottom-nav button { display: grid; justify-items: center; align-content: center; gap: 2px; border: 0; background: none; color: var(--c-text-2); font-size: .72rem; font-weight: 700; min-width: 0; }
  .bottom-nav a:hover { text-decoration: none; }
  .bottom-nav .active { color: var(--c-brand); }
  .bottom-nav .active .icon { background: var(--c-brand-soft); border-radius: var(--r-pill); box-shadow: 0 0 0 5px var(--c-brand-soft); }
  .dialog-back { align-items: end; padding: 0; }
  .dialog, .dialog-wide { width: 100%; max-height: 90dvh; border-radius: var(--r-lg) var(--r-lg) 0 0; border-bottom: 0; padding-bottom: env(safe-area-inset-bottom); }
  .onboard-card { padding: var(--s-4); }
  .choice-group { grid-template-columns: 1fr 1fr; }
  h1 { font-size: 1.4rem; }
  h2 { font-size: 1.15rem; }
}
@media (max-width: 420px) {
  .choice-group { grid-template-columns: 1fr; }
}

/* ---- Campus backdrop + moving light around menu items (skin of the previous version) ---------- */
html { background: #091421; }
:root[data-theme="light"] { background: #eef5f7; }
body { background: transparent; }
.fam-campus-backdrop {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background: linear-gradient(180deg, rgba(4, 10, 20, .27), rgba(4, 10, 20, .49)), var(--fam-academy-campus) center center / cover no-repeat #091421;
}
:root[data-theme="light"] .fam-campus-backdrop {
  background: linear-gradient(180deg, rgba(243, 248, 250, .58), rgba(238, 245, 247, .68)), var(--fam-academy-campus) center center / cover no-repeat #eef5f7;
}
#app { position: relative; z-index: 1; }

.sidebar { background: color-mix(in srgb, var(--c-surface) 80%, transparent); -webkit-backdrop-filter: blur(16px) saturate(1.15); backdrop-filter: blur(16px) saturate(1.15); }
.topbar { background: color-mix(in srgb, var(--c-bg) 70%, transparent); -webkit-backdrop-filter: blur(14px) saturate(1.1); backdrop-filter: blur(14px) saturate(1.1); }
.view { background: color-mix(in srgb, var(--c-bg) 78%, transparent); border-radius: var(--r-lg); padding: var(--s-5); box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-border) 60%, transparent); }
:root[data-theme="light"] .view { background: color-mix(in srgb, var(--c-bg) 82%, transparent); }
.view .card, .view .lesson-block { background-color: color-mix(in srgb, var(--c-surface) 90%, transparent); }
.view .stepper { background: color-mix(in srgb, var(--c-bg) 88%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-radius: var(--r-md); padding-inline: var(--s-2); }
@media (max-width: 860px) { .view { padding: var(--s-3); border-radius: var(--r-md); } }

.side-nav { gap: 6px; }
.side-link { border: 1px solid var(--c-border); background: color-mix(in srgb, var(--c-surface-2) 55%, transparent); }
.side-link.active { border-color: color-mix(in srgb, var(--fam-beam) 55%, transparent); }
.sheet-link { position: relative; }

.fam-nav-beam { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
.fam-nav-beam rect {
  fill: none; stroke: var(--fam-beam); stroke-width: 1.2; stroke-linecap: round; stroke-dasharray: 12 88;
  filter: drop-shadow(0 0 3px var(--fam-beam-glow)); animation: fam-nav-light 5s linear infinite;
}
.side-link:nth-child(2n) .fam-nav-beam rect, .sheet-link:nth-child(2n) .fam-nav-beam rect { animation-delay: -2.5s; }
.side-link:nth-child(3n) .fam-nav-beam rect, .sheet-link:nth-child(3n) .fam-nav-beam rect { animation-delay: -1.2s; }
.side-link.active .fam-nav-beam rect { stroke-width: 1.8; stroke-dasharray: 18 82; }
@keyframes fam-nav-light { to { stroke-dashoffset: -100; } }
@media (prefers-reduced-motion: reduce) { .fam-nav-beam rect { animation: none; } }

/* Screens. Only layout that is specific to one screen lives here. */

/* ---- dashboard ---- */
.hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s-6); padding: var(--s-6); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); border-inline-start: 5px solid var(--c-primary); margin-bottom: var(--s-5); }
.hero-copy { display: grid; gap: var(--s-2); justify-items: start; }
.hero-copy h1 { font-size: var(--fs-2xl); }
.hero-detail { color: var(--c-text-2); max-width: 62ch; margin: 0; }
.hero-reason { display: flex; align-items: center; gap: 6px; margin: 0; color: var(--c-text-2); font-size: var(--fs-sm); }
.hero .actions { margin-top: var(--s-2); }
.hero .meta-row { margin-top: var(--s-1); }
.hero-side { display: grid; justify-items: center; gap: var(--s-2); text-align: center; }
.hero-side-label { color: var(--c-text-2); font-size: var(--fs-sm); }
.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--s-3); margin-bottom: var(--s-5); }
.stat-tile { display: flex; align-items: center; gap: var(--s-3); padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--c-surface); border: 1px solid var(--c-border); }
.stat-icon { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: var(--r-sm); background: var(--c-brand-soft); color: var(--c-brand); }
.stat-copy { min-width: 0; line-height: 1.5; }
.stat-value { font-size: var(--fs-lg); font-weight: 700; }
.stat-label { color: var(--c-text-2); font-size: var(--fs-sm); }
.stat-hint { color: var(--c-text-3); font-size: var(--fs-xs); }
.card-path { margin-bottom: var(--s-5); }
.stage-strip { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 1fr); gap: var(--s-2); overflow-x: auto; padding-bottom: 4px; }
.stage-pill { display: grid; gap: 6px; height: 100%; padding: var(--s-3); border-radius: var(--r-md); border: 1px solid var(--c-border); background: var(--c-surface-2); color: var(--c-text); }
.stage-pill:hover { border-color: var(--c-border-strong); text-decoration: none; }
.stage-pill-top { display: flex; align-items: center; gap: var(--s-2); }
.stage-pill-num { font-size: var(--fs-xs); color: var(--c-text-2); }
.stage-pill-title { font-weight: 700; line-height: 1.5; }
.stage-pill.s-progress { border-color: var(--c-progress); background: var(--c-progress-soft); }
.stage-pill.s-locked { opacity: .75; }
.dash-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--s-5); align-items: start; }
.dash-col { display: grid; gap: var(--s-5); min-width: 0; }
.goal-row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-2); }
.goal-count { font-size: var(--fs-xl); font-weight: 700; }
.skill-list { display: grid; gap: var(--s-3); }
.skill-top { display: flex; justify-content: space-between; gap: var(--s-3); margin-bottom: 4px; }
.card-review { border-color: var(--c-review); }

/* ---- path catalogue and path map ---- */
.ladder { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-5); }
.ladder li { display: flex; align-items: center; gap: var(--s-2); }
.ladder li + li::before { content: "←"; color: var(--c-text-3); }
.ladder a { display: inline-flex; align-items: center; gap: var(--s-2); min-height: 40px; padding: 4px 14px 4px 8px; border-radius: var(--r-pill); border: 1px solid var(--c-border); background: var(--c-surface); color: var(--c-text); font-weight: 700; font-size: var(--fs-sm); }
[dir="rtl"] .ladder a { padding: 4px 8px 4px 14px; }
.ladder a:hover { text-decoration: none; border-color: var(--c-border-strong); }
.ladder a.current { border-color: var(--c-brand); color: var(--c-brand); }
.path-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: var(--s-4); }
.path-card { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-5); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); }
.path-card.is-active { border-color: var(--c-brand); box-shadow: inset 0 0 0 1px var(--c-brand); }
.path-card-top { display: flex; align-items: flex-start; gap: var(--s-3); }
.path-card-title { flex: 1; min-width: 0; }
.path-card-title h2 { font-size: var(--fs-lg); }
.path-card-title h2 a { color: var(--c-text); }
.path-icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--r-md); background: var(--c-brand-soft); color: var(--c-brand); }
.path-intro { color: var(--c-text-2); margin: 0; flex: 1; }
.path-card .meta-row { margin-top: 0; }
.path-progress { display: grid; gap: 4px; }
.path-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s-6); padding: var(--s-6); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); }
.path-hero .actions { margin-top: var(--s-4); }
.path-hero-ring { display: grid; justify-items: center; gap: var(--s-2); }
.path-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); margin-top: var(--s-4); }
.path-facts > section { padding: var(--s-5); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); }
.path-facts h2 { font-size: var(--fs-md); margin-bottom: var(--s-3); color: var(--c-text-2); }
.tick-list { display: grid; gap: var(--s-2); margin-bottom: var(--s-3); }
.tick-list li { display: flex; align-items: flex-start; gap: var(--s-2); }
.tick-list li > .icon { margin-top: .45em; color: var(--c-done); }
.stage-list { display: grid; gap: var(--s-3); }
.fold.stage { margin: 0; border-radius: var(--r-lg); scroll-margin-top: calc(var(--top-h) + 12px); }
.fold.stage > summary { min-height: 68px; border-radius: var(--r-lg); }
.fold.stage[open] > summary { border-bottom: 1px solid var(--c-border); border-radius: var(--r-lg) var(--r-lg) 0 0; }
.fold.stage > .fold-body { padding: var(--s-3); }
.stage-num { flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--c-surface-3); color: var(--c-text-2); font-weight: 700; }
.stage-num.s-done { background: var(--c-done); color: var(--c-bg); }
.stage-num.s-progress { background: var(--c-primary); color: var(--c-on-primary); }
.stage-num.s-review { background: var(--c-review-soft); color: var(--c-review); }
.stage-copy { flex: 1; min-width: 0; display: grid; line-height: 1.5; }
.stage-title { font-size: var(--fs-lg); }
.stage-desc { color: var(--c-text-2); font-size: var(--fs-sm); font-weight: 400; }
.stage-side { flex: none; display: flex; align-items: center; gap: var(--s-2); }
.map-list { display: grid; gap: 2px; }
.map-item { display: flex; align-items: center; gap: var(--s-3); min-height: 60px; padding: 8px 12px; border-radius: var(--r-md); color: var(--c-text); }
.map-item:hover { background: var(--c-surface-2); text-decoration: none; }
.map-copy { flex: 1; min-width: 0; display: grid; line-height: 1.55; }
.map-title { font-weight: 700; }
.map-meta { color: var(--c-text-2); font-size: var(--fs-sm); }
.map-side { flex: none; display: flex; align-items: center; gap: var(--s-2); }
.map-steps { display: inline-flex; gap: 3px; }
.map-steps i { width: 14px; height: 5px; border-radius: 3px; background: var(--c-surface-3); }
.map-steps i.on { background: var(--c-done); }
.map-item.s-locked .map-title { color: var(--c-text-2); }
.map-item.s-progress { background: var(--c-progress-soft); }
.map-chapter .map-title { font-weight: 400; }
.map-check { margin-top: var(--s-2); border: 1px dashed var(--c-border-strong); }
.dot-idle { color: var(--c-text-2); }
.legend { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-5); }

/* ---- lesson (unit) ---- */
.unit, .check { max-width: 900px; margin-inline: auto; }
.unit-head { margin-bottom: var(--s-4); }
.prereq-line { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); margin-top: var(--s-3); }
.stepper { position: sticky; top: var(--top-h); z-index: 20; display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0; margin: 0 0 var(--s-5); padding: var(--s-2) 0; background: var(--c-bg); border-bottom: 1px solid var(--c-border); overflow-x: auto; scrollbar-width: none; }
.stepper::-webkit-scrollbar { display: none; }
.stepper-item { position: relative; display: grid; justify-items: center; gap: 4px; min-width: 76px; padding: 6px 4px; border-radius: var(--r-sm); color: var(--c-text-2); font-size: var(--fs-sm); text-align: center; }
.stepper-item:hover { background: var(--c-surface-2); text-decoration: none; color: var(--c-text); }
.stepper-item::before { content: ""; position: absolute; top: 19px; inset-inline-start: calc(-50% + 18px); width: calc(100% - 36px); height: 2px; background: var(--c-border-strong); }
.stepper-item:first-child::before { display: none; }
.stepper-dot { position: relative; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--c-border-strong); background: var(--c-bg); font-size: var(--fs-xs); font-weight: 700; }
.stepper-item.done .stepper-dot { background: var(--c-done); border-color: var(--c-done); color: var(--c-bg); }
.stepper-item.done::before { background: var(--c-done); }
.stepper-item.review .stepper-dot { border-color: var(--c-review); color: var(--c-review); }
.stepper-item.current { color: var(--c-brand); font-weight: 700; }
.stepper-item.current .stepper-dot { border-color: var(--c-brand); box-shadow: 0 0 0 4px var(--c-brand-soft); }
.stepper-item.current:not(.done) .stepper-dot { background: var(--c-primary); border-color: var(--c-primary); color: var(--c-on-primary); }
.step-body { display: grid; gap: var(--s-4); min-width: 0; }
.step-body > * { min-width: 0; }
.step-head { display: flex; align-items: center; gap: var(--s-3); }
.step-head-icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--r-md); background: var(--c-brand-soft); color: var(--c-brand); }
.step-head p { margin: 0; }
.step-foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-6); padding-top: var(--s-4); border-top: 1px solid var(--c-border); }
.step-foot .btn.subtle .icon:first-child { transform: none; }
.lesson-block { padding: var(--s-5); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); min-width: 0; }
.lesson-block > h3 { margin-bottom: var(--s-3); }
.lesson-block + .lesson-block { margin-top: var(--s-4); }
.step-body > .lesson-block + .lesson-block { margin-top: 0; }
.goal-box { padding: var(--s-4) var(--s-5); border-radius: var(--r-lg); background: var(--c-brand-soft); border: 1px solid var(--c-border); }
.goal-box h3 { display: flex; align-items: center; gap: var(--s-2); font-size: var(--fs-md); color: var(--c-brand); }
.goal-box .rich-list { margin-bottom: 0; }
.walk { display: grid; gap: var(--s-4); }
.walk-step { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-3); }
.walk-num { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--c-primary); color: var(--c-on-primary); font-weight: 700; font-size: var(--fs-sm); }
.walk-body { min-width: 0; padding: var(--s-4); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); }
.walk-body > h3 { font-size: var(--fs-md); }
.walk-sub { color: var(--c-text-2); font-size: var(--fs-sm); }
.pitfalls, .criteria { display: grid; gap: var(--s-2); }
.pitfalls li, .criteria li { display: flex; align-items: flex-start; gap: var(--s-2); }
.pitfalls li > .icon { margin-top: .4em; color: var(--c-review); }
.criteria li > .icon { margin-top: .4em; color: var(--c-brand); }
.criteria { margin: var(--s-3) 0; }
.mission-card { padding: var(--s-5); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border-strong); }
.mission-card.solved { border-color: var(--c-done); }
.mission-card.solved .criteria li > .icon { color: var(--c-done); }
.mission-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-3); }
.self-check { display: grid; gap: var(--s-4); }
.self-rate { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
.checklist { display: grid; gap: 2px; }
.checklist li { display: flex; align-items: center; gap: var(--s-3); min-height: 44px; padding: 4px 0; border-bottom: 1px solid var(--c-border); }
.checklist li:last-child { border-bottom: 0; }
.checklist li a { flex: 1; font-weight: 700; color: var(--c-text); }
.checklist li.ok .check-mark, .prereq-list li.met .check-mark, .goal-list li.pass .check-mark { background: var(--c-done); border-color: var(--c-done); }
.next-box { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; padding: var(--s-5); border-radius: var(--r-lg); background: var(--c-brand-soft); border: 1px solid var(--c-brand); }
.next-box p { margin: 4px 0 0; }
.gate { display: grid; justify-items: center; gap: var(--s-3); text-align: center; padding: var(--s-7) var(--s-5); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); }
.gate-icon { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--c-locked-soft); color: var(--c-locked); }
.gate p { max-width: 60ch; }
.gate .actions { justify-content: center; }
.prereq-list { display: grid; gap: var(--s-2); width: min(100%, 520px); text-align: start; }
.prereq-list li { display: flex; align-items: center; gap: var(--s-3); min-height: 48px; padding: 6px 12px; border-radius: var(--r-md); background: var(--c-surface-2); }
.prereq-list li a { flex: 1; font-weight: 700; }
.prereq-list .check-mark { color: var(--c-text-3); }
.prereq-list li.met .check-mark { color: var(--c-bg); }
.static-map { overflow-x: auto; border-radius: var(--r-md); }
.static-map svg { display: block; max-width: 100%; height: auto; }
.packet-row { padding: 8px 0; border-top: 1px solid var(--c-border); }
.packet-row-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2); }
.qa { padding: var(--s-3) 0; border-top: 1px solid var(--c-border); }
.qa:first-child { border-top: 0; padding-top: 0; }
.qa h4 { margin-bottom: 4px; }

/* ---- quiz ---- */
.question-list { display: grid; gap: var(--s-4); }
.question { padding: var(--s-5); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); }
.lesson-block .question { padding: var(--s-4) 0 0; border: 0; border-top: 1px solid var(--c-border); border-radius: 0; background: none; }
.lesson-block .question:first-child { border-top: 0; padding-top: 0; }
.question-text { display: flex; gap: var(--s-3); font-weight: 700; font-size: var(--fs-lg); line-height: 1.8; margin-bottom: var(--s-3); }
.question-num { flex: none; display: grid; place-items: center; width: 30px; height: 30px; margin-top: 2px; border-radius: 50%; background: var(--c-surface-3); color: var(--c-text-2); font-size: var(--fs-sm); }
.options { display: grid; gap: var(--s-2); }
.option { display: flex; align-items: center; gap: var(--s-3); width: 100%; min-height: 52px; padding: 8px 14px; border-radius: var(--r-md); border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text); text-align: start; line-height: 1.7; }
.option:not(:disabled):hover { border-color: var(--c-brand); background: var(--c-brand-soft); }
.option:disabled { cursor: default; opacity: 1; }
.option-key { flex: none; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--c-border-strong); color: var(--c-text-2); font-size: var(--fs-sm); font-weight: 700; }
.option-text { flex: 1; min-width: 0; unicode-bidi: plaintext; text-align: right; }
.option.correct { border-color: var(--c-done); background: var(--c-done-soft); }
.option.correct .option-key { background: var(--c-done); border-color: var(--c-done); color: var(--c-bg); }
.option.wrong { border-color: var(--c-danger); background: var(--c-danger-soft); }
.option.wrong .option-key { background: var(--c-danger); border-color: var(--c-danger); color: var(--c-bg); }
.option.dim { color: var(--c-text-2); border-color: var(--c-border); }
.feedback { display: grid; gap: var(--s-2); justify-items: start; margin-top: var(--s-3); padding: var(--s-3) var(--s-4); border-radius: var(--r-md); border-inline-start: 4px solid var(--c-danger); background: var(--c-danger-soft); }
.feedback.ok { border-inline-start-color: var(--c-done); background: var(--c-done-soft); }
.feedback-head { display: flex; align-items: center; gap: var(--s-2); color: var(--c-danger); }
.feedback.ok .feedback-head { color: var(--c-done); }
.feedback p { margin: 0; }
.feedback-answer b { unicode-bidi: isolate; }
.quiz-set { display: grid; gap: var(--s-4); }
.quiz-summary { display: grid; gap: var(--s-2); justify-items: start; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--c-surface-2); }
.quiz-summary > .meter { width: 100%; }
.quiz-summary-row { display: flex; justify-content: space-between; gap: var(--s-3); width: 100%; flex-wrap: wrap; }
.check-intro, .check-result { padding: var(--s-6); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); }
.check-result { display: flex; align-items: center; gap: var(--s-6); flex-wrap: wrap; margin-bottom: var(--s-4); border-inline-start: 5px solid var(--c-review); }
.check-result.passed { border-inline-start-color: var(--c-done); }
.check-result .actions { margin-top: var(--s-3); }
.check-progress { display: grid; gap: var(--s-2); margin-bottom: var(--s-4); color: var(--c-text-2); font-size: var(--fs-sm); }

/* ---- library, labs, tools ---- */
.catalog { display: grid; gap: var(--s-6); }
.catalog-group { min-width: 0; }
.catalog-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-3); }
.catalog-head h2 { font-size: var(--fs-lg); }
.catalog-head h2 a { color: var(--c-text); }
.catalog-group + .catalog-group { margin-top: var(--s-6); }
.catalog > .catalog-group + .catalog-group { margin-top: 0; }
.row-link.s-locked b { color: var(--c-text-2); }
.glossary { display: grid; gap: var(--s-2); }
.term { padding: var(--s-3) var(--s-4); border-radius: var(--r-md); background: var(--c-surface); border: 1px solid var(--c-border); }
.term dt { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2); margin-bottom: 4px; }
.term dt b { font-size: var(--fs-lg); }
.lab-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--s-4); }
.lab-card { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-4); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); min-width: 0; }
.lab-card.is-done { border-color: var(--c-done); }
.lab-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-2); }
.lab-card-head h3 { font-size: var(--fs-md); line-height: 1.6; }
.lab-brief { flex: 1; margin: 0; color: var(--c-text-2); font-size: var(--fs-sm); }
.lab-card .meta-row { margin-top: 0; }
.lab-card .fold { margin: 0; }
.tool-group { margin-bottom: var(--s-6); }
.tool-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-3); }
.tool-tile { display: flex; align-items: center; gap: var(--s-3); min-height: 76px; padding: var(--s-3) var(--s-4); border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); color: var(--c-text); }
.tool-tile:hover { border-color: var(--c-brand); text-decoration: none; }
.tool-tile-icon { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: var(--r-md); background: var(--c-brand-soft); color: var(--c-brand); }
.tool-tile-copy { flex: 1; min-width: 0; display: grid; line-height: 1.6; }
.tool-tile-copy small { color: var(--c-text-2); }

/* ---- lab workspace ---- */
.ws-head { margin-bottom: var(--s-4); }
.ws-title { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-3); }
.ws-tabs { display: none; }
.ws-grid { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(300px, 1fr); gap: var(--s-4); align-items: start; }
.ws-col { display: grid; gap: var(--s-4); min-width: 0; }
.ws-col-side { position: sticky; top: calc(var(--top-h) + var(--s-3)); max-height: calc(100dvh - var(--top-h) - var(--s-5)); overflow-y: auto; }
.ws-pane { min-width: 0; padding: var(--s-4); }
.ws-sub { font-size: var(--fs-md); margin: var(--s-4) 0 var(--s-2); }
.ws-devices { display: flex; flex-wrap: wrap; gap: var(--s-2); }
.device-pill { display: inline-flex; align-items: baseline; gap: 6px; min-height: 40px; padding: 4px 12px; border-radius: var(--r-sm); border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text); font-family: var(--font-mono); font-size: var(--fs-sm); font-weight: 700; }
.device-pill small { color: var(--c-text-3); font-weight: 400; font-size: var(--fs-xs); }
.device-pill:hover { border-color: var(--c-brand); }
.device-pill.active { background: var(--c-primary); border-color: var(--c-primary); color: var(--c-on-primary); }
.device-pill.active small { color: var(--c-on-primary); opacity: .85; }
.ws-ifaces { margin-top: var(--s-3); }
.ws-iface-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-2); }
.goal-list { display: grid; gap: var(--s-2); margin-top: var(--s-3); }
.goal-list li { display: flex; align-items: flex-start; gap: var(--s-3); padding: 10px 12px; border-radius: var(--r-md); background: var(--c-surface-2); border: 1px solid transparent; line-height: 1.7; }
.goal-list li > .check-mark { margin-top: 3px; }
.goal-list li.pass { background: var(--c-done-soft); }
.goal-list li small { display: block; unicode-bidi: plaintext; text-align: right; }

@media (max-width: 1100px) {
  .ws-grid { grid-template-columns: minmax(0, 1fr); }
  .ws-col-side { position: static; max-height: none; overflow: visible; }
  .ws-col { display: contents; }
  .ws-tabs { position: sticky; top: var(--top-h); z-index: 20; display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; padding: var(--s-2) 0; margin-bottom: var(--s-2); background: var(--c-bg); }
  .ws-tabs button { display: grid; justify-items: center; gap: 2px; min-height: 52px; padding: 4px; border-radius: var(--r-sm); border: 1px solid var(--c-border); background: var(--c-surface); color: var(--c-text-2); font-size: var(--fs-xs); font-weight: 700; }
  .ws-tabs button.active { border-color: var(--c-brand); background: var(--c-brand-soft); color: var(--c-brand); }
  .ws-tabs button > span { display: inline-flex; align-items: center; gap: 4px; }
  .ws-pane { display: none; }
  .ws-pane.pane-active { display: block; }
}
@media (max-width: 860px) {
  .hero, .path-hero { grid-template-columns: minmax(0, 1fr); padding: var(--s-4); gap: var(--s-4); }
  .hero-side, .path-hero-ring { grid-auto-flow: column; justify-content: start; align-items: center; gap: var(--s-3); }
  .hero-side .ring, .path-hero-ring .ring { width: 64px !important; height: 64px !important; }
  .hero-side .ring-value, .path-hero-ring .ring-value { font-size: var(--fs-sm); }
  .hero-copy h1 { font-size: 1.35rem; }
  .hero .actions .btn.lg { flex: 1 1 100%; }
  .stat-grid { grid-template-columns: 1fr 1fr; gap: var(--s-2); }
  .stat-tile { padding: var(--s-3); }
  .stat-grid > :last-child:nth-child(odd) { grid-column: 1 / -1; }
  .stat-icon { display: none; }
  .dash-grid { grid-template-columns: minmax(0, 1fr); }
  .card, .lesson-block, .question, .check-intro, .check-result { padding: var(--s-4); }
  .stage-desc { display: none; }
  .fold.stage > summary { padding-inline: 12px; }
  .fold.stage > .fold-body { padding: var(--s-1); }
  .map-item { padding-inline: 8px; }
  .map-steps { display: none; }
  .stepper { margin-inline: calc(var(--s-3) * -1); padding-inline: var(--s-2); }
  .stepper-item { min-width: 64px; font-size: var(--fs-xs); }
  .walk-step { grid-template-columns: minmax(0, 1fr); }
  .walk-num { width: 28px; height: 28px; }
  .step-foot { position: sticky; bottom: calc(var(--bottom-h) + env(safe-area-inset-bottom)); z-index: 15; margin-inline: calc(var(--s-3) * -1); padding: var(--s-2) var(--s-3); background: var(--c-bg); border-top: 1px solid var(--c-border); flex-wrap: nowrap; }
  .step-foot > :last-child { flex: 1; min-width: 0; }
  .step-foot .btn { white-space: normal; text-align: center; }
  .step-foot .actions { justify-content: flex-end; flex-wrap: nowrap; }
  .next-box .btn { width: 100%; }
  .question-text { font-size: var(--fs-md); }
  .ws-title { flex-direction: column; }
  .toolbar .search-box { max-width: none; flex-basis: 100%; }
  .segmented { max-width: 100%; overflow-x: auto; flex-wrap: nowrap; }
  .segmented button { white-space: nowrap; }
  table.data { font-size: var(--fs-xs); }
  .spec-compact dt { width: 7em; }
}
/* the dot at the start of a row already says "not started"; no second marker at the end */
.map-side .status-compact, .stage-side .status-idle, .row-link > .step-dot ~ .status-compact { display: none; }

/* ---- Long-form concept text («شرح کامل») ---------------------------------------------------------- */
.deep { display: grid; gap: var(--s-4); min-width: 0; }
.deep-head h3, .deep-extra > h3 { display: flex; align-items: center; gap: var(--s-2); }
.deep-head p { margin: 4px 0 0; }
.deep-toc { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; counter-reset: deep; }
.deep-toc li { counter-increment: deep; }
.deep-toc a { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 3px 12px; border-radius: var(--r-pill); border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text-2); font-size: var(--fs-sm); }
.deep-toc a::before { content: counter(deep, persian); color: var(--c-brand); font-weight: 700; }
.deep-toc a:hover { color: var(--c-text); border-color: var(--c-brand); text-decoration: none; }
.deep-section { scroll-margin-top: calc(var(--top-h) + 76px); }
.deep-section > h3 { display: flex; align-items: center; gap: var(--s-2); margin-bottom: var(--s-3); font-size: var(--fs-lg); }
.deep-section .prose { max-width: 78ch; }
.deep-section .prose p, .deep-section .prose li { line-height: 2.05; }
.deep-section .prose .rich-list { display: grid; gap: 6px; }
 .learning-lens { display: grid; grid-template-columns: auto 1fr; gap: 10px 12px; align-items: start; margin: 0 0 var(--s-4); padding: 14px 16px; border: 1px solid var(--c-border); border-inline-start: 3px solid var(--c-brand); border-radius: var(--r-lg); background: linear-gradient(120deg, var(--c-brand-soft), var(--c-surface)); }
 .learning-lens-icon { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; color: var(--c-brand); background: var(--c-surface); }
 .learning-lens h3 { margin: 0 0 3px; font-size: var(--fs-md); }
 .learning-lens p { margin: 0; line-height: 1.9; color: var(--c-text-2); }
 .learning-lens .lens-meta { grid-column: 2; color: var(--c-text-3); font-size: var(--fs-sm); }
@media (max-width: 600px) { .learning-lens { padding: 12px; } }
.deep-box { display: flex; gap: var(--s-3); align-items: flex-start; padding: var(--s-3) var(--s-4); border-radius: var(--r-md); border: 1px solid var(--c-border); border-inline-start: 4px solid var(--c-brand); background: var(--c-brand-soft); }
.deep-box p { margin: 0; }
.deep-box-icon { flex: none; margin-top: 6px; color: var(--c-brand); }
.deep-warn { border-inline-start-color: var(--c-review); background: var(--c-review-soft); }
.deep-warn .deep-box-icon { color: var(--c-review); }
.deep-extra { display: grid; gap: var(--s-3); margin-top: var(--s-2); }

/* ---- Term cards: Persian equivalent + link to the lesson that teaches the topic ------------------ */
.gloss { border-bottom: 1.5px dashed color-mix(in srgb, var(--c-brand) 70%, transparent); cursor: help; border-radius: 3px; transition: background .15s; }
.gloss:hover, .gloss[aria-expanded="true"] { background: var(--c-brand-soft); border-bottom-style: solid; }
.gloss:focus-visible { outline: 2px solid var(--c-brand); outline-offset: 2px; }
.term-pop { position: fixed; z-index: 400; display: grid; gap: var(--s-2); padding: var(--s-3) var(--s-4); border-radius: var(--r-md); border: 1px solid var(--c-border-strong); background: var(--c-surface); color: var(--c-text); box-shadow: var(--sh-2); font-size: var(--fs-sm); line-height: 1.8; animation: fam4-in .14s ease-out; }
.term-pop p { margin: 0; }
.term-pop-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; }
.term-pop-head b { font-size: var(--fs-md); color: var(--c-brand); }
.term-pop-full { color: var(--c-text-2); font-size: var(--fs-xs); }
.term-pop-tag { display: inline-block; margin-inline-end: 8px; padding: 0 8px; border-radius: var(--r-pill); background: var(--c-brand-soft); color: var(--c-brand); font-size: var(--fs-xs); font-weight: 700; white-space: nowrap; }
.term-pop-fa { font-weight: 700; }
.term-pop-def { color: var(--c-text-2); }
.term-pop-links { display: grid; gap: 4px; justify-items: start; padding-top: var(--s-2); border-top: 1px solid var(--c-border); }
.term-pop-links a { display: inline-flex; align-items: center; gap: 6px; min-height: 30px; font-weight: 700; }
.term-pop-note { display: flex; align-items: center; gap: 6px; color: var(--c-done); font-size: var(--fs-xs); }
.term-pop-more { font-size: var(--fs-xs); color: var(--c-text-2); }

