C\u200C\u062F\u0627\u0631\u062F \u062A\u0627 \u0646\u0631\u062E \u0645\u062A\u0648\u0633\u0637 \u062D\u0641\u0638 \u0634\u0648\u062F. \u062A\u0641\u0627\u0648\u062A \u0639\u0645\u0644\u06CC: \u067E\u0644\u06CC\u0633\u06CC\u0646\u06AF \u0628\u0633\u062A\u0647 \u0631\u0627 \u0645\u06CC\u200C\u0627\u0646\u062F\u0627\u0632\u062F (retransmission \u0648 \u06A9\u0646\u062F\u06CC)\u060C \u0634\u0627\u067E\u06CC\u0646\u06AF \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648\u0644\u06CC \u0631\u06CC\u0632\u0634 \u0646\u062F\u0627\u0631\u062F.","\u067E\u0627\u0631\u0627\u0645\u062A\u0631\u0647\u0627\u06CC \u0645\u0647\u0645: CIR (\u0646\u0631\u062E \u0645\u062A\u0648\u0633\u0637)\u060C Bc (\u0628\u0648\u0631\u0633\u062A \u0642\u0627\u0628\u0644 \u0642\u0628\u0648\u0644) \u0648 Be (\u0628\u0648\u0631\u0633\u062A \u0627\u0636\u0627\u0641\u0647). \u0627\u06AF\u0631 CIR \u0648 Bc \u0631\u0627 \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u06CC\u060C \u0634\u0627\u067E\u06CC\u0646\u06AF \u0628\u0627\u0639\u062B \u0645\u06CC\u200C\u0634\u0648\u062F \u0635\u0641 \u0635\u062F\u0627 \u0647\u0645 \u062A\u062D\u062A \u062A\u0623\u062B\u06CC\u0631 \u0642\u0631\u0627\u0631 \u0628\u06AF\u06CC\u0631\u062F. \u0641\u0631\u0645\u0648\u0644 \u0633\u0627\u062F\u0647: Tc = Bc / CIR \u0648 \u0628\u0631\u0627\u06CC \u0635\u062F\u0627 Tc \u06A9\u0648\u0686\u06A9\u200C\u062A\u0631 \u0628\u0647\u062A\u0631 \u0627\u0633\u062A."],list:["Policing: \u0648\u0631\u0648\u062F\u06CC \xB7 drop \u06CC\u0627 re-mark \xB7 \u0628\u062F\u0648\u0646 \u062A\u0623\u062E\u06CC\u0631","Shaping: \u062E\u0631\u0648\u062C\u06CC \xB7 buffer \xB7 \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647","CIR \xB7 Bc \xB7 Be \xB7 Tc = Bc/CIR","\u0647\u0645\u06CC\u0634\u0647 \u0628\u0647 BANK-WAN \u0628\u06AF\u0648 \u0646\u0631\u062E \u0648\u0627\u0642\u0639\u06CC \u0633\u0631\u0648\u06CC\u0633 \u0686\u0642\u062F\u0631 \u0627\u0633\u062A (\u0646\u0647 \u0646\u0631\u062E \u062E\u0637)"]},{h:"\u0635\u0641\u200C\u0647\u0627",p:["LLQ \u06CC\u06A9 \u0635\u0641 \u0627\u0648\u0644\u0648\u06CC\u062A\u200C\u062F\u0627\u0631 \u062F\u0627\u0631\u062F \u06A9\u0647 \u0642\u0628\u0644 \u0627\u0632 \u0647\u0645\u0647 \u0633\u0631\u0648\u06CC\u0633 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 \u0628\u0627 \u06CC\u06A9 policing \u062F\u0627\u062E\u0644\u06CC \u0645\u062D\u062F\u0648\u062F \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646 \u0645\u062D\u062F\u0648\u062F\u06CC\u062A\u060C \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0635\u062F\u0627 \u0628\u0642\u06CC\u0647 \u0635\u0641\u200C\u0647\u0627 \u0631\u0627 \u06AF\u0631\u0633\u0646\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F. CBWFQ \u0628\u0642\u06CC\u0647 \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F \u0631\u0627 \u0628\u0627 \u0648\u0632\u0646 \u0628\u06CC\u0646 \u06A9\u0644\u0627\u0633\u200C\u0647\u0627 \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. WRED \u0642\u0628\u0644 \u0627\u0632 \u067E\u0631 \u0634\u062F\u0646 \u0635\u0641\u060C \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC TCP \u0631\u0627 \u0628\u0627 \u0627\u062D\u062A\u0645\u0627\u0644 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u0627\u0646\u062F\u0627\u0632\u062F \u062A\u0627 \u062C\u0631\u06CC\u0627\u0646\u200C\u0647\u0627 \u0646\u0631\u0645\u200C\u062A\u0631 \u0639\u0642\u0628 \u0628\u06A9\u0634\u0646\u062F.","\u0628\u0631\u0627\u06CC \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC: class-map \u0628\u0631\u0627\u06CC \u0647\u0631 \u06A9\u0644\u0627\u0633\u060C policy-map \u0628\u0627 priority percent \u0648 bandwidth remaining percent\u060C \u0648 service-policy output \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633. \u0628\u0631\u0627\u06CC \u0635\u062F\u0627 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u06F1\u06F0 \u062A\u0627 \u06F2\u06F0 \u062F\u0631\u0635\u062F \u067E\u0647\u06