E\u06CC\u0631."],["WRED","\u062D\u0630\u0641 \u0632\u0648\u062F\u0647\u0646\u06AF\u0627\u0645 \u0628\u0633\u062A\u0647 \u0628\u0631\u0627\u06CC \u062C\u0644\u0648\u06AF\u06CC\u0631\u06CC \u0627\u0632 \u0627\u0632\u062F\u062D\u0627\u0645."],["NBAR","\u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u0631\u0646\u0627\u0645\u0647 \u062D\u062A\u06CC \u0648\u0642\u062A\u06CC \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC\u200C\u0634\u062F\u0647 \u0627\u0633\u062A."]]},mpls:{prereq:["static-routing"],related:["sp-mpls-vpn","sp-sr","sp-isis"],title:"MPLS \u0648 VRF \u2014 \u0633\u0631\u0648\u06CC\u0633 \u0686\u0646\u062F\u0645\u0634\u062A\u0631\u06CC \u0631\u0648\u06CC \u06CC\u06A9 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A",tagline:"MPLS \u0628\u0633\u062A\u0647 \u0631\u0627 \u0628\u0627 \u0628\u0631\u0686\u0633\u0628 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F\u060C \u0646\u0647 \u0628\u0627 \u0622\u062F\u0631\u0633 IP\u061B \u0647\u0645\u06CC\u0646 \u0633\u0627\u062F\u06AF\u06CC\u060C \u0634\u0628\u06A9\u0647 \u0627\u067E\u0631\u0627\u062A\u0648\u0631 \u0631\u0627 \u0645\u0642\u06CC\u0627\u0633\u200C\u067E\u0630\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F.",minutes:15,goals:["\u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC \u0686\u0631\u0627 MPLS \u0627\u0635\u0644\u0627\u064B \u0628\u0647 \u0648\u062C\u0648\u062F \u0622\u0645\u062F \u0648 label switching \u0686\u0647 \u0645\u0632\u06CC\u062A\u06CC \u062F\u0627\u0631\u062F","\u062A\u0641\u0627\u0648\u062A VRF \u0648 VRF-lite \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC RD \u0648 RT \u0686\u0647 \u06A9\u0627\u0631\u06CC \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F","\u0645\u0633\u06CC\u0631 \u0628\u0633\u062A\u0647 \u062F\u0631 MPLS L3VPN \u0631\u0627 \u0627\u0632 CE \u062A\u0627 CE \u062F\u0646\u0628\u0627\u0644 \u06A9\u0646\u06CC"],sections:[{h:"\u0686\u0631\u0627 \u0628\u0631\u0686\u0633\u0628\u061F",p:["\u062F\u0631 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC\u060C \u0647\u0631 \u0631\u0648\u062A\u0631 \u0628\u0627\u06CC\u062F \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631 \u06A9\u0627\u0645\u0644 \u0631\u0627 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F \u0648 \u0628\u0631\u0627\u06CC \u0647\u0631 \u0628\u0633\u062A\u0647\u060C \u0637\u0648\u0644\u0627\u0646\u06CC\u200C\u062A\u0631\u06CC\u0646 \u062A\u0637\u0628\u06CC\u0642 \u0631\u0627 \u062D\u0633\u0627\u0628 \u06A9\u0646\u062F. \u062F\u0631 \u0634\u0628\u06A9\u0647 \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u06CC \u0628\u0627 \u0645\u06CC\u0644\u06CC\u0648\u0646\u200C\u0647\u0627 \u0645\u0633\u06CC\u0631\u060C \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0633\u0646\u06AF\u06CC\u0646 \u0627\u0633\u062A. MPLS \u0628\u0647\u200C\u062C\u0627\u06CC \u0627\u06CC\u0646\u060C \u06CC\u06A9 \u0628\u0631\u0686\u0633\u0628 \u06A9\u0648\u062A\u0627\u0647 (\u06F2\u06F0 \u0628\u06CC\u062A) \u0628\u0647 \u0628\u0633\u062A\u0647 \u0645\u06CC\u200C\u0686\u0633\u0628\u0627\u0646\u062F \u0648 \u0631\u0648\u062A\u0631\u0647\u0627\u06CC \u0645\u06CC\u0627\u0646\u06CC \u0641\u0642\u0637 \u0628\u0627 \u062C\u062F\u0648\u0644 \u0628\u0631\u0686\u0633\u0628 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F: \u0628\u0631\u0686\u0633\u0628 \u0631\u0627 \u0639\u0648\u0636 \u06A9\u0646 \u0648 \u0628\u0647 \u067E\u0648\u0631\u062A \u0628\u0639\u062F\u06CC \u0628\u0641\u0631\u0633\u062A (label swap).","\u0645\u0632\u06CC\u062A \u062F\u0648\u0645 \u0648 \u0645\u0647\u0645\u200C\u062A\u0631: \u0628\u0631\u0686\u0633\u0628 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0686\u0646\u062F \u0644\u0627\u06CC\u0647 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F (label stack). \u0627\u06CC\u0646 \u0627\u0645\u06A9\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F \u0686\u0646\u062F \u0633\u0631\u0648\u06CC\u0633 \u0631\u0648\u06CC \u06CC\u06A9 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0627\u062C\u0631\u0627 \u0634\u0648\u062F \u0648 \u0628\u0633\u062A\u0647\u060C \u0647\u0645 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0645\u0633\u06CC\u0631 \u0648 \u0647\u0645 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0633\u0631\u0648\u06CC\u0633 (\u0645\u0634\u062A\u0631\u06CC) \u0631\u0627 \u0628\u0627 \u062E\u0648\u062F\u0634 \u062D\u0645\u0644 \u06A9\u0646\u062F. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 MPLS \u067E\u0627\u06CC\u0647 \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627\u06CC \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u06CC (L3VPN\u060C L2VPN\u060C TE) \u0627\u0633\u062A."]},{h:"VRF: \u0686\u0646\u062F \u0631\u0648\u062A\u0631 \u062F\u0631 \u06CC\u06A9 \u0631\u0648\u062A\u0631",p:["\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u06CC\u06A9 \u0627\u067E\u0631\u0627\u062A\u0648\u0631 \u0628\u0647 \u0647\u0632\u0627\u0631 \u0645\u0634\u062A\u0631\u06CC \u0633\u0631\u0648\u06CC\u0633 \u0628\u062F\u0647\u062F\u060C \u0628\u0627\u06CC\u062F \u062C\u062F\u0648\u0644\u200C\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631 \u062C\u062F\u0627 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F. VRF \u062F\u0642\u06CC\u0642\u0627\u064B \u0647\u0645\u06CC\u0646 \u0627\u0633\u062A: \u06CC\u06A9 \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0633\u062A\u0642\u0644 \u0628\u0627 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633\u200C\u0647\u0627\u06CC \u062E\u0648\u062F\u0634. \u0628\u0627 VRF-lite \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0628\u062F\u0648\u0646 MPLS\u060C \u0641\u0642\u0637 \u0631\u0648\u06CC \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u0686\u0646\u062F \u062C\u062F\u0648\u0644 \u062C\u062F\u0627 \u062F\u0627\u0634\u062A.","\u0648\u0642\u062A\u06CC \u0686\u0646\u062F VRF \u062F\u0627\u0631\u06CC\u060C \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627\u06CC \u06CC\u06A9\u0633\u0627\u0646 (\u0645\u062B\u0644\u0627\u064B 192.168.1.0/24 \u062F\u0631 \u062F\u0648 \u0645\u0634\u062A\u0631\u06CC) \u0628\u0627\u06CC\u062F \u0627\u0632 \u0647\u0645 \u062A\u0641\u06A9\u06CC\u06A9 \u0634\u0648\u0646\u062F. \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0628\u0627 RD \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u06CC\u06A9 \u0639\u062F\u062F \u06F6\u06F4 \u0628\u06CC\u062A\u06CC \u06A9\u0647 \u0628\u0647 \u0627\u0628\u062A\u062F\u0627\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F \u0645\u06CC\u200C\u0686\u0633\u0628\u062F \u0648 \u0622\u0646 \u0631\u0627 \u06CC\u06A9\u062A\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0645\u0627 \u062A\u0635\u0645\u06CC\u0645 \xAB\u06A9\u062F\u0627\u0645 \u0645\u0633\u06CC\u0631 \u0648\u0627\u0631\u062F \u06A9\u062F\u0627\u0645 VRF \u0634\u0648\u062F\xBB \u0628\u0627 RT \u0627\u0633\u062A: \u06CC\u06A9 Community \u06A9\u0647 \u0647\u0646\u06AF\u0627\u0645 export \u0632\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0647\u0646\u06AF\u0627\u0645 import \u0645\u0642\u0627\u06CC\u0633\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u0634\u062A\u0628\u0627\u0647 \u062F\u0631 RT\u060C \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u062F\u0644\u06CC\u0644 \xAB\u0645\u0633\u06CC\u0631 \u0647\u0633\u062A \u0648\u0644\u06CC \u0646\u0635\u0628 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\xBB \u0627\u0633\u062A."],callout:{title:"RD \u0648 RT \u062F\u0631 \u06CC\u06A9 \u062C\u0645\u0644\u0647",text:"RD \u06CC\u06A9\u062A\u0627\u06CC\u06CC \u0645\u06CC\u200C\u062F\u0647\u062F (\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u062C\u062F\u0648\u0644\u200C\u0647\u0627 \u0642\u0627\u0637\u06CC \u0646\u0634\u0648\u0646\u062F)\u060C RT \u0633\u06CC\u0627\u0633\u062A \u0645\u06CC\u200C\u062F\u0647\u062F (\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u0628\u062F\u0627\u0646\u06CC \u0686\u0647 \u0686\u06CC\u0632\u06CC \u0631\u0627 \u06A9\u062C\u0627 \u0628\u0628\u0631\u06CC)."}},{h:"\u0645\u0633\u06CC\u0631 \u0628\u0633\u062A\u0647 \u062F\u0631 L3VPN",p:["CE (\u0631\u0648\u062A\u06