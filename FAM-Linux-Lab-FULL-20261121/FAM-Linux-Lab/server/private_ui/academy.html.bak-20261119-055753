      for(const [key,value] of Object.entries({x1,y1,x2,y2}))line.setAttribute(key,value);
      if(ref.label){ref.label.setAttribute('x',(x1+x2)/2);ref.label.setAttribute('y',(y1+y2)/2-5)}
