\u06CC\u06A9 \u062E\u0631\u0648\u062C\u06CC \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645 hash \u0628\u0647 \u06CC\u06A9 \u0639\u0636\u0648 \u0645\u06CC\u200C\u0631\u0648\u062F \u0648 \u0627\u0644\u0632\u0627\u0645\u0627\u064B \u062F\u0648 \u06AF\u06CC\u06AF\u0627\u0628\u06CC\u062A \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u062E\u0631\u0627\u0628\u06CC \u06CC\u06A9 \u0639\u0636\u0648 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062C\u0631\u06CC\u0627\u0646\u200C\u0647\u0627\u06CC \u0622\u0646 \u0631\u0627 \u0628\u0647 \u0627\u0639\u0636\u0627\u06CC \u0628\u0627\u0642\u06CC\u0645\u0627\u0646\u062F\u0647 \u0645\u0646\u062A\u0642\u0644 \u06A9\u0646\u062F\u061B \u0638\u0631\u0641\u06CC\u062A \u0628\u0627\u0642\u06CC\u0645\u0627\u0646\u062F\u0647 \u0648 \u0633\u06CC\u0627\u0633\u062A \u062D\u062F\u0627\u0642\u0644 \u0644\u06CC\u0646\u06A9 \u0631\u0627 \u062C\u062F\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646.","\u0627\u0632 show etherchannel summary \u0628\u0631\u0627\u06CC \u0648\u0636\u0639\u06CC\u062A \u06AF\u0631\u0648\u0647 \u0648 \u0639\u0636\u0648\u0647\u0627 \u0648 \u0627\u0632 show lacp neighbor \u0628\u0631\u0627\u06CC \u0645\u0630\u0627\u06A9\u0631\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646. \u0627\u06AF\u0631 \u0639\u0636\u0648 suspended \u0627\u0633\u062A\u060C mode\u060C \u0633\u0631\u0639\u062A\u060C native \u0648 allowed VLAN \u0631\u0627 \u062F\u0631 \u062F\u0648 \u0637\u0631\u0641 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646. \u062A\u0646\u0638\u06CC\u0645 \u062F\u0633\u062A\u06CC mode on \u0628\u0647\u200C\u0645\u0639\u0646\u06CC \u0645\u0630\u0627\u06A9\u0631\u0647 LACP \u0646\u06CC\u0633\u062A \u0648 \u0639\u062F\u0645 \u062A\u0637\u0627\u0628\u0642 \u062F\u0648 \u0637\u0631\u0641 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062E\u0637\u0631 \u0627\u06CC\u062C\u0627\u062F \u062D\u0644\u0642\u0647 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\u061B [[vlan-trunk|\u062A\u0631\u0627\u0646\u06A9]] \u0631\u0627 \u0645\u0631\u0648\u0631 \u06A9\u0646."],"l2-security":["\u0627\u0645\u0646\u06CC\u062A \u062F\u0633\u062A\u0631\u0633\u06CC \u0644\u0627\u06CC\u0647 \u06F2 \u0628\u0631 \u067E\u0627\u06CC\u0647 \u062A\u0639\u06CC\u06CC\u0646 \u0645\u0631\u0632 \u0627\u0639\u062A\u0645\u0627\u062F \u0627\u0633\u062A. DHCP Snooping \u067E\u0627\u0633\u062E DHCP \u0631\u0627 \u0641\u0642\u0637 \u0627\u0632 \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC trusted \u0645\u06CC\u200C\u067E\u0630\u06CC\u0631\u062F \u0648 \u062F\u0631 \u0635\u0648\u0631\u062A \u0645\u0648\u0641\u0642\u06CC\u062A\u060C binding \u0622\u062F\u0631\u0633 IP\u060C MAC\u060C VLAN \u0648 \u067E\u0648\u0631\u062A \u0627\u06CC\u062C\u0627\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F. Dynamic ARP Inspection \u06CC\u0627 DAI \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u062F\u0639\u0627\u0647\u0627\u06CC ARP \u0631\u0627 \u0628\u0627 binding \u06CC\u0627 ACL \u0645\u0646\u0627\u0633\u0628 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646\u062F\u061B IP Source Guard \u0646\u06CC\u0632 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u0628\u062F\u0623 \u0631\u0627 \u0645\u062D\u062F\u0648\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u062F\u0631 \u062D\u0645\u0644\u0647 \u062C\u0639\u0644 ARP\u060C \u0645\u0647\u0627\u062C\u0645 \u0645\u062F\u0639\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F IP \u062F\u0631\u0648\u0627\u0632\u0647 \u0628\u0647 MAC \u0627\u0648 \u062A\u0639\u0644\u0642 \u062F\u0627\u0631\u062F. \u0627\u06AF\u0631 DAI \u0641\u0639\u0627\u0644 \u0648 binding \u0645\u0639\u062A\u0628\u0631 \u0645\u0648\u062C\u0648\u062F \u0628\u0627\u0634\u062F\u060C \u0633\u0648\u0626\u06CC\u0686 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u067E\u06CC\u0627\u0645 \u0646\u0627\u0633\u0627\u0632\u06AF\u0627\u0631 \u062F\u0631\u06CC\u0627\u0641\u062A\u06CC \u0627\u0632 \u067E\u0648\u0631\u062A untrusted \u0631\u0627 \u0631\u062F \u06A9\u0646\u062F. Port Security \u0645\u062D\u062F\u0648\u062F\u06CC