F\u0647\u062F.","PIM \u0628\u06CC\u0646 \u0631\u0648\u062A\u0631\u0647\u0627 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062F\u0631\u062E\u062A \u062A\u0648\u0632\u06CC\u0639 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F. PIM Dense Mode \u0628\u0627 \u0633\u06CC\u0644 \u06A9\u0631\u062F\u0646 \u0648 \u0647\u0631\u0633 \u06A9\u0631\u062F\u0646 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0642\u062F\u06CC\u0645\u06CC \u0648 \u0628\u06CC\u200C\u0631\u062D\u0645)\u060C PIM Sparse Mode \u0628\u0627 \u06CC\u06A9 \u0646\u0642\u0637\u0647 \u0645\u0631\u06A9\u0632\u06CC \u0628\u0647 \u0646\u0627\u0645 RP (Rendezvous Point) \u0648 \u062B\u0628\u062A\u200C\u0646\u0627\u0645 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062F\u0631 SM \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0628\u0627 (*,G) join \u0628\u0647 \u0633\u0645\u062A RP \u0645\u06CC\u200C\u0631\u0648\u062F \u0648 \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u0647\u0645 \u0628\u0627 \u062B\u0628\u062A (*,G) \u0628\u0647 RP \u0645\u06CC\u200C\u0631\u0633\u062F\u061B \u0628\u0639\u062F \u0627\u0632 \u0628\u0631\u0642\u0631\u0627\u0631\u06CC\u060C \u0634\u0628\u06A9\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u0633\u06CC\u0631 \u0645\u0633\u062A\u0642\u06CC\u0645 \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631 (S,G) \u0628\u0633\u0627\u0632\u062F."],callout:{title:"\u0646\u06A9\u062A\u0647 \u0645\u0647\u0645",text:"PIM \u0628\u0631\u0627\u06CC \u0627\u0646\u062A\u062E\u0627\u0628 \u0647\u0645\u0633\u0627\u06CC\u0647 \u0628\u0627\u0644\u0627\u062F\u0633\u062A\u06CC \u0648 \u0628\u0631\u0631\u0633\u06CC RPF \u0628\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u062F\u0633\u062A\u0631\u0633\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F\u061B \u0627\u06CC\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0632 \u0645\u0633\u06CC\u0631\u0647\u0627\u06C