627\u06CC \u06A9\u0647 \u0627\u0632 \u06F1\u06F2 \u0646\u0648\u0627\u0645\u0628\u0631 \u06F2\u06F0\u06F2\u06F6 \u0634\u0631\u0648\u0639 \u0634\u0648\u062F \u062A\u0627 \u06F1\u06F0 \u0641\u0648\u0631\u06CC\u0647 \u06F2\u06F0\u06F2\u06F7 \u0627\u062F\u0627\u0645\u0647 \u062F\u0627\u0631\u062F. \u0628\u0631\u0627\u06CC CCNP \u0645\u062F\u0631\u06A9 CCNA \u067E\u06CC\u0634\u200C\u0646\u06CC\u0627\u0632 \u0631\u0633\u0645\u06CC \u0646\u06CC\u0633\u062A\u060C \u0627\u0645\u0627 \u062F\u0627\u0646\u0633\u062A\u0646 \u0645\u0628\u0627\u0646\u06CC \u062A\u0648\u0635\u06CC\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F."],table:{head:["\u0647\u0641\u062A\u0647","\u0641\u0635\u0644\u200C\u0647\u0627","\u062E\u0631\u0648\u062C\u06CC \u0642\u0627\u0628\u0644 \u0633\u0646\u062C\u0634"],rows:[["\u06F1\u2013\u06F2","\u06F1 \u0648 \u06F2","\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC \u0647\u0631 \u0622\u062F\u0631\u0633 /\u06F2\u06F4 \u062A\u0627 /\u06F3\u06F0 \u0631\u0627 \u0631\u0648\u06CC \u06A9\u0627\u063A\u0630 \u062A\u062D\u0644\u06CC\u0644 \u06A9\u0646\u06CC"],["\u06F3","\u06F3 \u0648 \u06F4","\u0633\u0647\u200C\u06AF\u0627\u0645 TCP \u0631\u0627 \u0645\u06CC\u200C\u06A9\u0634\u06CC \u0648 \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u0631\u0627 \u0627\u0632 \u0635\u0641\u0631 \u06A9\u0627\u0646\u0641\u06CC\u06AF \u0645\u06CC\u200C\u06A9\u0646\u06CC"],["\u06F4\u2013\u06F5","\u06F5 \u0648 \u06F6","\u062F\u0648 VLAN \u0628\u0627 \u062A\u0631\u0627\u0646\u06A9 \u0648 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0628\u06CC\u0646\u200CVLAN \u062F\u0631 \u0634\u0628\u06CC\u0647\u200C\u0633\u0627\u0632"],["\u06F6","\u06F7","root bridge \u0631\u0627 \u0639\u0645\u062F\u0627\u064B \u062C\u0627\u0628\u0647\u200C\u062C\u0627 \u0645\u06CC\u200C\u06A9\u0646\u06CC \u0648 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u06CC"],["\u06F7\u2013\u06F8","\u06F8 \u0648 \u06F9","OSPF \u062F\u0648 \u0646\u0627\u062D\u06CC\u0647\u200C\u0627\u06CC \u0628\u0627 \u0647\u0645\u0633\u0627\u06CC\u06AF\u06CC \u06A9\u0627\u0645\u0644"],["\u06F9","\u06F1\u06F0","DHCP \u0648 NAT \u0648 ACL \u062F\u0631 \u06CC\u06A9 \u062A\u0648\u067E\u0648\u0644\u0648\u0698\u06CC \u06A9\u0648\u0686\u06A9"],["\u06F1\u06F0\u2013\u06F1\u06F1","\u06F1\u06F1 (IPv6) \u0648 \u06F1\u06F2","\u0634\u0628\u06A9\u0647 dual-stack \u0628\u0627 SLAAC \u0648 \u067E\u06CC\u0646\u06AF \u0633\u0631\u062A\u0627\u0633\u0631\u06CC"],["\u06F1\u06F2","\u06F1\u06F3 \u062A\u0627 \u06F1\u06F7 (\u0645\u0631\u0648\u0631)","\u0641\u0642\u0637 \u0645\u0631\u0648\u0631 \u0645\u0641\u0627\u0647\u06CC\u0645\u061B \u0647\u062F\u0641\u060C \u062F\u06CC\u062F\u0646 \u062A\u0635\u0648\u06CC\u0631 \u0628\u0632\u0631\u06AF \u0627\u0633\u062A"],["\u06F1\u06F3","\u06F2\u06F0 (\u06A9\u062A\u0627\u0628\u0686\u0647 \u062E\u0631\u0627\u0628\u06CC)","\u0633\u0647 \u062E\u0631\u0627\u0628\u06CC \u0639\u0645\u062F\u06CC \u0631\u0627 \u062F\u0631 \u06A9\u0645\u062A\u0631 \u0627\u0632 \u06F1\u06F0 \u062F\u0642\u06CC\u0642\u0647 \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u06CC"]]}},{h:"\u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06CC \u062F\u0627\u062E\u0644 \u0647\u0645\u06CC\u0646 \u0628\u0631\u0646\u0627\u0645\u0647",p:["\u{1F9EA} \u0622\u0632\u0645\u0627\u06CC\u0634\u06AF\u0627\u0647 \u0622\u0632\u0627\u062F: \u0634\u0628\u06A9\u0647 \u0628\u0633\u0627\u0632\u060C \u0633\u06CC\u0645 \u0628\u06A9\u0634\u060C \u067E\u06CC\u0646\u06AF \u0628\u06AF\u06CC\u0631 \u0648 \u062F\u0631\u0633\u200C\u0647\u0627 \u0631\u0627 \u0628\u0627 \xAB\u0628\u0631\u0631\u0633\u06CC \u06A9\u0627\u0631\xBB \u0628\u0633\u0646\u062C (\u06A9\u0644\u06CC\u062F N).","\u{1F9EE} \u0627\u0628\u0632\u0627\u0631 \u0633\u0627\u0628\u0646\u062A \u0648 TCP: \u0622\u062F\u0631\u0633 \u0631\u0627 \u0628\u062F\u0647 \u062A\u0627 \u0634\u0628\u06A9\u0647/\u0628\u0631\u0627\u062F\u06A9\u0633\u062A/\u0645\u06CC\u0632\u0628\u0627\u0646\u200C\u0647\u0627 \u0648 \u0646\u0645\u0627\u06CC\u0634 \u0628\u06CC\u062A\u06CC \u0631\u0627 \u0628\u0628\u06CC\u0646\u06CC\u061B \u0633\u0647\u200C\u06AF\u0627\u0645 TCP \u0648 \u067E\u0627\u06CC\u0627\u0646 \u0627\u062A\u0635\u0627\u0644 \u0631\u0627 \u06AF\u0627\u0645\u200C\u0628\u0647\u200C\u06AF\u0627\u0645 \u0628\u0628\u06CC\u0646 (\u06A9\u0644\u06CC\u062F U\u061B T \u067E\u0648\u0633\u062A\u0647 \u0631\u0627 \u0639\u0648\u0636 \u0645\u06CC\u200C\u06A9\u0646\u062F).","\u{1F4D8} \u062C\u0632\u0648\u0647: \u0647\u0645\u06CC\u0646 \u0645\u062A\u0646 \u0628\u0627 \u0622\u0632\u0645\u0648\u0646 \u06A9\u0648\u062A\u0627\u0647 \u0648 \u0627\u0634\u062A\u0628\u0627\u0647\u200C\u0647\u0627\u06CC \u0631\u0627\u06CC\u062C\u060C \u0647\u0645\u06CC\u0634\u0647 \u0622\u0641\u0644\u0627\u06CC\u0646.","\u{1F393} \u0622\u0632\u0645\u0627\u06CC\u0634\u200C\u0647\u0627\u06CC \u06AF\u0627\u0645\u200C\u0628\u0647\u200C\u06AF\u0627\u0645 \u0628\u0627 \u067E\u062E\u0634 \u0628\u0633\u062A\u0647: \u06F5\u06F4 \u0622\u0632\u0645\u0627\u06CC\u0634 \u0648 \u062A\u06CC\u06A9\u062A \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u06A9\u0647 \u062E\u0648\u062F\u0634\u0627\u0646 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F.","\u0627\u06CC\u0646 \u0686\u0647\u0627\u0631 \u0627\u0628\u0632\u0627\u0631 \u0628\u0627 \u0647\u0645 \u06CC\u06A9 \u062D\u0644\u0642\u0647 \u0645\u06CC\u200C\u0633\u0627\u0632\u0646\u062F: \u0628\u062E\u0648\u0627\u0646 \u2192 \u0628\u0628\u06CC\u0646 \u2192 \u0628\u0633\u0627\u0632 \u2192 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u06A9\u0646."]},{h:"\u0645\u0646\u0627\u0628\u0639 \u0627\u06CC\u0646 \u062C\u0632\u0648\u0647 (\u0648 \u0686\u06CC\u0632\u06CC \u06A9\u0647 \u0627\u0632 \u0622\u0646\u200C\u0647\u0627 \u06AF\u0631\u0641\u062A\u0647 \u0634\u062F\u0647)",p:["\u0645\u0641\u0627\u0647\u06CC\u0645 \u0648 \u062F\u0633\u062A\u0648\u0631\u0647\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u0633\u062A\u0646\u062F\u0627\u062A \u0631\u0633\u0645\u06CC \u0633\u06CC\u0633\u06A9\u0648 \u0646\u0648\u0634\u062A\u0647 \u0634\u062F\u0647\u200C\u0627\u0646\u062F: \u0641\u0647\u0631\u0633\u062A \u0633\u0631\u0641\u0635\u0644 \u0622\u0632\u0645\u0648\u0646\u200C\u0647\u0627 \u062F\u0631 Cisco Learning Network (CCNA 200-301\u060C ENCOR 350-401\u060C ENARSI 300-410\u060C SPCOR 350-501) \u0648 Configuration Guides \u0647\u0645\u0627\u0646 \u0646\u0633\u062E\u0647\u200C\u0647\u0627\u06CC IOS/IOS-XE. \u0628\u0631\u0627\u06CC \u0631\u0641\u062A\u0627\u0631 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627 \u062F\u0631 \u062C\u0627\u0647\u0627\u06CC\u06CC \u0628\u0647 RFC \u0627\u0631\u062C\u0627\u0639 \u062F\u0627\u062F\u0647 \u0634\u062F\u0647 \u0627\u0633\u062A (\u0645\u062B\u0644\u0627\u064B RFC 4271 \u0628\u0631\u0627\u06CC BGP \u0648 RFC 7348 \u0628\u0631\u0627\u06CC VXLAN).","\u0627\u0632 \u0645\u0646\u0627\u0628\u0639 \u0641\u0627\u0631\u0633\u06CC \u0627\u06CC\u0646\u200C\u0647\u0627 \u0631\u0627 \u0628\u0631\u0627\u06CC \u0647\u0645\u200C\u0627\u0631\u0632\u06CC \u0627\u0635\u0637\u0644\u0627\u062D\u200C\u0647\u0627 \u062F\u06CC\u062F\u0647\u200C\u0627\u0645 \u0648 \u062E\u0648\u0627\u0646\u062F\u0646\u0634\u0627\u0646 \u0631\u0627 \u0628\u0631\u0627\u06CC \u0645\u0631\u0648\u0631 \u067E\u06CC\u0634\u0646\u0647\u0627\u062F \u0645\u06CC\u200C\u06A9\u0646\u0645: \u062C\u0632\u0648\u0647 CCNA \u0641\u0627\u0631\u0633\u06CC (\u06F2\u06F7\u06F5 \u0635\u0641\u062D\u0647\u060C \u0641\u0631\u0634\u06CC\u062F \u0628\u0627\u0628\u0627\u062C\u0627\u0646\u06CC\u060C netsimulate.net)\u060C \u062C\u0632\u0648\u0647 CCNP (\u06F2\u06F4\u06F3 \u0635\u0641\u062D\u0647\u060C aghazeh.com) \u0648 \u06A9\u062A\u0627\u0628 CCNA \u0641\u0627\u0631\u0633\u06CC (\u06F5\u06F4\u06F0 \u0635\u0641\u062D\u0647\u060C \u0645\u0647\u062F\u06CC\u0647 \u062A\u0648\u06A9\u0644\u06CC\u060C sourcebaran.com).","\u0635\u0627\u062F\u0642\u0627\u0646\u0647: \u0627\u06CC\u0646 \u062C\u0632\u0648\u0647 \u062A\u0631\u062C\u0645\u0647 \u0647\u06CC\u0686\u200C\u06A9\u062F\u0627\u0645 \u0627\u0632 \u0622\u0646\u200C\u