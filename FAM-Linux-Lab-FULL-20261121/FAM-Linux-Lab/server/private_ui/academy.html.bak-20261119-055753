3\u06CC ([[acl|\u0641\u06CC\u0644\u062A\u0631\u06CC\u0646\u06AF ACL]]) \u062A\u0631\u0627\u0641\u06CC\u06A9\u06CC \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u06A9\u0647 \u0627\u0632 \u06CC\u06A9 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 \u0628\u0647 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 \u062F\u06CC\u06AF\u0631 \u06CC\u0627 \u0628\u0647 \u0633\u0645\u062A WAN بانک \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0645\u0627 \u0627\u06AF\u0631 \u06CC\u06A9 \u0644\u067E\u200C\u062A\u0627\u067E \u0622\u0644\u0648\u062F\u0647 \u06CC\u0627 \u0646\u0641\u0648\u0630\u06AF\u0631 \u062F\u0631 \u062F\u0627\u062E\u0644 \u0647\u0645\u0627\u0646 VLAN 10 \u062D\u0636\u0648\u0631 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0628\u062F\u0648\u0646 \u0631\u0633\u06CC\u062F\u0646 \u062D\u062A\u06CC \u06CC\u06A9 \u0628\u0633\u062A\u0647 \u0628\u0647 \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 \u06CC\u0627 \u0631\u0648\u062A\u0631\u060C \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0633\u0627\u06CC\u0631 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0647\u0645\u0627\u0646 \u0637\u0628\u0642\u0647 \u0631\u0627 \u0634\u0646\u0648\u062F \u06CC\u0627 \u062F\u0633\u062A\u200C\u06A9\u0627\u0631\u06CC \u06A9\u0646\u062F! \u0686\u0647\u0627\u0631 \u0628\u0631\u062F\u0627\u0631 \u062D\u0645\u0644\u0647 \u0627\u0635\u0644\u06CC \u062F\u0631 \u0644\u0627\u06CC\u0647 \u06F2 \u0639\u0628\u0627\u0631\u062A\u200C\u0627\u0646\u062F \u0627\u0632:","\u06F1) **\u0627\u0634\u0628\u0627\u0639 \u062C\u062F\u0648\u0644 \u0645\u06A9 (CAM Table Overflow / MAC Flooding):** \u062D\u0627\u0641\u0638\u0647 \u0633\u062E\u062A\u200C\u0627\u0641\u0632\u0627\u0631\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0638\u0631\u0641\u06CC\u062A \u0645\u062D\u062F\u0648\u062F\u06CC \u062F\u0627\u0631\u062F (\u0645\u062B\u0644\u0627\u064B \u06F1\u06F6 \u06CC\u0627 \u06F3\u06F2 \u0647\u0632\u0627\u0631 \u0622\u062F\u0631\u0633 MAC). \u0645\u0647\u0627\u062C\u0645 \u062F\u0631 \u0686\u0646\u062F \u062B\u0627\u0646\u06CC\u0647 \u062F\u0647\u200C\u0647\u0627 \u0647\u0632\u0627\u0631 \u0641\u0631\u06CC\u0645 \u0628\u0627 MAC \u0645\u0628\u062F\u0623 \u062A\u0635\u0627\u062F\u0641\u06CC \u062A\u0632\u0631\u06CC\u0642 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0648\u0642\u062A\u06CC \u062C\u062F\u0648\u0644 \u067E\u0631 \u0634\u0648\u062F\u060C \u0633\u0648\u0626\u06CC\u0686 \u0628\u0631\u0627\u06CC \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC \u062C\u062F\u06CC\u062F \u0686\u0627\u0631\u0647\u200C\u0627\u06CC \u062C\u0632 \u0633\u06CC\u0644\u0627\u0628 \u06A9\u0631\u062F\u0646 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627 \u0631\u0648\u06CC \u062A\u0645\u0627\u0645 \u067E\u0648\u0631\u062A\u200C\u0647\u0627 (\u0634\u0628\u06CC\u0647 \u06CC\u06A9 Hub \u0642\u062F\u06CC\u0645\u06CC!) \u0646\u062F\u0627\u0631\u062F. \u06F2) **\u0633\u0631\u0648\u0631 DHCP \u062C\u0639\u0644\u06CC (Rogue DHCP) \u0648 \u0642\u062D\u0637\u06CC \u0622\u062F\u0631\u0633 (DHCP Starvation):** \u0645\u0647\u0627\u062C\u0645 \u06CC\u0627 \u06A9\u0644 \u0627\u0633\u062A\u062E\u0631 IP \u0633\u0631\u0648\u0631 \u0627\u0635\u0644\u06CC \u0631\u0627 \u062E\u0627\u0644\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u06CC\u0627 \u0632\u0648\u062F\u062A\u0631 \u0627\u0632 \u0633\u0631\u0648\u0631 \u0627\u0635\u0644\u06CC \u067E\u0627\u0633\u062E \u062C\u0639\u0644\u06CC `DHCP Offer` \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u0622\u062F\u0631\u0633 \u0644\u067E\u200C\u062A\u0627\u067E \u062E\u0648\u062F\u0634 \u0631\u0627 \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646 Default Gateway \u0648 DNS \u0642\u0631\u0628\u0627\u0646\u06CC \u062B\u0628\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0631.\u06A9. [[dhcp|\u0645\u0631\u0627\u062D\u0644 DORA \u062F\u0631 DHCP]]). \u06F3) **\u0645\u0633\u0645\u0648\u0645\u200C\u0633\u0627\u0632\u06CC \u06A9\u0634 ARP (ARP Poisoning / MitM):** \u0645\u0647\u0627\u062C\u0645 \u0628\u0627 \u0627\u0631\u0633\u0627\u0644 \u067E\u0627\u0633\u062E ARP \u0628\u06CC\u200C\u062F\u0631\u062E\u0648\u0627\u0633\u062A \u0628\u0647 \u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631 \u0642\u0631\u0628\u0627\u0646\u06CC \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0622\u062F\u0631\u0633 MAC \u062F\u0631\u0648\u0627\u0632\u0647 `192.168.10.1` \u0645\u06A9 \u0645\u0646 \u0627\u0633\u062A\xBB \u0648 \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0628\u0647 \u0631\u0648\u062A\u0631 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0645\u06A9 \u0642\u0631\u0628\u0627\u0646\u06CC \u0647\u0645 \u0645\u06A9 \u0645\u0646 \u0627\u0633\u062A\xBB \u0648 \u062A\u0645\u0627\u0645 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u0648\u0637\u0631\u0641\u0647 \u0631\u0627 \u0627\u0632 \u062F\u0644 \u0633\u06CC\u0633\u062A\u0645 \u062E\u0648\u062F \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F! \u06F4) **\u067E\u0631\u0634 \u0628\u06CC\u0646 VLAN\u0647\u0627 (VLAN Hopping):** \u0633\u0648\u0621\u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 DTP \u06CC\u0627 \u0627\u0631\u0633\u0627\u0644 \u0641\u0631\u06CC\u0645 \u062F\u0648\u0645\u0631\u062A\u0628\u0647\u200C\u0628\u0631\u0686\u0633\u0628\u200C\u062E\u0648\u0631\u062F\u0647 \u0647\u0645\u200C\u0634\u0645\u0627\u0631\u0647 \u0628\u0627 Native VLAN."]},{h:"\u0633\u062F \u062F\u0641\u0627\u0639\u06CC \u0627\u0648\u0644: Port Security \u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC MAC \u0645\u062C\u0627\u0632",p:["\u0642\u0627\u0628\u0644\u06CC\u062A **Port Security** \u0641\u0642\u0637 \u0631\u0648\u06CC \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u0627\u06CC\u0633\u062A\u0627 (`switchport mode access` \u06CC\u0627 \u062A\u0631\u0627\u0646\u06A9 \u0627\u06CC\u0633\u062A\u0627\u061B \u0647\u0631\u06AF\u0632 \u0631\u0648\u06CC \u067E\u0648\u0631\u062A \u067E\u0648\u06CC\u0627\u06CC DTP \u06CC\u0627 \u0639\u0636\u0648 EtherChannel \u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F) \u0641\u0639\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u062A\u0639\u062F\u0627\u062F \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC MAC \u0645\u062C\u0627\u0632 \u0631\u0648\u06CC \u0622\u0646 \u067E\u0648\u0631\u062A \u0631\u0627 \u0645\u0647\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F (\u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u067E\u0633 \u0627\u0632 \u0641\u0639\u0627\u0644\u200C\u0633\u0627\u0632\u06CC\u060C \u062D\u062F\u0627\u06A9\u062B\u0631 **`1` \u0622\u062F\u0631\u0633 MAC** \u0627\u0633\u062A\u061B \u0627\u06AF\u0631 \u0631\u0648\u06CC \u0645\u06CC\u0632 \u06A9\u0627\u0631\u0645\u0646\u062F \u06CC\u06A9 \u062A\u0644\u0641\u0646 IP \u0648 \u06CC\u06A9 \u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631 \u067E\u0634\u062A \u0622\u0646 \u062F\u0627\u0631\u06CC\u062F\u060C \u0628\u0627\u06CC\u062F `maximum 2` \u06CC\u0627 `maximum 3` \u062A\u0646\u0638\u06CC\u0645 \u06A9\u0646\u06CC\u062F).","\u0645\u062D\u0628\u0648\u0628\u200C\u062A\u0631\u06CC\u0646 \u0631\u0648\u0634 \u062B\u0628\u062A \u0645\u06A9 \u062F\u0631 \u0633\u0627\u0632\u0645\u0627\u0646\u200C\u0647\u0627 \u06AF\u0632\u06CC\u0646\u0647 **`mac-address sticky`** \u0627\u0633\u062A: \u0633\u0648\u0626\u06CC\u0686 \u0645\u06A9\u0650 \u0627\u0648\u0644\u06CC\u0646 \u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631\u06CC \u0631\u0627 \u06A9\u0647 \u0628\u0647 \u067E\u0648\u0631\u062A \u0648\u0635\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0628\u0647 \u0635\u0648\u0631\u062A \u067E\u0648\u06CC\u0627 \u06CC\u0627\u062F \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u0622\u0646 \u0631\u0627 \u062F\u0631 `running-config` \u0645\u06CC\u200C\u0646\u0648\u06CC\u0633\u062F\u061B \u0628\u0627 \u0632\u062F\u0646 `write memory` \u0622\u0646 \u0645\u06A9 \u0628\u0631\u0627\u06CC \u0647\u0645\u06CC\u0634\u0647 \u0628\u0647 \u0622\u0646 \u067E\u0648\u0631\u062A \u0642\u0641\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646\u06A9\u0647 \u0627\u062F\u0645\u06CC\u0646 \u0645\u062C\u0628\u0648\u0631 \u0628\u0627\u0634\u062F \u0635\u062F\u0647\u0627 \u0645\u06A9\u200C\u0622\u062F\u0631\u0633 \u0631\u0627 \u062F\u0633\u062A\u06CC \u062A\u0627\u06CC\u067E \u06A9\u0646\u062F! \u062F\u0631 \u0635\u0648\u0631\u062A \u0627\u062A\u0635\u0627\u0644 \u062F\u0633\u062A\u06AF\u0627\u0647 \u063A\u06CC\u0631\u0645\u062C\u0627\u0632\u060C \u0633\u0648\u0626\u06CC\u0686 \u0628\u0631 \u0627\u0633\u0627\u0633 \u062D\u0627\u0644\u062A \u0627\u0646\u062A\u062E\u0627\u0628\u06CC \u0648\u0627\u06A9\u0646\u0634 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F:"],table:{head:["\u062D\u0627\u0644\u062A \u062A\u062E\u0637\u06CC (Violation Mode)","\u0622\u06CC\u0627 \u0641\u0631\u06CC\u0645 \u0645\u0647\u0627\u062C\u0645 \u062D\u0630\u0641 \u0645\u06CC\u200C\u0634\u0648\u062F\u061F","\u0622\u06CC\u0627 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u0648 \u0647\u0634\u062F\u0627\u0631 Syslog/SNMP \u062B\u0628\u062A \u0645\u06CC\u200C\u0634\u0648\u062F\u061F","\u0622\u06CC\u0627 \u067E\u0648\u0631\u062A \u06A9\u0627\u0645\u0644 \u062E\u0627\u0645\u0648\u0634 (`err-disabled`) \u0645\u06CC\u200C\u0634\u0648\u062F\u061F"],rows:[["**`shutdown`** (\u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0633\u06CC\u0633\u06A9\u0648)","\u0628\u0644\u0647 (\u06A9\u0627\u0645\u0644)","\u0628\u0644\u0647 (\u062F\u0631 \u0644\u062D\u0638\u0647 \u062E\u0627\u0645\u0648\u0634\u06CC)","**\u0628\u0644\u0647!** \u067E\u0648\u0631\u062A \u0686\u0631\u0627\u063A \u062E\u0627\u0645\u0648\u0634 (`err-disabled`) \u0645\u06CC\u200C\u0634\u0648\u062F \u062A\u0627 \u0627\u062F\u0645\u06CC\u0646 \u0645\u062F\u0627\u062E\u0644\u0647 \u06A9\u0646\u062F."],["**`restrict`** (\u0645\u062D\u062F\u0648\u062F\u06A9\u0646\u0646\u062F\u0647 \u0628\u0627 \u06AF\u0632\u0627\u0631\u0634)","\u0628\u0644\u0647 (\u0641\u0642\u0637 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0645\u06A9 \u063A\u06CC\u0631\u0645\u062C\u0627\u0632)","**\u0628\u0644\u0647!** \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u062A\u062E\u0637\u06CC \u0628\u0627\u0644\u0627 \u0631\u0641\u062A\u0647 \u0648 \u062A\u0644\u0647 Syslog/SNMP \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062E\u06CC\u0631\u061B \u062F\u0633\u062A\u06AF\u0627\u0647 \u0645\u062C\u0627\u0632 \u0642\u0628\u0644\u06CC \u0647\u0645\u0686\u0646\u0627\u0646 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0645\u0646\u0627\u0633\u0628 \u067E\u0648\u0631\u062A \u067E\u0634\u062A \u062A\u0644\u0641\u0646 IP)."],["**`protect`** (\u0645\u062D\u0627\u0641\u0638\u062A \u062E\u0627\u0645\u0648\u0634)","\u0628\u0644\u0647 (\u0641\u0642\u0637 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0645\u06A9 \u063A\u06CC\u0631\u0645\u062C\u0627\u0632)","**\u062E\u06CC\u0631!** \u0647\u06CC\u0686 \u0644\u0627\u06AF\u06CC \u062A\u0648\u0644\u06CC\u062F \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u062E\u06CC\u0631\u061B \u067E\u0648\u0631\u062A \u0631\u0648\u0634\u0646 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F."]]}},{h:"\u0633\u062F \u062F\u0641\u0627\u0639\u06CC \u062F\u0648\u0645: DHCP Snooping \u2014 \u0633\u0646\u06AF\u200C\u0628\u0646\u0627\u06CC \u0627\u0639\u062A\u0645\u0627\u062F \u062F\u0631 \u0644\u0627\u06CC\u0647 \u06F2",p:["\u0648\u06CC\u0698\u06AF\u06CC **DHCP Snooping** \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0631\u0627 \u0628\u0647 \u062F\u0648 \u0642\u0644\u0645\u0631\u0648 \u0627\u0645\u0646\u06CC\u062A\u06CC \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0647\u0645\u0647 \u067E\u0648\u0631\u062A\u200C\u0647\u0627 \u0628\u0647 \u0637\u0648\u0631 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 **\u063A\u06CC\u0631\u0642\u0627\u0628\u0644 \u0627\u0639\u062A\u0645\u0627\u062F (`Untrusted`)** \u0647\u0633\u062A\u0646\u062F \u0648 \u0641\u0642\u0637 \u067E\u0648\u0631\u062A \u0622\u067E\u200C\u0644\u06CC\u0646\u06A9