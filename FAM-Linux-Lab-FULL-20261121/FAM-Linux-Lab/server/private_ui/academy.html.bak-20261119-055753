u062A\u0647\u060C \u0628\u0647\u062A\u0631\u06CC\u0646 \u06CC\u0627 \u062F\u0631 \u062C\u062F\u0648\u0644 \u0627\u0631\u0633\u0627\u0644 \u0646\u0635\u0628 \u0634\u062F\u0647 \u0627\u0633\u062A.","\u0628\u0631\u0627\u06CC \u0645\u0642\u0635\u062F\u06CC \u0628\u0627 \u062F\u0648 \u0645\u0633\u06CC\u0631\u060C \u0627\u0628\u062A\u062F\u0627 \u0627\u0639\u062A\u0628\u0627\u0631 \u0648 \u0642\u0627\u0628\u0644\u200C\u062D\u0644 \u0628\u0648\u062F\u0646 next-hop \u0631\u0627 \u06A9\u0646\u062A\u0631\u0644 \u06A9\u0646. \u0633\u067E\u0633 \u0645\u0631\u0627\u062D\u0644 \u0627\u0646\u062A\u062E\u0627\u0628 \u0628\u0631 \u0627\u0633\u0627\u0633 \u067E\u06CC\u0627\u062F\u0647\u200C\u0633\u0627\u0632\u06CC \u0648 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F\u061B \u062F\u0631 IOS \u0645\u0642\u0627\u06CC\u0633\u0647 Weight \u0645\u062D\u0644\u06CC \u0648 Local Preference \u0639\u0645\u0648\u0645\u0627\u064B \u0642\u0628\u0644 \u0627\u0632 \u0637\u0648\u0644 AS_PATH \u0631\u062E \u0645\u06CC\u200C\u062F\u0647\u062F. route-map \u06CC\u0627 prefix-list \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u067E\u06CC\u0634 \u0627\u0632 \u0627\u0646\u062A\u062E\u0627\u0628\u060C \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0641\u06CC\u0644\u062A\u0631 \u06CC\u0627 \u0648\u06CC\u0698\u06AF\u06CC \u0622\u0646 \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u062F.","show ip bgp summary \u0648\u0636\u0639\u06CC\u062A peer\u060C show ip bgp \u0628\u0631\u0627\u06CC \u062C\u0632\u0626\u06CC\u0627\u062A prefix \u0648 show ip route \u0628\u0631\u0627\u06CC \u0646\u0635\u0628 \u0648\u0627\u0642\u0639\u06CC \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F. \u062F\u0631 iBGP \u0628\u0647 \u0642\u0627\u0646\u0648\u0646 \u0639\u062F\u0645 \u0628\u0627\u0632\u0627\u0639\u0644\u0627\u0645 \u0645\u0633\u06CC\u0631 iBGP \u0628\u0647 iBGP \u062F\u06CC\u06AF\u0631 \u0648 \u0646\u06CC\u0627\u0632 \u0628\u0647 full mesh \u06CC\u0627 route reflector \u062F\u0631 \u0637\u0631\u0627\u062D\u06CC \u0645\u062A\u062F\u0627\u0648\u0644 \u062A\u0648\u062C\u0647 \u06A9\u0646. [[bgp-advanced|\u0633\u06CC\u0627\u0633\u062A \u0648 \u0645\u062D\u0627\u0641\u0638\u062A BGP]] \u0648 [[redistribution|\u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639]] \u0631\u0627 \u0645\u0631\u0648\u0631 \u06A9\u0646."],acl:["ACL \u06CC\u0627 Access Control List \u0645\u062C\u0645\u0648\u0639\u0647\u200C\u0627\u06CC \u0645\u0631\u062A\u0628 \u0627\u0632 \u0634\u0631\u0637\u200C\u0647\u0627 \u0627\u0633\u062A\u061B \u062F\u0633\u062A\u06AF\u0627\u0647 \u0628\u0647\u200C\u0637\u0648\u0631 \u0645\u0639\u0645\u0648\u0644 \u0627\u0648\u0644\u06CC\u0646 \u062E\u0637 \u0645\u0646\u0637\u0628\u0642 \u0631\u0627 \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062F\u0631 \u067E\u0627\u06CC\u0627\u0646 \u06CC\u06A9 deny \u0636\u0645\u0646\u06CC \u062F\u0627\u0631\u062F. \u062F\u0631 ACL \u0645\u0648\u0631\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0628\u0631\u0627\u06CC \u0641\u06CC\u0644\u062A\u0631 \u0631\u0627\u0628\u0637\u060C \u062C\u0647\u062A in \u0648 out \u0646\u0633\u0628\u062A \u0628\u0647 \u062E\u0648\u062F \u0631\u0627\u0628\u0637 \u0631\u0648\u062A\u0631 \u062A\u0639\u0631\u06CC\u0641 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B ACL \u0628\u0647\u200C\u06A9\u0627\u0631\u0631\u0641\u062A\u0647 \u0628\u0631\u0627\u06CC NAT \u06CC\u0627 route-map \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0645\u0639\u0646\u06CC \u062F\u06CC\u06AF\u0631\u06CC \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F.","\u0628\u0631\u0627\u06CC \u0627\u062C\u0627\u0632\u0647 \u0641\u0642\u0637 \u062A\u0631\u0627\u0641\u06CC\u06A9 TCP \u0627\u0632 \u06CC\u06A9 subnet \u0628\u0647 \u067E\u0648\u0631\u062A \u0633\u0631\u0648\u06CC\u0633 \u06CC\u06A9 \u0633\u0631\u0648\u0631\u060C \u062F\u0631 ACL extended \u0645\u0628\u062F\u0623\u060C \u0645\u0642\u0635\u062F\u060C \u067E\u0631\u0648\u062A\u06A9\u0644 \u0648 \u067E\u0648\u0631\u062A \u0631\u0627 \u0645\u0634\u062E\u0635 \u0648 \u0633\u067E\u0633 deny \u06CC\u0627 \u0627\u062C\u0627\u0632\u0647\u200C\u0647\u0627\u06CC \u0645\u0648\u0631\u062F\u0646\u06CC\u0627\u0632 \u062F\u06CC\u06AF\u0631 \u0631\u0627 \u0645\u0631\u062A\u0628 \u06A9\u0646. wildcard \u062F\u0631 \u0647\u0631 \u0628\u06CC\u062A \u0635\u0641\u0631 \u0628\u0647\u200C\u0645\u0639\u0646\u06CC \u062A\u0637\u0627\u0628\u0642 \u0648 \u06CC\u06A9 \u0628\u0647\u200C\u0645\u0639\u0646\u06CC \u0628\u06CC\u200C\u0627\u0647\u0645\u06CC\u062A \u0627\u0633\u062A\u061B 0.0.0.255 \u062F\u0631 \u06A9\u0646\u0627\u0631 \u0622\u062F\u0631\u0633 \u0634\u0628\u06A9\u0647 \u0646\u0645\u0648\u0646\u0647 /24 \u0631\u0627 \u067E\u0648\u0634\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F.","\u0642\u0628\u0644 \u0627\u0632 \u0627\u0639\u0645\u0627\u0644\u060C \u062F\u0633\u062A\u0631\u0633\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u0648 \u0627\u062B\u0631 deny \u0636\u0645\u0646\u06CC \u0631\u0627 \u0628\u0627 \u06CC\u06A9 \u062C\u0631\u06CC\u0627\u0646 \u0631\u0641\u062A \u0648 \u0628\u0631\u06AF\u0634\u062A \u0631\u0648\u06CC \u06A9\u0627\u063A\u0630 \u0634\u0628\u06CC\u0647\u200C\u0633\u0627\u0632\u06CC \u06A9\u0646. show access-lists \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u0648 show ip interface \u062C\u0647\u062A \u0627\u0639\u0645\u0627\u0644 \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F. ACL \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0641\u0642\u0637 \u0645\u0628\u062F\u0623 \u0631\u0627 \u0645\u06CC\u200C\u0628\u06CC\u0646\u062F\u061B \u0628\u0631\u0627\u06CC \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u062A\u0631\u062C\u0645\u0647\u200C\u0647\u0627 \u062A\u0631\u062A\u06CC\u0628 \u067E\u0631\u062F\u0627\u0632\u0634 \u067E\u0644\u062A\u0641\u0631\u0645 \u0631\u0627 \u062F\u0631 [[nat|NAT]] \u0647\u0645 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646."],nat:["NAT \u062A\u0631\u062C\u0645\u0647 \u0622\u062F\u0631\u0633 \u0627\u0633\u062A \u0648 PAT \u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u0622\u062F\u0631\u0633\u060C \u0634\u0646\u0627\u0633\u0647 \u0627\u0646\u062A\u0642\u0627\u0644 \u0645\u0627\u0646\u0646\u062F \u067E\u0648\u0631\u062A TCP/UDP \u0631\u0627 \u0628\u0631\u0627\u06CC \u0686\u0646\u062F \u062C\u0631\u06CC\u0627\u0646 \u062A\u0641\u06A9\u06CC\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F. Inside local \u0622\u062F\u0631\u0633 \u0645\u06CC\u0632\u0628\u0627\u0646 \u062F\u0627\u062E\u0644\u06CC \u0627\u0632 \u062F\u06CC\u062F \u062F\u0627\u062E\u0644\u06CC \u0648 inside global \u0646\u0645\u0627\u06CC\u0634 \u0647\u0645\u0627\u0646 \u0645\u06CC\u0632\u0628\u0627\u0646 \u062F\u0631 \u0628\u06CC\u0631\u0648\u0646 \u0627\u0633\u062A\u061B outside local \u0648 outside global \u0628\u0647 \u0645\u06CC\u0632\u0628\u0627\u0646 \u0628\u06CC\u0631\u0648\u0646\u06CC \u0627\u0632 \u062F\u0648 \u062F\u06CC\u062F \u0645\u0631\u0628\u0648\u0637\u200C\u0627\u0646\u062F. NAT \u062E\u0648\u062F \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 \u0646\u06CC\u0633\u062A.","\u062F\u0631 PAT \u062F\u0648 \u06A9\u0644\u0627\u06CC\u0646\u062A \u062E\u0635\u0648\u0635\u06CC \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0627\u0632 \u06CC\u06A9 IP \u0639\u0645\u0648\u0645\u06CC \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u0646\u062F\u061B \u062C\u062F\u0648\u0644 \u062A\u0631\u062C\u0645\u0647 \u0622\u0646\u200C\u0647\u0627 \u0631\u0627 \u0628\u0627 \u062A\u0631\u06A9\u06CC\u0628 \u067E\u0631\u0648\u062A\u06A9\u0644\u060C \u0622\u062F\u0631\u0633 \u0648 \u067E\u0648\u0631\u062A \u0627\u0632 \u0647\u0645 \u062C\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u067E\u0627\u0633\u062E \u0628\u0631\u06AF\u0634\u062A\u06CC \u0641\u0642\u0637 \u0648\u0642\u062A\u06CC \u0628\u0647 \u0645\u06CC\u0632\u0628\u0627\u0646 \u062F\u0631\u0633\