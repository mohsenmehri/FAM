45 \u0631\u0627\u0647 \u0628\u06CC\u0646\u062F\u0627\u0632\u062F\u060C \u06A9\u0644 \u0633\u0627\u0632\u0645\u0627\u0646 \u06CC\u06A9\u200C\u062C\u0627 \u0642\u0637\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F."]},{h:"\u0645\u0641\u0647\u0648\u0645 VLAN\u060C \u0627\u0646\u0648\u0627\u0639 \u067E\u0648\u0631\u062A\u200C\u0647\u0627 \u0648 \u0628\u0627\u0632\u0647\u200C\u0647\u0627\u06CC \u0639\u062F\u062F\u06CC \u062F\u0631 \u0633\u0648\u0626\u06CC\u0686\u200C\u0647\u0627\u06CC \u0633\u06CC\u0633\u06A9\u0648",p:["\u0641\u0646\u0627\u0648\u0631\u06CC **VLAN** \u06CC\u06A9 \u0633\u0648\u0626\u06CC\u0686 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0631\u0627 \u062F\u0631 \u0633\u0637\u062D \u0645\u0646\u0637\u0642\u06CC (\u062A\u0631\u0627\u0634\u0647 ASIC \u0633\u0648\u0626\u06CC\u0686) \u0628\u0647 \u0686\u0646\u062F\u06CC\u0646 \u0633\u0648\u0626\u06CC\u0686 \u0645\u062C\u0627\u0632\u06CC \u06A9\u0627\u0645\u0644\u0627\u064B \u0645\u062C\u0632\u0627 \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0628\u0631\u0627\u06CC \u0647\u0631 VLAN \u06CC\u06A9 \u062C\u062F\u0648\u0644 \u0622\u062F\u0631\u0633 MAC \u0645\u0633\u062A\u0642\u0644 \u0646\u06AF\u0647\u200C\u062F\u0627\u0631\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0647\u0645\u0647\u200C\u067E\u062E\u0634\u06CC VLAN 10 **\u0641\u0642\u0637 \u0648 \u0641\u0642\u0637** \u0628\u0647 \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u0639\u0636\u0648 VLAN 10 \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F. \u062F\u0648 \u062F\u0633\u062A\u06AF\u0627\u0647 \u062F\u0631 VLAN 10 \u0648 VLAN 20 \u062D\u062A\u06CC \u0627\u06AF\u0631 \u0631\u0648\u06CC \u062F\u0648 \u067E\u0648\u0631\u062A \u06A9\u0646\u0627\u0631\u06CC \u06CC\u06A9 \u0633\u0648\u0626\u06CC\u0686 \u0646\u0634\u0633\u062A\u0647 \u0628\u0627\u0634\u0646\u062F\u060C \u0628\u062F\u0648\u0646 \u0639\u0628\u0648\u0631 \u0627\u0632 \u06CC\u06A9 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0644\u0627\u06CC\u0647 \u06F3 (\u0631\u0648\u062A\u0631 \u06CC\u0627 \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 \u06A9\u0647 \u062F\u0631 \u0628\u062E\u0634 [[inter-vlan|\u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0628\u06CC\u0646 VLAN\u0647\u0627 (ROAS \u0648 SVI)]] \u062A\u062F\u0631\u06CC\u0633 \u0634\u062F\u0647 \u0627\u0633\u062A) \u0645\u0637\u0644\u0642\u0627\u064B \u0642\u0627\u062F\u0631 \u0628\u0647 \u0627\u0631\u062A\u0628\u0627\u0637 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u0627 \u0647\u0645 \u0646\u06CC\u0633\u062A\u0646\u062F.","\u062F\u0631 \u0637\u0631\u0627\u062D\u06CC \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F\u060C \u0647\u0631 VLAN \u062F\u0642\u06CC\u0642\u0627\u064B \u0645\u062A\u0646\u0627\u0638\u0631 \u0628\u0627 **\u06CC\u06A9 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 IP \u0645\u062C\u0632\u0627** (\u06CC\u06A9 Subnet \u062F\u0631 \u0644\u0627\u06CC\u0647 \u06F3\u061B \u0631.\u06A9. [[subnetting|\u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0628\u0646\u062F\u06CC CIDR \u0648 VLSM]]) \u062F\u0631 \u0646\u0638\u0631 \u06AF\u0631\u0641\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0628\u0631\u0627\u06CC \u0645\u062B\u0627\u0644 `VLAN 10 = 192.168.10.0/24` (\u0641\u0631\u0648\u0634) \u0648 `VLAN 20 = 192.168.20.0/24` (\u0645\u0647\u0646\u062F\u0633\u06CC). \u0627\u0632 \u062F\u06CC\u062F\u06AF\u0627\u0647 \u0646\u0642\u0634 \u067E\u0648\u0631\u062A\u200C\u0647\u0627 \u062F\u0631 \u0633\u0648\u0626\u06CC\u0686 \u0633\u0647 \u062D\u0627\u0644\u062A \u06A9\u0644\u06CC\u062F\u06CC \u062F\u0627\u0631\u06CC\u0645:"],list:["**\u067E\u0648\u0631\u062A \u062F\u0633\u062A\u0631\u0633\u06CC (Access Port):** \u067E\u0648\u0631\u062A \u0645\u062A\u0635\u0644 \u0628\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647 \u067E\u0627\u06CC\u0627\u0646\u06CC (\u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631\u060C \u0633\u0631\u0648\u0631\u060C \u067E\u0631\u06CC\u0646\u062A\u0631). \u0627\u06CC\u0646 \u067E\u0648\u0631\u062A \u0641\u0642\u0637 \u0639\u0636\u0648 \u06CC\u06A9 Data VLAN \u0627\u0633\u062A \u0648 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627 \u0631\u0627 \u06A9\u0627\u0645\u0644\u0627\u064B **\u0628\u062F\u0648\u0646 \u062A\u06AF (Untagged)** \u062A\u062D\u0648\u06CC\u0644 \u06AF\u0631\u0641\u062A\u0647 \u0648 \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F\u061B \u06A9\u0627\u0631\u062A \u0634\u0628\u06A9\u0647 \u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631 \u0627\u0635\u0644\u0627\u064B \u0646\u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u0639\u0636\u0648 \u0686\u0647 \u0634\u0645\u0627\u0631\u0647 VLAN\u06CC \u0627\u0633\u062A.","**\u067E\u0648\u0631\u062A \u062A\u0631\u0627\u0646\u06A9 (Trunk Port):** \u0634\u0627\u0647\u0631\u0627\u0647 \u0627\u0631\u062A\u0628\u0627\u0637\u06CC \u0628\u06CC\u0646 \u062F\u0648 \u0633\u0648\u0626\u06CC\u0686 (\u06CC\u0627 \u0628\u06CC\u0646 \u0633\u0648\u0626\u06CC\u0686 \u0648 \u0631\u0648\u062A\u0631/\u0647\u0627\u06CC\u067E\u0631\u0648\u0627\u06CC\u0632\u0631 \u0645\u062C\u0627\u0632\u06CC\u200C\u0633\u0627\u0632\u06CC \u0645\u0627\u0646\u0646\u062F VMware ESXi) \u06A9\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u0647\u200C\u0647\u0627 VLAN \u0645\u062E\u062A\u0644\u0641 \u0631\u0627 \u0627\u0632 \u0631\u0648\u06CC **\u06CC\u06A9 \u06A9\u0627\u0628\u0644 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0648\u0627\u062D\u062F** \u0628\u0627 \u0686\u0633\u0628\u0627\u0646\u062F\u0646 \u0628\u0631\u0686\u0633\u0628 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F `IEEE 802.1Q` \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F.","**\u067E\u0648\u0631\u062A \u062A\u0631\u06A9\u06CC\u0628\u06CC \u0635\u062F\u0627 \u0648 \u062F\u0627\u062F\u0647 (Voice VLAN):** \u0631\u0648\u06CC \u06CC\u06A9 \u067E\u0648\u0631\u062A Access \u0633\u06CC\u0633\u06A9\u0648 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0639\u0644\u0627\u0648\u0647 \u0628\u0631 VLAN \u062F\u0627\u062F\u0647 \u06A9\u062