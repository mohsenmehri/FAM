u0627\u0633\u200C\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0631\u0627 \u06AF\u0631\u0633\u0646\u0647 \u06A9\u0646\u062F\u061B \u0638\u0631\u0641\u06CC\u062A \u0648 overhead \u0631\u0627 \u062D\u0633\u0627\u0628 \u06A9\u0646.","\u0642\u0628\u0644 \u0648 \u0628\u0639\u062F \u0627\u0632 \u0627\u0639\u0645\u0627\u0644 \u0633\u06CC\u0627\u0633\u062A \u0646\u0631\u062E\u060C drops\u060C \u062A\u0623\u062E\u06CC\u0631 \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u06A9\u0644\u0627\u0633\u200C\u0647\u0627 \u0631\u0627 \u0627\u0646\u062F\u0627\u0632\u0647 \u0628\u06AF\u06CC\u0631. show policy-map interface \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u062F\u0627\u0645 \u06A9\u0644\u0627\u0633 \u062A\u0637\u0628\u06CC\u0642 \u062E\u0648\u0631\u062F\u0647 \u0648 \u0686\u0647 \u062A\u0639\u062F\u0627\u062F \u0628\u0633\u062A\u0647 \u062F\u0648\u0631 \u0631\u06CC\u062E\u062A\u0647 \u0634\u062F\u0647 \u0627\u0633\u062A. Policing \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0627\u0636\u0627\u0641\u0647 \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0633\u06CC\u0627\u0633\u062A \u0631\u062F \u06CC\u0627 \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B shaping \u0628\u0627 \u0635\u0641 \u0648 \u062A\u0623\u062E\u06CC\u0631 \u0646\u0631\u062E \u062E\u0631\u0648\u062C \u0631\u0627 \u0647\u0645\u0648\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. [[qos-advanced|QoS \u067E\u06CC\u0634\u0631\u0641\u062A\u0647]] \u0631\u0627 \u0628\u0628\u06CC\u0646."],mpls:["MPLS \u0628\u0627 label \u06CC\u0627 \u0628\u0631\u0686\u0633\u0628 \u06A9\u0648\u062A\u0627\u0647 \u0648 \u062C\u062F\u0648\u0644 \u0627\u0631\u0633\u0627\u0644 \u0628\u0631\u0686\u0633\u0628\u060C \u0628\u0633\u062A\u0647 \u0631\u0627 \u062F\u0631 \u0647\u0633\u062A\u0647 \u0647\u062F\u0627\u06CC\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F. VRF \u06CC\u0627 Virtual Routing and Forwarding \u062C\u062F\u0648\u0644\u200C\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0634\u062A\u0631\u06CC\u200C\u0647\u0627 \u0631\u0627 \u062C\u062F\u0627 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F\u061B \u062C\u062F\u0627\u0633\u0627\u0632\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0644\u0632\u0648\u0645\u0627\u064B \u0628\u0647 \u0645\u0639\u0646\u06CC \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0646\u06CC\u0633\u062A. PE \u062F\u0631 \u0645\u0631\u0632 \u0627\u0631\u0627\u0626\u0647\u200C\u062F\u0647\u0646\u062F\u0647 \u0648 P \u062F\u0631 \u0647\u0633\u062A\u0647 \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u062F.","\u062F\u0631 L3VPN \u0645\u0639\u0645\u0648\u0644\u060C PE \u0648\u0631\u0648\u062F\u06CC \u0627\u0628\u062A\u062F\u0627 \u0628\u0633\u062A\u0647 \u0631\u0627 \u062F\u0631 VRF \u0645\u0634\u062A\u0631\u06CC \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0633\u067E\u0633 \u0628\u0631\u0686\u0633\u0628 \u0633\u0631\u0648\u06CC\u0633 \u0648 \u0628\u0631\u0686\u0633\u0628 \u0627\u0646\u062A\u0642\u0627\u0644 \u0645\u0646\u0627\u0633\u0628 \u0631\u0627 \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F. \u0647\u0633\u062A\u0647 \u0628\u0627 \u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC \u0628\u0647 \u0633\u0645\u062A PE \u062E\u0631\u0648\u062C\u06CC \u0645\u06CC\u200C\u0631\u0648\u062F\u061B \u0628\u0631\u0686\u0633\u0628 \u062F\u0627\u062E\u0644\u06CC \u0628\u0647 PE \u062E\u0631\u0648\u062C\u06CC \u062F\u0631 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u0633\u0631\u0648\u06CC\u0633 \u06A9\u0645\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F. RD \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627\u06CC \u0647\u0645\u0633\u0627\u0646 \u0645\u0634\u062A\u0631\u06CC\u0627\u0646 \u0631\u0627 \u06CC\u06A9\u062A\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 RT \u0633\u06CC\u0627\u0633\u062A import/export \u0645\u0633\u06CC\u0631 \u0627\u0633\u062A.","\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0631\u