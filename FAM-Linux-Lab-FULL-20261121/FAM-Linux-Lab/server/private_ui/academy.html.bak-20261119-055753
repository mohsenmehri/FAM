6CC \u0645\u062A\u0641\u0627\u0648\u062A\u06CC \u062F\u0627\u0631\u0646\u062F\u061B \u0646\u0627\u0645 \u0645\u062D\u0635\u0648\u0644\u0627\u062A \u0648 \u0627\u0645\u06A9\u0627\u0646\u0627\u062A \u0628\u0627 \u0646\u0633\u062E\u0647 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. Underlay \u062F\u0633\u062A\u0631\u0633\u06CC \u0627\u0646\u062A\u0642\u0627\u0644\u06CC \u0645\u0627\u0646\u0646\u062F MPLS \u06CC\u0627 WAN بانک \u0648 overlay \u0627\u0631\u062A\u0628\u0627\u0637 \u0645\u0646\u0637\u0642\u06CC \u0627\u0645\u0646 \u0631\u0648\u06CC \u0622\u0646 \u0627\u0633\u062A.","\u062F\u0631 \u0648\u0631\u0648\u062F \u062F\u0633\u062A\u06AF\u0627\u0647 \u062C\u062F\u06CC\u062F\u060C \u0647\u0648\u06CC\u062A \u0648 \u0645\u062C\u0648\u0632 \u0622\u0646 \u0628\u0627\u06CC\u062F \u062A\u0623\u06CC\u06CC\u062F \u0648 \u0633\u067E\u0633 \u0627\u0631\u062A\u0628\u0627\u0637\u200C\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644\u06CC \u0628\u0631\u0642\u0631\u0627\u0631 \u0634\u0648\u062F. OMP \u0645\u0633\u06CC\u0631 \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062A\u06CC \u0645\u0627\u0646\u0646\u062F TLOC \u0631\u0627 \u0628\u06CC\u0646 \u0627\u062C\u0632\u0627 \u062A\u0648\u0632\u06CC\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B TLOC \u0646\u0642\u0637\u0647 \u0627\u062A\u0635\u0627\u0644 \u0627\u0646\u062A\u0642\u0627\u0644 \u0631\u0627 \u0628\u0627 \u0634\u0646\u0627\u0633\u0647 \u0633\u06CC\u0633\u062A\u0645\u060C \u0631\u0646\u06AF \u0648 \u0646\u0648\u0639 encapsulation \u062A\u0648\u0635\u06CC\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0633\u06CC\u0627\u0633\u062A \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0628\u0631 \u0627\u0633\u0627\u0633 \u06A9\u06CC\u0641\u06CC\u062A \u0633\u0646\u062C\u06CC\u062F\u0647\u200C\u0634\u062F\u0647 \u0648 SLA \u0628\u06CC\u0646 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u0645\u062C\u0627\u0632 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u062F.","\u0627\u06AF\u0631 \u0627\u0631\u062