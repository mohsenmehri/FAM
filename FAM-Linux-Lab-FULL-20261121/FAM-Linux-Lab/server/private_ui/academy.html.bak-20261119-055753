 \u062F\u0631 SR-MPLS \u0641\u0647\u0631\u0633\u062A segment\u0647\u0627 \u0628\u0647 \u067E\u0634\u062A\u0647 label \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u06AF\u0631\u0647\u200C\u0647\u0627\u06CC \u0645\u06CC\u0627\u0646\u06CC \u0645\u0637\u0627\u0628\u0642 label \u0628\u0627\u0644\u0627\u06CC \u067E\u0634\u062A\u0647 \u0639\u0645\u0644 swap \u06CC\u0627 forward \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F \u0648 \u062D\u0630\u0641 segment \u0647\u0646\u06AF\u0627\u0645 \u0631\u0633\u06CC\u062F\u0646 \u0628\u0647 \u0627\u0646\u062A\u0647\u0627\u06CC \u0645\u0631\u0628\u0648\u0637 \u06CC\u0627 \u0637\u0628\u0642 \u0642\u0648\u0627\u0639\u062F PHP \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0646\u0647 \u062F\u0631 \u0647\u0645\u0647 \u0631\u0648\u062A\u0631\u0647\u0627. \u0645\u062B\u0644 \u0627\u062C\u0631\u0627\u06CC \u06CC\u06A9 \u0627\u0633\u06A9\u0631\u06CC\u067E\u062A \u06A9\u0648\u0686\u06A9 \u0631\u0648\u06CC \u0628\u0633\u062A\u0647."]},{h:"SRGB \u0648 \u062F\u0648 \u0646\u0648\u0639 SID",p:["SRGB \u06CC\u0627 \u0628\u0644\u0648\u06A9 \u0628\u0631\u0686\u0633\u0628 Segment Routing\u060C \u0628\u0627\u0632\u0647\u200C\u0627\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0631\u0648\u062A\u0631 \u0628\u0631\u0686\u0633\u0628\u200C\u0647\u0627\u06CC SR \u0631\u0627 \u0627\u0632 \u0622\u0646 \u0628\u0631\u0645\u06CC\u200C\u062F\u0627\u0631\u062F\u061B \u0628\u0627\u0632\u0647 16000 \u062A\u0627 23999 \u062F\u0631 \u0628\u0631\u062E\u06CC \u067E\u06CC\u0627\u062F\u0647\u200C\u0633\u0627\u0632\u06CC\u200C\u0647\u0627\u06CC \u0633\u06CC\u0633\u06A9\u0648 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0627\u0633\u062A\u060C \u0627\u0645\u0627 \u0645\u0642\u062F\u0627\u0631 \u0639\u0645\u0648\u0645\u06CC \u0648 \u062B\u0627\u0628\u062A \u0647\u0645\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627 \u0646\u06CC\u0633\u062A. Prefix-SID \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u06CC\u06A9 \u067E\u06CC\u0634\u0648\u0646\u062F \u0627\u0633\u062A: \u0628\u0631\u0627\u06CC Prefix-SID \u0628\u0647 \u0635\u0648\u0631\u062A index\u060C label \u0627\u0632 index \u0648 \u067E\u0627\u06CC\u0647 SRGB \u0645\u062D\u0644\u06CC \u0645\u062D\u0627\u0633\u0628\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0631\u0648\u062A\u0631 \u062A\u0628\u0644\u06CC\u063A\u200C\u06A9\u0646\u0646\u062F\u0647 SID \u0631\u0627 \u0628\u0631\u0627\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F \u0645\u0631\u0628\u0648\u0637 \u0627\u0639\u0644\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u06AF\u0631 \u0647\u0645\u0647 \u0631\u0648\u062A\u0631\u0647\u0627 SRGB \u06CC\u06A9\u0633\u0627\u0646 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F\u060C Index \u0631\u0648\u06CC \u0647\u0645\u0647 \u06CC\u06A9 \u0645\u0639\u0646\u0627 \u062F\u0627\u0631\u062F \u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0633\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. Adjacency-SID \u0645\u062E\u0635\u0648\u0635 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u0645\u0634\u062E\u0635 \u0627\u0633\u062A \u0648 \u0628\u0631\u0627\u06CC \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u062F\u0642\u06CC\u0642 (Traffic Engineering) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0686\u0648\u0646 \u0628\u0647 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u06AF\u0631\u0647 \u062E\u0648\u0631\u062F\u0647\u060C \u0628\u0627 \u0642\u0637\u0639 \u0622\u0646 \u0644\u06CC\u0646\u06A9 \u0628\u0631\u0686\u0633\u0628\u0634 \u0647\u0645 \u0628\u0631\u062F\u0627\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062A\u0648\u0632\u06CC\u0639 \u0627\u06CC\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0628\u0627 \u0647\u0645\u0627\u0646 IGP (IS-IS \u06CC\u0627 OSPF) \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0686\u0648\u0646 IGP \u0627\u0632 \u0642\u0628\u0644 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u062A\u