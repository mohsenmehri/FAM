1 Underlay: \u0628\u0633\u062A\u0647 VXLAN \u0628\u0632\u0631\u06AF\u200C\u062A\u0631 \u0627\u0632 MTU \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0628\u0632\u0631\u06AF (\u0645\u062B\u0644 iSCSI) \u06AF\u0645 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F.","\u0646\u0628\u0648\u062F Underlay \u067E\u0627\u06CC\u062F\u0627\u0631: \u062A\u0648\u0646\u0644 VXLAN \u0631\u0648\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC IP \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0627\u06AF\u0631 IGP \u062F\u0631\u0633\u062A \u0646\u0628\u0627\u0634\u062F\u060C \u0647\u0645\u0647\u200C\u0686\u06CC\u0632 \u0645\u06CC\u200C\u062E\u0648\u0627\u0628\u062F.","\u0627\u0634\u062A\u0628\u0627\u0647 \u06AF\u0631\u0641\u062A\u0646 VNI \u0628\u0627 VLAN ID: \u0627\u06CC\u0646\u200C\u0647\u0627 \u062F\u0648 \u0641\u0636\u0627\u06CC \u0646\u0627\u0645 \u0645\u0633\u062A\u0642\u0644\u200C\u0627\u0646\u062F \u0648 \u0646\u0642\u0634\u0647\u200C\u0634\u0627\u0646 \u0628\u0627\u06CC\u062F \u062F\u0631 \u0647\u0631 VTEP \u06CC\u06A9\u0633\u0627\u0646 \u0628\u0627\u0634\u062F."],exam:["VXLAN \u0631\u0648\u06CC UDP \u067E\u0648\u0631\u062A \u06F4\u06F7\u06F8\u06F9 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 VNI \u0622\u0646 \u06F2\u06F4 \u0628\u06CC\u062A\u06CC \u0627\u0633\u062A.","EVPN \u0627\u0632 AFI 25 / SAFI 70 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 Type-2 \u0628\u0631\u0627\u06CC MAC/IP \u0627\u0633\u062A.","VXLAN \u0628\u0631\u0627\u06CC \u062D\u0644 \u0645\u0634\u06A9\u0644 \u0645\u0642\u06CC\u0627\u0633 VLAN \u0648 \u062D\u0630\u0641 STP \u0637\u0631\u0627\u062D\u06CC \u0634\u062F."],glossary:[["VTEP","\u062F\u0633\u062A\u06AF\u0627\u0647\u06CC \u06A9\u0647 \u0628\u0633\u062A\u0647 \u0631\u0627 \u062F\u0631 VXLAN \u0645\u06CC\u200C\u067E\u06CC\u0686\u062F \u06CC\u0627 \u0628\u0627\u0632 \u0645\u06CC\u200C\u06A9\u0646\u062F."],["VNI","\u0634\u064