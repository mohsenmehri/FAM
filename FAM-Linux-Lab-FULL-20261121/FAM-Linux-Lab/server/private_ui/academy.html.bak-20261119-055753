1F",p:["\u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u062F\u0627\u062E\u0644\u06CC (IGP) \u062F\u0646\u0628\u0627\u0644 \xAB\u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631\u06CC\u0646 \u0645\u0633\u06CC\u0631\xBB \u0647\u0633\u062A\u0646\u062F. BGP \u062F\u0646\u0628\u0627\u0644 \xAB\u0628\u0647\u062A\u0631\u06CC\u0646 \u0633\u06CC\u0627\u0633\u062A\xBB \u0627\u0633\u062A: \u06A9\u062F\u0627\u0645 BANK-WAN \u0627\u0631\u0632\u0627\u0646\u200C\u062A\u0631 \u0627\u0633\u062A\u060C \u06A9\u062F\u0627\u0645 \u0645\u0633\u06CC\u0631 \u067E\u0627\u06CC\u062F\u0627\u0631\u062A\u0631\u060C \u06A9\u062F\u0627\u0645 \u0645\u0634\u062A\u0631\u06CC \u0627\u0648\u0644\u0648\u06CC\u062A \u062F\u0627\u0631\u062F. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 BGP \u062F\u0647\u200C\u0647\u0627 \u0648\u06CC\u0698\u06AF\u06CC \u0628\u0631\u0627\u06CC \u0645\u0642\u0627\u06CC\u0633\u0647 \u062F\u0627\u0631\u062F \u0648 \u062A\u0631\u062A\u06CC\u0628 \u0645\u0642\u0627\u06CC\u0633\u0647 \u0622\u0646\u200C\u0647\u0627 \u0628\u0633\u06CC\u0627\u0631 \u0645\u0647\u0645 \u0627\u0633\u062A.","\u062A\u0641\u0627\u0648\u062A \u062F\u06CC\u06AF\u0631 \u0645\u0642\u06CC\u0627\u0633 \u0627\u0633\u062A: \u062C\u062F\u0648\u0644 WAN بانک \u0628\u06CC\u0634 \u0627\u0632 \u06F9\u06F0\u06F0 \u0647\u0632\u0627\u0631 \u067E\u06CC\u0634\u0648\u0646\u062F \u062F\u0627\u0631\u062F. BGP \u0628\u0627 \u0646\u06AF\u0647\u200C\u062F\u0627\u0634\u062A\u0646 \u0647\u0645\u0647 \u0645\u0633\u06CC\u0631\u0647\u0627 \u0648 \u0627\u0646\u062A\u062E\u0627\u0628 \u06CC\u06A9\u06CC\u060C \u0628\u0647 \u062A\u0648 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627\u06CC \u067E\u06CC\u0686\u06CC\u062F\u0647 \u0628\u0646\u0648\u06CC\u0633\u06CC\u060C \u0628\u0647 \u0642\u06CC\u0645\u062A \u0645\u0635\u0631\u0641 \u062D\u0627\u0641\u0638\u0647 \u0648 \u0632\u0645\u0627\u0646 \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC \u0628\u06CC\u0634\u062A\u0631."]},{h:"\u062A\u0631\u062A\u06CC\u0628 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0633\u06CC\u0631 (\u062E\u0644\u0627\u0635\u0647 \u0639\u0645\u0644\u06CC)",p:["\u062A\u0631\u062A\u06CC\u0628 \u06A9\u0644\u0627\u0633\u06CC\u06A9: \u06F1) \u0628\u0627\u0644\u0627\u062A\u0631\u06CC\u0646 Weight (\u0641\u0642\u0637 \u0645\u062D\u0644\u06CC\u060C \u0633\u06CC\u0633\u06A9\u0648) \u06F2) \u0628\u0627\u0644\u0627\u062A\u0631\u06CC\u0646 Local Preference (\u062F\u0631 \u06A9\u0644 AS) \u06F3) \u062A\u0631\u062C\u06CC\u062D \u0645\u0633\u06CC\u0631 \u062A\u0648\u0644\u06CC\u062F\u0634\u062F\u0647 \u0645\u062D\u0644\u06CC (network/redistribute/aggregate) \u06F4) \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631\u06CC\u0646 AS_PATH \u06F5) \u06A9\u0645\u062A\u0631\u06CC\u0646 Origin (IGP \u0628\u0647\u062A\u0631 \u0627\u0632 EGP \u0628\u0647\u062A\u0631 \u0627\u0632 Incomplete) \u06F6) \u06A9\u0645\u062A\u0631\u06CC\u0646 MED \u06F7) eBGP \u0628\u0631 iBGP \u06F8) \u0646\u0632\u062F\u06CC\u06A9\u200C\u062A\u0631\u06CC\u0646 IGP next-hop \u06F9) \u0642\u062F\u06CC\u0645\u06CC\u200C\u062A\u0631\u06CC\u0646 \u0645\u0633\u06CC\u0631 eBGP \u06F1\u06F0) \u06A9\u0645\u062A\u0631\u06CC\u0646 Router-ID \u06F1\u06F1) \u06A9\u0645\u062A\u0631\u06CC\u0646 neighbor IP.","\u062F\u0631 \u0622\u0632\u0645\u0648\u0646\u060C \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u062F\u0648 \u0648\u06CC\u0698\u06AF\u06CC \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F \u0648 \u0645\u06CC\u200C\u067E\u0631\u0633\u0646\u062F \u06A9\u062F\u0627\u0645 \u0628\u0631\u0646\u062F\u0647 \u0627\u0633\u062A\u061B \u06A9\u0627\u0641\u06CC \u0627\u0633\u062A \u062C\u0627\u06CC \u0622\u0646\u200C\u0647\u0627 \u0631\u0627 \u062F\u0631 \u0627\u06CC\u0646 \u0632\u0646\u062C\u06CC\u0631\u0647 \u0628\u062F\u0627\u0646\u06CC. \u06CC\u06A9 \u0642\u0627\u0639\u062F\u0647 \u0645\u0641\u06CC\u062F: \u0647\u0631 \u0686\u06CC\u0632\u06CC \u06A9\u0647 \xAB\u0642\u0628\u0644 \u0627\u0632 AS_PATH\x