u0628\u0647 \u062A\u0648\u0646\u0644 \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F","\u062A\u0641\u0627\u0648\u062A \u0641\u0627\u0632 \u06F1\u060C \u06F2 \u0648 \u06F3 DMVPN \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC \u0686\u0631\u0627 \u0641\u0627\u0632 \u06F3 \u0631\u0627\u06CC\u062C \u0634\u062F"],sections:[{h:"GRE: \u062A\u0648\u0646\u0644\u06CC \u06A9\u0647 \u0647\u0645\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627 \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F",p:["\u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u0627\u062E\u0644\u06CC \u0627\u0632 WAN بانک\u060C \u06CC\u0627 \u0628\u0627\u06CC\u062F \u0622\u0646 \u0631\u0627 \u0631\u0645\u0632 \u06A9\u0631\u062F (IPsec) \u06CC\u0627 \u062F\u0631 \u06CC\u06A9 \u0628\u0633\u062A\u0647 \u062F\u06CC\u06AF\u0631 \u067E\u06CC\u0686\u06CC\u062F (GRE) \u06CC\u0627 \u0647\u0631 \u062F\u0648. GRE \u0645\u0632\u06CC\u062A \u062E\u0627\u0635\u06CC \u062F\u0627\u0631\u062F: \u0686\u0648\u0646 \u06CC\u06A9 \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0633\u0627\u062F\u0647 \u0627\u0633\u062A\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F multicast \u0631\u0627 \u0647\u0645 \u062D\u0645\u0644 \u06A9\u0646\u062F. \u06CC\u0639\u0646\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC EIGRP \u06CC\u0627 OSPF \u0631\u0627 \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u0627\u062C\u0631\u0627 \u06A9\u0646\u06CC\u060C \u062F\u0631 \u062D\u0627\u0644\u06CC \u06A9\u0647 IPsec \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0631\u0627 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0639\u06CC\u0628 GRE \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u062E\u0648\u062F\u0634 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0646\u062F\u0627\u0631\u062F\u061B \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 \u062F\u0631 \u0639\u0645\u0644 GRE \u0631\u0627 \u0628\u0627 IPsec \u062A\u0631\u06A9\u06CC\u0628 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. \u062A\u0648\u0646\u0644 GRE \u0631\u0648\u06CC \u0628\u0633\u062A\u0631 \u0648\u0627\u0642\u0639\u06CC \u0644\u0627\u0632\u0645 \u0627\u0633\u062A\u060C \u0648\u0644\u06CC \u062F\u0631 DMVPN \u06CC\u06A9 \u062A\u0648\u0646\u0644 mGRE (\u0686\u0646\u062F\u0645\u0642\u0635\u062F\u0647) \u062F\u0627\u0631\u06CC\u0645: \u06CC\u06A9 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062A\u0648\u0646\u0644 \u0628\u0627 \u0686\u0646\u062F \u0645\u0642\u0635\u062F."]},{h:"NHRP: \u062F\u0641\u062A\u0631\u0686\u0647 \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644",p:["\u062F\u0631 mGRE\u060C \u0631\u0648\u062A\u0631 \u0634\u0639\u0628\u0647 (Spoke) \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u062F\u0627\u0631\u062F (\u0645\u062B\u0644\u0627\u064B 172.16.0.2) \u06A9\u0647 \u0647\u06CC\u0686 \u0631\u0628\u0637\u06CC \u0628\u0647 \u0622\u062F\u0631\u0633 \u0627\u06CC\u0646\u062A\u0631\u0646\u062A\u0634 \u0646\u062F\u0627\u0631\u062F. \u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u0628\u062F\u0627\u0646\u06CC \u0627\u06CC\u0646 \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0628\u0647 \u06A9\u062F\u0627\u0645 IP \u0639\u0645\u0648\u0645\u06CC \u0645\u06CC\u200C\u0631\u0633\u062F\u060C \u0627\u0632 NHRP \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645. Spoke \u0628\u0647 \u0647\u0627\u0628 \u062B\u0628\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \xAB\u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0645\u0646\u060C \u067E\u0634\u062A \u0627\u06CC\u0646 IP \u0639\u0645\u0648\u0645\u06CC \u0627\u0633\u062A\xBB \u0648 \u0647\u0627\u0628 \u0627\u06CC\u0646 \u0631\u0627 \u062F\u0631 \u062C\u062F\u0648\u0644\u0634 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F.","\u0648\u0642\u062A\u06CC Spoke \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u062F \u0628\u0627 Spoke \u062F\u06CC\u06AF\u0631\u06CC \u062D\u0631\u0641 \u0628\u0632\u0646\u062F\u060C \u0627\u0632 \u0647\u0627\u0628 \u0645\u06CC\u200C\u067E\u0631\u0633\u062F (NHRP Resolution Request) \u0648 \u0647\u0627\u0628 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u0627\u0648 \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F. \u062D\u0627\u0644\u0627 \u062A\u062D\u0648\u06CC\u0644 \u0628\u0633\u062A\u0647 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0628\u062F\u0648\u0646 \u0639\u0628\u0648\u0631 \u0627\u0632 \u0647\u0627\u0628."],callout:{title:"\u0645\u0634\u06A9\u0644 \u06A9\u0644\u0627\u0633\u06CC\u06A9",text:"\u0627\u06AF\u0631 \u06CC\u06A9 Spoke \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u062E\u0648\u062F\u06A9\u0627\u0631 (DHCP) \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u06A9\u0646\u062F\u060C \u062A\u0627 \u0648\u0642\u062A\u06CC \u062F\u0648\u0628\u0627\u0631\u0647 \u062B\u0628\u062A \u0646\u06A9\u0646\u062F\u060C \u0627\u0631\u062A\u0628\u0627\u0637 \u0642\u0637\u0639 \u0627\u0633\u062A. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 keepalive \u0648 re-registration \u0645\u0647\u0645\u200C\u0627\u0646\u062F."}},{h:"\u0633\u0647 \u0641\u0627\u0632 DMVPN",p:["\u0641\u0627\u0632 \u06F1: \u0641\u0642\u0637 \u0647\u0627\u0628 \u0648 Spoke\u0647\u0627 \u0628\u0627 \u0647\u0645 \u062D\u0631\u0641 \u0645\u06CC\u200C\u0632\u0646\u0646\u062F (\u0633\u062A\u0627\u0631\u0647). \u0633\u0627\u062F\u0647 \u0648\u0644\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0634\u0639\u0628\u0647\u200C\u0628\u0647\u200C\u0634\u0639\u0628\u0647 \u0627\u0632 \u0647\u0627\u0628 \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0641\u0627\u0632 \u06F2: Spoke\u0647\u0627 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u0627 \u0647\u0645 \u062A\u0648\u0646\u0644 \u0645\u06CC\u200C\u0633\u0627\u0632\u0646\u062F (mGRE \u06A9\u0627\u0645\u0644) \u2014 \u0633\u0631\u06CC\u0639\u200C\u062A\u0631 \u0648\u0644\u06CC \u0646\u06CC\u0627\u0632 \u0628\u0647 route summarization \u062F\u0642\u06CC\u0642 \u0648 next-hop \u0627\u0635\u0644\u0627\u062D\u200C\u0634\u062F\u0647 \u062F\u0627\u0631\u062F.","\u0641\u0627\u0632 \u06F3: \u062A\u0631\u06A9\u06CC\u0628\u06CC \u0647\u0648\u0634\u0645\u0646\u062F\u061B Spoke\u0647\u0627 \u0647\u0645\u0686\u0646\u0627\u0646 \u0627\u0632 \u0647\u0627\u0628 \u0645\u0633\u06CC\u0631 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F\u060C \u0648\u0644\u06CC \u0648\u0642\u062A\u06CC \u0644\u0627\u0632\u0645 \u0634\u062F \u0628\u0627 \u06CC\u06A9 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0631 NHRP \u0648 next-hop\u060C \u0627\u0631\u062A\u0628\u0627\u0637 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u0631\u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0686\u0648\u0646 \u0628\u062F\u0648\u0646 \u0646\u06CC\u0627\u0632 \u0628\u0647 \u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC \u067E\u06CC\u0686\u06CC\u062F\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0627\u0645\u0631\u0648\u0632\u0647 \u0627\u0646\u062A\u062E\u0627\u0628 \u0631\u0627\u06CC\u062C \u0627\u0633\u062A. \u062F\u0631 \u0647\u0645\u0647 \u0641\u0627\u0632\u0647\u0627 IPsec \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 BFD/NHRP \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC \u0631\u0627 \u0633\u0631\u06CC\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F."]},{h:"\u0628\u0631\u0631\u0633\u06CC \u0648 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC",p:["show dmvpn \u0647\u0645\u0647 \u0647\u0645\u0633\u0627\u06CC\u0647\u200C\u0647\u0627 \u0631\u0627 \u0628\u0627 \u0648\u0636\u0639\u06CC\u062A (UP/IKE/NHRP) \u0648 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u0648 \u062A\u0639\u062F\u0627\u062F tunnel \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F. show ip nhrp \u0647\u0645\u0627\u0646 \u062C\u0