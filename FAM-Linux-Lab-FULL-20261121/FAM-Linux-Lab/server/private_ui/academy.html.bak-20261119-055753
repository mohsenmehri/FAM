0646 \u0644\u06CC\u0646\u06A9 \u0628\u0631\u0648\u062F"],sections:[{h:"\u0645\u0634\u06A9\u0644\u06CC \u06A9\u0647 SD-WAN \u062D\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F",p:["\u062F\u0631 WAN \u0633\u0646\u062A\u06CC\u060C \u0647\u0631 \u0634\u0639\u0628\u0647 \u0628\u0627 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 MPLS \u0628\u0647 \u0645\u0631\u06A9\u0632 \u0648\u0635\u0644 \u0627\u0633\u062A \u0648 \u0647\u0645\u0647 \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627 \u0631\u0648\u06CC \u0631\u0648\u062A\u0631 \u0647\u0645\u0627\u0646 \u0634\u0639\u0628\u0647 \u0646\u0648\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062D\u0627\u0644\u0627 \u062A\u0635\u0648\u0631 \u06A9\u0646 \u0634\u0639\u0628\u0647\u200C\u0627\u06CC \u062F\u0648 \u0644\u06CC\u0646\u06A9 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F: MPLS \u06AF\u0631\u0627\u0646 \u0648 \u067E\u0627\u06CC\u062F\u0627\u0631\u060C WAN بانک \u0627\u0631\u0632\u0627\u0646 \u067E\u0631\u0646\u0648\u0633\u0627\u0646\u060C \u0648 LTE \u067E\u0634\u062A\u06CC\u0628\u0627\u0646. \u0628\u0627 BGP/OSPF \u0645\u0639\u0645\u0648\u0644\u06CC\u060C \u062A\u0635\u0645\u06CC\u0645 \u0645\u0633\u06CC\u0631 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u062A\u0631\u06CC\u06A9 \u0627\u0633\u062A\u060C \u0646\u0647 \u06A9\u06CC\u0641\u06CC\u062A \u0644\u062D\u0638\u0647\u200C\u0627\u06CC\u061B \u0646\u062A\u06CC\u062C\u0647 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u062A\u0645\u0627\u0633 \u0635\u0648\u062A\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9\u06CC \u0628\u06CC\u0641\u062A\u062F \u06A9\u0647 \u062C\u06CC\u062A\u0631 \u0628\u0627\u0644\u0627\u06CC\u06CC \u062F\u0627\u0631\u062F.","SD-WAN \u062F\u0648 \u06A9\u0627\u0631 \u06A9\u0631\u062F: \u0645\u062F\u06CC\u0631\u06CC\u062A \u0631\u0627 \u0645\u0631\u06A9\u0632\u06CC \u06A9\u0631\u062F (\u0642\u0627\u0644\u0628\u200C\u0647\u0627 \u0627\u0632 \u06CC\u06A9 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0645\u06CC\u200C\u0622\u06CC\u062F) \u0648 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u06A9\u06CC\u0641\u06CC\u062A \u0648\u0627\u0642\u0639\u06CC \u0647\u0631 \u0644\u06CC\u0646\u06A9 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0631\u062F. \u0627\u06CC\u0646 \u062F\u0648\u0645\u06CC \u0628\u0627 \u067E\u0631\u0648\u062A\u06A9\u0644 BFD \u0645\u0645\u06A9\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u0647\u0631 \u062B\u0627\u0646\u06CC\u0647 \u062A\u0623\u062E\u06CC\u0631\u060C \u0627\u0641\u062A \u0648 \u062C\u06CC\u062A\u0631 \u0631\u0627 \u0645\u06CC\u200C\u0633\u0646\u062C\u062F."]},{h:"\u0633\u0647 \u0646\u0642\u0634 \u0648 \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u0648\u0631\u0648\u062F",p:["\u0647\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647 SD-WAN \u0627\u0648\u0644 \u0628\u0627\u06CC\u062F \xAB\u0648\u0627\u0631\u062F\xBB \u0634\u0628\u06A9\u0647 \u0634\u0648\u062F. \u0628\u0627 vBond (\u0646\u0627\u0645 \u062C\u062F\u06CC\u062F: Validator) \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u06CC\u06A9 \u0633\u0634\u0646 DTLS \u0631\u0648\u06CC UDP \u067E\u0648\u0631\u062A \u06F1\u06F2\u06F3\u06F4\u06F6 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F\u060C \u06AF\u0648\u0627\u0647\u06CC \u062E\u0648\u062F\u0634 \u0631\u0627 \u0627\u062B\u0628\u0627\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062F\u0631 \u0639\u0648\u0636 \u0622\u062F\u0631\u0633 vSmart \u0648 vManage \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. vBond \u0647\u06CC\u0686 \u0645\u0633\u06CC\u0631\u06CC \u0646\u0645\u06CC\u200C\u062F\u0647\u062F\u061B \u06A9\u0627\u0631\u0634 \u062F\u0631\u0648\u0627\u0632\u0647\u200C\u0628\u0627\u0646\u06CC \u0648 \u0645\u0639\u0631\u0641\u06CC \u0627\u0633\u062A.","\u0648\u0627\u0631\u062F \u06A9\u0647 \u0634\u062F\u060C \u0628\u0627 vSmart (Controller) \u06A9\u0627\u0646\u0627\u0644 \u06A9\u0646\u062A\u0631\u0644 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u2014 DTLS \u0631\u0648\u06CC UDP 12346+n \u06CC\u0627 TLS \u0631\u0648\u06CC TCP 23456 \u2014 \u0648 \u0631\u0648\u06CC \u0647\u0645\u06CC\u0646 \u06A9\u0627\u0646\u0627\u0644\u060C \u067E\u0631\u0648\u062A\u06A9\u0644 OMP \u0641\u0639\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F. OMP \u0645\u0633\u06CC\u0631\u0647\u0627\u060C TLOC\u0647\u0627 \u0648 \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627 \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. vManage (Manager) \u0647\u0645 \u0628\u0631\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u060C \u0642\u0627\u0644\u0628\u200C\u0647\u0627 \u0648 \u062A\u0644\u0647\u200C\u0645\u062A\u0631\u06CC \u0627\u0633\u062A. \u062A\u0648\u062C\u0647: \u062F\u0631 \u0646\u0633\u062E\u0647\u200C\u0647\u0627\u06CC \u062C\u062F\u06CC\u062F \u0633\u06CC\u0633\u06A9\u0648 \u0627\u0633\u0645\u200C\u0647\u0627 \u0639\u0648\u0636 \u0634\u062F\u0647\u200C\u0627\u0646\u062F \u0648 \u06AF\u0641\u062A\u0646 \u0647\u0631 \u062F\u0648 \u0646\u0627\u0645\u060C \u062F\u0631 \u0645\u0635\u0627\u062D\u0628\u0647 \u0648 \u0622\u0632\u0645\u0648\u0646 \u0627\u0645\u062A\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F."],list:["vBond / Validator \u2014 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0648 \u0645\u0639\u0631\u0641\u06CC (UDP 12346)","vSmart / Controller \u2014 \u067E\u062E\u0634 \u0645\u0633\u06CC\u0631 \u0648 \u0633\u06CC\u0627\u0633\u062A \u0628\u0627 OMP","vManage / Manager \u2014 \u0642\u0627\u0644\u0628\u200C\u0647\u0627\u060C \u0645\u0627\u0646\u06CC\u062A\u0648\u0631\u06CC\u0646\u06AF\u060C API","WAN Edge \u2014 \u0631\u0648\u062A\u0631\u06CC \u06A9\u0647 \u0634\u0639\u0628\u0647 \u0631\u0627 \u0648\u0635\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F"]},{h:"TLOC\u060C OMP \u0648 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0633\u06CC\u0631",p:["\u0647\u0631 Edge \u0628\u0631\u0627\u06CC \u0647\u0631 \u062A\u0631\u06A9\u06CC\u0628 System-IP \u0648 Color \u06CC\u06A9 TLOC \u062F\u0627\u0631\u062F. Color \u06CC\u0639\u0646\u06CC \xAB\u0627\u0632 \u0686\u0647 \u0646\u0648\u0639 \u0644\u06CC\u0646\u06A9\u06CC \u0645\u06CC\u200C\u0622\u06CC\u0645\xBB: mpls\u060C biz-internet\u060C lte \u0648\u2026 . \u0648\u0642\u062A\u06CC \u0634\u0639\u0628\u0647\u200C\u0627\u06CC \u062F\u0648 \u0644\u06CC\u0646\u06A9 \u062F\u0627\u0631\u062F\u060C \u062F\u0648 TLOC \u062F\u0627\u0631\u062F \u0648 OMP \u0628\u0631\u0627\u06CC \u0647\u0631 \u0645\u0642\u0635\u062F \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u06A9\u062F\u0627\u0645 TLOC\u0647\u0627 \u0645\u0639\u062A\u0628\u0631\u0646\u062F \u0648 \u0628\u0627 \u0686\u0647 \u0627\u0648\u0644\u0648\u06CC\u062A\u06CC. Edge \u0637\u0628\u0642 \u0633\u06CC\u0627\u0633\u062A\u060C \u06CC\u06A9\u06CC \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0628\u062E\u0634 \u062C\u0630\u0627\u0628 \u0645\u0627\u062C\u0631\u0627 BFD \u0627\u0633\u062A: \u0631\u0648\u06CC \u0647\u0631 \u062A\u0648\u0646\u0644 IPsec \u06CC\u06A9 \u0633\u0634\u0646 BFD \u0647\u0633\u062A \u06A9\u0647 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0647\u0631 \u06F1\u06F0\u06F0\u06F0 \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647 hello \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F (multiplier \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u06F7 \u0631\u0648\u06CC \u0631\u0648\u062A\u0631 \u0633\u062E\u062A\u200C\u0627\u0641\u0632\u0627\u0631\u06CC). \u0627\u06CC\u0646 \u0633\u0646\u062C\u0634\u060C \u062F\u0627\u062F\u0647 \u062A\u0623\u062E\u06CC\u0631/\u0627\u0641\u062A/\u062C\u06CC\u062A\u0631 \u062A\u0648\u0644\u06CC\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 AAR (App-Aware Routing) \u0628\u0627 \u0622\u0646 \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0645\u062B\u0644\u0627\u064B \u0645\u06CC\u200C\u06AF\u0648\u06CC\u06CC \xAB\u062A\u0631\u0627\u0641\u06CC\u06A9 Teams \u0628\u0627\u06CC\u062F \u062A\u0623\u062E\u06CC\u0631 \u06A9\u0645\u062A\u0631 \u0627\u0632 \u06F1\u06F5\u06F0ms \u062F\u0627\u0634\u062A\u0