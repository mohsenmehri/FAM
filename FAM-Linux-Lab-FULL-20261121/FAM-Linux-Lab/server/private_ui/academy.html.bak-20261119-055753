62F\u0647\u200C\u0627\u0646\u062F. \u06A9\u0644\u0627\u06CC\u0646\u062A \u0647\u06CC\u0686\u200C\u0648\u0642\u062A \u0646\u0645\u06CC\u200C\u0641\u0647\u0645\u062F \u06A9\u0647 \u0631\u0648\u062A\u0631 \u0639\u0648\u0636 \u0634\u062F\u0647.","\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u06A9\u0644\u0627\u06CC\u0646\u062A \u062D\u062A\u06CC ARP \u0631\u0627 \u0647\u0645 \u0645\u062A\u0648\u062C\u0647 \u0646\u0634\u0648\u062F\u060C \u06CC\u06A9 MAC \u0645\u062C\u0627\u0632\u06CC \u0647\u0645 \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F \u06A9\u0647 \u0628\u0647 \u0622\u0646 \u0622\u062F\u0631\u0633 \u0645\u062C\u0627\u0632\u06CC \u0646\u06AF\u0627\u0634\u062A \u0645\u06CC\u200C\u0634\u0648\u062F. \u067E\u0633 \u06A9\u0627\u0631\u0628\u0631 \u0628\u0627 ARP \u0641\u0642\u0637 MAC \u0645\u062C\u0627\u0632\u06CC \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0648\u062A\u0631 \u067E\u0634\u062A \u0622\u0646 \u067E\u0646\u0647\u0627\u0646 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F."]},{h:"\u0633\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644\u060C \u0633\u0647 \u0631\u0641\u062A\u0627\u0631",p:["HSRP \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u0633\u06CC\u0633\u06A9\u0648 \u0627\u0633\u062A: \u06CC\u06A9 Active \u0648 \u06CC\u06A9 Standby\u060C \u0628\u0627 Priority \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u06F1\u06F0\u06F0 (\u0628\u0627\u0644\u0627\u062A\u0631 \u0628\u0631\u0646\u062F\u0647) \u0648 Preempt \u06A9\u0647 \u062F\u0631 \u0622\u0646 \u0631\u0648\u062A\u0631\u06CC \u06A9\u0647 \u062A\u0627\u0632\u0647 \u0628\u0627\u0644\u0627 \u0622\u0645\u062F\u0647 \u0648 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0627\u0644\u0627\u062A\u0631\u06CC \u062F\u0627\u0631\u062F\u060C \u06A9\u0646\u062A\u0631\u0644 \u0631\u0627 \u067E\u0633 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. VRRP \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0628\u0627\u0632 (RFC 5798) \u0627\u0633\u062A \u0648 \u0627\u0633\u0645\u200C\u0647\u0627\u06CC\u0634 Master \u0648 Backup \u0627\u0633\u062A\u061B \u062F\u0631 VRRP \u0622\u062F\u0631\u0633 \u0645\u062C\u0627\u0632\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0647\u0645\u0627\u0646 IP \u06CC\u06A9\u06CC \u0627\u0632 \u0631\u0648\u062A\u0631\u0647\u0627 \u0628\u0627\u0634\u062F \u06A9\u0647 \u062F\u0631 HSRP \u062A\u0648\u0635\u06CC\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","GLBP \u0627\u0632 \u0647\u0631 \u062F\u0648 \u062C\u0644\u0648\u062A\u0631 \u0645\u06CC\u200C\u0631\u0648\u062F: \u0647\u0645 \u0632\u0645\u0627\u0646 \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u0641\u0639\u0627\u0644 \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u062F\u0627\u0631\u062F\u060C \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0628\u06CC\u0646 \u0686\u0646\u062F \u0631\u0648\u062A\u0631 \u062A\u0642\u0633\u06CC\u0645 \u06A9\u0646\u062F (Load Balancing). \u0637\u0631\u06CC\u0642\u0647 \u06A9\u0627\u0631\u0634 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0628\u0631\u0627\u06CC \u06CC\u06A9 VIP \u0686\u0646\u062F MAC \u0645\u062C\u0627\u0632\u06CC \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u0648 \u0628\u0647 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 MAC\u0647\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u0645\u06CC\u200C\u062F\u0647\u062F\u061B \u0646\u062A\u06CC\u062C\u0647: \u0646\u0635\u0641 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0627\u0632 \u0631\u0648\u062A\u0631 A \u0648 \u0646\u0635\u0641 \u0627\u0632 \u0631\u0648\u062A\u0631 B \u0645\u06CC\u200C\u0631\u0648\u0646\u062F."],list:["HSRP \u2014 Active/Standby \xB7 Priority 100 \xB7 MAC \u0645\u062C\u0627\u0632\u06CC 0000.0c07.acXX","VRRP \u2014 Master/Backup \xB7 Priority 100 \xB7 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0628\u0627\u0632","GLBP \u2014 Active/Active \u0628\u0627 \u062A\u0648\u0632\u06CC\u0639 \u0628\u0627\u0631 \u0648 \u0686\u0646\u062F MAC \u0645\u062C\u0627\u0632\u06CC"]},{h:"Preempt \u0648 Tracking",p:["\u0628\u062F\u0648\u0646 Preempt\u060C \u0627\u06AF\u0631 \u0631\u0648\u062A\u0631 \u0628\u0627 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0627\u0644\u0627\u062A\u0631 \u0628\u0639\u062F\u0627\u064B \u0628\u0648\u062A \u0634\u0648\u062F\u060C \u0647\u0645\u0686\u0646\u0627\u0646 \u062F\u0631 \u062D\u0627\u0644\u062A Standby \u0645\u06CC\u200C\u0645\u0627\u0646\u062F \u0648 \u0631\u0648\u062A\u0631 \u0636\u0639\u06CC\u0641\u200C\u062A\u0631 Active \u0645\u06CC\u200C\u0645\u0627\u0646\u062F. \u067E\u0633 \u062F\u0631 \u0637\u0631\u0627\u062D\u06CC\u060C Preempt \u0631\u0627 \u0631\u0648\u0634\u0646 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645 \u062A\u0627 \u0646\u0642\u0634\u200C\u0647\u0627 \u0647\u0645\u06CC\u0634\u0647 \u0628\u0627 \u0627\u0648\u0644\u0648\u06CC\u062A \u062A\u0639\u0631\u06CC\u0641\u200C\u0634\u062F\u0647 \u0647\u0645\u200C\u062E\u0648\u0627\u0646 \u0628\u0627\u0634\u062F.","Tracking \u0647\u0645 \u0645\u06A9\u0645\u0644 Preempt \u0627\u0633\u062A: \u0645\u06CC\u200C\u06AF\u0648\u06CC\u06CC \xAB\u0627\u06AF\u0631 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 WAN \u0645\u0646 \u062E\u0648\u0627\u0628\u06CC\u062F\u060C \u0627\u0648\u0644\u0648\u06CC\u062A \u0645\u0646 \u06F2\u06F0 \u06A9\u0645 \u0634\u0648\u062F\xBB. \u0646\u062A\u06CC\u062C\u0647 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0648\u0642\u062A\u06CC \u0644\u06CC\u0646\u06A9 \u0631\u0648\u062A\u0631 Active \u0642\u0637\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0631\u0648\u062A\u0631 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u06A9\u0647 \u0644\u06CC\u0646\u06A9 \u0633\u0627\u0644\u0645\u06CC \u062F\u0627\u0631\u062F\u060C \u06A9\u0646\u062A\u0631\u0644 VIP \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0628\u062F\u0648\u0646 Tracking\u060C \u0631\u0648\u062A\u0631 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A Active \u0628\u0645\u0627\u0646\u06