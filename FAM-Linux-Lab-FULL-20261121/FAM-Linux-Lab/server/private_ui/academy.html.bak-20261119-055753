  <script id="fam-academy-fam-bridge" nonce="__FAM_CSP_NONCE__">
    window.FAM_ACADEMY_BOOTSTRAP = __FAM_ACADEMY_BOOTSTRAP__;
    (() => {
      'use strict';
      const boot = window.FAM_ACADEMY_BOOTSTRAP || {};
      const keys = new Set([
        'fam4.learn.v1', 'fam3.progress.v1', 'fam3.lab.v1', 'fam3.profile.v1',
        'fam3.level.v1', 'fam3.tour.v1', 'fam3.topo.positions', 'fam3.tab.v1',
        'fam.academy.theme'
      ]);
      let store;
      try { store = window.localStorage; } catch { return; }
      const rawSet = Storage.prototype.setItem;
      const rawRemove = Storage.prototype.removeItem;
      const rawClear = Storage.prototype.clear;
      const progress = boot.progress && typeof boot.progress === 'object' ? boot.progress : {};
      // The authenticated server copy is authoritative. Never inherit another
      // FAM account's old, browser-global Academy state on first use.
      for (const key of keys) {
        try {
          if (typeof progress[key] === 'string') rawSet.call(store, key, progress[key]);
          else rawRemove.call(store, key);
        } catch { /* Server data remains authoritative if browser quota is full. */ }
      }
      const pending = Object.create(null);
      let timer = 0, sending = false, inFlight = null, statusNode = null;
      const status = text => { if (statusNode) statusNode.textContent = text; };
      function schedule() {
        clearTimeout(timer);
        timer = setTimeout(flush, 350);
      }
      async function flush(keepalive = false) {
        if (sending || !Object.keys(pending).length || !boot.csrf) return;
        const changes = Object.assign(Object.create(null), pending);
        for (const key of Object.keys(changes)) delete pending[key];
        sending = true;
        inFlight = changes;
        try {
          const response = await fetch('/api/academy/progress', {
            method: 'POST', credentials: 'same-origin', keepalive,
            headers: { 'Content-Type': 'application/json', 'X-FAM-CSRF': boot.csrf },
            body: JSON.stringify({ changes })
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          status('پیشرفت در حساب FAM ذخیره شد');
          return true;
        } catch (error) {
          Object.assign(pending, changes, pending);
          status('ذخیرهٔ سروری انجام نشد؛ اتصال را بررسی کنید');
          return false;
        } finally {
          sending = false;
          inFlight = null;
          if (Object.keys(pending).length) {
            clearTimeout(timer);
            timer = setTimeout(flush, 2000);
          }
        }
      }
      Storage.prototype.setItem = function(key, value) {
        if (this !== store || !keys.has(String(key))) return rawSet.call(this, key, value);
        try { rawSet.call(this, key, value); } catch { /* The server copy can still be saved. */ }
        pending[String(key)] = String(value);
        status('در حال ذخیرهٔ پیشرفت…');
        schedule();
      };
      Storage.prototype.removeItem = function(key) {
        if (this !== store || !keys.has(String(key))) return rawRemove.call(this, key);
        try { rawRemove.call(this, key); } catch { /* The server copy can still be saved. */ }
        pending[String(key)] = null;
        status('در حال ذخیرهٔ پیشرفت…');
        schedule();
      };
      Storage.prototype.clear = function() {
        if (this !== store) return rawClear.call(this);
        for (const key of keys) {
          rawRemove.call(this, key);
          pending[key] = null;
        }
        status('در حال ذخیرهٔ پیشرفت…');
        schedule();
      };
      window.FAM_ACADEMY_FLUSH = flush;
      document.addEventListener('DOMContentLoaded', () => {
        // Keep save feedback available to assistive technology without adding a
        // floating account banner to the Academy layout.
        statusNode = document.createElement('span');
        statusNode.className = 'sr-only';
        statusNode.setAttribute('role', 'status');
        statusNode.setAttribute('aria-live', 'polite');
        statusNode.textContent = 'پیشرفت در همان حساب FAM ذخیره می‌شود';
        document.body.append(statusNode);
      }, { once: true });
      function flushOnPageHide() {
        clearTimeout(timer);
        // A normal save already in flight may be cancelled during navigation.
        // Re-send its snapshot plus any newer changes as a keepalive request.
        const changes = Object.assign(Object.create(null), inFlight || {}, pending);
        if (!Object.keys(changes).length || !boot.csrf) return;
        for (const key of Object.keys(pending)) delete pending[key];
        fetch('/api/academy/progress', {
          method: 'POST', credentials: 'same-origin', keepalive: true,
          headers: { 'Content-Type': 'application/json', 'X-FAM-CSRF': boot.csrf },
          body: JSON.stringify({ changes })
        }).catch(() => {});
      }
      window.addEventListener('pagehide', flushOnPageHide);
    })();
  </script>
  <script id="fam-theme-init" nonce="__FAM_CSP_NONCE__">
// Theme 1/2 is shared with the FAM workspace: dark/original = 1, light = 2.
try {
  var sharedTheme = localStorage.getItem('fam.ui.theme');
  var savedAcademyTheme = localStorage.getItem('fam.academy.theme');
  var t = sharedTheme === 'light' ? 'light' : sharedTheme === 'original' ? 'dark' :
    (savedAcademyTheme === 'light' || savedAcademyTheme === 'dark' ? savedAcademyTheme :
      (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));
  document.documentElement.dataset.theme = t;
  localStorage.setItem('fam.ui.theme', t === 'light' ? 'light' : 'original');
  localStorage.setItem('fam.academy.theme', t);
} catch (e) { document.documentElement.dataset.theme = 'dark'; }
</script>
