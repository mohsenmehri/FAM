\u06CC\u062F \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0641\u0642\u0637 \u0627\u0632 \u0633\u0645\u062A Root Bridge).","\u062F\u0633\u062A\u200C\u062A\u06A9\u0627\u0646\u06CC \u0633\u0631\u06CC\u0639 `Proposal / Agreement` \u062F\u0631 RSTP **\u0641\u0642\u0637** \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC Full-Duplex (`point-to-point`) \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC Half-Duplex (`shared`) \u067E\u0631\u0648\u062A\u06A9\u0644 \u0628\u0647 \u062A\u0627\u06CC\u0645\u0631\u0647\u0627\u06CC \u06A9\u0646\u062F \u0642\u062F\u06CC\u0645\u06CC \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F.","\u062A\u0641\u0627\u0648\u062A \u06A9\u0644\u06CC\u062F\u06CC **BPDU Guard** \u0648 **Root Guard**: \u0627\u0648\u0644\u06CC \u067E\u0648\u0631\u062A \u0631\u0627 `err-disabled` \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0631\u0648\u06CC \u067E\u0648\u0631\u062A Access \u06A9\u0627\u0631\u0628\u0631)\u061B \u062F\u0648\u0645\u06CC \u0641\u0642\u0637 \u0647\u0646\u06AF\u0627\u0645 \u062F\u0631\u06CC\u0627\u0641\u062A Superior BPDU \u067E\u0648\u0631\u062A \u0631\u0627 `root-inconsistent` \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F \u0648 \u062E\u0648\u062F\u06A9\u0627\u0631 \u0628\u0627\u0632\u06CC\u0627\u0628\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F (\u0631\u0648\u06CC \u067E\u0648\u0631\u062A Downlink \u0633\u0648\u0626\u06CC\u0686 \u062A\u0648\u0632\u06CC\u0639).","\u062F\u0631 \u0645\u0639\u0645\u0627\u0631\u06CC\u200C\u0647\u0627\u06CC \u0646\u0648\u06CC\u0646 \u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631 \u0648 \u067E\u0631\u062F\u06CC\u0633 ([[vxlan-evpn|\u0641\u0627\u0628\u0631\u06CC\u06A9 Spine-Leaf VXLAN]] \u0648 [[sda|Cisco SD-Access]])\u060C \u0628\u0647 \u062C\u0627\u06CC \u0645\u0633\u062F\u0648\u062F \u06A9\u0631\u062F\u0646 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627 \u0628\u0627 STP\u060C \u0644\u0627\u06CC\u0647 \u0632\u06CC\u0631\u06CC\u0646 \u062A\u0645\u0627\u0645\u0627\u064B \u0644\u0627\u06CC\u0647 \u06F3 \u0628\u0627 ECMP \u0637\u0631\u0627\u062D\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F \u062A\u0627 \u0627\u0632 \u06F1\u06F0\u06F0\u066A \u0638\u0631\u0641\u06CC\u062A \u0647\u0645\u0647 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0634\u0648\u062F."],glossary:[["BPDU","\u0641\u0631\u06CC\u0645 \u06A9\u0646\u062A\u0631\u0644\u06CC \u067E\u0631\u0648\u062A\u06A9\u0644 STP/RSTP \u06A9\u0647 \u0647\u0631 \u06F2 \u062B\u0627\u0646\u06CC\u0647 \u0628\u0631\u0627\u06CC \u0627\u0646\u062A\u062E\u0627\u0628 \u0631\u06CC\u0634\u0647 \u0648 \u06A9\u0634\u0641 \u062D\u0644\u0642\u0647 \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F."],["Bridge ID (BID)","\u0634\u0646\u0627\u0633\u0647 \u06F8 \u0628\u0627\u06CC\u062A\u06CC \u0647\u0631 \u0633\u0648\u0626\u06CC\u0686 \u0645\u062A\u0634\u06A9\u0644 \u0627\u0632 \u06F2 \u0628\u0627\u06CC\u062A \u0627\u0648\u0644\u0648\u06CC\u062A (\u0645\u0636\u0631\u0628 \u06F4\u06F0\u06F9\u06F6 + \u0634\u0645\u0627\u0631\u0647 VLAN) \u0648 \u06F6 \u0628\u0627\u06CC\u062A \u0622\u062F\u0631\u0633 MAC."],["Root Bridge","\u0633\u0648\u0626\u06CC\u0686 \u0645\u0631\u062C\u0639 \u0645\u0631\u06A9\u0632\u06CC \u062F\u0631\u062E\u062A STP \u0628\u0627 \u06A9\u0648\u0686\u06A9\u200C\u062A\u0631\u06CC\u0646 BID \u06A9\u0647 \u062A\u0645\u0627\u0645 \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u0641\u0639\u0627\u0644 \u0622\u0646 Designated \u0647\u0633\u062A\u0646\u062F."],["Root Port (RP)","\u062A\u0646\u0647\u0627 \u067E\u0648\u0631\u062A \u0647\u0631 \u0633\u0648\u0626\u06CC\u0686 \u063A\u06CC\u0631\u0631\u06CC\u0634\u0647 \u06A9\u0647 \u06A9\u0645\u062A\u0631\u06CC\u0646 \u0645\u062C\u0645\u0648\u0639 \u0647\u0632\u06CC\u0646\u0647 \u0645\u0633\u06CC\u0631 \u062A\u0627 Root Bridge \u0631\u0627 \u062F\u0627\u0631\u062F."],["Designated Port (DP)","\u067E\u0648\u0631\u062A \u0627\u0631\u0633\u0627\u0644\u200C\u06A9\u0646\u0646\u062F\u0647 \u0645\u0646\u062A\u062E\u0628 \u0631\u0648\u06CC \u0647\u0631 \u0633\u06AF\u0645\u0646\u062A \u0644\u06CC\u0646\u06A9 \u06A9\u0647 \u0647\u0632\u06CC\u0646\u0647 \u06A9\u0645\u062A\u0631\u06CC \u062A\u0627 \u0631\u06CC\u0634\u0647 \u0627\u0631\u0627\u0626\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F."],["RSTP (802.1w)","\u0646\u0633\u062E\u0647 \u0633\u0631\u06CC\u0639 STP \u0628\u0627 \u062D\u0627\u0644\u0627\u062A Discarding/Learning/Forwarding \u0648 \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC \u0632\u06CC\u0631\u062B\u0627\u0646\u06CC\u0647\u200C\u0627\u06CC Proposal/Agreement."],["PortFast","\u0639\u0628\u0648\u0631 \u0641\u0648\u0631\u06CC \u067E\u0648\u0631\u062A \u0633\u0645\u062A \u06A9\u0627\u0631\u0628\u0631 \u0628\u0647 \u062D\u0627\u0644\u062A Forwarding \u0648 \u062C\u0644\u0648\u06AF\u06CC\u0631\u06CC \u0627\u0632 \u062A\u0648\u0644\u06CC\u062F \u067E\u06CC\u0627\u0645\u200C\u0647\u0627\u06CC \u0645\u0632\u0627\u062D\u0645 TCN.","dhcp"],["BPDU Guard","\u062E\u0627\u0645\u0648\u0634 \u06A9\u0631\u062F\u0646 \u062D\u0641\u0627\u0638\u062A\u06CC (`err-disabled`) \u067E\u0648\u0631\u062A PortFast \u0628\u0647 \u0645\u062D\u0636 \u062F\u0631\u06CC\u0627\u0641\u062A \u0647\u0631\u06AF\u0648\u0646\u0647 BPDU.","l2-security"],["Root Guard","\u0645\u0633\u062F\u0648\u062F\u0633\u0627\u0632\u06CC \u0645\u0648\u0642\u062A \u067E\u0648\u0631\u062A (`root-inconsistent`) \u0647\u0646\u06AF\u0627\u0645 \u062F\u0631\u06CC\u0627\u0641\u062A BPDU \u0628\u0627 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0647\u062A\u0631 \u0627\u0632 \u0631\u06CC\u0634\u0647 \u0645\u062C\u0627\u0632."]]},etherchannel:{title:"EtherChannel \u0648 \u067E\u0631\u0648\u062A\u06A9\u0644 LACP \u2014 \u062A\u062C\u0645\u06CC\u0639 \u0647\u0648\u0634\u0645\u0646\u062F \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u060C \u0627\u0641\u0632\u0648\u0646\u06AF\u06CC \u0648 \u062A\u0648\u0632\u06CC\u0639 \u0628\u0627\u0631 \u0633\u062E\u062A\u200C\u0627\u0641\u