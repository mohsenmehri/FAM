u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u060C \u0633\u067E\u0633 \u062A\u0637\u0627\u0628\u0642 prefix-list \u0648 route-map\u060C seed metric\u060C \u0646\u0648\u0639 LSA \u06CC\u0627 \u0645\u0633\u06CC\u0631 \u062E\u0627\u0631\u062C\u06CC \u0648 \u0648\u0636\u0639\u06CC\u062A \u0647\u0645\u0633\u0627\u06CC\u0647 \u0645\u0642\u0635\u062F \u0631\u0627 \u0628\u0628\u06CC\u0646. \u062F\u0631 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0628\u0647 \u0647\u0631 \u062F\u0648 \u062C\u0647\u062A \u0648 Administrative Distance \u0646\u06AF\u0627\u0647 \u06A9\u0646. \u067E\u06CC\u0634 \u0627\u0632 \u062A\u063A\u06CC\u06CC\u0631 \u0639\u0645\u0644\u06CC\u0627\u062A\u06CC\u060C [[ospf-multi|LSA\u0647\u0627\u06CC OSPF]] \u0648 [[eigrp|\u0645\u062A\u0631\u06CC\u06A9 EIGRP]] \u0631\u0627 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646."],pbr:["Policy-Based Routing \u06CC\u0627 PBR \u0628\u0647 \u0631\u0648\u062A\u0631 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u0628\u0631\u0627\u06CC \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0645\u0646\u0637\u0628\u0642 \u0628\u0631 \u0633\u06CC\u0627\u0633\u062A\u060C \u062A\u0635\u0645\u06CC\u0645\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0632 lookup \u0639\u0627\u062F\u06CC \u0645\u0642\u0635\u062F \u0628\u06AF\u06CC\u0631\u062F. route-map \u062A\u0631\u062A\u06CC\u0628 \u0634\u0631\u0637 match \u0648 \u0639\u0645\u0644 set \u0631\u0627 \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0633\u06CC\u0627\u0633\u062A \u0627\u0639\u0645\u0627\u0644\u200C\u0634\u062F\u0647 \u0648\u0631\u0648\u062F\u06CC \u0628\u0631 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0639\u0628\u0648\u0631\u06CC \u0622\u0646 \u0631\u0627\u0628\u0637 \u0627\u062B\u0631 \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F\u061B \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062A\u0648\u0644\u06CC\u062F\u0634\u062F\u0647 \u062A\u0648\u0633\u0637 \u062E\u0648\u062F \u0631\u0648\u062A\u0631 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0628\u0647 local policy \u062C\u062F\u0627\u06AF\u0627\u0646\u0647 \u0646\u06CC\u0627\u0632 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F.","\u0641\u0631\u0636 \u06A9\u0646 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u06CC\u06A9 subnet \u0622\u0632\u0645\u0627\u06CC\u0634\u06CC \u0628\u0627\u06CC\u062F \u0627\u0632 \u0645\u0633\u06CC\u0631 WAN بانک \u062F\u0648\u0645 \u0628\u0631\u0648\u062F \u0648\u0644\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u06CC\u06AF\u0631 \u0627\u0632 \u062C\u062F\u0648\u0644 \u0639\u0627\u062F\u06CC \u067E\u06CC\u0631\u0648\u06CC \u06A9\u0646\u062F. ACL \u0645\u0648\u0631\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0628\u0631\u0627\u06CC match \u0646\u0642\u0634 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u062F\u0627\u0631\u062F\u060C \u0646\u0647 \u0627\u06CC\u0646\u06A9\u0647 \u0644\u0632\u0648\u0645\u0627\u064B \u0628\u0633\u062A\u0647 \u0631\u0627 \u0645\u0627\u0646\u0646\u062F ACL \u0641\u06CC\u0644\u062A\u0631 \u0631\u0627\u0628\u0637 drop \u06A9\u0646\u062F. \u062A\u0641\u0627\u0648\u062A set ip next-hop \u0628\u0627 default next-hop \u0648 \u0631\u0641\u062A\u0627\u0631 \u0634\u06A9\u0633\u062A next-hop \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0646\u0633\u062E\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0648 \u0642\u0627\u0628\u0644\u06CC\u062A verify-availability \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646.","\u0627\u0632 show route-map \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647\u200C\u0647\u0627\u06CC \u067E\u0644\u062A\u0641\u0631\u0645 \u0628\u0631\u0627\u06CC \u062A\u0637\u0628\u06CC\u0642\u060C \u0648 \u0627\u0632 traceroute \u06CC\u0627 \u0622\u0632\u0645\u0648\u0646 \u062C\u0631\u06CC\u0627\u0646 \u0648\u0627\u0642\u0639\u06CC \u062F\u0631 \u0647\u0631 \u062F\u0648 \u062C\u0647\u062A \u0628\u0631\u0627\u06CC \u0646\u062A\u06CC\u062C\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646. \u0645\u0633\u06CC\u0631 \u0628\u0631\u06AF\u0634\u062A\u060C NAT \u0648 \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 stateful \u0631\u0627 \u0646\u0627\u062F\u06CC\u062F\u0647 \u0646\u06AF\u06CC\u0631: \u0631\u0641\u062A \u0648 \u0628\u0631\u06AF\u0634\u062A \u0646\u0627\u0645\u062A\u0642\u0627\u0631\u0646 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0627\u0631\u062A\u0628\u0627\u0637 \u0631\u0627 \u0628\u0634\u06A9\u0646\u062F. [[acl|ACL]] \u0648 [[static-routing|\u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0633\u06CC\u0631]] \u067E\u06CC\u0634\u200C\u0646\u06CC\u0627\u0632 \u0627\u06CC\u0646 \u062A\u062D\u0644\u06CC\u0644\u200C\u0627\u0646\u062F."],"bgp-advanced":["\u0633\u06CC\u0627\u0633\u062A BGP \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u062F\u0627\u0645 prefix \u067E\u0630\u06CC\u0631\u0641\u062A\u0647 \u06CC\u0627 \u0627\u0639\u0644\u0627\u0645 \u0634\u0648\u062F \u0648 \u0628\u0627 \u0686\u0647 \u0648\u06CC\u0698\u06AF\u06CC\u200C\u0647\u0627\u06CC\u06CC \u0645\u0642\u0627\u06CC\u0633\u0647 \u0634\u0648\u062F. Prefix-list \u0628\u0631 \u0645\u0628\u0646\u0627\u06CC prefix \u0648 \u0637\u0648\u0644 \u0622\u0646 \u0641\u06CC\u0644\u062A\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B route-map \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0634\u0631\u0637\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0648\u06CC\u0698\u06AF\u06CC\u200C\u0647\u0627 \u0631\u0627 \u062A\u0631\u06A9\u06CC\u0628 \u06A9\u0646\u062F. Community \u0628\u0631\u0686\u0633\u0628\u06CC \u0628\u0631\u0627\u06CC \u062F\u0633\u062A\u0647\u200C\u0628\u0646\u062F\u06CC \u0648 \u0627\u0646\u062A\u0642\u0627\u0644 \u0633\u06CC\u0627\u0633\u062A \u0627\u0633\u062A\u060C \u0646\u0647 \u0631\u0645\u0632\u06AF\u0630\u0627\u0631\u06CC \u06CC\u0627 \u062A\u0636\u0645\u06CC\u0646 \u0645\u0646\u0634\u0623 \u0645\u0633\u06CC\u0631.","\u0627\u06AF\u0631 \u06CC\u06A9 \u0633\u0627\u0632\u0645\u0627\u0646 \u0628\u062E\u0648\u0627\u0647\u062F \u062E\u0631\u0648\u062C \u0627\u0632 \u0644\u06CC\u0646\u06A9