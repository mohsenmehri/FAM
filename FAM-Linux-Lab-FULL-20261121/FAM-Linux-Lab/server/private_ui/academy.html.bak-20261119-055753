2C \u0634\u0631\u0637 \u06CC\u06A9\u0633\u0627\u0646\u06CC \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u0639\u0636\u0648"],sections:[{h:"\u0645\u0633\u0626\u0644\u0647 \u0645\u0647\u0646\u062F\u0633\u06CC: \u0639\u0628\u0648\u0631 \u0627\u0632 \u0633\u0642\u0641 \u0633\u0631\u0639\u062A \u06CC\u06A9 \u067E\u0648\u0631\u062A \u0648 \u0645\u0627\u0646\u0639 STP",p:["\u0647\u0645\u0627\u0646\u200C\u0637\u0648\u0631 \u06A9\u0647 \u062F\u0631 \u0628\u062E\u0634 [[stp-rstp|\u067E\u0631\u0648\u062A\u06A9\u0644 STP \u0648 RSTP]] \u062F\u06CC\u062F\u06CC\u0645\u060C \u0627\u06AF\u0631 \u0628\u06CC\u0646 \u0633\u0648\u0626\u06CC\u0686 \u062F\u0633\u062A\u0631\u0633\u06CC \u0648 \u0633\u0648\u0626\u06CC\u0686 \u062A\u0648\u0632\u06CC\u0639 \u06F4 \u06A9\u0627\u0628\u0644 \u06CC\u06A9\u200C\u06AF\u06CC\u06AF\u0627\u0628\u06CC\u062A\u06CC \u0628\u06A9\u0634\u06CC\u062F \u062A\u0627 \u0628\u0647 \u0638\u0631\u0641\u06CC\u062A \u06F4 \u06AF\u06CC\u06AF\u0627\u0628\u06CC\u062A \u0628\u0631\u0633\u06CC\u062F\u060C STP \u0633\u0647 \u06A9\u0627\u0628\u0644 \u0627\u0632 \u0686\u0647\u0627\u0631 \u06A9\u0627\u0628\u0644 \u0631\u0627 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u062D\u0644\u0642\u0647 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u0648 **\u0645\u0633\u062F\u0648\u062F (Block)** \u0645\u06CC\u200C\u06A9\u0646\u062F! \u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u0647\u062F\u0631\u0631\u0641\u062A \u06F7\u06F5\u066A \u0638\u0631\u0641\u06CC\u062A\u060C \u0627\u06AF\u0631 \u0647\u0645\u0627\u0646 \u06CC\u06A9 \u06A9\u0627\u0628\u0644 \u0641\u0639\u0627\u0644 \u0642\u0637\u0639 \u0634\u0648\u062F\u060C \u0634\u0628\u06A9\u0647 \u0648\u0627\u0631\u062F \u0641\u0631\u0622\u06CC\u0646\u062F \u0628\u0627\u0632\u0645\u062D\u0627\u0633\u0628\u0647 \u062F\u0631\u062E\u062A \u0645\u06CC\u200C\u0634\u0648\u062F.","\u0641\u0646\u0627\u0648\u0631\u06CC **EtherChannel** (\u062F\u0631 \u0627\u062F\u0628\u06CC\u0627\u062A \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F IEEE \u0628\u0627 \u0646\u0627\u0645 **LAG \u2014 Link Aggregation Group**) \u06F2 \u062A\u0627 \u06F8 \u067E\u0648\u0631\u062A \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0647\u0645\u0633\u0627\u0646 \u0631\u0627 \u062F\u0631 \u06CC\u06A9 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0645\u062C\u0627\u0632\u06CC \u0648\u0627\u062D\u062F \u0628\u0647 \u0646\u0627\u0645 **`Port-channel`** \u0628\u0633\u062A\u0647\u200C\u0628\u0646\u062F\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0632 \u062F\u06CC\u062F STP \u0648 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC (\u0645\u0627\u0646\u0646\u062F [[ospf-single|OSPF]] \u06CC\u0627 [[eigrp|EIGRP]])\u060C \u0627\u06CC\u0646 \u0645\u062C\u0645\u0648\u0639\u0647 \u062F\u0642\u06CC\u0642\u0627\u064B **\u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u0645\u0646\u0637\u0642\u06CC \u0648\u0627\u062D\u062F** \u0628\u0627 \u0647\u0632\u06CC\u0646\u0647 \u06A9\u0645\u062A\u0631 \u0627\u0633\u062A\u061B \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646 \u0647\u0645\u0647 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627 \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0641\u0639\u0627\u0644\u200C\u0627\u0646\u062F \u0648 \u0627\u06AF\u0631 \u06CC\u06A9\u06CC \u0627\u0632 \u06A9\u0627\u0628\u0644\u200C\u0647\u0627 \u0642\u0637\u0639 \u0634\u0648\u062F\u060C \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u0631 \u06A9\u0633\u0631\u06CC \u0627\u0632 \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647 \u0631\u0648\u06CC \u0633\u0627\u06CC\u0631 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC \u0633\u0627\u0644\u0645 \u0628\u0627\u0646\u062F\u0644 \u062C\u0627\u0631\u06CC \u0645\u06CC\u200C\u0645\u0627\u0646\u062F \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646\u06A9\u0647 \u062D\u062A\u06CC STP \u062E\u0628\u0631\u062F\u0627\u0631 \u0634\u0648\u062F!"]},{h:"\u0645\u0642\u0627\u06CC\u0633\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u0645\u0630\u0627\u06A9\u0631\u0647: LACP (802.3ad) \u062F\u0631 \u0628\u0631\u0627\u0628\u0631 PAgP \u0648 \u062D\u0627\u0644\u062A \u0627\u06CC\u0633\u062A\u0627 (ON)",p:["\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u062F\u0648 \u0633\u0648\u0626\u06CC\u0686 \u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u0646\u062F \u06A9\u0627\u0628\u0644\u200C\u0647\u0627 \u0628\u0647 \u0627\u0634\u062A\u0628\u0627\u0647 \u0628\u0647 \u0633\u0648\u0626\u06CC\u0686 \u0633\u0648\u0645 \u06CC\u0627 \u0628\u0647 \u067E\u0648\u0631\u062A \u0627\u0634\u062A\u0628\u0627\u0647\u06CC \u0648\u0635\u0644 \u0646\u0634\u062F\u0647\u200C\u0627\u0646\u062F\u060C \u0627\u0632 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u0645\u0630\u0627\u06A9\u0631\u0647 \u067E\u0648\u06CC\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u062C\u0647\u0627\u0646\u06CC \u0648 \u0686\u0646\u062F\u0633\u0627\u0632\u0646\u062F\u0647 **LACP** (`IEEE 802.3ad / 802.1AX`) \u0628\u0627 \u0627\u0631\u0633\u0627\u0644 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644\u06CC **LACPDU** \u0628\u0647 \u0622\u062F\u0631\u0633 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A `01:80:C2:00:00:02` (\u0647\u0631 \u06F3\u06F0 \u062B\u0627\u0646\u06CC\u0647 \u062F\u0631 \u062D\u0627\u0644\u062A \u0639\u0627\u062F\u06CC \u0648 \u0647\u0631 \u06F1 \u062B\u0627\u0646\u06CC\u0647 \u062F\u0631 \u062D\u0627\u0644\u062A `lacp rate fast`) \u0633\u0644\u0627\u0645\u062A \u062A\u06A9\u200C\u062A\u06A9 \u062A\u0627\u0631\u0647\u0627 \u0631\u0627 \u0631\u0635\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F. LACP \u062D\u062A\u06CC \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u062A\u0627 **\u06F1\u06F6 \u067E\u0648\u0631\u062A** \u062F\u0631 \u06CC\u06A9 \u06AF\u0631\u0648\u0647 \u062A\u0639\u0631\u06CC\u0641 \u0634\u0648\u0646\u062F \u06A9\u0647 \u06F8 \u067E\u0648\u0631\u062A \u0628\u0627 \u06A9\u0645\u062A\u0631\u06CC\u0646 \u0639\u062F\u062F `Port Priority` \u0641\u0639\u0627\u0644 \u0634\u062F\u0647 \u0648 \u06F8 \u067E\u0648\u0631\u062A \u062F\u06CC\u06AF\u0631 \u062F\u0631 \u062D\u0627\u0644\u062A **Hot-Standby** \u0622\u0645\u0627\u062F\u0647 \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646\u06CC \u0641\u0648\u0631\u06CC \u0628\u0645\u0627\u0646\u0646\u062F."],table:{head:["\u0631\u0648\u0634 \u062A\u0634\u06A9\u06CC\u0644 \u0628\u0627\u0646\u062F\u0644","\u062D\u0627\u0644\u062A\u200C\u0647\u0627\u06CC \u062F\u0633\u062A\u0648\u0631 `channel-group`","\u062A\u0631\u06A9\u06CC\u0628\u200C\u0647\u0627\u06CC \u0645\u0648\u0641\u0642 \u062A\u0634\u06A9\u06CC\u0644 EtherChannel","\u062A\u0648\u0635\u06CC\u0647 \u0645\u0647\u0646\u062F\u0633\u06CC"],rows:[["**LACP** (`IEEE 802.3ad`)","`active` (\u0645\u0630\u0627\u06A9\u0631\u0647\u200C\u06AF\u0631 \u0641\u0639\u0627\u0644) \u0648 `passive` (\u0634\u0646\u0648\u0646\u062F\u0647)","`active + active` \u2705 \xB7 `active + passive` \u2705 (`passive + passive` \u274C)","**\u0628\u0647\u062A\u0631\u06CC\u0646 \u0627\u0646\u062A\u062E\u0627\u0628 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F** \u0628\u0631\u0627\u06CC \u0627\u062A\u0635\u0627\u0644 \u0633\u0648\u0626\u06CC\u0686\u200C\u0647\u0627\u060C \u0631\u0648\u062A\u0631\u0647\u0627\u060C \u0641\u0627\u06CC\u0631\u0648\u0627\u0644\u200C\u0647\u0627 \u0648 \u0633\u0631\u0648\u0631\u0647\u0627\u06CC \u0644\u06CC\u0646\u0648\u06A9\u0633/ESXi."],["**PAgP** (\u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u0633\u06CC\u0633\u06A9\u0648)","`desirable` (\u0641\u0639\u0627\u0644) \u0648 `auto` (\u0634\u0646\u0648\u0646\u062F\u0647)","`desirable + desirable` \u2705 \xB7 `desirable + auto` \u2705 (`auto + auto` \u274C)","\u0642\u062F\u06CC\u0645\u06CC \u0648 \u0641\u0642\u0637 \u0628\u06CC\u0646 \u062A\u062C\u0647\u06CC\u0632\u0627\u062A \u0633\u06CC\u0633\u06A9\u0648\u061B \u062F\u0631 \u0637\u0631\u0627\u062D\u06CC\u200C\u0647\u0627\u06CC \u062C\u062F\u06CC\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F."],["**Static / Manual**","`on` (\u0628\u062F\u0648\u0646 \u0647\u06CC\u0686 \u067E\u0631\u0648\u062A\u06A9\u0644 \u06A9\u0646\u062A\u0631\u0644\u06CC)","**\u0641\u0642\u0637** `on + on` \u2705 (\u062A\u0631\u06A9\u06CC\u0628 `on` \u0628\u0627 `active` \u06CC\u0627 `desirable` \u0641\u0627\u062C\u0639\u0647\u200C\u0628\u0627\u0631 \u0627\u0633\u062A!)","\u0628\u0633\u06CC\u0627\u0631 \u067E\u0631\u062E\u0637\u0631\u061B \u062F\u0631 \u0635\u0648\u0631\u062A \u062E\u0631\u0627\u0628\u06CC \u06CC\u06A9\u200C\u0637\u0631\u0641\u0647 \u0641\u06CC\u0628\u0631 \u06CC\u0627 \u0627\u0634\u062A\u0628\u0627\u0647 \u06A9\u0627\u0628\u0644\u200C\u06A9\u0634\u06CC\u060C \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u062D\u0644\u0642\u0647 \u0644\u0627\u06CC\u0647 \u06F2 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F."]]}},{h:"\u062A\u0648\u0632\u06CC\u0639 \u0628\u0627\u0631 \u062C\u0631\u06CC\u0627\u0646\u200C\u0645\u062D\u0648\u0631 (Per-Flow Hashing) \u2014 \u0686\u0631\u0627 \u06CC\u06A9 \u062F\u0627\u0646\u0644\u0648\u062F \u062A\u06A9\u06CC \u0633\u0631\u0639\u062A \u0631\u0627 \u062C\u0645\u0639 \u0646\u0645\u06CC\u200C\u0632\u0646\u062F\u061F",p:["\u06CC\u06A9 \u0633\u0648\u0621\u062A\u0641\u0627\u0647\u0645 \u0628\u0633\u06CC\u0627\u0631 \u0631\u0627\u06CC\u062C \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0628\u0627 \u0628\u0633\u062A\u0646 \u06F4 \u0644\u06CC\u0646\u06A9 \u06F1 \u06AF\u06CC\u06AF\u0627\u0628\u06CC\u062A\u06CC \u062F\u0631 \u0642\u0627\u0644\u0628 EtherChannel\u060C \u06CC\u06A9 \u06A9\u067E\u06CC \u0641\u0627\u06CC\u0644 \u062A\u06A9\u06CC \u0628\u06CC\u0646 \u0633\u0631\u0648\u0631 `A` \u0648 \u0633\u0631\u0648\u0631 `B` \u0628\u0627 \u0633\u0631\u0639\u062A `4 Gbps` \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F! \u062F\u0631 \u0648\u0627\u0642\u0639\u06CC\u062A \u0633\u0648\u0626\u06CC\u0686\u200C\u0647\u0627 \u0647\u0631\u06AF\u0632 \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC **\u06CC\u06A9 \u062C\u0631\u06CC\u0627\u0646 \u0648\u0627\u062D\u062F (Single TCP/UDP Flow)** \u0631\u0627 \u0628\u0647 \u0635\u0648\u0631\u062A \u0646\u0648\u0628\u062A\u06CC (Round-Robin \u0628\u0633\u062A\u0647 \u0628\u0647 \u0628\u0633\u062A\u0647) \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 \u067E\u062E\u0634 \u0646\u0645\u06CC\u200C\u06A9\u0646\u0646\u062F\u061B \u0632\u06CC\u0631\u0627 \u0631\u0633\u06CC\u062F\u0646 \u0632\u0648\u062F\u062A\u0631 \u0628\u0633\u062A\u0647 \u062F\u0648\u0645 \u0627\u0632 \u0628\u0633\u062A\u0647 \u0627\u0648\u0644 (`Out-of-Order Delivery`) \u0628\u0627\u0639\u062B \u0627\u0631\u0633\u0627\u0644 \u0631\u06AF\u0628\u0627\u0631\u06CC ACK \u062A\u06A9\u0631\u0627\u0631\u06CC \u062F\u0631 TCP \u0648 \u0633\u0642\u0648\u0637 \u0634\u062F\u06CC\u062F \u0633\u0631\u0639\u062A \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062F\u0631 \u0639\u0648\u0636\u060C \u062A\u0631\u0627\u0634\u0647 ASIC \u0633\u0648\u0626\u06CC\u0686 \u0639\u0645\u0644\u06CC\u0627\u062A \u0631\u06CC\u0627\u0636\u06CC **XOR Hash** \u0631\u0627 \u0631\u0648\u06CC \u0641\u06CC\u0644\u062F\u0647\u0627\u06CC \u0647\u062F\u0631 \u0628\u0633\u062A\u0647 \u0627\u0646\u062C\u0627\u0645 \u062F\u0627\u062F\u0647 \u0648 \u062E\u0631\u0648\u062C\u06CC \u0686\u0646\u062F\u0628\u06CC\u062A\u06CC \u0622\u0646 \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0627\u06CC\u0646 \u062C\u0631\u06CC\u0627\u0646 \u0645\u0634\u062E\u0635 \u0627\u0632 \u06A9\u062F\u0627\u0645 \u0639\u0636\u0648 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0639\u0628\u0648\u0631 \u06A9\u0646\u062F. \u0627\u06AF\u0631 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645 \u0647\u0634 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0633\u0648\u0626\u06CC\u0686 \u0641\u0642\u0637 `src-mac` \u0628\u0627\u0634\u062F \u0648 \u06A9\u0644 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0635\u062F\u0647\u0627 \u06A9\u0644\u0627\u06CC\u0646\u06