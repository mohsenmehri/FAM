0628\u0631\u0627\u06CC \u0634\u0639\u0628 \u06A9\u0648\u0686\u06A9 (\u062A\u0627 \u06F5\u2013\u06F1\u06F0 VLAN \u06A9\u0645\u200C\u062A\u0631\u0627\u0641\u06CC\u06A9) \u06A9\u0647 \u0641\u0642\u0637 \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F2 \u0648 \u06CC\u06A9 \u0631\u0648\u062A\u0631 WAN \u062F\u0627\u0631\u0646\u062F."],["**\u06F3. \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 (Multilayer Switch \u0628\u0627 SVI)**","\u062A\u0639\u0631\u06CC\u0641 \u062F\u0631\u0648\u0627\u0632\u0647\u200C\u0647\u0627\u06CC \u0645\u062C\u0627\u0632\u06CC **`interface Vlan X`** \u062F\u0631\u0648\u0646 \u062E\u0648\u062F \u0633\u0648\u0626\u06CC\u0686 \u0648 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0633\u062E\u062A\u200C\u0627\u0641\u0632\u0627\u0631\u06CC \u0628\u0627 **ASIC / CEF**","\u0633\u0631\u0639\u062A \u0633\u06CC\u0645 (**Wire-Speed**\u061B \u0635\u062F\u0647\u0627 \u0645\u06CC\u0644\u06CC\u0648\u0646 \u0628\u0633\u062A\u0647 \u062F\u0631 \u062B\u0627\u0646\u06CC\u0647!)","**\u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0642\u0637\u0639\u06CC \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u067E\u0631\u062F\u06CC\u0633 \u0648 \u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631 \u0645\u062F\u0631\u0646.**"]]}},{h:"\u06A9\u0627\u0644\u0628\u062F\u0634\u06A9\u0627\u0641\u06CC \u06AF\u0627\u0645\u200C\u0628\u0647\u200C\u06AF\u0627\u0645 \u062D\u0631\u06A9\u062A \u0628\u0633\u062A\u0647 \u062F\u0631 Router-on-a-Stick",p:["\u0628\u06CC\u0627\u06CC\u06CC\u062F \u0633\u0641\u0631 \u06CC\u06A9 \u067E\u06CC\u0646\u06AF \u0627\u0632 `PC1 (192.168.10.10)` \u062F\u0631 `VLAN 10` \u0628\u0647 `PC2 (192.168.20.20)` \u062F\u0631 `VLAN 20` \u0631\u0627 \u062F\u0631 \u0645\u0639\u0645\u0627\u0631\u06CC ROAS \u0644\u062D\u0638\u0647\u200C\u0628\u0647\u200C\u0644\u062D\u0638\u0647 \u0632\u06CC\u0631 \u0630\u0631\u0647\u200C\u0628\u06CC\u0646 \u0628\u0628\u0631\u06CC\u0645 (\u06CC\u06A9 \u0642\u0627\u0646\u0648\u0646 \u0637\u0644\u0627\u06CC\u06CC \u0634\u0628\u06A9\u0647 \u0631\u0627 \u0628\u0647 \u062E\u0627\u0637\u0631 \u0628\u0633\u067E\u0627\u0631\u06CC\u062F: **\u062F\u0631 \u0637\u0648\u0644 \u0645\u0633\u06CC\u0631 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0639\u0627\u062F\u06CC \u0628\u062F\u0648\u0646 NAT\u060C \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC IP \u0645\u0628\u062F\u0623 \u0648 \u0645\u0642\u0635\u062F \u0647\u0631\u06AF\u0632 \u062A\u063A\u06CC\u06CC\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u0646\u062F\u060C \u0627\u0645\u0627 \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC MAC \u0645\u0628\u062F\u0623 \u0648 \u0645\u0642\u0635\u062F \u062F\u0631 \u0647\u0631 \u067E\u0631\u0634 \u0644\u0627\u06CC\u0647 \u06F3 \u0627\u0632 \u0646\u0648 \u0646\u0648\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F!**):"],ol:["**\u06AF\u0627\u0645 \u06F1 (ARP \u0628\u0631\u0627\u06CC \u062F\u0631\u0648\u0627\u0632\u0647):** `PC1` \u06CC\u06A9 \u062F\u0631\u062E\u0648\u0627\u0633\u062A ARP \u062F\u0631 `VLAN 10` \u0628\u0631\u0627\u06CC \u06CC\u0627\u0641\u062A\u0646 \u0645\u06A9\u0650 \u062F\u0631\u0648\u0627\u0632\u0647\u200C\u0627\u0634 (`192.168.10.1`) \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F \u0648 \u0645\u06A9\u0650 \u0632\u06CC\u0631-\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 `Gi0/0.10` \u0631\u0648\u062A\u0631 \u0631\u0627 \u06CC\u0627\u062F \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F.","**\u06AF\u0627\u0645 \u06F2 (\u0627\u0631\u0633\u0627\u0644 \u0628\u062F\u0648\u0646 \u062A\u06AF \u0627\u0632 PC1 \u0628\u0647 \u0633\u0648\u0626\u06CC\u0686):** `PC1` \u0641\u0631\u06CC\u0645 \u0631\u0627 \u0628\u0627 `SrcIP=192.168.10.10`\u060C `DstIP=192.168.20.20`\u060C `SrcMAC=MAC_PC1` \u0648 `DstMAC=MAC_Router` \u0628\u0647 \u067E\u0648\u0631\u062A Access \u0633\u0648\u0626\u06CC\u0686 \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F.","**\u06AF\u0627\u0645 \u06F3 (\u062F\u0631\u062C \u062A\u06AF 10 \u0631\u0648\u06CC Trunk \u0628\u0647 \u0633\u0645\u062A \u0631\u0648\u062A\u0631):** \u0633\u0648\u0626\u06CC\u0686 \u0645\u06CC\u200C\u0628\u06CC\u0646\u062F \u0645\u06A9\u0650 \u0645\u0642\u0635\u062F (`MAC_Router`) \u067E\u0634\u062A \u067E\u0648\u0631\u062A Trunk \u0627\u0633\u062A\u061B \u067E\u0633 \u062A\u06AF \u06F4 \u0628\u0627\u06CC\u062A\u06CC `802.1Q (VID=10)` \u0631\u0627 \u0628\u0647 \u0641\u0631\u06CC\u0645 \u0645\u06CC\u200C\u0632\u0646\u062F \u0648 \u0631\u0648\u06CC \u06A9\u0627\u0628\u0644 \u062A\u0631\u0627\u0646\u06A9 \u0628\u0647 `R1` \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F.","**\u06AF\u0627\u0645 \u06F4 (\u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u062F\u0631\u0648\u0646 \u0631\u0648\u062A\u0631 \u0648 \u062A\u0639\u0648\u06CC\u0636 \u062A\u06AF \u0628\u0647 20):** \u0631\u0648\u062A\u0631 \u0641\u0631\u06CC\u0645 \u062A\u06AF\u200C\u062F\u0627\u0631 \u06F1\u06F0 \u0631\u0627 \u0631\u0648\u06CC \u0632\u06CC\u0631-\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 `Gi0/0.10` \u0628\u0627\u0632\u06AF\u0634\u0627\u06CC\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC (**RIB/CEF**) \u0631\u0627 \u0646\u06AF\u0627\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0641\u06CC\u0644\u062F `TTL` \u0628\u0633\u062A\u0647 IP \u0631\u0627 \u06CC\u06A9 \u0648\u0627\u062D\u062F \u06A9\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F (`64 \u2192 63`)\u060C \u0648 \u0645\u06CC\u200C\u0628\u06CC\u0646\u062F \u0645\u0642\u0635\u062F `192.168.20.0/24` \u0631\u0648\u06CC \u0632\u06CC\u0631-\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 `Gi0/0.20` \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u062F! \u0631\u0648\u062A\u0631 \u0641\u0631\u06CC\u0645 \u062C\u062F\u06CC\u062F\u06CC \u0628\u0627 `SrcMAC=MAC_Router`\u060C `DstMAC=MAC_PC2` \u0648 **\u062A\u06AF \u062C\u062F\u06CC\u062F `802.1Q (VID=20)`** \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u0648 \u0627\u0632 \u0647\u0645\u0627\u0646 \u06A9\u0627\u0628\u0644 \u062A\u0631\u0627\u0646\u06A9 \u0628\u0647 \u0633\u0648\u0626\u06CC\u0686 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F (\u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0641\u062A \u0648 \u0628\u0631\u06AF\u0634\u062A \u062F\u0648\u0628\u0627\u0631 \u0627\u0632 \u0647\u0645\u0627\u0646 \u06CC\u06A9 \u06A9\u0627\u0628\u0644 \u0631\u062F \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u0628\u0647 \u0622\u0646 \u06AF\u0644\u0648\u06AF\u0627\u0647 *Hairpinning* \u0645\u06CC\u200C\u06AF\u0648\u06CC\u0646\u062F).","**\u06AF\u0627\u0645 \u06F5 (\u062D\u0630\u0641 \u062A\u06AF \u0648 \u062A\u062D\u0648\u06CC\u0644 \u0628\u0647 PC2):** \u0633\u0648\u0626\u06CC\u0686 \u0641\u0631\u06CC\u0645 \u062F\u0627\u0631\u0627\u06CC \u062A\u06AF \u06F2\u06F0 \u0631\u0627 \u062F\u0631\u06CC\u0627\u0641\u062A \u06A9\u0631\u062F\u0647\u060C \u062F\u0631 \u062C\u062F\u0648\u0644 MAC \u067E\u0648\u0631\u062A Access \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 `PC2` \u0631\u0627 \u0645\u06CC\u200C\u06CC\u0627\u0628\u062F\u060C \u062A\u06AF \u06F2\u06F0 \u0631\u0627 \u0628\u0631\u0645\u06CC\u200C\u062F\u0627\u0631\u062F \u0648 \u0641\u0631\u06CC\u0645 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0631\u0627 \u0628\u0647 `PC2` \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F."]},{h:"\u0645\u0639\u0645\u0627\u0631\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3: \u062A\u0641\u0627\u0648\u062A SVI \u0648 \u067E\u0648\u0631\u062A \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC\u200C\u0634\u062F\u0647 (Routed Port)",p:["\u062F\u0631 \u06CC\u06A9 \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 (\u0645\u0627\u0646\u0646\u062F \u0633\u0631\u06CC Catalyst 9300/9500)\u060C \u0647\u0631 \u062F\u0648 \u06A9\u0627\u0631 \u0633\u0648\u0626\u06CC\u0686\u06CC\u0646\u06AF \u0648 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0631\u0648\u06CC \u062A\u0631\u0627\u0634\u0647 \u0633\u062E\u062A\u200C\u0627\u0641\u0632\u0627\u0631\u06CC **ASIC** \u0628\u0627 \u062C\u062F\u0648\u0644 **CEF** \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u062F\u06CC\u06AF\u0631 \u0646\u06CC\u0627\u0632\u06CC \u0628\u0647 \u062E\u0631\u0648\u062C \u0641\u0631\u06CC\u0645 \u0628\u0647 \u0631\u0648\u062A\u0631 \u0628\u06CC\u0631\u0648\u0646\u06CC \u0646\u06CC\u0633\u062A. \u0631\u0648\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 \u062F\u0648 \u0646\u0648\u0639 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0644\u0627\u06CC\u0647 \u06F3 \u062F\u0627\u0631\u06CC\u0645:","**\u06F1) \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0645\u062C\u0627\u0632\u06CC \u0633\u0648\u0626\u06CC\u0686\u200C\u0634\u062F\u0647 (SVI \u2014 Switched Virtual Interface):** \u0645\u0627\u0646\u0646\u062F `interface Vlan 10` \u06A9\u0647 \u0646\u0645\u0627\u06CC\u0646\u062F\u0647 \u0645\u0646\u0637\u0642\u06CC \u06CC\u06A9 VLAN \u062F\u0631 \u0645\u0648\u062A\u0648\u0631 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0627\u0633\u062A \u0648 \u0646\u0642\u0634 Default Gateway \u062A\u0645\u0627\u0645 \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u0639\u0636\u0648 \u0622\u0646 VLAN \u0631\u0627 \u0628\u0627\u0632\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F.","**\u06F2) \u067E\u0648\u0631\u062A \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC\u200C\u0634\u062F\u0647 \u0641\u06CC\u0632\u06CC\u06A9\u06CC (Routed Port):** \u06CC\u06A9 \u067E\u0648\u0631\u062A \u0641\u06CC\u0632\u06CC\u06A9\u06CC (\u0645\u062B\u0644\u0627\u064B `Gi1/0/48`) \u06A9\u0647 \u0631\u0648\u06CC \u0622\u0646 \u062F\u0633\u062A\u0648\u0631 **`no switchport`** \u0631\u0627 \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645\u061B \u0628\u0627 \u0627\u06CC\u0646 \u062F\u0633\u062A\u0648\u0631 \u067E\u0648\u0631\u062A \u06A9\u0627\u0645\u0644\u0627\u064B \u0627\u0632 \u062F\u0646\u06CC\u0627\u06CC \u0644\u0627\u06CC\u0647 \u06F2 (VLAN\u060C STP \u0648 DTP) \u062C\u062F\u0627 \u0634\u062F\u0647 \u0648 \u0639\u06CC\u0646\u0627\u064B \u062A\u0628\u062F\u06CC\u0644 \u0628\u0647 \u06CC\u06A9 \u067E\u0648\u0631\u062A \u0631\u0648\u062A\u0631 \u0628\u0631\u0627\u06CC \u0644\u06CC\u0646\u06A9 \u0646\u0642\u0637\u0647\u200C\u0628\u0647\u200C\u0646\u0642\u0637\u0647 `/30` \u0628\u0647 \u0633\u0645\u062A \u0647\u0633\u062A\u0647 \u0634\u0628\u06A9\u0647 \u06CC\u0627 \u0631\u0648\u062A\u0631 WAN بانک \u0645\u06CC\u200C\u0634\u0648\u062F."],callout:{kind:"warn",title:"\u0642\u0627\u0646\u0648\u0646 \u0637\u0644\u0627\u06CC\u06CC \u0633\u0647\u200C\u0634\u0631\u0637\u06CC \u0628\u0631\u0627\u06CC `up/up` \u0634\u062F\u0646 \u06CC\u06A9 SVI (\u0628\u0633\u06CC\u0627\u0631 \u067E\u0631\u062A\u06A9\u0631\u0627\u0631 \u062F\u0631 \u0622\u0632\u0645\u0648\u0646 \u0648 \u062A\u06CC\u06A9\u062A\u200C\u0647\u0627!)",text:"\u0686\u0631\u0627 \u06AF\u0627\u0647\u06CC `interface Vlan 20` \u0645\u06CC\u200C\u0633\u0627\u0632\u06CC\u062F \u0648 `no shutdown` \u0647\u0645 \u0645\u06CC\u200C\u0632\u0646\u06CC\u062F \u0627\u0645\u0627 \u0648\u0636\u0639\u06CC\u062A \u0622\u0646 `up / line protocol is down` \u0645\u06CC\u200C\u0645\u0627\u0646\u062F\u061F \u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u06CC\u06A9 SVI \u062F\u0631 \u0648\u0636\u0639\u06CC\u062A `up/up` \u0642\u0631\u0627\u0631 \u06AF\u06CC\u0631\u062F\u060C **\u0647\u0631 \u0633\u0647 \u0634\u0631\u0637 \u0632\u06CC\u0631 \u0628\u0627\u06CC\u062F \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0628\u0631\u0642\u0631\u0627\u0631 \u0628\u0627\u0634\u0646\u062F**: \u06F1) \u062E\u0648\u062F `vlan 20` \u062F\u0631 \u062F\u06CC\u062A\u0627\u0628\u06CC\u0633 VLAN \u0633\u0648\u0626\u06CC\u0686 \u0633\u0627\u062E\u062A\u0647 \u0634\u062F\u0647 \u0648 `active` \u0628\u0627\u0634\u062F (\u0641\u0642\u0637 \u0646\u0648\u0634\u062A\u0646 `interface Vlan 20` \u0647\u0631\u06AF\u0632 \u062E\u0648\u062F\u0650 VLAN 20 \u0631\u0627 \u062F\u0631 \u062F\u06CC\u062A\u0627\u0628\u06CC\u0633 \u0646\u0645\u06CC\u200C\u0633\u0627\u0632\u062F!)\u060C \u06F2) \u062D\u062F\u0627\u0642\u0644 **\u06CC\u06A9 \u067E\u0648\u0631\u062A \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0631\u0648\u0634\u0646** (Access \u062F\u0631 VLAN 20 \u06CC\u0627 Trunk \u0645\u062C\u0627\u0632 \u0628\u0631\u0627\u06CC VLAN 20) \u0648\u062C\u0648\u062F \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F \u06A9\u0647 \u062A\u0648\u0633\u0637 STP \u0645\u0633\u062F\u0648\u062F \u0646\u0634\u062F\u0647 \u0648 \u062F\u0631 \u062D\u0627\u0644\u062A **Forwarding** \u0628\u0627\u0634\u062F (\u0645\u06AF\u0631 \u0627\u06CC\u0646\u06A9\u0647 \u0642\u0627\u0628\u0644\u06CC\u062A `autostate exclude` \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0634\u0648\u062F)\u060C \u0648 \u06F3) \u062E\u0648\u062F `interface Vlan 20` \u062F\u0633\u062A\u0648\u0631 `no shutdown` \u062E\u0648\u0631\u062F\u0647 \u0628\u0627\u0634\u062F."}},{h:"\u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u06A9\u0627\u0645\u0644 \u0647\u0631 \u062F\u0648 \u0631\u0648\u0634 \u062F\u0631 Cisco IOS",cli:{title:"\u0627\u0644\u0641) \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC Router-on-a-Stick (ROAS) \u0648 \u0628) \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 \u0628\u0627 SVI \u0648 Routed Port",code:`! ================= \u0627\u0644\u0641) \u0633\u0645\u062A \u0631\u0648\u062A\u0631 \u062F\u0631 \u0631\u0648\u0634 Router-on-a-Stick =================
