\u06CC \u06A9\u0645\u200C\u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F (WAN)\u060C \u0648 policing \u062F\u0631 \u0648\u0631\u0648\u062F\u06CC \u0627\u0632 BANK-WAN."}},{h:"Policing \u06CC\u0627 Shaping\u061F",p:["Policing \u0646\u0631\u062E \u0631\u0627 \u0645\u06CC\u200C\u0633\u0646\u062C\u062F \u0648 \u0628\u0633\u062A\u0647 \u0628\u06CC\u0634\u062A\u0631 \u0627\u0632 \u062D\u062F \u0631\u0627 \u062D\u0630\u0641 \u06CC\u0627 re-mark \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F \u0648\u0644\u06CC \u0628\u0633\u062A\u0647 \u0645\u06CC\u200C\u0631\u06CC\u0632\u062F. Shaping \u0628\u0633\u062A\u0647 \u0627\u0636\u0627\u0641\u0647 \u0631\u0627 \u0628\u0627\u0641\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u062A\u0627 \u0646\u0631\u062E \u0647\u0645\u0648\u0627\u0631 \u0634\u0648\u062F\u061B \u0628\u0633\u062A\u0647 \u0646\u0645\u06CC\u200C\u0631\u06CC\u0632\u062F \u0648\u0644\u06CC \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0642\u0627\u0639\u062F\u0647 \u0633\u0627\u062F\u0647: \u0631\u0648\u06CC \u062E\u0631\u0648\u062C\u06CC \u0628\u0647 \u0633\u0645\u062A \u0644\u06CC\u0646\u06A9 \u06A9\u0645\u200C\u0633\u0631\u0639\u062A \u0627\u0632 Shaping (\u0686\u0648\u0646 BANK-WAN \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0633\u0631\u06CC\u0639\u200C\u062A\u0631 \u0627\u0632 CIR \u062A\u062D\u0648\u06CC\u0644 \u0628\u062F\u0647\u062F) \u0648 \u0631\u0648\u06CC \u0648\u0631\u0648\u062F\u06CC \u0627\u0632 Policing \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646."]}],analogy:"QoS \u0645\u062B\u0644 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0635\u0641 \u0641\u0631\u0648\u062F\u06AF\u0627\u0647 \u0627\u0633\u062A: \u0686\u0645\u062F\u0627\u0646\u200C\u0647\u0627\u06CC \u0641\u0648\u0631\u06CC (\u0635\u062F\u0627) \u062F\u0631 \u062E\u0637 \u0633\u0631\u06CC\u0639\u060C \u0645\u0633\u0627\u06