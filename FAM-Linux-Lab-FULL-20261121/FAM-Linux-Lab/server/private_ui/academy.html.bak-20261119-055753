<script id="fam-academy-sticky-header-fade-js" nonce="__FAM_CSP_NONCE__">
(()=>{
  let initialized=false;
  const init=()=>{
    const topbar=document.querySelector('.topbar');
    if(!topbar||initialized)return !!topbar;
    initialized=true;
    const bars=()=>document.querySelectorAll('.academy-section-head');
    let alignQueued=false,pinQueued=false;
    const align=()=>{
      alignQueued=false;
      const target=topbar.getBoundingClientRect();
      if(!target.width)return;
      for(const bar of bars()){
        if(!bar.getClientRects().length)continue;
        const transition=bar.style.transition;
        bar.style.transition='none';
        bar.style.transform='none';
        bar.style.width=`${target.width}px`;
        const mobile=window.matchMedia('(max-width: 860px)').matches;
        bar.style.minHeight=`${Math.max(mobile?58:62,target.height)}px`;
        const base=bar.getBoundingClientRect();
        bar.style.transform=`translateX(${target.left-base.left}px)`;
        bar.style.transition=transition;
      }
    };
    const updatePinned=()=>{
      pinQueued=false;
      for(const bar of bars()){
        if(!bar.getClientRects().length)continue;
        const top=parseFloat(getComputedStyle(bar).top)||0,box=bar.getBoundingClientRect();
        bar.classList.toggle('is-stuck',box.top<=top+1&&box.bottom>top);
      }
    };
    const scheduleAlign=()=>{if(!alignQueued){alignQueued=true;requestAnimationFrame(align);}};
    const schedulePinned=()=>{if(!pinQueued){pinQueued=true;requestAnimationFrame(updatePinned);}};
    const mo=new MutationObserver(scheduleAlign);
    mo.observe(document.getElementById('app')||document.body,{childList:true,subtree:true,attributes:true,attributeFilter:['class']});
    document.addEventListener('scroll',schedulePinned,{capture:true,passive:true});
    window.addEventListener('scroll',schedulePinned,{passive:true});
    window.addEventListener('resize',scheduleAlign,{passive:true});
    document.addEventListener('click',scheduleAlign,true);
    document.addEventListener('transitionend',scheduleAlign,true);
    scheduleAlign();updatePinned();
    return true;
  };
  if(!init()){
    const bootObserver=new MutationObserver(()=>{if(init())bootObserver.disconnect();});
    bootObserver.observe(document.getElementById('app')||document.body,{childList:true,subtree:true});
  }
})();
