.academy-brand-transition::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(152,215,231,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(152,215,231,.05) 1px,transparent 1px);background-size:52px 52px;mask-image:radial-gradient(ellipse at center,#000,transparent 78%);}
.academy-brand-transition-content{position:relative;z-index:1;display:grid;justify-items:center;gap:12px;text-align:center;animation:fam-academy-brand-mark var(--brand-duration,900ms) cubic-bezier(.16,1,.3,1) both;}
.academy-brand-transition-logo{width:clamp(110px,18vw,170px);height:clamp(110px,18vw,170px);border-radius:50%;background-color:#fff;background-size:88%;filter:drop-shadow(0 20px 40px rgba(0,0,0,.35));}
.academy-brand-transition-name{font-size:clamp(24px,4vw,34px);font-weight:900;letter-spacing:.12em;}
.academy-brand-transition-sub{font-size:12px;color:rgba(226,243,248,.75);}
@keyframes fam-academy-brand-mark{0%{opacity:0;transform:translateY(18px) scale(.68);filter:blur(9px)}35%{opacity:1;transform:translateY(0) scale(1.04);filter:blur(0)}70%{opacity:1;transform:scale(1);filter:blur(0)}100%{opacity:0;transform:scale(.97);filter:blur(2px)}}
@keyframes fam-academy-brand-out{0%,72%{opacity:1}100%{opacity:0;visibility:hidden}}
@media(prefers-reduced-motion:reduce){.academy-brand-transition,.academy-brand-transition *{animation:none!important;}}
</style>
<script id="fam-academy-brand-transition-js" nonce="__FAM_CSP_NONCE__">
(()=>{
 'use strict';
 const root=document.documentElement,reduce=!!(matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);
 const timeKey='fam.cinematic.transition.duration-ms.v1',motionKey='fam.ui.motion.enabled.v1';
 const enabled=()=>{try{return localStorage.getItem(motionKey)!=='0'}catch(_){return true}};
 const duration=()=>{try{const n=Number(localStorage.getItem(timeKey));if(Number.isFinite(n)&&n>=500&&n<=8000)return n}catch(_){}return 1800};
 function show(ms=duration()){
  if(reduce||!enabled())return false;
  const layer=document.createElement('section');layer.className='academy-brand-transition';layer.setAttribute('aria-hidden','true');layer.style.setProperty('--brand-duration',ms+'ms');
  const content=document.createElement('div');content.className='academy-brand-transition-content';
  const logo=document.createElement('span');logo.className='brand-logo academy-brand-transition-logo';
  const name=document.createElement('span');name.className='academy-brand-transition-name';name.textContent='FAM';
  const sub=document.createElement('span');sub.className='academy-brand-transition-sub';sub.textContent='آکادمی فام · FAM ACADEMY';
  content.append(logo,name,sub);layer.append(content);document.body.append(layer);setTimeout(()=>layer.remove(),ms+40);return true;
 }
 let arrivingFromFAM=false;try{arrivingFromFAM=new URLSearchParams(location.search).get('fam-brand-transition')==='1'}catch(_){}
 if(!arrivingFromFAM)document.addEventListener('DOMContentLoaded',()=>show(),{once:true});
 document.addEventListener('click',event=>{
  const origin=event.target instanceof Element?event.target:null;
  const link=origin?.closest('a[href^="/app"]');if(!link)return;
  if(event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
  if(link.target&&link.target!=='_self')return;
  event.preventDefault();event.stopImmediatePropagation();
  const ms=duration();if(!show(ms)){location.assign(link.href);return;}
  setTimeout(()=>location.assign(link.href),ms);
 },true);
})();
</script>
