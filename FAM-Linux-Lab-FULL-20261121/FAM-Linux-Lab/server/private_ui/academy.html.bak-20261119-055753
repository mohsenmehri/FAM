39\u062B \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \xAB\u0633\u0627\u06CC\u062A \u0628\u0627 IPv4 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0628\u0627 IPv6 \u06A9\u0646\u062F \u0627\u0633\u062A\xBB \u0628\u0634\u0648\u062F \u06CC\u06A9 \u062A\u06CC\u06A9\u062A \u0648\u0627\u0642\u0639\u06CC (PMTUD \u0648 MTU \u062A\u0648\u0646\u0644)."]}],debug:["`show ipv6 interface brief` \u2192 \u0622\u062F\u0631\u0633 link-local \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F\u061F \u0627\u06AF\u0631 \u0646\u0647\u060C \u0644\u06CC\u0646\u06A9/\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0645\u0634\u06A9\u0644 \u062F\u0627\u0631\u062F.","`show ipv6 neighbors` \u2192 \u0647\u0645\u0633\u0627\u06CC\u0647\u200C\u0647\u0627\u06CC \u06A9\u0634\u200C\u0634\u062F\u0647 \u0631\u0627 \u0628\u0628\u06CC\u0646\u061B \u062C\u062F\u0648\u0644 \u062E\u0627\u0644\u06CC \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0641\u0642\u0637 \u0628\u0647 \u0646\u0628\u0648\u062F \u062A\u0631\u0627\u0641\u06CC\u06A9 \u06CC\u0627 \u0627\u0646\u0642\u0636\u0627\u06CC \u0648\u0631\u0648\u062F\u06CC\u200C\u0647\u0627 \u0645\u0631\u0628\u0648\u0637 \u0628\u0627\u0634\u062F.","`show ipv6 route` \u0648 `show ipv6 routers` \u2192 RA \u0645\u06CC\u200C\u0631\u0633\u062F\u061F \u067E\u06CC\u0634\u0648\u0646\u062F \u0648 \u062F\u0631\u0648\u0627\u0632\u0647 \u062F\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061F","\u0628\u0631\u0627\u06CC \u0645\u0642\u0635\u062F link-local\u060C \u0631\u0627\u0628\u0637 \u062E\u0631\u0648\u062C\u06CC/zone \u0631\u0627 \u0628\u0627 \u0631\u0648\u0634 \u0645\u0646\u0627\u0633\u0628 \u0647\u0645\u0627\u0646 \u0633\u06CC\u0633\u062A\u0645 \u06CC\u0627 \u067E\u0644\u062A\u0641\u0631\u0645 \u0645\u0634\u062E\u0635 \u06A9\u0646\u061B \u0646\u062D\u0648 %interface \u062F\u0631 \u0647\u0645\u0647 IOS\u0647\u0627 \u06CC\u06A9\u0633\u0627\u0646 \u0646\u06CC\u0633\u062A.","\u0627\u06AF\u0631 RA \u0645\u06CC\u200C\u0631\u0633\u062F \u0648\u0644\u06CC \u0645\u06CC\u0632\u0628\u0627\u0646 \u0622\u062F\u0631\u0633 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F: \u067E\u0631\u0686\u0645 A \u062F\u0631 RA \u062E\u0627\u0645\u0648\u0634 \u0627\u0633\u062A \u06CC\u0627 DAD \u0622\u062F\u0631\u0633 \u0631\u0627 \u0631\u062F \u06A9\u0631\u062F\u0647 (\u062A\u06A9\u0631\u0627\u0631\u06CC).","ACL \u0648 \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 IPv6 \u0631\u0627 \u0628\u0627 \u0633\u06CC\u0627\u0633\u062A \u0648 \u062C\u0647\u062A \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. NDP \u0648 \u067E\u06CC\u0627\u0645 Packet Too Big \u0628\u0631\u0627\u06CC \u0639\u0645\u0644\u06A9\u0631\u062F \u0634\u0628\u06A9\u0647 \u0645\u0647\u0645\u200C\u0627\u0646\u062F\u061B \u0645\u062C\u0648\u0632 \u0646\u0648\u0639\u200C\u0647\u0627\u06CC \u0644\u0627\u0632\u0645 \u0631\u0627 \u0628\u0627 \u0637\u0631\u0627\u062D\u06CC \u0627\u0645\u0646\u06CC\u062A\u06CC \u062A\u0637\u0628\u06CC\u0642 \u0628\u062F\u0647."],scenarios:[{q:"\u0631\u0648\u062A\u0631 IPv6 \u062F\u0627\u0631\u062F\u060C \u0648\u0644\u06CC \u0645\u06CC\u0632\u0628\u0627\u0646\u200C\u0647\u0627 \u0622\u062F\u0631\u0633 \u062E\u0648\u062F\u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F.",a:"\u0627\u062D\u062A\u0645\u0627\u0644 \u0627\u0648\u0644 `ipv6 unicast-routing` \u0631\u0648\u06CC \u0631\u0648\u062A\u0631 \u0646\u06CC\u0633\u062A\u060C \u067E\u0633 RA \u0646\u0645\u06CC\u200C\u0631\u0648\u062F. \u062F\u0648\u0645: ACL \u06CC\u0627 \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 ICMPv6 \u0631\u0627 \u0628\u0633\u062A\u0647. \u0633\u0648\u0645: \u0631\u0648\u06CC \u0633\u0648\u06CC\u06CC\u0686/SVI\u060C IPv6 \u062E\u0627\u0645\u0648\u0634 \u0627\u0633\u062A (`ipv6 enable`)."},{q:"\u067E\u06CC\u0646\u06AF \u0628\u06CC\u0646 \u062F\u0648 \u0645\u06CC\u0632\u0628\u0627\u0646 IPv6 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0648\u0644\u06CC \u0628\u0647 WAN بانک IPv6 \u0646\u0647.",a:"\u067E\u