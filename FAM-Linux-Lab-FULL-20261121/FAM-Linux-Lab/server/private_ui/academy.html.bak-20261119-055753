28\u0627 SVI\u0647\u0627\u06CC\u0634 \u067E\u06CC\u0646\u06AF \u062C\u0648\u0627\u0628 \u0645\u06CC\u200C\u062F\u0647\u062F \u0627\u0645\u0627 \u0647\u06CC\u0686 \u0628\u0633\u062A\u0647\u200C\u0627\u06CC \u0631\u0627 \u0628\u06CC\u0646 \u062F\u0648 SVI \u0647\u062F\u0627\u06CC\u062A \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F!","\u062A\u0644\u0627\u0634 \u0628\u0631\u0627\u06CC \u0648\u0627\u0631\u062F \u06A9\u0631\u062F\u0646 \u062F\u0633\u062A\u0648\u0631 `ip address` \u0631\u0648\u06CC \u0632\u06CC\u0631-\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0631\u0648\u062A\u0631 **\u0642\u0628\u0644** \u0627\u0632 \u0646\u0648\u0634\u062A\u0646 `encapsulation dot1Q <vlan-id>`: \u0631\u0648\u062A\u0631 \u062E\u0637\u0627\u06CC `% Configuring IP routing on a LAN subinterface is only allowed if that subinterface is already configured as part of an IEEE 802.10, IEEE 802.1Q, or ISL vLAN` \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u0627\u0646\u062F.","\u0642\u0631\u0627\u0631 \u062F\u0627\u062F\u0646 \u067E\u0648\u0631\u062A \u0633\u0648\u0626\u06CC\u0686 \u0645\u062A\u0635\u0644 \u0628\u0647 \u0631\u0648\u062A\u0631 ROAS \u062F\u0631 \u062D\u0627\u0644\u062A `access` \u0628\u0647 \u062C\u0627\u06CC `trunk`: \u0631\u0648\u062A\u0631 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0628\u0631\u0686\u0633\u0628\u200C\u062F\u0627\u0631 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F \u0648 \u067E\u0648\u0631\u062A Access \u0633\u0648\u0626\u06CC\u0686 \u0647\u0645\u0647 \u0622\u0646\u200C\u0647\u0627 \u0631\u0627 \u062F\u0648\u0631 \u0645\u06CC\u200C\u0631\u06CC\u0632\u062F.","\u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0648\u0627\u0642\u0639\u06CC\u060C \u062F\u0627\u0634\u062A\u0646 \u062A\u0646\u0647\u0627 \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u06CC\u0627 \u06CC\u06A9 \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 Default Gateway \u0646\u0642\u0637\u0647 \u0634\u06A9\u0633\u062A \u0648\u0627\u062D\u062F (Single Point of Failure) \u0627\u0633\u062A\u061B \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646 \u062F\u0631 \u0639\u0645\u0644 \u0647\u0645\u06CC\u0634\u0647 \u062F\u0648 \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 \u0631\u0627 \u0628\u0627 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u0627\u0641\u0632\u0648\u0646\u06AF\u06CC \u062F\u0631\u0648\u0627\u0632\u0647 ([[fhrp|HSRP\u060C VRRP \u06CC\u0627 GLBP]]) \u0632\u0648\u062C \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645."],exam:["\u062F\u0631 ROAS\u060C \u0634\u0645\u0627\u0631\u0647 \u067E\u0633\u0648\u0646\u062F \u0632\u06CC\u0631-\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 (\u0645\u062B\u0644\u0627\u064B `.10` \u062F\u0631 `Gi0/0.10`) \u0635\u0631\u0641\u0627\u064B \u0642\u0631\u0627\u0631\u062F\u0627\u062F\u06CC \u0627\u0633\u062A\u060C \u0627\u0645\u0627 \u0639\u062F\u062F \u062C\u0644\u0648\u06CC \u062F\u0633\u062A\u0648\u0631 **`encapsulation dot1Q 10`** \u0647\u0645\u0627\u0646 \u0634\u0646\u0627\u0633\u0647 \u0648\u0627\u0642\u0639\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062F\u0631 \u062A\u06AF \u0641\u0631\u06CC\u0645 \u0686\u06A9 \u0648 \u062F\u0631\u062C \u0645\u06CC\u200C\u0634\u0648\u062F.","\u0627\u06AF\u0631 \u0632\u06CC\u0631-\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633\u06CC \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 Native VLAN \u062A\u0631\u0627\u0646\u06A9 \u0628\u0627\u0634\u062F\u060C \u0628\u0627\u06CC\u062F \u0639\u0628\u0627\u0631\u062A `encapsulation dot1Q <id> native` \u0631\u0648\u06CC \u0622\u0646 \u062A\u0646\u0638\u06CC\u0645 \u0634\u0648\u062F \u062A\u0627 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0622\u0646 \u0628\u062F\u0648\u0646 \u062A\u06AF \u0627\u0631\u0633\u0627\u0644 \u0634\u0648\u0646\u062F.","\u0631\u0648\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3\u060C \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 `Vlan X` \u0628\u0647\u200C\u0637\u0648\u0631 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 `administratively down` \u0627\u0633\u062A \u0648 \u062D\u062A\u0645\u0627\u064B \u0628\u0647 `no shutdown` \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F (\u0628\u0631\u062E\u0644\u0627\u0641 \u0632\u06CC\u0631-\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0631\u0648\u062A\u0631 \u06A9\u0647 \u0627\u0632 \u0648\u0636\u0639\u06CC\u062A \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0645\u0627\u062F\u0631 \u0627\u0631\u062B\u200C\u0628\u0631\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F).","\u0628\u0631\u0627\u06CC \u0627\u0639\u0645\u0627\u0644 \u0641\u06CC\u0644\u062A\u0631 \u0627\u0645\u0646\u06CC\u062A\u06CC \u0628\u06CC\u0646 \u062F\u0648 VLAN \u0631\u0648\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3\u060C \u0644\u06CC\u0633\u062A \u06A9\u0646\u062A\u0631\u0644 \u062F\u0633\u062A\u0631\u0633\u06CC ([[acl|Extended ACL]]) \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0645\u062C\u0627\u0632\u06CC `interface Vlan X` \u062F\u0631 \u062C\u0647\u062A `in` (\u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0648\u0631\u0648\u062F\u06CC \u0627\u0632 \u0633\u0645\u062A \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0647\u0645\u0627\u0646 VLAN) \u0628\u0633\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062F\u0631 \u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631\u0647\u0627\u06CC \u0645\u062F\u0631\u0646 \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 [[vxlan-evpn|VXLAN BGP EVPN]]\u060C \u0645\u0641\u0647\u0648\u0645 SVI \u0628\u0647 **Anycast Gateway** \u062A\u06A9\u0627\u0645\u0644 \u06CC\u0627\u0641\u062A\u0647 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0631 \u0622\u0646 \u06CC\u06A9 SVI \u0628\u0627 IP \u0648 MAC \u06CC\u06A9\u0633\u0627\u0646 \u0628\u0647 \u0637\u0648\u0631 \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0631\u0648\u06CC \u062F\u0647\u200C\u0647\u0627 \u0633\u0648\u0626\u06CC\u0686 Leaf \u0641\u0639\u0627\u0644 \u0627\u0633\u062A."],glossary:[[