627\u0628 \u0645\u06CC\u200C\u062F\u0647\u062F.",summary:["\u0634\u0628\u06A9\u0647 \u06CC\u0639\u0646\u06CC \u062F\u0648 \u06CC\u0627 \u0686\u0646\u062F \u062F\u0633\u062A\u06AF\u0627\u0647 \u06A9\u0647 \u0628\u0627 \u06CC\u06A9 \u0632\u0628\u0627\u0646 \u0645\u0634\u062A\u0631\u06A9 \u062D\u0631\u0641 \u0645\u06CC\u200C\u0632\u0646\u0646\u062F\u061B \u0632\u0628\u0627\u0646 \u0645\u0634\u062A\u0631\u06A9 \u0631\u0627 \xAB\u067E\u0631\u0648\u062A\u06A9\u0644\xBB \u0645\u06CC\u200C\u06AF\u0648\u06CC\u0646\u062F.","\u0647\u0631 \u0628\u0633\u062A\u0647 \u067E\u06CC\u0634 \u0627\u0632 \u0631\u0641\u062A\u0646\u060C \u0644\u0627\u06CC\u0647\u200C\u0628\u0647\u200C\u0644\u0627\u06CC\u0647 \u0628\u0633\u062A\u0647\u200C\u0628\u0646\u062F\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0645\u062B\u0644 \u0646\u0627\u0645\u0647\u200C\u0627\u06CC \u06A9\u0647 \u062F\u0631 \u067E\u0627\u06A9\u062A \u0648 \u0628\u0639\u062F \u062F\u0631 \u06A9\u06CC\u0633\u0647 \u067E\u0633\u062A \u0645\u06CC\u200C\u0631\u0648\u062F.","\u062F\u0631 \u0627\u062A\u0631\u0646\u062A \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0647\u0631 \u0631\u0627\u0628\u0637 \u06CC\u06A9 MAC \u0648 \u06CC\u06A9 \u06CC\u0627 \u0686\u0646\u062F IP \u062F\u0627\u0631\u062F\u061B MAC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u062C\u0627\u0632\u06CC \u06CC\u0627 \u062A\u063A\u06CC\u06CC\u0631\u067E\u0630\u06CC\u0631 \u0628\u0627\u0634\u062F \u0648 IP \u0628\u0627 \u062A\u0646\u0638\u06CC\u0645 \u06CC\u0627 DHCP \u062F\u0627\u062F\u0647 \u0634\u0648\u062F.","\u0633\u0648\u0626\u06CC\u0686 \u062F\u0627\u062E\u0644 \u06CC\u06A9 \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0644\u0627\u06CC\u0647 \u06F2)\u060C \u0631\u0648\u062A\u0631 \u0628\u06CC\u0646 \u0633\u0627\u062E\u062A\u0645\u0627\u0646\u200C\u0647\u0627 (\u0644\u0627\u06CC\u0647 \u06F3).","\u067E\u06CC\u0646\u06AF \u0627\u0648\u0644\u06CC\u0646 \u0627\u0628\u0632\u0627\u0631 \u0627\u0633\u062A\u060C \u0648\u0644\u06CC \xAB\u067E\u06CC\u0646\u06AF \u062C\u0648\u0627\u0628 \u062F\u0627\u062F\xBB \u06CC\u0639\u0646\u06CC \u0641\u0642\u0637 \u0645\u0633\u06CC\u0631 \u062A\u0627 \u0622\u0646 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0647\u0633\u062A\u060C \u0646\u0647 \u0627\u06CC\u0646\u200C\u06A9\u0647 \u0633\u0631\u0648\u06CC\u0633 \u0647\u0645 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F."],mental:"\u0634\u0628\u06A9\u0647 \u0645\u062B\u0644 \u0633\u06CC\u0633\u062A\u0645 \u067E\u0633\u062A \u0627\u0633\u062A. \u062A\u0648 \u0646\u0627\u0645\u0647 \u0631\u0627 \u062F\u0631 \u067E\u0627\u06A9\u062A \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u06CC (\u0628\u0633\u062A\u0647\u200C\u0628\u0646\u062F\u06CC)\u060C \u0622\u062F\u0631\u0633 \u0645\u06CC\u200C\u0646\u0648\u06CC\u0633\u06CC (IP)\u060C \u067E\u0633\u062A\u0686\u06CC \u0645\u062D\u0644\u0647 (\u0633\u0648\u0626\u06CC\u0686) \u0622\u0646 \u0631\u0627 \u0628\u0647 \u062F\u0641\u062A\u0631 \u0645\u0631\u06A9\u0632\u06CC (\u0631\u0648\u062A\u0631) \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u0622\u0646\u062C\u0627 \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0646\u0627\u0645\u0647 \u0627\u0632 \u06A9\u062F\u0627\u0645 \u0634\u0647\u0631 \u0628\u0631\u0648\u062F. \u0627\u06AF\u0631 \u0631\u0648\u06CC \u067E\u0627\u06A9\u062A \u0622\u062F\u0631\u0633 \u0646\u0628\u0627\u0634\u062F\u060C \u0647\u06CC\u0686 \u067E\u0633\u062A\u0686\u06CC \u0647\u0648\u0634\u0645\u0646\u062F\u06CC \u0647\u0645 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062D\u062F\u0633 \u0628\u0632\u0646\u062F.",blocks:[{h:"\u0634\u0628\u06A9\u0647 \u062F\u0642\u06CC\u0642\u0627\u064B \u0686\u06CC\u0633\u062A\u061F",p:["\u062F\u0648 \u06A9\u0627\u0645\u067E\u06CC\u0648\u062A\u0631 \u06A9\u0647 \u0628\u0627 \u06A9\u0627\u0628\u0644 \u0628\u0647 \u0647\u0645 \u0648\u0635\u0644 \u0634\u062F\u0647\u200C\u0627\u0646\u062F \u0648 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u062F\u0627\u062F\u0647 \u0631\u062F \u0648 \u0628\u062F\u0644 \u06A9\u0646\u0646\u062F\u060C \u06CC\u06A9 \u0634\u0628\u06A9\u0647\u200C\u0627\u0646\u062F. \u0628\u0631\u0627\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0633\u0647 \u0686\u06CC\u0632 \u0644\u0627\u0632\u0645 \u0627\u0633\u062A: \u06CC\u06A9 \u0631\u0627\u0647 (\u06A9\u0627\u0628\u0644 \u06CC\u0627 \u0648\u0627\u06CC\u200C\u0641\u0627\u06CC)\u060C \u06CC\u06A9 \u06A9\u0627\u0631\u062A \u0634\u0628\u06A9\u0647 \u062F\u0631 \u0647\u0631 \u0637\u0631\u0641\u060C \u0648 \u06CC\u06A9 \u0632\u0628\u0627\u0646 \u0645\u0634\u062A\u0631\u06A9.","\u0632\u0628\u0627\u0646 \u0645\u0634\u062A\u0631\u06A9 \u0631\u0627 \xAB\u067E\u0631\u0648\u062A\u06A9\u0644\xBB \u0645\u06CC\u200C\u06AF\u0648\u06CC\u0646\u062F. \u067E\u0631\u0648\u062A\u06A9\u0644 \u06CC\u0639\u0646\u06CC \u0642\u0631\u0627\u0631\u062F\u0627\u062F: \xAB\u0645\u0646 \u0627\u0648\u0644 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u0645 \u0633\u0644\u0627\u0645\u060C \u062A\u0648 \u062C\u0648\u0627\u0628 \u0645\u06CC\u200C\u062F\u0647\u06CC\u060C \u0628\u0639\u062F \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u06CC\u0645\xBB. \u0627\u06AF\u0631 \u06CC\u06A9 \u0637\u0631\u0641 \u0641\u0627\u0631\u0633\u06CC \u0648 \u0637\u0631\u0641 \u062F\u06CC\u06AF\u0631 \u0686\u06CC\u0646\u06CC \u062D\u0631\u0641 \u0628\u0632\u0646\u062F\u060C \u06A9\u0627\u0628\u0644 \u0633\u0627\u0644\u0645 \u0627\u0633\u062A \u0648\u0644\u06CC \u0627\u0631\u062A\u0628\u0627\u0637 \u0628\u0631\u0642\u0631\u0627\u0631 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u2014 \u0627\u06CC\u0646 \u062F\u0642\u06CC\u0642\u0627\u064B \u0647\u0645\u0627\u0646 \u0686\u06CC\u0632\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062F\u0631 \u0634\u0628\u06A9\u0647 \xAB\u067E\u0631\u0648\u062A\u06A9\u0644 \u0646\u0627\u0633\u0627\u0632\u06AF\u0627\u0631\xBB \u0646\u0627\u0645 \u062F\u0627\u0631\u062F.","\u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u06A9\u0648\u0686\u06A9 (\u062F\u0648 \u0644\u067E\u200C\u062A\u0627\u067E \u062F\u0631 \u06CC\u06A9 \u0627\u062A\u0627\u0642) \u0648 \u0628\u0632\u0631\u06AF (WAN بانک) \u0628\u0627 \u06CC\u06A9 \u0627\u06CC\u062F\u0647 \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F: \u0644\u0627\u06CC\u0647\u200C\u0628\u0646\u062F\u06CC. \u0647\u0631 \u0644\u0627\u06CC\u0647 \u0641\u0642\u0637 \u06A9\u0627\u0631 \u062E\u0648\u062F\u0634 \u0631\u0627 \u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u0648 \u0628\u0647 \u0628\u0642\u06CC\u0647 \u06A9\u0627\u0631 \u0646\u062F\u0627\u0631\u062F."]},{h:"\u0686\u0647\u0627\u0631 \u0644\u0627\u06CC\u0647\u060C \u0628\u0647 \u0632\u0628\u0627\u0646 \u0622\u062F\u0645\u06CC\u0632\u0627\u062F",p:["\u0644\u0627\u06CC\u0647 \u06F1 (\u0641\u06CC\u0632\u06CC\u06A9\u06CC): \u0633\u06CC\u0645\u060C \u06A9\u0627\u0628\u0644\u060C \u0646\u0648\u0631\u060C \u0627\u0645\u0648\u0627\u062C. \u0633\u0624\u0627\u0644 \u0627\u06CC\u0646 \u0644\u0627\u06CC\u0647: \xAB\u0627\u0635\u0644\u0627\u064B \u0686\u06CC\u0632\u06CC \u0628\u0647 \u0686\u06CC\u0632\u06CC \u0648\u0635\u0644 \u0627\u0633\u062A\u061F\xBB","\u0644\u0627\u06CC\u0647 \u06F2 (\u067E\u06CC\u0648\u0646\u062F \u062F\u0627\u062F\u0647): \u0641\u0631\u06CC\u0645 \u0648 \u0622\u062F\u0631\u0633 MAC. \u0633\u0624\u0627\u0644 \u0627\u06CC\u0646 \u0644\u0627\u06CC\u0647: \xAB\u0627\u06CC\u0646 \u0641\u0631\u06CC\u0645 \u0631\u0627 \u0628\u0647 \u06A9\u062F\u0627\u0645 \u06A9\u0627\u0631\u062A \u0634\u0628\u06A9\u0647 \u062F\u0631 \u0647\u0645\u06CC\u0646 \u0645\u062D\u0644\u0647 \u062A\u062D\u0648\u06CC\u0644 \u0628\u062F\u0647\u0645\u061F\xBB","\u0644\u0627\u06CC\u0647 \u06F3 (\u0634\u0628\u06A9\u0647): \u0628\u0633\u062A\u0647 \u0648 \u0622\u062F\u0631\u0633 IP. \u0633\u0624\u0627\u0644 \u0627\u06CC\u0646 \u0644\u0627\u06CC\u0647: \xAB\u0645\u0642\u0635\u062F \u06A9\u062F\u0627\u0645 \u0634\u0647\u0631 \u0627\u0633\u062A \u0648 \u0627\u0632 \u06A9\u062F\u0627\u0645 \u0631\u0627\u0647 \u0628\u0631\u0648\u0645\u061F\xBB","\u0644\u0627\u06CC\u0647 \u06F4 (\u0627\u0646\u062A\u0642\u0627\u0644): TCP \u0648 UDP \u0648 \u067E\u0648\u0631\u062A. \u0633\u0624\u0627\u0644 \u0627\u06CC\u0646 \u0644\u0627\u06CC\u0647: \xAB\u062F\u0627\u062F\u0647 \u0633\u0627\u0644\u0645 \u0648 \u0628\u0647 \u062A\u0631\u062A\u06CC\u0628 \u0628\u0631\u0633\u062F\u060C \u06CC\u0627 \u0633\u0631\u0639\u062A \u0645\u0647\u0645\u200C\u062A\u0631 \u0627\u0633\u062A\u061F\xBB","\u0628\u0627\u0644\u0627\u062A\u0631 \u0627\u0632 \u0627\u06CC\u0646\u200C\u0647\u0627 \u0644\u0627\u06CC\u0647 \u06A9\u0627\u0631\u0628\u0631\u062F \u0627\u0633\u062A: HTTP\u060C DNS\u060C SSH. \u06A9\u0633\u06CC \u06A9\u0647 \xABWAN بانک \u0642\u0637\u0639 \u0627\u0633\u062A\xBB \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F\u060C \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u06CC\u06A9\u06CC \u0627\u0632 \u0627\u06CC\u0646 \u0686\u0647\u0627\u0631 \u0644\u0627\u06CC\u0647 \u0631\u0627 \u0628\u0627 \u0647\u0645 \u0642\u0627\u0637\u06CC \u06A9\u0631\u062F\u0647 \u0627\u0633\u062A."],table:{head:["\u0644\u0627\u06CC\u0647","\u0648\u0627\u062D\u062F \u062F\u0627\u062F\u0647","\u0622\u062F\u0631\u0633","\u0627\u0628\u0632\u0627\u0631 \u0646\u0645\u0648\u0646\u0647","\u0633\u0624\u0627\u0644 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC"],rows:[["\u06F1 \u0641\u06CC\u0632\u06CC\u06A9\u06CC","\u0628\u06CC\u062A","\u2014","\u06A9\u0627\u0628\u0644\u060C SFP\u060C \u067E\u0648\u0631\u062A","\u0686\u0631\u0627\u063A \u0644\u06CC\u0646\u06A9 \u0631\u0648\u0634\u0646 \u0627\u0633\u062A\u061F"],["\u06F2 \u067E\u06CC\u0648\u0646\u062F \u062F\u0627\u062F\u0647","\u0641\u0631\u06CC\u0645","MAC","\u0633\u0648\u0626\u06CC\u0686","MAC \u0645\u0642\u0635\u062F \u0631\u0627 \u0645\u06CC\u200C\u0634\u0646\u0627\u0633\u062F\u061F"],["\u06F3 \u0634\u0628\u06A9\u0647","\u0628\u0633\u062A\u0647","IP","\u0631\u0648\u062A\u0631","\u0645\u0633\u06CC\u0631 \u0645\u0642\u0635\u062F \u0631\u0627 \u062F\u0627\u0631\u062F\u061F"],["\u06F4 \u0627\u0646\u062A\u0642\u0627\u0