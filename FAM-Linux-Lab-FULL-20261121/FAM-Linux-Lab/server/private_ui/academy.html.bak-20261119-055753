\u0647 \u0645\u062F\u06CC\u0631 \u06AF\u0631\u0648\u0647 \u062A\u0645\u0627\u0633 \u0631\u0627 \u0645\u0646\u062A\u0642\u0644 \u06A9\u0646\u062F.",pitfalls:["\u062A\u0646\u0638\u06CC\u0645 \u0646\u06A9\u0631\u062F\u0646 MTU/MSS \u0631\u0648\u06CC \u062A\u0648\u0646\u0644: \u0633\u0627\u06CC\u062A\u200C\u0647\u0627\u06CC HTTPS \u0628\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F.","\u0646\u0628\u0648\u062F \u0645\u0633\u06CC\u0631 \u0628\u0647 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC Spoke: NHRP \u062B\u0628\u062A \u0645\u06CC\u200C\u0634\u0648\u062F \u0648\u0644\u06CC \u062A\u0648\u0646\u0644 \u0628\u0631\u0642\u0631\u0627\u0631 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC \u0646\u0627\u062F\u0631\u0633\u062A \u062F\u0631 \u0641\u0627\u0632 \u06F2: Spoke\u0647\u0627 \u0645\u0633\u06CC\u0631 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0646\u0645\u06CC\u200C\u0633\u0627\u0632\u0646\u062F \u0648 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0627\u0632 \u0647\u0627\u0628 \u0645\u06CC\u200C\u0631\u0648\u062F."],exam:["GRE \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0634\u0645\u0627\u0631\u0647 \u06F4\u06F7 \u0627\u0633\u062A \u0648 multicast \u0631\u0627 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F.","NHRP \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0631\u0627 \u0628\u0647 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u0646\u06AF\u0627\u0634\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062E\u0648\u062F\u0634 \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0634\u0645\u0627\u0631\u0647 \u06F5\u06F4 \u0627\u0633\u062A.","DMVPN \u0641\u0627\u0632 \u06F3 \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u0637\u0631\u0627\u062D\u06CC \u0627\u0645\u0631\u0648\u0632 \u0627\u0633\u062A."],glossary:[["mGRE","\u062A\u0648\u0646\u0644 GRE \u0686\u0646\u062F\u0645\u0642\u0635\u062F\u0647."],["NHRP","\u067E\u0631\u0648\u062A\u06A9\u0644 \u0646\u06AF\u0627\u0634\u062A \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0628\u0647 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC."],["Spoke / Hub","\u0631\u0648\u062A\u0631 \u0634\u0639\u0628\u0647 \u0648 \u0631\u0648\u062A\u0631 \u0645\u0631\u06A9\u0632\u06CC."],["Phase 3","\u0645\u062F\u0644 DMVPN \u0628\u0627 \u0645\u0633\u06CC\u0631 \u0627\u0632 \u0647\u0627\u0628 \u0648 \u062A\u0648\u0646\u0644 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u06CC\u0646 \u0634\u0639\u0628."]]},ipsec:{prereq:["static-routing"],related:["dmvpn","sdwan","troubleshooting"],title:"IPsec \u0648 IKEv2 \u2014 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0648\u0627\u0642\u0639\u06CC \u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u0627\u0632 WAN بانک",tagline:"IPsec \u0633\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0637\u0631\u0641\u06CC\u0646\u060C \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u062F\u0627\u062F\u0647 \u0648 \u062A\u0636\u0645\u06CC\u0646 \u0639\u062F\u0645\u200C\u062A\u063A\u06CC\u06CC\u0631\u061B IKEv2 \u0641\u0642\u0637 \u0645\u0630\u0627\u06A9\u0631\u0647 \u06A9\u0644\u06CC\u062F\u0647\u0627\u0633\u062A.",minutes:16,goals:["\u062F\u0648 \u0641\u0627\u0632 IPsec \u0631\u0627 \u0627\u0632 \u0647\u0645 \u062A\u0641\u06A9\u06CC\u06A9 \u06A9\u0646\u06CC: IKE (\u06A9\u0646\u062A\u0631\u0644) \u0648 ESP (\u062F\u0627\u062F\u0647)","\u0628\u06AF\u0648\u06CC\u06CC ESP \u0648 AH \u0686\u0647 \u062A\u0641\u0627\u0648\u062A\u06CC \u062F\u0627\u0631\u0646\u062F \u0648 \u0686\u0631\u0627 AH \u06A9\u0645\u062A\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F","\u06CC\u06A9 \u062A\u0648\u0646\u0644 \u0633\u0627\u06CC\u062A\u200C\u0628\u0647\u200C\u0633\u0627\u06CC\u062A \u0631\u0627 \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0648 \u0628\u0627 show crypto ikev2 sa \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u06A9\u0646\u06CC"],sections:[{h:"\u0686\u0631\u0627 IPsec \u0628\u0647 IKE \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F\u061F",p:["\u0628\u0631\u0627\u06CC \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC\u060C \u062F\u0648 \u0637\u0631\u0641 \u0628\u0627\u06CC\u062F \u0631\u0648\u06CC \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645\u060C \u06A9\u0644\u06CC\u062F \u0648 \u0645\u062F\u062A \u0627\u0639\u062A\u0628\u0627\u0631 \u062A\u0648\u0627\u0641\u0642 \u06A9\u0646\u0646\u062F. \u0627\u0646\u062C\u0627\u0645 \u0627\u06CC\u0646 \u062A\u0648\u0627\u0641\u0642 \u062F\u0631 \u0645\u062A\u0646 \u0631\u0648\u0634\u0646 \u062E\u0637\u0631\u0646\u0627\u06A9 \u0627\u0633\u062A\u060C \u067E\u0633 \u06CC\u06A9 \u06A9\u0627\u0646\u0627\u0644 \u0627\u0645\u0646 \u06A9\u0646\u062A\u0631\u0644\u06CC \u0644\u0627\u0632\u0645 \u0627\u0633\u062A: IKE. IKEv2 \u062F\u0631 \u062F\u0648 \u0645\u0631\u062D\u0644\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F: IKE_SA_INIT (\u062A\u0628\u0627\u062F\u0644 \u067E\u06CC\u0634\u0646\u0647\u0627\u062F\u0647\u0627 \u0648 Diffie-Hellman) \u0648 IKE_AUTH (\u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0628\u0627 \u06AF\u0648\u0627\u0647\u06CC \u06CC\u0627 PSK \u0648 \u0633\u0627\u062E\u062A \u0627\u0648\u0644\u06CC\u0646 Child SA).","\u0628\u0639\u062F \u0627\u0632 \u0622\u0646\u060C \u062F\u0627\u062F\u0647 \u0628\u0627 ESP \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u0634\u0648\u062F. \u067E\u0633 \u06CC\u06A9 \u0642\u0627\u0639\u062F\u0647 \u0630\u0647\u0646\u06CC: \u0627\u06AF\u0631 \u062A\u0648\u0646\u0644 \u0628\u0627\u0644\u0627 \u0646\u0645\u06CC\u200C\u0622\u06CC\u062F\u060C \u0627\u0648\u0644 IKE \u0631\u0627 \u0686\u06A9 \u06A9\u0646 (\u0646\u0647 ESP \u0631\u0627). \u062F\u0633\u062A\u0648\u0631 show crypto ikev2 sa \u0648\u0636\u0639\u06CC\u062A \u0648 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645\u200C\u0647\u0627 \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F."]},{h:"ESP \u06CC\u0627 AH\u061F",p:["ESP \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC \u0648 \u062A\u0645\u0627\u0645\u06CC\u062A/\u0627\u062D\u0631\u0627\u0632 \u0627\u0635\u0627\u0644\u062A \u0631\u0627 \u0628\u0627 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645 \u0648 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0645\u0646\u0627\u0633\u0628 \u0641\u0631\u0627\u0647\u0645 \u06A9\u0646\u062F\u061B \u0647\u0631 \u0642\u0627\u0628\u0644\u06CC\u062A \u0631\u0627 \u0646\u0628\u0627\u06CC\u062F \u0628\u062F\u0648\u0646 \u0628\u0631\u0631\u0633\u06CC \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0645\u0641\u0631\u0648\u0636 \u06AF\u0631\u0641\u062A. AH \u062A\u0645\u0627\u0645\u06CC\u062A \u0648 \u0627\u062D\u0631\u0627\u0632 \u0627\u0635\u0627\u0644\u062A \u0645\u06CC\u200C\u062F\u0647\u062F \u0627\u0645\u0627 \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC \u0646\u0645\u06CC\u200C\u062F\u0647\u062F\u061B AH \u0628\u062E\u0634\u200C\u0647\u0627\u06CC \u062A\u063A\u06CC\u06CC\u0631\u0646\u0627\u067E\u0630\u06CC\u0631 \u0633\u0631\u0622\u06CC\u0646\u062F IP \u0631\u0627 \u0646\u06CC\u0632 \u067E\u0648\u0634\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F\u060C \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646 \u062A\u063A\u06CC\u06CC\u0631 \u0622\u062F\u0631\u0633 \u062A\u0648\u0633\u0637 NAT \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0628\u0631\u0631\u0633\u06CC \u0631\u0627 \u0646\u0627\u0645\u0648\u0641\u0642 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 AH \u06A9\u0645 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0633\u062A.","\u062D\u0627\u0644\u062A\u200C\u0647\u0627\u06CC \u0627\u0646\u062A\u0642\u0627\u0644 (transport) \u0648 \u062A\u0648\u0646\u0644 (tunnel) \u0647\u0645 \u0645\u0647\u0645\u200C\u0627\u0646\u062F: \u062F\u0631 \u062A\u0648\u0646\u0644\u060C \u06A9\u0644 \u0628\u0633\u062A\u0647 \u0627\u0635\u0644\u06CC \u062F\u0627\u062E\u0644 \u06CC\u06A9 \u0628\u0633\u062A\u0647 \u062C\u062F\u06CC\u062F \u067E\u06CC\u0686\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F (\u0628\u0631\u0627\u06CC \u0633\u0627\u06CC\u062A\u200C\u0628\u0647\u200C\u0633\u0627\u06CC\u062A)\u060C \u062F\u0631 \u0627\u0646\u062A\u0642\u0627\u0644 \u0641\u0642\u0637 payload \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u0634\u0648\u062F (\u0628\u0631\u0627\u06CC \u0627\u0631\u062A\u0628\u0627\u0637 \u0645\u06CC\u0632\u0628\u0627\u0646\u200C\u0628\u0647\u200C\u0645\u06CC\u0632\u0628\u0627\u0646)."],list:["IKEv1: \u062F\u0648 \u0641\u0627\u0632\u060C \u067E\u06CC\u0686\u06CC\u062F\u0647\u200C\u062A\u0631\u060C \u0642\u062F\u06CC\u0645\u06CC","IKEv2: \u0633\u0631\u06CC\u0639\u200C\u062A\u0631\u060C \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0628\u0647\u062A\u0631 \u0627\u0632 \u0645\u0648\u0628\u0627\u06CC\u0644 \u0648 MOBIKE","ESP: \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC + \u0627\u062D\u0631\u0627\u0632 \xB7 AH: \u0641\u0642\u0637 \u0627\u062D\u0631\u0627\u0632","NAT-T: UDP 4500 \u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u0627\u0632 NAT"]},{h:"\u0645\u062F\u0644\u200C\u0647\u0627\u06CC \u0627\u0633\u062A\u0642\u0631\u0627\u0631",p:["\u0633\u0627\u06CC\u062A\u200C\u0628\u0647\u200C\u0633\u0627\u06CC\u062A (LAN-to-LAN): \u062F\u0648 \u0631\u0648\u062A\u0631 \u0628\u0627 \u0644\u06CC\u0633\u062A \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u062F\u0627\u062E\u0644\u06CC\u060C \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0628\u06CC\u0646 \u062F\u0648 \u0634\u0628\u06A9\u0647 \u0627\u0632 \u062A\u0648\u0646\u0644 \u0645\u06CC\u200C\u0631\u0648\u0646\u062F. \u06AF\u0632\u06CC\u0646\u0647 \u062F\u06CC\u06AF\u0631\u060C \u062A\u0648\u0646\u0644 \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 (VTI) \u0627\u0633\u062A \u06A9\u0647 \u0631\u0641\u062A\u0627\u0631 \u0633\u0627\u062F\u0647\u200C\u062A\u0631\u06CC \u062F\u0627\u0631\u062F \u0648 \u0628\u0631\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u062F\u06CC\u0646\u0627\u0645\u06CC\u06A9 \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u0628\u0647\u062A\u0631 \u0627\u0633\u062A.","\u062F\u0633\u062A\u0631\u0633\u06CC \u0631\u0627\u0647 \u062F\u0648\u0631 (Remote Access): \u06A9\u0627\u0631\u0628\u0631 \u0628\u0627 AnyConnect/Client \u0627\u0632 \u0647\u0631 \u062C\u0627 \u0648\u0635\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0648 \u0628\u0631\u0627\u06CC \u0634\u0639\u0628\u0647\u200C\u0647\u0627\u06CC \u0632\u06CC\u0627\u062F\u060C IPsec over DMVPN \u06CC\u0627 SD-WAN \u06A9\u0627\u0645\u0644\u0627\u064B \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0631\u0627 \u062E\u0648\u062F\u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F."]},{h:"\u0645\u0634\u06A9\u0644\u0627\u062A \u0631\u0627\u06CC\u062C",p:["\u0646\u0634\u0627\u0646\u0647\u200C\u0647\u0627\u06CC \u0645\u0634\u06A9\u0644: \u062A\u0648\u0646\u0644 Phase 1 \u0628\u0627\u0644\u0627 \u0645\u06CC\u200C\u0622\u06CC\u062F \u0648\u0644\u06CC Phase 2 \u0646\u0647 (\u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0639\u062F\u0645 \u062A\u0637\u0627\u0628\u0642 ACL/\u062A\u0631\u0627\u0641\u06CC\u06A9 \u062C\u0627\u0644\u0628 \u06CC\u0627 proxy-identity)\u061B \u062A\u0648\u0646\u0644 \u0628\u0627\u0644\u0627 \u0627\u0633\u062A \u0648\u0644\u06CC \u067E\u06CC\u0646\u06AF \u0631\u062F \u0646\u0645\u06CC\u200C\u0634\u0648\u062F (\u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u06CC\u0627 ACL \u06CC\u0627 NAT)\u061B \u0628\u0639\u0636\u06CC \u0633\u0627\u06CC\u062A\u200C\u0647\u0627 \u0628\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F (MTU/MSS).","\u0628\u0631\u0627\u06CC \u062A\u0633\u062A: show crypto ikev2 sa\u060C show crypto ipsec sa\u060C \u0648 debug crypto ikev2 packet. \u0648 \u0647\u0645\u06CC\u0634\u0647 \u06CC\u0627\u062F\u062A \u0628\u0627\u0634\u062F \u06A9\u0647 \u0627\u06AF\u0631 NAT \u0631\u0648\u06CC \u0645\u0633\u06CC\u0631 \u0628\u0627\u0634\u062F\u060C \u0628\u0627\u06CC\u062F NAT-T \u0648 \u0634\u0646\u0627\u0633\u0647\u200C\u0647\u0627\u06CC \u062F\u0631\u0633\u062A \u062A\u0646\u0638\u06CC\u0645 \u0634\u0648\u062F\u060C \u0648\u06AF\u0631\u0646\u0647 \u062A\u0648\u0646\u0644 \u0628\u0647\u200C\u0638\u0627\u0647\u0631 \u0628\u0627\u0644\u0627 \u0646\u0645\u06CC\u200C\u0622\u06CC\u062F."]}],analogy:"IPsec \u0645\u062B\u0644 \u06CC\u06A9 \u067E\u06CC\u06A9 \u0627\u0645\u0646 \u0627\u0633\u062A: \u0627\u0648\u0644 \u067E\u06CC\u06A9 \u0648 \u0646\u06AF\u0647\u0628\u0627\u0646 \u0628\u0627 \u06CC\u06A9 \u062F\u0633\u062A\u200C\u062F\u0627\u062F\u0646 \u0631\u0645\u0632\u06CC \u0647\u0648\u06CC\u062A \u0647\u0645 \u0631\u0627 \u062A\u0623\u06CC\u06CC\u062F \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F (IKE)\u060C \u0628\u0639\u062F \u0628\u0633\u062A\u0647\u200C\u0647\u0627 \u062F\u0631 \u062C\u0639\u0628\u0647 \u0642\u0641\u0644\u200C\u062F\u0627\u0631 \u0628\u0627 \u0645\u0647\u0631 \u0648 \u0645\u0648\u0645 \u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F (ESP). \u0627\u06AF\u0631 \u0645\u0647\u0631 \u0634\u06A9\u0633\u062A\u0647 \u0634\u0648\u062F\u060C \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0645\u06CC\u200C\u0641\u0647\u0645\u062F.",pitfalls:["\u0639\u062F\u0645 \u062A\u0637\u0627\u0628\u0642 \u067E\u06CC\u0634\u0646\u0647\u0627\u062F\u0647\u0627 (encryption/hash/DH): IKE \u0627\u0635\u0644\u0627\u064B \u0628\u0627\u0644\u0627 \u0646\u0645\u06CC\u200C\u0622\u06CC\u062F.","ACL \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062C\u0627\u0644\u0628 \u0646\u0627\u0645\u062A\u0642\u0627\u0631\u0646: \u06CC\u06A9 \u0637\u0631\u0641 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F \u0648 \u0637\u0631\u0641 \u062F\u06CC\u06AF\u0631 \u0646\u0647.","\u0641\u0631\u0627\u0645\u0648\u0634\u200C\u06A9\u0631\u062F\u0646 MSS clamping: \u0633\u0627\u06CC\u062A\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0628\u0633\u062A\u0647 \u0628\u0632\u0631\u06AF \u062F\u0627\u0631\u0646\u062F \u0628\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F."],exam:["IKE \u0631\u0648\u06CC UDP 500\u060C NAT-T \u0631\u0648\u06CC UDP 4500\u060C ESP \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0634\u0645\u0627\u0631\u0647 \u06F5\u06F0\u060C AH \u0634\u0645\u0627\u0631\u0647 \u06F5\u06F1.","AH \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F\u061B ESP \u0647\u0645 \u0631\u0645\u0632 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0647\u0645 \u0627\u062D\u0631\u0627\u0632.","IKEv2 \u0628\u0627 IKE_SA_INIT \u0648 IKE_AUTH \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F."],glossary:[["SA","\u0627\u062A\u062D\u0627\u062F \u0627\u0645\u0646\u06CC\u062A\u06CC\u061B \u067E\u0627\u0631\u0627\u0645\u062A\u0631\u0647\u0627\u06CC \u062A\u0648\u0627\u0641\u0642\u200C\u0634\u062F\u0647 \u06CC\u06A9 \u062C\u0647\u062A."],["PSK","\u06A9\u0644\u06CC\u062F \u0645\u0634\u062A\u0631\u06A9 \u0627\u0632 \u067E\u06CC\u0634 \u062A\u0639\u06CC\u06CC\u0646\u200C\u0634\u062F\u0647 \u0628\u0631\u0627\u06CC \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A."],["VTI","\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062A\u0648\u0646\u0644 \u0645\u062C\u0627\u0632\u06CC \u0628\u0631\u0627\u06CC IPsec."],["MSS clamping","\u06A9\u0627\u0647\u0634 \u0627\u0646\u062F\u0627\u0632\u0647 \u0628\u0633\u062A\u0647 TCP \u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u0627\u0632 \u062A\u0648\u0646\u0644."]]},wlan:{prereq:["vlan-trunk"],related:["wifi6e","qos","sda"],title:"WLAN \u0648 WPA3 \u2014 \u0627\u0632 CAPWAP \u062A\u0627 \u0627\u062A\u0635\u0627\u0644 \u0627\u0645\u0646",tagline:"\u062F\u0631 \u0637\u0631\u0627\u062D\u06CC \u0645\u062A\u0645\u0631\u06A9\u0632 \u0633\u0627\u0632\u0645\u0627\u0646\u06CC\u060C AP \u0648 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0648 \u0633\u0631\u0648\u06CC\u0633 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0646\u0642\u0634 \u062F\u0627\u0631\u0646\u062F\u061B \u0645\u0639\u0645\u0627\u0631\u06CC \u0645\u0633\u062A\u0642\u0644 \u06CC\u0627 \u062D\u0627\u0644\u062A\u200C\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0647\u0645 \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u0646\u062F.",minutes:16,goals:["\u0628\u06AF\u0648\u06CC\u06CC CAPWAP \u0686\u06CC\u0633\u062A \u0648 \u0686\u0631\u0627 AP \u0628\u062F\u0648\u0646 \u06A9\u0646\u062A\u0631\u0644\u0631 \u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F","\u0645\u0633\u06CC\u0631 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A 802.1X \u0628\u0627 RADIUS \u0631\u0627 \u0642\u062F\u0645\u200C\u0628\u0647\u200C\u0642\u062F\u0645 \u062F\u0646\u0628\u0627\u0644 \u06A9\u0646\u06CC","\u062A\u0641\u0627\u0648\u062A WPA2\u060C WPA3-Personal \u0648 WPA3-Enterprise \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC"],sections:[{h:"\u0645\u0639\u0645\u0627\u0631\u06CC: AP\u060C WLC\u060C ISE",p:["\u062F\u0631 \u0648\u0627\u06CC\u200C\u0641\u0627\u06CC \u0633\u0627\u0632\u0645\u0627\u0646\u06CC\u060C AP \u0641\u0642\u0637 \u0631\u0627\u062F\u06CC\u0648 \u0627\u0633\u062A. \u06A9\u0646\u062A\u0631\u0644\u0631 (WLC) \u062A\u0646\u0638\u06CC\u0645\u0627\u062A\u060C \u0631\u0648\u0645\u06CC\u0646\u06AF \u0648 \u0627\u0645\u0646\u06CC\u062A \u0631\u0627 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0628\u06CC\u0646 AP \u0648 WLC \u06CC\u06A9 \u062A\u0648\u0646\u0644 \u06A9\u0646\u062A\u0631\u0644\u06CC \u0628\u0647 \u0646\u0627\u0645 CAPWAP \u0628\u0631\u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F (\u06A9\u0646\u062A\u0631\u0644 \u0631\u0648\u06CC UDP 5246\u060C \u062F\u0627\u062F\u0647 \u0631\u0648\u06CC 5247). \u0627\u06AF\u0631 AP \u0646\u062A\u0648\u0627\u0646\u062F \u0628\u0647 WLC \u0628\u0631\u0633\u062F\u060C \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0633\u0631\u0648\u06CC\u0633 \u0646\u0645\u06CC\u200C\u062F\u0647\u062F (\u0645\u06AF\u0631 \u062F\u0631 \u062D\u0627\u0644\u062A FlexConnect \u06A9\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0645\u062D\u0644\u06CC \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F).","\u06A9\u0644\u0627\u06CC\u0646\u062A SSID \u0631\u0627 \u0645\u06CC\u200C\u0628\u06CC\u0646\u062F\u060C \u0628\u0647 AP \u0648\u0635\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u0639\u062F \u0646\u0648\u0628\u062A \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0627\u0633\u062A. \u062F\u0631 \u0634\u0628\u06A9\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06CC\u060C \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0628\u0627 802.1X \u0648 RADIUS (\u0627\u06CC\u0646\u062C\u0627 ISE) \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u06A9\u0644\u0627\u06CC\u0646\u062A \u0648 \u0633\u0631\u0648\u0631 \u0628\u0627 EAP \u06AF\u0641\u062A\u06AF\u0648 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u0648 AP \u0641\u0642\u0637 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627 \u0631\u0627 \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F."],list:["CAPWAP: \u062A\u0648\u0646\u0644 \u0628\u06CC\u0646 AP \u0648 WLC (\u06A9\u0646\u062A\u0631\u0644 5246\u060C \u062F\u0627\u062F\u0647 5247)","802.1X: \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u067E\u0648\u0631\u062A\u200C\u0645\u062D\u0648\u0631 \u0628\u0627 EAP","RADIUS: \u067E\u0631\u0648\u062A\u06A9\u0644 \u0628\u06CC\u0646 WLC \u0648 ISE (UDP 1812/1813)","FlexConnect: AP \u0645\u062D\u0644\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F"]},{h:"WPA2 \u0648 WPA3",p:["\u062F\u0631 WPA2-Personal \u06A9\u0644\u06CC\u062F \u0628\u0627 PSK \u0648 \u0686\u0647\u0627\u0631\u0645\u0631\u062D\u0644\u0647\u200C\u0627\u06CC (4-way handshake) \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0622\u0633\u06CC\u0628\u200C\u067E\u0630\u06CC\u0631\u06CC\u200C\u0627\u0634 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0627\u06AF\u0631 \u06A9\u0633\u06CC handshake \u0631\u0627 \u0636\u0628\u0637 \u06A9\u0646\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0631\u0645\u0632 \u0631\u0627 \u0622\u0641\u0644\u0627\u06CC\u0646 \u062D\u062F\u0633 \u0628\u0632\u0646\u062F. WPA3-Personal \u0627\u06CC\u0646 \u0631\u0627 \u0628\u0627 SAE \u062D\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u062A\u0628\u0627\u062F\u0644 \u06A9\u0644\u06CC\u062F \u0628\u0647\u200C\u0634\u06A9\u0644\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062D\u0645\u0644\u0647 \u0622\u0641\u0644\u0627\u06CC\u0646 \u0645\u0645\u06A9\u0646 \u0646\u06CC\u0633\u062A.","\u062F\u0631 \u0633\u0627\u0632\u0645\u0627\u0646\u060C \u062D\u0627\u0644\u062A Enterprise \u0628\u0627 802.1X \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F: \u0647\u0631 \u06A9\u0627\u0631\u0628\u0631 \u0627\u0639\u062A\u0628\u0627\u0631 \u062E\u0648\u062F\u0634 \u0631\u0627 \u062F\u0627\u0631\u062F (\u0646\u0647 \u06CC\u06A9 \u0631\u0645\u0632 \u0645\u0634\u062A\u0631\u06A9). WPA3-Enterprise 192-bit \u0633\u062E\u062A\u200C\u06AF\u06CC\u0631\u0627\u0646\u0647\u200C\u062A\u0631\u06CC\u0646 \u062D\u0627\u0644\u062A \u0627\u0633\u062A: \u0641\u0642\u0637 EAP-TLS \u0648 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645\u200C\u0647\u0627\u06CC Suite-B. \u0627\u0646\u062A\u062E\u0627\u0628 \u062F\u0631\u0633\u062A \u0647\u0645\u06CC\u0634\u0647 \u0628\u0627 \u062A\u0648\u062C\u0647 \u0628\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627\u06CC \u0645\u0648\u062C\u0648\u062F \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u0627\u06AF\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0642\u062F\u06CC\u0645\u06CC \u062F\u0627\u0631\u06CC\u060C \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0644\u0627\u0632\u0645 \u0628\u0627\u0634\u062F SSID \u062C\u062F\u0627 \u0628\u0633\u0627\u0632\u06CC."],callout:{title:"PMF \u0631\u0627 \u062C\u062F\u06CC \u0628\u06AF\u06CC\u0631",text:"PMF \u06CC\u0627 802.11w \u0627\u0632 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062C\u0644\u0648\u06CC \u062D\u0645\u0644\u0647 Deauth \u062C\u0639\u0644\u06CC \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u062F\u0631 WPA3 \u0627\u0644\u0632\u0627\u0645\u06CC \u0648 \u062F\u0631 WPA2 \u0627\u062E\u062A\u06CC\u0627\u0631\u06CC \u0627\u0633\u062A."}},{h:"\u0631\u0648\u0645\u06CC\u0646\u06AF",p:["\u0648\u0642\u062A\u06CC \u06A9\u0627\u0631\u0628\u0631 \u062D\u0631\u06A9\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C AP \u0639\u0648\u0636 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062F\u0631 \u0631\u0648\u0645\u06CC\u0646\u06AF \u0633\u0627\u062F\u0647\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u06A9\u0627\u0645\u0644 \u0631\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u0628\u0631\u0627\u06CC \u0686\u0646\u062F \u062B\u0627\u0646\u06CC\u0647 \u0642\u0637\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0628\u0631\u0627\u06CC \u062A\u0645\u0627\u0633 \u0635\u0648\u062A\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0641\u06CC \u0627\u0633\u062A \u062A\u0627 \u062A\u0645\u0627\u0633 \u0628\u06CC\u0641\u062A\u062F. 802.11r \u06A9\u0644\u06CC\u062F \u0631\u0627 \u0627\u0632 \u0642\u0628\u0644 \u062F\u0631 AP \u062C\u062F\u06CC\u062F \u0622\u0645\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F (Fast Transition) \u0648 \u0642\u0637\u0639\u06CC \u0631\u0627 \u0628\u0647 \u0686\u0646\u062F \u062F\u0647 \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647 \u0645\u06CC\u200C\u0631\u0633\u0627\u0646\u062F.","802.11k \u0628\u0647 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0641\u0647\u0631\u0633\u062A \u0647\u0645\u0633\u0627\u06CC\u0647\u200C\u0647\u0627 \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F \u062A\u0627 \u0627\u0633\u06A9\u0646 \u06A9\u0648\u0631\u06A9\u0648\u0631\u0627\u0646\u0647 \u0646\u06A9\u0646\u062F \u0648 802.11v \u067E\u06CC\u0634\u0646\u0647\u0627\u062F \u0645\u0647\u0627\u062C\u0631\u062A \u0645\u06CC\u200C\u062F\u0647\u062F. \u0627\u06CC\u0646 \u0633\u0647 \u0628\u0627 \u0647\u0645\u060C \u062A\u062C\u0631\u0628\u0647 \u0631\u0648\u0645\u06CC\u0646\u06AF \u0631\u0627 \u0631\u0648\u0627\u0646 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F."]},{h:"\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0648\u0627\u06CC\u200C\u0641\u0627\u06CC",p:["\u0627\u06AF\u0631 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0648\u0635\u0644 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u062A\u0631\u062A\u06CC\u0628 \u0628\u0631\u0631\u0633\u06CC: \u0622\u06CC\u0627 SSID \u067E\u062E\u0634 \u0645\u06CC\u200C\u0634\u0648\u062F\u061F \u0622\u06CC\u0627 AP \u062F\u0631 WLC \u062B\u0628\u062A \u0627\u0633\u062A (CAPWAP)\u061F \u0622\u06CC\u0627 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0645\u06CC\u200C\u0634\u0648\u062F (\u0644\u0627\u06AF ISE)\u061F \u0622\u06CC\u0627 \u0628\u0639\u062F \u0627\u0632 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A\u060C DHCP \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F\u061F \u062A\u0641\u06A9\u06CC\u06A9 \u0627\u06CC\u0646 \u0686\u0647\u0627\u0631 \u0645\u0631\u062D\u0644\u0647\u060C \u06F9\u06F0\u066A \u06A9\u0627\u0631 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0627\u0633\u062A. \u062F\u0633\u062A\u0648\u0631\u0647\u0627\u06CC WLC: show ap summary\u060C show wlan summary\u060C show client detail <mac>."]}],analogy:"\u0648\u0627\u06CC\u200C\u0641\u0627\u06CC \u0633\u0627\u0632\u0645\u0627\u0646\u06CC \u0645\u062B\u0644 \u0648\u0631\u0648\u062F \u0628\u0647 \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u0627\u062F\u0627\u0631\u06CC \u0627\u0633\u062A: AP \u062F\u0631 \u0648\u0631\u0648\u062F\u06CC (\u06A9\u0627\u0631\u062A\u200C\u062E\u0648\u0627\u0646) \u0627\u0633\u062A\u060C WLC \u0646\u06AF\u0647\u0628\u0627\u0646\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u0647\u0631 \u067E\u0631\u0633\u0646\u0644 \u0628\u0647 \u06A9\u062F\u0627\u0645 \u0637\u0628\u0642\u0647 \u0628\u0631\u0648\u062F \u0648 ISE \u067E\u0631\u0648\u0646\u062F\u0647 \u067E\u0631\u0633\u0646\u0644\u06CC \u0648 \u0633\u0637\u062D \u062F\u0633\u062A\u0631\u0633\u06CC \u0631\u0627 \u062F\u0627\u0631\u062F.",pitfalls:["\u062B\u0628\u062A\u200C\u0646\u0634\u062F\u0646 AP \u062F\u0631 WLC (\u0645\u0634\u06A9\u0644 CAPWAP \u06CC\u0627 \u06AF\u0648\u0627\u0647\u06CC): SSID \u062F\u0631 \u0622\u0646 \u0646\u0627\u062D\u06CC\u0647 \u067E\u062E\u0634 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u0646\u0628\u0648\u062F RADIUS \u062F\u0631 \u062F\u0633\u062A\u0631\u0633: \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u062D\u0631\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0627\u062A\u0635\u0627\u0644 \u0628\u06CC\u200C\u067E\u0627\u06CC\u0627\u0646 \u062A\u0644\u0627\u0634 \u0645\u06CC\u200C\u06A9\u0646\u062F.","SSID \u0628\u0627 \u0627\u0645\u0646\u06CC\u062A \u0646\u0627\u0633\u0627\u0632\u06AF\u0627\u0631 \u0628\u0627 \u062F\u0633\u062A\u06AF\u0627\u0647: \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0641\u0642\u0637 \xAB\u0648\u0635\u0644 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F\xBB \u0628\u062F\u0648\u0646 \u067E\u06CC\u0627\u0645 \u062E\u0637\u0627\u06CC \u0631\u0648\u0634\u0646."],exam:["CAPWAP \u06A9\u0646\u062A\u0631\u0644 UDP 5246 \u0648 \u062F\u0627\u062F\u0647 UDP 5247 \u062F\u0627\u0631\u062F.","802.1X \u0628\u0627 EAP \u0648 RADIUS \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B RADIUS \u0631\u0648\u06CC 1812/1813 \u0627\u0633\u062A.","WPA3-Personal \u0627\u0632 SAE \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 PMF \u062F\u0631 \u0622\u0646 \u0627\u0644\u0632\u0627\u0645\u06CC \u0627\u0633\u062A."],glossary:[["WLC","\u06A9\u0646\u062A\u0631\u0644\u0631 \u0648\u0627\u06CC\u0631\u0644\u0633."],["CAPWAP","\u067E\u0631\u0648\u062A\u06A9\u0644 \u062A\u0648\u0646\u0644 \u0628\u06CC\u0646 AP \u0648 \u06A9\u0646\u062A\u0631\u0644\u0631."],["SSID","\u0646\u0627\u0645 \u0634\u0628\u06A9\u0647 \u0628\u06CC\u200C\u0633\u06CC\u0645."],["EAP","\u0686\u0627\u0631\u0686\u0648\u0628 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u062F\u0631 802.1X."]]},automation:{prereq:[],related:["netconf-yang","catalyst-center","sdwan"],title:"\u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0634\u0628\u06A9\u0647 \u2014 \u0627\u0632 CLI \u062F\u0633\u062A\u06CC \u0628\u0647 API \u0648 \u0642\u0627\u0644\u0628",tagline:"\u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u06CC\u0639\u0646\u06CC \u0647\u0645\u0627\u0646 \u06A9\u0627\u0631\u060C \u0648\u0644\u06CC \u062A\u06A9\u0631\u0627\u0631\u067E\u0630\u06CC\u0631\u060C \u0642\u0627\u0628\u0644 \u0628\u0627\u0632\u0628\u06CC\u0646\u06CC \u0648 \u0628\u062F\u0648\u0646 \u062A\u0627\u06CC\u067E \u0627\u0634\u062A\u0628\u0627\u0647.",minutes:13,goals:["\u062A\u0641\u0627\u0648\u062A \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC CLI \u0628\u0627 \u0645\u062F\u0644\u200C\u0645\u062D\u0648\u0631 (NETCONF/YANG) \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC","\u06CC\u06A9 \u062A\u0645\u0627\u0633 \u0633\u0627\u062F\u0647 \u0628\u0627 RESTCONF \u06CC\u0627 API \u0627\u0646\u062C\u0627\u0645 \u0628\u062F\u0647\u06CC \u0648 \u067E\u0627\u0633\u062E \u0631\u0627 \u0628\u062E\u0648\u0627\u0646\u06CC","\u0628\u062F\u0627\u0646\u06CC Ansible\u060C Terraform \u0648 \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644\u0631 \u06A9\u062C\u0627 \u0628\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u0622\u06CC\u0646\u062F"],sections:[{h:"\u0686\u0631\u0627 CLI \u0628\u0631\u0627\u06CC \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0645\u0646\u0627\u0633\u0628 \u0646\u06CC\u0633\u062A\u061F",p:["CLI \u0628\u0631\u0627\u06CC \u0627\u0646\u0633\u0627\u0646 \u0637\u0631\u0627\u062D\u06CC \u0634\u062F\u0647\u060C \u0646\u0647 \u0628\u0631\u0646\u0627\u0645\u0647. \u062E\u0631\u0648\u062C\u06CC \u0622\u0646 \u0645\u062A\u0646\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0628\u0627 \u0647\u0631 \u0646\u0633\u062E\u0647 IOS \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0639\u0648\u0636 \u0634\u0648\u062F\u061B \u0647\u06CC\u0686 \u0633\u0627\u062E\u062A\u0627\u0631 \u0645\u0634\u062E\u0635\u06CC \u0646\u062F\u0627\u0631\u062F \u0648 \u0641\u0647\u0645\u06CC\u062F\u0646 \xAB\u0622\u06CC\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u0627\u0639\u0645\u0627\u0644 \u0634\u062F\u061F\xBB \u0633\u062E\u062A \u0627\u0633\u062A. \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0645\u062F\u0631\u0646 \u0631\u0648\u06CC \u0645\u062F\u0644 \u062F\u0627\u062F\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0633\u0627\u062E\u062A\u0627\u0631 \u062F\u0631\u062E\u062A\u06CC YANG \u06A9\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0647\u0631 \u062A\u0646\u0638\u06CC\u0645 \u06A9\u062C\u0627\u0633\u062A \u0648 \u0686\u0647 \u0646\u0648\u0639\u06CC \u062F\u0627\u0631\u062F.","\u0628\u0627 NETCONF (\u0631\u0648\u06CC SSH 830) \u06CC\u0627 RESTCONF (\u0631\u0648\u06CC HTTPS) \u0647\u0645\u0627\u0646 \u062F\u0631\u062E\u062A \u0631\u0627 \u0645\u06CC\u200C\u062E\u0648\u0627\u0646\u06CC \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u062F\u0647\u06CC. \u0645\u0632\u06CC\u062A \u0628\u0632\u0631\u06AF: \u0627\u06AF\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0628\u0627 \u0645\u062F\u0644 \u0646\u062E\u0648\u0627\u0646\u062F\u060C \u062F\u0633\u062A\u06AF\u0627\u0647 \u0647\u0645\u0627\u0646 \u0627\u0648\u0644 \u0631\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F (validation) \u0648 \u0634\u0645\u0627 \u0645\u062C\u0628\u0648\u0631 \u0646\u06CC\u0633\u062A\u06CC\u062F \u0628\u0641\u0647\u0645\u06CC\u062F \u0686\u0631\u0627 \u0646\u0635\u0641 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0627\u0639\u0645\u0627\u0644 \u0634\u062F\u0647 \u0627\u0633\u062A."]},{h:"\u0627\u0628\u0632\u0627\u0631\u0647\u0627 \u0648 \u062C\u0627\u06CC \u0647\u0631\u06A9\u062F\u0627\u0645",p:["Ansible \u0628\u0631\u0627\u06CC \xAB\u0627\u062C\u0631\u0627\u06CC \u0648\u0638\u0627\u06CC\u0641\xBB \u062E\u0648\u0628 \u0627\u0633\u062A \u0648 \u0645\u0627\u0698\u0648\u0644\u200C\u0647\u0627\u06CC \u0634\u0628\u06A9\u0647 \u062F\u0627\u0631\u062F (ios_config, ios_command). Terraform \u0628\u0631\u0627\u06CC \xAB\u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u0646\u0627\u0628\u0639\xBB \u0628\u0647\u200C\u0635\u0648\u0631\u062A \u062D\u0627\u0644\u062A\u200C\u0645\u062D\u0648\u0631 (state) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u062F\u0631 \u0645\u062D\u06CC\u0637\u200C\u0647\u0627\u06CC \u0627\u0628\u0631\u06CC/\u0645\u062C\u0627\u0632\u06CC \u0639\u0627\u0644\u06CC \u0627\u0633\u062A. \u06A9\u0646\u062A\u0631\u0644\u0631\u0647\u0627 (Catalyst Center\u060C SD-WAN Manager) \u0647\u0645 API \u062F\u0627\u0631\u0646\u062F \u0648 \u0628\u0631\u0627\u06CC \u0645\u0642\u06CC\u0627\u0633 \u0628\u0632\u0631\u06AF \u0627\u0646\u062A\u062E\u0627\u0628 \u0627\u0648\u0644\u200C\u0627\u0646\u062F.","Python \u0628\u0627 \u06A9\u062A\u0627\u0628\u062E\u0627\u0646\u0647\u200C\u0647\u0627\u06CC ncclient \u0648 requests\u060C \u0632\u0628\u0627\u0646 \u0686\u0633\u0628\u200C\u062F\u0647\u0646\u062F\u0647 \u0627\u06CC\u0646\u200C\u0647\u0627\u0633\u062A. \u062F\u0631 \u0639\u0645\u0644\u060C \u0633\u0627\u0632\u0645\u0627\u0646\u200C\u0647\u0627 \u062A\u0631\u06A9\u06CC\u0628\u06CC \u0627\u0632 \u0647\u0645\u0647 \u0631\u0627 \u062F\u0627\u0631\u0646\u062F: \u06A9\u0646\u062A\u0631\u0644\u0631 \u0628\u0631\u0627\u06CC \u0632\u06CC\u0631\u0633\u0627\u062E\u062A\u060C Ansible \u0628\u0631\u0627\u06CC \u0648\u0638\u0627\u06CC\u0641 \u062F\u0648\u0631\u0647\u200C\u0627\u06CC\u060C \u0648 CI/CD \u0628\u0631\u0627\u06CC \u062A\u0633\u062A \u062A\u063A\u06CC\u06CC\u0631\u0627\u062A \u0642\u0628\u0644 \u0627\u0632 \u0627\u0639\u0645\u0627\u0644."],list:["NETCONF/RESTC