EL \u0627\u0633\u062A\u061B System ID \u0628\u0627\u06CC\u062F \u0637\u0628\u0642 \u0637\u0631\u0627\u062D\u06CC \u062F\u0631 \u062F\u0627\u0645\u0646\u0647 \u0645\u0648\u0631\u062F\u0646\u06CC\u0627\u0632 \u06CC\u06A9\u062A\u0627 \u0628\u0627\u0634\u062F. L1 \u0628\u0631\u0627\u06CC \u062F\u0627\u062E\u0644 \u0646\u0627\u062D\u06CC\u0647 \u0648 L2 \u0628\u0631\u0627\u06CC \u0627\u062A\u0635\u0627\u0644 \u0628\u06CC\u0646 \u0646\u0627\u062D\u06CC\u0647\u200C\u0647\u0627 \u0628\u0647\u200C\u06A9\u0627\u0631 \u0645\u06CC\u200C\u0631\u0648\u062F \u0648 \u0631\u0648\u062A\u0631 L1/L2 \u062F\u0631 \u0647\u0631 \u062F\u0648 \u0633\u0637\u062D \u0645\u0634\u0627\u0631\u06A9\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u062F\u0631 \u06CC\u06A9 \u0646\u0645\u0648\u0646\u0647 \u0628\u0627 \u062F\u0648 \u0646\u0627\u062D\u06CC\u0647\u060C \u0631\u0648\u062A\u0631\u0647\u0627\u06CC L1 \u062A\u0648\u067E\u0648\u0644\u0648\u0698\u06CC \u0633\u0637\u062D \u06CC\u06A9 \u062E\u0648\u062F \u0631\u0627 \u0645\u06CC\u200C\u0634\u0646\u0627\u0633\u0646\u062F \u0648 L1/L2 \u062F\u0633\u062A\u0631\u0633\u06CC \u0628\u0647 backbone \u0633\u0637\u062D \u062F\u0648 \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0633\u0637\u062D \u06CC\u06A9 \u0648 \u062F\u0648 \u062C\u062F\u0627 \u0647\u0633\u062A\u0646\u062F \u0648 \u0627\u0646\u062A\u0634\u0627\u0631 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u062E\u0627\u0635 \u0628\u06CC\u0646 \u0622\u0646\u200C\u0647\u0627 \u0628\u0633\u062A\u0647 \u0628\u0647 \u0633\u06CC\u0627\u0633\u062A \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F. Wide metric \u0638\u0631\u0641\u06CC\u062A \u0646\u0645\u0627\u06CC\u0634 \u0647\u0632\u06CC\u0646\u0647\u200C\u0647\u0627\u06CC \u0628\u0632\u0631\u06AF\u200C\u062A\u0631 \u0648 \u0628\u0631\u062E\u06CC \u062A\u0648\u0633\u0639\u0647\u200C\u0647\u0627 \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0627\u0632 show isis neighbors\u060C show isis database \u0648 show ip route isis \u06CC\u0627 \u062F\u0633\u062A\u0648\u0631 \u0645\u062A\u0646\u0627\u0638\u0631 \u0646\u0633\u062E\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646. \u0633\u0637\u062D \u0645\u0634\u062A\u0631\u06A9\u060C area\u060C MTU\u060C \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A\u060C NET \u0648 \u0641\u0639\u0627\u0644 \u0628\u0648\u062F\u0646 \u067E\u0631\u0648\u062A\u06A9\u0644 \u0631\u0648\u06CC \u0631\u0627\u0628\u0637 \u0631\u0627 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646. \u0627\u0631\u062A\u0628\u0627\u0637 IGP \u0648 SID\u0647\u0627\u06CC SR \u0631\u0627 \u062F\u0631 [[sp-sr|Segment Routing]] \u0648 \u0645\u0642\u0627\u06CC\u0633\u0647 \u0645\u0641\u0647\u0648\u0645\u06CC \u0628\u0627 [[ospf-multi|OSPF \u0686\u0646\u062F\u0646\u0627\u062D\u06CC\u0647]] \u0628\u062E\u0648\u0627\u0646."],"sp-evpn":["EVPN \u06CC\u06A9 \u062E\u0627\u0646\u0648\u0627\u062F\u0647 route \u062F\u0631 BGP \u0628\u0631\u0627\u06CC \u062E\u062F\u0645\u0627\u062A \u0634\u0628\u06A9\u0647 \u0627\u062A\u0631\u0646\u062A \u0648 \u0645\u0648\u0627\u0631\u062F \u062F\u06CC\u06AF\u0631 \u0627\u0633\u062A. PE\u0647\u0627 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F MAC\u0647\u0627\u06CC \u0645\u062D\u0644\u06CC \u0631\u0627 \u0627\u0632 \u0635\u0641\u062D\u0647 \u062F\u0627\u062F\u0647 \u0628\u06CC\u0627\u0645\u0648\u0632\u0646\u062F \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062A MAC/IP \u062F\u0648\u0631\u062F\u0633\u062A \u0631\u0627 \u0628\u0627 \u06A9\u0646\u062A\u0631\u0644 BGP \u0645\u0646\u062A\u0634\u0631 \u06A9\u0646\u0646\u062F. Broadcast\u060C unknown unicast \u0648 multicast \u06CC\u0627 BUM \u0647\u0645\u0686\u0646\u0627\u0646 \u0628\u0647 \u062A\u06A9\u062B\u06CC\u0631 \u0648 \u0633\u06CC\u0627\u0633\u062A \u0645\u0646\u0627\u0633\u0628 \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u0646\u062F.","Route Type 2 \u0622\u06AF\u0647\u06CC MAC/IP\u060C Type 3 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0639\u0636\u0648\u06CC\u062A \u0648 \u062A\u0648\u0632\u06CC\u0639 \u0641\u0631\u0627\u06AF\u06CC\u0631 \u0628\u0631\u0627\u06CC BUM \u0648 Type 5 prefix IP \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. Type 1 \u0648 4 \u062F\u0631 \u0633\u0627\u0632\u0648\u06A9\u0627\u0631\u0647\u0627\u06CC Ethernet Segment \u0648 \u0686\u0646\u062F\u0627\u062A\u0635\u0627\u0644\u06CC \u0646\u0642\u0634 \u062F\u0627\u0631\u0646\u062F. ESI \u0647\u0648\u06CC\u062A \u0633\u06AF\u0645\u0646\u062A \u0648 DF \u0631\u0648\u062A\u0631 \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647 \u0628\u0631\u0627\u06CC \u0628\u062E\u0634\u200C\u0647\u0627\u06CC\u06CC \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 BUM \u0628\u0647 \u0633\u06AF\u0645\u0646\u062A \u0627\u0633\u062A\u061B \u062C\u0632\u0626\u06CC\u0627\u062A \u062D\u0627\u0644\u062A all-active \u0648 single-active \u062A\u0641\u0627\u0648\u062A \u062F\u0627\u0631\u062F.","\u062F\u0631 \u0635\u0648\u0631\u062A \u0646\u0628\u0648\u062F MAC \u062F\u0631 PE \u0645\u0642\u0635\u062F\u060C \u0648\u0636\u0639\u06CC\u062A \u0646\u0634\u0633\u062A \u0648 \u0622\u06AF\u0647\u06CC Type 2\u060C \u0633\u06CC\u0627\u0633\u062A RT\u060C \u0639\u0636\u0648\u06CC\u062A \u0633\u0631\u0648\u06CC\u0633 \u0648 \u062F\u0633\u062A\u0631\u0633\u200C\u067E\u0630\u06CC\u0631\u06CC next-hop \u0631\u0627 \u062C\u062F\u0627\u06AF\u0627\u0646\u0647 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. \u0628\u0631\u0627\u06CC BUM \u0628\u0647 Type 3 \u0648 \u0631\u0648\u0634 replication \u0648 \u0628\u0631\u0627\u06CC \u0686\u0646\u062F\u0627\u062A\u0635\u0627\u0644\u06CC \u0628\u0647 ESI \u0648 DF \u062A\u0648\u062C\u0647 \u06A9\u0646. [[vxlan-evpn|EVPN \u0631\u0648\u06CC VXLAN]] \u0648 [[bgp-advanced|\u0633\u06CC\u0627\u0633\u062A BGP]] \u0645\u06A9\u0645\u0644\u200C\u0627\u0646\u062F."],"dc-spine-leaf":["Spine-Leaf \u0628\u0647\u200C\u062C\u0627\u06CC \u067E\u0631\u0647\u06CC\u0632 \u0627\u0632 \u062D\u0644\u0642\u0647 \u0628\u0627 STP\u060C \u062D\u0644\u0642\u0647 \u0631\u0627 \u062F\u0631 \u0644\u0627\u06CC\u0647 \u06F3 \u062D\u0630\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0647\u0631 Leaf \u0628\u0647 \u0647\u0645\u0647 Spine\u0647\u0627 \u0648\u0635\u0644 \u0627\u0633\u062A \u0648 \u0647\u06CC\u0686 Leaf\u06CC \u0628\u0647 Leaf \u062F\u06CC\u06AF\u0631 \u0648\u0635\u0644 \u0646\u06CC\u0633\u062A. \u0646\u062A\u06CC\u062C\u0647 \u067E\u0631\u0634 \u062B\u0627\u0628\u062A \u062F\u0648\u06AF\u0627\u0646\u0647 \u0648 \u0627\u0645\u06A9\u0627\u0646 ECMP \u0631\u0648\u06CC \u0647\u0645\u0647 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627 \u0627\u0633\u062A.","\u0627\u06AF\u0631 \u0628\u062E\u0648\u0627\u0647\u06CC \u0647\u0645\u06CC\u0646 \u0631\u0627 \u0628\u0627 EtherChannel \u0648 STP \u0628\u0633\u0627\u0632\u06CC\u060C \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC \u0627\u0636\u0627\u0641\u06CC \u0645\u0633\u062F\u0648\u062F \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u0638\u0631\u0641\u06CC\u062A \u0647\u062F\u0631 \u0645\u06CC\u200C\u0631\u0648\u062F. \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0644\u0627\u06CC\u0647 \u06F3 \u0628\u0627 BGP \u0648 maximum-paths \u0647\u0645\u0647 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627 \u0631\u0627 \u0641\u0639\u0627\u0644 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F. \u0627\u06CC\u0646 \u062A\u0635\u0645\u06CC\u0645 \u0631\u0627 \u062F\u0631 [[dc-vpc|vPC]] \u0648 [[dc-evpn-multisite|EVPN Multisite]] \u0627\u062F\u0627\u0645\u0647 \u0628\u062F\u0647.","\u0628\u0631\u0627\u06CC \u062A\u0623\u06CC\u06CC\u062F\u060C `show ip route` \u0631\u0627 \u0628\u0628\u06CC\u0646 \u06A9\u0647 \u0628\u0627\u06CC\u062F \u0686\u0646\u062F next-hop \u0647\u0645\u200C\u0647\u0632\u06CC\u0646\u0647 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\u060C \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u0647\u0631 uplink \u0631\u0627 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646. \u0627\u06AF\u0631 \u06CC\u06A9\u06CC \u0628\u06CC\u200C\u0628\u0627\u0631 \u0627\u0633\u062A\u060C \u0645\u0634\u06A9\u0644 \u0647\u0634\u06CC\u0646\u06AF \u0627\u0633\u062A \u0646\u0647 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC."],"dc-vpc":["vPC \u0633\u0647 \u062C\u0632\u0621 \u062F\u0627\u0631\u062F: Peer-Link \u0628\u0631\u0627\u06CC \u062F\u0627\u062F\u0647 \u0648 \u0647\u0645\u06AF\u0627\u0645\u200C\u0633\u0627\u0632\u06CC\u060C Peer-Keepalive \u0628\u0631\u0627\u06CC heartbeat \u0627\u0632 \u0645\u0633\u06CC\u0631 \u0645\u0633\u062A\u0642\u0644\u060C \u0648 \u0646\u0642\u0634 Primary/Secondary. \u0646\u0628\u0648\u062F \u0647\u0631 \u06CC\u06A9\u060C \u0631\u0641\u062A\u0627\u0631 \u0633\u06CC\u0633\u062A\u0645 \u0631\u0627 \u062F\u0631 \u0642\u0637\u0639\u06CC \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F.","\u0633\u0646\u0627\u0631\u06CC\u0648\u06CC \u06A9\u0644\u0627\u0633\u06CC\u06A9: Peer-Link \u0642\u0637\u0639 \u0648 keepalive \u0633\u0627\u0644\u0645 \u2192 Secondary \u0647\u0645\u0647 vPC\u0647\u0627 \u0631\u0627 suspend \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u06AF\u0631 \u0647\u0631 \u062F\u0648 \u0642\u0637\u0639 \u0634\u0648\u0646\u062F\u060C \u062E\u0637\u0631 split-brain \u0648 \u062D\u0644\u0642\u0647 \u0627\u0633\u062A\u061B auto-recovery \u0628\u0627 reload-delay \u0627\u06CC\u0646 \u067E\u0646\u062C\u0631\u0647 \u0631\u0627 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F.","consistency-parameters \u0631\u0627 \u062F\u0631 \u0647\u0631 \u062A\u063A\u06CC\u06CC\u0631 \u0686\u06A9 \u06A9\u0646: MTU\u060C allowed VLAN \u0648 STP mode. vPC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F up \u0628\u0627\u0634\u062F \u0648 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0647\u0645\u0686\u0646\u0627\u0646 \u0646\u0627\u0642\u0635 \u0628\u0627\u0634\u062F."],"dc-aci":["ACI \u0645\u062F\u0644 \u0633\u06CC\u0627\u0633\u062A\u200C\u0645\u062D\u0648\u0631 \u0627\u0633\u062A: Tenant \u0645\u0631\u0632 \u0627\u062F\u0627\u0631\u06CC\u060C VRF \u0645\u0631\u0632 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC\u060C BD \u0645\u0631\u0632 L2 \u0628\u0627 gateway\u060C EPG \u06AF\u0631\u0648\u0647 \u0646\u0642\u0627\u0637 \u067E\u0627\u06CC\u0627\u0646\u06CC \u0648 Contract \u0645\u062C\u0648\u0632 \u0627\u0631\u062A\u0628\u0627\u0637. VLAN \u0641\u0642\u0637 \u0628\u0631\u0627\u06CC \u0627\u062A\u0635\u0627\u0644 \u0628\u0647 \u062F\u0646\u06CC\u0627\u06CC \u0628\u06CC\u0631\u0648\u0646 \u0645\u0639\u0646\u0627 \u062F\u0627\u0631\u062F.","\u062F\u0631 ACI \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 deny \u0627\u0633\u062A. \u0627\u06AF\u0631 Contract \u0646\u0628\u0627\u0634\u062F \u062D\u062A\u06CC \u062F\u0648 EPG \u062F\u0631 \u06CC\u06A9 BD \u0628\u0627 \u0647\u0645 \u062D\u0631\u0641 \u0646\u0645\u06CC\u200C\u0632\u0646\u0646\u062F. Contract stateful \u0627\u0633\u062A\u060C \u067E\u0633 \u067E\u0627\u0633\u062E \u0628\u062F\u0648\u0646 Contract \u0645\u0639\u06A9\u0648\u0633 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F. \u0628\u0631\u0627\u06CC \u0645\u0642\u0627\u06CC\u0633\u0647 \u0628\u0627 \u0645\u062F\u0644 \u0633\u0646\u062A\u06CC\u060C [[bank-pci-segmentation|\u0633\u06AF\u0645\u0646\u062A\u06CC\u0634\u0646]] \u0631\u0627 \u0628\u0628\u06CC\u0646.","\u062A\u0631\u062A\u06CC\u0628 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC: `show endpoint ip` \u2192 EPG membership \u2192 Contract/filter \u2192 zoning-rule \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647. \u0628\u06CC\u0634\u062A\u0631 \u0645\u0648\u0627\u0631\u062F \xABContract \u062F\u0631\u0633\u062A \u0627\u0633\u062A \u0648\u0644\u06CC \u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F\xBB \u0628\u0647 EPG \u0627\u0634\u062A\u0628\u0627\u0647 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F."],"dc-san":["FC \u0628\u0631\u0627\u06CC \u0628\u062F\u0648\u0646\u200C\u0627\u0641\u062A \u0637\u0631\u0627\u062D\u06CC \u0634\u062F\u061B FCoE \u0647\u0645\u0627\u0646 \u0641\u0631\u06CC\u0645 \u0631\u0627 \u0631\u0648\u06CC \u0627\u062A\u0631\u0646\u062A \u0645\u06CC\u200C\u0628\u0631\u062F \u0648 \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646 \u0628\u0647 PFC \u0648\u0627\u0628\u0633\u062A\u0647 \u0627\u0633\u062A. iSCSI \u0631\u0648\u06CC TCP \u06A9\u0646\u062A\u0631\u0644 \u0627\u0632\u062F\u062D\u0627\u0645 \u0648 retransmit \u062F\u0627\u0631\u062F \u0648 \u0647\u0645\u06CC\u0646 \u062A\u0641\u0627\u0648\u062A\u060C \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0639\u0645\u0627\u0631\u06CC \u0631\u0627 \u062A\u0639\u06CC\u06CC\u0646 \u0645\u06CC\u200C\u06A9\u0646\u062F.","VSAN \u062C\u062F\u0627\u0633\u0627\u0632\u06CC \u0648 Zoning \u06A9\u0646\u062A\u0631\u0644 \u062F\u0633\u062A\u0631\u0633\u06CC \u0627\u0633\u062A. single-initiator zoning \u0642\u0627\u0628\u0644 audit\u200C\u062A\u0631 \u0627\u0633\u062A. \u062F\u0648 \u0641\u0627\u0628\u0631\u06CC\u06A9 SAN \u0645\u0633\u062A\u0642\u0644\u200C\u0627\u0646\u062F\u061B \u0633\u0627\u0644\u0645 \u0628\u0648\u062F\u0646 \u06CC\u06A9\u06CC\u060C \u0633\u0627\u0644\u0645 \u0628\u0648\u062F\u0646 SAN \u0646\u06CC\u0633\u062A. \u0628\u0631\u0627\u06CC \u0644\u0627\u06CC\u0647 \u0628\u062F\u0648\u0646\u200C\u0627\u0641\u062A\u060C [[dc-lossless-qos|QoS \u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631]] \u0631\u0627 \u0628\u062E\u0648\u0627\u0646.","\u0627\u06AF\u0631 I/O timeout \u062F\u06CC\u062F\u06CC\u060C \u0627\u0648\u0644 `show interface priority-flow-control` \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 drop \u0631\u0627 \u0628\u0628\u06CC\u0646\u061B \u062F\u0631 FCoE\u060C drop \u06CC\u0639\u0646\u06CC reset \u0634\u062F\u0646 I/O\u060C \u0646\u0647 \u0641\u0642\u0637 \u06A9\u0646\u062F\u06CC."],"dc-lossless-qos":["PFC \u0628\u0627 Pause per-priority \u062C\u0644\u0648\u06CC drop \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 ECN \u0628\u0627 \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC \u062F\u0631 IP \u0627\u0632 \u0627\u0632\u062F\u062D\u0627\u0645 \u062E\u0628\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F. \u062A\u0631\u06A9\u06CC\u0628 \u062A\u0648\u0635\u06CC\u0647\u200C\u0634\u062F\u0647 \u0628\u0631\u0627\u06CC RoCEv2\u060C ECN \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646 \u0645\u06A9\u0627\u0646\u06CC\u0632\u0645 \u0627\u0635\u0644\u06CC \u0648 PFC \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646 \u062A\u0648\u0631 \u0646\u062C\u0627\u062A \u0627\u0633\u062A.","\u0622\u0633\u062A\u0627\u0646\u0647 ECN \u062E\u06CC\u0644\u06CC \u067E\u0627\u06CC\u06CC\u0646 throughput \u0631\u0627 \u06A9\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062E\u06CC\u0644\u06CC \u0628\u0627\u0644\u0627 PFC \u0631\u0627 \u062F\u0627\u0626\u0645 \u0641\u0639\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062A\u0646\u0638\u06CC\u0645 \u0628\u0627\u06CC\u062F \u0628\u0627 baseline \u0648 \u0627\u0646\u062F\u0627\u0632\u0647\u200C\u06AF\u06CC\u0631\u06CC \u0642\u0628\u0644/\u0628\u0639\u062F \u0647\u0645\u0631\u0627\u0647 \u0628\u0627\u0634\u062F.","\u062E\u0637\u0631 PFC\u060C deadlock \u0648 \u062D\u0644\u0642\u0647 pause \u0627\u0633\u062A. watchdog \u0648 \u0637\u0631\u0627\u062D\u06CC deadlock \u0631\u0627 \u062C\u062F\u06CC \u0628\u06AF\u06CC\u0631\u061B \u062F\u0631 \u0634\u0628\u06A9\u0647 \u0630\u062E\u06CC\u0631\u0647\u200C\u0633\u0627\u0632\u06CC \u0628\u0627\u0646\u06A9\u060C \u062A\u0648\u0642\u0641 \u06A9\u0627\u0645\u0644 \u0628\u062F\u062A\u0631 \u0627\u0632 \u06A9\u0646\u062F\u06CC \u0627\u0633\u062A."],"bank-active-active":["\u0641\u0639\u0627\u0644-\u0641\u0639\u0627\u0644 \u0633\u0647 \u0644\u0627\u06CC\u0647 \u062F\u0627\u0631\u062F: \u0627\u0646\u062A\u062E\u0627\u0628 \u0633\u0627\u06CC\u062A (DNS/GSLB \u06CC\u0627 anycast)\u060C \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC (BGP) \u0648 \u0648\u0636\u0639\u06CC\u062A (\u0646\u0634\u0633\u062A/\u0633\u0628\u062F/\u062A\u0648\u06A9\u0646). \u0627\u06AF\u0631 \u0644\u0627\u06CC\u0647 \u0633\u0648\u0645 \u062D\u0644 \u0646\u0634\u0648\u062F\u060C \u062F\u0648 \u0644\u0627\u06CC\u0647 \u0627\u0648\u0644 \u0641\u0642\u0637 \u0633\u0631\u0639\u062A \u0631\u0633\u06CC\u062F\u0646 \u0628\u0647 \u062E\u0637\u0627 \u0631\u0627 \u0628\u0627\u0644\u0627 \u0645\u06CC\u200C\u0628\u0631\u0646\u062F.","\u0633\u0631\u0648\u06CC\u0633 \u0628\u06CC\u200C\u062D\u0627\u0644\u062A \u0631\u0627 \u0628\u0627 anycast \u0633\u0627\u062F\u0647 \u06A9\u0646 \u0648 \u0633\u0631\u0648\u06CC\u0633 \u062D\u0627\u0644\u062A\u200C\u062F\u0627\u0631 \u0631\u0627 \u0628\u0627 GSLB \u0622\u06AF\u0627\u0647 \u0627\u0632 \u0646\u0634\u0633\u062A. TTL \u06A9\u0648\u062A\u0627\u0647 \u0628\u0631\u0627\u06CC \u0631\u06A9\u0648\u0631\u062F\u0647\u0627\u06CC \u0628\u062D\u0631\u0627\u0646\u06CC \u0644\u0627\u0632\u0645 \u0627\u0633\u062A \u0648\u0644\u06CC \u0628\u0627\u0631 \u06A9\u0648\u0626\u0631\u06CC \u0631\u0627 \u0628\u0627\u0644\u0627 \u0645\u06CC\u200C\u0628\u0631\u062F.","\u0628\u0631\u0627\u06CC \u067E\u0631\u062F\u0627\u062E\u062A\u060C idempotency key \u0627\u062C\u0628\u0627\u0631\u06CC \u0627\u0633\u062A. \u062C\u0632\u0626\u06CC\u0627\u062A \u0628\u0627\u0632\u06CC\u0627\u0628\u06CC \u0648 \u0627\u0639\u062F\u0627\u062F RPO/RTO \u062F\u0631 [[bank-dr|DR]] \u0622\u0645\u062F\u0647 \u0627\u0633\u062A."],"bank-pci-segmentation":["CDE \u0647\u0631 \u0633\u06CC\u0633\u062A\u0645\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062F\u0627\u062F\u0647 \u06A9\u0627\u0631\u062A \u0631\u0627 \u067E\u0631\u062F\u0627\u0632\u0634\u060C \u0630\u062E\u06CC\u0631\u0647 \u06CC\u0627 \u0645\u0646\u062A\u0642\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0648 \u0647\u0631 \u0633\u06CC\u0633\u062A\u0645\u06CC \u06A9\u0647 \u0628\u0647 \u0622\u0646 \u062F\u0633\u062A\u0631\u0633\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u062F\u0627\u0631\u062F \u0647\u0645 \u0639\u0645\u0644\u0627\u064B \u062F\u0631 \u0645\u0631\u0632 \u0627\u0633\u062A. \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646 \u0633\u06AF\u0645\u0646\u062A\u06CC\u0634\u0646 \u0641\u0642\u0637 \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 \u0646\u06CC\u0633\u062A.","deny by default \u0648 \u0627\u0633\u062A\u062B\u0646\u0627\u06CC \u0645\u0633\u062A\u0646\u062F \u0642\u0627\u0639\u062F\u0647 \u0627\u0635\u0644\u06CC \u0627\u0633\u062A. SGT/SGACL \u0633\u06CC\u0627\u0633\u062A \u0631\u0627 \u0627\u0632 \u0622\u062F\u0631\u0633 \u062C\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062F\u0631 \u0645\u062D\u06CC\u0637 \u0645\u062C\u0627\u0632\u06CC \u06A9\u0647 \u0622\u062F\u0631\u0633 \u0639\u0648\u0636 \u0645\u06CC\u200C\u0634\u0648\u062F \u067E\u0627\u06CC\u062F\u0627\u0631 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F. \u0645\u062F\u0644 ACI \u0631\u0627 \u062F\u0631 [[dc-aci|ACI]] \u0628\u0628\u06CC\u0646.","\u0633\u06AF\u0645\u0646\u062A\u06CC\u0634\u0646 \u0631\u0627 \u0628\u0627 \u0622\u0632\u0645\u0648\u0646 \u0645\u0646\u0641\u06CC \u0627\u062B\u0628\u0627\u062A \u06A9\u0646: \u0627\u0632 POS \u0628\u0647 \u067E\u0648\u0631\u062A \u063A\u06CC\u0631\u0645\u062C\u0627\u0632\u060C \u0648 \u0627\u0632 \u0634\u0628\u06A9\u0647 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0628\u062F\u0648\u0646 jump host. \u0628\u062F\u0648\u0646 \u0644\u0627\u06AF\u060C \u06A9\u0646\u062A\u0631\u0644 \u0627\u062B\u0628\u0627\u062A\u200C\u0646\u0634\u062F\u0647 \u0627\u0633\u062A."],"bank-dr":["RPO \u062F\u0631\u0628\u0627\u0631\u0647 \u062F\u0627\u062F\u0647 \u0627\u0633\u062A \u0648 RTO \u062F\u0631\u0628\u0627\u0631\u0647 \u0632\u0645\u0627\u0646. RPO \u0635\u0641\u0631 \u06CC\u0639\u0646\u06CC replication \u0633\u0646\u06A9\u0631\u0648\u0646 \u0648 \u0647\u0632\u06CC\u0646\u0647 latency. RTO \u0628\u062F\u0648\u0646 \u062F\u0631 \u0646\u0638\u0631 \u06AF\u0631\u0641\u062A\u0646 TTL \u0648 \u06A9\u0634 DNS \u0639\u062F\u062F \u0648\u0627\u0642\u0639\u06CC \u0646\u06CC\u0633\u062A.","\u06A9\u0634\u06CC\u062F\u0646 L2 \u0645\u0647\u0627\u062C\u0631\u062A \u0631\u0627 \u0633\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648\u0644\u06CC \u062E\u0637\u0627\u0647\u0627\u06CC \u0644\u0627\u06CC\u0647 \u06F2 \u0631\u0627 \u0628\u06CC\u0646 \u0633\u0627\u06CC\u062A\u200C\u0647\u0627 \u0645\u06CC\u200C\u0628\u0631\u062F\u061B L3 DCI \u0633\u0627\u062F\u0647\u200C\u062A\u0631 \u0627\u0633\u062A \u0648\u0644\u06CC \u0628\u0647 \u0622\u06AF\u0627\u0647\u06CC \u0627\u067E\u0644\u06CC\u06A9\u06CC\u0634\u0646 \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F. \u06AF\u0632\u06CC\u0646\u0647\u200C\u0647\u0627 \u0631\u0627 \u0628\u0627 \u0631\u06CC\u0633\u06A9 \u0645\u06A9\u062A\u0648\u0628 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646.","\u0622\u0632\u0645\u0648\u0646 DR \u0628\u0627\u06CC\u062F \u0633\u0647 \u0639\u062F\u062F \u0628\u062F\u0647\u062F: downtime\u060C \u062F\u0627\u062F\u0647 \u0627\u0632 \u062F\u0633\u062A \u0631\u0641\u062A\u0647 \u0648 \u0632\u0645\u0627\u0646 \u0628\u0627\u0632\u06AF\u0634\u062A \u06A9\u0627\u0645\u0644. \u0627\u06AF\u0631 \u0627\u06CC\u0646 \u0633\u0647 \u0631\u0627 \u0646\u062F\u0627\u0631\u06CC\u060C \u0641\u0642\u0637 \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u062F\u0627\u0631\u06CC. \u0645\u0633\u06CC\u0631 L2 \u0631\u0627 \u062F\u0631 [[dc-evpn-multisite|EVPN Multisite]] \u0628\u0628\u06CC\u0646."],"dc-evpn-multisite":["EVPN \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC Type 2 (MAC/IP) \u0648 Type 5 (\u067E\u06CC\u0634\u0648\u0646\u062F IP) \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 ESI \u0645\u0627\u0644\u062A\u06CC\u200C\u0647\u0648\u0645\u06CC\u0646\u06AF \u0631\u0627 \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u062F. Border Gateway \u0628\u0627 site-id \u0645\u0631\u0632 \u0633\u0627\u06CC\u062A \u0631\u0627 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F \u0648 flooding \u0631\u0627 \u06A9\u0646\u062A\u0631\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0628\u0627 anycast gateway\u060C \u0645\u0647\u0627\u062C\u0631\u062A VM \u0628\u062F\u0648\u0646 \u062A\u063A\u06CC\u06CC\u0631 IP \u0645\u0645\u06A9\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F: \u0645\u0628\u062F\u0623 \u0645\u0633\u06CC\u0631 Type 2 \u0631\u0627 withdraw \u0648 \u0645\u0642\u0635\u062F \u0627\u0639\u0644\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0627\u06AF\u0631 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u0647 \u0633\u0627\u06CC\u062A \u0642\u0628\u0644\u06CC \u0645\u06CC\u200C\u0631\u0648\u062F\u060C \u0627\u0648\u0644 \u0648\u062C\u0648\u062F \u0648 withdraw \u0634\u062F\u0646 Type 2 \u0631\u0627 \u062F\u0631 \u0647\u0631 \u062F\u0648 Border \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u061B \u0633\u067E\u0633 route-target \u0648 multisite."],"bank-observability":["\u0628\u0631\u0627\u06CC \u062A\u0631\u0627\u06A9\u0646\u0634\u060C p95 \u0648 p99 \u0645\u0639\u06CC\u0627\u0631\u0646\u062F \u0646\u0647 \u0645\u06CC\u0627\u0646\u06AF\u06CC\u0646. NetFlow \u0628\u0627 timestamp \u0648 \u067E\u0648\u0631\u062A\u200C\u0647\u0627 \u0627\u062C\u0627\u0632\u0647 \u062A\u062D\u0644\u06CC\u0644 per-flow \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 telemetry \u0627\u0633\u062A\u0631\u06CC\u0645\u06CC \u062F\u0642\u062A \u0628\u0627\u0644\u0627\u062A\u0631\u06CC \u0645\u06CC\u200C\u062F\u0647\u062F.","\u0628\u0648\u062F\u062C\u0647 \u062A\u0623\u062E\u06CC\u0631 \u0631\u0627 \u0628\u06CC\u0646 \u0628\u062E\u0634\u200C\u0647\u0627 \u0628\u0634\u06A9\u0646 \u0648 \u0647\u0631 \u0628\u062E\u0634 \u0631\u0627 \u062C\u062F\u0627 \u0627\u0646\u062F\u0627\u0632\u0647 \u0628\u06AF\u06CC\u0631\u061B \u0645\u062C\u0645\u0648\u0639 \u0628\u0627\u06CC\u062F \u0632\u06CC\u0631 SLO \u0628\u0645\u0627\u0646\u062F. \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u062C\u0647\u062A \u0628\u0647\u06CC\u0646\u0647\u200C\u0633\u0627\u0632\u06CC \u0631\u0627 \u0627\u0632 \u062D\u062F\u0633 \u0628\u0647 \u0639\u062F\u062F \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F.","timeout \u0631\u0627 \u0628\u0627\u0644\u0627\u06CC p99 \u0628\u06AF\u0630\u0627\u0631. timeout \u06A9\u0645\u062A\u0631 \u0627\u0632 p99\u060C \u062A\u0631\u0627\u06A9\u0646\u0634 \u0633\u0627\u0644\u0645 \u0631\u0627 \u0642\u0637\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0628\u0639\u062F \u062E\u0637\u0627 \u0628\u0647 \u0634\u0628\u06A9\u0647 \u0646\u0633\u0628\u062A \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u0628\u0632\u0627\u0631 \u062C\u0645\u0639\u200C\u0622\u0648\u0631\u06CC \u0631\u0627 \u062F\u0631 [[flexible-netflow|Flexible NetFlow]] \u0628\u0628\u06CC\u0646."],"eem-automation":["EEM \u0627\u0632 event \u0648 action \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0628\u0631\u0627\u06CC \u0634\u0631\u0648\u0639\u060C applet \u06A9\u0627\u0641\u06CC \u0627\u0633\u062A\u061B Tcl \u0628\u0631\u0627\u06CC \u0645\u0646\u0637\u0642 \u067E\u06CC\u0686\u06CC\u062F\u0647\u200C\u062A\u0631. event \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F syslog\u060C \u062A\u0627\u06CC\u0645\u0631\u060C \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u06CC\u0627 SNMP \u0628\u0627\u0634\u062F.","action\u0647\u0627\u06CC \u0627\u0637\u0644\u0627\u0639\u200C\u0631\u0633\u0627\u0646 \u06A9\u0645\u200C\u062E\u0637\u0631\u0646\u062F\u061B action\u0647\u0627\u06CC\u06CC \u0645\u062B\u0644 shutdown \u06CC\u0627 clear \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u062D\u0644\u0642\u0647 \u0628\u0627\u0632\u062E\u0648\u0631\u062F \u0628\u0633\u0627\u0632\u0646\u062F\u060C \u0645\u062E\u0635\u0648\u0635\u0627\u064B \u0627\u06AF\u0631 pattern \u06A9\u0644\u06CC \u0628\u0627\u0634\u062F.","\u0628\u0627 `event manager run` \u062A\u0633\u062A \u06A9\u0646 \u0648 `maxrun` \u0628\u06AF\u0630\u0627\u0631. \u0627\u06AF\u0631 applet \u062F\u0631 \u0645\u062D\u06CC\u0637 \u0648\u0627\u0642\u0639\u06CC \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u062F \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u062F\u060C human-in-the-loop \u0631\u0627 \u0627\u0644\u0632\u0627\u0645\u06CC \u06A9\u0646. \u062D\u0641\u0627\u0638\u062A \u0627\u0632 CPU \u0631\u0627 \u062F\u0631 [[copp|CoPP]] \u0628\u0628\u06CC\u0646."],copp:["\u06A9\u0646\u062A\u0631\u0644\u200C\u067E\u0644\u06CC\u0646 \u0641\u0631\u0622\u06CC\u0646\u062F\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0627\u0633\u062A. CoPP \u0628\u0627 policy-map \u0631\u0648\u06CC control-plane \u0646\u0631\u062E \u0647\u0631 \u06A9\u0644\u0627\u0633 \u0631\u0627 \u0645\u062D\u062F\u0648\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F \u062A\u0627 \u0633\u06CC\u0644 \u0628\u0633\u062A\u0647 CPU \u0631\u0627 \u0627\u0632 \u06A9\u0627\u0631 \u0646\u06CC\u0646\u062F\u0627\u0632\u062F.","\u06A9\u0644\u0627\u0633 routing \u0628\u0627\u06CC\u062F \u0646\u0631\u062E \u06A9\u0627\u0641\u06CC \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\u061B \u0645\u062D\u062F\u0648\u062F\u06A9\u0631\u062F\u0646 \u0634\u062F\u06CC\u062F \u0622\u0646 \u0647\u0645\u0633\u0627\u06CC\u06AF\u06CC BGP/OSPF \u0631\u0627 \u0645\u06CC\u200C\u0627\u0646\u062F\u0627\u0632\u062F. \u06A9\u0644\u0627\u0633 management \u0631\u0627 \u0645\u062D\u062F\u0648\u062F\u062A\u0631 \u0628\u06AF\u06CC\u0631.","\u0634\u0645\u0627\u0631\u0646\u062F\u0647 exceed \u0631\u0627 \u062A\u0641\u0633\u06CC\u0631 \u06A9\u0646: \u0628\u062F\u0648\u0646 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0648\u0627\u0642\u0639\u06CC \u062F\u0631 MGMT \u06CC\u0639\u0646\u06CC \u0627\u0633\u06A9\u0646. \u0642\u0628\u0644 \u0627\u0632 \u0647\u0631 \u062A\u063A\u06CC\u06CC\u0631\u060C \u062E\u0631\u0648\u062C\u06CC `show policy-map control-plane` \u0631\u0627 \u062B\u0628\u062A \u06A9\u0646."],"dot1x-aaa":["802.1X \u0633\u0647 \u0646\u0642\u0634 \u062F\u0627\u0631\u062F: supplicant\u060C authenticator \u0648 RADIUS. \u0633\u0648\u0626\u06CC\u0686 \u062A\u0627 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0641\u0642\u0637 EAPOL \u0631\u0627 \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\