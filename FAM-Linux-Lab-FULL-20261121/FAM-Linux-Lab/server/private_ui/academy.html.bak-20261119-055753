u062F \u062A\u062F\u0627\u062E\u0644 \u06CC\u0627 \u062A\u0636\u0645\u06CC\u0646 \u0633\u0631\u0639\u062A \u0646\u06CC\u0633\u062A\u061B \u0639\u0631\u0636 \u06A9\u0627\u0646\u0627\u0644\u060C \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0648 \u0637\u0631\u0627\u062D\u06CC \u067E\u0648\u0634\u0634 \u0645\u0647\u0645\u200C\u0627\u0646\u062F.","OFDMA \u06A9\u0627\u0646\u0627\u0644 \u0631\u0627 \u0628\u0647 \u0648\u0627\u062D\u062F\u0647\u0627\u06CC \u0645\u0646\u0628\u0639 \u0628\u0631\u0627\u06CC \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC \u0686\u0646\u062F \u06A9\u0627\u0631\u0628\u0631 \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. BSS coloring \u0628\u0647 \u062A\u0634\u062E\u06CC\u0635 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0647\u0645\u067E\u0648\u0634\u0627\u0646 \u06A9\u0645\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 spatial reuse \u062A\u062D\u062A \u0634\u0631\u0627\u06CC\u0637 \u0645\u0646\u0627\u0633\u0628 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0647\u0645\u200C\u0632\u0645\u0627\u0646\u06CC \u0631\u0627 \u0627\u0641\u0632\u0627\u06CC\u0634 \u062F\u0647\u062F. TWT \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC \u0628\u06CC\u062F\u0627\u0631\u06CC \u0627\u0633\u062A. \u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u06F6GHz\u060C \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627\u06CC \u0627\u0645\u0646\u06CC\u062A\u06CC \u0645\u062C\u0627\u0632 \u0648 PMF \u0631\u0627 \u0637\u0628\u0642 \u06AF\u0648\u0627\u0647\u06CC \u0648 \u067E\u0644\u062A\u0641\u0631\u0645 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u061B OWE \u0628\u0631\u0627\u06CC \u0634\u0628\u06A9\u0647 \u0645\u0647\u0645\u0627\u0646 \u0631\u0645\u0632\u06AF\u0630\u0627\u0631\u06CC\u200C\u0634\u062F\u0647 \u06AF\u0632\u06CC\u0646\u0647\u200C\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0632 WPA3 \u0627\u0633\u062A.","\u062F\u0631 \u0627\u0631\u0632\u06CC\u0627\u0628\u06CC\u060C