  function famLabHook(lab) {
    const key='fam3.hook.'+lab.id;
    try { if(sessionStorage.getItem(key))return ''; sessionStorage.setItem(key,'1'); } catch {}
    let text;
    if(lab.id.includes('vlan')) text='ساعت ۳ صبح، تلفن زنگ می‌زنه. بخش مالی از شبکه قطعه و مدیرعامل جواب می‌خواد. ارتباط VLAN شرکت باید تا یک ساعت دیگه برگرده.';
    else if(lab.id.includes('ospf')) text='پنج دقیقه دیگه جلسه هیئت‌مدیره داری. شبکه بین دو دفتر قطعه و مسیریابی OSPF درست کار نمی‌کنه.';
    else if(lab.tshoot?.symptom) text='یک هشدار فوری از شبکه رسیده: '+lab.tshoot.symptom+' تیم منتظر تشخیص و راه‌حل توست.';
    else text='یک اختلال در شبکه گزارش شده و تیم منتظر کمک توست. باید مسئلهٔ '+(lab.titleFa||lab.name)+' را بررسی و ارتباط را بازیابی کنی.';
    return `<div class="lab-hook"><p>⚡ ${$(text)}</p><button type="button" class="btn sm" disabled>بریم حلش کنیم!</button></div>`;
  }
