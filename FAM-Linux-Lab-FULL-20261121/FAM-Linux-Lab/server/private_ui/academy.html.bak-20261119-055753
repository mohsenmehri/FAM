      const dx=bx-ax,dy=by-ay,len=Math.hypot(dx,dy)||1,ox=-dy/len*offset,oy=dx/len*offset;
      const x1=ax+Math.sign(dx)*(Be/2-6)+ox,y1=ay+Math.sign(dy)*(At/2-4)+oy;
