function annotateGlossary(container){
 const walker=document.createTreeWalker(container,NodeFilter.SHOW_TEXT);
 const nodes=[];while(walker.nextNode()){const n=walker.currentNode,p=n.parentElement;if(p&&!p.closest('code,pre,button,a,script,style,textarea')&&/[A-Za-z0-9]/.test(n.nodeValue))nodes.push(n);}
 const terms=GLOSSARY_TERMS.map(x=>x[0]).sort((a,b)=>b.length-a.length);
 const escaped=terms.map(x=>x.split('.').join('\\.'));
 const re=new RegExp('(^|[^A-Za-z0-9])('+escaped.join('|')+')(?=$|[^A-Za-z0-9])','gi');
 for(const node of nodes){const raw=node.nodeValue;let last=0,m,frag=document.createDocumentFragment(),found=false;while((m=re.exec(raw))){const start=m.index+m[1].length,end=start+m[2].length,key=m[2].toLowerCase(),item=GLOSSARY_MAP.get(key);frag.append(document.createTextNode(raw.slice(last,start)));if(item){const b=document.createElement('button');b.type='button';b.className='glossary-term';b.textContent=raw.slice(start,end);b.setAttribute('aria-label','معنی '+item.term);b.addEventListener('click',()=>showGlossary(key));frag.append(b);found=true;}else frag.append(document.createTextNode(raw.slice(start,end)));last=end;}if(found){frag.append(document.createTextNode(raw.slice(last)));node.parentNode.replaceChild(frag,node);}re.lastIndex=0;}
}
