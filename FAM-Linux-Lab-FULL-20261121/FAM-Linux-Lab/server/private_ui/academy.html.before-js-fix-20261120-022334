async function boot(){
 try{
  const response=await fetch('/academy-assets/curriculum-catalog.json?v=academy-redesign-a1',{cache:'no-store'});
  if(!response.ok)throw new Error('Catalog HTTP '+response.status);
  state.catalog=await response.json();state.lessons=[];
  for(const p of state.catalog.paths||[])for(const c of p.courses||[])for(const l of c.lessons||[])state.lessons.push({...l,pathId:p.id,courseTitle:c.title});
  for(const l of state.lessons){if(state.lessonMap.has(l.id))throw new Error('شناسه تکراری درس: '+l.id);state.lessonMap.set(l.id,l)}
  for(const l of state.lessons)for(const p of l.prerequisites||[])if(!state.lessonMap.has(p))throw new Error('پیش‌نیاز نامعتبر: '+p);
  renderHome();
 }catch(err){root.innerHTML='<div class="panel"><span class="eyebrow">ACADEMY INITIALIZATION</span><h2>بارگذاری مسیرهای آموزشی ناموفق بود</h2><p style="color:var(--muted)">'+esc(err.message)+'</p><button class="action" onclick="location.reload()">تلاش دوباره</button></div>'}
}
boot();
})();
