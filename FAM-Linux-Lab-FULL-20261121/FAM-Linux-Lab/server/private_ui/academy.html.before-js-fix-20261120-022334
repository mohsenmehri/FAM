<script id="fam-academy-fam-bridge" nonce="__FAM_CSP_NONCE__">
window.FAM_ACADEMY_BOOTSTRAP = __FAM_ACADEMY_BOOTSTRAP__;
(() => {
  'use strict';
  const boot = window.FAM_ACADEMY_BOOTSTRAP || {};
  const csrf = boot.csrf || '';
  const stored = boot.progress || {};
  function readProgress() {
    if (Array.isArray(stored.completed)) return stored;
    for (const key of ['fam4.learn.v1', 'fam3.progress.v1']) {
      if (typeof stored[key] !== 'string') continue;
      try { const parsed = JSON.parse(stored[key]); if (parsed && typeof parsed === 'object' && Array.isArray(parsed.completed)) return parsed; } catch (_) {}
    }
    return { completed: [], labs: {}, selfAssessed: [], profile: {} };
  }
  window.FamAcademyBridge = {
    user: boot.user || null,
    progress: readProgress(),
    async saveProgress(payload) {
      const safe = {
        completed: Array.isArray(payload?.completed) ? payload.completed.filter(x => typeof x === 'string') : [],
        labs: payload?.labs && typeof payload.labs === 'object' && !Array.isArray(payload.labs) ? payload.labs : {},
        selfAssessed: Array.isArray(payload?.selfAssessed) ? payload.selfAssessed.filter(x => typeof x === 'string') : [],
        profile: payload?.profile && typeof payload.profile === 'object' && !Array.isArray(payload.profile) ? {
          level: ['beginner','intermediate','advanced'].includes(payload.profile.level) ? payload.profile.level : 'beginner',
          goal: ['CCNA','CCNP'].includes(payload.profile.goal) ? payload.profile.goal : 'CCNA',
          minutesPerDay: Number.isFinite(Number(payload.profile.minutesPerDay)) ? Number(payload.profile.minutesPerDay) : 45,
          daysPerWeek: Number.isFinite(Number(payload.profile.daysPerWeek)) ? Number(payload.profile.daysPerWeek) : 5
        } : undefined
      };
      try { localStorage.setItem('fam_academy_progress_v1', JSON.stringify(safe.completed)); } catch (_) {}
      try {
        const response = await fetch('/api/academy/progress', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json', 'X-FAM-CSRF': csrf },
          body: JSON.stringify({ changes: { 'fam4.learn.v1': JSON.stringify(safe) } })
        });
        if (!response.ok) return false;
        this.progress = safe;
        return true;
      } catch (_) { return false; }
    }
  };
})();
</script>
