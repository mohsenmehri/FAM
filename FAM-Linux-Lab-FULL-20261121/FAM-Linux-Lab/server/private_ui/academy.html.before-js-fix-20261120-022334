 const devices=t.devices,links=t.links||[],w=640,h=250;
 const pos=new Map();
 devices.forEach((d,i)=>{let x=Number(d.x),y=Number(d.y);if(!Number.isFinite(x)||!Number.isFinite(y)){x=60+(i%4)*170;y=50+Math.floor(i/4)*130}pos.set(d.id,{x:x+30,y:y+25})});
 const edges=links.map(link=>{
  const a=String(link.a||'').split(':')[0],b=String(link.b||'').split(':')[0],p1=pos.get(a),p2=pos.get(b);if(!p1||!p2)return '';
  return '<line class="link" x1="'+p1.x+'" y1="'+p1.y+'" x2="'+p2.x+'" y2="'+p2.y+'"/><text class="tag" x="'+((p1.x+p2.x)/2)+'" y="'+((p1.y+p2.y)/2-7)+'" text-anchor="middle">'+(link.vlan?'VLAN '+link.vlan:'')+'</text>';
 }).join('');
 const nodes=devices.map(d=>{
  const p=pos.get(d.id),pc=/pc|host/i.test(d.type||'');
  return '<g><rect class="'+(pc?'pc':'device')+'" x="'+(p.x-43)+'" y="'+(p.y-22)+'" width="86" height="44" rx="12"/><text class="devname" x="'+p.x+'" y="'+(p.y-2)+'" text-anchor="middle">'+esc(d.id)+'</text><text class="meta" x="'+p.x+'" y="'+(p.y+13)+'" text-anchor="middle">'+esc(d.port||d.role||d.type||'')+'</text>'+(d.ip?'<text class="meta" x="'+p.x+'" y="'+(p.y+37)+'" text-anchor="middle">'+esc(d.ip)+'</text>':'')+'</g>';
 }).join('');
 return '<div class="topology-wrap"><svg class="topology" viewBox="0 0 '+w+' '+h+'" role="img" aria-label="توپولوژی شبکه درس">'+edges+nodes+'</svg></div>';
