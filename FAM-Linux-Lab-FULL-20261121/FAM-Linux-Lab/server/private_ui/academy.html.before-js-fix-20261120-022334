  if(pathId==='ccna')return pathLessons('ccna');
  const needed=new Set();
  const visit=id=>{if(needed.has(id))return;needed.add(id);(state.lessonMap.get(id)?.prerequisites||[]).forEach(visit)};
  pathLessons('ccnp-enterprise').forEach(l=>visit(l.id));
  return state.lessons.filter(l=>needed.has(l.id));
}
function currentGoalLessons(){return requiredLessons(state.goal==='CCNA'?'ccna':'ccnp-enterprise')}
function goalName(id){return id==='CCNA'?'CCNA':'CCNP Enterprise'}
