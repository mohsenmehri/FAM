646 \u0645\u062C\u0627\u0632 \u0634\u0648\u062F\u060C \u0646\u0647 \u0627\u06CC\u0646\u06A9\u0647 \u0647\u0645\u0647 \u0633\u06CC\u06AF\u0646\u0627\u0644\u200C\u0647\u0627\u06CC \u0647\u0645\u0633\u0627\u06CC\u0647 \u0646\u0627\u062F\u06CC\u062F\u0647 \u06AF\u0631\u0641\u062A\u0647 \u0634\u0648\u0646\u062F. TWT \u0647\u0645 \u0628\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627\u06CC \u0628\u0627\u062A\u0631\u06CC\u200C\u062F\u0627\u0631 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0686\u0647 \u0632\u0645\u0627\u0646\u06CC \u0628\u06CC\u062F\u0627\u0631 \u0634\u0648\u0646\u062F.","\u0646\u06A9\u062A\u0647\u200C\u0627\u06CC \u06A9\u0647 \u062F\u0631 \u0639\u0645\u0644 \u0645\u0647\u0645 \u0627\u0633\u062A: \u0639\u0631\u0636 \u06A9\u0627\u0646\u0627\u0644 \u062F\u0631 \u06F6GHz \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u062A\u0641\u0627\u0648\u062A \u0628\u0627\u0634\u062F\u061B \u06A9\u0627\u0646\u0627\u0644 \u067E\u0647\u0646\u200C\u062A\u0631 \u0646\u0631\u062E \u0628\u0627\u0644\u0642\u0648\u0647 \u0628\u0627\u0644\u0627\u062A\u0631 \u0648\u0644\u06CC \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0646\u0627\u0644\u200C\u0647\u0627\u06CC \u063A\u06CC\u0631\u0647\u0645\u067E\u0648\u0634\u0627\u0646 \u06A9\u0645\u062A\u0631 \u0648 \u0627\u062D\u062A\u0645\u0627\u0644 \u062A\u062F\u0627\u062E\u0644 \u0647\u0645\u200C\u06A9\u0627\u0646\u0627\u0644 \u0628\u06CC\u0634\u062A\u0631\u06CC \u062F\u0627\u0631\u062F. \u0637\u0631\u0627\u062D\u06CC \u0628\u0647 \u0645\u0642\u0631\u0631\u0627\u062A \u0648 \u0645\u062D\u06CC\u0637 \u0628\u0633\u062A\u06AF\u06CC \u062F\u0627\u0631\u062F. PSC \u06CC\u0627 \xAB\u06A9\u0627\u0646\u0627\u0644\u200C\u0647\u0627\u06CC \u062A\u0631\u062C\u06CC\u062D\u06CC \u0627\u0633\u06A9\u0646\xBB \u0647\u0645 \u0628\u0627\u0639\u062B \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0644\u0627\u06CC\u0646\u062A \u06A9\u0644 \u06F5\u06F9 \u06A9\u0627\u0646\u0627\u0644 \u0631\u0627 \u0627\u0633\u06A9\u0646 \u0646\u06A9\u0646\u062F \u0648 \u0633\u0631\u06CC\u0639\u200C\u062A\u0631 AP \u067E\u06CC\u062F\u0627 \u06A9\u0646\u062F."],list:["PSC: \u06A9\u0627\u0646\u0627\u0644\u200C\u0647\u0627\u06CC \u062A\u0631\u062C\u06CC\u062D\u06CC \u0628\u0627 \u0641\u0627\u0635\u0644\u0647 \u06F8\u06F0 \u0645\u06AF\u0627\u0647\u0631\u062A\u0632\u061B \u062A\u0639\u062F\u0627\u062F \u0642\u0627\u0628\u0644 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0628\u0647 \u0637\u06CC\u0641 \u0645\u062C\u0627\u0632 \u0645\u0646\u0637\u0642\u0647 \u0628\u0633\u062A\u06AF\u06CC \u062F\u0627\u0631\u062F","OFDMA: \u062A\u0642\u0633\u06CC\u0645 \u06A9\u0627\u0646\u0627\u0644 \u0628\u0647 RU \u0628\u0631\u0627\u06CC \u0686\u0646\u062F \u06A9\u0627\u0631\u0628\u0631 \u0647\u0645\u200C\u0632\u0645\u0627\u0646","BSS Coloring: \u06A9\u0627\u0647\u0634 \u0627\u062B\u0631 \u062A\u062F\u0627\u062E\u0644 \u0647\u0645\u0633\u0627\u06CC\u0647","TWT: \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC \u0628\u06CC\u062F\u0627\u0631\u06CC \u0628\u0631\u0627\u06CC \u0635\u0631\u0641\u0647\u200C\u062C\u0648\u06CC\u06CC \u0628\u0627\u062A\u0631\u06CC"]},{h:"\u0627\u0645\u0646\u06CC\u062A: WPA3 \u0648 PMF",p:["\u062F\u0631 WPA3-Personal \u0628\u0647\u200C\u062C\u0627\u06CC PSK \u0627\u0632 SAE \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u062F\u0631 \u0628\u0631\u0627\u0628\u0631 \u062D\u062F\u0633 \u0622\u0641\u0644\u0627\u06CC\u0646 \u0631\u0645\u0632 \u0645\u0642\u0627\u0648\u0645 \u0627\u0633\u062A. \u0628\u0631\u0627\u06CC \u0633\u0627\u0632\u0645\u0627\u0646\u060C WPA3-Enterprise \u062D\u0627\u0644\u062A 192-bit \u062F\u0627\u0631\u06CC\u0645 \u06A9\u0647 \u0641\u0642\u0637 EAP-TLS \u0631\u0627 \u0645\u06CC\u200C\u067E\u0630\u06CC\u0631\u062F \u0648 \u0627\u0632 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645\u200C\u0647\u0627\u06CC Suite-B (GCMP-256 \u0648 SHA-384) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0645\u0647\u0645\u200C\u062A\u063