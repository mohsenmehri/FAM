+name: Academy browser and delivery tests
+
+on:
+  push:
+  pull_request:
+  workflow_dispatch:
+
+jobs:
+  academy:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '22'
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.11'
+      - run: python -m pip install -r FAM-Linux-Lab-vm-backup/FAM-Linux-Lab/server/requirements.txt
+      - run: npm install --no-save --no-package-lock playwright && npx playwright install --with-deps chromium
+      - run: python -m unittest discover -s FAM-Linux-Lab-vm-backup/FAM-Linux-Lab/tests -v
+      - run: python -m unittest discover -s manual-deployment/fam-academy-157682a/tests -v
+      - run: node tests/e2e/academy.spec.mjs
+      - run: node tests/e2e/academy-lessons.spec.mjs
+      - run: node tests/e2e/academy-flask.spec.mjs
+      - run: node tests/e2e/academy-library.spec.mjs
