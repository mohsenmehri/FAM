\u0645 \u0627\u0633\u062A\u061B AP \u0646\u0642\u0637\u0647 \u062F\u0633\u062A\u0631\u0633\u06CC \u0631\u0627\u062F\u06CC\u0648\u06CC\u06CC \u0648 WLC \u06A9\u0646\u062A\u0631\u0644\u200C\u06A9\u0646\u0646\u062F\u0647 \u062F\u0631 \u0645\u0639\u0645\u0627\u0631\u06CC \u0645\u062A\u0645\u0631\u06A9\u0632 \u0627\u0633\u062A. SSID \u0646\u0627\u0645 \u0634\u0628\u06A9\u0647\u200C\u0627\u06CC \u0627\u0633\u062A \u06A9\u0647 \u06A9\u0627\u0631\u0628\u0631 \u0645\u06CC\u200C\u0628\u06CC\u0646\u062F \u0648 BSSID \u0647\u0648\u06CC\u062A \u0631\u0627\u062F\u06CC\u0648\u06CC\u06CC \u06CC\u06A9 \u0633\u0644\u0648\u0644 \u0627\u0633\u062A. \u0645\u0639\u0645\u0627\u0631\u06CC \u0645\u0633\u062A\u0642\u0644 \u0646\u06CC\u0632 \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F\u061B CAPWAP \u062F\u0631 \u0637\u0631\u062D \u06A9\u0646\u062A\u0631\u0644\u200C\u0634\u062F\u0647 \u0628\u0631\u0627\u06CC \u0627\u0631\u062A\u0628\u0627\u0637 AP \u0648 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0628\u0647\u200C\u06A9\u0627\u0631 \u0645\u06CC\u200C\u0631\u0648\u062F.","\u067E\u06CC\u0634 \u0627\u0632 \u0648\u0631\u0648\u062F\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A \u0628\u0627\u06CC\u062F \u0634\u0628\u06A9\u0647 \u0631\u0627 \u067E\u06CC\u062F\u0627 \u0648 association \u0628\u0631\u0642\u0631\u0627\u0631 \u06A9\u0646\u062F\u061B \u0633\u067E\u0633 \u0628\u0633\u062A\u0647 \u0628\u0647 \u0631\u0648\u0634 \u0627\u0645\u0646\u06CC\u062A\u06CC \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0648 \u062A\u0628\u0627\u062F\u0644 \u06A9\u0644\u06CC\u062F \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u0639\u062F \u0622\u062F\u0631\u0633 IP \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u062F\u0631 WPA3-Personal \u0627\u0632 SAE \u0648 \u062F\u0631 \u0634\u0628\u06A9\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06CC \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0627\u0632 802.1X \u0648 \u0633\u0631\u0648\u0631 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0634\u0648\u062F. PMF \u0627\u0632 \u0628\u0631\u062E\u06CC \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0646\u0647 \u0647\u0645\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u06CC\u200C\u0633\u06CC\u0645.","\u0645\u0634\u06A9\u0644 \u0631\u0627 \u0628\u0647 \u06A9\u0634\u0641 \u0631\u0627\u062F\u06CC\u0648\u06CC\u06CC\u060C association\u060C authentication\u060C DHCP \u0648 \u062F\u0633\u062A\u0631\u0633\u06CC IP \u062A\u0641\u06A9\u06CC\u06A9 \u06A9\u0646. \u0633\u0637\u062D \u0633\u06CC\u06AF\u0646\u0627\u0644\u060C \u062A\u062F\u0627\u062E\u0644\u060C \u062A\u0646\u0638\u06CC\u0645 \u06A9\u0627\u0646\u0627\u0644\u060C \u0633\u0627\u0632\u06AF\u0627\u0631\u06CC \u0627\u0645\u0646\u06CC\u062A\u06CC\u060C VLAN \u0648 \u0631\u062E\u062F\u0627\u062F\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644\u0631 \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. \u062A\u0641\u0627\u0648\u062A \u0648\u06CC\u0698\u06AF\u06CC\u200C\u0647\u0627\u06CC \u0628\u0627\u0646\u062F \u0634\u0634 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0631\u0627 \u062F\u0631 [[wifi6e|Wi-Fi 6E]] \u0648 \u062A\u0623\u062B\u06CC\u0631 \u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u0631\u0627 \u062F\u0631 [[qos|QoS]] \u0628\u062E\u0648\u0627\u0646."],automation:["\u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u06CC\u0639\u0646\u06CC \u062A\u0639\u0631\u06CC\u0641 \u062A\u06A9\u0631\u0627\u0631\u067E\u0630\u06CC\u0631 \u0648\u0636\u0639\u06CC\u062A \u0645\u0637\u0644\u0648\u0628 \u0648 \u0627\u062C\u0631\u0627\u06CC \u0642\u0627\u0628\u0644 \u0628\u0627\u0632\u0628\u06CC\u0646\u06CC \u062A\u063A\u06CC\u06CC\u0631\u060C \u0646\u0647 \u0635\u0631\u0641\u0627\u064B \u0627\u062C\u0631\u0627\u06CC \u0633\u0631\u06CC\u0639 \u0686\u0646\u062F \u062F\u0633\u062A\u0648\u0631. API \u0631\u0627\u0628\u0637 \u0628\u0631\u0646\u0627\u0645\u0647\u200C\u0646\u0648\u06CC\u0633\u06CC\u060C JSON \u0642\u0627\u0644\u0628 \u062F\u0627\u062F\u0647 \u0648 idempotency \u062E\u0627\u0635\u06CC\u062A\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062A\u06A9\u0631\u0627\u0631 \u0639\u0645\u0644\u06CC\u0627\u062A \u0631\u0627 \u0628\u062F\u0648\u0646 \u062A\u063A\u06CC\u06CC\u0631 \u0627\u0636\u0627\u0641\u06CC \u067E\u0633 \u0627\u0632 \u0631\u0633\u06CC\u062F\u0646 \u0628\u0647 \u0648\u0636\u0639\u06CC\u062A \u0645\u0637\u0644\u0648\u0628 \u0645\u0645\u06A9\u0646 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0647\u0645\u0647 \u062F\u0631\u062E\u0648\u0627\u0633\u062A\u200C\u0647\u0627\u06CC API \u0630\u0627\u062A\u0627\u064B idempotent \u0646\u06CC\u0633\u062A\u0646\u062F.","\u06CC\u06A9 \u06AF\u0631\u062F\u0634 \u06A9\u0627\u0631 \u0627\u0645\u0646: \u0645\u0648\u062C\u0648\u062F\u06CC \u062F\u0633\u062A\u06AF\u0627\u0647 \u0648 \u0646\u0633\u062E\u0647 API \u0631\u0627 \u0628\u062E\u0648\u0627\u0646\u060C \u0637\u0631\u062D \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0627 \u062A\u0648\u0644\u06CC\u062F \u06A9\u0646\u060C \u0622\u0646 \u0631\u0627 \u0628\u0631\u0627\u06CC \u0628\u0627\u0632\u0628\u06CC\u0646\u06CC \u0648 \u0622\u0632\u0645\u0627\u06CC\u0634 \u062F\u0631 \u0645\u062D\u06CC\u0637 \u0645\u062D\u062F\u0648\u062F \u0627\u0631\u0627\u0626\u0647 \u0628\u062F\u0647\u060C \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0627 \u0627\u0639\u0645\u0627\u0644 \u0648 \u0648\u0636\u0639\u06CC\u062A \u0648\u0627\u0642\u0639\u06CC \u0631\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0628\u062E\u0648\u0627\u0646. \u062E\u0637\u0627\u06CC \u0628\u062E\u0634\u06CC \u0631\u0627 \u062B\u0628\u062A \u06A9\u0646 \u0648 \u0628\u0627\u0632\u06AF\u0634\u062A \u06CC\u0627 \u062C\u0628\u0631\u0627\u0646 \u0627\u0632 \u067E\u06CC\u0634 \u0637\u0631\u0627\u062D\u06CC \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634. \u0627\u0632 \u0642\u0631\u0627\u0631 \u062F\u0627\u062F\u0646 \u06AF\u0630\u0631\u0648\u0627\u0698\u0647 \u062F\u0631 \u06A9\u062F \u0648 \u063A\u06CC\u0631\u0641\u0639\u0627\u0644\u200C\u06A9\u0631\u062F\u0646 \u062F\u0627\u0626\u0645\u06CC \u0627\u0639\u062A\u0628\u0627\u0631\u0633\u0646\u062C\u06CC TLS \u0628\u067E\u0631\u0647\u06CC\u0632.","\u0645\u0648\u0641\u0642 \u0628\u0648\u062F\u0646 HTTP 200 \u0644\u0632\u0648\u0645\u0627\u064B \u0627\u0646\u062C\u0627\u0645 \u06A9\u0627\u0645\u0644 \u06A9\u0627\u0631 \u0646\u0627\u0647\u0645\u06AF\u0627\u0645 \u062F\u0631 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0631\u0627 \u0627\u062B\u0628\u0627\u062A \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F\u061B task \u0648 \u0646\u062A\u06CC\u062C\u0647 \u0646\u0647\u0627\u06CC\u06CC \u0648 \u0648\u0636\u0639\u06CC\u062A \u062F\u0633\u062A\u06AF\u0627\u0647 \u0631\u0627 \u0646\u06CC\u0632 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. timeout\u060C retry \u0628\u0627 \u0627\u062D\u062A\u06CC\u0627\u0637\u060C \u0644\u0627\u06AF \u0648 \u06A9\u0646\u062A\u0631\u0644 \u062F\u0633\u062A\u0631\u0633\u06CC \u0631\u0627 \u062F\u0631 \u0646\u0638\u0631 \u0628\u06AF\u06CC\u0631. \u062A\u0641\u0627\u0648\u062A \u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u062F\u0644\u200C\u0645\u062D\u0648\u0631 \u0628\u0627 NETCONF \u0648 RESTCONF \u062F\u0631 [[netconf-yang|NETCONF/YANG]] \u0648 \u0646\u0645\u0648\u0646\u0647 \u06A9\u0646\u062A\u0631\u0644\u0631 \u062F\u0631 [[catalyst-center|Catalyst Center]] \u062A\u0648\u0636\u06CC\u062D \u062F\u0627\u062F\u0647 \u0634\u062F\u0647 \u0627\u0633\u062A."],troubleshooting:["\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0641\u0631\u0622\u06CC\u0646\u062F\u06CC \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 \u0634\u0648\u0627\u0647\u062F \u0627\u0633\u062A: \u0645\u062D\u062F\u0648\u062F\u0647 \u0645\u0634\u06A9\u0644 \u0648 \u0632\u0645\u0627\u0646 \u0634\u0631\u0648\u0639 \u0631\u0627 \u0645\u0634\u062E\u0635 \u06A9\u0646\u060C \u0648\u0636\u0639\u06CC\u062A \u0633\u0627\u0644\u0645 \u0631\u0627 \u0628\u0634\u0646\u0627\u0633\u060C \u0641\u0631\u0636\u06CC\u0647 \u0628\u0633\u0627\u0632\u060C \u0622\u0632\u0645\u0627\u06CC\u0634 \u06A9\u0645\u200C\u062E\u0637\u0631 \u0627\u0646\u062C\u0627\u0645 \u0628\u062F\u0647 \u0648 \u0646\u062A\u06CC\u062C\u0647 \u0631\u0627 \u0628\u0627 \u0641\u0631\u0636\u06CC\u0647 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646. \u0645\u062F\u0644 OSI \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062A\u0631\u062A\u06CC\u0628 \u0628\u0631\u0631\u0633\u06CC \u0631\u0627 \u0633\u0627\u0632\u0645\u0627\u0646 \u0628\u062F\u0647\u062F\u060C \u0627\u0645\u0627 \u0647\u0645\u06CC\u0634\u0647 \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A \u0647\u0645\u0647 \u0644\u0627\u06CC\u0647\u200C\u0647\u0627 \u0631\u0627 \u0627\u0632 \u067E\u0627\u06CC\u06CC\u0646 \u062A\u0627 \u0628\u0627\u0644\u0627 \u0628\u0647\u200C\u062A\u0631\u062A\u06CC\u0628 \u0637\u06CC \u06A9\u0646\u06CC.","\u0645\u062B\u0627\u0644: \u0627\u06AF\u0631 \u06CC\u06A9 \u06A9\u0627\u0631\u0628\u0631 \u0628\u0647 \u062F\u0631\u0648\u0627\u0632\u0647 ping \u0645\u06CC\u200C\u0632\u0646\u062F \u0648\u0644\u06CC \u0628\u0647 \u0633\u0631\u0648\u06CC\u0633 \u062F\u0648\u0631\u062F\u0633\u062A \u0646\u0645\u06CC\u200C\u0631\u0633\u062F\u060C \u0633\u0644\u0627\u0645\u062A \u0646\u0633\u0628\u06CC \u0628\u062E\u0634 \u0645\u062D\u0644\u06CC \u0631\u0627 \u0645\u06CC\u200C\u0628\u06CC\u0646\u06CC \u0646\u0647 \u0633\u0644\u0627\u0645\u062A \u06A9\u0627\u0645\u0644 \u0634\u0628\u06A9\u0647. DNS\u060C \u0645\u0633\u06CC\u0631 \u0631\u0641\u062A \u0648 \u0628\u0631\u06AF\u0634\u062A\u060C ACL\u060C \u067E\u0648\u0631\u062A \u06A9\u0627\u0631\u0628\u0631\u062F \u0648 \u0648\u0636\u0639\u06CC\u062A \u0633\u0631\u0648\u0631 \u0631\u0627 \u062C\u062F\u0627 \u0622\u0632\u0645\u0627\u06CC\u0634 \u06A9\u0646\u061B \u0627\u0632 \u0647\u0645\u0627\u0646 \u0645\u0628\u062F\u0623 \u0648 \u0647\u0645\u0627\u0646 \u0646\u0648\u0639 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u0634\u06A9\u0644\u200C\u062F\u0627\u0631 \u0627\u0646\u062F\u0627\u0632\u0647\u200C\u06AF\u06CC\u0631\u06CC \u06A9\u0646.","\u0628\u0631\u0627\u06CC \u0647\u0631 \u062A\u063A\u06CC\u06CC\u0631\u060C \u0642\u0628\u0644 \u0648 \u0628\u0639\u062F \u0622\u0646 \u0631\u0627 \u062B\u0628\u062A \u06A9\u0646 \u0648 \u06CC\u06A9 \u0645\u062A\u063A\u06CC\u0631 \u0631\u0627 \u062F\u0631 \u0647\u0631 \u0622\u0632\u0645\u0627\u06CC\u0634 \u062A\u063A\u06CC\u06CC\u0631 \u0628\u062F\u0647. ping \u0635\u0631\u0641\u0627\u064B \u0631\u0633\u06CC\u062F\u0646 \u067E\u0627\u0633\u062E ICMP \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u062F\u0631 \u0645\u0633\u06CC\u0631 \u0641\u06CC\u0644\u062A\u0631 \u0634\u0648\u062F\u061B traceroute \u0646\u06CC\u0632 \u0628\u0633\u062A\u0647 \u0628\u0647 \u0631\u0648\u0634 \u0648 \u0633\u06CC\u0627\u0633\u062A \u06A9\u0627\u0645\u0644 \u0646\u06CC\u0633\u062A. \u0646\u062A\u0627\u06CC\u062C \u0631\u0627 \u0628\u0627 [[acl|ACL]]\u060C [[static-routing|\u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631]] \u0648 [[dhcp|DHCP]] \u0645\u0631\u062A\u0628\u0637 \u06A9\u0646."],redistribution:["Redistribution \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u0627\u0646\u062A\u062E\u0627\u0628\u200C\u0634\u062F\u0647 \u0627\u0632 \u06CC\u06A9 \u0645\u0646\u0628\u0639 \u0631\u0627 \u062F\u0631 \u067E\u0631\u0648\u062A\u06A9\u0644 \u0645\u0642\u0635\u062F \u0628\u0627\u0632\u0627\u0639\u0644\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0645\u062A\u0631\u06CC\u06A9\u200C\u0647\u0627\u06CC \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627 \u0645\u0633\u062A\u0642\u06CC\u0645\u0627\u064B \u0642\u0627\u0628\u0644 \u0645\u0642\u0627\u06CC\u0633\u0647 \u0646\u06CC\u0633\u062A\u0646\u062F. Seed Metric \u0645\u0642\u062F\u0627\u0631 \u0622\u063A\u0627\u0632\u06CC\u0646 \u062F\u0631 \u062F\u0627\u0645\u0646\u0647 \u0645\u0642\u0635\u062F \u0627\u0633\u062A. \u0628\u0631\u0627\u06CC EIGRP \u0648 RIP \u062F\u0631 \u0628\u0633\u06CC\u0627\u0631\u06CC \u0627\u0632 \u062A\u0628\u062F\u06CC\u0644\u200C\u0647\u0627 \u0628\u0627\u06CC\u062F \u0645\u062A\u0631\u06CC\u06A9 \u0645\u0646\u0627\u0633\u0628 \u0645\u0634\u062E\u0635 \u0634\u0648\u062F\u061B \u0627\u0633\u062A\u062B\u0646\u0627\u0647\u0627 \u0648 \u0631\u0641\u062A\u0627\u0631 \u062F\u0642\u06CC\u0642 \u0628\u0647 \u0645\u0628\u062F\u0623 \u0648 \u067E\u0644\u062A\u0641\u0631\u0645 \u0648\u0627\u0628\u0633\u062A\u0647\u200C\u0627\u0646\u062F.","\u0628\u0631\u0627\u06CC OSPF \u0645\u0642\u0635\u062F\u060C \u0645\u062A\u0631\u06CC\u06A9 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0645\u0633\u06CC\u0631 \u062E\u0627\u0631\u062C\u06CC \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u06F2\u06F0 \u0627\u0633\u062A \u0648 \u0628\u0631\u0627\u06CC \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC BGP \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u06F1\u061B \u0646\u0648\u0639 \u062E\u0627\u0631\u062C\u06CC \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 E2 \u0627\u0633\u062A. \u062F\u0631 \u0686\u0646\u062F \u0646\u0642\u0637\u0647 \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u062F\u0648\u0637\u0631\u0641\u0647\u060C \u0645\u0633\u06CC\u0631 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0632 \u0645\u0631\u0632 \u062F\u06CC\u06AF\u0631\u06CC \u0628\u0627\u0632\u06AF\u0631\u062F\u062F \u0648 \u0628\u0647 \u062F\u0644\u06CC\u0644 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0633\u06CC\u0631 \u0646\u0627\u0645\u0646\u0627\u0633\u0628 \u062D\u0644\u0642\u0647 \u06CC\u0627 black hole \u0628\u0633\u0627\u0632\u062F. route tag \u0648 \u0641\u06CC\u0644\u062A\u0631 \u0631\u0641\u062A\u200C\u0648\u0628\u0631\u06AF\u0634\u062A \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0637\u0631\u062D \u062F\u0642\u06CC\u0642 \u0645\u0633\u06CC\u0631\u0647\u0627 \u0627\u06CC\u0646 \u0631\u06CC\u0633\u06A9 \u0631\u0627 \u06A9\u0627\u0647\u0634 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F.","\u0627\u0648\u0644 \u062D\u0636\u0648\u0631 \u0645\u0633\u06CC\u0631 \u0645\u0628\u062F\u0623 \u062F\u0631 RIB \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u060C \u0633\u067E\u0633 \u062A\u0637\u0627\u0628\u0642 prefix-list \u0648 route-map\u060C seed metric\u060C \u0646\u0648\u0639 LSA \u06CC\u0627 \u0645\u0633\u06CC\u0631 \u062E\u0627\u0631\u062C\u06CC \u0648 \u0648\u0636\u0639\u06CC\u062A \u0647\u0645\u0633\u0627\u06CC\u0647 \u0645\u0642\u0635\u062F \u0631\u0627 \u0628\u0628\u06CC\u0646. \u062F\u0631 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0628\u0647 \u0647\u0631 \u062F\u0648 \u062C\u0647\u062A \u0648 Administrative Distance \u0646\u06AF\u0627\u0647 \u06A9\u0646. \u067E\u06CC\u0634 \u0627\u0632 \u062A\u063A\u06CC\u06CC\u0631 \u0639\u0645\u0644\u06CC\u0627\u062A\u06CC\u060C [[ospf-multi|LSA\u0647\u0627\u06CC OSPF]] \u0648 [[eigrp|\u0645\u062A\u0631\u06CC\u06A9 EIGRP]] \u0631\u0627 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646."],pbr:["Policy-Based Routing \u06CC\u0627 PBR \u0628\u0647 \u0631\u0648\u062A\u0631 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u0628\u0631\u0627\u06CC \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0645\u0646\u0637\u0628\u0642 \u0628\u0631 \u0633\u06CC\u0627\u0633\u062A\u060C \u062A\u0635\u0645\u06CC\u0645\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0632 lookup \u0639\u0627\u062F\u06CC \u0645\u0642\u0635\u062F \u0628\u06AF\u06CC\u0631\u062F. route-map \u062A\u0631\u062A\u06CC\u0628 \u0634\u0631\u0637 match \u0648 \u0639\u0645\u0644 set \u0631\u0627 \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0633\u06CC\u0627\u0633\u062A \u0627\u0639\u0645\u0627\u0644\u200C\u0634\u062F\u0647 \u0648\u0631\u0648\u062F\u06CC \u0628\u0631 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0639\u0628\u0648\u0631\u06CC \u0622\u0646 \u0631\u0627\u0628\u0637 \u0627\u062B\u0631 \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F\u061B \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062A\u0648\u0644\u06CC\u062F\u0634\u062F\u0647 \u062A\u0648\u0633\u0637 \u062E\u0648\u062F \u0631\u0648\u062A\u0631 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0628\u0647 local policy \u062C\u062F\u0627\u06AF\u0627\u0646\u0647 \u0646\u06CC\u0627\u0632 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F.","\u0641\u0631\u0636 \u06A9\u0646 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u06CC\u06A9 subnet \u0622\u0632\u0645\u0627\u06CC\u0634\u06CC \u0628\u0627\u06CC\u062F \u0627\u0632 \u0645\u0633\u06CC\u0631 WAN بانک \u062F\u0648\u0645 \u0628\u0631\u0648\u062F \u0648\u0644\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u06CC\u06AF\u0631 \u0627\u0632 \u062C\u062F\u0648\u0644 \u0639\u0627\u062F\u06CC \u067E\u06CC\u0631\u0648\u06CC \u06A9\u0646\u062F. ACL \u0645\u0648\u0631\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0628\u0631\u0627\u06CC match \u0646\u0642\u0634 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u062F\u0627\u0631\u062F\u060C \u0646\u0647 \u0627\u06CC\u0646\u06A9\u0647 \u0644\u0632\u0648\u0645\u0627\u064B \u0628\u0633\u062A\u0647 \u0631\u0627 \u0645\u0627\u0646\u0646\u062F ACL \u0641\u06CC\u0644\u062A\u0631 \u0631\u0627\u0628\u0637 drop \u06A9\u0646\u062F. \u062A\u0641\u0627\u0648\u062A set ip next-hop \u0628\u0627 default next-hop \u0648 \u0631\u0641\u062A\u0627\u0631 \u0634\u06A9\u0633\u062A next-hop \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0646\u0633\u062E\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0648 \u0642\u0627\u0628\u0644\u06CC\u062A verify-availability \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646.","\u0627\u0632 show route-map \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647\u200C\u0647\u0627\u06CC \u067E\u0644\u062A\u0641\u0631\u0645 \u0628\u0631\u0627\u06CC \u062A\u0637\u0628\u06CC\u0642\u060C \u0648 \u0627\u0632 traceroute \u06CC\u0627 \u0622\u0632\u0645\u0648\u0646 \u062C\u0631\u06CC\u0627\u0646 \u0648\u0627\u0642\u0639\u06CC \u062F\u0631 \u0647\u0631 \u062F\u0648 \u062C\u0647\u062A \u0628\u0631\u0627\u06CC \u0646\u062A\u06CC\u062C\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646. \u0645\u0633\u06CC\u0631 \u0628\u0631\u06AF\u0634\u062A\u060C NAT \u0648 \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 stateful \u0631\u0627 \u0646\u0627\u062F\u06CC\u062F\u0647 \u0646\u06AF\u06CC\u0631: \u0631\u0641\u062A \u0648 \u0628\u0631\u06AF\u0634\u062A \u0646\u0627\u0645\u062A\u0642\u0627\u0631\u0646 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0627\u0631\u062A\u0628\u0627\u0637 \u0631\u0627 \u0628\u0634\u06A9\u0646\u062F. [[acl|ACL]] \u0648 [[static-routing|\u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0633\u06CC\u0631]] \u067E\u06CC\u0634\u200C\u0646\u06CC\u0627\u0632 \u0627\u06CC\u0646 \u062A\u062D\u0644\u06CC\u0644\u200C\u0627\u0646\u062F."],"bgp-advanced":["\u0633\u06CC\u0627\u0633\u062A BGP \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u062F\u0627\u0645 prefix \u067E\u0630\u06CC\u0631\u0641\u062A\u0647 \u06CC\u0627 \u0627\u0639\u0644\u0627\u0645 \u0634\u0648\u062F \u0648 \u0628\u0627 \u0686\u0647 \u0648\u06CC\u0698\u06AF\u06CC\u200C\u0647\u0627\u06CC\u06CC \u0645\u0642\u0627\u06CC\u0633\u0647 \u0634\u0648\u062F. Prefix-list \u0628\u0631 \u0645\u0628\u0646\u0627\u06CC prefix \u0648 \u0637\u0648\u0644 \u0622\u0646 \u0641\u06CC\u0644\u062A\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B route-map \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0634\u0631\u0637\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0648\u06CC\u0698\u06AF\u06CC\u200C\u0647\u0627 \u0631\u0627 \u062A\u0631\u06A9\u06CC\u0628 \u06A9\u0646\u062F. Community \u0628\u0631\u0686\u0633\u0628\u06CC \u0628\u0631\u0627\u06CC \u062F\u0633\u062A\u0647\u200C\u0628\u0646\u062F\u06CC \u0648 \u0627\u0646\u062A\u0642\u0627\u0644 \u0633\u06CC\u0627\u0633\u062A \u0627\u0633\u062A\u060C \u0646\u0647 \u0631\u0645\u0632\u06AF\u0630\u0627\u0631\u06CC \u06CC\u0627 \u062A\u0636\u0645\u06CC\u0646 \u0645\u0646\u0634\u0623 \u0645\u0633\u06CC\u0631.","\u0627\u06AF\u0631 \u06CC\u06A9 \u0633\u0627\u0632\u0645\u0627\u0646 \u0628\u062E\u0648\u0627\u0647\u062F \u062E\u0631\u0648\u062C \u0627\u0632 \u0644\u06CC\u0646\u06A9 \u0627\u0635\u0644\u06CC \u0631\u0627 \u062A\u0631\u062C\u06CC\u062D \u062F\u0647\u062F\u060C \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A Local Preference \u0628\u0627\u0644\u0627\u062A\u0631 \u0631\u0627 \u0628\u0631\u0627\u06CC \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u062F\u0631\u06CC\u0627\u0641\u062A\u06CC \u0622\u0646 \u0644\u06CC\u0646\u06A9 \u062F\u0631 AS \u062E\u0648\u062F \u062A\u0646\u0638\u06CC\u0645 \u06A9\u0646\u062F. \u0628\u0631\u0627\u06CC \u0627\u062B\u0631\u06AF\u0630\u0627\u0631\u06CC \u0628\u0631 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0648\u0631\u0648\u062F\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0627\u0632 \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0645\u0627\u0646\u0646\u062F AS-path prepend \u06CC\u0627 community \u0627\u0631\u0627\u0626\u0647\u200C\u062F\u0647\u0646\u062F\u0647 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0631\u062F\u060C \u0648\u0644\u06CC \u062A\u0635\u0645\u06CC\u0645 \u0646\u0647\u0627\u06CC\u06CC \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0628\u06CC\u0631\u0648\u0646\u06CC \u062A\u0636\u0645\u06CC\u0646\u200C\u0634\u062F\u0647 \u0646\u06CC\u0633\u062A.","\u0627\u0628\u062A\u062F\u0627 \u0646\u0634\u0633\u062A\u060C \u0633\u067E\u0633 \u0641\u06CC\u0644\u062A\u0631\u0647\u0627\u06CC \u0648\u0631\u0648\u062F \u0648 \u062E\u0631\u0648\u062C\u060C next-hop\u060C \u0628\u0647\u062A\u0631\u06CC\u0646 \u0645\u0633\u06CC\u0631 \u0648 \u0646\u0635\u0628 \u062F\u0631 RIB \u0631\u0627 \u062C\u062F\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. maximum-prefix \u0627\u0632 \u062F\u0631\u06CC\u0627\u0641\u062A \u0628\u06CC\u0634 \u0627\u0632 \u062D\u062F \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0627\u0645\u0627 \u062C\u0627\u06CC \u0641\u06CC\u0644\u062A\u0631 \u0645\u062C\u0627\u0632 prefix \u0631\u0627 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. RPKI origin validation \u0628\u0647 \u0627\u0639\u062A\u0628\u0627\u0631\u0633\u0646\u062C\u06CC AS \u0645\u0628\u062F\u0623 \u0645\u0631\u0628\u0648\u0637 \u0627\u0633\u062A \u0648 \u0647\u0645\u0647 \u062A\u0647\u062F\u06CC\u062F\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631 \u0631\u0627 \u062D\u0644 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F\u061B [[bgp|\u0645\u0628\u0627\u0646\u06CC BGP]] \u0648 [[sp-evpn|EVPN]] \u0631\u0627 \u0628\u0628\u06CC\u0646."],"vxlan-evpn":["VXLAN \u0634\u0628\u06A9\u0647 \u0644\u0627\u06CC\u0647 \u06F2 \u0645\u0646\u0637\u0642\u06CC \u0631\u0627 \u0631\u0648\u06CC \u0632\u06CC\u0631\u0633\u0627\u062E\u062A IP \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. VTEP \u0646\u0642\u0637\u0647 \u0627\u0646\u062A\u0647\u0627\u06CC\u06CC \u06A9\u067E\u0633\u0648\u0644\u0647\u200C\u0633\u0627\u0632\u06CC \u0627\u0633\u062A \u0648 VNI \u0634\u0646\u0627\u0633\u0647 \u06F2\u06F4 \u0628\u06CC\u062A\u06CC \u0628\u062E\u0634 \u0645\u062C\u0627\u0632\u06CC \u0631\u0627 \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u062F. Underlay \u0634\u0628\u06A9\u0647 IP \u062D\u0627\u0645\u0644 \u0648 overlay \u0634\u0628\u06A9\u0647 \u0645\u062C\u0627\u0632\u06CC \u0631\u0648\u06CC \u0622\u0646 \u0627\u0633\u062A\u061B \u067E\u0627\u06CC\u062F\u0627\u0631\u06CC overlay \u0628\u062F\u0648\u0646 \u062F\u0633\u062A\u0631\u0633\u06CC underlay \u0627\u0645\u06A9\u0627\u0646\u200C\u067E\u0630\u06CC\u0631 \u0646\u06CC\u0633\u062A.","\u062F\u0631 \u0627\u0631\u0633\u0627\u0644 \u0628\u06CC\u0646 \u062F\u0648 \u0645\u06CC\u0632\u0628\u0627\u0646\u060C VTEP \u0645\u0628\u062F\u0623 \u0641\u0631\u06CC\u0645 \u062F\u0627\u062E\u0644\u06CC \u0631\u0627 \u0628\u0627 \u0647\u062F\u0631 VXLAN\u060C UDP \u0648 IP \u0628\u06CC\u0631\u0648\u0646\u06CC \u0628\u0647 VTEP \u0645\u0642\u0635\u062F \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F. EVPN \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0637\u0644\u0627\u0639\u0627\u062A MAC/IP \u0631\u0627\u0647 \u062F\u0648\u0631 \u0631\u0627 \u0628\u0627 BGP \u0645\u0646\u062A\u0634\u0631 \u06A9\u0646\u062F\u061B MAC \u0645\u062D\u0644\u06CC \u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u062F\u0631 \u0635\u0641\u062D\u0647 \u062F\u0627\u062F\u0647 \u0622\u0645\u0648\u062E\u062A\u0647 \u0634\u0648\u062F \u0648 broadcast\u060C unknown unicast \u0648 multicast \u0628\u0647 \u0631\u0627\u0647\u06A9\u0627\u0631 \u062A\u06A9\u062B\u06CC\u0631 \u0645\u0646\u0627\u0633\u0628 \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u0646\u062F.","\u0627\u0628\u062A\u062F\u0627 reachability \u0648 MTU \u0645\u0633\u06CC\u0631 VTEP\u0647\u0627 \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u061B encapsulation \u0633\u0631\u0628\u0627\u0631 \u062F\u0627\u0631\u062F \u0648 MTU \u0646\u0627\u06A9\u0627\u0641\u06CC \u0628\u0627\u0639\u062B \u0627\u0641\u062A \u0628\u0633\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0633\u067E\u0633 VNI\u060C \u0639\u0636\u0648\u06CC\u062A bridge domain\u060C peer\u0647\u0627 \u0648 route\u0647\u0627\u06CC EVPN \u0648 RT \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. [[sp-evpn|EVPN \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u06CC]] \u0628\u0631\u0627\u06CC \u0646\u0642\u0634 route type\u0647\u0627 \u0648 [[vlan-trunk|VLAN]] \u0628\u0631\u0627\u06CC \u062F\u0627\u0645\u0646\u0647 \u0645\u062D\u0644\u06CC \u0645\u0641\u06CC\u062F \u0627\u0633\u062A."],sdwan:["SD-WAN \u0645\u062F\u06CC\u0631\u06CC\u062A \u0648 \u0633\u06CC\u0627\u0633\u062A WAN \u0631\u0627 \u0627\u0632 \u062A\u062C\u0647\u06CC\u0632\u0627\u062A \u067E\u0631\u0627\u06A9\u0646\u062F\u0647 \u0628\u0647 \u0645\u0639\u0645\u0627\u0631\u06CC \u06A9\u0646\u062A\u0631\u0644 \u0645\u062A\u0645\u0631\u06A9\u0632 \u0646\u0632\u062F\u06CC\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u06A9\u0646\u062A\u0631\u0644\u0631 \u0645\u062F\u06CC\u0631\u06CC\u062A \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC\u060C \u06A9\u0646\u062A\u0631\u0644\u0631 \u0645\u0633\u06CC\u0631 \u0648 orchestrator \u0646\u0642\u0634\u200C\u0647\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A\u06CC \u062F\u0627\u0631\u0646\u062F\u061B \u0646\u0627\u0645 \u0645\u062D\u0635\u0648\u0644\u0627\u062A \u0648 \u0627\u0645\u06A9\u0627\u0646\u0627\u062A \u0628\u0627 \u0646\u0633\u062E\u0647 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. Underlay \u062F\u0633\u062A\u0631\u0633\u06CC \u0627\u0646\u062A\u0642\u0627\u0644\u06CC \u0645\u0627\u0646\u0646\u062F MPLS \u06CC\u0627 WAN بانک \u0648 overlay \u0627\u0631\u062A\u0628\u0627\u0637 \u0645\u0646\u0637\u0642\u06CC \u0627\u0645\u0646 \u0631\u0648\u06CC \u0622\u0646 \u0627\u0633\u062A.","\u062F\u0631 \u0648\u0631\u0648\u062F \u062F\u0633\u062A\u06AF\u0627\u0647 \u062C\u062F\u06CC\u062F\u060C \u0647\u0648\u06CC\u062A \u0648 \u0645\u062C\u0648\u0632 \u0622\u0646 \u0628\u0627\u06CC\u062F \u062A\u0623\u06CC\u06CC\u062F \u0648 \u0633\u067E\u0633 \u0627\u0631\u062A\u0628\u0627\u0637\u200C\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644\u06CC \u0628\u0631\u0642\u0631\u0627\u0631 \u0634\u0648\u062F. OMP \u0645\u0633\u06CC\u0631 \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062A\u06CC \u0645\u0627\u0646\u0646\u062F TLOC \u0631\u0627 \u0628\u06CC\u0646 \u0627\u062C\u0632\u0627 \u062A\u0648\u0632\u06CC\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B TLOC \u0646\u0642\u0637\u0647 \u0627\u062A\u0635\u0627\u0644 \u0627\u0646\u062A\u0642\u0627\u0644 \u0631\u0627 \u0628\u0627 \u0634\u0646\u0627\u0633\u0647 \u0633\u06CC\u0633\u062A\u0645\u060C \u0631\u0646\u06AF \u0648 \u0646\u0648\u0639 encapsulation \u062A\u0648\u0635\u06CC\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0633\u06CC\u0627\u0633\u062A \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0628\u0631 \u0627\u0633\u0627\u0633 \u06A9\u06CC\u0641\u06CC\u062A \u0633\u0646\u062C\u06CC\u062F\u0647\u200C\u0634\u062F\u0647 \u0648 SLA \u0628\u06CC\u0646 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u0645\u062C\u0627\u0632 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u062F.","\u0627\u06AF\u0631 \u0627\u0631\u062A\u0628\u0627\u0637 \u0634\u0639\u0628\u0647 \u0642\u0637\u0639 \u0627\u0633\u062A\u060C \u062F\u0633\u062A\u0631\u0633\u06CC \u0648 DNS/\u0632\u0645\u0627\u0646 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A\u060C certificate \u0648 \u06A9\u0646\u062A\u0631\u0644 session\u060C \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC OMP\u060C \u0648\u0636\u0639\u06CC\u062A \u062A\u0648\u0646\u0644 \u0648 BFD \u0648 \u0633\u067E\u0633 \u0633\u06CC\u0627\u0633\u062A \u0631\u0627 \u0628\u0647\u200C\u062A\u0631\u062A\u06CC\u0628 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 BFD \u0648 IPsec \u0631\u0627 \u062F\u0631 \u0646\u0633\u062E\u0647 \u0648 \u062A\u0648\u067E\u0648\u0644\u0648\u0698\u06CC \u0647\u0645\u0627\u0646 \u0631\u0627\u0647\u06A9\u0627\u0631 \u062A\u0623\u06CC\u06CC\u062F \u06A9\u0646. \u0645\u0641\u0627\u0647\u06CC\u0645 \u062A\u0648\u0646\u0644 \u0627\u0645\u0646 \u062F\u0631 [[ipsec|IPsec]] \u0648 \u0627\u0648\u0644\u0648\u06CC\u062A \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u0631 [[qos|QoS]] \u0647\u0633\u062A\u0646\u062F."],wifi6e:["Wi-Fi 6E \u0628\u0647 \u06A9\u0627\u0631\u0628\u0631\u062F Wi-Fi 6 \u062F\u0631 \u0628\u0627\u0646\u062F \u06F6 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0627\u0634\u0627\u0631\u0647 \u062F\u0627\u0631\u062F\u061B \u0645\u0642\u0631\u0631\u0627\u062A\u060C \u0637\u06CC\u0641 \u0642\u0627\u0628\u0644 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0648 \u062A\u0648\u0627\u0646 \u0645\u062C\u0627\u0632 \u0628\u0647 \u06A9\u0634\u0648\u0631 \u0648 \u0646\u0648\u0639 \u062A\u062C\u0647\u06CC\u0632 \u0648\u0627\u0628\u0633\u062A\u0647\u200C\u0627\u0646\u062F. Wi-Fi 7 \u0646\u06CC\u0632 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0632 \u0627\u06CC\u0646 \u0628\u0627\u0646\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u062F. \u0628\u0627\u0632\u062A\u0631 \u0628\u0648\u062F\u0646 \u0637\u06CC\u0641 \u0628\u0647 \u0645\u0639\u0646\u06CC \u0646\u0628\u0648\u062F \u062A\u062F\u0627\u062E\u0644 \u06CC\u0627 \u062A\u0636\u0645\u06CC\u0646 \u0633\u0631\u0639\u062A \u0646\u06CC\u0633\u062A\u061B \u0639\u0631\u0636 \u06A9\u0627\u0646\u0627\u0644\u060C \u062A\u0639\u062F\u0627\u062F \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0648 \u0637\u0631\u0627\u062D\u06CC \u067E\u0648\u0634\u0634 \u0645\u0647\u0645\u200C\u0627\u0646\u062F.","OFDMA \u06A9\u0627\u0646\u0627\u0644 \u0631\u0627 \u0628\u0647 \u0648\u0627\u062D\u062F\u0647\u0627\u06CC \u0645\u0646\u0628\u0639 \u0628\u0631\u0627\u06CC \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC \u0686\u0646\u062F \u06A9\u0627\u0631\u0628\u0631 \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. BSS coloring \u0628\u0647 \u062A\u0634\u062E\u06CC\u0635 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0647\u0645\u067E\u0648\u0634\u0627\u0646 \u06A9\u0645\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 spatial reuse \u062A\u062D\u062A \u0634\u0631\u0627\u06CC\u0637 \u0645\u0646\u0627\u0633\u0628 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0647\u0645\u200C\u0632\u0645\u0627\u0646\u06CC \u0631\u0627 \u0627\u0641\u0632\u0627\u06CC\u0634 \u062F\u0647\u062F. TWT \u0632\u0645\u0627\u0646\u200C\u0628\u0646\u062F\u06CC \u0628\u06CC\u062F\u0627\u0631\u06CC \u0627\u0633\u062A. \u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u06F6GHz\u060C \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627\u06CC \u0627\u0645\u0646\u06CC\u062A\u06CC \u0645\u062C\u0627\u0632 \u0648 PMF \u0631\u0627 \u0637\u0628\u0642 \u06AF\u0648\u0627\u0647\u06CC \u0648 \u067E\u0644\u062A\u0641\u0631\u0645 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u061B OWE \u0628\u0631\u0627\u06CC \u0634\u0628\u06A9\u0647 \u0645\u0647\u0645\u0627\u0646 \u0631\u0645\u0632\u06AF\u0630\u0627\u0631\u06CC\u200C\u0634\u062F\u0647 \u06AF\u0632\u06CC\u0646\u0647\u200C\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0632 WPA3 \u0627\u0633\u062A.","\u062F\u0631 \u0627\u0631\u0632\u06CC\u0627\u0628\u06CC\u060C \u0645\u062F\u0644 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u06F6GHz\u060C \u06A9\u0634\u0648\u0631 \u0648 firmware\u060C \u062A\u0646\u0638\u06CC\u0645 \u06A9\u0627\u0646\u0627\u0644 \u0648 \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F\u060C \u0627\u0645\u0646\u06CC\u062A \u0648 PMF \u0631\u0627 \u06A9\u0646\u062A\u0631\u0644 \u06A9\u0646. \u0642\u062F\u0631\u062A \u0633\u06CC\u06AF\u0646\u0627\u0644 \u0648 \u0646\u0631\u062E PHY \u0631\u0627 \u0628\u0627 throughput \u0648\u0627\u0642\u0639\u06CC \u0627\u0634\u062A\u0628\u0627\u0647 \u0646\u06AF\u06CC\u0631 \u0648 \u0622\u0632\u0645\u0627\u06CC\u0634 \u0631\u0627 \u062F\u0631 \u0645\u062D\u0644 \u06A9\u0627\u0631\u0628\u0631 \u0627\u0646\u062C\u0627\u0645 \u0628\u062F\u0647. [[wlan|\u0645\u0628\u0627\u0646\u06CC WLAN]] \u0648 [[qos|\u0627\u0648\u0644\u0648\u06CC\u062A \u062A\u0631\u0627\u0641\u06CC\u06A9]] \u067E\u06CC\u0634\u200C\u0646\u06CC\u0627\u0632\u0646\u062F."],sda:["SD-Access \u06CC\u06A9 \u0645\u0639\u0645\u0627\u0631\u06CC fabric \u0633\u0627\u0632\u0645\u0627\u0646\u06CC \u0627\u0633\u062A. Underlay \u0627\u0646\u062A\u0642\u0627\u0644 IP \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B overlay \u0627\u062A\u0635\u0627\u0644 \u0645\u0646\u0637\u0642\u06CC \u0645\u06CC\u0632\u0628\u0627\u0646\u200C\u0647\u0627 \u0631\u0627 \u0628\u0631 \u0628\u0633\u062A\u0631 \u0622\u0646 \u0628\u0631\u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. Fabric edge \u0645\u06CC\u0632\u0628\u0627\u0646 \u0631\u0627 \u0648\u0635\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C control plane \u0645\u06A9\u0627\u0646 endpoint \u0631\u0627 \u062F\u0646\u0628\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 border \u0645\u0633\u06CC\u0631 \u0648\u0631\u0648\u062F \u0648 \u062E\u0631\u0648\u062C \u0628\u0647 \u0634\u0628\u06A9\u0647 \u0628\u06CC\u0631\u0648\u0646 \u0627\u0633\u062A\u061B \u0646\u0642\u0634 \u0648 \u062A\u0631\u06A9\u06CC\u0628 \u0622\u0646\u200C\u0647\u0627 \u0628\u0647 \u0637\u0631\u0627\u062D\u06CC \u0628\u0633\u062A\u06AF\u06CC \u062F\u0627\u0631\u062F.","\u062F\u0631 \u06CC\u06A9 \u0646\u0645\u0648\u0646\u0647\u060C \u0647\u0648\u06CC\u062A \u06A9\u0627\u0631\u0628\u0631 \u06CC\u0627 \u062F\u0633\u062A\u06AF\u0627\u0647 \u062F\u0631 \u0641\u0631\u0627\u06CC\u0646\u062F \u062F\u0633\u062A\u0631\u0633\u06CC \u0628\u0631\u0631\u0633\u06CC \u0648 \u0628\u0631\u0686\u0633\u0628 \u0627\u0645\u0646\u06CC\u062A\u06CC SGT \u0628\u0647 \u0633\u06CC\u0627\u0633\u062A \u0645\u0631\u0628\u0648\u0637 \u0645\u06CC\u200C\u0634\u0648\u062F. LISP \u062F\u0631 \u0646\u0642\u0634 \u06A9\u0646\u062A\u0631\u0644\u060C \u0627\u0631\u062A\u0628\u0627\u0637 \u0647\u0648\u06CC\u062A \u0648 \u0645\u06A9\u0627\u0646 endpoint \u0631\u0627 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0648 VXLAN \u062D\u0645\u0644 overlay \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0639\u0645\u0627\u0644 \u0633\u06CC\u0627\u0633\u062A \u06AF\u0631\u0648\u0647\u06CC \u0628\u0647 \u0637\u0631\u0627\u062D\u06CC \u0648 \u0645\u062D\u0644 enforcement \u0648\u0627\u0628\u0633\u062A\u0647 \u0627\u0633\u062A\u061B \u062F\u0627\u0634\u062A\u0646 SGT \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u062A\u0636\u0645\u06CC\u0646 \u0627\u0639\u0645\u0627\u0644 \u0635\u062D\u06CC\u062D \u0633\u06CC\u0627\u0633\u062A \u0646\u06CC\u0633\u062A.","\u0628\u0631\u0627\u06CC \u062E\u0637\u0627 \u0627\u0628\u062A\u062F\u0627 underlay \u0648 reachability\u060C \u0633\u067E\u0633 onboarding \u0648 \u062B\u0628\u062A endpoint\u060C \u0639\u0636\u0648\u06CC\u062A fabric \u0648 \u0633\u06CC\u0627\u0633\u062A \u0648 \u0645\u0633\u06CC\u0631 border \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. \u0646\u0633\u062E\u0647 \u06A9\u0646\u062A\u0631\u0644\u0631\u060C \u0647\u0645\u06AF\u0627\u0645 \u0628\u0648\u062F\u0646 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0648 \u0648\u0636\u0639\u06CC\u062A \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627 \u0645\u0647\u0645\u200C\u0627\u0646\u062F. \u0627\u0631\u062A\u0628\u0627\u0637 \u0641\u0627\u0628\u0631\u06CC\u06A9 \u0648 \u06A9\u0646\u062A\u0631\u0644\u0631 \u062F\u0631 [[catalyst-center|Catalyst Center]] \u0648 \u0645\u0641\u0647\u0648\u0645 \u06A9\u067E\u0633\u0648\u0644\u0647\u200C\u0633\u0627\u0632\u06CC \u062F\u0631 [[vxlan-evpn|VXLAN]] \u0634\u0631\u062D \u062F\u0627\u062F\u0647 \u0634\u062F\u0647 \u0627\u0633\u062A."],"catalyst-center":["Catalyst Center \u0633\u0627\u0645\u0627\u0646\u0647 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0648 \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0634\u0628\u06A9\u0647 \u0627\u0633\u062A\u061B discovery\u060C inventory\u060C \u0637\u0631\u0627\u062D\u06CC\u060C \u0627\u0633\u062A\u0642\u0631\u0627\u0631 \u0648 assurance \u0646\u0642\u0634\u200C\u0647\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A\u06CC \u062F\u0627\u0631\u0646\u062F. Intent API \u0628\u0647 \u0646\u0631\u0645\u200C\u0627\u0641\u0632\u0627\u0631 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u0628\u0627 \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627\u06CC \u0645\u0633\u062A\u0646\u062F\u0634\u062F\u0647 \u0627\u0631\u062A\u0628\u0627\u0637 \u0628\u06AF\u06CC\u0631\u062F. API\u060C \u0648\u0636\u0639\u06CC\u062A \u0648\u0627\u0642\u0639\u06CC \u0647\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0648 \u0646\u0633\u062E\u0647 \u0646\u0631\u0645\u200C\u0627\u0641\u0632\u0627\u0631 \u0633\u0647 \u0633\u0637\u062D \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0647\u0633\u062A\u0646\u062F \u0648 \u0628\u0627\u06CC\u062F \u0628\u0627 \u0647\u0645 \u0645\u0642\u0627\u06CC\u0633\u0647 \u0634\u0648\u0646\u062F.","\u062F\u0631 \u0645\u062B\u0627\u0644 \u06AF\u0631\u0641\u062A\u0646 inventory\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u0628\u062A\u062F\u0627 \u0628\u0627 \u0633\u0627\u0632\u0648\u06A9\u0627\u0631 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0645\u0633\u062A\u0646\u062F \u062A\u0648\u06A9\u0646 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F\u060C \u0633\u067E\u0633 endpoint \u0645\u0631\u0628\u0648\u0637 \u0631\u0627 \u0641\u0631\u0627\u062E\u0648\u0627\u0646\u06CC \u0648 \u067E\u0627\u0633\u062E \u0631\u0627 \u0627\u0632 \u0646\u0638\u0631 pagination\u060C \u062E\u0637\u0627 \u0648 \u0641\u06CC\u0644\u062F\u0647\u0627\u06CC \u0645\u0648\u0631\u062F\u0646\u06CC\u0627\u0632 \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u062D\u0633\u0627\u0633 \u0646\u0628\u0627\u06CC\u062F \u062F\u0631 \u06A9\u062F \u06CC\u0627 log \u0642\u0631\u0627\u0631 \u06AF\u06CC\u0631\u062F. \u0628\u0639\u0636\u06CC \u062A\u063A\u06CC\u06CC\u0631\u0627\u062A \u0646\u0627\u0647\u0645\u06AF\u0627\u0645\u200C\u0627\u0646\u062F \u0648 \u067E\u0627\u0633\u062E \u0627\u0648\u0644\u06CC\u0647 \u0641\u0642\u0637 \u0634\u0646\u0627\u0633\u0647 task \u0645\u06CC\u200C\u062F\u0647\u062F\u060C \u0646\u0647 \u0645\u0648\u0641\u0642\u06CC\u062A \u0646\u0647\u0627\u06CC\u06CC.","\u0627\u06AF\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647 unmanaged \u0627\u0633\u062A\u060C \u062F\u0633\u062A\u0631\u0633\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u060C credential\u060C \u0645\u062C\u0648\u0632\u0647\u0627\u060C \u0646\u0633\u062E\u0647 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC\u200C\u0634\u062F\u0647 \u0648 \u0632\u0645\u0627\u0646 \u0648 certificate \u0631\u0627 \u06A9\u0646\u062A\u0631\u0644 \u06A9\u0646 \u0648 \u0639\u0644\u062A \u0631\u0627 \u062F\u0631 \u06AF\u0632\u0627\u0631\u0634 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0628\u062E\u0648\u0627\u0646. \u067E\u0627\u0633\u062E API \u0646\u0645\u0648\u0646\u0647 \u0622\u0645\u0648\u0632\u0634\u06CC \u0627\u0633\u062A \u0648 \u0646\u0634\u0627\u0646\u0647 \u0627\u062A\u0635\u0627\u0644 \u0628\u0647 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0648\u0627\u0642\u0639\u06CC \u0646\u06CC\u0633\u062A. \u0628\u0631\u0627\u06CC \u0631\u0648\u0634 \u0627\u0645\u0646 \u0648 \u062A\u06A9\u0631\u0627\u0631\u067E\u0630\u06CC\u0631 [[automation|\u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646]] \u0648 \u0628\u0631\u0627\u06CC \u0645\u062F\u0644 \u062F\u0627\u062F\u0647 [[netconf-yang|YANG]] \u0631\u0627 \u0628\u0628\u06CC\u0646."],multicast:["Multicast \u0627\u0631\u0633\u0627\u0644 \u06CC\u06A9 \u062C\u0631\u06CC\u0627\u0646 \u0628\u0647 \u06CC\u06A9 \u06AF\u0631\u0648\u0647 \u0627\u0632 \u06AF\u06CC\u0631\u0646\u062F\u06AF\u0627\u0646 \u0639\u0644\u0627\u0642\u0647\u200C\u0645\u0646\u062F \u0627\u0633\u062A. IGMP \u062F\u0631 IPv4 \u0628\u0631\u0627\u06CC \u0639\u0636\u0648\u06CC\u062A \u0645\u06CC\u0632\u0628\u0627\u0646 \u0648 \u0631\u0648\u062A\u0631 \u0645\u062D\u0644\u06CC \u0648 PIM \u0628\u0631\u0627\u06CC \u0633\u0627\u062E\u062A \u0648\u0636\u0639\u06CC\u062A \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u0627\u0646 \u0631\u0648\u062A\u0631\u0647\u0627 \u06A9\u0627\u0631\u0628\u0631\u062F \u062F\u0627\u0631\u062F. RP \u0646\u0642\u0637\u0647 rendezvous \u062F\u0631 PIM-SM \u0628\u0631\u0627\u06CC \u0645\u062F\u0644 \u06AF\u0631\u0648\u0647\u200C\u0647\u0627\u06CC\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0627\u0632 \u062F\u0631\u062E\u062A \u0645\u0634\u062A\u0631\u06A9 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F\u061B SSM \u0631\u0648\u06CC\u06A9\u0631\u062F \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0634\u062E\u0635 \u0645\u0646\u0628\u0639 \u062F\u0627\u0631\u062F.","\u06AF\u06CC\u0631\u0646\u062F\u0647 \u0639\u0636\u0648\u06CC\u062A \u06AF\u0631\u0648\u0647 \u0631\u0627 \u0627\u0639\u0644\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0631\u0648\u062A\u0631 \u0645\u062D\u0644\u06CC Join \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062F\u0631\u062E\u062A \u0645\u0634\u062A\u0631\u06A9 \u0631\u0627 \u06AF\u0627\u0645\u200C\u0628\u0647\u200C\u06AF\u0627\u0645 \u0628\u0647 \u0633\u0645\u062A RP \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F. \u0631\u0648\u062A\u0631 \u0646\u0632\u062F\u06CC\u06A9 \u0645\u0646\u0628\u0639 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062F\u0627\u062F\u0647 \u0627\u0648\u0644\u06CC\u0647 \u0631\u0627 \u062F\u0631 \u067E\u06CC\u0627\u0645 Register \u0628\u0647 RP \u0628\u0631\u0633\u0627\u0646\u062F. \u062F\u0631\u062E\u062A (S,G) \u0628\u0647 \u06CC\u06A9 \u0645\u0646\u0628\u0639 \u0648 \u06AF\u0631\u0648\u0647 \u0648 (*,G) \u0628\u0647 \u062F\u0631\u062E\u062A \u0645\u0634\u062A\u0631\u06A9 \u0627\u0634\u0627\u0631\u0647 \u062F\u0627\u0631\u062F\u061B \u062A\u063A\u06CC\u06CC\u0631 \u0628\u0647 \u062F\u0631\u062E\u062A \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631 \u0648\u0627\u0628\u0633\u062A\u0647 \u0628\u0647 \u0633\u06CC\u0627\u0633\u062A \u0648 \u067E\u06CC\u0627\u062F\u0647\u200C\u0633\u0627\u0632\u06CC \u0627\u0633\u062A.","\u0648\u062C\u0648\u062F \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0631\u0627 \u0628\u0627 show ip igmp groups \u0648 \u0647\u0645\u0633\u0627\u06CC\u06AF\u06CC \u0631\u0627 \u0628\u0627 show ip pim neighbor \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. show ip mroute \u0631\u0627\u0628\u0637 \u0648\u0631\u0648\u062F\u06CC \u0648 \u0641\u0647\u0631\u0633\u062A \u062E\u0631\u0648\u062C\u06CC \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F\u061B RPF \u0645\u0637\u0645\u0626\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F \u0628\u0633\u062A\u0647 \u0627\u0632 \u0633\u0645\u062A \u0645\u0648\u0631\u062F \u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0631\u0627\u06CC \u0645\u0646\u0628\u0639 \u06CC\u0627 RP \u0622\u0645\u062F\u0647 \u0627\u0633\u062A. reachability \u0645\u0648\u0631\u062F\u0646\u06CC\u0627\u0632\u060C RP mapping \u0648 ACL\u0647\u0627 \u0631\u0627 \u06A9\u0646\u062A\u0631\u0644 \u06A9\u0646\u061B [[static-routing|\u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u06CC\u06A9\u200C\u067E\u062E\u0634\u06CC]] \u0631\u0627 \u0645\u0631\u0648\u0631 \u06A9\u0646."],"qos-advanced":["\u0637\u0628\u0642\u0647\u200C\u0628\u0646\u062F\u06CC \u0648 marking \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u0627\u0632\u062F\u062D\u0627\u0645 \u0631\u0627 \u062D\u0644 \u0646\u0645\u06CC\u200C\u06A9\u0646\u0646\u062F\u061B \u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0627\u0641\u062A \u062F\u0631 \u0646\u0642\u0637\u0647 \u062A\u0646\u06AF\u0646\u0627 \u0644\u0627\u0632\u0645\u200C\u0627\u0646\u062F. LLQ \u0635\u0641 \u0627\u0648\u0644\u0648\u06CC\u062A \u06A9\u0645\u200C\u062A\u0623\u062E\u06CC\u0631 \u0648 CBWFQ \u062A\u062E\u0635\u06CC\u0635 \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F \u0628\u0631\u0627\u06CC \u06A9\u0644\u0627\u0633\u200C\u0647\u0627 \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0631\u0641\u062A\u0627\u0631 \u062F\u0642\u06CC\u0642 \u0648 \u0645\u062D\u062F\u0648\u062F\u06CC\u062A\u200C\u0647\u0627 \u0628\u0647 \u0633\u062E\u062A\u200C\u0627\u0641\u0632\u0627\u0631 \u0648 \u0646\u0633\u062E\u0647 \u0648\u0627\u0628\u0633\u062A\u0647 \u0627\u0633\u062A. WRED \u0627\u0641\u062A \u0632\u0648\u062F\u0647\u0646\u06AF\u0627\u0645 \u0631\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0622\u0633\u062A\u0627\u0646\u0647 \u0648 \u0627\u062D\u062A\u0645\u0627\u0644 \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0627\u06AF\u0631 \u0644\u06CC\u0646\u06A9 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u06CC\u06A9 \u06AF\u06CC\u06AF\u0627\u0628\u06CC\u062A \u0648\u0644\u06CC \u0633\u0631\u0648\u06CC\u0633 \u0627\u067E\u0631\u0627\u062A\u0648\u0631 \u06F1\u06F0\u06F0 \u0645\u06AF\u0627\u0628\u06CC\u062A \u0628\u0627\u0634\u062F\u060C \u0635\u0641 \u0628\u062F\u0648\u0646 shaping \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u062F\u0631 \u0633\u0645\u062A \u0627\u067E\u0631\u0627\u062A\u0648\u0631 \u062A\u0634\u06A9\u06CC\u0644 \u0634\u0648\u062F. \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0628\u0627 shaping \u0645\u062A\u0646\u0627\u0633\u0628 \u0628\u0627 \u0646\u0631\u062E \u0648 \u0633\u0631\u0628\u0627\u0631 \u0633\u0631\u0648\u06CC\u0633 \u0635\u0641 \u0631\u0627 \u0628\u0647 \u0645\u062D\u0644 \u0627\u0639\u0645\u0627\u0644 \u0633\u06CC\u0627\u0633\u062A \u0645\u0646\u062A\u0642\u0644 \u06A9\u0631\u062F \u0648 \u0633\u06CC\u0627\u0633\u062A \u0641\u0631\u0632\u0646\u062F \u0628\u0631\u0627\u06CC \u06A9\u0644\u0627\u0633\u200C\u0647\u0627 \u0628\u0647\u200C\u06A9\u0627\u0631 \u0628\u0631\u062F\u061B \u062F\u0631\u0635\u062F \u062B\u0627\u0628\u062A \u0628\u0631\u0627\u06CC \u0647\u0645\u0647 \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627 \u062A\u0636\u0645\u06CC\u0646 \u0646\u06CC\u0633\u062A.","show policy-map interface \u0631\u0627 \u0628\u0627 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0648\u0627\u0642\u0639\u06CC \u062F\u0631 \u0632\u0645\u0627\u0646 \u0627\u0632\u062F\u062D\u0627\u0645 \u0628\u062E\u0648\u0627\u0646: \u062A\u0637\u0628\u06CC\u0642 \u06A9\u0644\u0627\u0633\u060C transmit\u060C drop\u060C queue \u0648 \u0646\u0631\u062E \u0631\u0627 \u06A9\u0646\u0627\u0631 \u062A\u0623\u062E\u06CC\u0631 \u0648 jitter \u0627\u0631\u0632\u06CC\u0627\u0628\u06CC \u06A9\u0646. \u0627\u0641\u062A \u0635\u0641\u0631 \u062F\u0631 \u0632\u0645\u0627\u0646 \u0628\u062F\u0648\u0646 \u0628\u0627\u0631 \u0646\u0634\u0627\u0646\u200C\u062F\u0647\u0646\u062F\u0647 \u0633\u0644\u0627\u0645\u062A \u0637\u0631\u0627\u062D\u06CC \u062F\u0631 \u0627\u0632\u062F\u062D\u0627\u0645 \u0646\u06CC\u0633\u062A. \u0627\u0628\u062A\u062F\u0627 [[qos|QoS \u067E\u0627\u06CC\u0647]] \u0648 \u062A\u0641\u0627\u0648\u062A policing \u0648 shaping \u0631\u0627 \u06CC\u0627\u062F \u0628\u06AF\u06CC\u0631."],"netconf-yang":["YANG \u0632\u0628\u0627\u0646 \u0645\u062F\u0644\u200C\u0633\u0627\u0632\u06CC \u0633\u0627\u062E\u062A\u0627\u0631 \u0648 \u0645\u062D\u062F\u0648\u062F\u06CC\u062A \u062F\u0627\u062F\u0647 \u0627\u0633\u062A\u061B NETCONF \u067E\u0631\u0648\u062A\u06A9\u0644 \u0639\u0645\u0644\u06CC\u0627\u062A \u0631\u0648\u06CC \u062F\u0627\u062F\u0647\u200C\u0647\u0627\u06CC \u0645\u062F\u0644\u200C\u0634\u062F\u0647 \u0648 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0628\u0631 SSH \u0627\u0633\u062A. RESTCONF \u062F\u0633\u062A\u0631\u0633\u06CC HTTP \u0628\u0647 \u062F\u0627\u062F\u0647\u200C\u0647\u0627\u06CC YANG \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. running\u060C candidate \u0648 startup datastore\u0647\u0627\u06CC \u0645\u0641\u0647\u0648\u0645\u06CC\u200C\u0627\u0646\u062F \u06A9\u0647 \u0648\u062C\u0648\u062F \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0647\u0631\u06A9\u062F\u0627\u0645 \u062F\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0628\u0627\u06CC\u062F \u0627\u0632 capability\u0647\u0627 \u0645\u0634\u062E\u0635 \u0634\u0648\u062F.","\u0628\u0631\u0627\u06CC \u062A\u063A\u06CC\u06CC\u0631 \u0627\u06CC\u0645\u0646\u060C \u0627\u0628\u062A\u062F\u0627 capability \u0648 \u0645\u062F\u0644 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC\u200C\u0634\u062F\u0647 \u0631\u0627 \u0645\u06CC\u200C\u062E\u0648\u0627\u0646\u06CC\u0645\u060C \u062F\u0627\u062F\u0647 \u0647\u062F\u0641 \u0631\u0627 \u0628\u0627 namespace \u0635\u062D\u06CC\u062D \u0622\u0645\u0627\u062F\u0647 \u0648 \u062F\u0631 \u0635\u0648\u0631\u062A \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC candidate \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0627 staged \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645. validate \u0648 commit \u0648 \u062F\u0631 \u0635\u0648\u0631\u062A \u0627\u0645\u06A9\u0627\u0646 confirmed commit \u062E\u0637\u0631 \u0645\u0627\u0646\u062F\u0646 \u062A\u063A\u06CC\u06CC\u0631 \u0646\u0627\u0645\u0646\u0627\u0633\u0628 \u0631\u0627 \u06A9\u0627\u0647\u0634 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F. \u0627\u06CC\u0646 \u0639\u0645\u0644\u06CC\u0627\u062A \u0648 \u0642\u0627\u0628\u0644\u06CC\u062A\u200C\u0647\u0627 \u062F\u0631 \u0647\u0645\u0647 \u067E\u0644\u062A\u0641\u0631\u0645\u200C\u0647\u0627 \u06CC\u06A9\u0633\u0627\u0646 \u0646\u06CC\u0633\u062A\u0646\u062F.","\u067E\u0633 \u0627\u0632 edit-config \u06CC\u0627 \u062F\u0631\u062E\u0648\u0627\u0633\u062A RESTCONF\u060C \u0641\u0642\u0637 \u0645\u0648\u0641\u0642\u06CC\u062A \u0627\u0646\u062A\u0642\u0627\u0644 \u0631\u0627 \u0645\u0644\u0627\u06A9 \u0642\u0631\u0627\u0631 \u0646\u062F\u0647\u061B \u067E\u0627\u0633\u062E \u062E\u0637\u0627\u060C task \u0648 \u062F\u0627\u062F\u0647 \u062E\u0648\u0627\u0646\u062F\u0647\u200C\u0634\u062F\u0647 \u067E\u0633 \u0627\u0632 \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0627 \u06A9\u0646\u062A\u0631\u0644 \u06A9\u0646. \u0642\u0641\u0644\u200C\u0647\u0627 \u0631\u0627 \u0622\u0632\u0627\u062F\u060C \u0645\u062D\u062F\u0648\u062F\u06CC\u062A \u0632\u0645\u0627\u0646 \u0631\u0627 \u0631\u0639\u0627\u06CC\u062A \u0648 \u0627\u0639\u062A\u0628\u0627\u0631 TLS \u0648 \u062F\u0633\u062A\u0631\u0633\u06CC \u062D\u062F\u0627\u0642\u0644\u06CC \u0631\u0627 \u062D\u0641\u0638 \u06A9\u0646. [[automation|\u0627\u0635\u0648\u0644 \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646]] \u0648 [[catalyst-center|API \u06A9\u0646\u062A\u0631\u0644\u0631]] \u0645\u0642\u0627\u06CC\u0633\u0647 \u0645\u0641\u06CC\u062F\u06CC \u0627\u0631\u0627\u0626\u0647 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F."],"ipv6-routing":["OSPFv3 \u063A\u0627\u0644\u0628\u0627\u064B \u0628\u0631\u0627\u06CC \u0647\u0645\u0633\u0627\u06CC\u06AF\u06CC \u0627\u0632 \u0622\u062F\u0631\u0633 link-local \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 Router ID \u0622\u0646 \u0647\u0645\u0686\u0646\u0627\u0646 \u06F3\u06F2 \u0628\u06CC\u062A\u06CC \u0627\u0633\u062A. \u062F\u0631 OSPFv3\u060C Link-LSA \u0646\u0648\u0639 \u06F8 \u0648 Intra-Area-Prefix-LSA \u0646\u0648\u0639 \u06F9 \u0627\u0633\u062A\u061B \u0646\u0648\u0639 \u0648 \u062D\u0648\u0632\u0647 \u0627\u0646\u062A\u0634\u0627\u0631 \u0631\u0627 \u0628\u0627 OSPFv2 \u0627\u0634\u062A\u0628\u0627\u0647 \u0646\u06AF\u06CC\u0631. \u0646\u0633\u062E\u0647\u200C\u0647\u0627\u06CC \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F address family\u0647\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F \u0648 \u0646\u062D\u0648 \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0628\u0647 \u067E\u0644\u062A\u0641\u0631\u0645 \u0648\u0627\u0628\u0633\u062A\u0647 \u0627\u0633\u062A.","\u062F\u0631 \u0646\u062D\u0648 \u06A9\u0644\u0627\u0633\u06CC\u06A9 IOS\u060C \u067E\u0633 \u0627\u0632 \u0641\u0639\u0627\u0644\u200C\u0633\u0627\u0632\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC IPv6 \u0648 \u062A\u0646\u0638\u06CC\u0645 router-id\u060C OSPFv3 \u0631\u0648\u06CC \u0631\u0627\u0628\u0637 \u0628\u0627 ipv6 ospf process-id area area-id \u0641\u0639\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0647\u0645\u0633\u0627\u06CC\u06AF\u06CC FULL \u0646\u0634\u0627\u0646\u0647 \u0647\u0645\u06AF\u0627\u0645\u200C\u0633\u0627\u0632\u06CC \u0627\u0633\u062A\u060C \u0648\u0644\u06CC \u0628\u0631\u0627\u06CC \u062F\u0633\u062A\u0631\u0633\u06CC \u0628\u0647 \u0645\u0642\u0635\u062F \u0628\u0627\u06CC\u062F prefix \u0645\u0646\u0627\u0633\u0628 \u0627\u0639\u0644\u0627\u0645 \u0648 \u0645\u0633\u06CC\u0631 \u0628\u0631\u06AF\u0634\u062A \u0646\u06CC\u0632 \u0645\u0648\u062C\u0648\u062F \u0628\u0627\u0634\u062F. OSPFv3 virtual link \u0627\u0632 \u0642\u0627\u0639\u062F\u0647 \u0645\u0639\u0645\u0648\u0644 link-local \u0627\u0633\u062A\u062B\u0646\u0627 \u062F\u0627\u0631\u062F.","\u0628\u0627 show ipv6 ospf neighbor \u0648 show ipv6 route ospf\u060C \u0627\u0628\u062A\u062F\u0627 adjacency \u0648 \u0633\u067E\u0633 \u0645\u0633\u06CC\u0631\u0647\u0627 \u0631\u0627 \u062C\u062F\u0627 \u06A9\u0646\u062A\u0631\u0644 \u06A9\u0646. \u0628\u0631\u0627\u06CC link-local \u0645\u062D\u062F\u0648\u062F\u0647 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0645\u0647\u0645 \u0627\u0633\u062A\u06