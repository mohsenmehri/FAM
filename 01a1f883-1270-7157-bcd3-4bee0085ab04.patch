+++ b/FAM-Linux-Lab-vm-backup/FAM-Linux-Lab/tests/test_academy_delivery.py
@@ -0,0 +1,341 @@
+import re
+import contextlib
+import html
+import io
+import ipaddress
+import json
+from unittest.mock import patch
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+SERVER = Path(__file__).resolve().parents[1] / 'server'
+sys.path.insert(0, str(SERVER))
+from app import create_app
+
+
+class AcademyDeliveryTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.app = create_app({'TESTING': True, 'DB_PATH': str(Path(self.temp.name) / 'test.sqlite3'),
+                               'PUBLIC_ORIGIN': 'https://test.local', 'COOKIE_SECURE': False})
+        self.client = self.app.test_client()
+
+    def test_authenticated_html_and_static_assets(self):
+        self.assertEqual(self.client.get('/academy').status_code, 401)
+        response = self.client.post('/api/login', json={'username': 'admin', 'password': '1109'},
+                                    headers={'Origin': 'https://test.local'})
+        self.assertEqual(response.status_code, 200)
+        response = self.client.get('/academy')
+        self.assertEqual(response.status_code, 200)
+        html = response.get_data(as_text=True)
+        self.assertNotIn('__FAM_ACADEMY_BOOTSTRAP__', html)
+        self.assertNotIn('__FAM_CSP_NONCE__', html)
+        self.assertIn("script-src 'self' 'nonce-", response.headers['Content-Security-Policy'])
+        assets = re.findall(r'(?:src|href)="(/academy-assets/[^"?]+)', html)
+        self.assertIn('/academy-assets/academy-reference-ui.css', assets)
+        self.assertIn('/academy-assets/academy-reference-shell.js', assets)
+        self.assertIn('/academy-assets/academy-course-library.css', assets)
