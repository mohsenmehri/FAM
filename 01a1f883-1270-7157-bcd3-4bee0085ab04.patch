u0645\u06CC\u200C\u0634\u0648\u062F."],exam:["Wi-Fi 6E \u0627\u0632 802.11ax \u0648 \u0628\u0627\u0646\u062F \u06F6GHz \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B Wi-Fi 7 \u0646\u06CC\u0632 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0632 \u0627\u06CC\u0646 \u0628\u0627\u0646\u062F \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u062F. \u0627\u0644\u0632\u0627\u0645\u0627\u062A \u0627\u0645\u0646\u06CC\u062A\u06CC WPA3/OWE \u0648 PMF \u0631\u0627 \u062F\u0631 \u067E\u0644\u062A\u0641\u0631\u0645 \u0647\u062F\u0641 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646.","PSC \u0628\u0631\u0627\u06CC \u06A9\u0634\u0641 \u0633\u0631\u06CC\u0639 \u06A9\u0627\u0646\u0627\u0644\u200C\u0647\u0627\u0633\u062A\u061B OFDMA \u06A9\u0627\u0646\u0627\u0644 \u0631\u0627 \u0628\u0647 RU \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F.","WPA3-Enterprise 192-bit \u0641\u0642\u0637 EAP-TLS \u0628\u0627 GCMP-256 \u0648 SHA-384."],glossary:[["PSC","\u06A9\u0627\u0646\u0627\u0644\u200C\u0647\u0627\u06CC \u062A\u0631\u062C\u06CC\u062D\u06CC \u0628\u0631\u0627\u06CC \u0627\u0633\u06A9\u0646 \u0633\u0631\u06CC\u0639 \u062F\u0631 \u06F6GHz."],["OFDMA","\u062A\u0642\u0633\u06CC\u0645 \u06A9\u0627\u0646\u0627\u0644 \u0628\u0647 \u0648\u0627\u062D\u062F\u0647\u0627\u06CC \u0641\u0631\u0639\u06CC \u0628\u0631\u0627\u06CC \u0686\u0646\u062F \u06A9\u0627\u0631\u0628\u0631."],["PMF","\u0645\u062D\u0627\u0641\u0638\u062A \u0627\u0632 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC (802.11w)."],["SAE","\u0631\u0648\u0634 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A WPA3-Personal."]]},sda:{prereq:["vlan-trunk"],related:["vxlan-evpn","catalyst-center","l2-discovery"],title:"SD-Access \u2014 \u0641\u0627\u0628\u0631\u06CC\u06A9 \u0634\u0628\u06A9\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06CC",tagline:"SD-Access \u0647\u0645\u0627\u0646 \u0627\u06CC\u062F\u0647 SD-WAN \u0631\u0627 \u0628\u0647 \u0634\u0628\u06A9\u0647 \u062F\u0627\u062E\u0644\u06CC \u0645\u06CC\u200C\u0622\u0648\u0631\u062F: \u06CC\u06A9 \u0641\u0627\u0628\u0631\u06CC\u06A9\u060C \u0633\u06CC\u0627\u0633\u062A \u0645\u062A\u0645\u0631\u06A9\u0632\u060C \u0628\u0631\u0686\u0633\u0628 \u0647\u0648\u06CC\u062A \u0628\u0647\u200C\u062C\u0627\u06CC IP.",minutes:16,goals:["\u0646\u0642\u0634 Control-Plane Node\u060C Border \u0648 Edge \u0631\u0627 \u062F\u0631 \u0641\u0627\u0628\u0631\u06CC\u06A9 \u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC","\u0628\u06AF\u0648\u06CC\u06CC LISP \u0686\u0647 \u06A9\u0627\u0631\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 VXLAN-GPO \u0686\u0647 \u062A\u0641\u0627\u0648\u062A\u06CC \u0628\u0627 VXLAN \u0645\u0639\u0645\u0648\u0644\u06CC \u062F\u0627\u0631\u062F","\u0628\u0627 SGT \u0648 SGACL \u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC \u0686\u0631\u0627 \u0633\u06CC\u0627\u0633\u062A \u0628\u0631 \u0627\u0633\u0627\u0633 \u0647\u0648\u06CC\u062A\u060C \u0627\u0632 ACL \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 IP \u0628\u0647\u062A\u0631 \u0627\u0633\u062A"],sections:[{h:"\u0633\u0647 \u0644\u0627\u06CC\u0647 \u0641\u0627\u0628\u0631\u06CC\u06A9",p:["SD-Access \u0633\u0647 \u0644\u0627\u06CC\u0647 \u062F\u0627\u0631\u062F. Underlay: \u0634\u0628\u06A9\u0647 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC\u200C\u0634\u062F\u0647 (\u0645\u0639\u0645\u0648\u0644\u0627\u064B IS-IS) \u06A9\u0647 \u0641\u0642\u0637 \u06A9\u0627\u0631\u0634 \u0631\u0633\u0627\u0646\u062F\u0646 \u0628\u0633\u062A\u0647 \u0628\u0647 \u0645\u0642\u0635\u062F \u0627\u0633\u062A. Overlay: \u0634\u0628\u06A9\u0647 \u0645\u062C\u0627\u0632\u06CC \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 VXLAN \u06A9\u0647 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0648 \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627 \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. Control Plane: \u0628\u0627 LISP\u060C \u062C\u0627\u06CC\u06CC \u06A9\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0647\u0631 \u0622\u062F\u0631\u0633 (EID) \u067E\u0634\u062A \u06A9\u062F\u0627\u0645 \u0633\u0648\u0626\u06CC\u0686 (RLOC) \u0627\u0633\u062A.","\u0686\u0631\u0627 LISP\u061F \u0686\u0648\u0646 \u062F\u0631 \u0634\u0628\u06A9\u0647 \u0633\u0646\u062A\u06CC\u060C \u0622\u062F\u0631\u0633 IP \u0647\u0645 \xAB\u0647\u0648\u06CC\u062A\xBB \u0627\u0633\u062A \u0648 \u0647\u0645 \xAB\u0645\u062D\u0644\xBB. \u062F\u0631 SD-Access \u0627\u06CC\u0646 \u062F\u0648 \u062C\u062F\u0627 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F: \u06A9\u0627\u0631\u0628\u0631 \u0647\u0631 \u062C\u0627 \u0648\u0635\u0644 \u0634\u0648\u062F\u060C \u0647\u0645\u0627\u0646 \u0622\u062F\u0631\u0633 \u0631\u0627 \u062F\u0627\u0631\u062F \u0648 \u0634\u0628\u06A9\u0647 \u0628\u0627 LISP \u0645\u06CC\u200C\u0641\u0647\u0645\u062F \u0627\u0644\u0627\u0646 \u06A9\u062C\u0627\u0633\u062A. \u0627\u06CC\u0646 \u0647\u0645\u0627\u0646 \u0686\u06CC\u0632\u06CC \u0627\u0633\u062A \u06A9\u0647 \xAB\u0648\u0635\u0644 \u0634\u0648\u060C \u0647\u0631 \u062C\u0627 \u06A9\u0647 \u0647\u0633\u062A\u06CC\xBB \u0631\u0627 \u0645\u0645\u06A9\u0646 \u0645\u06CC\u200C\u06A9\u0646\u062F."],list:["Control-Plane Node: Map-Server/Map-Resolver\u060C \u062B\u0628\u062A EID\u0647\u0627 (UDP 4342)","Border Node: \u062E\u0631\u0648\u062C \u0641\u0627\u0628\u0631\u06CC\u06A9 \u0628\u0647 \u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631/WAN بانک\u060C \u0628\u0627 Fusion Router","Edge Node: \u0633\u0648\u0626\u06CC\u0686\u06CC \u06A9\u0647 \u06A9\u0627\u0631\u0628\u0631 \u0628\u0647 \u0622\u0646 \u0648\u0635\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 VXLAN \u0631\u0627 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F","Intermediate Node: \u0633\u0648\u0626\u06CC\u0686\u200C\u0647\u0627\u06CC \u0645\u06CC\u0627\u0646\u06CC \u06A9\u0647 \u0641\u0642\u0637 Underlay \u0647\u0633\u062A\u0646\u062F"]},{h:"\u0633\u06AF\u0645\u0646\u062A\u06CC\u0634\u0646 \u0628\u0627 SGT",p:["\u062F\u0631 \u0634\u0628\u06A9\u0647 \u06A9\u0644\u0627\u0633\u06CC\u06A9\u060C \u0633\u06CC\u0627\u0633\u062A \u0627\u0645\u0646\u06CC\u062A\u06CC \u0628\u0627 ACL \u0631\u0648\u06CC \u0622\u062F\u0631\u0633 IP \u0646\u0648\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0645\u0634\u06A9\u0644: \u0628\u0627 DHCP\u060C \u06A9\u0627\u0631\u0628\u0631 \u0641\u0631\u062F\u0627 IP \u062F\u06CC\u06AF\u0631\u06CC \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 ACL \u0628\u06CC\u200C\u0645\u0639\u0646\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F. \u062F\u0631 SD-Access\u060C \u0647\u0631 \u06A9\u0627\u0631\u0628\u0631 \u06CC\u06A9 \u0628\u0631\u0686\u0633\u0628 \u06AF\u0631\u0648\u0647 \u0627\u0645\u0646\u06CC\u062A\u06CC (SGT) \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u06A9\u0647 \u0628\u0627 \u0647\u0648\u06CC\u062A \u0627\u0648 (\u0627\u0632 ISE) \u06AF\u0631\u0647 \u062E\u0648\u0631\u062F\u0647 \u0627\u0633\u062A. SGT \u06CC\u06A9 \u0639\u062F\u062F \u06F1\u06F6 \u0628\u06CC\u062A\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062F\u0631 \u0647\u062F\u0631 VXLAN-GPO \u062D\u0645\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062D\u0627\u0644\u0627 \u0633\u06CC\u0627\u0633\u062A \u0628\u0647 \u0627\u06CC\u0646 \u0634\u06A9\u0644 \u0646\u0648\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F: \xAB\u06AF\u0631\u0648\u0647 \u062F\u0627\u0646\u0634\u062C\u0648 \u0627\u062C\u0627\u0632\u0647 \u0646\u062F\u0627\u0631\u062F \u0628\u0647 \u06AF\u0631\u0648\u0647 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0633\u0631\u0648\u0631 \u062F\u0633\u062A\u0631\u0633\u06CC \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\xBB\u060C \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646\u06A9\u0647 \u06CC\u06A9 IP \u062F\u0631 \u0622\u0646 \u0628\u0627\u0634\u062F. \u0627\u06AF\u0631 \u062F\u0627\u0646\u0634\u062C\u0648 IP \u0639\u0648\u0636 \u06A9\u0646\u062F\u060C SGT \u0627\u0648 \u0647\u0645\u0627\u0646 \u0627\u0633\u062A \u0648 \u0633\u06CC\u0627\u0633\u062A \u0647\u0645\u0686\u0646\u0627\u0646 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F."],callout:{title:"\u0631\u0648\u0646\u062F \u062A\u062D\u0642\u0642 \u06CC\u06A9 \u0628\u0633\u062A\u0647",text:"Edge \u0648\u0631\u0648\u062F\u06CC SGT \u0631\u0627 \u0627\u0632 ISE \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u2192 \u0628\u0633\u062A\u0647 \u0631\u0627 \u062F\u0631 VXLAN-GPO \u0645\u06CC\u200C\u067E\u06CC\u0686\u062F (SGT \u062F\u0627\u062E\u0644 \u0647\u062F\u0631) \u2192 Edge \u0645\u0642\u0635\u062F \u0642\u0628\u0644 \u0627\u0632 \u062A\u062D\u0648\u06CC\u0644\u060C SGACL \u0631\u0627 \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F \u2192 \u062F\u0631 \u0635\u0648\u0631\u062A \u0631\u062F\u060C \u0628\u0633\u062A\u0647 \u0647\u0645\u0627\u0646\u200C\u062C\u0627 drop \u0645\u06CC\u200C\u0634\u0648\u062F."}},{h:"\u0646\u0642\u0634 Border \u0648 Fusion",p:["\u0641\u0627\u0628\u0631\u06CC\u06A9 \u06CC\u06A9 \u062C\u0632\u06CC\u0631\u0647 \u0627\u0633\u062A\u061B \u0628\u0631\u0627\u06CC \u0631\u0633\u06CC\u062F\u0646 \u0628\u0647 \u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631 \u06CC\u0627 WAN بانک \u0628\u0627\u06CC\u062F \u0627\u0632 Border \u062E\u0627\u0631\u062C \u0634\u0648\u062F. Border \u0628\u0627 VRF\u0647\u0627\u06CC \u062C\u062F\u0627 \u0628\u0631\u0627\u06CC \u0647\u0631 Virtual Network \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0628\u0627 Fusion Router (\u0631\u0648\u062A\u0631\u06CC \u06A9\u0647 \u0628\u06CC\u0646 VN\u0647\u0627 \u0648 \u062F\u0646\u06CC\u0627\u06CC \u0628\u06CC\u0631\u0648\u0646 \u0627\u0633\u062A) \u062A\u0628\u0627\u062F\u0644 \u0645\u0633\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062F\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A\u060C \u0627\u06CC\u0646 \u062A\u0628\u062F\u06CC\u0644 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0627\u0632 LISP \u0628\u0647 BGP \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u0646\u06A9\u062A\u0647 \u0637\u0631\u0627\u062D\u06CC: Border \u0628\u0627\u06CC\u062F \u062F\u0631 \u062C\u0627\u0647\u0627\u06CC\u06CC \u0628\u0627\u0634\u062F \u06A9\u0647 \u062E\u0631\u0648\u062C \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u0646\u0637\u0642\u06CC \u0627\u0633\u062A (\u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631\u060C WAN بانک) \u0648 \u0628\u0631\u0627\u06CC \u062F\u0633\u062A\u0631\u0633\u200C\u067E\u0630\u06CC\u0631\u06CC \u0628\u0627\u0644\u0627\u060C \u062F\u0648 Border \u0645\u0648\u0627\u0632\u06CC \u0628\u06AF\u0630\u0627\u0631. \u0647\u0645\u0627\u0646 LISP \u06A9\u0647 \u0628\u0647 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F \u0647\u0631 \u062C\u0627 \u0648\u0635\u0644 \u0634\u0648\u0646\u062F\u060C \u0628\u0647 \u062A\u0648 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u062F Border\u0647\u0627 \u0631\u0627 \u0647\u0645 \u0628\u0647\u200C\u0631\u0627\u062D\u062A\u06CC \u0627\u0636\u0627\u0641\u0647 \u06A9\u0646\u06CC."]},{h:"\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0641\u0627\u0628\u0631\u06CC\u06A9",p:["\u0627\u06AF\u0631 \u06A9\u0627\u0631\u0628\u0631 Authenticate \u0645\u06CC\u200C\u0634\u0648\u062F \u0648\u0644\u06CC \u0628\u0647 \u0634\u0628\u06A9\u0647 \u062F\u0633\u062A\u0631\u0633\u06CC \u0646\u062F\u0627\u0631\u062F\u060C \u062A\u0631\u062A\u06CC\u0628 \u0628\u0631\u0631\u0633\u06CC \u0627\u06CC\u0646 \u0627\u0633\u062A: \u0622\u06CC\u0627 Edge \u0628\u0647 Control-Plane Node \u0633\u0634\u0646 LISP \u062F\u0627\u0631\u062F (show lisp session)\u061F \u0622\u06CC\u0627 EID\u0647\u0627 \u062B\u0628\u062A \u0634\u062F\u0647\u200C\u0627\u0646\u062F (show lisp site)\u061F \u0622\u06CC\u0627 Underlay (IS-IS) \u0647\u0645\u0633\u0627\u06CC\u0647 \u062F\u0627\u0631\u062F\u061F \u0627\u06AF\u0631 Underlay \u062E\u0648\u0627\u0628\u06CC\u062F\u0647 \u0628\u0627\u0634\u062F\u060C LISP \u0647\u0645 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u06A9\u0627\u0631 \u06A9\u0646\u062F.","\u0646\u06A9\u062A\u0647\u200C\u0627\u06CC \u06A9\u0647 \u062F\u0631 \u062A\u06CC\u06A9\u062A \u0647\u0645\u06CC\u0646 \u0644\u0627\u0628\u0631\u0627\u062A\u0648\u0627\u0631 \u062F\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F: NET \u062A\u06A9\u0631\u0627\u0631\u06CC \u062F\u0631 IS-IS\u060C \u0647\u0645\u0633\u0627\u06CC\u06AF\u06CC \u0631\u0627 \u062E\u0631\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062F\u0631 \u0646\u062A\u06CC\u062C\u0647 \u062B\u0628\u062A EID \u0627\u0646\u062C\u0627\u0645 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u2014 \u0648 \u06A9\u0627\u0631\u0628\u0631 \u0628\u06CC\u200C\u062F\u0644\u06CC\u0644 \xAB\u0628\u062F\u0648\u0646 \u062F\u0633\u062A\u0631\u0633\u06CC\xBB \u0645\u06CC\u200C\u0634\u0648\u062F."]}],analogy:"SD-Access \u0645\u062B\u0644 \u06CC\u06A9 \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u0647\u0648\u0634\u0645\u0646\u062F \u0627\u0633\u062A: \u0622\u0633\u0627\u0646\u0633\u0648\u0631 (Underlay) \u062A\u0648 \u0631\u0627 \u0628\u0647 \u0637\u0628\u0642\u0647 \u0645\u06CC\u200C\u0628\u0631\u062F\u060C \u06A9\u0627\u0631\u062A \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC (SGT) \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0628\u0647 \u06A9\u062F\u0627\u0645 \u0627\u062A\u0627\u0642\u200C\u0647\u0627 \u0627\u062C\u0627\u0632\u0647 \u062F\u0627\u0631\u06CC\u060C \u0648 \u062F\u0641\u062A\u0631 \u067E\u0630\u06CC\u0631\u0634 \u0645\u0631\u06A9\u0632\u06CC (LISP) \u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u0647\u0631 \u06A9\u0627\u0631\u0645\u0646\u062F \u0627\u0644\u0627\u0646 \u06A9\u062C\u0627\u0633\u062A.",pitfalls:["\u062E\u0631\u0627\u0628\u06CC Underlay (\u0645\u062B\u0644 NET \u062A\u06A9\u0631\u0627\u0631\u06CC \u062F\u0631 IS-IS): \u0633\u0634\u0646 LISP \u0642\u0637\u0639 \u0648 \u0641\u0627\u0628\u0631\u06CC\u06A9 \u0628\u06CC\u200C\u0641\u0627\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u0646\u0628\u0648\u062F SGACL \u062F\u0631 ISE: SGT \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F \u0648\u0644\u06CC \u0647\u06CC\u0686 \u0633\u06CC\u0627\u0633\u062A\u06CC \u0627\u0639\u0645\u0627\u0644 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u062A\u062F\u0627\u062E\u0644 Instance-ID \u0628\u0627 VN \u0627\u0634\u062A\u0628\u0627\u0647: \u0628\u0633\u062A\u0647 \u0628\u0647 \u0641\u0627\u0628\u0631\u06CC\u06A9 \u062F\u0631\u0633\u062A \u0646\u0645\u06CC\u200C\u0631\u0633\u062F."],exam:["Control Plane \u062F\u0631 SD-Access \u0628\u0627 LISP \u0627\u0633\u062A (UDP 4342)\u060C \u0646\u0647 \u0628\u0627 BGP.","SGT \u062F\u0631 \u0647\u062F\u0631 VXLAN-GPO \u062D\u0645\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0633\u06CC\u0627\u0633\u062A \u0628\u0627 SGACL \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F.","Border \u0628\u0627 Fusion Router \u062A\u0645\u0627\u0633 \u0641\u0627\u0628\u0631\u06CC\u06A9 \u0631\u0627 \u0628\u0647 \u0628\u06CC\u0631\u0648\u0646 \u0648\u0635\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F."],glossary:[["Fabric","\u0634\u0628\u06A9\u0647 Overlay \u06CC\u06A9\u067E\u0627\u0631\u0686\u0647 \u0628\u0627 \u06A9\u0646\u062A\u0631\u0644 \u0645\u0631\u06A9\u0632\u06CC."],["EID / RLOC","\u0622\u062F\u0631\u0633 \u0627\u0646\u062A\u0647\u0627\u06CC\u06CC \u0648 \u0645\u062D\u0644 \u0648\u0627\u0642\u0639\u06CC \u0622\u0646 \u062F\u0631 \u0641\u0627\u0628\u0631\u06CC\u06A9."],["SGT","\u0628\u0631\u0686\u0633\u0628 \u06AF\u0631\u0648\u0647 \u0627\u0645\u0646\u06CC\u062A\u06CC \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 \u0647\u0648\u06CC\u062A."],["VXLAN-GPO","\u0646\u0633\u062E\u0647\u200C\u0627\u06CC \u0627\u0632 VXLAN \u06A9\u0647 SGT \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F."]]},"catalyst-center":{prereq:["automation"],related:["sda","netconf-yang","troubleshooting"],title:"Catalyst Center \u2014 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u062A\u0645\u0631\u06A9\u0632 \u0628\u0627 API",tagline:"\u0645\u062F\u06CC\u0631\u06CC\u062A \u0634\u0628\u06A9\u0647 \u0648 \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u062F\u0631 \u0627\u06CC\u0646 \u062F\u0631\u0633 \u0627\u0632 \u067E\u0646\u0644 \u06CC\u0627 Intent API \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062E\u0648\u062F Catalyst Center \u0628\u0631\u0627\u06CC \u0628\u0631\u062E\u06CC \u0648\u0638\u0627\u06CC\u0641 \u0646\u0635\u0628 \u0648 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC CLI \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u062F\u0627\u0631\u062F\u061B \u0622\u0646 \u0631\u0627 \u0628\u0627 IOS CLI \u0631\u0648\u062A\u0631 \u06CC\u0627 \u0633\u0648\u0626\u06CC\u0686 \u06CC\u06A9\u0633\u0627\u0646 \u0646\u062F\u0627\u0646\u06CC\u062F.",minutes:14,goals:["\u0686\u0631\u062E\u0647 \u06A9\u0627\u0631 Catalyst Center \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC: \u06A9\u0634\u0641 \u2192 \u0645\u0648\u062C\u0648\u062F\u06CC \u2192 \u0642\u0627\u0644\u0628 \u2192 PnP \u2192 Assurance","\u0628\u0627 Intent API \u06CC\u06A9 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0631\u0627 \u0628\u062E\u0648\u0627\u0646\u06CC \u0648 \u0642\u0627\u0644\u0628 \u0631\u0627 \u0627\u0639\u0645\u0627\u0644 \u06A9\u0646\u06CC","\u0628\u062F\u0627\u0646\u06CC \u0686\u0631\u0627 \u06CC\u06A9 \u062F\u0633\u062A\u06AF\u0627\u0647 \xABUnmanaged\xBB \u0645\u06CC\u200C\u0645\u0627\u0646\u062F \u0648 \u0686\u0637\u0648\u0631 \u0631\u0641\u0639\u0634 \u06A9\u0646\u06CC"],sections:[{h:"\u0686\u0631\u0627 \u06A9\u0646\u062A\u0631\u0644\u0631\u060C \u0648\u0642\u062A\u06CC CLI \u062F\u0627\u0631\u06CC\u0645\u061F",p:["\u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0627\u06CC \u0628\u0627 \u06F5\u06F0\u06F0 \u0633\u0648\u0626\u06CC\u0686\u060C \u0627\u062C\u0631\u0627\u06CC \u062F\u0633\u062A\u06CC \u06CC\u06A9 \u062A\u063A\u06CC\u06CC\u0631 \u0633\u0627\u062F\u0647 (\u0645\u062B\u0644\u0627\u064B \u0627\u0636\u0627\u0641\u0647\u200C\u06A9\u0631\u062F\u0646 \u06CC\u06A9 VLAN) \u06CC\u0639\u0646\u06CC \u06F5\u06F0\u06F0 \u0628\u0627\u0631 \u0648\u0635\u0644 \u0634\u062F\u0646 \u0648 \u062A\u0627\u06CC\u067E \u06A9\u0631\u062F\u0646. \u062E\u0637\u0631 \u0627\u0634\u062A\u0628\u0627\u0647 \u0647\u0645 \u0628\u0627\u0644\u0627\u0633\u062A. Catalyst Center \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0631\u0627 \u0628\u0627 \xAB\u0642\u0627\u0644\u0628\xBB \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u062F\u0647\u062F: \u06CC\u06A9 \u0628\u0627\u0631 \u0642\u0627\u0644\u0628 \u0645\u06CC\u200C\u0633\u0627\u0632\u06CC\u060C \u0628\u0639\u062F \u0631\u0648\u06CC \u0647\u0631 \u062A\u0639\u062F\u0627\u062F \u062F\u0633\u062A\u06AF\u0627\u0647 \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u06CC \u0648 \u0633\u06CC\u0633\u062A\u0645 \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u062F\u0627\u0645 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0627\u0632 \u0642\u0627\u0644\u0628 \u0641\u0627\u0635\u0644\u0647 \u06AF\u0631\u0641\u062A\u0647 \u0627\u0633\u062A (Compliance).","\u0646\u06A9\u062A\u0647 \u0645\u0647\u0645 \u0628\u0631\u0627\u06CC \u0622\u0632\u0645\u0648\u0646 \u0648 \u0628\u0631\u0627\u06CC \u0648\u0627\u0642\u0639\u06CC\u062A: \u0627\u06CC\u0646 \u0645\u062D\u0635\u0648\u0644 \u0631\u0627\u0628\u0637 \u062E\u0637 \u0641\u0631\u0645\u0627\u0646 \u0646\u062F\u0627\u0631\u062F. \u0647\u0631 \u0686\u06CC\u0632\u06CC \u06A9\u0647 \u0628\u0647\u200C\u0635\u0648\u0631\u062A DNAC# show ... \u0646\u0648\u0634\u062A\u0647 \u0634\u062F\u0647 \u0628\u0627\u0634\u062F\u060C \u0633\u0627\u062E\u062A\u06AF\u06CC \u0627\u0633\u062A. \u0645\u062F\u06CC\u0631\u06CC\u062A \u06CC\u0627 \u0627\u0632 \u0637\u0631\u06CC\u0642 GUI (Workflows) \u0627\u0633\u062A \u06CC\u0627 \u0627\u0632 \u0637\u0631\u06CC\u0642 Intent API \u0631\u0648\u06CC HTTPS."]},{h:"\u067E\u0646\u062C \u06AF\u0627\u0645 \u06A9\u0627\u0631 \u0628\u0627 \u0633\u06CC\u0633\u062A\u0645",p:["\u06AF\u0627\u0645 \u0627\u0648\u0644 \u06A9\u0634\u0641 (Discovery): \u06CC\u06A9 \u0645\u062D\u062F\u0648\u062F\u0647 IP \u0648 \u0627\u0639\u062A\u0628\u06