+DOC_RE = re.compile(r'^academy-ccna-(fundamentals|access|connectivity|services|security|automation)-(\d{2})-.+-fa\.md$')
+STAGE_RE = re.compile(r'^academy-stage-zero-(\d{2})-.+-fa\.md$')
