\u0645\u0634\u062A\u0631\u06CC \u0646\u0645\u06CC\u200C\u062F\u0627\u0646\u0646\u062F \u2014 \u0641\u0642\u0637 \u0628\u0631\u0686\u0633\u0628 \u0631\u0627 \u0639\u0648\u0636 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F.","\u0627\u06CC\u0646 \u062C\u062F\u0627\u0633\u0627\u0632\u06CC\u060C \u06A9\u0644\u06CC\u062F \u0645\u0642\u06CC\u0627\u0633\u200C\u067E\u0630\u06CC\u0631\u06CC \u0627\u0633\u062A: \u0647\u0633\u062A\u0647 \u0641\u0642\u0637 \u0628\u0627 \u0628\u0631\u0686\u0633\u0628 \u06A9\u0627\u0631 \u062F\u0627\u0631\u062F\u060C \u0628\u062F\u0648\u0646 \u0646\u06AF\u0647\u200C\u062F\u0627\u0634\u062A\u0646 \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631 \u0645\u0634\u062A\u0631\u06CC\u0627\u0646. \u0627\u06AF\u0631 \u0645\u0634\u062A\u0631\u06CC \u062C\u062F\u06CC\u062F\u06CC \u0627\u0636\u0627\u0641\u0647 \u0634\u0648\u062F\u060C \u0641\u0642\u0637 PE\u0647\u0627 \u062A\u0646\u0638\u06CC\u0645 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 P\u0647\u0627 \u0628\u062F\u0648\u0646 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u0645\u0627\u0646\u0646\u062F."]},{h:"VRF\u060C RD \u0648 RT",p:["VRF \u06CC\u06A9 \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631 \u0645\u0633\u062A\u0642\u0644 \u0628\u0627 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633\u200C\u0647\u0627\u06CC \u062E\u0648\u062F\u0634 \u0627\u0633\u062A. \u0645\u0634\u06A9\u0644\u06CC \u06A9\u0647 \u067E\u06CC\u0634 \u0645\u06CC\u200C\u0622\u06CC\u062F \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0648 \u0645\u0634\u062A\u0631\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u067E\u06CC\u0634\u0648\u0646\u062F \u06CC\u06A9\u0633\u0627\u0646 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F (\u0647\u0631 \u062F\u0648 10.1.0.0/24). \u062F\u0631 BGP\u060C \u067E\u06CC\u0634\u0648\u0646\u062F \u0628\u0627\u06CC\u062F \u06CC\u06A9\u062A\u0627 \u0634\u0648\u062F\u061B \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0628\u0627 RD \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u06CC\u06A9 \u0639\u062F\u062F \u06F8 \u0628\u0627\u06CC\u062A\u06CC \u06A9\u0647 \u062C\u0644\u0648\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F \u0645\u06CC\u200C\u0646\u0634\u06CC\u0646\u062F \u0648 \u062A\u0631\u06A9\u06CC\u0628 \u067E\u06CC\u0634\u0648\u0646\u062F + RD \u0631\u0627 \u06CC\u06A9\u062A\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F (VPNv4).","\u0627\u0645\u0627 \u06CC\u06A9\u062A\u0627\u06CC\u06CC \u06A9\u0627\u0641\u06CC \u0646\u06CC\u0633\u062A\u061B \u0628\u0627\u06CC\u062F \u0628\u06AF\u0648\u06CC\u06CC\u0645 \u06A9\u062F\u0627\u0645 \u0645\u0633\u06CC\u0631 \u0628\u0647 \u06A9\u062F\u0627\u0645 \u0645\u0634\u062A\u0631\u06CC \u0628\u0631\u0648\u062F. \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0628\u0627 RT \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u06CC\u06A9 Extended Community \u06A9\u0647 \u0647\u0646\u06AF\u0627\u0645 export \u0628\u0647 \u0645\u0633\u06CC\u0631 \u0645\u06CC\u200C\u0686\u0633\u0628\u062F \u0648 \u062F\u0631 \u0633\u0645\u062A \u062F\u06CC\u06AF\u0631 \u0647\u0646\u06AF\u0627\u0645 import \u0645\u0642\u0627\u06CC\u0633\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062A\u0646\u0647\u0627 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC\u06CC \u0648\u0627\u0631\u062F VRF \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u06A9\u0647 RT \u0622\u0646\u200C\u0647\u0627 \u062F\u0631 \u0644\u06CC\u0633\u062A import \u0622\u0646 VRF \u0628\u0627\u0634\u062F. \u067E\u0633: RD \u0628\u0631\u0627\u06CC \u06CC\u06A9\u062A\u0627\u06CC\u06CC\u060C RT \u0628\u0631\u0627\u06CC \u0633\u06CC\u0627\u0633\u062A."],list:["RD: \u06F8 \u0628\u0627\u06CC\u062A \xB7 \u06CC\u06A9\u062A\u0627\u0633\u0627\u0632\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F \u062F\u0631 VPNv4","RT: Extended Community \xB7 import/export","VRF: \u062C\u062F\u0648\u0644 \u0645\u062D\u0644\u06CC PE \u0628\u0631\u0627\u06CC \u0647\u0631 \u0645\u0634\u062A\u0631\u06CC","VPNv4: \u067E\u0631\u0648\u062A\u06A9\u0644 MP-BGP \u0628\u0631\u0627\u06CC \u062D\u0645\u0644 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC VRF"]},{h:"\u0627\u0646\u062A\u0634\u0627\u0631 \u0628\u0631\u0686\u0633\u0628 VPN \u062F\u0631 MP-BGP",p:["\u062F\u0631 \u0645\u0639\u0645\u0627\u0631\u06CC RFC 4364\u060C PE \u0622\u06AF\u0647\u06CC\u200C\u062F\u0647\u0646\u062F\u0647 \u0628\u0631\u0686\u0633\u0628 VPN \u0631\u0627 \u0647\u0645\u0631\u0627\u0647 NLRI \u0645\u0633\u06CC\u0631 VPNv4 \u0627\u0632 \u0637\u0631\u06CC\u0642 MP-BGP \u0645\u0646\u062A\u0634\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F (AFI 1\u060C SAFI 128). RFC 3107 \u0648 \u062C\u0627\u0646\u0634\u06CC\u0646 \u0622\u0646 RFC 8277 \u0646\u062D\u0648\u0647 \u062D\u0645\u0644 \u0627\u0637\u0644\u0627\u0639\u0627\u062A label \u062F\u0631 BGP \u0631\u0627 \u062A\u0634\u0631\u06CC\u062D \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F\u061B BGP-LU \u0628\u0627 SAFI 4 \u0631\u0627 \u0628\u0627 VPNv4 \u0628\u0627 SAFI 128 \u06CC\u06A9\u0633\u0627\u0646 \u0646\u062F\u0627\u0646. \u062A\u062E\u0635\u06CC\u0635 label \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0628\u0631 \u0627\u0633\u0627\u0633 VRF\u060C \u0645\u0633\u06CC\u0631 \u06CC\u0627 \u0631\u0627\u0628\u0637 \u0628\u0627\u0634\u062F \u0648 \u0627\u0644\u0632\u0627\u0645\u0627\u064B \u06CC\u06A9 label \u06CC\u06A9\u062A\u0627 \u0628\u0631\u0627\u06CC \u0647\u0631 prefix \u0646\u06CC\u0633\u062A.","PE \u0648\u0631\u0648\u062F\u06CC \u0627\u0632 label \u0627\u0639\u0644\u0627\u0645\u200C\u0634\u062F\u0647 \u062A\u0648\u0633\u0637 PE \u062E\u0631\u0648\u062C\u06CC \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F. PE \u062E\u0631\u0648\u062C\u06CC \u0646\u06AF\u0627\u0634\u062A label \u0631\u0627 \u0645\u062D\u0644\u06CC \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F \u0648 \u0628\u0646\u0627 \u0628\u0647 \u0631\u0648\u0634 \u062A\u062E\u0635\u06CC\u0635 \u0622\u0646 \u0631\u0627 \u0628\u0631\u0627\u06CC \u062A\u0639\u06CC\u06CC\u0646 VRF \u06CC\u0627 \u062E\u0631\u0648\u062C\u06CC \u0645\u0646\u0627\u0633\u0628 \u0628\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u0628\u0631\u062F. \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC VRF\u060C RT \u0648 \u0627\u062A\u0635\u0627\u0644 CE \u0647\u0645\u0686\u0646\u0627\u0646 \u0644\u0627\u0632\u0645 \u0627\u0633\u062A\u061B label \u062F\u0627\u062E\u0644\u06CC \u0631\u0627 \u0628\u0627 \u0645\u0642\u062F\u0627\u0631 \u062B\u0627\u0628\u062A \u0627\u0634\u062A\u0628\u0627\u0647 \u0646\u06AF\u06CC\u0631."],callout:{title:"\u062F\u0648 \u0628\u0631\u0686\u0633\u0628 \u062F\u0631 \u06CC\u06A9 \u0628\u0633\u062A\u0647",text:"\u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC (Transport) \u0628\u0633\u062A\u0647 \u0631\u0627 \u062A\u0627 PE \u0645\u0642\u0635\u062F \u0645\u06CC\u200C\u0628\u0631\u062F \u0648 \u0628\u0627 LDP \u06CC\u0627 Segment Routing \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0628\u0631\u0686\u0633\u0628 \u062F\u0631\u0648\u0646\u06CC (VPN) \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u062F\u0631 PE \u0645\u0642\u0635\u062F \u06A9\u062F\u0627\u0645 VRF \u0631\u0627 \u0646\u06AF\u0627\u0647 \u06A9\u0646\u062F. \u062F\u0631 \u062D\u0627\u0644\u062A PHP\u060C \u0631\u0648\u062A\u0631 \u0645\u0627\u0642\u0628\u0644 \u0622\u062E\u0631 \u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC \u0631\u0627 \u062D\u0630\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0641\u0639\u0627\u0644 \u0628\u0648\u062F\u0646 \u0648 \u062C\u0632\u0626\u06CC\u0627\u062A \u0622\u0646 \u0628\u0647 label \u0648 \u067E\u06CC\u0627\u062F\u0647\u200C\u0633\u0627\u0632\u06CC \u0648\u0627\u0628\u0633\u062A\u0647 \u0627\u0633\u062A."}},{h:"\u0645\u0633\u06CC\u0631 \u0628\u0633\u062A\u0647 \u0648 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC",p:["CE \u0628\u0647 PE \u0645\u0633\u06CC\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F \u2192 PE \u0622\u0646 \u0631\u0627 \u062F\u0631 VRF \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F \u2192 \u0628\u0627 MP-BGP (VPNv4) 