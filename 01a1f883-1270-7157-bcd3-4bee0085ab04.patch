+  await page.waitForSelector('.app-shell');
+  for (const file of ['academy-reference-ui.css', 'academy-reference-shell.js', 'academy-catalog.js', 'lesson-engine.js', 'coverage-dashboard.js', 'curriculum-catalog.json', 'academy-course-library.js', 'academy-course-library.css']) {
