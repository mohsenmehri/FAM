\u200C\u067E\u0631\u0633\u0646\u062F \xABQoS \u0686\u06CC\u0633\u062A\xBB\u061B \u0645\u06CC\u200C\u067E\u0631\u0633\u0646\u062F \xAB\u0686\u0631\u0627 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0635\u062F\u0627 \u062F\u0631 \u0633\u0627\u0639\u062A \u0634\u0644\u0648\u063A\u06CC \u062C\u06CC\u062A\u0631 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F\xBB.",minutes:15,goals:["\u062A\u0641\u0627\u0648\u062A Policing \u0648 Shaping \u0648 \u0627\u062B\u0631 \u0647\u0631\u06A9\u062F\u0627\u0645 \u0628\u0631 \u062A\u0623\u062E\u06CC\u0631 \u0648 \u0631\u06CC\u0632\u0634 \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC","\u0635\u0641\u200C\u0628\u0646\u062F\u06CC CBWFQ \u0648 LLQ \u0648 WRED \u0631\u0627 \u0628\u0627 \u067E\u0627\u0631\u0627\u0645\u062A\u0631\u0647\u0627\u06CC\u0634\u0627\u0646 \u067E\u06CC\u0627\u062F\u0647 \u06A9\u0646\u06CC","\u06CC\u06A9 \u0637\u0631\u062D QoS \u06A9\u0627\u0645\u0644 \u0631\u0627 \u0627\u0632 \u0644\u0628\u0647 \u062A\u0627 \u062E\u0631\u0648\u062C\u06CC WAN \u0637\u0631\u0627\u062D\u06CC \u06A9\u0646\u06CC"],sections:[{h:"\u0627\u0632 \u062A\u0626\u0648\u0631\u06CC \u0628\u0647 \u0633\u06CC\u0627\u0633\u062A",p:["\u062F\u0631 \u0633\u0637\u062D CCNA \u06CC\u0627\u062F \u06AF\u0631\u0641\u062A\u06CC DSCP EF \u0628\u0631\u0627\u06CC \u0635\u062F\u0627\u0633\u062A. \u062F\u0631 \u0633\u0637\u062D \u062D\u0631\u0641\u0647\u200C\u0627\u06CC \u0633\u0624\u0627\u0644 \u0627\u06CC\u0646 \u0627\u0633\u062A: \u0686\u0647 \u06A9\u0633\u06CC \u062D\u0642 \u062F\u0627\u0631\u062F EF \u0628\u06AF\u0630\u0627\u0631\u062F\u061F \u0627\u06AF\u0631 \u0647\u0645\u0647 \u0628\u062A\u0648\u0627\u0646\u0646\u062F\u060C \u0647\u06CC\u0686\u200C\u06A9\u0633 \u0627\u0648\u0644\u0648\u06CC\u062A \u0646\u062F\u0627\u0631\u062F. \u067E\u0633 \u062F\u0631 \u0644\u0628\u0647\u060C \u06CC\u06A9 policy \u062A\u0639\u0631\u06CC\u0641 \u0645\u06CC\u200C\u06A9\u0646\u06CC \u06A9\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062A\u0644\u0641\u0646\u200C\u0647\u0627\u06CC IP \u0631\u0627 \u0628\u0647 EF \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0647\u062F \u0648 \u0639\u0644\u0627\u0645\u062A \u0633\u0627\u06CC\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627 \u0631\u0627 \u0635\u0641\u0631 \u06A9\u0646\u062F (untrust). \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627\u06CC \u0634\u0628\u06A9\u0647 \u062E\u0648\u062F\u062A \u0631\u0627 \u0647\u0645 \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646 trust boundary \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u06CC.","\u0628\u0639\u062F \u0646\u0648\u0628\u062A \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC WAN \u0627\u0633\u062A. \u0644\u06CC\u0646\u06A9 WAN \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u06AF\u0644\u0648\u06AF\u0627\u0647 \u0627\u0633\u062A\u060C \u067E\u0633 \u0622\u0646\u062C\u0627 \u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u0645\u0639\u0646\u0627 \u062F\u0627\u0631\u062F\u061B \u062F\u0631 \u0644\u06CC\u0646\u06A9 LAN \u06AF\u06CC\u06AF\u0627\u0628\u06CC\u062A\u06CC \u06A9\u0647 \u0641\u0642\u0637 \u06F5\u066A \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u062A\u0642\u0631\u06CC\u0628\u0627\u064B \u0628\u06CC\u200C\u0627\u062B\u0631 \u0627\u0633\u062A."]},{h:"Shaping \u0648 Policing",p:["\u067E\u0644\u06CC\u0633\u06CC\u0646\u06AF \u0631\u0648\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0648\u0631\u0648\u062F\u06CC \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0628\u06CC\u0634 \u0627\u0632 \u0646\u0631\u062E \u0645\u062C\u0627\u0632 \u0631\u0627 \u062D\u0630\u0641 \u06CC\u0627 \u0639\u0644\u0627\u0645\u062A \u0645\u06CC\u200C\u0632\u0646\u062F. \u0634\u0627\u067E\u06CC\u0646\u06AF \u0631\u0648\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062E\u0631\u0648\u062C\u06CC \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0628\u0633\u062A\u0647\u200C\u0647\u0627 \u0631\u0627 \u062F\u0631 \u0628\u0627\u0641\u0631 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F \u062A\u0627 \u0646\u0631\u062E \u0645\u062A\u0648\u0633\u0637 \u062D\u0641\u0638 \u0634\u0648\u062F. \u062A\u0641\u0627\u0648\u062A \u0639\u0645\u0644\u06CC: \u067E\u0644\u06CC\u0633\u06CC\u0646\u06AF \u0628\u0633\u062A\u0647 \u0631\u0627 \u0645\u06CC\u200C\u0627\u0646\u062F\u0627\u0632\u062F (retransmission \u0648 \u06A9\u0646\u062F\u06CC)\u060C \u0634\u0627\u067E\u06CC\u0646\u06AF \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648\u0644\u06CC \u0631\u06CC\u0632\u0634 \u0646\u062F\u0627\u0631\u062F.","\u067E\u0627\u0631\u0627\u0645\u062A\u0631\u0647\u0627\u06CC \u0645\u0647\u0645: CIR (\u0646\u0631\u062E \u0645\u062A\u0648\u0633\u0637)\u060C Bc (\u0628\u0648\u0631\u0633\u062A \u0642\u0627\u0628\u0644 \u0642\u0628\u0648\u0644) \u0648 Be (\u0628\u0648\u0631\u0633\u062A \u0627\u0636\u0627\u0641\u0647). \u0627\u06AF\u0631 CIR \u0648 Bc \u0631\u0627 \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u06CC\u060C \u0634\u0627\u067E\u06CC\u0646\u06AF \u0628\u0627\u0639\u062B \u0645\u06CC\u200C\u0634\u0648\u062F \u0635\u0641 \u0635\u062F\u0627 \u0647\u0645 \u062A\u062D\u062A \u062A\u0623\u062B\u06CC\u0631 \u0642\u0631\u0627\u0631 \u0628\u06AF\u06CC\u0631\u062F. \u0641\u0631\u0645\u0648\u0644 \u0633\u0627\u062F\u0647: Tc = Bc / CIR \u0648 \u0628\u0631\u0627\u06CC \u0635\u062F\u0627 Tc \u06A9\u0648\u0686\u06A9\u200C\u062A\u0631 \u0628\u0647\u062A\u0631 \u0627\u0633\u062A."],list:["Policing: \u0648\u0631\u0648\u062F\u06CC \xB7 drop \u06CC\u0627 re-mark \xB7 \u0628\u062F\u0648\u0646 \u062A\u0623\u062E\u06CC\u0631","Shaping: \u062E\u0631\u0648\u062C\u06CC \xB7 buffer \xB7 \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647","CIR \xB7 Bc \xB7 Be \xB7 Tc = Bc/CIR","\u0647\u0645\u06CC\u0634\u0647 \u0628\u0647 BANK-WAN \u0628\u06AF\u0648 \u0646\u0631\u062E \u0648\u0627\u0642\u0639\u06CC \u0633\u0631\u0648\u06CC\u0633 \u0686\u0642\u062F\u0631 \u0627\u0633\u062A (\u0646\u0647 \u0646\u0631\u062E \u062E\u0637)"]},{h:"\u0635\u0641\u200C\u0647\u0627",p:["LLQ \u06CC\u06A9 \u0635\u0641 \u0627\u0648\u0644\u0648\u06CC\u062A\u200C\u062F\u0627\u0631 \u062F\u0627\u0631\u062F \u06A9\u0647 \u0642\u0628\u0644 \u0627\u0632 \u0647\u0645\u0647 \u0633\u0631\u0648\u06CC\u0633 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 \u0628\u0627 \u06CC\u06A9 policing \u062F\u0627\u062E\u0644\u06CC \u0645\u062D\u062F\u0648\u062F \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646 \u0645\u062D\u062F\u0648\u062F\u06CC\u062A\u060C \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0635\u062F\u0627 \u0628\u0642\u06CC\u0647 \u0635\u0641\u200C\u0647\u0627 \u0631\u0627 \u06AF\u0631\u0633\u0646\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F. CBWFQ \u0628\u0642\u06CC\u0647 \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F \u0631\u0627 \u0628\u0627 \u0648\u0632\u0646 \u0628\u06CC\u0646 \u06A9\u0644\u0627\u0633\u200C\u0647\u0627 \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. WRED \u0642\u0628\u0644 \u0627\u0632 \u067E\u0631 \u0634\u062F\u0646 \u0635\u0641\u060C \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC TCP \u0631\u0627 \u0628\u0627 \u0627\u062D\u062A\u0645\u0627\u0644 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u0627\u0646\u062F\u0627\u0632\u062F \u062A\u0627 \u062C\u0631\u06CC\u0627\u0646\u200C\u0647\u0627 \u0646\u0631\u0645\u200C\u062A\u0631 \u0639\u0642\u0628 \u0628\u06A9\u0634\u0646\u062F.","\u0628\u0631\u0627\u06CC \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC: class-map \u0628\u0631\u0627\u06CC \u0647\u0631 \u06A9\u0644\u0627\u0633\u060C policy-map \u0628\u0627 priority percent \u0648 bandwidth remaining percent\u060C \u0648 service-policy output \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633. \u0628\u0631\u0627\u06CC \u0635\u062F\u0627 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u06F1\u06F0 \u062A\u0627 \u06F2\u06F0 \u062F\u0631\u0635\u062F \u067E\u0647\u0