3\u06A9\u0631\u06CC\u067E\u062A: \u0628\u0627 \u0627\u0631\u062A\u0642\u0627\u06CC \u0646\u0633\u062E\u0647 \u0645\u06CC\u200C\u0634\u06A9\u0646\u062F.","\u0646\u0628\u0648\u062F idempotency: \u0627\u062C\u0631\u0627\u06CC \u062F\u0648\u0628\u0627\u0631\u0647 \u0647\u0645\u0627\u0646 playbook\u060C \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F."],exam:["NETCONF \u0631\u0648\u06CC SSH 830 \u0648 RESTCONF \u0631\u0648\u06CC HTTPS 443 \u0627\u0633\u062A.","YANG \u0632\u0628\u0627\u0646 \u0645\u062F\u0644\u200C\u0633\u0627\u0632\u06CC \u062F\u0627\u062F\u0647 \u0627\u0633\u062A\u060C \u0646\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644.","Ansible \u0628\u062F\u0648\u0646 agent \u0648 \u0628\u0627 SSH \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B Terraform \u062D\u0627\u0644\u062A\u200C\u0645\u062D\u0648\u0631 \u0627\u0633\u062A."],glossary:[["Idempotent","\u0627\u062C\u0631\u0627\u06CC \u0645\u06A9\u0631\u0631\u060C \u0646\u062A\u06CC\u062C\u0647 \u06CC\u06A9\u0633\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F."],["Dry run","\u0627\u062C\u0631\u0627\u06CC \u0622\u0632\u0645\u0627\u06CC\u0634\u06CC \u0628\u062F\u0648\u0646 \u0627\u0639\u0645\u0627\u0644 \u062A\u063A\u06CC\u06CC\u0631."],["YANG","\u0632\u0628\u0627\u0646 \u062A\u0648\u0635\u06CC\u0641 \u0645\u062F\u0644 \u062F\u0627\u062F\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647."],["gNMI","\u067E\u0631\u0648\u062A\u06A9\u0644 \u062A\u0644\u0647\u200C\u0645\u062A\u0631\u06CC \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 gRPC."]]},troubleshooting:{prereq:["subnetting"],related:["ospf-single","acl","l2-security","ipv6-routing"],title:"\u062C\u0639\u0628\u0647\u200C\u0627\u0628\u0632\u0627\u0631 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u2014 \u0631\u0648\u0634\u060C \u0646\u0647 \u062D\u062F\u0633",tagline:"\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u062D\u0631\u0641\u0647\u200C\u0627\u06CC \u06CC\u0639\u0646\u06CC \u062F\u0646\u0628\u0627\u0644 \u06A9\u0631\u062F\u0646 \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u0645\u0646\u0637\u0642\u06CC \u0627\u0632 \u0644\u0627\u06CC\u0647 \u06F1 \u062A\u0627 \u06F7\u060C \u0628\u0627 \u0634\u0648\u0627\u0647\u062F \u062F\u0631 \u0647\u0631 \u06AF\u0627\u0645.",minutes:15,goals:["\u06CC\u06A9 \u0631\u0648\u0634 \u067E\u0646\u062C\u200C\u0645\u0631\u062D\u0644\u0647\u200C\u0627\u06CC \u0628\u0631\u0627\u06CC \u0647\u0631 \u062A\u06CC\u06A9\u062A \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u06CC","\u0628\u062F\u0627\u0646\u06CC NetFlow\u060C SPAN\u060C Syslog \u0648 SNMP \u0647\u0631 \u06A9\u062F\u0627\u0645 \u0686\u0647 \u0633\u0624\u0627\u0644\u06CC \u062C\u0648\u0627\u0628 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F","\u0627\u0632 \u062E\u0631\u0648\u062C\u06CC \u062F\u0633\u062A\u0648\u0631\u0647\u0627 \u0634\u0648\u0627\u0647\u062F \u062C\u0645\u0639 \u06A9\u0646\u06CC\u060C \u0646\u0647 \u0627\u06CC\u0646\u06A9\u0647 \u062D\u062F\u0633 \u0628\u0632\u0646\u06CC"],sections:[{h:"\u0631\u0648\u0634 \u067E\u0646\u062C\u200C\u0645\u0631\u062D\u0644\u0647\u200C\u0627\u06CC",p:["\u0627\u0648\u0644 \u0645\u0633\u0626\u0644\u0647 \u0631\u0627 \u062F\u0642\u06CC\u0642 \u062A\u0639\u0631\u06CC\u0641 \u06A9\u0646: \u0686\u0647 \u06A9\u0633\u06CC\u060C \u0686\u0647 \u0686\u06CC\u0632\u06CC\u060C \u0627\u0632 \u06A9\u062C\u0627\u060C \u0627\u0632 \u0686\u0647 \u0632\u0645\u0627\u0646\u06CC\u061F \xABWAN بانک \u0642\u0637\u0639 \u0627\u0633\u062A\xBB \u06CC\u06A9 \u0634\u06A9\u0627\u06CC\u062A \u0627\u0633\u062A\u060C \u0646\u0647 \u0645\u0633\u0626\u0644\u0647. \xAB\u06A9\u0627\u0631\u0628\u0631\u0627\u0646 VLAN 20 \u0627\u0632 \u0633\u0627\u0639\u062A \u06F9 \u0635\u0628\u062D \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u0628\u0647 \u0633\u0631\u0648\u0631 10.10.10.50 \u0648\u0635\u0644 \u0634\u0648\u0646\u062F\xBB \u06CC\u06A9 \u0645\u0633\u0626\u0644\u0647 \u0642\u0627\u0628\u0644 \u0628\u0631\u0631\u0633\u06CC \u0627\u0633\u062A. \u062F\u0648\u0645\u060C \u062F\u0627\u0645\u0646\u0647 \u0631\u0627 \u0645\u062D\u062F\u0648\u062F \u06A9\u0646: \u06CC\u06A9 \u06A9\u0627\u0631\u0628\u0631 \u06CC\u0627 \u0647\u0645\u0647\u061F \u06CC\u06A9 \u0633\u0627\u06CC\u062A \u06CC\u0627 \u0647\u0645\u0647 \u0633\u0627\u06CC\u062A\u200C\u0647\u0627\u061F \u0627\u06CC\u0646 \u062F\u0648 \u0633\u0624\u0627\u0644\u060C \u0646\u06CC\u0645\u06CC \u0627\u0632 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0627\u0633\u062A.","\u0633\u0648\u0645\u060C \u0627\u0632 \u067E\u0627\u06CC\u06CC\u0646 \u0628\u0647 \u0628\u0627\u0644\u0627 \u0628\u0631\u0648: \u0644\u06CC\u0646\u06A9 \u0641\u06CC\u0632\u06CC\u06A9\u06CC\u060C \u0622\u062F\u0631\u0633\u200C\u062F\u0647\u06CC (IP/DHCP)\u060C \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC\u060C \u0641\u0627\u06CC\u0631\u0648\u0627\u0644/ACL\u060C \u0633\u0631\u0648\u06CC\u0633 (DNS/HTTP). \u0686\u0647\u0627\u0631\u0645\u060C \u0641\u0631\u0636\u06CC\u0647 \u0628\u0633\u0627\u0632 \u0648 \u0628\u0627 \u06CC\u06A9 \u062A\u0633\u062A \u0622\u0646 \u0631\u0627 \u0631\u062F \u06CC\u0627 \u062A\u0623\u06CC\u06CC\u062F \u06A9\u0646 \u2014 \u0646\u0647 \u0627\u06CC\u0646\u06A9\u0647 \u0686\u0646\u062F \u062A\u063A\u06CC\u06CC\u0631 \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0628\u062F\u0647\u06CC. \u067E\u0646\u062C\u0645\u060C \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0627 \u0645\u0633\u062A\u0646\u062F \u06A9\u0646 \u0648 \u0627\u0632 \u0631\u06CC\u0634\u0647 (root cause) \u0645\u0637\u0645\u0626\u0646 \u0634\u0648\u060C \u0646\u0647 \u0641\u0642\u0637 \u0627\u0632 \u0631\u0641\u0639 \u0638\u0627\u0647\u0631\u06CC."]},{h:"\u0627\u0628\u0632\u0627\u0631\u0647\u0627 \u0648 \u0633\u0624\u0627\u0644 \u0647\u0631 \u06A9\u062F\u0627\u0645",p:["NetFlow \u0628\u0647 \u062A\u0648 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0686\u0647 \u06A9\u0633\u06CC \u0628\u0627 \u0686\u0647 \u06A9\u0633\u06CC \u062D\u0631\u0641 \u0645\u06CC\u200C\u0632\u0646\u062F \u0648 \u0686\u0642\u062F\u0631 (\u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F\u060C \u062A\u0639\u062F\u0627\u062F \u062C\u0631\u06CC\u0627\u0646). SPAN \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u06A9\u067E\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u062A\u0627 \u0628\u0627 Wireshark \u0628\u0633\u062A\u0647\u200C\u0647\u0627 \u0631\u0627 \u0628\u0628\u06CC\u0646\u06CC. Syslog \u062A\u0627\u0631\u06CC\u062E \u0631\u062E\u062F\u0627\u062F\u0647\u0627 \u0631\u0627 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F. SNMP \u0648\u0636\u0639\u06CC\u062A \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647\u200C\u0647\u0627 \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F. IPSLA \u0645\u0633\u06CC\u0631 \u0648 \u06A9\u06CC\u0641\u06CC\u062A \u0631\u0627 \u0645\u06CC\u200C\u0633\u0646\u062C\u062F. \u0647\u0631 \u06A9\u062F\u0627\u0645 \u06CC\u06A9 \u0633\u0624\u0627\u0644 \u0645\u062A\u0641\u0627\u0648\u062A \u0631\u0627 \u062C\u0648\u0627\u0628 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F \u0648 \u062C\u0627\u06CC \u0647\u0645 \u0631\u0627 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F.","\u0628\u0631\u0627\u06CC \u062F\u06CC\u062F\u0646 \u0645\u0633\u06CC\u0631 \u0648\u0627\u0642\u0639\u06CC\u060C traceroute \u0648 \u0628\u0631\u0627\u06CC \u062F\u06CC\u062F\u0646 \u0645\u0633\u06CC\u0631 \u067E\u0648\u06CC\u0627\u060C show ip route \u06A9\u0627\u0641\u06CC \u0627\u0633\u062A\u061B \u0648\u0644\u06CC \u0627\u06AF\u0631 \u0645\u0634\u06A9\u0644 \xAB\u06A9\u064F\u0646\u062F\u06CC\xBB \u0628\u0627\u0634\u062F\u060C \u0634\u0645\u0627\u0631\u0646\u062F\u0647 interface (\u0628\u0627\u06CC\u062A\u060C \u062E\u0637\u0627\u060C CRC\u060C drops) \u0627\u0648\u0644\u06CC\u0646 \u0686\u06CC\u0632\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0628\u0627\u06CC\u062F \u0646\u06AF\u0627\u0647 \u06A9\u0646\u06CC."],list:["NetFlow: \u0686\u0647 \u06A9\u0633\u06CC\u060C \u0686\u0642\u062F\u0631\u060C \u0628\u0647 \u06A9\u062C\u0627","SPAN: \u0645\u062D\u062A\u0648\u0627\u06CC \u0628\u0633\u062A\u0647\u200C\u0647\u0627 \u0686\u06CC\u0633\u062A","Syslog: \u0686\u0647 \u0632\u0645\u0627\u0646\u06CC \u0686\u0647 \u0627\u062A\u0641\u0627\u0642\u06CC \u0627\u0641\u062A\u0627\u062F","SNMP: \u0648\u0636\u0639\u06CC\u062A \u062F\u0633\u062A\u06AF\u0627\u0647 \u0648 \u0631\u0648\u0646\u062F\u0647\u0627"]},{h:"\u0627\u0634\u062A\u0628\u0627\u0647\u200C\u0647\u0627\u06CC \u0631\u0627\u06CC\u062C \u062F\u0631 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC",p:["\u0627\u0648\u0644\u06CC\u0646 \u0627\u0634\u062A\u0628\u0627\u0647: \u062A\u063A\u06CC\u06CC\u0631 \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0686\u0646\u062F \u0686\u06CC\u0632. \u0627\u06AF\u0631 \u0628\u0639\u062F \u0627\u0632 \u0633\u0647 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0631\u0633\u062A \u0634\u062F\u060C \u0646\u0645\u06CC\u200C\u062F\u0627\u0646\u06CC \u06A9\u062F\u0627\u0645 \u0645\u0624\u062B\u0631 \u0628\u0648\u062F \u0648 \u0634\u0627\u06CC\u062F \u062F\u0648 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u06CC\u06AF\u0631 \u0645\u0634\u06A9\u0644 \u062C\u062F\u06CC\u062F \u0633\u0627\u062E\u062A\u0647 \u0628\u0627\u0634\u0646\u062F. \u062F\u0648\u0645\u06CC\u0646: \u0646\u062F\u0627\u0634\u062A\u0646 \u0628\u06A9\u0627\u067E \u0642\u0628\u0644 \u0627\u0632 \u062A\u063A\u06CC\u06CC\u0631. \u0633\u0648\u0645\u06CC\u0646: \u0641\u0631\u0636 \u0627\u06CC\u0646\u06A9\u0647 \u0645\u0634\u06A9\u0644 \u0627\u0632 \u062F\u0633\u062A\u06AF\u0627\u0647 \u062F\u06CC\u06AF\u0631 \u0627\u0633\u062A.","\u0686\u0647\u0627\u0631\u0645\u06CC\u0646 \u0648 \u0645\u0647\u0645\u200C\u062A\u0631\u06CC\u0646: \u0646\u062F\u06CC\u062F\u0646 \u06A9\u0644 \u0645\u0633\u06CC\u0631. \u062F\u0631 \u0628\u06CC\u0634\u062A\u0631 \u062A\u06CC\u06A9\u062A\u200C\u0647\u0627\u060C \u0645\u0634\u06A9\u0644 \u062C\u0627\u06CC\u06CC \u0627\u0633\u062A \u06A9\u0647 \u06A9\u0633\u06CC \u0628\u0647 \u0622\u0646 \u0646\u06AF\u0627\u0647 \u0646\u06A9\u0631\u062F\u0647: DNS\u060C MTU\u060C \u06CC\u0627 \u06CC\u06A9 ACL \u06A9\u0647 \u0647\u0641\u062A\u0647 \u067E\u06CC\u0634 \u0627\u0636\u0627\u0641\u0647 \u0634\u062F\u0647. \u06CC\u06A9 \u0639\u0627\u062F\u062A \u062E\u0648\u0628: \u0642\u0628\u0644 \u0627\u0632 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0639\u0645\u06CC\u0642\u060C \u0628\u067E\u0631\u0633 \xAB\u0686\u0647 \u0686\u06CC\u0632\u06CC \u0627\u062E\u06CC\u0631\u0627\u064B \u0639\u0648\u0636 \u0634\u062F\u061F\xBB"]},{h:"\u0645\u0633\u062A\u0646\u062F\u0633\u0627\u0632\u06CC \u0648 \u0627\u0646\u062A\u0642\u0627\u0644 \u062F\u0627\u0646\u0634",p:["\u062A\u06CC\u06A9\u062A\u06CC \u06A9\u0647 \u0631\u0641\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648\u0644\u06CC \u0645\u0633\u062A\u0646\u062F \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u062F\u0648\u0628\u0627\u0631\u0647 \u062A\u06A9\u0631\u0627\u0631 \u062E\u0648\u0627\u0647\u062F \u0634\u062F. \u0628\u0631\u0627\u06CC \u0647\u0631 \u062D\u0627\u062F\u062B\u0647 \u0633\u0647 \u0686\u06CC\u0632 \u0631\u0627 \u062B\u0628\u062A \u06A9\u0646: \u0639\u0644\u062A \u0631\u06CC\u0634\u0647\u200C\u0627\u06CC (root cause)\u060C \u0627\u0642\u062F\u0627\u0645\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0645\u0624\u062B\u0631 \u0628\u0648\u062F\u0646\u062F \u0648 \u0627\u0642\u062F\u0627\u0645\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0641\u0642\u0637 \u0648\u0642\u062A \u06AF\u0631\u0641\u062A\u0646\u062F. \u0627\u06CC\u0646 \u062B\u0628\u062A \u06A9\u0648\u062A\u0627\u0647\u060C \u062F\u0641\u0639\u0647 \u0628\u0639\u062F \u062C\u0633\u062A\u200C\u0648\u062C\u0648 \u0631\u0627 \u0627\u0632 \u0633\u0627\u0639\u062A\u200C\u0647\u0627 \u0628\u0647 \u062F\u0642\u06CC\u0642\u0647 \u06A9\u0627\u0647\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F.","\u06CC\u06A9 \u0631\u0627\u0646\u0628\u0648\u06A9 \u062E\u0648\u0628 \u0628\u0631\u0627\u06CC \u0647\u0631 \u0633\u0631\u0648\u06CC\u0633 \u0628\u0646\u0648\u06CC\u0633: \u0686\u0637\u0648\u0631 \u0633\u0627\u0644\u0645 \u0628\u0648\u062F\u0646\u0634 \u0631\u0627 \u0686\u06A9 \u06A9\u0646\u0645\u060C \u0627\u06AF\u0631 X \u062E\u0637\u0627 \u062F\u0627\u062F \u0627\u0648\u0644 \u0686\u0647 \u0686\u06CC\u0632\u06CC \u0631\u0627 \u0628\u0628\u06CC\u0646\u0645\u060C \u0648 \u0686\u0647 \u06A9\u0633\u06CC \u0628\u0627\u06CC\u062F \u062E\u0628\u0631 \u0634\u0648\u062F. \u0628\u0647\u062A\u0631\u06CC\u0646 \u062A\u06CC\u0645\u200C\u0647\u0627 \u0631\u0627\u0646\u0628\u0648\u06A9\u06CC \u062F\u0627\u0631\u0646\u062F \u06A9\u0647 \u06CC\u06A9 \u0646\u0641\u0631 \u062A\u0627\u0632\u0647\u200C\u06A9\u0627\u0631 \u0647\u0645 \u0628\u062A\u0648\u0627\u0646\u062F \u0628\u0627 \u0622\u0646 \u0627\u0648\u0644\u06CC\u0646 \u0642\u062F\u0645\u200C\u0647\u0627 \u0631\u0627 \u0628\u0631\u062F\u0627\u0631\u062F. \u0628\u0647 \u0627\u06CC\u0646 \u062A\u0631\u062A\u06CC\u0628 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0627\u0632 \u06CC\u06A9 \u0645\u0647\u0627\u0631\u062A \u0641\u0631\u062F\u06CC \u0628\u0647 \u06CC\u06A9 \u0641\u0631\u0627\u06CC\u0646\u062F \u0633\u0627\u0632\u0645\u0627\u0646\u06CC \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F."],callout:{title:"\u067E\u0633 \u0627\u0632 \u062D\u0627\u062F\u062B\u0647",text:"\u062C\u0644\u0633\u0647 \u0628\u0627\u0632\u0628\u06CC\u0646\u06CC \u0628\u062F\u0648\u0646 \u0645\u0642\u0635\u0631\u062A\u0631\u0627\u0634\u06CC (blameless): \u0647\u062F\u0641 \u06CC\u0627\u062F\u06AF\u06CC\u0631\u06CC \u0633\u06CC\u0633\u062A\u0645 \u0627\u0633\u062A\u060C \u0646\u0647 \u067E\u06CC\u062F\u0627 \u06A9\u0631\u062F\u0646 \u0641\u0631\u062F. \u0627\u06AF\u0631 \u0627\u0641\u0631\u0627\u062F \u0627\u0632 \u06AF\u0632\u0627\u0631\u0634 \u062E\u0637\u0627 \u0628\u062A\u0631\u0633\u0646\u062F\u060C \u062D\u0627\u062F\u062B\u0647 \u0628\u0639\u062F\u06CC \u062F\u06CC\u0631\u062A\u0631 \u06AF\u0632\u0627\u0631\u0634 \u0645\u06CC\u200C\u0634\u0648\u062F."}}],analogy:"\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0645\u062B\u0644 \u06A9\u0627\u0631\u0622\u06AF\u0627\u0647 \u0627\u0633\u062A: \u0627\u0648\u0644 \u0635\u062D\u0646\u0647 \u062C\u0631\u0645 \u0631\u0627 \u062A\u0648\u0635\u06CC\u0641 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u060C \u0628\u0639\u062F \u0634\u0648\u0627\u0647\u062F \u062C\u0645\u0639 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u060C \u0628\u0639\u062F \u0641\u0631\u0636\u06CC\u0647 \u0645\u06CC\u200C\u0633\u0627\u0632\u06CC \u0648 \u0622\u0632\u0645\u0627\u06CC\u0634\u0634 \u0645\u06CC\u200C\u06A9\u0646\u06CC. \u06A9\u0633\u06CC \u06A9\u0647 \u0641\u0642\u0637 \u062D\u062F\u0633 \u0645\u06CC\u200C\u0632\u0646\u062F\u060C \u062F\u0631 \u0646\u0647\u0627\u06CC\u062A \u0686\u0646\u062F \u0686\u06CC\u0632 \u0631\u0627 \u0639\u0648\u0636 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0646\u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u06A9\u062F\u0627\u0645 \u062F\u0631\u0633\u062A \u0628\u0648\u062F.",pitfalls:["\u062A\u063A\u06CC\u06CC\u0631 \u0686\u0646\u062F \u067E\u0627\u0631\u0627\u0645\u062A\u0631 \u0647\u0645\u200C\u0632\u0645\u0627\u0646: \u0627\u0632 \u062F\u0633\u062A \u062F\u0627\u062F\u0646 \u0639\u0644\u062A \u0648\u0627\u0642\u0639\u06CC.","\u0628\u06CC\u200C\u062A\u0648\u062C\u0647\u06CC \u0628\u0647 \u0632\u0645\u0627\u0646: \u0644\u0627\u06AF\u200C\u0647\u0627 \u0631\u0627 \u0628\u0627\u06CC\u062F \u0628\u0627 \u0633\u0627\u0639\u062A \u062F\u0631\u0633\u062A \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646\u06CC (NTP!).","\u0646\u0627\u062F\u06CC\u062F\u0647 \u06AF\u0631\u0641\u062A\u0646 \u0644\u0627\u06CC\u0647 \u06F1: \u06A9\u0627\u0628\u0644\u060C SFP \u0648 CRC \u062E\u06CC\u0644\u06CC \u0628\u06CC\u0634\u062A\u0631 \u0627\u0632 \u0622\u0646\u0686\u0647 \u0641\u06A9\u0631 \u0645\u06CC\u200C\u06A9\u0646\u06CC \u0645\u0634\u06A9\u0644 \u0645\u06CC\u200C\u0633\u0627\u0632\u0646\u062F."],exam:["\u062A\u0631\u062A\u06CC\u0628 \u0644\u0627\u06CC\u0647\u200C\u0647\u0627 \u062F\u0631 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC: \u06F1\u060C \u06F2\u060C \u06F3\u060C \u0628\u0639\u062F \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627.","NetFlow \u0622\u0645\u0627\u0631 \u062C\u0631\u06CC\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F\u061B SPAN \u0645\u062D\u062A\u0648\u0627\u06CC \u0628\u0633\u062A\u0647.","Syslog \u0646\u06CC\u0627\u0632\u0645\u0646\u062F NTP \u0647\u0645\u0627\u0647\u0646\u06AF \u0627\u0633\u062A \u062A\u0627 \u0632\u0645\u0627\u0646\u200C\u0647\u0627 \u0642\u0627\u0628\u0644 \u0645\u0642\u0627\u06CC\u0633\u0647 \u0628\u0627\u0634\u0646\u062F."],glossary:[["NetFlow","\u0633\u06CC\u0633\u062A\u0645 \u062C\u0645\u0639\u200C\u0622\u0648\u0631\u06CC \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u062C\u0631\u06CC\u0627\u0646\u200C\u0647\u0627."],["SPAN","\u06A9\u067E\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u06CC\u06A9 \u067E\u0648\u0631\u062A \u0628\u0647 \u067E\u0648\u0631\u062A \u0645\u0627\u0646\u06CC\u062A\u0648\u0631."],["Syslog","\u0633\u06CC\u0633\u062A\u0645 \u0627\u0631\u0633\u0627\u0644 \u0648 \u0646\u06AF\u0647\u200C\u062F\u0627\u0631\u06CC \u0644\u0627\u06AF."],["Root cause","\u0639\u0644\u062A \u0627\u0635\u0644\u06CC\u060C \u0646\u0647 \u0639\u0644\u0627\u0645\u062A \u0638\u0627\u0647\u0631\u06CC."]]},redistribution:{prereq:["ospf-single","eigrp"],related:["ospf-multi","bgp","bgp-advanced"],title:"\u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0645\u0633\u06CC\u0631 (Redistribution) \u2014 \u067E\u0644 \u0628\u06CC\u0646 \u062F\u0648 \u062F\u0646\u06CC\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC",tagline:"\u062F\u0648 \u067E\u0631\u0648\u062A\u06A9\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0632\u0628\u0627\u0646 \u0647\u0645 \u0631\u0627 \u0646\u0645\u06CC\u200C\u0641\u0647\u0645\u0646\u062F\u061B \u0627\u06AF\u0631 \u0645\u0633\u06CC\u0631\u0647\u0627 \u0631\u0627 \u062A\u0631\u062C\u0645\u0647 \u0646\u06A9\u0646\u06CC\u060C \u062F\u0648 \u0646\u06CC\u0645\u0647 \u0634\u0628\u06A9\u0647 \u0647\u0631\u06AF\u0632 \u0647\u0645 \u0631\u0627 \u0646\u0645\u06CC\u200C\u0628\u06CC\u0646\u0