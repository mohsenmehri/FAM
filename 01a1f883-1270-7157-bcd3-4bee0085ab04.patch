@@ -0,0 +1,115 @@
+import { chromium } from 'playwright';
+import { spawn } from 'node:child_process';
+import { createInterface } from 'node:readline';
+import assert from 'node:assert/strict';
+
+// Disposable Flask/SQLite instance only; never connects to LAB or Production.
+const server = spawn(process.env.PYTHON || 'python3', ['tests/e2e/academy_flask_server.py'], { stdio: ['ignore', 'pipe', 'inherit'] });
+const lines = createInterface({ input: server.stdout });
+let browser;
+let checkpoint = 'start isolated server';
+try {
+  const port = await new Promise((resolve, reject) => {
+    lines.once('line', resolve);
+    server.once('error', reject);
+    server.once('exit', code => reject(new Error(`Isolated Flask server exited: ${code}`)));
+  });
+  const origin = `http://127.0.0.1:${port}`;
+  browser = await chromium.launch({ headless: true, ...(process.env.CHROMIUM_EXECUTABLE_PATH ? { executablePath: process.env.CHROMIUM_EXECUTABLE_PATH, args: ['--no-sandbox'] } : {}) });
+  const page = await browser.newPage({ viewport: { width: 1360, height: 1000 } });
+  const errors = [];
+  const responses = new Map();
+  page.on('pageerror', error => errors.push(error.message));
+  page.on('response', response => {
+    const pathname = new URL(response.url()).pathname;
+    if (pathname.startsWith('/academy-assets/') || pathname.startsWith('/academy-content/')) {
+      responses.set(pathname, response.status());
+    }
+  });
+
+  checkpoint = 'anonymous content gate';
+  await page.goto(origin + '/');
+  const anonymousStatus = await page.evaluate(async () => (await fetch('/academy-content/catalog.json')).status);
+  assert.equal(anonymousStatus, 401, 'Course content must require a FAM session');
+
+  checkpoint = 'fixture login';
+  const loginStatus = await page.evaluate(async () => (await fetch('/api/login', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ username: 'admin', password: '1109' })
+  })).status);
+  assert.equal(loginStatus, 200);
+  checkpoint = 'Academy dashboard and library assets';
+  await page.goto(origin + '/academy', { waitUntil: 'networkidle' });
+  if (await page.locator('.journey-skip').count()) await page.locator('.journey-skip').click();
+  await page.waitForSelector('.fa-dashboard');
+  for (const file of ['academy-reference-shell.js', 'academy-course-library.js', 'academy-course-library.css']) {
+    assert.equal(responses.get(`/academy-assets/${file}`), 200, file);
+  }
+
+  checkpoint = 'open library and verify summary counts';
+  await page.locator('.side-link[data-action="library"]').click();
+  await page.waitForSelector('.fam-library-dashboard');
+  assert.equal(await page.locator('.fam-library-stat').nth(0).locator('strong').textContent(), '10');
+  assert.equal(await page.locator('.fam-library-stat').nth(1).locator('strong').textContent(), '59');
+  assert.equal(await page.locator('.fam-library-stat').nth(2).locator('strong').textContent(), '27');
+  assert.equal(await page.locator('.fam-library-stat').nth(3).locator('strong').textContent(), '2');
+  assert.equal(await page.locator('.fam-library-stat').nth(4).locator('strong').textContent(), '52');
+
+  checkpoint = 'stage-zero filter';
+  await page.locator('[data-library-filter="stage-zero"]').click();
+  assert.equal(await page.locator('.fam-library-card').count(), 10);
+  checkpoint = 'CCNA filter';
+  await page.locator('[data-library-filter="ccna"]').click();
+  assert.equal(await page.locator('.fam-library-card').count(), 59);
+  checkpoint = 'worksheet filter and embedded lesson anchor';
+  await page.locator('[data-library-filter="worksheets"]').click();
+  assert.equal(await page.locator('.fam-library-card').count(), 29);
+  await page.locator('.fam-library-card').first().click();
+  await page.waitForSelector('.fam-library-document .fam-course-markdown');
+  await page.waitForFunction(() => document.getElementById('heading-16')?.textContent.includes('کاربرگ مستقل PNETLab'));
+  assert.match(await page.locator('#heading-16').textContent(), /کاربرگ مستقل PNETLab/);
+
+  checkpoint = 'back navigation and search by lesson code';
+  await page.locator('.fam-library-document-header .fam-library-back').click();
+  await page.waitForSelector('.fam-library-dashboard');
+  await page.locator('[data-library-filter="ccna"]').click();
+  await page.locator('.fam-library-search input').fill('NA-04');
+  assert.equal(await page.locator('.fam-library-card').count(), 1, 'Search should narrow the CCNA list by lesson code');
+  await page.locator('.fam-library-card').first().click();
+  await page.waitForSelector('.fam-library-document .fam-course-markdown');
+  const codeSamples = await page.locator('.fam-course-inline-code').allTextContents();
+  assert(codeSamples.some(text => text.includes('encapsulation dot1Q <id>')), 'XML-like placeholder must remain literal code text');
+  assert.equal(await page.locator('.fam-course-markdown id').count(), 0, 'Markdown must not create raw HTML elements');
+  assert.equal(await page.locator('.fam-course-markdown').evaluate(node => getComputedStyle(node).direction), 'rtl');
+
+  checkpoint = 'diagram filter and SVG delivery';
+  await page.locator('.fam-library-document-header .fam-library-back').click();
+  await page.waitForSelector('.fam-library-dashboard');
+  await page.locator('.fam-library-search input').fill('');
+  await page.locator('[data-library-filter="diagrams"]').click();
+  assert.equal(await page.locator('.fam-library-diagram-card').count(), 52);
+  const firstImage = page.locator('.fam-library-diagram-image').first();
+  await firstImage.waitFor({ state: 'visible' });
+  await page.waitForFunction(() => {
+    const image = document.querySelector('.fam-library-diagram-image');
+    return image && image.complete && image.naturalWidth > 0;
+  });
+  assert.equal(await page.locator('.fam-library-inline-link').count(), 52);
+
+  checkpoint = 'reference filter, protected responses and final page errors';
+  await page.locator('[data-library-filter="references"]').click();
+  assert.equal(await page.locator('.fam-library-card').count(), 5);
+  assert.equal(responses.get('/academy-content/catalog.json'), 200);
+  assert.equal(responses.get('/academy-content/academy-ccna-access-04-intervlan-router-stick-fa.md'), 200);
+  assert.deepEqual(errors, []);
+  console.log('PASS: authenticated Academy library, 76 Markdown docs, 29 worksheet entries, 52 SVG diagrams, raw-tag safety and reference navigation');
+} catch (error) {
+  const details = String(error?.message || error).replace(/[%\r\n]/g, ' ');
+  console.error(`::error file=tests/e2e/academy-library.spec.mjs,title=Academy library E2E::${checkpoint}: ${details}`);
+  throw error;
+} finally {
+  if (browser) await browser.close();
+  server.kill('SIGTERM');
+  lines.close();
+}
