+    def test_rest_worksheet_requests_without_cli_secrets(self):
+        lab = self.load('rest-json')['stages']['lab']['html']
+        script = html.unescape(re.search(r'<pre[^>]*><code>(.*?)</code></pre>', lab, re.S).group(1))
+        compile(script, 'rest-worksheet', 'exec')
+        requests = []
+        class Response:
+            def __init__(self, payload): self.payload = payload
+            def __enter__(self): return io.BytesIO(json.dumps(self.payload).encode())
+            def __exit__(self, *args): return False
+        def fake_open(request, *, timeout):
+            requests.append(request)
+            return Response({'Token': 'sensitive-token'} if len(requests) == 1 else {'response': [{'hostname': 'SW1'}]})
+        out = io.StringIO()
+        with patch('builtins.input', return_value='test-user'), patch('getpass.getpass', return_value='sensitive-password'), \
+             patch('ssl.create_default_context', return_value=object()), patch('urllib.request.build_opener') as build_opener, \
+             contextlib.redirect_stdout(out):
+            build_opener.return_value.open.side_effect = fake_open
+            exec(compile(script, 'rest-worksheet', 'exec'), {})
+            no_redirect = build_opener.call_args.args[1]
+            self.assertIsNone(no_redirect.redirect_request(None, None, 302, '', {}, 'https://other.example'))
+        self.assertEqual(len(requests), 2)
+        self.assertEqual(requests[0].get_method(), 'POST')
+        self.assertTrue(requests[0].get_header('Authorization').startswith('Basic '))
+        self.assertEqual(requests[1].get_header('X-auth-token'), 'sensitive-token')
+        self.assertEqual(requests[1].get_method(), 'GET')
+        self.assertIn('SW1', out.getvalue())
+        self.assertNotIn('sensitive-token', out.getvalue())
+        self.assertNotIn('sensitive-password', out.getvalue())
+        self.assertNotIn('curl', script)
