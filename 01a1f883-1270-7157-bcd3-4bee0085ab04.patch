u06AF\u0631 \u0644\u0627\u06CC\u0647 \u0633\u0648\u0645 \u0631\u0627 \u062D\u0644 \u0646\u06A9\u0646\u06CC\u060C \u062F\u0648 \u0644\u0627\u06CC\u0647 \u0627\u0648\u0644 \u0641\u0642\u0637 \u0633\u0631\u0639\u062A \u0631\u0633\u06CC\u062F\u0646 \u06A9\u0627\u0631\u0628\u0631 \u0628\u0647 \u062E\u0637\u0627 \u0631\u0627 \u0627\u0641\u0632\u0627\u06CC\u0634 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F.","\u0642\u0627\u0639\u062F\u0647 \u0627\u0646\u062A\u062E\u0627\u0628: \u0633\u0631\u0648\u06CC\u0633 \u0628\u06CC\u200C\u062D\u0627\u0644\u062A (API\u060C \u0645\u062D\u062A\u0648\u0627\u06CC \u0639\u0645\u0648\u0645\u06CC) \u2192 anycast \u0633\u0627\u062F\u0647 \u0648 \u0633\u0631\u06CC\u0639\u061B \u0633\u0631\u0648\u06CC\u0633 \u062D\u0627\u0644\u062A\u200C\u062F\u0627\u0631 (\u067E\u0631\u062F\u0627\u062E\u062A\u060C \u0628\u0627\u0646\u06A9\u062F\u0627\u0631\u06CC) \u2192 GSLB \u0622\u06AF\u0627\u0647 \u0627\u0632 \u0646\u0634\u0633\u062A \u06CC\u0627 anycast \u0628\u0627 state \u0645\u0634\u062A\u0631\u06A9."]},{h:"RTO \u0648\u0627\u0642\u0639\u06CC \u0628\u0627 DNS",p:["TTL \u06CC\u06A9 \u0639\u062F\u062F \u067E\u0646\u0647\u0627\u0646 \u062F\u0631 RTO \u0627\u0633\u062A. \u0627\u06AF\u0631 TTL \u0631\u06A9\u0648\u0631\u062F \u06F3\u06F6\u06F0\u06F0 \u062B\u0627\u0646\u06CC\u0647 \u0628\u0627\u0634\u062F\u060C \u062D\u062A\u06CC failover \u0628\u06CC\u200C\u0646\u0642\u0635 \u0647\u0645 \u06CC\u06A9 \u0633\u0627\u0639\u062A \u0637\u0648\u0644 \u0645\u06CC\u200C\u06A9\u0634\u062F \u0686\u0648\u0646 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0622\u062F\u0631\u0633 \u0642\u062F\u06CC\u0645\u06CC \u0631\u0627 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F. TTL \u06A9\u0648\u062A\u0627\u0647 \u0647\u0632\u06CC\u0646\u0647 \u062F\u0627\u0631\u062F (\u0628\u0627\u0631 \u06A9\u0648\u0626\u0631\u06CC) \u0648\u0644\u06CC \u0628\u0631\u0627\u06CC \u0631\u06A9\u0648\u0631\u062F\u0647\u0627\u06CC \u0628\u062D\u0631\u0627\u0646\u06CC \u0644\u0627\u0632\u0645 \u0627\