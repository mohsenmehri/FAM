re (\u062F\u0648 \u0644\u0627\u06CC\u0647) \u0628\u0631\u0627\u06CC \u0634\u0639\u0628\u0647 \u0648 \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u0645\u062A\u0648\u0633\u0637. \u0645\u062F\u0644 spine-leaf \u0628\u0631\u0627\u06CC \u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631 \u06A9\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0634\u0631\u0642\u06CC-\u063A\u0631\u0628\u06CC \u0632\u06CC\u0627\u062F \u0627\u0633\u062A.","\u062F\u0631 \u0647\u0631 \u0645\u062F\u0644\u060C \u0627\u0635\u0644 \u062B\u0627\u0628\u062A \u0627\u0633\u062A: \u0645\u0633\u06CC\u0631 \u062F\u0627\u062F\u0647 \u0628\u0627\u06CC\u062F \u06A9\u0648\u062A\u0627\u0647 \u0648 \u067E\u06CC\u0634\u200C\u0628\u06CC\u0646\u06CC\u200C\u067E\u0630\u06CC\u0631 \u0628\u0627\u0634\u062F \u0648 \u0633\u06CC\u0627\u0633\u062A \u062F\u0631 \u0646\u0642\u0627\u0637 \u06A9\u0645\u200C\u062A\u0639\u062F\u0627\u062F \u0627\u0639\u0645\u0627\u0644 \u0634\u0648\u062F."],table:{head:["\u0645\u062F\u0644","\u06A9\u062C\u0627","\u0645\u0632\u06CC\u062A","\u0647\u0632\u06CC\u0646\u0647"],rows:[["\u0633\u0647\u200C\u0644\u0627\u06CC\u0647","\u067E\u0631\u062F\u06CC\u0633 \u0628\u0632\u0631\u06AF","\u0633\u06CC\u0627\u0633\u062A \u0645\u062A\u0645\u0631\u06A9\u0632\u060C \u0645\u0642\u06CC\u0627\u0633","\u062A\u062C\u0647\u06CC\u0632 \u0648 latency \u0628\u06CC\u0634\u062A\u0631"],["Collapsed core","\u0634\u0639\u0628\u0647","\u0633\u0627\u062F\u0647 \u0648 \u0627\u0631\u0632\u0627\u0646","\u0645\u0642\u06CC\u0627\u0633 \u0645\u062D\u062F\u0648\u062F"],["Spine-Leaf","\u062F\u06CC\u062A\u0627\u0633\u0646\u062A\u0631","\u067E\u0631\u0634 \u062B\u0627\u0628\u062A\u060C ECMP","\u0646\u06CC\u0627\u0632 \u0628\u0647 \u0645\u0647\u0627\u0631\u062A L3"]]}},{h:"SD-Access \u0648 SD-WAN \u062F\u0631 \u06CC\u06A9 \u0646\u06AF\u0627\u0647",p:["SD-Access: \u0644\u0627\u06CC\u0647 \u0632\u06CC\u0631\u06CC\u0646 (underlay) \u0628\u0627 IS-IS\u060C \u0644\u0627\u06CC\u0647 overlay \u0628\u0627 LISP/VXLAN\u060C \u0648 \u0633\u06CC\u0627\u0633\u062A \u0628\u0627 SGT/TrustSec. \u06A9\u0646\u062A\u0631\u0644\u0631 (DNA Center/Catalyst Center) \u0646\u0642\u0634\u0647 \u0648 \u0633\u06CC\u0627\u0633\u062A \u0631\u0627 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F.","SD-WAN: \u06A9\u0646\u062A\u0631\u0644\u0631 (vManage) \u0633\u06CC\u0627\u0633\u062A \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F\u060C \u0644\u0628\u0647\u200C\u0647\u0627 (vEdge/cEdge) \u0628\u0627 IPsec \u062A\u0648\u0646\u0644 \u0645\u06CC\u200C\u0633\u0627\u0632\u0646\u062F \u0648 \u0628\u0631 \u0627\u0633\u0627\u0633 SLA \u0645\u0633\u06CC\u0631 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F (BFD + IP SLA). \u062A\u0641\u0627\u0648\u062A \u06A9\u0644\u06CC\u062F\u06CC \u0628\u0627 WAN \u06A9\u0644\u0627\u0633\u06CC\u06A9: \u062A\u0635\u0645\u06CC\u0645 \u0645\u0633\u06CC\u0631 \u0628\u0631 \u0627\u0633\u0627\u0633 \u06A9\u06CC\u0641\u06CC\u062A\u060C \u0646\u0647 \u0641\u0642\u0637 \u0645\u062A\u0631\u06CC\u06A9."]},{h:"\u062F\u0633\u062A\u0631\u0633\u200C\u067E\u0630\u06CC\u0631\u06CC \u0628\u0627\u0644\u0627",p:["\u0633\u0637\u062D \u06F1: \u0627\u0641\u0632\u0648\u0646\u06AF\u06CC \u062A\u062C\u0647\u06CC\u0632 (\u062F\u0648 \u0633\u0648\u0626\u06CC\u0686\u060C \u062F\u0648 PSU). \u0633\u0637\u062D \u06F2: \u0627\u0641\u0632\u0648\u0646\u06AF\u06CC \u0645\u0633\u06CC\u0631 (ECMP\u060C EtherChannel, vPC). \u0633\u0637\u062D \u06F3: \u0627\u0641\u0632\u0648\u0646\u06AF\u06CC \u062F\u0631\u0648\u0627\u0632\u0647 (HSRP/VRRP). \u062F\u0631 \u0637\u0631\u0627\u062D\u06CC\u060C \u0628\u0627\u06CC\u062F \u0628\u062F\u0627\u0646\u06CC \u06A9\u062F\u0627\u0645 \u0633\u0637\u062D \u06A9\u062F\u0627\u0645 \u062E\u0637\u0627 \u0631\u0627 \u067E\u0648\u0634\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u06A9\u062F\u0627\u0645 \u062E\u0637\u0627 \u0631\u0627 \u0646\u0647."]}],debug:["\u0646\u0642\u0634\u0647 \u0644\u0627\u06CC\u0647\u200C\u0647\u0627 \u0631\u0627 \u0628\u06A9\u0634: \u06A9\u062F\u0627\u064