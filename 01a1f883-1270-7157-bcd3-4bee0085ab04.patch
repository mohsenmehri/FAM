+/* Hosts for the reused simulator screens. Their own rules are scoped to .legacy by the build;
+   this file only fits them into the new layout. */
+.legacy { color: var(--c-text); font-size: var(--fs-md); line-height: 1.7; min-width: 0; }
+.legacy .hero { display: block; padding: var(--s-5); margin-bottom: var(--s-4); border-radius: var(--r-lg); border: 1px solid var(--c-border); border-inline-start: 5px solid var(--c-primary); background: var(--c-surface); box-shadow: none; }
+.legacy .hero::before, .legacy .hero::after { display: none; }
+.legacy .hero h2 { font-size: var(--fs-xl); margin-bottom: var(--s-2); }
+.legacy .card { border-radius: var(--r-lg); background: var(--c-surface); border: 1px solid var(--c-border); box-shadow: none; backdrop-filter: none; }
+.legacy .btn { min-height: 40px; }
+.legacy pre, .legacy code, .legacy .term-out, .legacy .term-in { font-family: var(--font-mono); }
+.ws-topology, .ws-console, .ws-trace { min-width: 0; }
+.ws-topology svg { max-width: 100%; }
+.legacy .btn.primary, :root[data-theme="light"] .legacy .btn.primary { background: var(--c-primary); border-color: var(--c-primary); color: var(--c-on-primary); box-shadow: none; text-shadow: none; }
+.legacy .btn.primary:hover, :root[data-theme="light"] .legacy .btn.primary:hover { background: var(--c-primary-hover); }
+/* Persian notes inside the console use the reading font (monospace fonts have no joined Arabic forms). */
+.legacy .term-line.note, .legacy .term-foot, .legacy .term-status { font-family: var(--font); }
+.legacy .term-line.note { unicode-bidi: plaintext; text-align: start; font-size: 12.5px; }
+.legacy .term-head .btn, .legacy .term-foot .btn { min-height: 30px; padding: 3px 10px; font-size: 11.5px; }
+.legacy .term-input:focus-visible { outline: none; }
+.legacy .term-input-row:focus-within { box-shadow: inset 0 0 0 2px var(--c-brand); }
+.legacy .chip.on, .legacy .chip.info { border-color: var(--c-border); }
+.legacy .bank-lab-guide { border: 1px solid var(--c-border); border-radius: var(--r-lg); background: var(--c-surface); padding: var(--s-4); }
+.legacy table { font-size: var(--fs-sm); }
+.legacy .split, .legacy .grid.g2, .legacy .grid.g3 { min-width: 0; }
+@media (max-width: 860px) {
+  .legacy .split, .legacy .split.rev, .legacy .grid.g2, .legacy .grid.g3, .legacy .grid.g4 { grid-template-columns: minmax(0, 1fr); }
+  .legacy .hero { padding: var(--s-4); }
+  .legacy .card { padding: var(--s-3); }
+  .legacy .tablewrap, .legacy .table-wrap { overflow-x: auto; }
+  .legacy .term-body { max-height: 46vh; min-height: 180px; }
+  .legacy .list-toolbar { flex-direction: column; align-items: stretch; }
+}
+.legacy .term-input, .legacy .term-input:focus { border: 0; box-shadow: none; outline: none; background: transparent; }
