627\u0633\u062A \u06A9\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0645\u062F\u06CC\u0631\u0647\u0627 \u0647\u0645\u06CC\u0634\u0647 \u0627\u0632 \u062F\u0631\u0650 \u0634\u0631\u0642\u06CC \u0628\u0631\u0648\u0646\u062F\xBB \u062D\u062A\u06CC \u0627\u06AF\u0631 \u062F\u0631\u0650 \u063A\u0631\u0628\u06CC \u0646\u0632\u062F\u06CC\u06A9\u200C\u062A\u0631 \u0628\u0627\u0634\u062F.",pitfalls:["\u0627\u0646\u062A\u0638\u0627\u0631 \u0627\u062B\u0631 PBR \u0631\u0648\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062A\u0648\u0644\u06CC\u062F\u0634\u062F\u0647 \u062A\u0648\u0633\u0637 \u062E\u0648\u062F \u0631\u0648\u062A\u0631 (\u0628\u0627\u06CC\u062F ip local policy \u0628\u0627\u0634\u062F).","\u0646\u0628\u0648\u062F \u0641\u06CC\u0644\u062A\u0631 \u0648 \u062A\u0637\u0628\u06CC\u0642 \u0647\u0645\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u0627 \u06CC\u06A9 ACL \u0628\u0627\u0632 (permit ip any any).","\u0646\u062F\u06CC\u062F\u0646 \u0648\u0636\u0639\u06CC\u062A \u0644\u06CC\u0646\u06A9 \u0648 \u0641\u0631\u0633\u062A\u0627\u062F\u0646 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u0647 \u0645\u0633\u06CC\u0631 \u0642\u0637\u0639."],exam:["PBR \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0648\u0631\u0648\u062F\u06CC \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F (ip policy route-map).","set ip default next-hop \u0641\u0642\u0637 \u0648\u0642\u062A\u06CC \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631 \u0631\u0627\u0647\u06CC \u0646\u062F\u0627\u0631\u062F.","\u0628\u0631\u0627\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 local \u0627\u0632 ip local policy route-map \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F."],glossary:[["PBR","\u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0628\u0631 \u0627\u0633\u0627\u0633 \u0633\u06CC\u0627\u0633\u062A\u060C \u0646\u0647 \u0641\u0642\u0637 \u0645\u0642\u0635\u062F."],["set next-hop","\u062A\u0639\u06CC\u06CC\u0646 \u067E\u0631\u