+  printf 'Local app image rebuild failed; attempting rollback…\n' >&2
+  FAM_ACADEMY_TARGET=LAB FAM_ACADEMY_CONFIRM=LAB-ONLY bash "$BUNDLE_DIR/rollback.sh" "$ROOT" "$BACKUP_DIR" ||
+    academy_fail "App image build failed and automatic rollback did not complete. Verified backup: $BACKUP_DIR"
+  academy_fail "App image build failed; previous Academy files and app image were restored. Backup retained at $BACKUP_DIR"
+fi
+if ! academy_compose up -d --no-deps app; then
+  printf 'App container replacement failed; attempting rollback…\n' >&2
+  FAM_ACADEMY_TARGET=LAB FAM_ACADEMY_CONFIRM=LAB-ONLY bash "$BUNDLE_DIR/rollback.sh" "$ROOT" "$BACKUP_DIR" ||
+    academy_fail "App start failed and automatic rollback did not complete. Verified backup: $BACKUP_DIR"
+  academy_fail "App start failed; previous Academy files and app image were restored. Backup retained at $BACKUP_DIR"
+fi
+if ! academy_compose exec -T nginx nginx -t >/dev/null 2>&1 ||
+   ! academy_compose exec -T nginx nginx -s reload >/dev/null 2>&1; then
+  printf 'Nginx reload failed; attempting rollback…\n' >&2
+  FAM_ACADEMY_TARGET=LAB FAM_ACADEMY_CONFIRM=LAB-ONLY bash "$BUNDLE_DIR/rollback.sh" "$ROOT" "$BACKUP_DIR" ||
+    academy_fail "Nginx reload failed and automatic rollback did not complete. Verified backup: $BACKUP_DIR"
+  academy_fail "Nginx reload failed; previous Academy files and app image were restored. Backup retained at $BACKUP_DIR"
+fi
+
+if ! python3 - "$ROOT" <<'PY'
+import ssl
+import sys
+import time
+import urllib.error
+import urllib.request
+
+context = ssl._create_unverified_context()
+base = 'https://127.0.0.1'
+paths = ['/academy', '/academy-content/catalog.json', '/academy-content/images/nf-02-poe.svg']
+for attempt in range(30):
+    statuses = []
+    try:
+        for path in paths:
+            try:
+                response = urllib.request.urlopen(base + path, context=context, timeout=3)
+                statuses.append(response.status)
+                response.close()
+            except urllib.error.HTTPError as error:
+                statuses.append(error.code)
+        if statuses == [401, 401, 401]:
+            print('Protected Academy routes answered 401 without a session, as expected.')
+            break
+    except Exception:
+        statuses = []
+    if attempt == 29:
+        print('Protected route check failed; expected unauthenticated HTTP 401 responses.', file=sys.stderr)
+        sys.exit(1)
+    time.sleep(1)
+PY
+then
+  printf 'Post-deploy route check failed; attempting rollback…\n' >&2
+  FAM_ACADEMY_TARGET=LAB FAM_ACADEMY_CONFIRM=LAB-ONLY bash "$BUNDLE_DIR/rollback.sh" "$ROOT" "$BACKUP_DIR" ||
+    academy_fail "Post-deploy route check failed and automatic rollback did not complete. Verified backup: $BACKUP_DIR"
+  academy_fail "Post-deploy route check failed; previous Academy files and app image were restored. Backup retained at $BACKUP_DIR"
+fi
+
+academy_compose ps
+printf '\nManual LAB deployment completed.\n'
+printf 'Verified backup/rollback record: %s\n' "$BACKUP_DIR"
+printf 'Retained previous app image tag: %s\n' "$ROLLBACK_TAG"
+printf 'Next: complete the authenticated browser checklist in README-fa.md; no live-user login was attempted by this script.\n'
