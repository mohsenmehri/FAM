index 0000000..98575a0
--- /dev/null
+++ b/manual-deployment/fam-academy-157682a/tests/test_install_config_archive.py
@@ -0,0 +1,186 @@
+"""Isolated safety tests for the FAM Academy deployment scripts.
+
+These tests use temporary fixture trees and never invoke Docker or a live FAM
+installation. In particular, the config archive test reproduces the exact
+find/tar list comparison used by install.sh.
+"""
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+PACKAGE_DIR = Path(__file__).resolve().parents[1]
+INSTALL_SCRIPT = PACKAGE_DIR / "install.sh"
+PREFLIGHT_SCRIPT = PACKAGE_DIR / "preflight.sh"
+ROLLBACK_SCRIPT = PACKAGE_DIR / "rollback.sh"
+CONFIG_FIND_RE = re.compile(
+    r"(?m)^\s*find (?P<paths>\.env Dockerfile docker-compose\.yml nginx\.conf certs) "
+    r"-printf '%(?P<format>[pP])\\n' \| LC_ALL=C sort$"
+)
+CONFIG_SOURCES = [".env", "Dockerfile", "docker-compose.yml", "nginx.conf", "certs"]
+EXPECTED_ARCHIVE_MEMBERS = {
+    ".env",
+    "Dockerfile",
+    "docker-compose.yml",
+    "nginx.conf",
+    "certs",
+    "certs/fam.crt",
+    "certs/fam.key",
+}
+
+
+def make_config_fixture(root: Path) -> None:
+    files = {
+        ".env": "FIXTURE_ONLY=not-a-secret\n",
+        "Dockerfile": "FROM scratch\n",
+        "docker-compose.yml": "services: {}\n",
+        "nginx.conf": "events {}\n",
+        "certs/fam.crt": "fixture certificate, not a real certificate\n",
+        "certs/fam.key": "fixture key, not a real key\n",
+    }
+    for relative, content in files.items():
+        path = root / relative
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(content, encoding="utf-8")
+
+
+def archive_members(archive: Path) -> list[str]:
+    result = subprocess.run(
+        ["tar", "-tzf", str(archive)],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    normalized = {
+        line.removeprefix("./").removesuffix("/")
+        for line in result.stdout.splitlines()
+        if line
+    }
+    return sorted(normalized)
+
+
+def run_find(root: Path, paths: list[str], format_specifier: str) -> list[str]:
+    result = subprocess.run(
+        ["find", *paths, "-printf", f"%{format_specifier}\\n"],
+        cwd=root,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    # This is the find output before the installer's LC_ALL=C sort; retaining
+    # empty lines is intentional because cmp would see them in config-expected.
+    return sorted(result.stdout.splitlines())
+
+
+def tree_snapshot(root: Path) -> dict[str, tuple[bool, bytes | None]]:
+    snapshot: dict[str, tuple[bool, bytes | None]] = {}
+    for path in sorted(root.rglob("*")):
+        relative = path.relative_to(root).as_posix()
+        snapshot[relative] = (path.is_dir(), path.read_bytes() if path.is_file() else None)
+    return snapshot
+
+
+class ConfigArchiveManifestTests(unittest.TestCase):
+    def test_install_find_list_matches_config_archive_and_catches_percent_P_regression(self):
+        script = INSTALL_SCRIPT.read_text(encoding="utf-8")
+        match = CONFIG_FIND_RE.search(script)
+        self.assertIsNotNone(match, "install.sh must keep the config find/list comparison explicit")
+        assert match is not None
+        paths = match.group("paths").split()
+        self.assertEqual(paths, CONFIG_SOURCES)
+        self.assertEqual(
+            match.group("format"),
+            "p",
+            "Starting-point paths must be included; %P emits empty names for the roots.",
+        )
+
+        with tempfile.TemporaryDirectory(prefix="fam-academy-config-archive-") as temporary:
+            root = Path(temporary)
+            make_config_fixture(root)
+            archive = root.parent / f"{root.name}-config-certs.tar.gz"
+            self.addCleanup(lambda: archive.unlink(missing_ok=True))
+            subprocess.run(
+                [
+                    "tar",
+                    "-czpf",
+                    str(archive),
+                    "-C",
+                    str(root),
+                    "--",
+                    *paths,
+                ],
+                check=True,
+                capture_output=True,
+                text=True,
+            )
+
+            actual = archive_members(archive)
+            expected = run_find(root, paths, match.group("format"))
+            self.assertEqual(actual, sorted(EXPECTED_ARCHIVE_MEMBERS))
+            self.assertEqual(expected, actual)
+
+            # Prove the test fixture would have caught the reported bug.
+            legacy_expected = run_find(root, paths, "P")
+            self.assertNotEqual(legacy_expected, actual)
+            self.assertIn("", legacy_expected)
+
+
+class DeploymentEntryPointSafetyTests(unittest.TestCase):
+    def test_all_entry_points_require_lab_confirmation_without_side_effects(self):
+        with tempfile.TemporaryDirectory(prefix="fam-academy-lab-isolated-") as temporary:
+            root = Path(temporary)
+            (root / "server").mkdir()
+            (root / "docker-compose.yml").write_text("fixture only\n", encoding="utf-8")
+            (root / "server" / "app.py").write_text("# fixture only\n", encoding="utf-8")
+            (root / "server" / "manage.py").write_text("# fixture only\n", encoding="utf-8")
+            initial_snapshot = tree_snapshot(root)
+
+            env = os.environ.copy()
+            env["FAM_ACADEMY_TARGET"] = "LAB"
+            env.pop("FAM_ACADEMY_CONFIRM", None)
+
+            for script in (PREFLIGHT_SCRIPT, INSTALL_SCRIPT, ROLLBACK_SCRIPT):
+                with self.subTest(script=script.name):
+                    command = ["bash", str(script), str(root)]
+                    if script == ROLLBACK_SCRIPT:
+                        command.append(str(root / "missing-backup-fixture"))
+                    result = subprocess.run(
+                        command,
+                        cwd=PACKAGE_DIR,
+                        env=env,
+                        capture_output=True,
+                        text=True,
+                        timeout=10,
+                    )
+                    self.assertEqual(result.returncode, 1, result.stdout + result.stderr)
+                    self.assertIn("Set FAM_ACADEMY_CONFIRM=LAB-ONLY", result.stderr)
+                    self.assertEqual(tree_snapshot(root), initial_snapshot)
+                    self.assertFalse((root / "data").exists())
+
+    def test_backup_and_checksum_guards_precede_mutation_or_restore(self):
+        install = INSTALL_SCRIPT.read_text(encoding="utf-8")
+        preflight = PREFLIGHT_SCRIPT.read_text(encoding="utf-8")
+        rollback = ROLLBACK_SCRIPT.read_text(encoding="utf-8")
+
+        self.assertIn('academy_resolve_root "${1:-}"\nacademy_preflight', preflight)
+        self.assertLess(
+            install.index("academy_preflight"),
+            install.index('mkdir -p -m 0700 -- "$ROOT/data/backups"'),
+        )
+        self.assertLess(
+            install.index("Creating a FAM-validated SQLite backup"),
+            install.index("Applying only the checksummed Academy payload"),
+        )
+        self.assertLess(
+            rollback.index("sha256sum -c SHA256SUMS"),
+            rollback.index("Restoring only files changed by this Academy package"),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
