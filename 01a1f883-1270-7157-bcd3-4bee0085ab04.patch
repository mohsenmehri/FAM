+  await page.locator('[data-open-path]').first().click();
+  await page.locator('[data-open-blueprint]').first().click();
+  for (const stage of ['concept', 'example', 'practice', 'lab', 'quiz', 'summary']) {
+    await page.locator(`.le-stage-pill[data-stage-id="${stage}"]`).first().click();
+    const section = page.locator(`#sec-${stage}`);
