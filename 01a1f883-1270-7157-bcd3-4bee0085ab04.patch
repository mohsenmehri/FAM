+  academy_fail "Could not identify the running app image. No project file was copied; backup workspace: $BACKUP_DIR"
+ROLLBACK_TAG="fam-academy-rollback:${STAMP}-$$"
+docker image tag "$EXPECTED_OLD" "$ROLLBACK_TAG" >/dev/null 2>&1 ||
+  academy_fail "Could not retain the current app image for rollback. No project file was copied; backup workspace: $BACKUP_DIR"
+cat > "$BACKUP_DIR/ROLLBACK.meta" <<EOF
+base_commit=$FAM_ACADEMY_BASE_COMMIT
+old_image_id=$EXPECTED_OLD
+old_image_ref=fam-app:1.0
+rollback_tag=$ROLLBACK_TAG
+app_container_id=$APP_ID
+nginx_container_id=$NGINX_ID
+EOF
