 \u067E\u0633 \u0628\u06AF\u06CC\u0631\u0646\u062F. \u06CC\u0639\u0646\u06CC \u062D\u062A\u06CC \u0648\u0642\u062A\u06CC \u0633\u0631\u0648\u0631 \u0648 \u06A9\u0644\u0627\u06CC\u0646\u062A \u062F\u0631 \u06CC\u06A9 \u0634\u0628\u06A9\u0647\u200C\u0627\u0646\u062F\u060C \u062F\u0648 \u067E\u06CC\u0627\u0645 \u0627\u0632 \u0686\u0647\u0627\u0631 \u067E\u06CC\u0627\u0645 broadcast \u0627\u0633\u062A."]},{h:"Relay: \u0648\u0642\u062A\u06CC \u0633\u0631\u0648\u0631 \u062F\u0631 VLAN \u062F\u06CC\u06AF\u0631 \u0627\u0633\u062A",p:["broadcast \u0627\u0632 \u0631\u0648\u062A\u0631 \u0639\u0628\u0648\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F. \u067E\u0633 \u0627\u06AF\u0631 \u0633\u0631\u0648\u0631 DHCP \u062F\u0631 VLAN \u0645\u062F\u06CC\u0631\u06CC\u062A \u0628\u0627\u0634\u062F \u0648 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u062F\u0631 VLAN 10\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A \u0647\u06CC\u0686\u200C\u0648\u0642\u062A \u062C\u0648\u0627\u0628 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0631\u0627\u0647\u200C\u062D\u0644 ip helper-address \u0627\u0633\u062A: \u0631\u0648\u062A\u0631 \u067E\u06CC\u0627\u0645 broadcast \u06A9\u0644\u0627\u06CC\u0646\u062A \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F\u060C \u0622\u0646 \u0631\u0627 \u0628\u0647\u200C\u0635\u0648\u0631\u062A unicast \u0628\u0631\u0627\u06CC \u0633\u0631\u0648\u0631 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F \u0648 \u062F\u0631 \u0647\u0645\u0627\u0646 \u0628\u0633\u062A\u0647\u060C \u0622\u062F\u0631\u0633 \u06AF\u06CC\u062A\u200C\u0648\u06CC (giaddr) \u0631\u0627 \u0647\u0645 \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F \u062A\u0627 \u0633\u0631\u0648\u0631 \u0628\u062F\u0627\u0646\u062F \u06A9\u062F\u0627\u0645 pool \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u062F.","\u067E\u0633 \u06CC\u06A9 \u0627\u0634\u062A\u0628\u0627\u0647 \u06A9\u0644\u0627\u0633\u06CC\u06A9 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 pool \u062F\u0631\u0633\u062A \u062A\u0646\u0638\u06CC\u0645 \u0634\u062F\u0647 \u0648\u0644\u06CC helper \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 VLAN \u06A9\u0644\u0627\u06CC\u0646\u062A \u062A\u0646\u0638\u06CC\u0645 \u0646\u0634\u062F\u0647\u061B \u06CC\u0627 \u0628\u0631\u0639\u06A9\u0633\u060C helper \u0647\u0633\u062A \u0648\u0644\u06CC IP \u0633\u0631\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0633\u062A. \u062F\u0631 Catalyst\u060C \u062F\u0633\u062A\u0648\u0631 ip dhcp relay information option \u0628\u0627\u0639\u062B \u0645\u06CC\u200C\u0634\u0648\u062F \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u067E\u0648\u0631\u062A \u0648 VLAN \u0647\u0645 \u0628\u0647 \u0633\u0631\u0648\u0631 \u0628\u0631\u0633\u062F."],callout:{title:"\u0633\u0647 \u062F\u0644\u06CC\u0644 \u0631\u0627\u06CC\u062C \xABIP \u0646\u06AF\u0631\u0641\u062A\u0645\xBB",text:"\u06F1) helper \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062F\u0631\u0633\u062A \u0646\u06CC\u0633\u062A \u06CC\u0627 IP \u0633\u0631\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0633\u062A. \u06F2) pool \u062A\u0645\u0627\u0645 \u0634\u062F\u0647 (excluded \u0646\u06A9\u0631\u062F\u0647\u200C\u0627\u06CC \u06CC\u0627 lease \u062E\u06CC\u0644\u06CC \u0637\u0648\u0644\u0627\u0646\u06CC \u0627\u0633\u062A). \u06F3) DHCP Snooping \u0641\u0639\u0627\u0644 \u0627\u0633\u062A \u0648\u0644\u06CC \u067E\u0648\u0631\u062A uplink trusted \u0646\u06CC\u0633\u062A."}},{h:"\u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0633\u0631\u0648\u0631 \u0631\u0648\u06CC \u0631\u0648\u062A\u0631",p:["\u0631\u0648\u062A\u0631 \u0633\u06CC\u0633\u06A9\u0648 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062E\u0648\u062F\u0634 \u0633\u0631\u0648\u0631 DHCP \u0628\u0627\u0634\u062F: ip dhcp excluded-address \u0628\u0631\u0627\u06CC \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC \u0631\u0632\u0631\u0648\u060C \u0628\u0639\u062F ip dhcp pool NAME\u060C network\u060C default-router\u060C dns-server \u0648 lease. \u0628\u0631\u0627\u06CC \u0686\u0646\u062F VLAN\u060C \u0628\u0631\u0627\u06CC \u0647\u0631 VLAN \u06CC\u06A9 pool \u0645\u06CC\u200C\u0633\u0627\u0632\u06CC \u0648 \u0622\u062F\u0631\u0633 \u06AF\u06CC\u062A\u200C\u0648\u06CC \u0647\u0645\u0627\u0646 VLAN \u0631\u0627 default-router \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u06CC.","\u0628\u0631\u0627\u06CC \u0628\u0631\u0631\u0633\u06CC: show ip dhcp binding (\u06A9\u062F\u0627\u0645 MAC \u0686\u0647 IP \u06AF\u0631\u0641\u062A\u0647)\u060C show ip dhcp pool (\u0686\u0646\u062F \u0622\u062F\u0631\u0633 \u0622\u0632\u0627\u062F \u0648 \u0686\u0646\u062F \u062F\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647) \u0648 clear ip dhcp binding * \u0628\u0631\u0627\u06CC \u0622\u0632\u0627\u062F \u06A9\u0631\u062F\u0646. \u0628\u0631\u0627\u06CC \u06AF\u0631\u0641\u062A\u0646 \u0644\u0627\u06AF\u060C debug ip dhcp server events \u0631\u0627 \u0631\u0648\u0634\u0646 \u06A9\u0646."]},{h:"\u0627\u0645\u0646\u06CC\u062A DHCP",p:["\u0686\u0648\u0646 DHCP \u06CC\u06A9 \u067E\u0631\u0648\u062A\u06A9\u0644 \u0628\u062F\u0648\u0646 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0627\u0633\u062A\u060C \u0647\u0631 \u06A9\u0633\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0633\u0631\u0648\u0631 \u062C\u0639\u0644\u06CC \u0628\u0627\u0644\u0627 \u0628\u06CC\u0627\u0648\u0631\u062F. DHCP Snooping (\u062F\u0631 \u0644\u0627\u0628\u0631\u0627\u062A\u0648\u0627\u0631 \u0627\u0645\u0646\u06CC\u062A \u0644\u0627\u06CC\u0647 \u06F2 \u062F\u06CC\u062F\u06CC\u0645) \u062C\u0644\u0648\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u062F\u0631 IPv6\u060C \u0645\u0641\u0647\u0648\u0645 \u0645\u0634\u0627\u0628\u0647 DHCPv6 Guard \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F.","\u0646\u06A9\u062A\u0647 \u062F\u06CC\u06AF\u0631: \u0627\u06AF\u0631 \u0627\u0632 DHCP \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0646\u0645\u06CC\u200C\u06A9\u0646\u06CC \u0648\u0644\u06CC \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0647\u0646\u0648\u0632 \u062A\u0644\u0627\u0634 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F\u060C \u0628\u0647\u062A\u0631 \u0627\u0633\u062A DHCP \u0631\u0627 \u0631\u0648\u06CC \u0633\u0648\u0626\u06CC\u0686 \u063A\u06CC\u0631\u0641\u0639\u0627\u0644 \u06A9\u0646\u06CC \u062A\u0627 \u0634\u0628\u06A9\u0647 \u0628\u0627 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627\u06CC Discover \u067E\u0631 \u0646\u0634\u0648\u062F."]}],analogy:"DHCP \u0645\u062B\u0644 \u067E\u0630\u06CC\u0631\u0634 \u0647\u062A\u0644 \u0627\u0633\u062A: \u0645\u0647\u0645\u0627\u0646 (\u06A9\u0644\u0627\u06CC\u0646\u062A) \u0645\u06CC\u200C\u067E\u0631\u0633\u062F \xAB\u0627\u062A\u0627\u0642 \u062F\u0627\u0631\u06CC\u062F\u061F\xBB (Discover)\u060C \u067E\u0630\u06CC\u0631\u0634 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0627\u062A\u0627\u0642 \u06F2\u06F0\u06F3\xBB (Offer)\u060C \u0645\u0647\u0645\u0627\u0646 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0647\u0645\u0627\u0646 \u0631\u0627 \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u0645\xBB (Request) \u0648 \u067E\u0630\u06CC\u0631\u0634 \u06A9\u0627\u0631\u062A \u0627\u062A\u0627\u0642 \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F (ACK).",pitfalls:["\u0646\u0628\u0633\u062A\u0646 ip helper-address \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 VLAN \u06A9\u0644\u0627\u06CC\u0646\u062A.","\u0641\u0631\u0627\u0645\u0648\u0634 \u06A9\u0631\u062F\u0646 excluded-address: \u0633\u0631\u0648\u0631 \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC\u06CC \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u0628\u0631\u0627\u06CC \u06AF\u06CC\u062A\u200C\u0648\u06CC \u06CC\u0627 \u067E\u0631\u06CC\u0646\u062A\u0631 \u0631\u0632\u0631\u0648 \u0634\u062F\u0647\u200C\u0627\u0646\u062F \u0648 \u062A\u062F\u0627\u062E\u0644 IP \u0631\u062E \u0645\u06CC\u200C\u062F\u0647\u062F.","lease \u062E\u06CC\u0644\u06CC \u0