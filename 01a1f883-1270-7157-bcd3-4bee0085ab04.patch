+printf 'All backups verified. No FAM data, .env, Compose settings, certificates, or network configuration will be changed.\n'
+printf 'Applying only the checksummed Academy payload…\n'
+
+install_one() {
+  local new_sha="$1" relative="$2" target="$ROOT/$2" source="$BUNDLE_DIR/payload/$2"
+  local existed old_sha old_mode old_uid old_gid row_tmp parent temp_file
+  row_tmp="$(awk -F '\t' -v p="$relative" '$1==p {print; exit}' "$BACKUP_DIR/ROLLBACK.tsv")"
+  [[ -n "$row_tmp" ]] || return 1
+  IFS=$'\t' read -r _ existed old_sha _ old_mode old_uid old_gid <<< "$row_tmp"
+  if [[ "$existed" == '1' ]]; then
+    [[ -f "$target" && "$(academy_sha "$target")" == "$old_sha" ]] || return 1
+  else
+    [[ ! -e "$target" && ! -L "$target" ]] || return 1
+  fi
+  parent="$(dirname -- "$target")"
+  if [[ ! -d "$parent" ]]; then (umask 022; mkdir -p -- "$parent") || return 1; fi
+  temp_file="$(mktemp "$parent/.fam-academy-install.XXXXXX")" || return 1
+  if ! cp -- "$source" "$temp_file"; then rm -f -- "$temp_file"; return 1; fi
+  if [[ "$existed" == '1' ]]; then
+    if ! chown "$old_uid:$old_gid" "$temp_file" || ! chmod "$old_mode" "$temp_file"; then
+      rm -f -- "$temp_file"; return 1
+    fi
+  else
+    if ! chown 0:0 "$temp_file" || ! chmod 0644 "$temp_file"; then
+      rm -f -- "$temp_file"; return 1
+    fi
+  fi
+  if ! mv -f -- "$temp_file" "$target"; then rm -f -- "$temp_file"; return 1; fi
+  [[ "$(academy_sha "$target")" == "$new_sha" ]]
