headers={&#x27;X-Auth-Token&#x27;: token})\n    with opener.open(request, timeout=15) as response:\n        devices = json.load(response)\n    print(json.dumps(devices, ensure_ascii=False, indent=2))\nexcept HTTPError as error:\n    print(&#x27;HTTP error:&#x27;, error.code)  # بدنهٔ خطا یا توکن را چاپ نکنید\nexcept (URLError, OSError, ValueError, KeyError) as error:\n    print(&#x27;Request failed; check TLS, connectivity and API response type:&#x27;, type(error).__name__)\nfinally:\n    # حذف ارجاع‌ها پاک‌سازی قطعی حافظه در Python را تضمین نمی‌کند.\n    credentials = token = request = None\n</code></pre><h4>راستی‌آزمایی و امنیت</h4><p>گذرواژه تعاملی و بدون echo دریافت می‌شود؛ رمز و توکن در حافظهٔ همان فرایند قرار می‌گیرند، نه آرگومان فرایند. از میزبان مورد اعتماد استفاده کنید؛ Python پاک‌سازی قطعی حافظه را تضمین نمی‌کند؛ redirect خودکار غیرفعال است تا اعتبارنامه به مقصد دیگر ارسال نشود. 401 را با بررسی اعتبار یا انقضای توکن، 403 را با مجوز حساب و خطای TLS را با CA و نام میزبان بررسی کنید. پاسخ و لاگ‌ها می‌توانند اطلاعات تجهیزات را داشته باشند؛ با احتیاط نگهداری شوند. هیچ درخواست تغییردهنده‌ای ارسال نمی‌شود.</p>"
