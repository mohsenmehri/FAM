Fi 6E \u2014 \u0628\u0627\u0646\u062F \u06F6 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0648 \u0627\u0645\u0646\u06CC\u062A WPA3",tagline:"\u06F6 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0638\u0631\u0641\u06CC\u062A \u0637\u06CC\u0641\u06CC \u0628\u06CC\u0634\u062A\u0631\u06CC \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0627\u0644\u0632\u0627\u0645\u0627\u062A \u0627\u0645\u0646\u06CC\u062A\u06CC \u0634\u0627\u0645\u0644 WPA3 \u06CC\u0627 Enhanced Open/OWE \u0648 \u0645\u062D\u0627\u0641\u0638\u062A \u0641\u0631\u06CC\u0645 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0628\u0647 \u0646\u0648\u0639 \u0634\u0628\u06A9\u0647 \u0648 \u06AF\u0648\u0627\u0647\u06CC \u0648\u0627\u0628\u0633\u062A\u0647 \u0627\u0633\u062A.",minutes:15,goals:["\u0628\u06AF\u0648\u06CC\u06CC \u0686\u0631\u0627 \u0628\u0627\u0646\u062F \u06F6 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0628\u0627 \u06F5 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0641\u0631\u0642 \u062F\u0627\u0631\u062F \u0648 \u0686\u0647 \u0645\u062D\u062F\u0648\u062F\u06CC\u062A\u200C\u0647\u0627\u06CC\u06CC \u062F\u0627\u0631\u062F","\u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC PSC\u060C OFDMA \u0648 BSS Coloring \u0686\u0647 \u0645\u0634\u06A9\u0644\u06CC \u0631\u0627 \u062D\u0644 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F","WLAN \u0631\u0627 \u0628\u0627 WPA3 \u0648 PMF \u062A\u0646\u0638\u06CC\u0645 \u06A9\u0646\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC \u0686\u0631\u0627 WPA2 \u062F\u0631 \u06F6GHz \u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F"],sections:[{h:"\u0686\u0631\u0627 \u0628\u0627\u0646\u062F \u062C\u062F\u06CC\u062F\u061F",p:["\u0628\u0627\u0646\u062F \u06F2.\u06F4 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0634\u0644\u0648\u063A \u0648 \u06A9\u0645\u0639\u0631\u0636 \u0627\u0633\u062A\u060C \u06F5 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u0647\u0645 \u0634\u0644\u0648\u063A \u0634\u062F\u0647. \u062F\u0631 \u0622\u0645\u0631\u06CC\u06A9\u0627 \u0628\u0627\u0632\u0647 \u06F5\u06F9\u06F2\u06F5 \u062A\u0627 \u06F7\u06F1\u06F2\u06F5 \u0645\u06AF\u0627\u0647\u0631\u062A\u0632 \u062D\u062F\u0648\u062F \u06F1\u06F2\u06F0\u06F0 \u0645\u06AF\u0627\u0647\u0631\u062A\u0632 \u0637\u06CC\u0641 \u062F\u0627\u0631\u062F\u061B \u0645\u0642\u0631\u0631\u0627\u062A \u06A9\u0634\u0648\u0631\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0633\u062A. \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627\u06CC Wi-Fi \u0642\u062F\u06CC\u0645\u06CC \u06A9\u0647 \u0627\u06CC\u0646 \u0628\u0627\u0646\u062F \u0631\u0627 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0646\u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u062F\u0631 \u0622\u0646 \u062D\u0636\u0648\u0631 \u0646\u062F\u0627\u0631\u0646\u062F\u060C \u0648\u0644\u06CC \u062A\u062F\u0627\u062E\u0644 \u062F\u06CC\u06AF\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u06F6 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 \u06CC\u0627 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u062C\u0627\u0632 \u062F\u06CC\u06AF\u0631 \u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A.","\u0645\u062D\u062F\u0648\u062F\u06CC\u062A \u0645\u0647\u0645: Wi-Fi 6E \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 802.11ax \u0627\u0632 \u0627\u06CC\u0646 \u0628\u0627\u0646\u062F \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0646\u0633\u0644\u200C\u0647\u0627\u06CC \u062C\u062F\u06CC\u062F\u062A\u0631 \u0645\u0627\u0646\u0646\u062F Wi-Fi 7 \u0646\u06CC\u0632 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u0627\u0632 \u0622\u0646 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u0646\u062F \u0648 \u0627\u0645\u0646\u06CC\u062A \u0628\u0627\u06CC\u062F WPA3 (\u06CC\u0627 OWE \u0628\u0631\u0627\u06CC \u0634\u0628\u06A9\u0647 \u0645\u0647\u0645\u0627\u0646) \u0628\u0627 PMF \u0627\u062C\u0628\u0627\u0631\u06CC \u0628\u062