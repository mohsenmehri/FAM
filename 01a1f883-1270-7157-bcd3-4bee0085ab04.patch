+def parse_worksheet_inventory(lesson_paths: list[Path]) -> list[dict[str, object]]:
+    inventory_path = DOCS / 'academy-ccna-worksheet-inventory-fa.md'
+    lesson_by_name = {path.name: path for path in lesson_paths}
+    entries = []
+    for line in inventory_path.read_text(encoding='utf-8').splitlines():
+        if not line.startswith('|') or 'academy-ccna-' not in line:
+            continue
+        cells = [cell.strip() for cell in line.strip('|').split('|')]
+        if len(cells) < 3 or not cells[1].startswith('`') or not cells[2].startswith('`'):
+            continue
+        code_title = cells[0]
+        file_name = cells[1].strip('`')
+        listed_heading = cells[2].strip('`')
+        path = lesson_by_name.get(file_name)
+        if not path:
+            fail(f'Worksheet inventory points outside the 59 lesson files: {file_name}')
+        text = path.read_text(encoding='utf-8')
+        headings = scan_headings(text)
+        expected = normalize_title(listed_heading.lstrip('#').strip())
+        actual = next((item for item in headings if normalize_title(str(item['title'])) == expected), None)
+        if actual is None:
+            # The maintained inventory has one known title drift: IS-07 still
+            # records the earlier wording for section 8. Resolve by section
+            # number and the actual heading text; never invent an anchor.
+            section_number = re.match(r'^#{2,6}\s*([^\s.]+)', listed_heading)
