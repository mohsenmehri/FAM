+
+
+def write_content_without_overwrite(payload: dict[str, bytes], refresh: bool = False) -> None:
+    for relative, content in sorted(payload.items()):
+        rel = PurePosixPath(relative)
+        if rel.is_absolute() or '..' in rel.parts or not rel.parts:
+            fail(f'Unsafe generated content path: {relative}')
+        target = CONTENT_ROOT.joinpath(*rel.parts)
+        if CONTENT_ROOT.is_symlink() or target.parent.is_symlink() or target.is_symlink():
+            fail(f'Refusing to follow an Academy content symlink: {target}')
+        target.parent.mkdir(parents=True, exist_ok=True)
+        if target.exists():
+            if not target.is_file():
+                fail(f'Refusing to replace non-file Academy content path: {target}')
+            if target.read_bytes() == content:
+                continue
+            if not refresh:
+                fail(f'Refusing to replace existing Academy content file: {target}')
+        temporary = target.with_name(target.name + '.tmp-' + str(os.getpid()))
+        with temporary.open('xb') as handle:
+            handle.write(content)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.chmod(temporary, 0o644)
+        os.replace(temporary, target)
+
+
+def git_blob(relative: str) -> bytes:
+    command = ['git', 'show', f'{BASE_COMMIT}:FAM-Linux-Lab-vm-backup/FAM-Linux-Lab/{relative}']
+    try:
+        return subprocess.check_output(command, cwd=REPO_ROOT, stderr=subprocess.DEVNULL)
+    except subprocess.CalledProcessError:
+        fail(f'Could not read pinned baseline file {relative} from {BASE_COMMIT}')
+
+
+def write_manifest(path: Path, entries: list[tuple[str, bytes]]) -> None:
+    lines = [f'{sha256(data)}  {name}' for name, data in sorted(entries)]
+    path.write_text('\n'.join(lines) + '\n', encoding='ascii')
+
+
+def package_entries(payload: dict[str, bytes]) -> dict[str, bytes]:
+    files = ['README-fa.md', 'lib.sh', 'preflight.sh', 'install.sh', 'rollback.sh']
+    entries: dict[str, bytes] = {}
+    archive_payload: dict[str, bytes] = {}
+    for archive_path, source_path in EXECUTABLE_FILES.items():
+        source = REPO_ROOT / 'FAM-Linux-Lab-vm-backup' / source_path
+        if not source.is_file():
+            fail(f'Changed Academy executable source file is missing: {source_path}')
+        archive_payload[archive_path] = source.read_bytes()
+    for relative, content in payload.items():
+        archive_payload['server/www/academy-content/' + relative] = content
+    for name in files:
+        path = PACKAGE_DIR / name
+        if not path.is_file():
+            fail(f'Package source file is missing: {name}')
+        entries[name] = path.read_bytes()
+    entries['BASE-COMMIT'] = (BASE_COMMIT + '\n').encode('ascii')
+    baseline = [(name, git_blob(name)) for name in BASELINE_FILES]
+    entries['baseline.sha256'] = ''.join(f'{sha256(data)}  {name}\n' for name, data in sorted(baseline)).encode('ascii')
+    entries['PACKAGE.json'] = (json.dumps({
+        'name': 'FAM Academy manual LAB deployment',
+        'baseCommit': BASE_COMMIT,
+        'scope': 'Academy only; manual LAB execution only; Production excluded',
+        'counts': {
+            'markdownDocuments': 76,
+            'stageZeroLessons': 10,
+            'ccnaLessons': 59,
+            'worksheetInventoryTitles': 27,
+            'independentWorksheets': 2,
+            'referenceDocuments': 5,
+            'svgDiagrams': 52,
+        },
+    }, ensure_ascii=False, indent=2) + '\n').encode('utf-8')
+    for relative, content in archive_payload.items():
+        entries['payload/' + relative] = content
+    entries['payload.sha256'] = ''.join(
+        f'{sha256(content)}  {name}\n' for name, content in sorted(archive_payload.items())
+    ).encode('ascii')
+    return entries
+
+
+def create_tarball(entries: dict[str, bytes]) -> tuple[Path, str]:
+    with tempfile.NamedTemporaryFile(prefix='fam-academy-bundle-', suffix='.tar.gz', dir=PACKAGE_DIR, delete=False) as temporary:
+        temp_path = Path(temporary.name)
+        with gzip.GzipFile(fileobj=temporary, mode='wb', filename='', mtime=0) as gz:
+            with tarfile.open(fileobj=gz, mode='w', format=tarfile.PAX_FORMAT) as archive:
+                for name, content in sorted(entries.items()):
+                    info = tarfile.TarInfo(name)
+                    info.size = len(content)
+                    info.mode = 0o755 if name.endswith('.sh') else 0o644
+                    info.uid = info.gid = 0
+                    info.uname = info.gname = ''
+                    info.mtime = 0
+                    archive.addfile(info, __import__('io').BytesIO(content))
+        temporary.flush()
+        os.fsync(temporary.fileno())
+    digest = sha256(temp_path.read_bytes())
+    base = PACKAGE_DIR / 'FAM-Academy-manual-157682a.tar.gz'
+    if not base.exists() or sha256(base.read_bytes()) == digest:
+        destination = base
+    else:
+        destination = PACKAGE_DIR / f'FAM-Academy-manual-157682a-{digest[:10]}.tar.gz'
+    if destination.exists():
+        if sha256(destination.read_bytes()) != digest:
+            temp_path.unlink()
+            fail(f'Bundle output already exists with different bytes: {destination}')
+        temp_path.unlink()
+    else:
+        os.replace(temp_path, destination)
+        os.chmod(destination, 0o644)
+    checksum_path = destination.with_name(destination.name + '.sha256')
+    checksum_text = f'{digest}  {destination.name}\n'
+    if checksum_path.exists() and checksum_path.read_text(encoding='ascii') != checksum_text:
+        fail(f'Bundle checksum file already exists and differs: {checksum_path}')
+    if not checksum_path.exists():
+        checksum_path.write_text(checksum_text, encoding='ascii')
+    return destination, digest
+
+
+def verify_tarball(path: Path, expected_count: int) -> None:
+    with tarfile.open(path, 'r:gz') as archive:
+        members = archive.getmembers()
+        if any(not member.isfile() for member in members):
+            fail('Bundle contains a non-regular file')
+        names = {member.name for member in members}
+        if 'payload.sha256' not in names or 'baseline.sha256' not in names or 'install.sh' not in names:
+            fail('Bundle is missing an installer or checksum manifest')
+        payload_names = [name for name in names if name.startswith('payload/') and name != 'payload.sha256']
+        if len(payload_names) != expected_count:
+            fail(f'Bundle payload contains {len(payload_names)} files; expected {expected_count}')
+        manifest = archive.extractfile('payload.sha256').read().decode('ascii').splitlines()
+        expected = {line.split('  ', 1)[1] for line in manifest if '  ' in line}
+        if expected != {name.removeprefix('payload/') for name in payload_names}:
+            fail('Bundle payload checksum manifest does not match its file set')
+        for line in manifest:
+            digest, relative = line.split('  ', 1)
+            member = archive.extractfile('payload/' + relative)
+            if member is None or sha256(member.read()) != digest:
+                fail(f'Bundle payload checksum mismatch: {relative}')
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--content-only', action='store_true', help='generate runtime Academy content files without creating a deployment archive')
+    parser.add_argument('--refresh-content', action='store_true', help='refresh generated Academy content and catalogue after source changes')
+    args = parser.parse_args()
+    if subprocess.call(['git', 'cat-file', '-e', f'{BASE_COMMIT}^{{commit}}'], cwd=REPO_ROOT, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
+        fail(f'Pinned commit is not available locally: {BASE_COMMIT}')
+    catalog, payload = build_catalog()
+    write_content_without_overwrite(payload, refresh=args.refresh_content)
+    if args.content_only:
+        print(f'Academy content prepared: {catalog["counts"]}')
+        return
+    entries = package_entries(payload)
+    archive_path, digest = create_tarball(entries)
+    verify_tarball(archive_path, len(payload) + len(EXECUTABLE_FILES))
+    print(f'Bundle: {archive_path.relative_to(REPO_ROOT)}')
+    print(f'SHA-256: {digest}')
+    print(f'Payload files: {len(payload) + len(EXECUTABLE_FILES)} ({len(EXECUTABLE_FILES)} executable files, 76 Markdown, 52 SVG, 1 catalogue)')
+    print(f'Counts: {json.dumps(catalog["counts"], ensure_ascii=False, sort_keys=True)}')
+
+
+if __name__ == '__main__':
+    main()
