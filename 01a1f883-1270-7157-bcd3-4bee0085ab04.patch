+    academy_fail "Automatic rollback did not complete. Stop using Academy and use the verified backup directory: $BACKUP_DIR"
+  fi
+  academy_fail "Payload application failed; previous Academy files and app image were restored. Backup retained at $BACKUP_DIR"
+fi
+
