5\u0627\u0644 \u0627\u0633\u062A. \u0627\u0628\u0632\u0627\u0631: `netstat -s` (\u0648\u06CC\u0646\u062F\u0648\u0632) \u06CC\u0627 `ss -ti` (\u0644\u06CC\u0646\u0648\u06A9\u0633)."]},{h:"UDP: \u06A9\u0650\u06CC \u0648 \u0686\u0631\u0627",p:["UDP \u0646\u0647 \u062F\u0633\u062A\u200C\u062F\u0627\u062F\u0646 \u062F\u0627\u0631\u062F\u060C \u0646\u0647 ACK\u060C \u0646\u0647 \u062A\u0631\u062A\u06CC\u0628. \u06F8 \u0628\u0627\u06CC\u062A \u0633\u0631\u0622\u06CC\u0646\u062F \u062F\u0627\u0631\u062F \u0648 \u0628\u0631\u0627\u06CC \u0635\u062F\u0627\u060C \u0648\u06CC\u062F\u06CC\u0648\u060C \u0628\u0627\u0632\u06CC\u060C DNS \u0648 DHCP \u0627\u06CC\u062F\u0647\u200C\u0622\u0644 \u0627\u0633\u062A.","\u0642\u06CC\u0645\u062A\u0634 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u06AF\u0645\u200C\u0634\u062F\u0646 \u0628\u0633\u062A\u0647 \u0631\u0627 \u062E\u0648\u062F\u0650 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0627\u06CC\u062F \u0645\u062F\u06CC\u0631\u06CC\u062A \u06A9\u0646\u062F. \u062F\u0631 \u062A\u0645\u0627\u0633 \u062A\u0635\u0648\u06CC\u0631\u06CC\u060C \u0627\u0632 \u062F\u0633\u062A \u062F\u0627\u062F\u0646 \u0686\u0646\u062F \u0641\u0631\u06CC\u0645 \u0628\u0647\u062A\u0631 \u0627\u0632 \u062A\u0623\u062E\u06CC\u0631 \u0627\u0633\u062A.","\u0628\u0639\u0636\u06CC \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627 \u0631\u0648\u06CC UDP \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u0648 \u0627\u06AF\u0631 \u0641\u0642\u0637 TCP \u0631\u0627 \u062A\u0633\u062A \u06A9\u0646\u06CC\u060C \u0641\u06A9\u0631 \u0645\u06CC\u200C\u06A9\u0646\u06CC \xAB\u0633\u0631\u0648\u06CC\u0633 \u0646\u06CC\u0633\u062A\xBB. DNS \u0648 DHCP \u0648 RADIUS \u0646\u0645\u0648\u0646\u0647\u200C\u0627\u0646\u062F."],table:{head:["\u0648\u06CC\u0698\u06AF\u06CC","TCP","UDP"],rows:[["\u0627\u062A\u0635\u0627\u0644","\u0633\u0647\u200C\u06AF\u0627\u0645","\u0628\u062F\u0648\u0646 \u0627\u062A\u0635\u0627\u0644"],["\u0642\u0627\u0628\u0644\u06CC\u062A \u0627\u0