+  }
+  await page.click('#le-complete-btn');
+  await page.waitForFunction(() => window.FamAcademyBridge?.progress?.completed?.includes('ccna-osi-tcpip'));
+  await page.reload({ waitUntil: 'networkidle' });
+  assert(await page.evaluate(() => window.FamAcademyBridge.progress.completed.includes('ccna-osi-tcpip')));
+  assert.deepEqual(errors, []);
+  console.log('PASS: Real Flask login, CSP, assets, dashboard, roadmap, six visible lesson stages and server-backed progress after reload');
