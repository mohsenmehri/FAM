+.fa-gradient{background:linear-gradient(90deg,var(--fa-blue),var(--fa-violet) 60%,#df86ef);-webkit-background-clip:text;background-clip:text;color:transparent}
+.fa-hero p{max-width:660px;color:var(--fa-muted);font-size:14px;margin:0;line-height:2}
+.fa-hero-art{min-height:190px;display:grid;place-items:center;position:relative}
+.fa-orb{width:190px;height:190px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#75eaff,#6577fa 38%,#9d55d5 68%,transparent 73%);filter:blur(2px);opacity:.78;box-shadow:0 0 80px #827dff44}
+.fa-orb:after{content:"";position:absolute;inset:18px;border:1px solid #b7c8ff55;border-radius:50%}
+.fa-float{position:absolute;padding:9px 12px;border:1px solid var(--fa-line);border-radius:13px;background:var(--fa-panel);color:var(--fa-muted);font-size:10px;box-shadow:0 12px 30px #0003}
+.fa-float b{display:block;color:var(--fa-text);font-size:13px}.fa-float.one{top:8px;right:0}.fa-float.two{bottom:8px;left:0}
+.fa-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
+.fa-stat{padding:15px 17px;border:1px solid var(--fa-line);border-radius:17px;background:var(--fa-panel);display:flex;align-items:center;gap:12px;min-width:0}
+.fa-stat-icon{width:40px;height:40px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,#52d6ef2c,#a78bfa30);font-size:18px}
+.fa-stat strong{display:block;font-size:21px;line-height:1.3}.fa-stat small{display:block;color:var(--fa-muted);font-size:10px}
+.fa-section-head{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap}
+.fa-section-head h2{font-size:20px;margin:0}.fa-section-head p{font-size:11px;color:var(--fa-muted);margin:4px 0 0}
+.fa-path-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
+.fa-path-card{position:relative;overflow:hidden;border:1px solid var(--fa-line);border-radius:21px;background:var(--fa-panel);padding:22px;box-shadow:0 18px 45px #0002;display:flex;flex-direction:column;gap:13px;min-width:0}
+.fa-path-card:before{content:"";position:absolute;width:190px;height:190px;border-radius:50%;filter:blur(55px);opacity:.15;top:-100px;left:-65px;background:var(--fa-glow)}
+.fa-path-top,.fa-path-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;position:relative}
+.fa-path-icon{width:48px;height:48px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(135deg,color-mix(in srgb,var(--fa-glow) 40%,transparent),transparent);border:1px solid color-mix(in srgb,var(--fa-glow) 50%,transparent);font-size:21px}
+.fa-tag{padding:5px 9px;border:1px solid var(--fa-line);border-radius:99px;color:var(--fa-muted);font-size:9px}
+.fa-path-code{color:var(--fa-glow);font-size:10px;letter-spacing:1px;font-weight:900;direction:ltr;text-align:right}
+.fa-path-card h3{font-size:20px;margin:0}.fa-path-card p{font-size:12px;color:var(--fa-muted);line-height:1.9;margin:0;min-height:44px}
+.fa-progress{height:7px;border-radius:99px;background:var(--fa-panel2);overflow:hidden}.fa-progress span{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,var(--fa-blue),var(--fa-violet))}
+.fa-path-meta{display:flex;gap:14px;flex-wrap:wrap;color:var(--fa-muted);font-size:10px}
+.fa-path-foot{border-top:1px solid var(--fa-line);padding-top:13px}.fa-path-foot strong{font-size:12px}
+.fa-action{border:1px solid var(--fa-line);border-radius:12px;background:var(--fa-panel2);color:var(--fa-text);padding:9px 13px;font:inherit;font-size:11px;font-weight:800;cursor:pointer}
+.fa-action.primary{border:0;color:#081326;background:linear-gradient(110deg,#5bd8ef,#9c8cff)}
+.fa-roadmap{border:1px solid var(--fa-line);border-radius:22px;background:var(--fa-panel);padding:20px;overflow:hidden}
+.fa-course{border:1px solid var(--fa-line);border-radius:17px;background:var(--fa-panel);padding:17px;margin:13px 0}
+.fa-course-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
+.fa-course-head h3{font-size:15px;margin:0}.fa-course-head small{color:var(--fa-muted);font-size:10px}
+.fa-lesson-list{display:grid;gap:8px}
+.fa-lesson-row{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--fa-line);border-radius:13px;background:var(--fa-panel2);min-width:0}
+.fa-lesson-num{width:34px;height:34px;flex:0 0 34px;border-radius:10px;display:grid;place-items:center;background:#55c8ff1a;color:var(--fa-blue);font-size:11px;font-weight:900}
+.fa-lesson-info{flex:1;min-width:0}.fa-lesson-info strong{display:block;font-size:12px}.fa-lesson-info small{display:block;color:var(--fa-muted);font-size:10px;margin-top:3px}
+.fa-lesson-row button{flex:0 0 auto}
+.fa-back-btn{margin-bottom:14px}
+.fa-complete{color:var(--fa-green);font-size:11px}
+@media(max-width:900px){.fa-hero{grid-template-columns:1fr}.fa-hero-art{min-height:150px}.fa-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
+@media(max-width:650px){.fa-topbar{align-items:flex-start}.fa-brand{margin-bottom:4px}.fa-nav{width:100%;overflow-x:auto;flex-wrap:nowrap}.fa-nav .btn{white-space:nowrap}.fa-path-grid{grid-template-columns:1fr}.fa-hero{padding:20px}.fa-hero h1{font-size:30px}.fa-stat{padding:11px}.fa-stat strong{font-size:18px}.fa-lesson-row{align-items:flex-start;flex-wrap:wrap}.fa-lesson-row button{margin-right:46px}}
+@media(prefers-reduced-motion:no-preference){.fa-path-card{transition:transform .2s,border-color .2s}.fa-path-card:hover{transform:translateY(-3px);border-color:#7b9cff77}}
