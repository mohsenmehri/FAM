9\u200C\u0634\u062F\u0647 \u062E\u0648\u062F\u0634 \u0631\u0627 \u0628\u0627 AD \u0628\u0647\u062A\u0631 \u0627\u0632 \u0645\u0633\u06CC\u0631 \u0627\u0635\u0644\u06CC \u0628\u0628\u06CC\u0646\u062F \u0648 \u0622\u0646 \u0631\u0627 \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646 \u06A9\u0646\u062F\u061B \u0646\u062A\u06CC\u062C\u0647 \u06CC\u06A9 \u062D\u0644\u0642\u0647 \u06CC\u0627 \u0645\u0633\u06CC\u0631 \u063A\u06CC\u0631\u0628\u0647\u06CC\u0646\u0647 \u0627\u0633\u062A.","\u0631\u0627\u0647\u200C\u062D\u0644 \u06A9\u0644\u0627\u0633\u06CC\u06A9: Tag \u0632\u062F\u0646. \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0627\u0632 EIGRP \u0622\u0645\u062F\u0647\u200C\u0627\u0646\u062F\u060C \u0628\u0627 \u06CC\u06A9 tag \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u0647\u0646\u06AF\u0627\u0645 \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0628\u0631\u06AF\u0634\u062A\u060C \u0622\u0646\u200C\u0647\u0627 \u0631\u0627 \u0631\u062F \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645. \u0631\u0648\u0634 \u062F\u06CC\u06AF\u0631: Distribute-List \u06CC\u0627 Route-Map \u0628\u0627 match tag \u0648 deny. \u0628\u0647 \u0627\u06CC\u0646 \u062A\u0631\u062A\u06CC\u0628 \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u06CC\u06A9\u200C\u0637\u0631\u0641\u0647 \u062F\u0631 \u0647\u0631 \u062C\u0647\u062A\u060C \u0641\u0642\u0637 \u06CC\u06A9 \u0628\u0627\u0631 \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F."],callout:{title:"\u0642\u0627\u0639\u062F\u0647 \u0637\u0644\u0627\u06CC\u06CC",text:"\u0647\u0645\u06CC\u0634\u0647 \u0627\u0648\u0644 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u062F\u0642\u06CC\u0642 \u0631\u0627 \u0628\u0627 prefix-list \u0645\u0634\u062E\u0635 \u06A9\u0646\u060C \u0628\u0639\u062F \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639. \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0647\u0645\u0647\u200C\u0686\u06CC\u0632 (redistribute ospf 1 subnets \u0628\u062F\u0648\u0646 \u0641\u06CC\u0644\u062A\u0631) \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u062F\u0644\u06CC\u0644 \u0645\u0634\u06A9\u0644\u0627\u062A \u0639\u062C\u06CC\u0628 \u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u062A\u0631\u06A9\u06CC\u0628\u06CC \u0627\u0633\u062A."}},{h:"AD \u0648 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0633\u06CC\u0631",p:["\u0648\u0642\u062A\u06CC \u06CC\u06A9 \u067E\u06CC\u0634\u0648\u0646\u062F \u0627\u0632 \u062F\u0648 \u0645\u0646\u0628\u0639 \u0645\u062E\u062A\u0644\u0641 \u0634\u0646\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0631\u0648\u062A\u0631 \u0628\u0631 \u0627\u0633\u0627\u0633 Administrative Distance \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F: Connected \u0635\u0641\u0631\u060C Static \u06CC\u06A9\u060C EIGRP \u062F\u0627\u062E\u0644\u06CC \u06F9\u06F0\u060C OSPF \u06F1\u06F1\u06F0\u060C RIP \u06F1\u06F2\u06F0 \u0648 EIGRP \u062E\u0627\u0631\u062C\u06CC \u06F1\u06F7\u06F0. \u062A\u0648\u062C\u0647 \u06A9\u0646 \u06A9\u0647 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639\u200C\u0634\u062F\u0647 \u0645\u0639\u0645\u0648\u0644\u0627\u064B EIGRP \u062E\u0627\u0631\u062C\u06CC (\u06F1\u06F7\u06F0) \u062D\u0633\u0627\u0628 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F\u060C \u067E\u0633 \u0627\u06AF\u0631 \u0647\u0645\u0627\u0646 \u067E\u06CC\u0634\u0648\u0646\u062F \u0627\u0632 OSPF \u0647\u0645 \u0628\u06CC\u0627\u06CC\u062F (\u06F1\u06F1\u06F0)\u060C OSPF \u0628\u0631\u0646\u062F\u0647 \u0627\u0633\u062A \u0648 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0622\u0646\u0686\u0647 \u0627\u0646\u062A\u0638\u0627\u0631 \u062F\u0627\u0631\u06CC \u0631\u062E \u0646\u062F\u0647\u062F.","\u0631\u0648\u0634 \u06A9\u0646\u062A\u0631\u0644: \u062A\u063A\u06CC\u06CC\u0631 AD \u0628\u0627 distance \u062F\u0631 \u067E\u0631\u0648\u062A\u06A9\u0644\u060C \u06CC\u0627 \u0641\u06CC\u0644\u062A\u0631 \u06A9\u0631\u062F\u0646 \u0645\u0633\u06CC\u0631\u060C \u06CC\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 tag \u0648 route-map. \u062F\u0631 \u0622\u0632\u0645\u0648\u0646\u200C\u0647\u0627 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0627\u0632 \u062A\u0648\u0636\u06CC\u062D \xAB\u0686\u0631\u0627 \u0645\u0633\u06CC\u0631 \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639\u200C\u0634\u062F\u0647 \u0627\u0646\u062A\u062E\u0627\u0628 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\xBB \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u0648 \u062C\u0648\u0627\u0628 \u062F\u0631 AD \u06CC\u0627 \u0645\u062A\u0631\u06CC\u06A9 \u0627\u0633\u062A."]},{h:"\u0631\u0648\u0634 \u0627\u062C\u0631\u0627 \u0648 \u0628\u0631\u0631\u0633\u06CC",p:["\u0645\u0631\u0627\u062D\u0644: \u06F1) \u06CC\u06A9 prefix-list \u0628\u0633\u0627\u0632 \u06A9\u0647 \u0641\u0642\u0637 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0645\u0648\u0631\u062F\u0646\u0638\u0631 \u0631\u0627 \u0645\u062C\u0627\u0632 \u06A9\u0646\u062F. \u06F2) \u06CC\u06A9 route-map \u0628\u0633\u0627\u0632 \u0648 \u062F\u0631 \u0622\u0646 match ip address prefix-list \u0628\u06AF\u0630\u0627\u0631 \u0648 set tag \u0628\u062F\u0647. \u06F3) \u062F\u0631 router ospf\u060C \u062F\u0633\u062A\u0648\u0631 redistribute eigrp 10 subnets route-map RM-TO-OSPF \u0631\u0627 \u0627\u062C\u0631\u0627 \u06A9\u0646. \u06F4) \u0647\u0645\u0627\u0646 \u0631\u0627 \u062F\u0631 \u062C\u0647\u062A \u0645\u0642\u0627\u0628\u0644 \u062A\u06A9\u0631\u0627\u0631 \u06A9\u0646.","\u0628\u0631\u0631\u0633\u06CC: show ip route \u0628\u0631\u0627\u06CC \u062F\u06CC\u062F\u0646 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC E1/E2 \u06CC\u0627 D EX\u060C show ip ospf database external \u0628\u0631\u0627\u06CC \u062F\u06CC\u062F\u0646 LSA \u0646\u0648\u0639 \u06F5\u060C \u0648 show route-map \u0628\u0631\u0627\u06CC \u062F\u06CC\u062F\u0646 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u062A\u0637\u0628\u06CC\u0642\u200C\u0647\u0627. \u0627\u06AF\u0631 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u0635\u0641\u0631 \u0627\u0633\u062A\u060C prefix-list \u06CC\u0627 match \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0633\u062A."]}],analogy:"\u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0645\u062B\u0644 \u0645\u062A\u0631\u062C\u0645 \u0628\u06CC\u0646 \u062F\u0648 \u0646\u0641\u0631 \u0627\u0633\u062A \u06A9\u0647 \u06CC\u06A9\u06CC \u0645\u062A\u0631 \u0648 \u062F\u06CC\u06AF\u0631\u06CC \u0641\u0648\u062A \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0628\u062F\u0648\u0646 \u062A\u0628\u062F\u06CC\u0644 \u0648\u0627\u062D\u062F (Seed Metric) \u067E\u06CC\u0627\u0645 \u0628\u06CC\u200C\u0645\u0639\u0646\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0648 \u0627\u06AF\u0631 \u0647\u0631 \u062F\u0648 \u0646\u0641\u0631 \u0645\u062A\u0631\u062C\u0645 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F \u0648 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627 \u0628\u0631\u06AF\u0631\u062F\u0646\u062F\u060C \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u06CC\u06A9 \u062D\u0631\u0641 \u0686\u0646\u062F \u0628\u0627\u0631 \u062A\u0631\u062C\u0645\u0647 \u0648 \u062E\u0631\u0627\u0628 \u0634\u0648\u062F (\u062D\u0644\u0642\u0647 \u0628\u0627\u0632\u062E\u0648\u0631\u062F).",pitfalls:["\u0641\u0631\u0627\u0645\u0648\u0634\u200C\u06A9\u0631\u062F\u0646 subnets \u062F\u0631 OSPF: \u0641\u0642\u0637 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC classful \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F.","\u0646\u062F\u0627\u062F\u0646 Seed Metric: \u0645\u0633\u06CC\u0631 \u062F\u0631 \u062C\u062F\u0648\u0644 EIGRP \u062F\u06CC\u062F\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u0646\u0628\u0648\u062F \u0641\u06CC\u0644\u062A\u0631 \u0648 tag: \u062D\u0644\u0642\u0647 \u0628\u0627\u0632\u062E\u0648\u0631\u062F \u0648 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u063A\u06CC\u0631\u0628\u0647\u06CC\u0646\u0647."],exam:["EIGRP \u062E\u0627\u0631\u062C\u06CC AD = \u06F1\u06F7\u06F0\u060C OSPF = \u06F1\u06F1\u06F0\u060C static = \u06F1.","OSPF \u0646\u06CC\u0627\u0632 \u0628\u0647 subnets \u0628\u0631\u0627\u06CC \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u063A\u06CC\u0631classful \u062F\u0627\u0631\u062F.","Tag \u0632\u062F\u0646 \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u0631\u0627\u0647 \u062C\u0644\u0648\u06AF\u06CC\u0631\u06CC \u0627\u0632 \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0628\u0631\u06AF\u0634\u062A\u06CC \u0627\u0633\u062A."],glossary:[["Seed Metric","\u0645\u062A\u0631\u06CC\u06A9 \u0627\u0648\u0644\u06CC\u0647\u200C\u0627\u06CC \u06A9\u0647 \u0647\u0646\u06AF\u0627\u0645 \u0648\u0631\u0648\u062F \u0645\u0633\u06CC\u0631 \u0628\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644 \u062C\u062F\u06CC\u062F \u062A\u0639\u06CC\u06CC\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F."],["Tag","\u0628\u0631\u0686\u0633\u0628\u06CC \u06A9\u0647 \u0628\u0647 \u0645\u0633\u06CC\u0631 \u0645\u06CC\u200C\u0686\u0633\u0628\u062F \u062A\u0627 \u062F\u0631 \u0641\u06CC\u0644\u062A\u0631 \u06CC\u0627 \u0628\u0627\u0632\u062A\u0648\u0632\u06CC\u0639 \u0628\u0639\u062F\u06CC \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u0634\u0648\u062F."],["Prefix-list","\u0641\u06CC\u0644\u062A\u0631 \u0645\u0633\u06CC\u0631 \u0628\u0631 \u0627\u0633\u0627\u0633 \u067E\u06CC\u0634\u0648\u0646\u062F \u0648 \u0637\u0648\u0644 \u0645\u0627\u0633\u06A9."],["E1 / E2","\u0645\u0633\u06CC\u0631\u0647\u0627\u06CC OSPF \u062E\u0627\u0631\u062C\u06CC \u0628\u0627 \u0645\u062A\u0631\u06CC\u06A9 \u0627\u0641\u0632\u0627\u06CC\u0634\u06CC \u06CC\u0627 \u062B\u0627\u0628\u062A."]]},pbr:{prereq:["static-routing","acl"],related:["redistribution","qos"],title:"PBR \u2014 \u0648\u0642\u062A\u06CC \u0645\u0642\u0635\u062F \u062A\u0646\u0647\u0627 \u0645\u0644\u0627\u06A9 \u0646\u06CC\u0633\u062A",tagline:"\u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC \u0641\u0642\u0637 \u0645\u0642\u0635\u062F \u0631\u0627 \u0645\u06CC\u200C\u0628\u06CC\u0646\u062F\u061B PBR \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u0628\u062F\u0623\u060C \u067E\u0648\u0631\u062A \u06CC\u0627 \u0646\u0648\u0639 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062A\u0635\u0645\u06CC\u0645 \u0628\u06AF\u06CC\u0631\u062F.",minutes:12,goals:["\u062A\u0641\u0627\u0648\u062A PBR \u0628\u0627 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC \u0631\u0627 \u062F\u0631 \u06CC\u06A9 \u062C\u0645\u0644\u0647 \u0628\u06AF\u0648\u06CC\u06CC","\u0628\u0627 route-map \u0648 match/set \u06CC\u06A9 \u0633\u06CC\u0627\u0633\u062A \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0628\u0646\u0648\u06CC\u0633\u06CC","\u0628\u062F\u0627\u0646\u06CC \u0686\u0631\u0627 PBR \u0631\u0648\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062E\u0648\u062F \u0631\u0648\u062A\u0631 \u0627\u062B\u0631 \u0646\u062F\u0627\u0631\u062F \u0648 ip local policy \u0686\u06CC\u0633\u062A"],sections:[{h:"\u0686\u0631\u0627 PBR \u0644\u0627\u0632\u0645 \u0627\u0633\u062A\u061F",p:["\u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0628\u0631 \u0627\u0633\u0627\u0633 \xAB\u06A9\u062C\u0627 \u0645\u06CC\u200C\u0631\u0648\u06CC\xBB \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0627\u0645\u0627 \u06AF\u0627\u0647\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0641\u06CC \u0646\u06CC\u0633\u062A: \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u0627\u0632 \u0644\u06CC\u0646\u06A9 A \u0628\u0631\u0648\u062F \u0648 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0627\u0632 \u0644\u06CC\u0646\u06A9 B\u060C \u062D\u062A\u06CC \u0627\u06AF\u0631 \u0645\u0642\u0635\u062F\u0634\u0627\u0646 \u06CC\u06A9\u06CC \u0628\u0627\u0634\u062F. \u06CC\u0627 \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 VoIP \u0628\u0627 \u06A9\u06CC\u0641\u06CC\u062A \u0628\u0627\u0644\u0627 \u0645\u0633\u06CC\u0631\u06CC \u0634\u0648\u062F \u0648 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u06A9\u0627\u067E \u0627\u0632 WAN بانک \u0627\u0631\u0632\u0627\u0646. PBR \u0627\u06CC\u0646 \u0642\u062F\u0631\u062A \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u0628\u062F\u0623\u060C \u067E\u0648\u0631\u062A \u0645\u0642\u0635\u062F\u060C \u067E\u0631\u0648\u062A\u06A9\u0644 \u06CC\u0627 DSCP \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0646\u06CC.","PBR \u062F\u0631 \u0646\u0642\u0637\u0647 \u0648\u0631\u0648\u062F (ingress) \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0642\u0628\u0644 \u0627\u0632 \u0627\u06CC\u0646\u06A9\u0647 \u0628\u0633\u062A\u0647 \u0628\u0647 \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC \u0628\u0631\u0633\u062F. \u0627\u06AF\u0631 \u0647\u06CC\u0686 \u06A9\u06CC\u0633\u06CC \u062A\u0637\u0628\u06CC\u0642 \u0646\u062E\u0648\u0631\u062F\u060C \u0628\u0633\u062A\u0647 \u0628\u0647 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F \u2014 \u0627\u06CC\u0646 \u0631\u0641\u062A\u0627\u0631 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0645\u0647\u0645 \u0627\u0633\u062A."]},{h:"\u0633\u0627\u062E\u062A\u0627\u0631 \u06CC\u06A9 \u0633\u06CC\u0627\u0633\u062A",p:["\u0628\u0627 access-list \u06CC\u0627 prefix-list \u0645\u0634\u062E\u0635 \u0645\u06CC\u200C\u06A9\u0646\u06CC \u0686\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9\u06CC \u0631\u0627 \u0628\u06AF\u06CC\u0631\u062F\u060C \u0628\u0627 route-map \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC \u0686\u0647 \u0634\u0648\u062F\u060C \u0648 \u0628\u0627 ip policy route-map NAME \u0622\u0646 \u0631\u0627 \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0648\u0631\u0648\u062F\u06CC \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u06CC. \u062F\u0631 route-map \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0627\u0632 set ip next-hop (\u0622\u062F\u0631\u0633 \u0628\u0639\u062F\u06CC \u0645\u0634\u062E\u0635)\u060C set interface (\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062E\u0631\u0648\u062C\u06CC) \u06CC\u0627 set ip default next-hop (\u0641\u0642\u0637 \u0627\u06AF\u0631 \u0645\u0633\u06CC\u0631 \u0645\u0639\u0645\u0648\u0644\u06CC \u0646\u0628\u0648\u062F) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062A\u0641\u0627\u0648\u062A \u0645\u0647\u0645: set ip next-hop \u0627\u0648\u0644\u0648\u06CC\u062A \u062F\u0627\u0631\u062F \u0648 \u0628\u0639\u062F \u0627\u0632 \u0622\u0646 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC \u0627\u062C\u0631\u0627 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F (\u0627\u0644\u0628\u062A\u0647 \u0627\u06AF\u0631 next-hop \u062F\u0631 \u062F\u0633\u062A\u0631\u0633 \u0646\u0628\u0627\u0634\u062F\u060C \u0628\u0633\u062A\u0647 \u0628\u0647 \u0631\u0641\u062A\u0627\u0631 \u067E\u0644\u062A\u0641\u0631\u0645 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0628\u0647 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC \u0628\u0631\u06AF\u0631\u062F\u062F). set ip default next-hop \u0641\u0642\u0637 \u0648\u0642\u062A\u06CC \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0631\u0627\u0647\u06CC \u0646\u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\u061B \u0627\u06CC\u0646 \u062A\u0641\u0627\u0648\u062A \u062F\u0631 \u0622\u0632\u0645\u0648\u0646 \u0628\u0633\u06CC\u0627\u0631 \u067E\u0631\u0633\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F."],list:["match ip address \xB7 match length \xB7 match ip dscp","set ip next-hop A.B.C.D","set interface Serial0/0","set ip default next-hop","set ip precedence / dscp (\u0628\u0631\u0627\u06CC \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC \u0647\u0645\u0631\u0627\u0647 \u0645\u0633\u06CC\u0631)"]},{h:"\u062F\u0648 \u0646\u06A9\u062A\u0647 \u06A9\u0647 \u062F\u0631 \u0639\u0645\u0644 \u0645\u0647\u0645\u200C\u0627\u0646\u062F",p:["\u0627\u0648\u0644: PBR \u0631\u0648\u06CC \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u062E\u0648\u062F \u0631\u0648\u062A\u0631 \u062A\u0648\u0644\u06CC\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0645\u062B\u0644 \u067E\u06CC\u0646\u06AF \u06CC\u0627 SSH \u0627\u0632 \u062E\u0648\u062F \u0631\u0648\u062A\u0631) \u0627\u062B\u0631 \u0646\u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F\u060C \u0686\u0648\u0646 \u0622\u0646\u200C\u0647\u0627 \u0647\u06CC\u0686\u200C\u0648\u0642\u062A \u0627\u0632 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0648\u0631\u0648\u062F\u06CC \u0639\u0628\u0648\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. \u0628\u0631\u0627\u06CC \u0627\u06CC\u0646 \u062D\u0627\u0644\u062A \u0627\u0632 ip local policy route-map \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062F\u0648\u0645: PBR \u0628\u062F\u0648\u0646 \u0628\u0631\u0631\u0633\u06CC \u0648\u0636\u0639\u06CC\u062A \u0644\u06CC\u0646\u06A9\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0628\u0647 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u0642\u0637\u0639 \u0641\u0631\u0633\u062A\u0627\u062F\u061B \u0631\u0627\u0647\u200C\u062D\u0644\u060C \u062A\u0631\u06A9\u06CC\u0628 \u0628\u0627 IPSLA \u0648 route-map \u0628\u0627 track \u0627\u0633\u062A.","\u0628\u0631\u0631\u0633\u06CC: show route-map NAME (\u0634\u0645\u0627\u0631\u0646\u062F\u0647 match)\u06