48\u06CC\u062A \u062F\u0631 \u06AF\u0631\u0648\u0647\u200C\u0647\u0627\u06CC \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A (`224.0.0.0/4`). \u062F\u0631 **IGMPv3** \u06AF\u0632\u0627\u0631\u0634\u200C\u0647\u0627 \u0628\u0647 `224.0.0.22` \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0639\u0644\u0627\u0648\u0647 \u0628\u0631 \u06AF\u0631\u0648\u0647\u060C \u0622\u062F\u0631\u0633 \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u0645\u062C\u0627\u0632 \u0631\u0627 \u0647\u0645 \u0645\u0634\u062E\u0635 \u06A9\u0646\u062F (\u0628\u0631\u0627\u06CC **SSM**). \u0631\u0648\u06CC \u0633\u0648\u0626\u06CC\u0686\u200C\u0647\u0627\u06CC \u0644\u0627\u06CC\u0647 \u06F2 \u0646\u06CC\u0632 **IGMP Snooping** \u0628\u0627 \u06AF\u0648\u0634\u200C\u062F\u0627\u062F\u0646 \u0628\u0647 \u0627\u06CC\u0646 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627 \u062C\u0644\u0648\u06CC \u0633\u06CC\u0644\u0627\u0628 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A \u0628\u0647 \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u063A\u06CC\u0631\u0639\u0636\u0648 \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F.",labs:["multicast"]},{term:"PIM-SM",aliases:["PIM","RP","RPF"],full:"Protocol Independent Multicast \u2014 Sparse Mode",cat:"l3",def:"\u067E\u0631\u0648\u062A\u06A9\u0644 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A (IP Protocol 103\u060C \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A `224.0.0.13`): \u06AF\u06CC\u0631\u0646\u062F\u0647\u200C\u0647\u0627 \u0648 \u0645\u0646\u0627\u0628\u0639 \u0627\u0628\u062A\u062F\u0627 \u062F\u0631 \u06CC\u06A9 \u0646\u0642\u0637\u0647 \u0645\u06CC\u0639\u0627\u062F\u06AF\u0627\u0647 \u0645\u0631\u06A9\u0632\u06CC \u0628\u0647 \u0646\u0627\u0645 **RP (Rendezvous Point)** \u0628\u0627 \u062F\u0631\u062E\u062A \u0645\u0634\u062A\u0631\u06A9 `(*,G)` \u0628\u0647 \u0647\u0645 \u0645\u06CC\u200C\u0631\u0633\u0646\u062F \u0648 \u0633\u067E\u0633 \u0631\u0648\u062A\u0631 \u0645\u0642\u0635\u062F \u0628\u0627 \u0633\u0627\u062E\u062A \u062F\u0631\u062E\u062A \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631\u06CC\u0646 \u0645\u0633\u06CC\u0631 **(S,G) SPT** \u0645\u0633\u062A\u0642\u06CC\u0645\u0627\u064B \u0628\u0647 \u0633\u0645\u062A \u0645\u0646\u0628\u0639 \u0633\u0648\u0626\u06CC\u0686 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062F\u0631 \u0647\u0631 \u06AF\u0627\u0645\u060C \u0631\u0648\u062A\u0631 \u0628\u0627 \u0628\u0631\u0631\u0633\u06CC **RPF (Reverse Path Forwarding)** \u0645\u0637\u0645\u0626\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F \u0628\u0633\u062A\u0647 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A \u0627\u0632 \u0647\u0645\u0627\u0646 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633\u06CC \u0648\u0627\u0631\u062F \u0634\u062F\u0647 \u06A9\u0647 \u0628\u0647\u062A\u0631\u06CC\u0646 \u0645\u0633\u06CC\u0631 \u062A\u06A9\u200C\u067E\u062E\u0634\u06CC \u0628\u0647 \u0633\u0645\u062A \u0645\u0646\u0628\u0639 \u0627\u0632 \u0622\u0646 \u062E\u0627\u0631\u062C \u0645\u06CC\u200C\u0634\u0648\u062F \u062A\u0627 \u062D\u0644\u0642\u0647 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A \u0631\u062E \u0646\u062F\u0647\u062F.",labs:["multicast"]},{term:"FHRP",full:"First Hop Redundancy Protocol",cat:"services",def:"\u062E\u0627\u0646\u0648\u0627\u062F\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u0627\u0641\u0632\u0648\u0646\u06AF\u06CC \u062F\u0631\u0648\u0627\u0632\u0647 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 (\u0634\u0627\u0645\u0644 **HSRP**\u060C **VRRP** \u0648 **GLBP**) \u06A9\u0647 \u0628\u0647 \u062F\u0648 \u06CC\u0627 \u0686\u0646\u062F \u0631\u0648\u062A\u0631/\u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3 \u0627\u062C\u0627\u0632\u0647 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F \u06CC\u06A9 \u0