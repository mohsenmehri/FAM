o-advertise."],glossary:[["Local Preference","\u0627\u0648\u0644\u0648\u06CC\u062A \u0645\u0633\u06CC\u0631 \u062F\u0631\u0648\u0646 \u06CC\u06A9 AS."],["MED","\u067E\u06CC\u0634\u0646\u0647\u0627\u062F \u0628\u0647 AS \u0647\u0645\u0633\u0627\u06CC\u0647 \u0628\u0631\u0627\u06CC \u0627\u0646\u062A\u062E\u0627\u0628 \u0648\u0631\u0648\u062F\u06CC."],["RR","\u0631\u0648\u062A\u0631 \u0628\u0627\u0632\u062A\u0627\u0628\u200C\u062F\u0647\u0646\u062F\u0647 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC iBGP."],["maximum-prefix","\u062D\u062F\u0627\u06A9\u062B\u0631 \u062A\u0639\u062F\u0627\u062F \u067E\u06CC\u0634\u0648\u0646\u062F \u0645\u062C\u0627\u0632 \u0627\u0632 \u06CC\u06A9 \u0647\u0645\u0633\u0627\u06CC\u0647."]]},multicast:{prereq:["subnetting","static-routing"],related:["ospf-single","qos"],title:"\u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A \u0648 PIM-SM \u2014 \u06CC\u06A9 \u0641\u0631\u0633\u062A\u0646\u062F\u0647\u060C \u0647\u0632\u0627\u0631 \u06AF\u06CC\u0631\u0646\u062F\u0647",tagline:"\u062F\u0631 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A\u060C \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u06CC\u06A9 \u0646\u0633\u062E\u0647 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F \u0648 \u0634\u0628\u06A9\u0647 \u0622\u0646 \u0631\u0627 \u0641\u0642\u0637 \u0628\u0631\u0627\u06CC \u06A9\u0633\u0627\u0646\u06CC \u06A9\u0647 \u062E\u0648\u0627\u0633\u062A\u0647\u200C\u0627\u0646\u062F \u062A\u06A9\u062B\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F.",minutes:16,goals:["\u062A\u0641\u0627\u0648\u062A Unicast\u060C Broadcast \u0648 Multicast \u0631\u0627 \u0628\u0627 \u06CC\u06A9 \u0645\u062B\u0627\u0644 \u0639\u062F\u062F\u06CC \u0628\u06AF\u0648\u06CC\u06CC","\u0646\u0642\u0634 IGMP\u060C PIM \u0648 RP \u0631\u0627 \u062F\u0631 PIM-SM \u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC","\u0645\u0633\u06CC\u0631 \u062F\u0631\u062E\u062A \u0645\u0634\u062A\u0631\u06A9 (*,G) \u0648 \u062F\u0631\u062E\u062A \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631\u06CC\u0646 \u0645\u0633\u06CC\u0631 (S,G) \u0631\u0627 \u062A\u0641\u06A9\u06CC\u06A9 \u06A9\u0646\u06CC"],sections:[{h:"\u0686\u0631\u0627 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A\u061F",p:["\u0627\u06AF\u0631 \u06F1\u06F0\u06F0 \u06A9\u0627\u0631\u0628\u0631 \u06CC\u06A9 \u0648\u06CC\u062F\u06CC\u0648\u06CC \u0632\u0646\u062F\u0647 \u0631\u0627 \u062A\u0645\u0627\u0634\u0627 \u06A9\u0646\u0646\u062F\u060C \u062F\u0631 Unicast \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u0628\u0627\u06CC\u062F \u06F1\u06F0\u06F0 \u0646\u0633\u062E\u0647 \u0628\u0641\u0631\u0633\u062A\u062F. \u062F\u0631 Broadcast\u060C \u0628\u0633\u062A\u0647 \u0628\u0647 \u0647\u0645\u0647 \u0645\u06CC\u200C\u0631\u0648\u062F\u060C \u062D\u062A\u06CC \u06A9\u0633\u0627\u0646\u06CC \u06A9\u0647 \u0646\u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u0646\u062F. \u062F\u0631 Multicast\u060C \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u06CC\u06A9 \u0646\u0633\u062E\u0647 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F \u0648 \u0634\u0628\u06A9\u0647 \u0641\u0642\u0637 \u062F\u0631 \u0646\u0642\u0627\u0637\u06CC \u06A9\u0647 \u06AF\u06CC\u0631\u0646\u062F\u0647 \u062F\u0627\u0631\u062F \u062A\u06A9\u062B\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u06CC\u0646 \u062A\u0641\u0627\u0648\u062A \u062F\u0631 \u0645\u0642\u06CC\u0627\u0633\u060C \u062A\u0641\u0627\u0648\u062A \u0628\u06CC\u0646 \u06CC\u06A9 \u0634\u0628\u06A9\u0647 \u0633\u0627\u0644\u0645 \u0648 \u06CC\u06A9 \u0634\u0628\u06A9\u0647 \u0627\u0634\u0628\u0627\u0639 \u0627\u0633\u062A.","\u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A \u062F\u0631 \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC \u06A9\u0644\u0627\u0633 D \u06CC\u0639\u0646\u06CC 224.0.0.0/4 \u0632\u0646\u062F\u06AF\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F (224.0.0.0 \u062A\u0627 239.255.255.255). \u0628\u062E\u0634 224.0.0.x \u0628\u0631\u0627\u06CC \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644 \u0645\u062D\u0644\u06CC \u0631\u0632\u0631\u0648 \u0627\u0633\u062A\u061B \u0628\u0631\u0627\u06CC \u062F\u0627\u062F\u0647 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0627\u0632 239.0.0.0/8 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0622\u062F\u0631\u0633 MAC \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A \u0647\u0645 01:00:5E \u0628\u0627 \u0628\u06CC\u062A\u200C\u0647\u0627\u06CC \u0645\u0634\u062E\u0635 \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F."],list:["224.0.0.1 \u2014 all hosts \xB7 224.0.0.2 \u2014 all routers","224.0.0.5 / .6 \u2014 OSPF \xB7 224.0.0.9 \u2014 RIPv2","239.0.0.0/8 \u2014 \u0645\u062D\u062F\u0648\u062F\u0647 \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u0633\u0627\u0632\u0645\u0627\u0646\u200C\u0647\u0627","IGMPv2/v3 \u2014 \u0645\u06A9\u0627\u0644\u0645\u0647 \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0628\u0627 \u0631\u0648\u062A\u0631 \u0645\u062D\u0644\u06CC"]},{h:"IGMP \u0648 PIM",p:["IGMP \u0628\u06CC\u0646 \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0648 \u0631\u0648\u062A\u0631 \u0644\u0627\u06CC\u0647 \u06F3 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0648\u0642\u062A\u06CC \u06A9\u0644\u0627\u06CC\u0646\u062A \u0628\u0633\u062A\u0647\u200C\u0627\u06CC \u0628\u0631\u0627\u06CC \u062F\u06CC\u062F\u0646 \u06AF\u0631\u0648\u0647 \u062F\u0631\u06CC\u0627\u0641\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F (\u062F\u0631 IGMPv2 \u0628\u0627 Report)\u060C \u0631\u0648\u062A\u0631 \u0645\u06CC\u200C\u0641\u0647\u0645\u062F \u0627\u06CC\u0646 \u06AF\u0631\u0648\u0647 \u06AF\u06CC\u0631\u0646\u062F\u0647 \u062F\u0627\u0631\u062F \u0648 \u0628\u0627 Query \u062F\u0648\u0631\u0647\u200C\u0627\u06CC \u0645\u0637\u0645\u0626\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F \u0647\u0646\u0648\u0632 \u062F\u0627\u0631\u062F. IGMPv3 \u0627\u0645\u06A9\u0627\u0646 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0646\u0628\u0639 (SSM) \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F.","PIM \u0628\u06CC\u0646 \u0631\u0648\u062A\u0631\u0647\u0627 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062F\u0631\u062E\u062A \u062A\u0648\u0632\u06CC\u0639 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F. PIM Dense Mode \u0628\u0627 \u0633\u06CC\u0644 \u06A9\u0631\u062F\u0646 \u0648 \u0647\u0631\u0633 \u06A9\u0631\u062F\u0646 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0642\u062F\u06CC\u0645\u06CC \u0648 \u0628\u06CC\u200C\u0631\u062D\u0645)\u060C PIM Sparse Mode \u0628\u0627 \u06CC\u06A9 \u0646\u0642\u0637\u0647 \u0645\u0631\u06A9\u0632\u06CC \u0628\u0647 \u0646\u0627\u0645 RP (Rendezvous Point) \u0648 \u062B\u0628\u062A\u200C\u0646\u0627\u0645 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062F\u0631 SM \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0628\u0627 (*,G) join \u0628\u0647 \u0633\u0645\u062A RP \u0645\u06CC\u200C\u0631\u0648\u062F \u0648 \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u0647\u0645 \u0628\u0627 \u062B\u0628\u062A (*,G) \u0628\u0647 RP \u0645\u06CC\u200C\u0631\u0633\u062F\u061B \u0628\u0639\u062F \u0627\u0632 \u0628\u0631\u0642\u0631\u0627\u0631\u06CC\u060C \u0634\u0628\u06A9\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u0633\u06CC\u0631 \u0645\u0633\u062A\u0642\u06CC\u0645 \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631 (S,G) \u0628\u0633\u0627\u0632\u062F."],callout:{title:"\u0646\u06A9\u062A\u0647 \u0645\u0647\u0645",text:"PIM \u0628\u0631\u0627\u06CC \u0627\u0646\u062A\u062E\u0627\u0628 \u0647\u0645\u0633\u0627\u06CC\u0647 \u0628\u0627\u0644\u0627\u062F\u0633\u062A\u06CC \u0648 \u0628\u0631\u0631\u0633\u06CC RPF \u0628\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u062F\u0633\u062A\u0631\u0633\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F\u061B \u0627\u06CC\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0632 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC unicast \u06CC\u0627 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 RPF \u062A\u0623\u0645\u06CC\u0646 \u0634\u0648\u062F. \u067E\u06CC\u0627\u0645 Join/Prune \u06AF\u0627\u0645\u200C\u0628\u0647\u200C\u06AF\u0627\u0645 \u0628\u0647 \u0633\u0645\u062A RP \u06CC\u0627 \u0645\u0646\u0628\u0639 \u067E\u0631\u062F\u0627\u0632\u0634 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B Register \u0627\u0632 \u0631\u0648\u062A\u0631 \u0645\u0628\u062F\u0623 \u062A\u0627 RP \u0628\u0647\u200C\u0635\u0648\u0631\u062A unicast \u0627\u0631\u0633\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F. RP \u0631\u0627 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0627\u06CC\u0633\u062A\u0627 \u06CC\u0627 \u0628\u0627 \u0631\u0648\u0634\u200C\u0647\u0627\u06CC \u067E\u0648\u06CC\u0627\u06CC \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC\u200C\u0634\u062F\u0647 \u0645\u0639\u0631\u0641\u06CC \u06A9\u0631\u062F."}},{h:"\u062F\u0631\u062E\u062A\u200C\u0647\u0627",p:["\u062F\u0631\u062E\u062A \u0645\u0634\u062A\u0631\u06A9 (*,G) \u0631\u06CC\u0634\u0647\u200C\u0627\u0634 RP \u0627\u0633\u062A \u0648 \u0645\u0633\u06CC\u0631 \u0647\u0645\u0647 \u06AF\u0631\u0648\u0647\u200C\u0647\u0627 \u0631\u0627 \u0627\u0632 \u06CC\u06A9 \u0646\u0642\u0637\u0647 \u062C\u0645\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0645\u0632\u06CC\u062A: \u0633\u0627\u062F\u0647\u200C\u062A\u0631 \u0648 \u06A9\u0645\u200C\u0645\u0635\u0631\u0641\u200C\u062A\u0631\u061B \u0639\u06CC\u0628: \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0645\u0633\u06CC\u0631 \u063A\u06CC\u0631\u0628\u0647\u06CC\u0646\u0647 \u0628\u0627\u0634\u062F. \u0648\u0642\u062A\u06CC \u0646\u0631\u062E \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u0627\u0644\u0627 \u0631\u0641\u062A\u060C SPT switchover \u0628\u0627 (S,G) \u0645\u0633\u06CC\u0631 \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631\u06CC\u0646 \u0627\u0632 \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u062A\u0627 \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F.","\u0628\u0631\u0631\u0633\u06CC: show ip mroute (\u062F\u0631\u062E\u062A\u200C\u0647\u0627 \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647\u200C\u0647\u0627)\u060C show ip pim neighbor\u060C show ip igmp groups \u0648 show ip rpf (\u0622\u06CC\u0627 \u0645\u0633\u06CC\u0631 \u0628\u0627\u0632\u06AF\u0634\u062A \u0628\u0647 \u0641\u0631\u0633\u062A\u0646\u062F\u0647 \u062F\u0631\u0633\u062A \u0627\u0633\u062A). \u0627\u06AF\u0631 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u0628\u0633\u062A\u0647 \u062F\u0631 mroute \u0635\u0641\u0631 \u0627\u0633\u062A\u060C \u0645\u0634\u06A9\u0644 \u062F\u0631 RPF \u06CC\u0627 IGMP \u0627\u0633\u062A\u060C \u0646\u0647 \u062F\u0631 \u062E\u0648\u062F \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A."]},{h:"\u0686\u0627\u0644\u0634\u200C\u0647\u0627\u06CC \u0639\u0645\u0644\u06CC",p:["\u0627\u0648\u0644: RPF. \u0631\u0648\u062A\u0631 \u0641\u0642\u0637 \u0628\u0633\u062A\u0647\u200C\u0627\u06CC \u0631\u0627 \u0642\u0628\u0648\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0647 \u0627\u0632 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062F\u0631\u0633\u062A (\u0645\u0637\u0627\u0628\u0642 \u0645\u0633\u06CC\u0631 \u0628\u0627\u0632\u06AF\u0634\u062A \u0628\u0647 \u0645\u0646\u0628\u0639) \u0631\u0633\u06CC\u062F\u0647 \u0628\u0627\u0634\u062F. \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u062B\u0627\u0628\u062A \u0646\u0627\u0645\u062A\u0642\u0627\u0631\u0646 \u06CC\u0627 \u062A\u0648\u0646\u0644 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F RPF \u0631\u0627 \u0628\u0634\u06A9\u0646\u062F. \u062F\u0648\u0645: \u0644\u0627\u06CC\u0647 \u06F2. \u0686\u0648\u0646 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A \u06CC\u06A9 MAC \u0645\u0634\u062E\u0635 \u062F\u0627\u0631\u062F\u060C \u0633\u0648\u0626\u06CC\u0686 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0647\u0645\u0647 \u067E\u0648\u0631\u062A\u200C\u0647\u0627 \u0631\u0627 \u0633\u06CC\u0644 \u06A9\u0646\u062F\u06