u06CC\u06A9 \u0648 Null0]] \u0631\u0627 \u0628\u0628\u06CC\u0646."],"l2-discovery":["CDP \u067E\u0631\u0648\u062A\u06A9\u0644 \u06A9\u0634\u0641 \u0647\u0645\u0633\u0627\u06CC\u0647 \u0633\u06CC\u0633\u06A9\u0648 \u0648 LLDP \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0686\u0646\u062F\u0633\u0627\u0632\u0646\u062F\u0647 \u0627\u0633\u062A\u061B \u0622\u0646\u200C\u0647\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0647\u0648\u06CC\u062A\u060C \u067E\u0648\u0631\u062A \u0648 \u0642\u0627\u0628\u0644\u06CC\u062A \u0647\u0645\u0633\u0627\u06CC\u0647 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0631\u0627 \u062A\u0628\u0644\u06CC\u063A \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. VTP \u0628\u0631\u0627\u06CC \u062A\u0648\u0632\u06CC\u0639 \u0627\u0637\u0644\u0627\u0639\u0627\u062A VLAN \u062F\u0631 \u062F\u0627\u0645\u0646\u0647 \u0633\u06CC\u0633\u06A9\u0648 \u0627\u0633\u062A \u0648 \u0646\u0642\u0634\u0634 \u0628\u0627 \u06A9\u0634\u0641 \u0647\u0645\u0633\u0627\u06CC\u0647 \u0645\u062A\u0641\u0627\u0648\u062A \u0627\u0633\u062A. \u0646\u0633\u062E\u0647 \u0648 \u062D\u0627\u0644\u062A VTP \u0628\u0631 \u0631\u0641\u062A\u0627\u0631 \u0648 \u062F\u0627\u0645\u0646\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0627\u062B\u0631 \u062F\u0627\u0631\u062F.","\u0648\u0642\u062A\u06CC \u0646\u0642\u0634\u0647 \u06A9\u0627\u0628\u0644\u200C\u06A9\u0634\u06CC \u0646\u0627\u0645\u0634\u062E\u0635 \u0627\u0633\u062A\u060C show cdp neighbors detail \u06CC\u0627 show lldp neighbors detail \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u067E\u0648\u0631\u062A \u0647\u0645\u0633\u0627\u06CC\u0647 \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0645\u062F\u06CC\u0631\u06CC\u062A \u0631\u0627 \u0646\u0634\u0627\u0646 \u062F\u0647\u062F. \u0627\u06CC\u0646 \u0645\u0634\u0627\u0647\u062F\u0647 \u0628\u0627\u06CC\u062F \u0628\u0627 \u0645\u0633\u062A\u0646\u062F \u06A9\u0627\u0628\u0644 \u0648 \u0645\u0648\u062C\u0648\u062F\u06CC \u062A\u0637\u0628\u06CC\u0642 \u062F\u0627\u062F\u0647 \u0634\u0648\u062F\u061B \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u062F\u0631\u06CC\u0627\u0641\u062A\u06CC \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u0647\u0648\u06CC\u062A \u0642\u0627\u0628\u0644\u200C\u0627\u0639\u062A\u0645\u0627\u062F \u0627\u0645\u0646\u06CC\u062A\u06CC \u0646\u06CC\u0633\u062A. \u062F\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 VTP \u067E\u06CC\u0627\u0645\u062F revision \u0648 \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646\u06CC \u067E\u0627\u06CC\u06AF\u0627\u0647 VLAN \u0631\u0627 \u067E\u06CC\u0634\u0627\u067E\u06CC\u0634 \u062F\u0631 \u0645\u062D\u06CC\u0637 \u0622\u0632\u0645\u0627\u06CC\u0634 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646.","\u0627\u06AF\u0631 \u0647\u0645\u0633\u0627\u06CC\u0647 \u062F\u06CC\u062F\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0627\u062A\u0635\u0627\u0644 \u0641\u06CC\u0632\u06CC\u06A9\u06CC\u060C \u0641\u0639\u0627\u0644 \u0628\u0648\u062F\u0646 \u067E\u0631\u0648\u062A\u06A9\u0644 \u062F\u0631 \u062F\u0648 \u0637\u0631\u0641\u060C \u0631\u0627\u0628\u0637 \u0648 \u0641\u06CC\u0644\u062A\u0631 \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. \u0631\u0648\u06CC \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u063A\u06CC\u0631\u0645\u0648\u0631\u062F\u0646\u06CC\u0627\u0632 \u06CC\u0627 \u0628\u062F\u0648\u0646 \u0627\u0639\u062A\u0645\u0627\u062F \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u062A\u0628\u0644\u06CC\u063A \u06A9\u0634\u0641 \u0631\u0627 \u0637\u0628\u0642 \u0633\u06CC\u0627\u0633\u062A \u0627\u0645\u0646\u06CC\u062A\u06CC \u0645\u062D\u062F\u0648\u062F \u06A9\u0631\u062F. \u0628\u0631\u0627\u06CC \u0627\u0631\u062A\u0628\u0627\u0637 \u067E\u0648\u0631\u062A \u0648 VLAN \u0627\u0632 [[vlan-trunk|VLAN \u0648 trunk]] \u0648 \u0628\u0631\u0627\u06CC \u0645\u0631\u0632 \u0627\u0639\u062A\u0645\u0627\u062F \u0627\u0632 [[l2-security|\u0627\u0645\u0646\u06CC\u062A \u0644\u0627\u06CC\u0647 \u06F2]] \u06A9\u0645\u06A9 \u0628\u06AF\u06CC\u0631."],fhrp:["FHRP \u06CC\u0627 First Hop Redundancy Protocol \u06CC\u06A9 \u062F\u0631\u0648\u0627\u0632\u0647 \u0645\u062C\u0627\u0632\u06CC \u0628\u0631\u0627\u06CC \u0645\u06CC\u0632\u0628\u0627\u0646\u200C\u0647\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F \u062A\u0627 \u062E\u0631\u0627\u0628\u06CC \u0631\u0648\u062A\u0631 \u0641\u0639\u0627\u0644 \u0627\u0644\u0632\u0627\u0645\u0627\u064B \u0627\u062A\u0635\u0627\u0644 \u0647\u0645\u0647 \u0631\u0627 \u0642\u0637\u0639 \u0646\u06A9\u0646\u062F. HSRP\u060C VRRP \u0648 GLBP \u0646\u0642\u0634\u200C\u0647\u0627 \u0648 \u0631\u0641\u062A\u0627\u0631 \u0645\u062A\u0641\u0627\u0648\u062A\u06CC \u062F\u0627\u0631\u0646\u062F. IP \u0645\u062C\u0627\u0632\u06CC \u0648 MAC \u0645\u062C\u0627\u0632\u06CC \u0627\u0632 IP \u0648 MAC \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0631\u0627\u0628\u0637\u200C\u0647\u0627 \u0645\u062A\u0645\u0627\u06CC\u0632\u0646\u062F \u0648 \u0647\u0645\u0647 \u0627\u0639\u0636\u0627\u06CC \u06AF\u0631\u0648\u0647 \u0628\u0627\u06CC\u062F \u062F\u0631 \u06CC\u06A9 \u0637\u0631\u062D \u0633\u0627\u0632\u06AF\u0627\u0631 \u06A9\u0627\u0631 \u06A9\u0646\u0646\u062F.","\u062F\u0648 \u0631\u0648\u062A\u0631 \u0628\u0647 VLAN \u06A9\u0627\u0631\u0628\u0631 \u0645\u062A\u0635\u0644\u200C\u0627\u0646\u062F \u0648 DHCP\u060C \u0622\u062F\u0631\u0633 \u062F\u0631\u0648\u0627\u0632\u0647 \u0645\u062C\u0627\u0632\u06CC \u0631\u0627 \u0628\u0647 \u06A9\u0627\u0631\u0628\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F. \u0631\u0648\u062A\u0631 \u0641\u0639\u0627\u0644 \u0628\u0633\u062A\u0647\u200C\u0647\u0627 \u0631\u0627 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F\u061B \u062F\u0631 \u062E\u0631\u0627\u0628\u06CC\u060C \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0628\u0627 \u0645\u06A9\u0627\u0646\u06CC\u0632\u0645 \u0647\u0645\u0627\u0646 \u067E\u0631\u0648\u062A\u06A9\u0644 \u0646\u0642\u0634 \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. Tracking \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u06A9\u0627\u0647\u0634 \u0627\u0648\u0644\u0648\u06CC\u062A \u0631\u0627 \u0628\u0647 \u062E\u0631\u0627\u0628\u06CC uplink \u0648\u0627\u0628\u0633\u062A\u0647 \u06A9\u0646\u062F\u061B preempt \u0627\u062C\u0627\u0632\u0647 \u0628\u0627\u0632\u067E\u0633\u200C\u06AF\u06CC\u0631\u06CC \u0646\u0642\u0634 \u0631\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0648 \u067E\u0631\u0648\u062A\u06A9\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F.","show standby brief \u06CC\u0627 \u062F\u0633\u062A\u0648\u0631 \u0645\u0646\u0627\u0633\u0628 VRRP/GLBP\u060C \u0648\u0636\u0639\u06CC\u062A \u0646\u0642\u0634 \u0648 IP \u0645\u062C\u0627\u0632\u06CC \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F. \u0646\u0633\u062E\u0647\u060C \u0634\u0645\u0627\u0631\u0647 \u06AF\u0631\u0648\u0647\u060C \u0627\u0648\u0644\u0648\u06CC\u062A\u060C preempt \u0648 track \u0631\u0627 \u062F\u0631 \u062F\u0648 \u0637\u0631\u0641 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646 \u0648 \u0645\u0633\u06CC\u0631 \u0628\u0627\u0644\u0627\u062F\u0633\u062A\u06CC \u0648 \u0628\u0627\u0632\u06AF\u0634\u062A \u0631\u0627 \u0646\u06CC\u0632 \u0622\u0632\u0645\u0627\u06CC\u0634 \u06A9\u0646. \u0648\u062C\u0648\u062F \u062F\u0648 \u062F\u0631\u0648\u0627\u0632\u0647 \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u062E\u0631\u0627\u0628\u06CC \u0633\u0648\u0626\u06CC\u0686 \u06CC\u0627 \u0637\u0631\u0627\u062D\u06CC \u0644\u0627\u06CC\u0647 \u06F2 \u0631\u0627 \u062D\u0630\u0641 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F\u061B [[stp-rstp|STP]] \u0648 [[inter-vlan|SVI]] \u0631\u0627 \u0645\u0631\u0648\u0631 \u06A9\u0646."],qos:["QoS \u06CC\u0627 Quality of Service \u0645\u0646\u0627\u0628\u0639 \u0645\u062D\u062F\u0648\u062F \u0631\u0627 \u0628\u0631\u0627\u06CC \u06A9\u0644\u0627\u0633\u200C\u0647\u0627\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F \u062C\u062F\u06CC\u062F \u0646\u0645\u06CC\u200C\u0633\u0627\u0632\u062F. \u0637\u0628\u0642\u0647\u200C\u0628\u0646\u062F\u06CC\u060C marking\u060C \u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u0648 \u06A9\u0646\u062A\u0631\u0644 \u0646\u0631\u062E \u06A9\u0627\u0631\u06A9\u0631\u062F\u0647\u0627\u06CC \u062C\u062F\u0627 \u0647\u0633\u062A\u0646\u062F. DSCP \u0634\u0634 \u0628\u06CC\u062A \u062F\u0631 \u0647\u062F\u0631 IP \u0648 CoS \u0633\u0647 \u0628\u06CC\u062A \u0627\u0648\u0644\u0648\u06CC\u062A \u062F\u0631 \u062A\u06AF 802.1Q \u0627\u0633\u062A\u061B \u0627\u0639\u062A\u0645\u0627\u062F \u0628\u0647 marking \u0628\u0627\u06CC\u062F \u062F\u0631 \u0645\u0631\u0632 \u0634\u0628\u06A9\u0647 \u0628\u0627 \u0633\u06CC\u0627\u0633\u062A \u0645\u0634\u062E\u0635 \u0634\u0648\u062F.","\u062F\u0631 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u0634\u0644\u0648\u063A\u060C \u0628\u0633\u062A\u0647 \u0635\u0648\u062A\u06CC \u0628\u0647 \u062A\u0623\u062E\u06CC\u0631 \u0648 jitter \u062D\u0633\u0627\u0633 \u0627\u0633\u062A \u0648 \u0627\u0646\u062A\u0642\u0627\u0644 \u0641\u0627\u06CC\u0644 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0646\u0633\u0628\u062A \u0628\u0647 \u062A\u0623\u062E\u06CC\u0631 \u062A\u062D\u0645\u0644 \u0628\u06CC\u0634\u062A\u0631\u06CC \u062F\u0627\u0631\u062F. class-map \u062C\u0631\u06CC\u0627\u0646 \u0631\u0627 \u062A\u0634\u062E\u06CC\u0635 \u0645\u06CC\u200C\u062F\u0647\u062F\u060C policy-map \u0631\u0641\u062A\u0627\u0631 \u0631\u0627 \u062A\u0639\u0631\u06CC\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 service-policy \u0622\u0646 \u0631\u0627 \u062F\u0631 \u062C\u0647\u062A \u0645\u0634\u062E\u0635 \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0635\u0641 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u062F\u0648\u0646 \u0633\u0642\u0641 \u0645\u0646\u0627\u0633\u0628 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u06A9\u0644\u0627\u0633\u200C\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0631\u0627 \u06AF\u0631\u0633\u0646\u0647 \u06A9\u0646\u062F\u061B \u0638\u0631\u0641\u06CC\u062A \u0648 overhead \u0631\u0627 \u062D\u0633\u0627\u0628 \u06A9\u0646.","\u0642\u0628\u0644 \u0648 \u0628\u0639\u062F \u0627\u0632 \u0627\u0639\u0645\u0627\u0644 \u0633\u06CC\u0627\u0633\u062A \u0646\u0631\u062E\u060C drops\u060C \u062A\u0623\u062E\u06CC\u0631 \u0648 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u06A9\u0644\u0627\u0633\u200C\u0647\u0627 \u0631\u0627 \u0627\u0646\u062F\u0627\u0632\u0647 \u0628\u06AF\u06CC\u0631. show policy-map interface \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u062F\u0627\u0645 \u06A9\u0644\u0627\u0633 \u062A\u0637\u0628\u06CC\u0642 \u062E\u0648\u0631\u062F\u0647 \u0648 \u0686\u0647 \u062A\u0639\u062F\u0627\u062F \u0628\u0633\u062A\u0647 \u062F\u0648\u0631 \u0631\u06CC\u062E\u062A\u0647 \u0634\u062F\u0647 \u0627\u0633\u062A. Policing \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0627\u0636\u0627\u0641\u0647 \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0633\u06CC\u0627\u0633\u062A \u0631\u062F \u06CC\u0627 \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B shaping \u0628\u0627 \u0635\u0641 \u0648 \u062A\u0623\u062E\u06CC\u0631 \u0646\u0631\u062E \u062E\u0631\u0648\u062C \u0631\u0627 \u0647\u0645\u0648\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. [[qos-advanced|QoS \u067E\u06CC\u0634\u0631\u0641\u062A\u0647]] \u0631\u0627 \u0628\u0628\u06CC\u0646."],mpls:["MPLS \u0628\u0627 label \u06CC\u0627 \u0628\u0631\u0686\u0633\u0628 \u06A9\u0648\u062A\u0627\u0647 \u0648 \u062C\u062F\u0648\u0644 \u0627\u0631\u0633\u0627\u0644 \u0628\u0631\u0686\u0633\u0628\u060C \u0628\u0633\u062A\u0647 \u0631\u0627 \u062F\u0631 \u0647\u0633\u062A\u0647 \u0647\u062F\u0627\u06CC\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F. VRF \u06CC\u0627 Virtual Routing and Forwarding \u062C\u062F\u0648\u0644\u200C\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0634\u062A\u0631\u06CC\u200C\u0647\u0627 \u0631\u0627 \u062C\u062F\u0627 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F\u061B \u062C\u062F\u0627\u0633\u0627\u0632\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0644\u0632\u0648\u0645\u0627\u064B \u0628\u0647 \u0645\u0639\u0646\u06CC \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0646\u06CC\u0633\u062A. PE \u062F\u0631 \u0645\u0631\u0632 \u0627\u0631\u0627\u0626\u0647\u200C\u062F\u0647\u0646\u062F\u0647 \u0648 P \u062F\u0631 \u0647\u0633\u062A\u0647 \u0642\u0631\u0627\u0631 \u062F\u0627\u0631\u062F.","\u062F\u0631 L3VPN \u0645\u0639\u0645\u0648\u0644\u060C PE \u0648\u0631\u0648\u062F\u06CC \u0627\u0628\u062A\u062F\u0627 \u0628\u0633\u062A\u0647 \u0631\u0627 \u062F\u0631 VRF \u0645\u0634\u062A\u0631\u06CC \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0633\u067E\u0633 \u0628\u0631\u0686\u0633\u0628 \u0633\u0631\u0648\u06CC\u0633 \u0648 \u0628\u0631\u0686\u0633\u0628 \u0627\u0646\u062A\u0642\u0627\u0644 \u0645\u0646\u0627\u0633\u0628 \u0631\u0627 \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F. \u0647\u0633\u062A\u0647 \u0628\u0627 \u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC \u0628\u0647 \u0633\u0645\u062A PE \u062E\u0631\u0648\u062C\u06CC \u0645\u06CC\u200C\u0631\u0648\u062F\u061B \u0628\u0631\u0686\u0633\u0628 \u062F\u0627\u062E\u0644\u06CC \u0628\u0647 PE \u062E\u0631\u0648\u062C\u06CC \u062F\u0631 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u0633\u0631\u0648\u06CC\u0633 \u06A9\u0645\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F. RD \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627\u06CC \u0647\u0645\u0633\u0627\u0646 \u0645\u0634\u062A\u0631\u06CC\u0627\u0646 \u0631\u0627 \u06CC\u06A9\u062A\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 RT \u0633\u06CC\u0627\u0633\u062A import/export \u0645\u0633\u06CC\u0631 \u0627\u0633\u062A.","\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0631\u0627 \u0627\u0632 \u0644\u0627\u06CC\u0647 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0634\u0631\u0648\u0639 \u06A9\u0646: reachability \u0648 LDP \u06CC\u0627 \u0633\u0627\u0632\u0648\u06A9\u0627\u0631 \u0627\u0646\u062A\u0642\u0627\u0644 \u0628\u0631\u0686\u0633\u0628\u060C \u0633\u067E\u0633 \u0646\u0634\u0633\u062A MP-BGP \u0648 \u062F\u0631 \u0622\u062E\u0631 RT\u060C route \u0648 \u0631\u0627\u0628\u0637 VRF. \u0646\u0628\u0648\u062F \u0645\u0633\u06CC\u0631 \u062F\u0631 VRF \u0639\u0644\u0644 \u0645\u062A\u0639\u062F\u062F \u062F\u0627\u0631\u062F \u0648 \u0641\u0642\u0637 RT \u0646\u06CC\u0633\u062A. \u0628\u0631\u0627\u06CC \u062C\u0632\u0626\u06CC\u0627\u062A \u0647\u0633\u062A\u0647 \u0628\u0647 [[sp-mpls-vpn|MPLS L3VPN \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u06CC]] \u0648 \u0628\u0631\u0627\u06CC \u0631\u0648\u0634 \u062F\u06CC\u06AF\u0631 \u0627\u0646\u062A\u0642\u0627\u0644 \u0628\u0647 [[sp-sr|Segment Routing]] \u0628\u0631\u0648."],dmvpn:["GRE \u06CC\u06A9 \u06A9\u067E\u0633\u0648\u0644\u0647\u200C\u0633\u0627\u0632\u06CC \u062A\u0648\u0646\u0644\u06CC \u0627\u0633\u062A \u0648 \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC \u0641\u0631\u0627\u0647\u0645 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F. DMVPN \u0627\u0632 mGRE \u0628\u0631\u0627\u06CC \u0686\u0646\u062F \u0645\u0642\u0635\u062F \u062A\u0648\u0646\u0644\u06CC \u0648 NHRP \u0628\u0631\u0627\u06CC \u0646\u06AF\u0627\u0634\u062A \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644\u06CC \u0628\u0647 \u0622\u062F\u0631\u0633 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A NBMA \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B IPsec \u062F\u0631 \u0637\u0631\u062D\u200C\u0647\u0627\u06CC \u0631\u0627\u06CC\u062C \u0627\u0645\u0646\u06CC\u062A \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062A\u0648\u0646\u0644 \u0631\u0627 \u0641\u0631\u0627\u0647\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0646\u0642\u0634 hub \u0648 spoke \u0648 \u0631\u0641\u062A\u0627\u0631 shortcut \u0628\u0647 \u0641\u0627\u0632 \u0648 \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0628\u0633\u062A\u06AF\u06CC \u062F\u0627\u0631\u062F.","\u0627\u0628\u062A\u062F\u0627 spoke \u0622\u062F\u0631\u0633 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A hub \u0631\u0627 \u0645\u06CC\u200C\u0634\u0646\u0627\u0633\u062F \u0648 \u062F\u0631 NHRP \u062B\u0628\u062A \u0645\u06CC\u200C\u0634\u0648\u062F. \u0628\u0633\u062A\u0647 \u0628\u0647 \u0641\u0627\u0632 \u0648 \u0634\u0631\u0627\u06CC\u0637\u060C \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0628\u062A\u062F\u0627 \u0627\u0632 hub \u0639\u0628\u0648\u0631 \u06A9\u0646\u062F \u0648 \u067E\u0633 \u0627\u0632 \u0622\u0645\u0648\u062E\u062A\u0646 \u0646\u06AF\u0627\u0634\u062A\u060C \u0645\u0633\u06CC\u0631 spoke-to-spoke \u0628\u0631\u0642\u0631\u0627\u0631 \u0634\u0648\u062F. \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u062F\u0627\u062E\u0644 \u062A\u0648\u0646\u0644 \u0648 \u062F\u0633\u062A\u0631\u0633\u06CC IP \u0628\u06CC\u0631\u0648\u0646\u06CC \u0647\u0631 \u062F\u0648 \u0644\u0627\u0632\u0645\u200C\u0627\u0646\u062F\u061B \u062A\u0634\u06A9\u06CC\u0644 tunnel \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u0635\u062D\u062A end-to-end \u0631\u0627 \u062B\u0627\u0628\u062A \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0627\u0628\u062A\u062F\u0627 \u062F\u0633\u062A\u0631\u0633\u06CC \u062A\u062D\u062A\u0627\u0646\u06CC\u060C \u0622\u062F\u0631\u0633 \u0645\u0628\u062F\u0623 \u062A\u0648\u0646\u0644\u060C NHRP registration \u0648 \u0633\u067E\u0633 \u0648\u0636\u0639\u06CC\u062A \u0645\u0633\u06CC\u0631\u0647\u0627 \u0648 IPsec SA \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646. show dmvpn\u060C show ip nhrp \u0648 show crypto ipsec sa \u062F\u0631 \u0646\u0633\u062E\u0647\u200C\u0647\u0627\u06CC \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0645\u0641\u06CC\u062F\u0646\u062F. NAT\u060C MTU/MSS \u0648 \u0633\u06CC\u0627\u0633\u062A \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0645\u0627\u0646\u0639 \u0628\u0627\u0634\u0646\u062F\u061B \u0645\u0641\u0627\u0647\u06CC\u0645 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0631\u0627 \u062F\u0631 [[ipsec|IPsec]] \u0645\u0631\u0648\u0631 \u06A9\u0646."],ipsec:["IPsec \u062E\u0627\u0646\u0648\u0627\u062F\u0647\u200C\u0627\u06CC \u0627\u0632 \u0633\u0627\u0632\u0648\u06A9\u0627\u0631\u0647\u0627\u06CC \u0645\u062D\u0627\u0641\u0638\u062A IP \u0627\u0633\u062A. ESP \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC\u060C \u062A\u0645\u0627\u0645\u06CC\u062A \u0648 \u0627\u062D\u0631\u0627\u0632 \u0627\u0635\u0627\u0644\u062A \u0631\u0627 \u0628\u0633\u062A\u0647 \u0628\u0647 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645 \u0648 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0641\u0631\u0627\u0647\u0645 \u06A9\u0646\u062F\u061B AH \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC \u0646\u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u0628\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u0622\u062F\u0631\u0633 \u062A\u0648\u0633\u0637 NAT \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0633\u0627\u0632\u06AF\u0627\u0631 \u0646\u06CC\u0633\u062A. IKEv2 \u0628\u0631\u0627\u06CC \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0637\u0631\u0641\u06CC\u0646 \u0648 \u0645\u0630\u0627\u06A9\u0631\u0647 \u06A9\u0644\u06CC\u062F\u0647\u0627 \u0648 SA\u0647\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062F\u0631 \u0634\u0631\u0648\u0639\u060C \u0637\u0631\u0641\u06CC\u0646 \u0627\u0628\u062A\u062F\u0627 IKE SA \u0631\u0627 \u0628\u0631\u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u0648 \u0633\u067E\u0633 CHILD SA \u0628\u0631\u0627\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u062D\u0627\u0641\u0638\u062A\u200C\u0634\u062F\u0647 \u0645\u06CC\u200C\u0633\u0627\u0632\u06