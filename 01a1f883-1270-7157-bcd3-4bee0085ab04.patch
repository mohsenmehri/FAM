u062F\u0644 \u062F\u0627\u062F\u0647 YANG \u0648 \u0646\u0642\u0634 \u0622\u0646 \u0631\u0627 \u062F\u0631 \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC","\u062A\u0641\u0627\u0648\u062A NETCONF \u0648 RESTCONF \u0631\u0627 \u062F\u0631 \u067E\u0631\u0648\u062A\u06A9\u0644 \u062D\u0645\u0644 \u0648 \u0639\u0645\u0644\u06CC\u0627\u062A \u0628\u06AF\u0648\u06CC\u06CC","\u06CC\u06A9 \u062F\u0631\u062E\u0648\u0627\u0633\u062A get-config \u0648 edit-config \u0631\u0627 \u0628\u062E\u0648\u0627\u0646\u06CC \u0648 \u062A\u0641\u0633\u06CC\u0631 \u06A9\u0646\u06CC"],sections:[{h:"\u0627\u0632 CLI \u0628\u0647 \u0645\u062F\u0644",p:["\u062F\u0631 CLI\u060C \u062F\u0633\u062A\u0648\u0631 \u06CC\u06A9 \u0645\u062A\u0646 \u0627\u0633\u062A \u0648 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0622\u0646 \u0631\u0627 \u062A\u062D\u0644\u06CC\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u06AF\u0631 \u0628\u062E\u0634\u06CC \u0627\u0632 \u062F\u0633\u062A\u0648\u0631 \u0627\u0634\u062A\u0628\u0627\u0647 \u0628\u0627\u0634\u062F\u060C \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0628\u062E\u0634\u06CC \u0627\u0639\u0645\u0627\u0644 \u0648 \u0628\u062E\u0634\u06CC \u0631\u062F \u0634\u0648\u062F. \u062F\u0631 \u0645\u062F\u0644\u200C\u0645\u062D\u0648\u0631\u060C \u062F\u0633\u062A\u06AF\u0627\u0647 \u06CC\u06A9 \u062F\u0631\u062E\u062A \u062F\u0627\u062F\u0647 YANG \u062F\u0627\u0631\u062F: \u0647\u0631 \u06AF\u0631\u0647 \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u0645\u0634\u062E\u0635\u060C \u0646\u0648\u0639 \u0645\u0634\u062E\u0635 \u0648 \u0645\u062D\u062F\u0648\u062F\u06CC\u062A \u0645\u0634\u062E\u0635 \u062F\u0627\u0631\u062F. \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u06CC\u0639\u0646\u06CC \u0627\u0631\u0633\u0627\u0644 \u06CC\u06A9 \u0633\u0646\u062F XML/JSON \u06A9\u0647 \u0628\u062E\u0634\u06CC \u0627\u0632 \u0627\u06CC\u0646 \u062F\u0631\u062E\u062A \u0631\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F. \u0627\u0639\u062A\u0628\u0627\u0631\u0633\u0646\u062C\u06CC \u0642\u0628\u0644 \u0627\u0632 \u0627\u0639\u0645\u0627\u0644 \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u067E\u0633 \u062A\u063A\u06CC\u06CC\u0631 \u0646\u06CC\u0645\u0647\u200C\u06A9\u0627\u0631\u0647 \u0646\u062F\u0627\u0631\u06CC\u0645.","YANG \u0632\u0628\u0627\u0646 \u0645\u062F\u0644\u200C\u0633\u0627\u0632\u06CC \u0627\u0633\u062A\u060C \u0646\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644. NETCONF \u067E\u0631\u0648\u062A\u06A9\u0644 \u062D\u0645\u0644 \u0628\u0631 \u0628\u0633\u062A\u0631 SSH (\u067E\u0648\u0631\u062A \u06F8\u06F3\u06F0) \u0627\u0633\u062A \u0648 \u0627\u0632 XML \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F. RESTCONF \u0647\u0645\u0627\u0646 \u0645\u062F\u0644 \u0631\u0627 \u0631\u0648\u06CC HTTPS \u0628\u0627 JSON/XML \u0646\u0645\u0627\u06CC\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F."],list:["NETCONF: SSH 830 \xB7 XML \xB7 RPC","RESTCONF: HTTPS 443 \xB7 JSON/XML \xB7 GET/POST/PATCH/PUT/DELETE","gNMI: gRPC \xB7 \u062A\u0644\u0647\u200C\u0645\u062A\u0631\u06CC \u0627\u0633\u062A\u0631\u06CC\u0645","YANG: schema \u0648 \u0627\u0639\u062A\u0628\u0627\u0631\u0633\u0646\u062C\u06CC"]},{h:"\u0645\u062F\u0644 \u062F\u0627\u062F\u0647 \u0648 datastore",p:["NETCONF \u0633\u0647 \u0645\u062E\u0632\u0646 \u062F\u0627\u0631\u062F: running\u060C candidate \u0648 startup. \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0648\u06CC candidate \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u0627 commit \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06AF\u0631\u062F\u062F\u061B \u0627\u06CC\u0646 \u06CC\u0639\u0646\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC \u0686\u0646\u062F \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0627 \u06CC\u06A9\u200C\u062C\u0627 \u0648 \u0627\u062A\u0645\u06CC\u06A9 \u0627\u0639\u0645\u0627\u0644 \u06A9\u0646\u06CC. \u0627\u06AF\u0631 \u0627\u0634\