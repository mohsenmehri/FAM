62F\u0631 \u06AF\u0631\u0647 \u0645\u0627\u0642\u0628\u0644 \u0622\u062E\u0631 \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F."],glossary:[["VRF","\u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631 \u0645\u0633\u062A\u0642\u0644 \u0628\u0631\u0627\u06CC \u0647\u0631 \u0645\u0634\u062A\u0631\u06CC."],["RD","\u0634\u0646\u0627\u0633\u0647 \u06F8 \u0628\u0627\u06CC\u062A\u06CC \u06CC\u06A9\u062A\u0627\u0633\u0627\u0632 \u067E\u06CC\u0634\u0648\u0646\u062F."],["RT","Community \u06A9\u0646\u062A\u0631\u0644 \u0648\u0631\u0648\u062F \u0648 \u062E\u0631\u0648\u062C \u0645\u0633\u06CC\u0631 \u0628\u0647 VRF."],["PHP","\u062D\u0630\u0641 \u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC \u062F\u0631 \u0622\u062E\u0631\u06CC\u0646 \u0631\u0648\u062A\u0631 \u0647\u0633\u062A\u0647."]]},"sp-sr":{prereq:["mpls"],related:["sp-isis","sp-mpls-vpn"],title:"Segment Routing \u2014 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u062F\u0631 \u062E\u0648\u062F \u0628\u0633\u062A\u0647 \u0628\u0646\u0648\u06CC\u0633",tagline:"\u062F\u0631 Segment Routing\u060C \u0645\u0628\u062F\u0623 \u06CC\u0627 \u06AF\u0631\u0647 \u0648\u0631\u0648\u062F\u06CC \u0641\u0647\u0631\u0633\u062A segment\u0647\u0627 \u0631\u0627 \u062F\u0631 \u0628\u0633\u062A\u0647 \u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F\u061B \u06AF\u0631\u0647\u200C\u0647\u0627\u06CC \u0634\u0628\u06A9\u0647 \u0647\u0645\u0686\u0646\u0627\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0645\u0633\u06CC\u0631 \u0648 forwarding \u0631\u0627 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u0646\u062F.",minutes:16,goals:["\u062A\u0641\u0627\u0648\u062A SR \u0628\u0627 LDP \u0631\u0627 \u062F\u0631 \u06CC\u06A9 \u062C\u0645\u0644\u0647 \u0628\u06AF\u0648\u06CC\u06CC","Prefix-SID \u0648 Adjacency-SID \u0631\u0627 \u0628\u0627 SRGB \u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC","\u0628\u062F\u0627\u0646\u06CC TI-LFA \u0686\u0637\u0648\u0631 \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC \u0631\u0627 \u0628\u0647 \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647 \u0645\u06CC\u200C\u0631\u0633\u0627\u0646\u062F"],sections:[{h:"\u0627\u06CC\u062F\u0647 \u0627\u0635\u0644\u06CC",p:["\u062F\u0631 MPLS \u0628\u0627 LDP\u060C \u0647\u0645\u0633\u0627\u06CC\u0647\u200C\u0647\u0627 \u0646\u06AF\u0627\u0634\u062A \u0628\u0631\u0686\u0633\u0628 \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627 \u0631\u0627 \u062A\u0648\u0632\u06CC\u0639 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. \u062F\u0631 SR-MPLS\u060C Prefix-SID \u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0645\u0631\u062A\u0628\u0637 \u0627\u0632 \u0637\u0631\u06CC\u0642 IGP \u0645\u0646\u062A\u0634\u0631 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u0628\u0633\u062A\u0647 \u0628\u0647 SRGB \u0647\u0631 \u0631\u0648\u062A\u0631\u060C label \u0645\u062D\u0644\u06CC \u0645\u0646\u0627\u0633\u0628 \u0645\u062D\u0627\u0633\u0628\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u06CC\u06A9\u0633\u0627\u0646 \u0628\u0648\u062F\u0646 \u0639\u062F\u062F label \u0631\u0648\u06CC \u0647\u0645\u0647 \u0631\u0648\u062A\u0631\u0647\u0627 \u0627\u0644\u0632\u0627\u0645\u06CC \u0646\u06CC\u0633\u062A. SR \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0628\u0631\u0627\u06CC \u0627\u0646\u062A\u0642\u0627\u0644 \u0628\u0631\u0686\u0633\u0628 \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646 LDP \u0634\u0648\u062F\u060C \u0627\u0645\u0627 \u062F\u0631 \u0645\u0647\u0627\u062C\u0631\u062A \u0647\u0631 \u062F\u0648 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0648\u062C\u0648\u062F \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F.","\u0642\u0637\u0639\u0647 (Segment) \u06CC\u06A9 \u062F\u0633\u062A\u0648\u0631\u0627\u0644\u0639\u0645\u0644 \u0627\u0633\u062A: \xAB\u0628\u0647 \u0627\u06CC\u0646 \u0631\u0648\u062A\u0631 \u0628\u0631\u0648\xBB \u06CC\u0627 \xAB\u0627\u0632 \u0627\u06CC\u0646 \u0644\u06CC\u0646\u06A9 \u0628\u0631\u0648\xBB. \u062F\u0631 SR-MPLS \u0641\u0647\u0631\u0633\u062A segment\u0647\u0627 \u0628\u0647 \u067E\u0634\u062A\u0647 label \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u06AF\u0631\u0647\u200C\u0647\u0627\u06CC \u0645\u06CC\u0627\u0646\u06CC \u0645\u0637\u0627\u0628\u0642 label \u0628\u0627\u0644\u0627\u06CC \u067E\u0634\u062A\u0647 \u0639\u0645\u0644 swap \u06CC\u0627 forward \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u062F\u0647\u0646\u062F \u0648 \u062D\u0630\u0641 segment \u0647\u0646\u06AF\u0627\u0645 \u0631\u0633\u06CC\u062F\u0646 \u0628\u0647 \u0627\u0646\u062A\u0647\u0627\u06CC \u0645\u0631\u0628\u0648\u0637 \u06CC\u0627 \u0637\u0628\u0642 \u0642\u0648\u0627\u0639\u062F PHP \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0646\u0647 \u062F\u0631 \u0647\u0645\u0647 \u0631\u0648\u062A\u0631\u0647\u0627. \u0645\u062B\u0644 \u0627\u062C\u0631\u0627\u06CC \u06CC\u06A9 \u0627\u0633\u06A9\u0631\u06CC\u067E\u062A \u06A9\u0648\u0686\u06A9 \u0631\u0648\u06CC \u0628\u0633\u062A\u0647."]},{h:"SRGB \u0648 \u062F\u0648 \u0646\u0648\u0639 SID",p:["SRGB \u06CC\u0627 \u0628\u0644\u0648\u06A9 \u0628\u0631\u0686\u0633\u0628 Segment Routing\u060C \u0628\u0627\u0632\u0647\u200C\u0627\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0631\u0648\u062A\u0631 \u0628\u0631\u0686\u0633\u0628\u200C\u0647\u0627\u06CC SR \u0631\u0627 \u0627\u0632 \u0622\u0646 \u0628\u0631\u0645\u06CC\u200C\u062F\u0627\u0631\u062F\u061B \u0628\u0627\u0632\u0647 16000 \u062A\u0627 23999 \u062F\u0631 \u0628\u0631\u062E\u06CC \u067E\u06CC\u0627\u062F\u0647\u200C\u0633\u0627\u0632\u06CC\u200C\u0647\u0627\u06CC \u0633\u06CC\u0633\u06A9\u0648 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0627\u0633\u062A\u060C \u0627\u0645\u0627 \u0645\u0642\u062F\u0627\u0631 \u0639\u0645\u0648\u0645\u06CC \u0648 \u062B\u0627\u0628\u062A \u0647\u0645\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627 \u0646\u06CC\u0633\u062A. Prefix-SID \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u06CC\u06A9 \u067E\u06CC\u0634\u0648\u0646\u062F \u0627\u0633\u062A: \u0628\u0631\u0627\u06CC Prefix-SID \u0628\u0647 \u0635\u0648\u0631\u062A index\u060C label \u0627\u0632 index \u0648 \u067E\u0627\u06CC\u0647 SRGB \u0645\u062D\u0644\u06CC \u0645\u062D\u0627\u0633\u0628\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0631\u0648\u062A\u0631 \u062A\u0628\u0644\u06CC\u063A\u200C\u06A9\u0646\u0646\u062F\u0647 SID \u0631\u0627 \u0628\u0631\u0627\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F \u0645\u0631\u0628\u0648\u0637 \u0627\u0639\u0644\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u06AF\u0631 \u0647\u0645\u0647 \u0631\u0648\u062A\u0631\u0647\u0627 SRGB \u06CC\u06A9\u0633\u0627\u0646 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F\u060C Index \u0631\u0648\u06CC \u0647\u0645\u0647 \u06CC\u06A9 \u0645\u0639\u0646\u0627 \u062F\u0627\u0631\u062F \u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0633\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. Adjacency-SID \u0645\u062E\u0635\u0648\u0635 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u0645\u0634\u062E\u0635 \u0627\u0633\u062A \u0648 \u0628\u0631\u0627\u06CC \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC \u062F\u0642\u06CC\u0642 (Traffic Engineering) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0686\u0648\u0646 \u0628\u0647 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u06AF\u0631\u0647 \u062E\u0648\u0631\u062F\u0647\u060C \u0628\u0627 \u0642\u0637\u0639 \u0622\u0646 \u0644\u06CC\u0646\u06A9 \u0628\u0631\u0686\u0633\u0628\u0634 \u0647\u0645 \u0628\u0631\u062F\u0627\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u062A\u0648\u0632\u06CC\u0639 \u0627\u06CC\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0628\u0627 \u0647\u0645\u0627\u0646 IGP (IS-IS \u06CC\u0627 OSPF) \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0686\u0648\u0646 IGP \u0627\u0632 \u0642\u0628\u0644 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u062A\u0648\u067E\u0648\u0644\u0648\u0698\u06CC \u0631\u0627 \u067E\u062E\u0634 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u06CC\u0639\u0646\u06CC SR \u0631\u0648\u06CC IGP \u0633\u0648\u0627\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0646\u0647 \u0631\u0648\u06CC \u06CC\u06A9 \u067E\u0631\u0648\u062A\u06A9\u0644 \u062C\u062F\u06CC\u062F."],list:["SRGB \u0646\u0645\u0648\u0646\u0647 \u062F\u0631 \u0628\u0631\u062E\u06CC \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627: 16000\u201323999\u061B \u062A\u0646\u0638\u06CC\u0645 \u0648\u0627\u0642\u0639\u06CC \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646","Prefix-SID = Index + SRGB (\u0645\u062B\u0644\u0627\u064B Index 10 \u2192 16010)","Adjacency-SID: \u0645\u062E\u0635\u0648\u0635 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 \u0645\u0634\u062E\u0635","SR-Policy: \u0645\u0633\u06CC\u0631 \u0628\u0627 Segment List \u0648 PCE"]},{h:"TI-LFA: \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u062F\u0631 \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647",p:["\u0645\u0633\u0626\u0644\u0647 \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC IGP \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0628\u0639\u062F \u0627\u0632 \u0642\u0637\u0639 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9\u060C \u0647\u0645\u0647 \u0631\u0648\u062A\u0631\u0647\u0627 \u0628\u0627\u06CC\u062F \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0631\u0627 \u067E\u062E\u0634 \u0648 \u062F\u0648\u0628\u0627\u0631\u0647 \u0645\u062D\u0627\u0633\u0628\u0647 \u06A9\u0646\u0646\u062F\u061B \u0627\u06CC\u0646 \u0686\u0646\u062F \u0635\u062F \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647 \u062A\u0627 \u0686\u0646\u062F \u062B\u0627\u0646\u06CC\u0647 \u0637\u0648\u0644 \u0645\u06CC\u200C\u06A9\u0634\u062F \u0648 \u0628\u0631\u0627\u06CC VoIP \u06CC\u0627 \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627\u06CC \u062D\u0633\u0627\u0633 \u0632\u06CC\u0627\u062F \u0627\u0633\u062A. TI-LFA \u0628\u0627 \u0645\u062D\u0627\u0633\u0628\u0647 \u0627\u0632 \u0642\u0628\u0644 \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u0650 \u0628\u062F\u0648\u0646 \u062D\u0644\u0642\u0647 \u0622\u0645\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0628\u0627 P-Space \u0648 Q-Space) \u0648 \u0628\u0647\u200C\u0635\u0648\u0631\u062A \u0645\u062D\u0644\u06CC \u0631\u0648\u06CC \u0647\u0645\u0627\u0646 \u0631\u0648\u062A\u0631 \u0646\u0635\u0628 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0648\u0642\u062A\u06CC \u0644\u06CC\u0646\u06A9 \u0642\u0637\u0639 \u0634\u062F\u060C \u0631\u0648\u062A\u0631 \u0628\u0644\u0627\u0641\u0627\u0635\u0644\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0631\u0648\u06CC \u0645\u0633\u06CC\u0631 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0628\u0627 Segment List \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F\u060C \u0628\u062F\u0648\u0646 \u0627\u0646\u062A\u0638\u0627\u0631 \u0628\u0631\u0627\u06CC \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC \u06A9\u0644 \u0634\u0628\u06A9\u0647. \u0628\u0639\u062F \u0627\u0632 \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC\u060C \u0645\u0633\u06CC\u0631 \u0639\u0627\u062F\u06CC \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F. \u0627\u06CC\u0646 \u06CC\u06A9\u06CC \u0627\u0632 \u0628\u0632\u0631\u06AF\u200C\u062A\u0631\u06CC\u0646 \u062F\u0644\u0627\u06CC\u0644 \u0645\u062D\u0628\u0648\u0628\u06CC\u062A SR \u062F\u0631 \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u0647\u0627\u0633\u062A."],callout:{title:"\u0646\u06A9\u062A\u0647 \u0622\u0632\u0645\u0648\u0646\u06CC",text:"TI-LFA \u0645\u0633\u06CC\u0631 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0631\u0627 \xAB\u0627\u0632 \u0642\u0628\u0644\xBB \u0645\u062D\u0627\u0633\u0628\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0628\u062F\u0648\u0646 \u062D\u0644\u0642\u0647 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F\u061B SR-Policy \u0628\u0631 \u0627\u0633\u0627\u0633 SLA \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0627\u0646\