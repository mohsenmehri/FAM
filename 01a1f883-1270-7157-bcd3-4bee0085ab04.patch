+      .replaceAll('__FAM_CSP_NONCE__', nonce)
+      .replace('__FAM_ACADEMY_BOOTSTRAP__', boot);
+    res.writeHead(200, {
+      'Content-Type': 'text/html; charset=utf-8',
+      'Content-Security-Policy': `script-src 'self' 'nonce-${nonce}'`
+    });
+    res.end(html);
+    return;
+  }
+
+  if (url.pathname.startsWith('/academy-assets/')) {
