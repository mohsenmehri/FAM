+class AcademyMarkdownTableTests(unittest.TestCase):
+    docs = Path(__file__).resolve().parents[3] / 'docs'
+
+    @staticmethod
+    def _cells(line):
+        line = line.strip()
+        if line.startswith('|'):
+            line = line[1:]
+        if line.endswith('|') and not line.endswith('\\|'):
+            line = line[:-1]
+        cells = []
+        start = 0
+        index = 0
+        while index < len(line):
+            if line[index] == '\\':
+                index += 2
+                continue
+            if line[index] == '`':
+                run = 1
+                while index + run < len(line) and line[index + run] == '`':
+                    run += 1
+                marker = '`' * run
+                closing = line.find(marker, index + run)
+                if closing >= 0:
+                    index = closing + run
+                    continue
+                index += run
+                continue
+            if line[index] == '|':
+                cells.append(line[start:index].strip())
+                start = index + 1
+            index += 1
+        cells.append(line[start:].strip())
+        return cells
+
+    @classmethod
+    def _is_separator(cls, line):
+        return all(re.fullmatch(r':?-{3,}:?', cell) for cell in cls._cells(line))
+
+    def test_academy_markdown_tables_have_consistent_column_counts(self):
+        errors = []
+        for path in sorted(self.docs.glob('academy-*.md')):
+            lines = path.read_text(encoding='utf-8').splitlines()
+            fence = None
+            index = 0
+            while index < len(lines):
+                stripped = lines[index].strip()
+                if stripped.startswith('```') or stripped.startswith('~~~'):
+                    marker = stripped[0]
+                    length = len(stripped) - len(stripped.lstrip(marker))
+                    if fence is None:
+                        fence = (marker, length)
+                    elif marker == fence[0] and length >= fence[1]:
+                        fence = None
+                    index += 1
+                    continue
+                if fence is not None:
+                    index += 1
+                    continue
+                if (stripped.startswith('|') and index + 1 < len(lines)
+                        and self._is_separator(lines[index + 1].strip())):
+                    expected = len(self._cells(stripped))
+                    separator_columns = len(self._cells(lines[index + 1].strip()))
+                    if separator_columns != expected:
+                        errors.append(f'{path}:{index + 2}: separator has {separator_columns} columns; header has {expected}')
+                    row_index = index + 2
+                    while row_index < len(lines):
+                        row = lines[row_index].strip()
+                        if not (row.startswith('|') and row.endswith('|')):
+                            break
+                        columns = len(self._cells(row))
+                        if columns != expected:
+                            errors.append(f'{path}:{row_index + 1}: row has {columns} columns; header has {expected}')
+                        row_index += 1
+                    index = row_index
+                    continue
+                index += 1
+        self.assertEqual(errors, [], '\n'.join(errors))
+
+
+if __name__ == '__main__':
+    unittest.main()
