+      const ext = path.extname(fp);
+      const ct = ext === '.json' ? 'application/json' : ext === '.js' ? 'application/javascript' : ext === '.css' ? 'text/css; charset=utf-8' : 'text/plain';
+      res.writeHead(200, { 'Content-Type': ct });
+      fs.createReadStream(fp).pipe(res);
+      return;
+    }
+  }
+
+  if (url.pathname === '/api/academy/progress' && req.method === 'POST') {
