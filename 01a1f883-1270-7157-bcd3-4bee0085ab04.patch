+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+BUNDLE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
+# shellcheck source=lib.sh
+source "$BUNDLE_DIR/lib.sh"
+
+academy_resolve_root "${1:-}"
+academy_preflight
+academy_note 'Read-only preflight finished. The install command will repeat every check, then create and validate backups before it copies a file.'
diff --git a/manual-deployment/fam-academy-157682a/rollback.sh b/manual-deployment/fam-academy-157682a/rollback.sh
new file mode 100644
index 0000000..271532d
--- /dev/null
+++ b/manual-deployment/fam-academy-157682a/rollback.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+BUNDLE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
+# shellcheck source=lib.sh
+source "$BUNDLE_DIR/lib.sh"
+
+academy_resolve_root "${1:-}"
+academy_require_root
+BACKUP_ARG="${2:-}"
+[[ -n "$BACKUP_ARG" && -d "$BACKUP_ARG" ]] || academy_fail 'Pass the verified backup directory reported by install.sh.'
+BACKUP_DIR="$(realpath -e -- "$BACKUP_ARG")"
+EXPECTED_PREFIX="$ROOT/data/backups/fam-academy-157682a-"
+[[ "$BACKUP_DIR" == "$EXPECTED_PREFIX"* && ! -L "$BACKUP_ARG" ]] ||
+  academy_fail 'Rollback directory is not a package-created backup under this FAM project data/backups/.'
+[[ -f "$BACKUP_DIR/SHA256SUMS" && -f "$BACKUP_DIR/ROLLBACK.tsv" &&
+   -f "$BACKUP_DIR/ROLLBACK.meta" && -f "$BACKUP_DIR/target-files.tar.gz" ]] ||
+  academy_fail 'Rollback metadata or target-file archive is missing.'
+(
+  cd "$BACKUP_DIR"
+  sha256sum -c SHA256SUMS >/dev/null
+) || academy_fail 'A backup checksum failed. Nothing has been restored.'
+[[ "$(stat -c '%a' "$BACKUP_DIR")" == '700' ]] || academy_fail 'Backup directory permissions are not 0700.'
+[[ "$(stat -c '%a' "$BACKUP_DIR/fam.sqlite3")" == '600' ]] || academy_fail 'Database backup permissions are not 0600.'
+
+meta_value() {
+  awk -F= -v key="$1" '$1==key {sub(/^[^=]*=/, ""); print; exit}' "$BACKUP_DIR/ROLLBACK.meta"
+}
+BASE_COMMIT="$(meta_value base_commit)"
+OLD_IMAGE_ID="$(meta_value old_image_id)"
+OLD_IMAGE_REF="$(meta_value old_image_ref)"
+ROLLBACK_TAG="$(meta_value rollback_tag)"
+[[ "$BASE_COMMIT" == "$FAM_ACADEMY_BASE_COMMIT" ]] || academy_fail 'Rollback record has a different base commit.'
+[[ "$OLD_IMAGE_ID" =~ ^sha256:[0-9a-f]+$ && "$OLD_IMAGE_REF" == 'fam-app:1.0' &&
+   "$ROLLBACK_TAG" == fam-academy-rollback:* ]] || academy_fail 'Rollback image metadata is invalid.'
+docker image inspect "$OLD_IMAGE_ID" >/dev/null 2>&1 || academy_fail 'The prior app image is no longer available locally.'
+
+TMP="$(mktemp -d)"
+trap 'rm -rf -- "$TMP"' EXIT
+if ! tar -tzf "$BACKUP_DIR/target-files.tar.gz" > "$TMP/archive-list" 2>/dev/null; then
+  academy_fail 'Target-file backup archive cannot be listed.'
+fi
+sed 's#^\./##; s#/$##' "$TMP/archive-list" | awk 'NF' | LC_ALL=C sort -u > "$TMP/archive-files"
+awk -F '\t' '$2=="1" {print $1}' "$BACKUP_DIR/ROLLBACK.tsv" | LC_ALL=C sort -u > "$TMP/expected-files"
+cmp -s "$TMP/archive-files" "$TMP/expected-files" || academy_fail 'Target-file archive does not match its rollback record.'
+while IFS= read -r relative; do
+  case "$relative" in
+    nginx.conf|server/app.py|server/private_ui/academy.html|server/www/academy-assets/academy-course-library.css|server/www/academy-assets/academy-course-library.js|server/www/academy-content/catalog.json|server/www/academy-content/academy-*.md|server/www/academy-content/images/*.svg)
+      ;;
+    *) academy_fail "Out-of-scope rollback path: $relative" ;;
+  esac
+  [[ "$relative" != /* && "$relative" != *'..'* ]] || academy_fail "Unsafe rollback path: $relative"
+done < "$TMP/archive-files"
+tar -xzf "$BACKUP_DIR/target-files.tar.gz" -C "$TMP" >/dev/null 2>&1 || academy_fail 'Could not extract the verified target-file backup.'
+
+# Verify every original copy and current target before the first restore. A
+# target changed after installation is left untouched and requires review.
+while IFS=$'\t' read -r relative existed old_sha new_sha old_mode old_uid old_gid; do
+  case "$relative" in
+    nginx.conf|server/app.py|server/private_ui/academy.html|server/www/academy-assets/academy-course-library.css|server/www/academy-assets/academy-course-library.js|server/www/academy-content/catalog.json|server/www/academy-content/academy-*.md|server/www/academy-content/images/*.svg)
+      ;;
+    *) academy_fail "Out-of-scope rollback path: $relative" ;;
+  esac
+  [[ "$relative" != /* && "$relative" != *'..'* && "$new_sha" =~ ^[0-9a-f]{64}$ ]] ||
+    academy_fail "Invalid rollback record for $relative"
+  target="$ROOT/$relative"
+  if [[ -L "$target" ]]; then academy_fail "Target is now a symlink; refusing rollback: $relative"; fi
+  if [[ "$existed" == '1' ]]; then
+    [[ "$old_sha" =~ ^[0-9a-f]{64}$ && "$old_mode" =~ ^[0-7]{3,4}$ &&
+       "$old_uid" =~ ^[0-9]+$ && "$old_gid" =~ ^[0-9]+$ ]] || academy_fail "Invalid old-file metadata: $relative"
+    [[ -f "$TMP/$relative" && "$(academy_sha "$TMP/$relative")" == "$old_sha" ]] ||
+      academy_fail "Verified original file is missing or changed in backup: $relative"
+    if [[ -f "$target" ]]; then
+      current_sha="$(academy_sha "$target")"
+      [[ "$current_sha" == "$old_sha" || "$current_sha" == "$new_sha" ]] ||
+        academy_fail "File changed after package deployment; refusing to overwrite: $relative"
+    else
+      academy_fail "Previously existing file disappeared; refusing to infer user intent: $relative"
+    fi
+  elif [[ "$existed" == '0' ]]; then
+    [[ "$old_sha" == '-' && "$old_mode" == '-' && "$old_uid" == '-' && "$old_gid" == '-' ]] ||
+      academy_fail "Invalid absent-file metadata: $relative"
+    if [[ -e "$target" ]]; then
+      [[ -f "$target" && "$(academy_sha "$target")" == "$new_sha" ]] ||
+        academy_fail "A newly-added target changed after deployment; refusing to delete: $relative"
+    fi
+  else
+    academy_fail "Invalid existence flag for $relative"
+  fi
+done < "$BACKUP_DIR/ROLLBACK.tsv"
+
+printf 'Restoring only files changed by this Academy package…\n'
+while IFS=$'\t' read -r relative existed old_sha new_sha old_mode old_uid old_gid; do
+  target="$ROOT/$relative"
+  if [[ "$existed" == '1' ]]; then
+    current_sha="$(academy_sha "$target")"
+    if [[ "$current_sha" != "$old_sha" ]]; then
+      parent="$(dirname -- "$target")"
+      temp_file="$(mktemp "$parent/.fam-academy-rollback.XXXXXX")"
+      cp -- "$TMP/$relative" "$temp_file"
+      chown "$old_uid:$old_gid" "$temp_file"
+      chmod "$old_mode" "$temp_file"
+      mv -f -- "$temp_file" "$target"
+    fi
+  elif [[ -f "$target" ]]; then
+    rm -f -- "$target"
+  fi
+done < "$BACKUP_DIR/ROLLBACK.tsv"
+
+# Compose and nginx are the only services touched; the saved data volume,
+# settings and certificates are never restored or rewritten by normal rollback.
+docker image tag "$OLD_IMAGE_ID" "$OLD_IMAGE_REF" >/dev/null 2>&1 || academy_fail 'Could not restore the old app image tag.'
+academy_compose up -d --no-deps app || academy_fail 'Could not start the prior app image.'
+NGINX_ID="$(academy_compose ps -q nginx 2>/dev/null || true)"
+if [[ -z "$NGINX_ID" || "$(docker inspect --format '{{.State.Running}}' "$NGINX_ID" 2>/dev/null || true)" != 'true' ]]; then
+  academy_compose up -d --no-deps nginx || academy_fail 'Could not start the existing nginx service for config rollback.'
+fi
+academy_compose exec -T nginx nginx -t >/dev/null 2>&1 || academy_fail 'Restored nginx configuration did not pass nginx -t.'
+academy_compose exec -T nginx nginx -s reload >/dev/null 2>&1 || academy_fail 'Could not reload nginx with the restored config.'
+
+printf 'Rollback completed for FAM Academy files and app image.\n'
+printf 'Database, .env, Compose settings, certificates and network settings were not restored or modified.\n'
+printf 'Verified backup retained at: %s\n' "$BACKUP_DIR"
+printf 'Keep the previous-image tag until the owner signs off: %s\n' "$ROLLBACK_TAG"
diff --git a/manual-deployment/fam-academy-157682a/tests/test_install_config_archive.py b/manual-deployment/fam-academy-157682a/tests/test_install_config_archive.py
