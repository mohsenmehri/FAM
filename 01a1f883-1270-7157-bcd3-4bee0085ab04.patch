+[[ "$(stat -c '%a' "$BACKUP_DIR")" == '700' ]] || academy_fail 'Backup directory permissions are not 0700.'
+[[ "$(stat -c '%a' "$BACKUP_DIR/fam.sqlite3")" == '600' ]] || academy_fail 'Database backup permissions are not 0600.'
