PAT","\u062A\u0631\u062C\u0645\u0647 \u0622\u062F\u0631\u0633 \u0648 \u067E\u0648\u0631\u062A\u061B \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u0646\u0648\u0639 NAT."],["Inside/Outside","\u0634\u0628\u06A9\u0647 \u0645\u0627 \u062F\u0631 \u0645\u0642\u0627\u0628\u0644 \u0634\u0628\u06A9\u0647 \u0628\u06CC\u0631\u0648\u0646."],["ALG","\u06A9\u0645\u06A9\u200C\u06A9\u0646\u0646\u062F\u0647 \u0644\u0627\u06CC\u0647 \u0627\u067E\u0644\u06CC\u06A9\u06CC\u0634\u0646 \u0628\u0631\u0627\u06CC \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 IP \u0631\u0627 \u062F\u0631 payload \u062F\u0627\u0631\u0646\u062F."],["NAT-T","\u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 UDP 4500 \u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 IPsec \u0627\u0632 NAT."]]},dhcp:{prereq:["subnetting"],related:["l2-security","ipv6","inter-vlan"],title:"DHCP \u0648 Relay \u2014 \u0686\u0637\u0648\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627 \u0628\u062F\u0648\u0646 \u062A\u0646\u0638\u06CC\u0645 \u062F\u0633\u062A\u06CC \u0622\u062F\u0631\u0633 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F",tagline:"DHCP \u0686\u0647\u0627\u0631 \u067E\u06CC\u0627\u0645 \u0633\u0627\u062F\u0647 \u062F\u0627\u0631\u062F\u060C \u0648\u0644\u06CC \u0628\u06CC\u0634\u062A\u0631 \u0642\u0637\u0639\u06CC\u200C\u0647\u0627\u06CC \xABIP \u0646\u06AF\u0631\u0641\u062A\u0645\xBB \u0628\u0647 \u0647\u0645\u06CC\u0646 \u0686\u0647\u0627\u0631 \u067E\u06CC\u0627\u0645 \u0645\u0631\u0628\u0648\u0637 \u0627\u0633\u062A.",minutes:12,goals:["\u0686\u0647\u0627\u0631 \u067E\u06CC\u0627\u0645 DORA \u0631\u0627 \u0628\u0647 \u062A\u0631\u062A\u06CC\u0628 \u0628\u06AF\u0648\u06CC\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC \u0647\u0631 \u06A9\u062F\u0627\u0645 broadcast \u0627\u0633\u062A \u06CC\u0627 unicast","\u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC \u0686\u0631\u0627 \u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0627\u06CC \u0628\u0627 \u0686\u0646