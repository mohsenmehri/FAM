+def validate_svg(path: Path) -> None:
+    raw = path.read_text(encoding='utf-8')
+    if re.search(r'<!\s*(?:DOCTYPE|ENTITY)', raw, re.I):
+        fail(f'Unsafe DTD/entity in SVG: {path.name}')
+    try:
+        root = ET.fromstring(raw)
+    except ET.ParseError as exc:
+        fail(f'Invalid SVG {path.name}: {exc}')
+    if root.tag.rsplit('}', 1)[-1].lower() != 'svg':
+        fail(f'Root element is not SVG: {path.name}')
+    forbidden = {'script', 'foreignobject', 'iframe', 'object', 'embed', 'audio', 'video'}
+    for node in root.iter():
+        tag = node.tag.rsplit('}', 1)[-1].lower()
+        if tag in forbidden:
+            fail(f'Active/embedded element {tag} in SVG: {path.name}')
+        for name, value in node.attrib.items():
+            local_name = name.rsplit('}', 1)[-1].lower()
+            if local_name.startswith('on'):
+                fail(f'Event attribute in SVG {path.name}: {local_name}')
+            if local_name == 'href' and value and not value.startswith(('#', 'data:')):
+                fail(f'External SVG reference in {path.name}: {value[:80]}')
+            if local_name == 'style' and re.search(r'(?:url\s*\(|@import|javascript\s*:|expression\s*\()', value, re.I):
+                fail(f'External/active SVG style in {path.name}')
+        if node.text and re.search(r'(?:url\s*\(|@import|javascript\s*:|expression\s*\()', node.text, re.I):
+            fail(f'External/active SVG CSS in {path.name}')
+
