+/* Academy's section header follows the native FAM view-head placement. */
+.academy-section-head {
+  position: sticky; top: calc(var(--top-h) + 10px); z-index: 65;
+  transition: opacity .18s ease;
+  display: flex; align-items: center; gap: 12px; min-height: 62px;
+  align-self: center; margin: 0 14px 10px; padding: 10px 16px;
+  box-sizing: border-box; border: 1px solid var(--c-border); border-radius: var(--r-md);
+  background: color-mix(in srgb, var(--c-surface) 88%, transparent);
+  box-shadow: var(--sh-1); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
+}
+/* Keep the side panel clear of the pinned header. */
+@media (min-width: 861px) {
+  .app-shell:not(.academy-menu-collapsed) > .sidebar {
+    top: calc(var(--top-h) + 92px);
+    height: calc(100dvh - var(--top-h) - 92px);
+  }
+}
+.academy-section-head.is-stuck { opacity: .78; }
+.academy-section-heading { display: flex; align-items: center; gap: 11px; min-width: 0; }
+.academy-head-mark {
+  display: grid; place-items: center; flex: none; width: 38px; height: 38px;
+  border: 1px solid var(--c-border); border-radius: var(--r-sm);
+  background: var(--c-brand-soft); color: var(--c-brand); font-size: 10px; font-weight: 900;
+}
+.academy-section-heading h2 { font-size: var(--fs-lg); font-weight: 800; }
+.academy-section-sub { margin-top: 2px; color: var(--c-text-3); font-size: var(--fs-xs); letter-spacing: .06em; text-transform: uppercase; }
+.academy-section-actions { display: flex; align-items: center; gap: 8px; margin-inline-start: auto; }
+.academy-section-switch { display: inline-flex; flex: none; align-items: center; justify-content: center; min-height: 36px; padding: 0 13px; border: 1px solid var(--c-border-strong); border-radius: var(--r-sm); background: var(--c-surface); color: var(--c-text); font-size: var(--fs-sm); font-weight: 700; white-space: nowrap; }
+.academy-section-switch:hover { border-color: var(--c-brand); background: var(--c-brand-soft); color: var(--c-brand); text-decoration: none; }
+.academy-section-switch-primary { border-color: var(--c-brand); background: var(--c-brand); color: var(--c-on-primary); font-weight: 800; }
+.academy-section-switch-primary:hover { border-color: var(--c-brand); background: color-mix(in srgb, var(--c-brand) 86%, #000); color: var(--c-on-primary); }
