46\u0631\u062E \u062F\u0627\u062E\u0644\u06CC \u0628\u0631\u0627\u06CC \u0635\u062F\u0627 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F\u061B **Shaping** \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u0627\u0632\u0627\u062F \u062E\u0631\u0648\u062C\u06CC \u0631\u0627 \u062F\u0631 \u0628\u0627\u0641\u0631 \u0646\u0631\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B **Policing** \u0645\u0627\u0632\u0627\u062F \u0646\u0631\u062E \u0631\u0627 \u0628\u0627 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645 Token Bucket \u062F\u0648\u0631 \u0645\u06CC\u200C\u0631\u06CC\u0632\u062F \u06CC\u0627 Remark \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0648 **WRED** \u0628\u0627 \u062D\u0630\u0641 \u0647\u0648\u0634\u0645\u0646\u062F \u0648 \u062A\u0635\u0627\u062F\u0641\u06CC \u0632\u0648\u062F\u0647\u0646\u06AF\u0627\u0645 \u062C\u0644\u0648\u06CC \u067E\u062F\u06CC\u062F\u06C0 TCP Global Synchronization \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F.",labs:["qos","qos-advanced"]},{term:"GRE",aliases:["mGRE"],full:"Generic Routing Encapsulation (RFC 2784)",cat:"services",def:"\u067E\u0631\u0648\u062A\u06A9\u0644 \u062A\u0648\u0646\u0644\u200C\u0632\u0646\u06CC \u0633\u0627\u062F\u0647 \u0648 \u0647\u0645\u0647\u200C\u06A9\u0627\u0631\u0647 \u0644\u0627\u06CC\u0647 \u06F3 (\u0634\u0645\u0627\u0631\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0628\u0631\u0627\u0628\u0631 \u06F4\u06F7 \u0628\u0627 \u06F4 \u0628\u0627\u06CC\u062A \u0647\u062F\u0631 GRE + \u06F2\u06F0 \u0628\u0627\u06CC\u062A \u0647\u062F\u0631 IP \u062C\u062F\u06CC\u062F = \u06F2\u06F4 \u0628\u0627\u06CC\u062A \u0633\u0631\u0628\u0627\u0631) \u06A9\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u0627\u0644\u062A\u06CC\u200C\u06A9\u0633\u062A\u060C IPv6 \u0648 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u067E\u0648\u06CC\u0627 (OSPF/EIGRP) \u0631\u0627 \u0627\u0632 \u0631\u0648\u06CC WAN بانک \u0639\u0628\u0648\u0631 \u062F\u0647\u062F\u060C \u0627\u0645\u0627 \u0628\u0647\u200C\u062E\u0648\u062F\u06CC\u200C\u062E\u0648\u062F **\u0647\u06CC\u0686 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0646\u062F\u0627\u0631\u062F**. \u0646\u0633\u062E\u0647 \u0686\u0646\u062F\u0646\u0642\u0637\u0647\u200C\u0627\u06CC \u0622\u0646 (**mGRE**) \u067E\u0627\u06CC\u0647 \u0645\u0639\u0645\u0627\u0631\u06CC DMVPN \u0627\u0633\u062A.",labs:["dmvpn","ipsec"]},{term:"DMVPN",aliases:["NHRP"],full:"Dynamic Multipoint VPN & Next Hop Resolution Protocol",cat:"services",def:"\u0645\u0639\u0645\u0627\u0631\u06CC \u0645\u0642\u06CC\u0627\u0633\u200C\u067E\u0630\u06CC\u0631 WAN \u0633\u06CC\u0633\u06A9\u0648 \u0645\u062A\u0634\u06A9\u0644 \u0627\u0632 \u062A\u0648\u0646\u0644\u200C\u0647\u0627\u06CC **mGRE**\u060C \u067E\u0631\u0648\u062A\u06A9\u0644 **NHRP** (\u0646\u0642\u0634\u0647\u200C\u0628\u0631\u062F\u0627\u0631 \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u062E\u0635\u0648\u0635\u06CC \u0628\u0647 IP \u0639\u0645\u0648\u0645\u06CC \u0627\u06CC\u0646\u062A\u0631\u0646\u062A\u06CC \u0631\u0648\u062A\u0631\u0647\u0627\u060C \u0645\u0634\u0627\u0628\u0647 ARP \u0631\u0648\u06CC WAN)\u060C \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u067E\u0648\u06CC\u0627 \u0648 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC **IPsec**. \u062F\u0631 \u0641\u0627\u0632 \u06F3 (\u0628\u0627 \u062F\u0633\u062A\u0648\u0631\u0647\u0627\u06CC `ip nhrp redirect` \u0631\u0648\u06CC Hub \u0648 `ip nhrp shortcut` \u0631\u0648\u06CC Spoke) \u062F\u0648 \u0634\u0639\u0628\u0647 \u0645\u0633\u062A\u0642\u06CC\u0645\u0627\u064B \u0648 \u067E\u0648\u06CC\u0627 \u0628\u0627 \u0647\u0645 \u062A\u0648\u0646\u0644 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC\u200C\u0634\u062F\u0647 \u0645\u06CC\u200C\u0632\u0646\u0646\u062F \u0628\u062F\u0648\u0646 \u0639\u0628\u0648\u0631 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0627\u0632 \u0645\u0631\u06A9\u0632.",labs:["dmvpn","ipsec"]},{term:"IPsec",aliases:["IKEv2","ESP","AH"],full:"IP Security Architecture & Internet Key Exchange v2 (RFC 7296)",cat:"services",def:"\u0686\u0627\u0631\u0686\u0648\u0628 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0627\u0645\u0646\u06CC\u062A \u0644\u0627\u06CC\u0647 \u06F3 \u0628\u0631\u0627\u06CC \u062A\u0636\u0645\u06CC\u0646 \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC (AES-GCM)\u060C \u06CC\u06A9\u067E\u0627\u0631\u0686\u06AF\u06CC\u060C \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0645\u0628\u062F\u0623 \u0648 \u0645\u0642\u0627\u0628\u0644\u0647 \u0628\u0627 \u062A\u06A9\u0631\u0627\u0631 \u0628\u0633\u062A\u0647 (Anti-Replay). \u062F\u0631 **IKEv2** (\u0631\u0648\u06CC UDP \u067E\u0648\u0631\u062A \u06F5\u06F0\u06F0 \u0648 \u062F\u0631 \u062D\u0636\u0648\u0631 NAT \u067E\u0648\u0631\u062A \u06F4\u06F5\u06F0\u06F0) \u062A\u0646\u0647\u0627 \u0628\u0627 \u06F4 \u067E\u06CC\u0627\u0645 (`IKE_SA_INIT` \u0648 `IKE_AUTH`) \u06A9\u0627\u0646\u0627\u0644 \u0627\u0645\u0646 \u0648 \u0627\u0646\u062C\u0645\u0646\u200C\u0647\u0627\u06CC \u0627\u0645\u0646\u06CC\u062A\u06CC **ESP** (\u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0634\u0645\u0627\u0631\u0647 \u06F5\u06F0) \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F.",labs:["ipsec","dmvpn","sdwan"]},{term:"MTU",aliases:["TCP MSS","PMTUD"],full:"Maximum Transmission Unit & TCP Maximum Segment Size",cat:"services",def:"\u062D\u062F\u0627\u06A9\u062B\u0631 \u0627\u0646\u062F\u0627\u0632\u0647 \u0628\u0633\u062A\u0647 \u0644\u0627\u06CC\u0647 \u06F3 \u0642\u0627\u0628\u0644 \u0627\u0631\u0633\u0627\u0644 \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9 \u0628\u062F\u0648\u0646 \u0642\u0637\u0639\u0647\u200C\u0642\u0637\u0639\u0647 \u0634\u062F\u0646 (\u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0627\u062A\u0631\u0646\u062A \u06F1\u06F5\u06F0\u06F0 \u0628\u0627\u06CC\u062A). \u0647\u0646\u06AF\u0627\u0645 \u0639\u0628\u0648\u0631 \u0628\u0633\u062A\u0647 \u0627\u0632 \u062A\u0648\u0646\u0644\u200C\u0647\u0627\u06CC GRE/IPsec\u060C MPLS \u06CC\u0627 VXLAN\u060C \u0633\u0631\u0628\u0627\u0631 \u0647\u062F\u0631\u0647\u0627\u06CC \u062C\u062F\u06CC\u062F \u0628\u0647 \u0628\u0633\u062A\u0647 \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646 \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062A\u0648\u0646\u0644 \u0627\u0632 `ip mtu 1400` \u0648 `ip tcp adjust-mss 1360` (\u0648 \u062F\u0631 VXLAN \u0627\u0632 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A Jumbo Frame \u0628\u0627 MTU \u06F9\u06F0\u06F0\u06F0+) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.",labs:["dmvpn","ipsec","vxlan-evpn","troubleshooting"]},{term:"CAPWAP",aliases:["WLC","FlexConnect"],full:"Control and Provisioning of Wireless Access Points (RFC 5415)",cat:"fabric",def:"\u067E\u0631\u0648\u062A\u06A9\u0644 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0627\u0631\u062A\u0628\u0627\u0637\u06CC \u0645\u06CC\u0627\u0646 \u0627\u06A9\u0633\u0633\u200C\u067E\u0648\u06CC\u0646\u062A\u200C\u0647\u0627\u06CC \u0633\u0628\u06A9 (Lightweight AP) \u0648 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0628\u06CC\u200C\u0633\u06CC\u0645 (**WLC**\u060C \u0645\u0627\u0646\u0646\u062F Catalyst 9800): \u06A9\u0627\u0646\u0627\u0644 \u06A9\u0646\u062A\u0631\u0644\u06CC \u0631\u0648\u06CC **UDP 5246** (\u0647\u0645\u06CC\u0634\u0647 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC\u200C\u0634\u062F\u0647 \u0628\u0627 DTLS) \u0648 \u06A9\u0627\u0646\u0627\u0644 \u062F\u0627\u062F\u0647 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0631\u0648\u06CC **UDP 5247** \u0628\u0631\u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062F\u0631 \u0645\u0639\u0645\u0627\u0631\u06CC \u0634\u0639\u0628 \u062F\u0648\u0631 (**FlexConnect**) \u06A9\u0646\u062A\u0631\u0644 \u062F\u0631 \u0645\u0631\u06A9\u0632 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F \u0627\u0645\u0627 \u062F\u0627\u062F\u0647 \u06A9\u0627\u0631\u0628\u0631 \u0645\u062D\u0644\u06CC \u0631\u0648\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0634\u0639\u0628\u0647 \u0633\u0648\u0626\u06CC\u0686 \u0645\u06CC\u200C\u0634\u0648\u062F.",labs:["wlan","wifi6e"]},{term:"WPA3",aliases:["SAE","OWE","PMF","802.11w"],full:"Wi-Fi Protected Access 3 & Protected Management Frames",cat:"fabric",def:"\u0646\u0633\u0644 \u0633\u0648\u0645 \u0627\u0645\u0646\u06CC\u062A \u0628\u06CC\u200C\u0633\u06CC\u0645 \u06A9\u0647 \u062F\u0631 \u062D\u0627\u0644\u062A \u0634\u062E\u0635\u06CC \u067E\u0631\u0648\u062A\u06A9\u0644 **SAE (Dragonfly)** \u0631\u0627 \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646 PSK \u06A9\u0631\u062F\u0647 \u062A\u0627 \u062F\u0631 \u0628\u0631\u0627\u0628\u0631 \u062D\u0645\u0644\u0627\u062A \u062F\u06CC\u06A9\u0634\u0646\u0631\u06CC \u0622\u0641\u0644\u0627\u06CC\u0646 \u0645\u0642\u0627\u0648\u0645 \u0628\u0627\u0634\u062F \u0648 Forward Secrecy \u0628\u062F\u0647\u062F\u060C \u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0628\u0627\u0632 \u0627\u0632 **OWE** \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC **PMF (802.11w)** \u0631\u0627 \u0627\u062C\u0628\u0627\u0631\u06CC \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u062A\u0627 \u062D\u0645\u0644\u0627\u062A \u0642\u0637\u0639 \u0627\u062A\u0635\u0627\u0644 \u062C\u0639\u0644\u06CC (Deauthentication Spoofing) \u0646\u0627\u0645\u0645\u06A9\u0646 \u0634\u0648\u0646\u062F. \u062F\u0631 \u0628\u0627\u0646\u062F \u06F6 \u06AF\u06CC\u06AF\u0627\u0647\u0631\u062A\u0632 (Wi-Fi 6E) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 WPA3/OWE \u0628\u0627 PMF \u0627\u062C\u0628\u0627\u0631\u06CC \u0627\u0644\u0632\u0627\u0645\u06CC \u0627\u0633\u062A.",labs:["wlan","wifi6e"]},{term:"Wi-Fi 6E",aliases:["802.11ax","OFDMA","BSS Coloring","802.11r"],full:"IEEE 802.11ax in 6 GHz Spectrum",cat:"fabric",def:"\