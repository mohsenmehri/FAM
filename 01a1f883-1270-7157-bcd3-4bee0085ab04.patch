],title:"NAT \u0648 PAT \u2014 \u0686\u0637\u0648\u0631 \u0622\u062F\u0631\u0633 \u062E\u0635\u0648\u0635\u06CC \u0628\u0647 \u0627\u06CC\u0646\u062A\u0631\u0646\u062A \u0645\u06CC\u200C\u0631\u0633\u062F",tagline:"NAT \u06CC\u06A9 \u062A\u063A\u06CC\u06CC\u0631 \u0633\u0627\u062F\u0647 \u0631\u0648\u06CC \u0622\u062F\u0631\u0633 \u0627\u0633\u062A\u060C \u0648\u0644\u06CC \u0647\u0645\u06CC\u0646 \u062A\u063A\u06CC\u06CC\u0631\u060C \u062C\u062F\u0648\u0644 \u0648\u0636\u0639\u06CC\u062A \u0648 \u062A\u0631\u062A\u06CC\u0628 \u067E\u0631\u062F\u0627\u0632\u0634 \u0631\u0627 \u067E\u06CC\u0686\u06CC\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F.",minutes:14,goals:["inside/outside \u0648 local/global \u0631\u0627 \u0628\u0627 \u0647\u0645 \u0627\u0634\u062A\u0628\u0627\u0647 \u0646\u06AF\u06CC\u0631\u06CC","\u0633\u0647 \u0646\u0648\u0639 NAT (static\u060C dynamic\u060C overload) \u0631\u0627 \u062A\u0634\u062E\u06CC\u0635 \u0628\u062F\u0647\u06CC \u0648 \u06A9\u0627\u0631\u0628\u0631\u062F \u0647\u0631 \u06A9\u062F\u0627\u0645 \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC","\u0628\u062F\u0627\u0646\u06CC \u0686\u0631\u0627 NAT \u0628\u0627 IPsec \u0648 \u0628\u0627 \u0628\u0639\u0636\u06CC \u0627\u067E\u0644\u06CC\u06A9\u06CC\u0634\u0646\u200C\u0647\u0627 \u0645\u0634\u06A9\u0644 \u067E\u06CC\u062F\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F"],sections:[{h:"\u0686\u0631\u0627 NAT \u0644\u0627\u0632\u0645 \u0634\u062F\u061F",p:["\u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC IPv4 \u062A\u0645\u0627\u0645 \u0634\u062F\u0646\u062F \u0648 \u0631\u0627\u0647\u200C\u062D\u0644 \u0645\u0648\u0642\u062A \u0627\u06CC\u0646 \u0628\u0648\u062F \u06A9\u0647 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u062F\u0627\u062E\u0644\u06CC \u0627\u0632 \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC \u062E\u0635\u0648\u0635\u06CC (10/8\u060C 172.16/12\u060C 192.168/16) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u0646\u062F \u0648 \u0641\u0642\u0637 \u06CC\u06A9 \u06CC\u0627 \u0686\u0646\u062F \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u062F\u0631 \u0645\u0631\u0632 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F. NAT \u0647\u0645\u0627\u0646 \u062A\u0631\u062C\u0645\u0647 \u0627\u0633\u062A: \u0622\u062F\u0631\u0633 \u062E\u0635\u0648\u0635\u06CC \u062F\u0631 \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u062E\u0631\u0648\u062C\u06CC \u0628\u0647 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u062F\u0631 \u0628\u0627\u0632\u06AF\u0634\u062A\u060C \u0628\u0631\u0639\u06A9\u0633.","\u0645\u0632\u06CC\u062A \u062C\u0627\u0646\u0628\u06CC \u0627\u0645\u0646\u06CC\u062A\u06CC \u0647\u0645 \u062F\u0627\u0631\u062F: \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627\u06CC WAN بانک \u0622\u062F\u0631\u0633 \u062F\u0627\u062E\u0644\u06CC \u062A\u0648 \u0631\u0627 \u0646\u0645\u06CC\u200C\u0628\u06CC\u0646\u0646\u062F. \u0648\u0644\u06CC NAT \u06CC\u06A9 \u062F\u06CC\u0648\u0627\u0631 \u0627\u0645\u0646\u06CC\u062A\u06CC \u0648\u0627\u0642\u0639\u06CC \u0646\u06CC\u0633\u062A \u2014 \u0641\u0642\u0637 \u0622\u062F\u0631\u0633 \u0631\u0627 \u067E\u0646\u0647\u0627\u0646 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0641\u0627\u06CC\u0631\u0648\u0627\u0644 \u06A9\u0627\u0631 \u062C\u062F\u0627\u06AF\u0627\u0646\u0647\u200C\u0627\u06CC \u0627\u0633\u062A."]},{h:"\u0686\u0647\u0627\u0631 \u0648\u0627\u0698\u0647 \u06A9\u0647 \u0647\u0645\u0647 \u0631\u0627 \u0642\u0627\u0637\u06CC \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F",p:["\xABinside local\xBB \u0622\u062F\u0631\u0633 \u062F\u0633\u062A\u06AF\u0627\u0647 \u062F\u0631 \u0634\u0628\u06A9\u0647 \u062F\u0627\u062E\u0644\u06CC \u0627\u0632 \u062F\u06CC\u062F \u062E\u0648\u062F\u0645\u0627\u0646 \u0627\u0633\u062A (\u0645\u062B\u0644\u0627\u064B 192.168.1.10). \xABinside global\xBB \u0622\u062F\u0631\u0633 \u0647\u0645\u0627\u0646 \u062F\u0633\u062A\u06AF\u0627\u0647 \u067E\u0633 \u0627\u0632 \u062A\u0631\u062C\u0645\u0647\u060C \u0627\u0632 \u062F\u06CC\u062F WAN بانک \u0627\u0633\u062A (\u0645\u062B\u0644\u0627\u064B 10.10.113.5). \xABoutside global\xBB \u0622\u062F\u0631\u0633 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0628\u06CC\u0631\u0648\u0646\u06CC \u0627\u0633\u062A \u0648 \xABoutside local\xBB \u0622\u062F\u0631\u0633 \u0622\u0646 \u0627\u0632 \u062F\u06CC\u062F \u0634\u0628\u06A9\u0647 \u062F\u0627\u062E\u0644\u06CC (\u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0647\u0645\u0627\u0646 \u062E\u0627\u0631\u062C\u06CC).","\u0642\u0627\u0639\u062F\u0647 \u0630\u0647\u0646\u06CC: local = \u0627\u0632 \u062F\u0627\u062E\u0644 \u062F\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C global = \u0627\u0632 \u0628\u06CC\u0631\u0648\u0646. inside = \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0634\u0628\u06A9\u0647 \u0645\u0627\u060C outside = \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0628\u06CC\u0631\u0648\u0646. \u062A\u0631\u06A9\u06CC\u0628 \u0627\u06CC\u0646 \u062F\u0648\u060C \u0686\u0647\u0627\u0631 \u0648\u0627\u0698\u0647 \u0631\u0627 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u0648 \u062F\u0631 \u0622\u0632\u0645\u0648\u0646\u200C\u0647\u0627 \u0645\u0646\u0628\u0639 \u0633\u0624\u0627\u0644 \u0627\u0633\u062A."],list:["Static NAT: \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u062F\u0627\u062E\u0644\u06CC \u21C4 \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u062B\u0627\u0628\u062A (\u0628\u0631\u0627\u06CC \u0633\u0631\u0648\u0631\u0647\u0627)","Dynamic NAT: \u0627\u0632 \u06CC\u06A9 pool \u0639\u0645\u0648\u0645\u06CC\u060C \u0647\u0631 \u062C\u0644\u0633\u0647 \u06CC\u06A9 \u0622\u062F\u0631\u0633","PAT (overload): \u0647\u0645\u0647 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0628\u0627 \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u0648 \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 \u2014 \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u062D\u0627\u0644\u062A \u062E\u0627\u0646\u06AF\u06CC \u0648 \u0633\u0627\u0632\u0645\u0627\u0646\u06CC"]},{h:"PAT \u0686\u0637\u0648\u0631 \u062F\u0647\u200C\u0647\u0627 \u06A9\u0627\u0631\u0628\u0631 \u0631\u0627 \u0628\u0627 \u06CC\u06A9 IP \u062C\u0648\u0627\u0628 \u0645\u06CC\u200C\u062F\u0647\u062F\u061F",p:["\u062F\u0631 PAT\u060C \u0631\u0648\u062A\u0631 \u062C\u062F\u0648\u0644\u06CC \u0627\u0632 \u062C\u0644\u0633\u0627\u062A \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F: (\u0622\u062F\u0631\u0633 \u062F\u0627\u062E\u0644\u06CC\u060C \u067E\u0648\u0631\u062A \u062F\u0627\u062E\u0644\u06CC) \u21C4 (\u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC\u060C \u067E\u0648\u0631\u062A \u0639\u0645\u0648\u0645\u06CC). \u0648\u0642\u062A\u06CC \u0633\u0647 \u0644\u067E\u200C\u062A\u0627\u067E \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u0628\u0647 \u06CC\u06A9 \u0633\u0627\u06CC\u062A \u0648\u0635\u0644 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F\u060C \u0647\u0631 \u06A9\u062F\u0627\u0645 \u0628\u0627 \u06CC\u06A9 \u067E\u0648\u0631\u062A \u0639\u0645\u0648\u0645\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u062A\u0631\u062C\u0645\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u062F\u0631 \u0628\u0627\u0632\u06AF\u0634\u062A \u0631\u0648\u062A\u0631 \u0628\u0627 \u0647\u0645\u0627\u0646 \u062C\u062F\u0648\u0644 \u0645\u06CC\u200C\u0641\u0647\u0645\u062F \u067E\u0627\u0633\u062E \u0645\u0627\u0644 \u06A9\u062F\u0627\u0645 \u0644\u067E\u200C\u062A\u0627\u067E \u0627\u0633\u062A. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 PAT \u0628\u0647 TCP/UDP \u0648 \u067E\u0648\u0631\u062A \u0648\u0627\u0628\u0633\u062A\u0647 \u0627\u0633\u062A \u0648 \u0628\u0631\u0627\u06CC \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u067E\u0648\u0631\u062A \u0646\u062F\u0627\u0631\u0646\u062F (\u0645\u062B\u0644 ICMP) \u0628\u0627 \u0634\u0646\u0627\u0633\u0647\u200C\u0647\u0627\u06CC \u062F\u0627\u062E\u0644\u06CC \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0627\u06CC\u0646 \u062C\u062F\u0648\u0644 \u0648\u0636\u0639\u06CC\u062A (state) \u062D\u0627\u0641\u0638\u0647 \u0645\u0635\u0631\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u067E\u0633 \u0627\u0632 \u0645\u062F\u062A\u06CC timeout \u0645\u06CC\u200C\u0634\u0648\u062F. \u0628\u0631\u0627\u06CC \u0647\u0645\u06CC\u0646 \u062C\u0644\u0633\u0627\u062A \u0637\u0648\u0644\u0627\u0646\u06CC (SSH\u060C SIP) \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0642\u0637\u0639 \u0634\u0648\u0646\u062F \u0627\u06AF\u0631 timeout \u0645\u0646\u0627\u0633\u0628 \u0646\u0628\u0627\u0634\u062F."],callout:{title:"\u062A\u0631\u062A\u06CC\u0628 \u067E\u0631\u062F\u0627\u0632\u0634",text:"\u062F\u0631 \u0645\u062F\u0644 \u06A9\u0644\u0627\u0633\u06CC\u06A9 IOS \u0628\u0631\u0627\u06CC inside-to-outside\u060C ACL \u0648\u0631\u0648\u062F\u06CC \u067E\u06CC\u0634 \u0627\u0632 route lookup \u0648 NAT \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 ACL \u062E\u0631\u0648\u062C\u06CC \u067E\u0633 \u0627\u0632 NAT \u0627\u0633\u062A. \u062F\u0631 outside-to-inside \u0646\u06CC\u0632 ACL \u0648\u0631\u0648\u062F\u06CC \u067E\u06CC\u0634 \u0627\u0632 NAT \u0648 \u0633\u067E\u0633 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0627\u0633\u062A\u061B ACL \u062E\u0631\u0648\u062C\u06CC \u0628\u0639\u062F \u0627\u0632 \u062A\u0631\u062C\u0645\u0647 \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u0645\u06A9\u0627\u0646\u0627\u062A \u067E\u0644\u062A\u0641\u0631\u0645 \u0648 \u0645\u0633\u06CC\u0631 \u067E\u0631\u062F\u0627\u0632\u0634 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u062A\u0641\u0627\u0648\u062A \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F: \u0631\u0648\u06CC \u0646\u0633\u062E\u0647 \u0645\u0648\u0631\u062F\u0646\u0638\u0631 \u0628\u0627 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 ACL \u0648 \u062C\u062F\u0648\u0644 \u062A\u0631\u062C\u0645\u0647 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646."}},{h:"\u0645\u0634\u06A9\u0644\u0627\u062A \u06A9\u0644\u0627\u0633\u06CC\u06A9 NAT",p:["\u0627\u0648\u0644\u060C \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0622\u062F\u0631\u0633 IP \u0631\u0627 \u062F\u0631 payload \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F: FTP \u0641\u0639\u0627\u0644\u060C SIP\u060C H.323. NAT \u0622\u062F\u0631\u0633 \u062F\u0627\u062E\u0644 payload \u0631\u0627 \u0646\u0645\u06CC\u200C\u0628\u06CC\u0646\u062F \u0648 \u0622\u0646\u200C\u0647\u0627 \u0645\u06CC\u200C\u0634\u06A9\u0646\u0646\u062F\u061B \u0628\u0631\u0627\u06CC \u0647\u0645\u06CC\u0646 Application Layer Gateway \u06CC\u0627 ALG \u0644\u0627\u0632\u0645 \u0627\u0633\u062A. \u062F\u0648\u0645\u060C IPsec: \u0686\u0648\u0646 AH \u0627\u0632 \u0628\u062E\u0634\u200C\u0647\u0627\u06CC \u062A\u063A\u06CC\u06CC\u0631\u0646\u0627\u067E\u0630\u06CC\u0631 \u0633\u0631\u0622\u06CC\u0646\u062F IP \u0646\u06CC\u0632 \u062F\u0631 \u0628\u0631\u0631\u0633\u06CC \u062A\u0645\u0627\u0645\u06CC\u062A \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u062A\u063A\u06CC\u06CC\u0631 \u0622\u062F\u0631\u0633 \u062A\u0648\u0633\u0637 NAT \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0622\u0646 \u0631\u0627 \u0628\u0627\u0637\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 NAT-T \u0628\u0627 ESP \u0648 UDP 4500 \u0633\u0627\u062E\u062A\u0647 \u0634\u062F.","\u0633\u0648\u0645\u060C \u0633\u0631\u0648\u0631\u0647\u0627: \u0628\u0631\u0627\u06CC \u062F\u0633\u062A\u0631\u0633\u06CC \u0622\u063A\u0627\u0632\u0634\u062F\u0647 \u0627\u0632 \u0628\u06CC\u0631\u0648\u0646 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0628\u0647 \u0646\u06AF\u0627\u0634\u062A \u0648\u0631\u0648\u062F\u06CC \u0645\u0646\u0627\u0633\u0628 \u0645\u0627\u0646\u0646\u062F static NAT \u06CC\u0627 static PAT \u0648 \u0627\u06