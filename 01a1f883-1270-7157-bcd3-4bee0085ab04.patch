+    if len({str(item['id']) for item in worksheets}) != len(worksheets):
+        fail('Worksheet catalogue contains duplicate IDs')
+    document_names = {path.name for path in all_content_paths}
+    svg_paths = sorted((DOCS / 'academy-images').glob('*.svg'))
+    if len(svg_paths) != 52:
