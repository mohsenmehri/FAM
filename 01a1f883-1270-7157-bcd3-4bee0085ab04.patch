39\u0628\u0648\u0631 \u06A9\u0646\u06CC\u0645. \u0646\u062A\u06CC\u062C\u0647: \u062F\u0631 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC\u200C\u0634\u062F\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0627\u0632 ECMP \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0631\u062F\u061B STP \u0647\u0645\u0686\u0646\u0627\u0646 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u062F\u0631 \u0628\u062E\u0634\u200C\u0647\u0627\u06CC \u0645\u062D\u0644\u06CC \u0644\u0627\u06CC\u0647 \u06F2 \u0644\u0627\u0632\u0645 \u0628\u0627\u0634\u062F \u0648 \u062A\u0639\u062F\u0627\u062F \u0634\u0646\u0627\u0633\u0647\u200C\u0647\u0627 \u0627\u0632 \u06F4 \u0647\u0632\u0627\u0631 \u0628\u0647 \u06F1\u06F6 \u0645\u06CC\u0644\u06CC\u0648\u0646 \u0645\u06CC\u200C\u0631\u0633\u062F."]},{h:"\u0628\u0633\u062A\u0647 VXLAN \u0686\u0637\u0648\u0631 \u0627\u0633\u062A\u061F",p:["\u0633\u0648\u0626\u06CC\u0686\u06CC \u06A9\u0647 \u0628\u0633\u062A\u0647 \u0631\u0627 \u0645\u06CC\u200C\u067E\u06CC\u0686\u062F VTEP \u0646\u0627\u0645 \u062F\u0627\u0631\u062F. \u0628\u0633\u062A\u0647 \u0627\u0635\u0644\u06CC (\u0641\u0631\u06CC\u0645 Ethernet) \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646 payload \u062F\u0627\u062E\u0644 \u06CC\u06A9 \u0628\u0633\u062A\u0647 UDP (\u067E\u0648\u0631\u062A \u06F4\u06F7\u06F8\u06F9) \u0645\u06CC\u200C\u0631\u0648\u062F \u0648 \u0647\u062F\u0631 VXLAN (\u06F8 \u0628\u0627\u06CC\u062A) \u0634\u0627\u0645\u0644 VNI \u0627\u0633\u062A: \u06CC\u06A9 \u0639\u062F\u062F \u06F2\u06F4 \u0628\u06CC\u062A\u06CC \u06A9\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0627\u06CC\u0646 \u0641\u0631\u06CC\u0645 \u0645\u0627\u0644 \u06A9\u062F\u0627\u0645 \u0634\u0628\u06A9\u0647 \u0645\u062C\u0627\u0632\u06CC \u0627\u0633\u062A. \u0628\u06CC\u0631\u0648\u0646 \u0627\u0632 \u0622\u0646 \u0647\u0645 IP \u0648 MAC \u0634\u0628\u06A9\u0647 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F.","\u062F\u0648 VTEP \u0628\u0627\u06CC\u062F \u0647\u0645\u062F\u06CC\u06AF\u0631 \u0631\u0627 \u0628\u0634\u0646\u0627\u0633\u0646\u062F. \u0631\u0648\u0634 \u0642\u062F\u06CC\u0645\u06CC \xABflood and learn\xBB \u0627\u0633\u062A: MAC\u0647\u0627\u06CC \u0646\u0627\u0634\u0646\u0627\u062E\u062A\u0647 \u0631\u0627 \u062F\u0631 \u062A\u0648\u0646\u0644 \u067E\u062E\u0634 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u0648 \u0627\u0632 \u067E\u0627\u0633\u062E \u06CC\u0627\u062F \u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F (\u0645\u062B\u0644 \u0633\u0648\u0626\u06CC\u0686 \u0645\u0639\u0645\u0648\u0644\u06CC\u060C \u0648\u0644\u06CC \u062F\u0631 \u0645\u0642\u06CC\u0627\u0633 \u0628\u0632\u0631\u06AF). \u0631\u0648\u0634 \u0645\u062F\u0631\u0646 EVPN \u0627\u0633\u062A: \u0647\u0631 VTEP \u0628\u0627 BGP \u0627\u0639\u0644\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u062F\u0627\u0645 MAC (\u06CC\u0627 \u06A9\u062F\u0627\u0645 \u067E\u06CC\u0634\u0648\u0646\u062F IP) \u067E\u0634\u062A \u06A9\u062F\u0627\u0645 VTEP \u0627\u0633\u062A."],list:["VNI = \u0634\u0646\u0627\u0633\u0647 \u0634\u0628\u06A9\u0647 \u0645\u062C\u0627\u0632\u06CC (\u06F2\u06F4 \u0628\u06CC\u062A) \xB7 VXLAN \u0631\u0648\u06CC UDP 4789","VTEP = \u0646\u0642\u0637\u0647 \u0648\u0631\u0648\u062F \u0648 \u062E\u0631\u0648\u062C \u062A\u0648\u0646\u0644","Underlay = \u0634\u0628\u06A9\u0647 IP \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC\u200C\u0634\u062F\u0647 (BGP/OSPF/IS-IS) \u06A9\u0647 \u062A\u0648\u0646\u0644 \u0631\u0648\u06CC \u0622\u0646 \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F","Overlay = \u0634\u0628\u06A9\u0647 \u0645\u062C\u0627\u0632\u06CC \u0644\u0627\u06CC\u0647 \u06F2/\u06F3 \u06A9\u0647 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u06CC\u200C\u0628\u06CC\u0646\u0646\u062F"]},{h:"EVPN: \u06A9\u0646\u062A\u0631\u0644 \u0645\u0633\u06CC\u0631 \u0628\u0627 BGP",p:["EVPN \u06CC\u06A9 \u062E\u0627\u0646\u0648\u0627\u062F\u0647 \u0622\u062F\u0631\u0633 BGP \u0627\u0633\u062A (AFI 25\u060C SAFI 70). \u0627\u0646\u0648\u0627\u0639 \u0645\u0633\u06CC\u0631 \u0622\u0646 \u06A9\u0627\u0631\u0647\u0627\u06CC \u0645\u0634\u062E\u0635\u06CC \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F: Type-2 \u0628\u0631\u0627\u06CC \u0627\u0639\u0644\u0627\u0645 MAC (\u0648 \u0627\u062E\u062A\u06CC\u0627\u0631\u06CC IP)\u060C Type-3 \u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 VTEP\u0647\u0627 \u0628\u062F\u0627\u0646\u0646\u062F \u0647\u0645\u062F\u06CC\u06AF\u0631 \u0631\u0627 \u0628\u0631\u0627\u06CC \u067E\u062E\u0634 BUM \u06A9\u062C\u0627 \u0628\u0641\u0631\u0633\u062A\u0646\u062F\u060C Type-4 \u0628\u0631\u0627\u06CC \u0647\u0645\u0627\u0647\u0646\u06AF\u06CC \u0627\u062A\u0635\u0627\u0644 \u062F\u0648\u06AF\u0627\u0646\u0647 \u0648 Type-5 \u0628\u0631\u0627\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627\u06CC IP.","\u0645\u0632\u06CC\u062A \u0628\u0632\u0631\u06AF EVPN \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u067E\u062E\u0634 broadcast/multicast/unknown-unicast (BUM) \u0628\u0647 \u0647\u0645\u0647 VTEP\u0647\u0627 \u0646\u0645\u06CC\u200C\u0631\u0648\u062F\u060C \u0628\u0644\u06A9\u0647 \u0628\u0647 \u0644\u06CC\u0633\u062A \u06A9\u0646\u062A\u0631\u0644\u200C\u0634\u062F\u0647 \u0645\u06CC\u200C\u0631\u0648\u062F. \u0646\u062A\u06CC\u062C\u0647: \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0628\u0632\u0631\u06AF \u0645\u0642\u06CC\u0627\u0633\u200C\u067E\u0630\u06CC\u0631 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627\u06CC \u067E\u06CC\u0686\u06CC\u062F\u0647 (\u0645\u062B\u0644\u0627\u064B \u06CC\u06A9 \u0645\u0633\u062A\u0623\u062C\u0631 \u0641\u0642\u0637 \u0628\u0627 \u0633\u0631\u0648\u0631\u0647\u0627\u06CC \u062E\u0648\u062F\u0634 \u062D\u0631\u0641 \u0628\u0632\u0646\u062F) \u0631\u0627 \u0628\u0627 BGP \u0627\u0639\u0645\u0627\u0644 \u06A9\u0631\u062F."],callout:{title:"\u062C\u0645\u0639\u200C\u0628\u0646\u062F\u06CC \u06CC\u06A9\u200C\u062E\u0637\u06CC",text:"VXLAN \u0686\u06CC\u0633\u062A\u061F \u0628\u0633\u062A\u0647\u200C\u0627\u06CC \u06A9\u0647 \u067E\u0648\u0634\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F. EVPN \u0686\u06CC\u0633\u062A\u061F \u0645\u063A\u0632\u06CC \u06A9\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0647\u0631 MAC \u06A9\u062C\u0627\u0633\u062A \u062A\u0627 \u0644\u0627\u0632\u0645 \u0646\u0628\u0627\u0634\u062F \u0647\u0645\u0647\u200C\u062C\u0627 \u067E\u062E\u0634 \u0634\u0648\u062F."}},{h:"MTU \u0648 \u0644\u0627\u06CC\u0647 \u0632\u06CC\u0631\u06CC\u0646 (Underlay)",p:["\u0647\u0631 \u0628\u0633\u062A\u0647 VXLAN \u06CC\u06A9 \u0647\u062F\u0631 \u0628\u06CC\u0631\u0648\u0646\u06CC \u062C\u062F\u06CC\u062F \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F: IP \u062E\u0627\u0631\u062C\u06CC\u060C UDP \u0648 VXLAN. \u0645\u062C\u0645\u0648\u0639 \u0633\u0631\u0628\u0627\u0631 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u062D\u062F\u0648\u062F \u06F5\u06F0 \u0628\u0627\u06CC\u062A (\u06CC\u0627 \u0628\u06CC\u0634\u062A\u0631 \u0627\u06AF\u0631 IPsec \u0647\u0645 \u0627\u0636\u0627\u0641\u0647 \u0634\u0648\u062F) \u0627\u0633\u062A. \u0627\u06AF\u0631 MTU \u0632\u06CC\u0631\u0644\u0627\u06CC\u0647 \u06F1\u06F5\u06F0\u06F0 \u0628\u0627\u0634\u062F\u060C \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0628\u0632\u0631\u06AF Fragment \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u06CC\u0627 \u062F\u0648\u0631 \u0631\u06CC\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u0646\u062A\u06CC\u062C\u0647\u200C\u0627\u0634 \u0633\u0627\u06CC\u062A\u200C\u0647\u0627\u06CC\u06CC \u0627\u0633\u062A \u06A9\u0647 \xAB\u0646\u06CC\u0645\u0647\u200C\u0628\u0627\u0632\xBB \u0645\u06CC\u200C\u0634\u0648\u0646\u062F.","MTU \u0645\u0648\u0631\u062F\u0646\u06CC\u0627\u0632 \u0631\u0627 \u0628\u0627 \u062A\u0648\u062C\u0647 \u0628\u0647 \u0627\u0646\u062F\u0627\u0632\u0647 \u0641\u0631\u06CC\u0645 \u062F\u0627\u062E\u0644\u06CC\u060C IPv4/IPv6 \u0628\u06CC\u0631\u0648\u0646\u06CC\u060C VLAN \u0648 \u0633\u0627\u06CC\u0631 \u0633\u0631\u0628\u0627\u0631\u0647\u0627 \u0645\u062D\u0627\u0633\u0628\u0647 \u06A9\u0646 \u0648 \u0638\u0631\u0641\u06CC\u062A \u062A\u0645\u0627\u0645 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC underlay \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u061B \u0645\u0639\u06CC\u0627\u0631 MTU \u0644\u0627\u06CC\u0647 \u06F2 \u06CC\u0627 \u06F3 \u0628\u0647 \u067E\u0644\u062A\u0641\u0631\u0645 \u0628\u0633\u062A\u06AF\u06CC \u062F\u0627\u0631\u062F. MSS clamping \u0641\u0642\u0637 \u0628\u0647 TCP \u06A9\u0645\u06A9 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062C\u0627\u06CC \u0638\u0631\u0641\u06CC\u062A \u0645\u0646\u0627\u0633\u0628 MTU \u0631\u0627 \u0628\u0631\u0627\u06CC UDP \u06CC\u0627 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F."]}],analogy:"VXLAN \u0645\u062B\u0644 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0627\u062A\u0627\u0642\u200C\u0647\u0627\u06CC \u06CC\u06A9 \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u0631\u0627 \u0628\u0627 \u067E\u0627\u06A9\u062A \u067E\u0633\u062A\u06CC \u0628\u0647 \u0647\u0645 \u0648\u0635\u0644 \u06A9\u0646\u06CC: \u0641\u0631\u06CC\u0645 \u062F\u0627\u062E\u0644 \u067E\u0627\u06A9\u062A \u0645\u06CC\u200C\u0631\u0648\u062F \u0648 \u0631\u0648\u06CC \u067E\u0627\u06A9\u062A \u0622\u062F\u0631\u0633 \u067E\u0633\u062A\u06CC (IP) \u0645\u06CC\u200C\u062E\u0648\u0631\u062F. EVPN \u0647\u0645 \u0645\u062B\u0644 \u062F\u0641\u062A\u0631 \u0622\u062F\u0631\u0633 \u0645\u0631\u06A9\u0632\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u0647\u0631 \u0627\u062A\u0627\u0642 \u0627\u0632 \u06A9\u062F\u0627\u0645 \u0645\u0633\u06CC\u0631 \u067E\u0633\u062A\u06CC \u0642\u0627\u0628\u0644 \u062F\u0633\u062A\u0631\u0633\u06CC \u0627\u0633\u062A.",pitfalls:["MTU \u06A9\u0645 \u062F\u0631 Underlay: \u0628\u0633\u062A\u0647 VXLAN \u0628\u0632\u0631\u06AF\u200C\u062A\u0631 \u0627\u0632 MTU \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0628\u0632\u0631\u06AF (\u0645\u062B\u0644 iSCSI) \u06AF\u0645 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F.","\u0646\u0628\u0648\u062F Underlay \u067E\u0627\u06CC\u062F\u0627\u0631: \u062A\u0648\u0646\u0644 VXLAN \u0631\u0648\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC IP \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0627\u06AF\u0631 IGP \u062F\u0631\u0633\u062A \u0646\u0628\u0627\u0634\u062F\u060C \u0647\u0645\u0647\u200C\u0686\u06CC\u0632 \u0645\u06CC\u200C\u062E\u0648\u0627\u0628\u062F.","\u0627\u0634\u062A\u0628\u0627\u0647 \u06AF\u0631\u0641\u062A\u0646 VNI \u0628\u0627 VLAN ID: \u0627\u06CC\u0646\u200C\u0647\u0627 \u062F\u0648 \u0641\u0636\u0627\u06CC \u0646\u0627\u0645 \u0645\u0633\u062A\u0642\u0644\u200C\u0627\u0646\u062F \u0648 \u0646\u0642\u0634\u0647\u200C\u0634\u0627\u0646 \u0628\u0627\u06CC\u062F \u062F\u0631 \u0647\u0631 VTEP \u06CC\u06A9\u0633\u0627\u0646 \u0628\u0627\u0634\u062F."],exam:["VXLAN \u0631\u0648\u06CC UDP \u067E\u0648\u0631\u062A \u06F4\u06F7\u06F8\u06F9 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 VNI \u0622\u0646 \u06F2\u06F4 \u0628\u06CC\u062A\u06CC \u0627\u0633\u062A.","EVPN \u0627\u0632 AFI 25 / SAFI 70 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 Type-2 \u0628\u0631\u0627\u06CC MAC/IP \u0627\u0633\u062A.","VXLAN \u0628\u0631\u0627\u06CC \u062D\u0644 \u0645\u0634\u06A9\u0644 \u0645\u0642\u06CC\u0627\u0633 VLAN \u0648 \u062D\u0630\u0641 STP \u0637\u0631\u0627\u062D\u06CC \u0634\u062F."],glossary:[["VTEP","\u062F\u0633\u062A\u06AF\u0627\u0647\u06CC \u06A9\u0647 \u0628\u0633\u062A\u0647 \u0631\u0627 \u062F\u0631 VXLAN \u0645\u06CC\u200C\u067E\u06CC\u0686\u062F \u06CC\u0627 \u0628\u0627\u0632 \u0645\u06CC\u200C\u06A9\u0646\u062F."],["VNI","\u0634\u0646\u0627\u0633\u0647 \u0634\u0628\u06A9\u0647 \u0645\u062C\u0627\u0632\u06CC \u062F\u0631 VXLAN."],["BUM","Broadcast\u060C Unknown unicast \u0648 Multicast."],["Underlay / Overlay","\u0634\u0628\u06A9\u0647 \u0641\u06CC\u0632\u06CC\u06A9\u06CC \u0632\u06CC\u0631\u06CC\u0646 \u0648 \u0634\u0628\u06A9\u0647 \u0645\u062C\u0627\u0632\u06CC \u0631\u0648\u06CC \u0622\u0646."]]},sdwan:{prereq:["static-routing"],related:["ipsec","qos","automation"],title:"SD-WAN \u0633\u06CC\u0633\u06A9\u0648 \u2014 \u06A9\u0646\u062A\u0631\u0644 \u0645\u0631\u06A9\u0632\u06CC \u0628\u0631\u0627\u06CC \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0686\u0646\u062F\u0644\u06CC\u0646\u06A9\u0647",tagline:"SD-WAN \u0645\u062F\u06CC\u0631\u06CC\u062A WAN \u0631\u0627 \u0627\u0632 \u062A\u06A9\u200C\u062A\u06A9 \u0631\u0648\u062A\u0631\u0647\u0627 \u0628\u0647 \u06CC\u06A9 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0645\u06CC\u200C\u0622\u0648\u0631\u062F \u0648 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u06A9\u06CC\u0641\u06CC\u062A \u0644\u06CC\u0646\u06A9 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u062F.",minutes:18,goals:["\u0646\u0642\u0634 vBond\u060C vSmart \u0648 vManage \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC \u0647\u0631 \u06A9\u062F\u0627\u0645 \u0631\u0648\u06CC \u0686\u0647 \u067E\u0648\u0631\u062A \u0648 \u067E\u0631\u0648\u062A\u06A9\u0644\u06CC \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F","\u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC TLOC \u0648 OMP \u0686\u06CC\u0633\u062A \u0648 \u0686\u0631\u0627 SD-WAN \u0628\u0647 OSPF/BGP \u062F\u0631 Overlay \u0646\u06CC\u0627\u0632 \u0646\u062F\u0627\u0631\u062F","\u0628\u0641\u0647\u0645\u06CC BFD \u0648 AAR \u0686\u0637\u0648\u0631 \u0628\u0627\u0639\u062B \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0635\u0648\u062A\u06CC \u0631\u0648\u06CC \u0628\u0647\u062A\u0631\u06CC\u0646 \u0644\u06CC\u0646\u06A9 \u0628\u0631\u0648\u062F"],sections:[{h:"\u0645\u0634\u06A9\u0644\u06CC \u06A9\u0647 SD-WAN \u062D\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F",p:["\u062F\u0631 WAN \u0633\u0646\u062A\u06CC\u060C \u0647\u0631 \u0634\u0639\u0628\u0647 \u0628\u0627 \u06CC\u06A9 \u0644\u06CC\u0646\u06A9 MPLS \u0628\u0647 \u0645\u0631\u06A9\u0632 \u0648\u0635\u0644 \u0627\u0633\u062A \u0648 \u0647\u0645\u0647 \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627 \u0631\u0648\u06CC \u0631\u0648\u062A\u0631 \u0647\u0645\u0627\u0646 \u0634\u0639\u0628\u0647 \u0646\u0648\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062D\u0627\u0644\u0627 \u062A\u0635\u0648\u0631 \u06A9\u0646 \u0634\u0639\u0628\u0647\u200C\u0627\u06CC \u062F\u0648 \u0644\u06CC\u0646\u06A9 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F: MPLS \u06AF\u0631\u0627\u0646 \u0648 \u067E\u0627\u06CC\u062F\u0627\u0631\u060C WAN بانک \u0627\u0631\u0632\u0627\u0646 \u067E\u0631\u0646\u0648\u0633\u0627\u0646\u060C \u0648 LTE \u067E\u0634\u062A\u06CC\u0628\u0627\u0646. \u0628\u0627 BGP/OSPF \u0645\u0639\u0645\u0648\u0644\u06CC\u060C \u062A\u0635\u0645\u06CC\u0645 \u0645\u0633\u06CC\u0631 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0645\u062A\u0631\u06CC\u06A9 \u0627\u0633\u062A\u060C \u0646\u0647 \u06A9\u06CC\u0641\u06CC\u062A \u0644\u062D\u0638\u0647\u200C\u0627\u06CC\u061B \u0646\u062A\u06CC\u062C\u0647 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u062A\u0645\u0627\u0633 \u0635\u0648\u062A\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9\u06CC \u0628\u06CC\u0641\u062A\u062F \u06A9\u0647 \u062C\u06CC\u062A\u0631 \u0628\u0627\u0644\u0627\u06CC\u06CC \u062F\u0627\u0631\u062F.","SD-WAN \u062F\u0648 \u06A9\u0627\u0631 \u06A9\u0631\u062F: \u0645\u062F\u06CC\u0631\u06CC\u062A \u0631\u0627 \u0645\u0631\u06A9\u0632\u06CC \u06A9\u0631\u062F (\u0642\u0627\u0644\u0628\u200C\u0647\u0627 \u0627\u0632 \u06CC\u06A9 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0645\u06CC\u200C\u0622\u06CC\u062F) \u0648 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0628\u0631 \u0627\u0633\u0627\u0633 \u06A9\u06CC\u0641\u06CC\u062A \u0648\u0627\u0642\u0639\u06CC \u0647\u0631 \u0644\u06CC\u0646\u06A9 \u0627\u0646\u062A\u062E\u0627\u0628 \u06A9\u0631\u062F. \u0627\u06CC\u0646 \u062F\u0648\u0645\u06CC \u0628\u0627 \u067E\u0631\u0648\u062A\u06A9\u0644 BFD \u0645\u0645\u06A9\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u0647\u0631 \u062B\u0627\u0646\u06CC\u0647 \u062A\u0623\u062E\u06CC\u0631\u060C \u0627\u0641\u062A \u0648 \u062C\u06CC\u062A\u0631 \u0631\u0627 \u0645\u06CC\u200C\u0633\u0646\u062C\u062F."]},{h:"\u0633\u0647 \u0646\u0642\u0634 \u0648 \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u0648\u0631\u0648\u062F",p:["\u0647\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647 SD-WAN \u0627\u0648\u0644 \u0628\u0627\u06CC\u062F \xAB\u0648\u0627\u0631\u062F\xBB \u0634\u0628\u06A9\u0647 \u0634\u0648\u062F. \u0628\u0627 vBond (\u0646\u0627\u0645 \u062C\u062F\u06CC\u062F: Validator) \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u06CC\u06A9 \u0633\u0634\u0646 DTLS \u0631\u0648\u06CC UDP \u067E\u0648\u0631\u062A \u06F1\u06F2\u06F3\u06F4\u06F6 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F\u060C \u06AF\u0648\u0627\u0647\u06CC \u062E\u0648\u062F\u0634 \u0631\u0627 \u0627\u062B\u0628\u0627\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062F\u0631 \u0639\u0648\u0636 \u0622\u062F\u0631\u0633 vSmart \u0648 vManage \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. vBond \u0647\u06CC\u0686 \u0645\u0633\u06CC\u0631\u06CC \u0646\u0645\u06CC\u200C\u062F\u0647\u062F\u061B \u06A9\u0627\u0631\u0634 \u062F\u0631\u0648\u0627\u0632\u0647\u200C\u0628\u0627\u0646\u06CC \u0648 \u0645\u0639\u0631\u0641\u06CC \u0627\u0633\u062A.","\u0648\u0627\u0631\u062F \u06A9\u0647 \u0634\u062F\u060C \u0628\u0627 vSmart (Controller) \u06A9\u0627\u0646\u0627\u0644 \u06A9\u0646\u062A\u0631\u0644 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u2014 DTLS \u0631\u0648\u06CC UDP 12346+n \u06CC\u0627 TLS \u0631\u0648\u06CC TCP 23456 \u2014 \u0648 \u0631\u0648\u06CC \u0647\u0645\u06CC\u0646 \u06A9\u0627\u0646\u0627\u0644\u060C \u067E\u0631\u0648\u062A\u06A9\u0644 OMP \u0641\u0639\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F. OMP \u0645\u0633\u06CC\u0631\u0647\u0627\u060C TLOC\u0647\u0627 \u0648 \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627 \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. vManage (Manager) \u0647\u0645 \u0628\u0631\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u060C \u0642\u0627\u0644\u0628\u200C\u0647\u0627 \u0648 \u062A\u0644\u0647\u200C\u0645\u062A\u0631\u06CC \u0627\u0633\u062A. \u062A\u0648\u062C\u0647: \u062F\u0631 \u0646\u0633\u062E\u0647\u200C\u0647\u0627\u06CC \u062C\u062F\u06CC\u062F \u0633\u06CC\u0633\u06A9\u0648 \u0627\u0633\u0645\u200C\u0647\u0627 \u0639\u0648\u0636 \u0634\u062F\u0647\u200C\u0627\u0646\u062F \u0648 \u06AF\u0641\u062A\u0646 \u0647\u0631 \u062F\u0648 \u0646\u0627\u0645\u060C \u062F\u0631 \u0645\u0635\u0627\u062D\u0628\u0647 \u0648 \u0622\u0632\u0645\u0648\u0646 \u0627\u0645\u062A\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F."],list:["vBond / Validator \u2014 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0648 \u0645\u0639\u0631\u0641\u06CC (UDP 12346)","vSmart / Controller \u2014 \u067E\u062E\u0634 \u0645\u0633\u06CC\u0631 \u0648 \u0633\u06CC\u0627\u0633\u062A \u0628\u0627 OMP","vManage / Manager \u2014 \u0642\u0627\u0644\u0628\u200C\u0647\u0627\u060C \u0645\u0627\u0646\u06CC\u062A\u0648\u0631\u06CC\u0646\u06AF\u060C API","WAN Edge \u2014 \u0631\u0648\u062A\u0631\u06CC \u06A9\u0647 \u0634\u0639\u0628\u0647 \u0631\u0627 \u0648\u0635\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F"]},{h:"TLOC\u060C OMP \u0648 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u0633\u06CC\u0631",p:["\u0647\u0631 Edge \u0628\u0631\u0627\u06CC \u0647\u0631 \u062A\u0631\u06A9\u06CC\u0628 System-IP \u0648 Color \u06CC\u06A9 TLOC \u062F\u0627\u0631\u062F. Color \u06CC\u0639\u0646\u06CC \xAB\u0627\u0632 \u0686\u0647 \u0646\u0648\u0639 \u0644\u06CC\u0646\u06A9\u06CC \u0645\u06CC\u200C\u0622\u06CC\u0645\xBB: mpls\u060C biz-internet\u060C lte \u0648\u2026 . \u0648\u0642\u062A\u06CC \u0634\u0639\u0628\u0647\u200C\u0627\u06CC \u062F\u0648 \u0644\u06CC\u0646\u06A9 \u062F\u0627\u0631\u062F\u060C \u062F\u0648 TLOC \u062F\u0627\u0631\u062F \u0648 OMP \u0628\u0631\u0627\u06CC \u0647\u0631 \u0645\u0642\u0635\u062F \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u06A9\u062F\u0627\u0645 TLOC\u0647\u0627 \u0645\u0639\u062A\u0628\u0631\u0646\u062F \u0648 \u0628\u0627 \u0686\u0647 \u0627\u0648\u0644\u0648\u06CC\u062A\u06CC. Edge \u0637\u0628\u0642 \u0633\u06CC\u0627\u0633\u062A\u060C \u06CC\u06A9\u06CC \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0628\u062E\u0634 \u062C\u0630\u0627\u0628 \u0645\u0627\u062C\u0631\u0627 BFD \u0627\u0633\u062A: \u0631\u0648\u06CC \u0647\u0631 \u062A\u0648\u0646\u0644 IPsec \u06CC\u06A9 \u0633\u0634\u0646 BFD \u0647\u0633\u062A \u06A9\u0647 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0647\u0631 \u06F1\u06F0\u06F0\u06F0 \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647 hello \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F (multiplier \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u06F7 \u0631\u0648\u06CC \u0631\u0648\u062A\u0631 \u0633\u062E\u062A\u200C\u0627\u0641\u0632\u0627\u0631\u06CC). \u0627\u06CC\u0646 \u0633\u0646\u062C\u0634\u060C \u062F\u0627\u062F\u0647 \u062A\u0623\u062E\u06CC\u0631/\u0627\u0641\u062A/\u062C\u06CC\u062A\u0631 \u062A\u0648\u0644\u06CC\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 AAR (App-Aware Routing) \u0628\u0627 \u0622\u0646 \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0645\u062B\u0644\u0627\u064B \u0645\u06CC\u200C\u06AF\u0648\u06CC\u06CC \xAB\u062A\u0631\u0627\u0641\u06CC\u06A9 Teams \u0628\u0627\u06CC\u062F \u062A\u0623\u062E\u06CC\u0631 \u06A9\u0645\u062A\u0631 \u0627\u0632 \u06F1\u06F5\u06F0ms \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\xBB\u061B \u0627\u06AF\u0631 MPLS \u0627\u0632 \u0627\u06CC\u0646 \u062D\u062F \u0628\u062F\u062A\u0631 \u0634\u062F\u060C \u062E\u0648\u062F\u06A9\u0627\u0631 \u0628\u0647 \u0644\u06CC\u0646\u06A9 \u062F\u06CC\u06AF\u0631 \u0645\u06CC\u200C\u0631\u0648\u062F."],callout:{title:"\u062F\u0648 \u0646\u06A9\u062A\u0647 \u06A9\u0647 \u062F\u0631 \u0645\u0635\u0627\u062D\u0628\u0647 \u0645\u06CC\u200C\u067E\u0631\u0633\u0646\u062F",text:"\u06F1) OMP \u067E\u0648\u0631\u062A \u062C\u062F\u0627 \u0646\u062F\u0627\u0631\u062F\u061B \u0631\u0648\u06CC \u0647\u0645\u0627\u0646 \u06A9\u0627\u0646\u0627\u0644 \u06A9\u0646\u062A\u0631\u0644 \u0627\u0633\u062A. \u06F2) BFD \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u062F\u0627\u062F\u0647 (IPsec) \u0627\u0633\u062A\u060C \u0646\u0647 \u0631\u0648\u06CC \u06A9\u0627\u0646\u0627\u0644 \u06A9\u0646\u062A\u0631\u0644."}},{h:"\u0642\u0627\u0644\u0628\u200C\u0647\u0627 \u0648 \u0627\u0633\u062A\u0642\u0631\u0627\u0631",p:["\u062F\u0631 vManage \u0628\u0627 Feature Template (\u0645\u062B\u0644\u0627\u064B VPN\u060C BFD\u060C Routing) \u0648 Device Template\u060C \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u06A9\u0644 \u0634\u0639\u0628\u0647 \u0627\u0632 \u0686\u0646\u062F \u0645\u062A\u063A\u06CC\u0631 \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062F\u0633\u062A\u06AF\u0627\u0647 \u062C\u062F\u06CC\u062F \u0627\u0632 \u06A9\u0627\u0631\u062A\u0646 \u062F\u0631\u0645\u06CC\u200C\u0622\u06CC\u062F\u060C \u0628\u0627 DHCP/DNS \u06CC\u0627 PnP \u0628\u0647 vBond \u0645\u06CC\u200C\u0631\u0633\u062F\u060C \u06AF\u0648\u0627\u0647\u06CC \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 \u0628\u0642\u06CC\u0647 \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0627\u0632 \u0642\u0627\u0644\u0628 \u0645\u06CC\u200C\u0622\u06CC\u062F \u2014 \u0628\u062F\u0648\u0646 \u06A9\u0633\u06CC \u06A9\u0647 \u06A9\u0627\u0628\u0644 \u06A9\u0646\u0633\u0648\u0644 \u0628\u0632\u0646\u062F.","\u0628\u0631\u0627\u06CC \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC: show sdwan control connections (\u0648\u0636\u0639\u06CC\u062A \u06A9\u0627\u0646\u0627\u0644 \u06A9\u0646\u062A\u0631\u0644)\u060C show sdwan omp routes (\u0645\u0633\u06CC\u0631\u0647\u0627\u06CC Overlay)\u060C show sdwan bfd sessions (\u06A9\u06CC\u0641\u06CC\u062A \u0644\u06CC\u0646\u06A9) \u0648 show sdwan app-route stats (\u0622\u0645\u0627\u0631 \u0645\u0633\u06CC\u0631 \u0628\u0631\u0646\u0627\u0645\u0647). \u0627\u06AF\u0631 \u0634\u0639\u0628\u0647\u200C\u0627\u06CC \xAB\u062B\u0628\u062A \u0634\u062F\u0647 \u0648\u0644\u06CC \u0645\u0633\u06CC\u0631 \u0646\u062F\u0627\u0631\u062F\xBB\u060C \u0645\u0639\u0645\u0648\u0644\u0627\u064B Issue \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 TLOC \u06CC\u0627 Site-ID \u062A\u06A9\u0631\u0627\u0631\u06CC \u0627\u0633\u062A."]}],analogy:"SD-WAN \u0645\u062B\u0644 \u06CC\u06A9 \u0633\u0631\u0648\u06CC\u0633 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0622\u0646\u0644\u0627\u06CC\u0646 \u0627\u0633\u062A: \u0686\u0646\u062F \u0645\u0633\u06CC\u0631 \u0628\u0647 \u0645\u0642\u0635\u062F \u062F\u0627\u0631\u06CC\u060C \u0648\u0644\u06CC \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0631 \u0627\u0633\u0627\u0633 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0644\u062D\u0638\u0647\u200C\u0627\u06CC \u0648 \u06A9\u06CC\u0641\u06CC\u062A \u062C\u0627\u062F\u0647\u060C \u0633\u0631\u06CC\u0639\u200C\u062A\u0631\u06CC\u0646 \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u062F \u2014 \u0646\u0647 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0627\u06CC\u0646\u06A9\u0647 \u06A9\u062F\u0627\u0645 \u062C\u0627\u062F\u0647 \u0631\u0648\u06CC \u0646\u0642\u0634\u0647 \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631 \u0627\u0633\u062A.",pitfalls:["\u062A\u06A9\u0631\u0627\u0631 Site-ID \u0628\u06CC\u0646 \u062F\u0648 \u062F\u0633\u062A\u06AF\u0627\u0647: \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC OMP \u062F\u0631\u0633\u062A \u0634\u06