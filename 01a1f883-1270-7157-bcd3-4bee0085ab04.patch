0648\u0631 \u062A\u0633\u062A \u06A9\u0646: \u062E\u0648\u062F\u0645 \u2192 \u062F\u0631\u0648\u0627\u0632\u0647 \u2192 \u067E\u0631\u0634 \u0628\u0639\u062F\u06CC \u2192 \u0645\u0642\u0635\u062F \u2192 \u067E\u0648\u0631\u062A \u0645\u0642\u0635\u062F.","\u0634\u0645\u0627\u0631\u0646\u062F\u0647\u200C\u0647\u0627 \u0631\u0627 \u062F\u0648 \u0628\u0627\u0631 \u0628\u0627 \u0641\u0627\u0635\u0644\u0647 \u0648 \u0646\u0631\u062E \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646\u061B \u0627\u0641\u0632\u0627\u06CC\u0634 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u0633\u0631\u0646\u062E \u0627\u0633\u062A\u060C \u0646\u0647 \u0627\u062B\u0628\u0627\u062A \u0639\u0644\u062A.","`show logging` \u0648 `show processes cpu sorted` \u0631\u0627 \u062F\u0631 \u06A9\u0646\u062F\u06CC \u0648 \u0642\u0637\u0639\u06CC \u0647\u0645\u06CC\u0634\u0647 \u0628\u0628\u06CC\u0646.","\u0634\u0645\u0627\u0631\u0646\u062F\u0647 \u0642\u0648\u0627\u0646\u06CC\u0646 \u0641\u0627\u06CC\u0631\u0648\u0627\u0644\u060C \u0628\u0627\u0632\u0647 \u0627\u0646\u062F\u0627\u0632\u0647\u200C\u06AF\u06CC\u0631\u06CC \u0648 \u0642\u0648\u0627\u0646\u06CC\u0646 \u0642\u0628\u0644\u06CC \u0631\u0627 \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646\u061B \u0635\u0641\u0631 \u0628\u0648\u062F\u0646 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0686\u0646\u062F \u0639\u0644\u062A \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F.","\u062F\u0631 \u0628\u0633\u062A\u0647\u200C\u06AF\u06CC\u0631\u06CC \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u062F\u0648 \u0637\u0631\u0641 \u0631\u0627 \u0628\u06AF\u06CC\u0631\u061B \u062E\u06CC\u0644\u06CC \u0627\u0632 \u062E\u0631\u0627\u0628\u06CC\u200C\u0647\u0627 \u06CC\u06A9\u200C\u0637\u0631\u0641\u0647\u200C\u0627\u0646\u062F."],scenarios:[{q:"\u06A9\u0627\u0631\u0628\u0631 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0634\u0628\u06A9\u0647 \u0642\u0637\u0639 \u0627\u0633\u062A\xBB \u0648 \u062A\u0648 \u062F\u0631 \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u062F\u06CC\u06AF\u0631\u06CC \u0647\u0633\u062A\u06CC.",a:"\u0627\u0648\u0644 \u062F\u0627\u0645\u0646\u0647 \u0648 \u0645\u0628\u062F\u0623 \u0622\u0632\u0645\u0648\u0646 \u0631\u0627 \u0645\u0634\u062E\u0635 \u06A9\u0646. \u067E\u06CC\u0646\u06AF \u062F\u0631\u0648\u0627\u0632\u0647 \u0627\u0632 \u0645\u0627\u0646\u06CC\u062A\u0648\u0631\u06CC\u0646\u06AF \u0641\u0642\u0637 \u0645\u0633\u06CC\u0631 \u0645\u0627\u0646\u06CC\u062A\u0648\u0631\u06CC\u0646\u06AF \u062A\u0627 \u062F\u0631\u0648\u0627\u0632\u0647 \u0631\u0627 \u0645\u06CC\u200C\u0633\u0646\u062C\u062F\u061B \u0628\u0631\u0627\u06CC \u0645\u0633\u06CC\u0631 \u06A9\u0627\u0631\u0628\u0631 \u0648 \u0633\u0631\u0648\u06CC\u0633\u060C \u0634\u0648\u0627\u0647\u062F \u062C\u062F\u0627\u06AF\u0627\u0646\u0647 \u0644\u0627\u0632\u0645 \u0627\u0633\u062A."},{q:"\u0628\u0639\u062F \u0627\u0632 \u062A\u063A\u06CC\u06CC\u0631 ACL\u060C \u0646\u06CC\u0645\u06CC \u0627\u0632 \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u0646\u062F \u0648\u0627\u0631\u062F \u0634\u0648\u0646\u062F.",a:"ACL \u0631\u0627 \u0628\u0627 \u0634\u0645\u0627\u0631\u0646\u062F\u0647 (`show ip access-lists`) \u0628\u0628\u06CC\u0646: \u06A9\u062F\u0627\u0645 \u062E\u0637 hit \u0645\u06CC\u200C\u062E\u0648\u0631\u062F\u061F \u0627\u062D\u062A\u0645\u0627\u0644 \u0632\u06CC\u0627\u062F \u062A\u0631\u062A\u06CC\u0628 \u06CC\u0627 wildcard \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0633\u062A. \u0642\u0628\u0644 \u0627\u0632 \u0647\u0631 ACL\u060C \u0646\u0633\u062E\u0647 \u0642\u0628\u0644\u06CC \u0631\u0627 \u0630\u062E\u06CC\u0631\u0647 \u06A9\u0646 \u062A\u0627 \u0628\u0627\u0632\u06AF\u0634\u062A \u0633\u0631\u06CC\u0639 \u0628\u0627\u0634\u062F."},{q:"\u0634\u0628\u06A9\u0647 \u0647\u0631 \u06F2\u06F0 \u062F\u0642\u06CC\u0642\u0647 \u06CC\u06A9\u200C\u0628\u0627\u0631 \u0645\u06CC\u200C\u062E\u0648\u0627\u0628\u062F \u0648 \u062E\u0648\u062F\u0634 \u0628\u0631\u0645\u06CC\u200C\u06AF\u0631\u062F\u062F.",a:"\u0627\u0644\u06AF\u0648\u06CC \u062A\u06A9\u0631\u0627\u0631\u06CC \u06CC\u0639\u0646\u06CC \u06CC\u06A9 \u0641\u0631\u0627\u06CC\u0646\u062F: STP reconvergence\u060C ARP/ND storm\u060C DHCP renew\u060C \u06CC\u0627 \u0622\u062F\u0631\u0633 \u062A\u06A9\u0631\u0627\u0631\u06CC. `show logging` \u0648 `show spanning-tree detail` (\u062A\u063A\u06CC\u06CC\u0631\u0627\u062A topology) \u0631\u0627 \u0628\u0627 \u0633\u0627\u0639\u062A \u0645\u0642\u0627\u06CC\u0633\u0647 \u06A9\u0646."}],mistakes:[{m:"\u0634\u0631\u0648\u0639 \u0628\u0627 \u062F\u0633\u062A\u0648\u0631 \u0628\u0647\u200C\u062C\u0627\u06CC \u0633\u0624\u0627\u0644",why:"\u0628\u062F\u0648\u0646 \u062F\u0627\u0645\u0646\u0647 \u0648 \u0632\u0645\u0627\u0646\u060C \u062F\u0631 \u062C\u0646\u06AF\u0644 \u062F\u0633\u062A\u0648\u0631\u0647\u0627 \u06AF\u0645 \u0645\u06CC\u200C\u0634\u0648\u06CC.",fix:"\u067E\u0646\u062C \u0633\u0624\u0627\u0644 \u06CC\u0627 \u0634\u0634 \u0642\u062F\u0645 \u0627\u0648\u0644 \u0631\u0627 \u0627\u062C\u0631\u0627 \u06A9\u0646."},{m:"\u062A\u063A\u06CC\u06CC\u0631 \u0686\u0646\u062F \u0686\u06CC\u0632 \u0647\u0645\u0632\u0645\u0627\u0646",why:"\u0646\u0645\u06CC\u200C\u0641\u0647\u0645\u06CC \u06A9\u062F\u0627\u0645 \u0627\u062B\u0631 \u062F\u0627\u0634\u062A \u0648 \u06A9\u062F\u0627\u0645 \u062E\u0631\u0627\u0628\u06CC \u0631\u0627 \u0633\u0627\u062E\u062A.",fix:"\u06CC\u06A9 \u062A\u063A\u06CC\u06CC\u0631\u060C \u06CC\u06A9 \u062A\u0633\u062A\u060C \u06CC\u06A9 \u062B\u0628\u062A."},{m:"\u0628\u0627\u0632\u06AF\u0634\u062A \u0646\u06A9\u0631\u062F\u0646 \u0628\u0647 \u0648\u0636\u0639\u06CC\u062A \u0642\u0628\u0644",why:"\u062F\u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0648\u06CC \u0647\u0645 \u0645\u06CC\u200C\u0646\u0634\u06CC\u0646\u062F \u0648 \u067E\u0631\u0648\u0646\u062F\u0647 \u067E\u06CC\u0686\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.",fix:"\u0642\u0628\u0644 \u0627\u0632 \u062A\u063A\u06CC\u0