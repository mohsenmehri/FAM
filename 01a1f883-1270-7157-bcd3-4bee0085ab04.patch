0630\u0627\u06A9\u0631\u0647 EtherChannel (\u0628\u0627 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644\u06CC LACPDU \u0628\u0647 \u0645\u0642\u0635\u062F `01:80:C2:00:00:02`). \u062F\u0648 \u062D\u0627\u0644\u062A \u062F\u0627\u0631\u062F: `active` (\u0634\u0631\u0648\u0639\u200C\u06A9\u0646\u0646\u062F\u0647 \u0645\u0630\u0627\u06A9\u0631\u0647) \u0648 `passive` (\u067E\u0627\u0633\u062E\u200C\u062F\u0647\u0646\u062F\u0647)\u061B \u0628\u0631\u0627\u06CC \u062A\u0634\u06A9\u06CC\u0644 \u0628\u0627\u0646\u062F\u0644 \u062D\u062F\u0627\u0642\u0644 \u06CC\u06A9 \u0633\u0631 \u0628\u0627\u06CC\u062F `active` \u0628\u0627\u0634\u062F.",labs:["etherchannel"]},{term:"PAgP",full:"Port Aggregation Protocol",cat:"l2",def:"\u067E\u0631\u0648\u062A\u06A9\u0644 \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u0642\u062F\u06CC\u0645\u06CC \u0633\u06CC\u0633\u06A9\u0648 \u0628\u0631\u0627\u06CC \u0645\u0630\u0627\u06A9\u0631\u0647 EtherChannel \u0628\u0627 \u062F\u0648 \u062D\u0627\u0644\u062A `desirable` \u0648 `auto`. \u062F\u0631 \u0637\u0631\u0627\u062D\u06CC\u200C\u0647\u0627\u06CC \u0645\u062F\u0631\u0646 \u0648 \u0686\u0646\u062F\u0633\u0627\u0632\u0646\u062F\u0647 \u0647\u0645\u0648\u0627\u0631\u0647 LACP \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646 \u0622\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F.",labs:["etherchannel"]},{term:"Port Security",full:"Cisco Switchport Port Security",cat:"l2",def:"\u0642\u0627\u0628\u0644\u06CC\u062A \u0627\u0645\u0646\u06CC\u062A\u06CC \u0644\u0627\u06CC\u0647 \u06F2 \u0631\u0648\u06CC \u067E\u0648\u0631\u062A\u200C\u0647\u0627\u06CC Access \u06A9\u0647 \u062A\u0639\u062F\u0627\u062F \u0648 \u0647\u0648\u06CC\u062A \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC MAC \u0645\u062C\u0627\u0632 \u0631\u0627 \u0645\u062D\u062F\u0648\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F (\u0627\u0632 \u062C\u0645\u0644\u0647 \u06CC\u0627\u062F\u06AF\u06CC\u0631\u06CC \u062E\u0648\u062F\u06A9\u0627\u0631 \u0645\u0627\u0646\u062F\