31\u0627\u0631 \u0628\u062F\u0648\u0646 \u062F\u0633\u062A\u200C\u06A9\u0627\u0631\u06CC (Zero-Touch) \u062F\u0633\u062A\u06AF\u0627\u0647 \u062C\u062F\u06CC\u062F \u0627\u0633\u062A.","Assurance \u0627\u0632 \u062A\u0644\u0647\u200C\u0645\u062A\u0631\u06CC\u060C Syslog \u0648 \u062C\u0631\u06CC\u0627\u0646\u200C\u0647\u0627 \u0628\u0631\u0627\u06CC \u0627\u0645\u062A\u06CC\u0627\u0632 \u0633\u0644\u0627\u0645\u062A \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F."],glossary:[["Intent API","\u0631\u0627\u0628\u0637 REST \u0628\u0631\u0627\u06CC \u062E\u0648\u062F\u06A9\u0627\u0631\u0633\u0627\u0632\u06CC Catalyst Center."],["PnP","Plug and Play \u0628\u0631\u0627\u06CC \u0627\u0633\u062A\u0642\u0631\u0627\u0631 \u062E\u0648\u062F\u06A9\u0627\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647."],["SWIM","\u0645\u062F\u06CC\u0631\u06CC\u062A \u062A\u0635\u0648\u06CC\u0631 \u0646\u0631\u0645\u200C\u0627\u0641\u0632\u0627\u0631 \u0648 \u0627\u0631\u062A\u0642\u0627\u06CC \u0646\u0633\u062E\u0647."],["Compliance","\u0628\u0631\u0631\u0633\u06CC \u0647\u0645\u200C\u062E\u0648\u0627\u0646\u06CC \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0628\u0627 \u0642\u0627\u0644\u0628."]]},fhrp:{prereq:["inter-vlan","subnetting"],related:["stp-rstp","troubleshooting"],title:"HSRP\u060C VRRP \u0648 GLBP \u2014 \u06AF\u06CC\u062A\u200C\u0648\u06CC \u0647\u0645\u06CC\u0634\u0647 \u062F\u0631 \u062F\u0633\u062A\u0631\u0633",tagline:"\u0627\u06AF\u0631 \u06AF\u06CC\u062A\u200C\u0648\u06CC \u06A9\u0627\u0631\u0628\u0631 \u0628\u062E\u0648\u0627\u0628\u062F\u060C \u0647\u06CC\u0686\u200C\u06A9\u0633 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0627\u0632 \u0634\u0628\u06A9\u0647 \u0628\u06CC\u0631\u0648\u0646 \u0628\u0631\u0648\u062F\u061B FHRP \u062F\u0642\u06CC\u0642\u0627\u064B \u0647\u0645\u06CC\u0646 \u06CC\u06A9 \u0646\u0642\u0637\u0647 \u0631\u0627 \u062D\u0630\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F.",minutes:13,goals:["\u062A\u0641\u0627\u0648\u062A HSRP\u060C VRRP \u0648 GLBP \u0631\u0627 \u062F\u0631 \u06CC\u06A9 \u062C\u0645\u0644\u0647 \u0628\u06AF\u0648\u06CC\u06CC","Virtual IP \u0648 MAC \u0645\u062C\u0627\u0632\u06CC \u0631\u0627 \u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC ARP \u06A9\u0627\u0631\u0628\u0631 \u0628\u0647 \u0686\u0647 \u06A9\u0633\u06CC \u062C\u0648\u0627\u0628 \u0645\u06CC\u200C\u062F\u0647\u062F","\u0628\u0627 Priority \u0648 Preempt \u0648 Tracking \u0631\u0641\u062A\u0627\u0631 failover \u0631\u0627 \u06A9\u0646\u062A\u0631\u0644 \u06A9\u0646\u06CC"],sections:[{h:"\u0645\u0634\u06A9\u0644: \u06CC\u06A9 \u06AF\u06CC\u062A\u200C\u0648\u06CC\u060C \u06CC\u06A9 \u0646\u0642\u0637\u0647 \u062E\u0631\u0627\u0628\u06CC",p:["\u0647\u0645\u0647 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0622\u062F\u0631\u0633 \u06AF\u06CC\u062A\u200C\u0648\u06CC \u0631\u0627 \u0627\u0632 DHCP \u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F \u0648 \u0622\u0646 \u0622\u062F\u0631\u0633 \u0631\u0648\u06CC \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u0627\u0633\u062A. \u0627\u06AF\u0631 \u0622\u0646 \u0631\u0648\u062A\u0631 \u062E\u0627\u0645\u0648\u0634 \u0634\u0648\u062F\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u062A\u0627 \u062A\u063A\u06CC\u06CC\u0631 DHCP \u0628\u06CC\u200C\u06AF\u06CC\u062A\u200C\u0648\u06CC\u200C\u0627\u0646\u062F. \u0631\u0627\u0647\u200C\u062D\u0644 FHRP \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0686\u0646\u062F \u0631\u0648\u062A\u0631 \u06CC\u06A9 IP \u0645\u062C\u0627\u0632\u06CC (Virtual IP) \u0645\u0634\u062A\u0631\u06A9 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u0646\u062F \u0648 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0647\u0645\u0627\u0646 \u0631\u0627 \u06AF\u06CC\u062A\u200C\u0648\u06CC \u0628\u06AF\u0630\u0627\u0631\u0646\u062F. \u06CC\u06A9\u06CC \u0641\u0639\u0627\u0644 \u0627\u0633\u062A (Active) \u0648 \u0628\u0642\u06CC\u0647 \u0622\u0645\u0627\u062F\u0647\u200C\u0627\u0646\u062F. \u06A9\u0644\u0627\u06CC\u0646\u062A \u0647\u06CC\u0686\u200C\u0648\u0642\u062A \u0646\u0645\u06CC\u200C\u0641\u0647\u0645\u062F \u06A9\u0647 \u0631\u0648\u062A\u0631 \u0639\u0648\u0636 \u0634\u062F\u0647.","\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u06A9\u0644\u0627\u06CC\u0646\u062A \u062D\u062A\u06CC ARP \u0631\u0627 \u0647\u0645 \u0645\u062A\u0648\u062C\u0647 \u0646\u0634\u0648\u062F\u060C \u06CC\u06A9 MAC \u0645\u062C\u0627\u0632\u06CC \u0647\u0645 \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F \u06A9\u0647 \u0628\u0647 \u0622\u0646 \u0622\u062F\u0631\u0633 \u0645\u062C\u0627\u0632\u06CC \u0646\u06AF\u0627\u0634\u062A \u0645\u06CC\u200C\u0634\u0648\u062F. \u067E\u0633 \u06A9\u0627\u0631\u0628\u0631 \u0628\u0627 ARP \u0641\u0642\u0637 MAC \u0645\u062C\u0627\u0632\u06CC \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0631\u0648\u062A\u0631 \u067E\u0634\u062A \u0622\u0646 \u067E\u0646\u0647\u0627\u0646 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F."]},{h:"\u0633\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644\u060C \u0633\u0647 \u0631\u0641\u062A\u0627\u0631",p:["HSRP \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u0633\u06CC\u0633\u06A9\u0648 \u0627\u0633\u062A: \u06CC\u06A9 Active \u0648 \u06CC\u06A9 Standby\u060C \u0628\u0627 Priority \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u06F1\u06F0\u06F0 (\u0628\u0627\u0644\u0627\u062A\u0631 \u0628\u0631\u0646\u062F\u0647) \u0648 Preempt \u06A9\u0647 \u062F\u0631 \u0622\u0646 \u0631\u0648\u062A\u0631\u06CC \u06A9\u0647 \u062A\u0627\u0632\u0647 \u0628\u0627\u0644\u0627 \u0622\u0645\u062F\u0647 \u0648 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0627\u0644\u0627\u062A\u0631\u06CC \u062F\u0627\u0631\u062F\u060C \u06A9\u0646\u062A\u0631\u0644 \u0631\u0627 \u067E\u0633 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. VRRP \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0628\u0627\u0632 (RFC 5798) \u0627\u0633\u062A \u0648 \u0627\u0633\u0645\u200C\u0647\u0627\u06CC\u0634 Master \u0648 Backup \u0627\u0633\u062A\u061B \u062F\u0631 VRRP \u0622\u062F\u0631\u0633 \u0645\u062C\u0627\u0632\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0647\u0645\u0627\u0646 IP \u06CC\u06A9\u06CC \u0627\u0632 \u0631\u0648\u062A\u0631\u0647\u0627 \u0628\u0627\u0634\u062F \u06A9\u0647 \u062F\u0631 HSRP \u062A\u0648\u0635\u06CC\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","GLBP \u0627\u0632 \u0647\u0631 \u062F\u0648 \u062C\u0644\u0648\u062A\u0631 \u0645\u06CC\u200C\u0631\u0648\u062F: \u0647\u0645 \u0632\u0645\u0627\u0646 \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u0641\u0639\u0627\u0644 \u0648 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u062F\u0627\u0631\u062F\u060C \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0628\u06CC\u0646 \u0686\u0646\u062F \u0631\u0648\u062A\u0631 \u062A\u0642\u0633\u06CC\u0645 \u06A9\u0646\u062F (Load Balancing). \u0637\u0631\u06CC\u0642\u0647 \u06A9\u0627\u0631\u0634 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0628\u0631\u0627\u06CC \u06CC\u06A9 VIP \u0686\u0646\u062F MAC \u0645\u062C\u0627\u0632\u06CC \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u0648 \u0628\u0647 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 MAC\u0647\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u0645\u06CC\u200C\u062F\u0647\u062F\u061B \u0646\u062A\u06CC\u062C\u0647: \u0646\u0635\u0641 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0627\u0632 \u0631\u0648\u062A\u0631 A \u0648 \u0646\u0635\u0641 \u0627\u0632 \u0631\u0648\u062A\u0631 B \u0645\u06CC\u200C\u0631\u0648\u0646\u062F."],list:["HSRP \u2014 Active/Standby \xB7 Priority 100 \xB7 MAC \u0645\u062C\u0627\u0632\u06CC 0000.0c07.acXX","VRRP \u2014 Master/Backup \xB7 Priority 100 \xB7 \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0628\u0627\u0632","GLBP \u2014 Active/Active \u0628\u0627 \u062A\u0648\u0632\u06CC\u0639 \u0628\u0627\u0631 \u0648 \u0686\u0646\u062F MAC \u0645\u062C\u0627\u0632\u06CC"]},{h:"Preempt \u0648 Tracking",p:["\u0628\u062F\u0648\u0646 Preempt\u060C \u0627\u06AF\u0631 \u0631\u0648\u062A\u0631 \u0628\u0627 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0627\u0644\u0627\u062A\u0631 \u0628\u0639\u062F\u0627\u064B \u0628\u0648\u062A \u0634\u0648\u062F\u060C \u0647\u0645\u0686\u0646\u0627\u0646 \u062F\u0631 \u062D\u0627\u0644\u062A Standby \u0645\u06CC\u200C\u0645\u0627\u0646\u062F \u0648 \u0631\u0648\u062A\u0631 \u0636\u0639\u06CC\u0641\u200C\u062A\u0631 Active \u0645\u06CC\u200C\u0645\u0627\u0646\u062F. \u067E\u0633 \u062F\u0631 \u0637\u0631\u0627\u062D\u06CC\u060C Preempt \u0631\u0627 \u0631\u0648\u0634\u0646 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645 \u062A\u0627 \u0646\u0642\u0634\u200C\u0647\u0627 \u0647\u0645\u06CC\u0634\u0647 \u0628\u0627 \u0627\u0648\u0644\u0648\u06CC\u062A \u062A\u0639\u0631\u06CC\u0641\u200C\u0634\u062F\u0647 \u0647\u0645\u200C\u062E\u0648\u0627\u0646 \u0628\u0627\u0634\u062F.","Tracking \u0647\u0645 \u0645\u06A9\u0645\u0644 Preempt \u0627\u0633\u062A: \u0645\u06CC\u200C\u06AF\u0648\u06CC\u06CC \xAB\u0627\u06AF\u0631 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 WAN \u0645\u0646 \u062E\u0648\u0627\u0628\u06CC\u062F\u060C \u0627\u0648\u0644\u0648\u06CC\u062A \u0645\u0646 \u06F2\u06F0 \u06A9\u0645 \u0634\u0648\u062F\xBB. \u0646\u062A\u06CC\u062C\u0647 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0648\u0642\u062A\u06CC \u0644\u06CC\u0646\u06A9 \u0631\u0648\u062A\u0631 Active \u0642\u0637\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0631\u0648\u062A\u0631 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u06A9\u0647 \u0644\u06CC\u0646\u06A9 \u0633\u0627\u0644\u0645\u06CC \u062F\u0627\u0631\u062F\u060C \u06A9\u0646\u062A\u0631\u0644 VIP \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0628\u062F\u0648\u0646 Tracking\u060C \u0631\u0648\u062A\u0631 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A Active \u0628\u0645\u0627\u0646\u062F \u062F\u0631 \u062D\u0627\u0644\u06CC \u06A9\u0647 \u0647\u06CC\u0686 \u0631\u0627\u0647\u06CC \u0628\u0647 \u0628\u06CC\u0631\u0648\u0646 \u0646\u062F\u0627\u0631\u062F."],callout:{title:"\u0646\u06A9\u062A\u0647 \u0639\u0645\u0644\u06CC",text:"\u0647\u0645\u06CC\u0634\u0647 \u062A\u0631\u06A9\u06CC\u0628 Priority \u0628\u0627\u0644\u0627\u062A\u0631 + Preempt + Track \u0631\u0648\u06CC \u0631\u0648\u062A\u0631 \u0627\u0635\u0644\u06CC\u060C \u0648 Priority \u067E\u0627\u06CC\u06CC\u0646\u200C\u062A\u0631 \u0631\u0648\u06CC \u0631\u0648\u062A\u0631 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646. \u0648 \u0627\u06AF\u0631 \u0627\u0632 DHCP \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u060C VIP \u0631\u0627 \u0628\u0647\u200C\u0639\u0646\u0648\u0627\u0646 default-router \u0628\u062F\u0647\u060C \u0646\u0647 IP \u0641\u06CC\u0632\u06CC\u06A9\u06CC."}},{h:"\u0628\u0631\u0631\u0633\u06CC \u0648\u0636\u0639\u06CC\u062A",p:["\u0628\u0631\u0627\u06CC HSRP: show standby brief (\u06A9\u062F\u0627\u0645 Active\u060C \u06A9\u062F\u0627\u0645 Standby\u060C Priority \u0648 Preempt) \u0648 show standby \u0628\u0631\u0627\u06CC \u062C\u0632\u0626\u06CC\u0627\u062A \u062A\u0627\u06CC\u0645\u0631\u0647\u0627. \u0628\u0631\u0627\u06CC VRRP: show vrrp. \u0628\u0631\u0627\u06CC GLBP: show glbp. \u0646\u0634\u0627\u0646\u0647\u200C\u0647\u0627\u06CC \u0645\u0634\u06A9\u0644 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0627\u06CC\u0646\u200C\u0647\u0627 \u0647\u0633\u062A\u0646\u062F: \u0647\u0631 \u062F\u0648 \u0631\u0648\u062A\u0631 Active \u0647\u0633\u062A\u0646\u062F (\u0645\u0634\u06A9\u0644 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u06CC\u0627 VLAN)\u060C \u06CC\u0627 \u0647\u06CC\u0686\u200C\u06A9\u062F\u0627\u0645 Active \u0646\u06CC\u0633\u062A (\u062A\u0646\u0638\u06CC\u0645 \u0646\u06A9\u0631\u062F\u0646 VIP).","\u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u062F\u0627\u0631\u0627\u06CC \u0633\u0648\u0626\u06CC\u0686 \u0644\u0627\u06CC\u0647 \u06F3\u060C \u0627\u063A\u0644\u0628 \u0628\u0647\u200C\u062C\u0627\u06CC HSRP \u0627\u0632 SVI \u0628\u0627 VPC \u06CC\u0627 MLAG \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0648\u0644\u06CC \u0645\u0641\u0647\u0648\u0645 \u0647\u0645\u0627\u0646 \u0627\u0633\u062A."]}],analogy:"FHRP \u0645\u062B\u0644 \u062F\u0648 \u0645\u0646\u0634\u06CC \u0627\u0633\u062A \u06A9\u0647 \u06CC\u06A9 \u0634\u0645\u0627\u0631\u0647 \u062A\u0644\u0641\u0646 \u0645\u0634\u062A\u0631\u06A9 \u062F\u0627\u0631\u0646\u062F: \u062A\u0627 \u0648\u0642\u062A\u06CC \u06CC\u06A9\u06CC \u0647\u0633\u062A\u060C \u062A\u0645\u0627\u0633\u200C\u0647\u0627 \u062C\u0648\u0627\u0628 \u062F\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u06A9\u0633\u06CC \u0645\u062A\u0648\u062C\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u062F\u0627\u0645 \u0645\u0646\u0634\u06CC \u067E\u0634\u062A \u062A\u0644\u0641\u0646 \u0627\u0633\u062A.",pitfalls:["\u0641\u0631\u0627\u0645\u0648\u0634\u200C\u06A9\u0631\u062F\u0646 Preempt: \u0631\u0648\u062A\u0631 \u0628\u0627 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0627\u0644\u0627\u062A\u0631 \u0647\u0631\u06AF\u0632 Active \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u0646\u0628\u0648\u062F Tracking \u0631\u0648\u06CC \u0644\u06CC\u0646\u06A9 WAN: \u0631\u0648\u062A\u0631 \u0628\u062F\u0648\u0646 WAN بانک Active \u0645\u06CC\u200C\u0645\u0627\u0646\u062F \u0648 \u0634\u0628\u06A9\u0647 \u0642\u0637\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u06AF\u0631\u0648\u0647 (Group) \u0645\u062A\u0641\u0627\u0648\u062A \u062F\u0631 \u062F\u0648 \u0631\u0648\u062A\u0631: \u0647\u0631 \u062F\u0648 \u0641\u0639\u0627\u0644 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u0622\u062F\u0631\u0633 \u0645\u062C\u0627\u0632\u06CC \u062C\u0648\u0627\u0628 \u0646\u0645\u06CC\u200C\u062F\u0647\u062F."],exam:["HSRP \u0627\u062E\u062A\u0635\u0627\u0635\u06CC \u0633\u06CC\u0633\u06A9\u0648 \u0628\u0627 Active/Standby\u061B VRRP \u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u0628\u0627 Master/Backup.","Priority \u0628\u0627\u0644\u0627\u062A\u0631 \u0628\u0631\u0646\u062F\u0647 \u0627\u0633\u062A \u0648 VRRP \u062F\u0631 \u062D\u0627\u0644\u062A \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 Preempt \u062F\u0627\u0631\u062F.","GLBP \u062A\u0648\u0632\u06CC\u0639 \u0628\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C HSRP \u0648 VRRP \u0646\u0645\u06CC\u200C\u06A9\u0646\u0646\u062F."],glossary:[["VIP","\u0622\u062F\u0631\u0633 \u0645\u062C\u0627\u0632\u06CC \u0645\u0634\u062A\u0631\u06A9 \u0628\u06CC\u0646 \u0631\u0648\u062A\u0631\u0647\u0627."],["Preempt","\u0628\u0627\u0632\u067E\u0633\u200C\u06AF\u06CC\u0631\u06CC \u0646\u0642\u0634 \u0641\u0639\u0627\u0644 \u062A\u0648\u0633\u0637 \u0631\u0648\u062A\u0631 \u0628\u0627 \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0627\u0644\u0627\u062A\u0631."],["Tracking","\u06A9\u0627\u0647\u0634 \u0627\u0648\u0644\u0648\u06CC\u062A \u0647\u0646\u06AF\u0627\u0645 \u062E\u0631\u0627\u0628\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0645\u0634\u062E\u0635."],["GLBP","\u0646\u0633\u062E\u0647 \u0633\u06CC\u0633\u06A9\u0648 \u0628\u0627 \u062A\u0648\u0632\u06CC\u0639 \u0628\u0627\u0631 \u0628\u06CC\u0646 \u0631\u0648\u062A\u0631\u0647\u0627."]]},qos:{prereq:["vlan-trunk"],related:["qos-advanced","wlan","sdwan"],title:"QoS \u2014 \u0648\u0642\u062A\u06CC \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F \u06A9\u0645 \u0645\u06CC\u200C\u0622\u06CC\u062F\u060C \u0627\u0648\u0644\u0648\u06CC\u062A \u0628\u0627 \u06A9\u06CC\u0633\u062A\u061F",tagline:"QoS \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0646\u0645\u06CC\u200C\u0633\u0627\u0632\u062F\u061B \u0641\u0642\u0637 \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u062F\u0631 \u0644\u062D\u0638\u0647 \u0627\u0632\u062F\u062D\u0627\u0645\u060C \u0686\u0647 \u0686\u06CC\u0632\u06CC \u0627\u0648\u0644 \u0628\u0631\u0648\u062F \u0648 \u0686\u0647 \u0686\u06CC\u0632\u06CC \u0635\u0628\u0631 \u06A9\u0646\u062F.",minutes:14,goals:["\u062A\u0641\u0627\u0648\u062A CoS (\u0644\u0627\u06CC\u0647 \u06F2) \u0648 DSCP (\u0644\u0627\u06CC\u0647 \u06F3) \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC \u0686\u0631\u0627 EF \u0628\u0631\u0627\u06CC \u0635\u062F\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F","\u0645\u062F\u0644 MQC \u0631\u0627 \u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC: class-map\u060C policy-map \u0648 service-policy","\u062A\u0641\u0627\u0648\u062A Policing \u0648 Shaping \u0648 \u062C\u0627\u06CC \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0647\u0631 \u06A9\u062F\u0627\u0645 \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC"],sections:[{h:"\u0633\u0647 \u0633\u0624\u0627\u0644 QoS",p:["QoS \u0647\u0645\u06CC\u0634\u0647 \u0628\u0627 \u0633\u0647 \u0633\u0624\u0627\u0644 \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F: \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0686\u0637\u0648\u0631 \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u06A9\u0646\u0645\u060C \u0686\u0637\u0648\u0631 \u0639\u0644\u0627\u0645\u062A \u0628\u0632\u0646\u0645\u060C \u0648 \u062F\u0631 \u0627\u0632\u062F\u062D\u0627\u0645 \u0686\u0637\u0648\u0631 \u0631\u0641\u062A\u0627\u0631 \u06A9\u0646\u0645\u061F \u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u0628\u0627 ACL \u06CC\u0627 NBAR \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC \u0628\u0627 DSCP (\u06F6 \u0628\u06CC\u062A \u062F\u0631 \u0647\u062F\u0631 IP) \u06CC\u0627 CoS (\u06F3 \u0628\u06CC\u062A \u062F\u0631 \u062A\u06AF 802.1Q)\u060C \u0648 \u0631\u0641\u062A\u0627\u0631 \u062F\u0631 \u0627\u0632\u062F\u062D\u0627\u0645 \u0628\u0627 \u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0627\u0632\u062F\u062D\u0627\u0645.","\u0645\u0642\u0627\u062F\u06CC\u0631 \u0631\u0627\u06CC\u062C DSCP \u0631\u0627 \u0628\u0627\u06CC\u062F \u062D\u0641\u0638 \u0628\u0627\u0634\u06CC: EF \u06CC\u0627 \u06F4\u06F6 \u0628\u0631\u0627\u06CC \u0635\u062F\u0627\u060C AF41 \u0628\u0631\u0627\u06CC \u0648\u06CC\u062F\u06CC\u0648\u06A9\u0646\u0641\u0631\u0627\u0646\u0633\u060C AF11/AF21 \u0628\u0631\u0627\u06CC \u062F\u0627\u062F\u0647 \u0645\u0639\u0645\u0648\u0644\u06CC \u0648 \u06F0 \u0628\u0631\u0627\u06CC Best Effort. \u0627\u06CC\u0646\u06A9\u0647 \u06A9\u062F\u0627\u0645 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0686\u0647 \u0639\u0644\u0627\u0645\u062A\u06CC \u0628\u06AF\u06CC\u0631\u062F\u060C \xAB\u0645\u062F\u0644 \u0637\u0631\u0627\u062D\u06CC QoS\xBB \u0646\u0627\u0645 \u062F\u0627\u0631\u062F \u0648 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u062F\u0631 \u0644\u0628\u0647 \u0634\u0628\u06A9\u0647 \u062A\u0639\u06CC\u06CC\u0646 \u0645\u06CC\u200C\u0634\u0648\u062F."],list:["Voice: DSCP EF (46) \xB7 \u0635\u0641 LLQ \xB7 \u062A\u0623\u062E\u06CC\u0631 \u0648 \u062C\u06CC\u062A\u0631 \u06A9\u0645","Video: AF41 (34) \xB7 \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F \u062A\u0636\u0645\u06CC\u0646\u06CC","\u062F\u0627\u062F\u0647 \u0645\u0647\u0645: AF21/AF31 \xB7 \u0628\u0627\u0632\u06AF\u0634\u062A\u200C\u067E\u0630\u06CC\u0631","Best effort: 0 \xB7 \u0647\u0631\u0686\u06CC \u0645\u0627\u0646\u062F"]},{h:"MQC: \u0633\u0647 \u0644\u0627\u06CC\u0647",p:["\u062F\u0631 \u0633\u06CC\u0633\u06A9\u0648 QoS \u0628\u0627 \u0645\u062F\u0644 MQC \u0646\u0648\u0634\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F: class-map \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0686\u0647 \u0686\u06CC\u0632\u06CC\xBB (match dscp ef)\u060C policy-map \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \xAB\u0686\u0647 \u06A9\u0627\u0631\u06CC\xBB (priority percent 20)\u060C \u0648 service-policy \u0622\u0646 \u0631\u0627 \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0647\u0645\u06CC\u0634\u0647 \u0628\u0627 show policy-map interface \u0686\u06A9 \u06A9\u0646 \u06A9\u0647 \u0634\u0645\u0627\u0631\u0646\u062F\u0647\u200C\u0647\u0627 \u0628\u0627\u0644\u0627 \u0645\u06CC\u200C\u0631\u0648\u0646\u062F\u061B \u0627\u06AF\u0631 \u0635\u0641\u0631 \u0628\u0645\u0627\u0646\u0646\u062F\u060C \u06CC\u0627 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062A\u0637\u0628\u06CC\u0642 \u0646\u0645\u06CC\u200C\u062E\u0648\u0631\u062F \u06CC\u0627 policy \u0631\u0648\u06CC \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u0627\u0634\u062A\u0628\u0627\u0647 \u0627\u0633\u062A.","\u0627\u0628\u0632\u0627\u0631 \u0645\u0647\u0645 \u062F\u06CC\u06AF\u0631 trust \u0627\u0633\u062A: \u0627\u06AF\u0631 \u0633\u0648\u0626\u06CC\u0686 \u0644\u0628\u0647 \u0628\u0647 \u0639\u0644\u0627\u0645\u062A\u200C\u0647\u0627\u06CC \u062A\u0644\u0641\u0646 IP \u0627\u0639\u062A\u0645\u0627\u062F \u0646\u06A9\u0646\u062F\u060C DSCP \u0635\u0641\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u06A9\u0644 QoS \u0628\u06CC\u200C\u0627\u062B\u0631 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 \u062F\u0631 \u0644\u0628\u0647\u060C policy \u0628\u0631\u0627\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u062F\u0648\u0646 \u0639\u0644\u0627\u0645\u062A (re-marking) \u0648 trust \u0628\u0631\u0627\u06CC \u067E\u0648\u0631\u062A \u062A\u0644\u0641\u0646 \u062A\u0639\u0631\u06CC\u0641 \u0645\u06CC\u200C\u0634\u0648\u062F."]},{h:"\u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u0648 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0627\u0632\u062F\u062D\u0627\u0645",p:["LLQ (Low Latency Queue) \u06CC\u06A9 \u0635\u0641 \u0627\u0648\u0644\u0648\u06CC\u062A\u200C\u062F\u0627\u0631 \u0627\u0633\u062A \u06A9\u0647 \u0647\u0645\u06CC\u0634\u0647 \u0627\u0648\u0644 \u0633\u0631\u0648\u06CC\u0633 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F \u0648 \u067E\u0647\u0646\u0627\u06CC\u0634 \u0628\u0627 policing \u062F\u0627\u062E\u0644\u06CC \u0645\u062D\u062F\u0648\u062F \u0645\u06CC\u200C\u0634\u0648\u062F \u062A\u0627 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u063A\u06CC\u0631\u0645\u062C\u0627\u0632 \u06A9\u0644 \u0644\u06CC\u0646\u06A9 \u0631\u0627 \u0646\u062E\u0648\u0631\u062F. CBWFQ \u0633\u0647\u0645 \u062A\u0636\u0645\u06CC\u0646\u06CC \u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F \u0645\u06CC\u200C\u062F\u0647\u062F (\u0645\u062B\u0644\u0627\u064B \u06F3\u06F0\u066A \u0628\u0631\u0627\u06CC \u0648\u06CC\u062F\u06CC\u0648). WRED \u0628\u0627 \u062D\u0630\u0641 \u0632\u0648\u062F\u0647\u0646\u06AF\u0627\u0645 \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u06A9\u0645\u200C\u0627\u0647\u0645\u06CC\u062A\u060C \u0628\u0647 TCP \u0633\u06CC\u06AF\u0646\u0627\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F \u06A9\u0647 \u0633\u0631\u0639\u062A\u0634 \u0631\u0627 \u06A9\u0645 \u06A9\u0646\u062F\u060C \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646\u06A9\u0647 \u0635\u0641 \u06A9\u0627\u0645\u0644 \u067E\u0631 \u0634\u0648\u062F.","Tail drop (\u062D\u0630\u0641 \u0648\u0642\u062A\u06CC \u0635\u0641 \u067E\u0631 \u0634\u062F) \u0628\u062F\u062A\u0631\u06CC\u0646 \u0631\u0641\u062A\u0627\u0631 \u0627\u0633\u062A \u0686\u0648\u0646 \u0647\u0645\u0647 \u062C\u0631\u06CC\u0627\u0646\u200C\u0647\u0627 \u0647\u0645\u200C\u0632\u0645\u0627\u0646 \u06A9\u0646\u062F \u0645\u06CC\u200C\u0634\u0648\u0646\u062F\u061B WRED \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646 \u0647\u0648\u0634\u0645\u0646\u062F\u062A\u0631\u0634 \u0627\u0633\u062A."],callout:{title:"\u0642\u0627\u0639\u062F\u0647 \u0637\u0631\u0627\u062D\u06CC",text:"\u0627\u0632 \u0644\u0628\u0647 \u0628\u0647 \u0647\u0633\u062A\u0647: \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC \u062F\u0631 \u0644\u0628\u0647\u060C \u0627\u0639\u062A\u0645\u0627\u062F \u062F\u0631 \u0644\u0628\u0647\u060C \u0635\u0641\u200C\u0628\u0646\u062F\u06CC \u062F\u0631 \u0644\u06CC\u0646\u06A9\u200C\u0647\u0627\u06CC \u06A9\u0645\u200C\u067E\u0647\u0646\u0627\u06CC \u0628\u0627\u0646\u062F (WAN)\u060C \u0648 policing \u062F\u0631 \u0648\u0631\u0648\u062F\u06CC \u0627\u0632 BANK-WAN."}},{h:"Policing \u06CC\u0627 Shaping\u061F",p:["Policing \u0646\u0631\u062E \u0631\u0627 \u0645\u06CC\u200C\u0633\u0646\u062C\u062F \u0648 \u0628\u0633\u062A\u0647 \u0628\u06CC\u0634\u062A\u0631 \u0627\u0632 \u062D\u062F \u0631\u0627 \u062D\u0630\u0641 \u06CC\u0627 re-mark \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F \u0648\u0644\u06CC \u0628\u0633\u062A\u0647 \u0645\u06CC\u200C\u0631\u06CC\u0632\u062F. Shaping \u0628\u0633\u062A\u0647 \u0627\u0636\u0627\u0641\u0647 \u0631\u0627 \u0628\u0627\u0641\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F \u062A\u0627 \u0646\u0631\u062E \u0647\u0645\u0648\u0627\u0631 \u0634\u0648\u062F\u061B \u0628\u0633\u062A\u0647 \u0646\u0645\u06CC\u200C\u0631\u06CC\u0632\u062F \u0648\u0644\u06CC \u062A\u0623\u062E\u06CC\u0631 \u0627\u0636\u0627\u0641\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0642\u0627\u0639\u062F\u0647 \u0633\u0627\u062F\u0647: \u0631\u0648\u06CC \u062E\u0631\u0648\u062C\u06CC \u0628\u0647 \u0633\u0645\u062A \u0644\u06CC\u0646\u06A9 \u06A9\u0645\u200C\u0633\u0631\u0639\u062A \u0627\u0632 Shaping (\u0686\u0648\u0646 BANK-WAN \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0633\u0631\u06CC\u0639\u200C\u062A\u0631 \u0627\u0632 CIR \u062A\u062D\u0648\u06CC\u0644 \u0628\u062F\u0647\u062F) \u0648 \u0631\u0648\u06CC \u0648\u0631\u0648\u062F\u06CC \u0627\u0632 Policing \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646."]}],analogy:"QoS \u0645\u062B\u0644 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0635\u0641 \u0641\u0631\u0648\u062F\u06AF\u0627\u0647 \u0627\u0633\u062A: \u0686\u0645\u062F\u0627\u0646\u200C\u0647\u0627\u06CC \u0641\u0648\u0631\u06CC (\u0635\u062F\u0627) \u062F\u0631 \u062E\u0637 \u0633\u0631\u06CC\u0639\u060C \u0645\u0633\u0627\u0641\u0631\u0627\u0646 \u0639\u0627\u062F\u06CC \u062F\u0631 \u062E\u0637 \u0645\u0639\u0645\u0648\u0644\u06CC\u060C \u0648 \u0627\u06AF\u0631 \u0635\u0641 \u0634\u0644\u0648\u063A \u0634\u062F\u060C \u06A9\u0633\u0627\u0646\u06CC \u06A9\u0647 \u0639\u062C\u0644\u0647 \u0646\u062F\u0627\u0631\u0646\u062F \u06A9\u0645\u06CC \u0635\u0628\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u062A\u0627 \u067E\u0631\u0648\u0627\u0632 \u0627\u0632 \u062F\u0633\u062A \u0646\u0631\u0648\u062F.",pitfalls:["\u0631\u0648\u0634\u0646 \u0646\u06A9\u0631\u062F\u0646 trust \u0631\u0648\u06CC \u067E\u0648\u0631\u062A \u062A\u0644\u0641\u0646: DSCP \u0635\u0641\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 QoS \u0628\u06CC\u200C\u0627\u062B\u0631 \u0627\u0633\u062A.","\u0627\u0639\u0645\u0627\u0644 service-policy \u0631\u0648\u06CC \u062C\u0647\u062A \u0627\u0634\u062A\u0628\u0627\u0647 (\u0628\u06CC\u0634\u062A\u0631 QoS \u0631\u0648\u06CC \u062E\u0631\u0648\u062C\u06CC \u0645\u0639\u0646\u0627 \u062F\u0627\u0631\u062F).","\u062F\u0627\u062F\u0646 priority \u0628\u062F\u0648\u0646 \u0633\u0642\u0641 \u0628\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9: \u0635\u0641 \u0635\u062F\u0627 \u0628\u0642\u06CC\u0647 \u0631\u0627 \u06AF\u0631\u0633\u0646\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F."],exam:["EF = 46 \u0628\u0631\u0627\u06CC \u0635\u062F\u0627\u061B AF41 = 34 \u0628\u0631\u0627\u06CC \u0648\u06CC\u062F\u06CC\u0648.","MQC = class-map + policy-map + service-policy.","Policing \u062D\u0630\u0641/\u0639\u0644\u0627\u0645\u062A \u0645\u06CC\u200C\u0632\u0646\u062F\u060C Shaping \u0628\u0627\u0641\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F."],glossary:[["DSCP","\u06F6 \u0628\u06CC\u062A \u0639\u0644\u0627\u0645\u062A\u200C\u06AF\u0630\u0627\u0631\u06CC \u062F\u0631 \u0647\u062F\u0631 IP."],["LLQ","\u0635\u0641 \u0627\u0648\u0644\u0648\u06CC\u062A\u200C\u062F\u0627\u0631 \u0628\u0631\u0627\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062D\u0633\u0627\u0633 \u0628\u0647 \u062A\u0623\u062E\u06CC\u0631."],["WRED","\u062D\u0630\u0641 \u0632\u0648\u062F\u0647\u0646\u06AF\u0627\u0645 \u0628\u0633\u062A\u0647 \u0628\u0631\u0627\u06CC \u062C\u0644\u0648\u06AF\u06CC\u0631\u06CC \u0627\u0632 \u0627\u0632\u062F\u062D\u0627\u0645."],["NBAR","\u0634\u0646\u0627\u0633\u0627\u06CC\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0628\u0631\u0646\u0627\u0645\u0647 \u062D\u062A\u06CC \u0648\u0642\u062A\u06CC \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC\u200C\u0634\u062F\u0647 \u0627\u0633\u062A."]]},mpls:{prereq:["static-routing"],related:["sp-mpls-vpn","sp-sr","sp-isis"],title:"MPLS \u0648 VRF \u2014 \u0633\u0631\u0648\u06CC\u0633 \u0686\u0646\u062F\u0645\u0634\u062A\u0631\u06CC \u0631\u0648\u06CC \u06CC\u06A9 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A",tagline:"MPLS \u0628\u0633\u062A\u0647 \u0631\u0627 \u0628\u0627 \u0628\u0631\u0686\u0633\u0628 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F\u060C \u0646\u0647 \u0628\u0627 \u0622\u062F\u0631\u0633 IP\u061B \u0647\u0645\u06CC\u0646 \u0633\u0627\u062F\u06AF\u06CC\u060C \u0634\u0628\u06A9\u0647 \u0627\u067E\u0631\u0627\u062A\u0648\u0631 \u0631\u0627 \u0645\u0642\u06CC\u0627\u0633\u200C\u067E\u0630\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F.",minutes:15,goals:["\u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC \u0686\u0631\u0627 MPLS \u0627\u0635\u0644\u0627\u064B \u0628\u0647 \u0648\u062C\u0648\u062F \u0622\u0645\u062F \u0648 label switching \u0686\u0647 \u0645\u0632\u06CC\u062A\u06CC \u062F\u0627\u0631\u062F","\u062A\u0641\u0627\u0648\u062A VRF \u0648 VRF-lite \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC RD \u0648 RT \u0686\u0647 \u06A9\u0627\u0631\u06CC \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F","\u0645\u0633\u06CC\u0631 \u0628\u0633\u062A\u0647 \u062F\u0631 MPLS L3VPN \u0631\u0627 \u0627\u0632 CE \u062A\u0627 CE \u062F\u0646\u0628\u0627\u0644 \u06A9\u0646\u06CC"],sections:[{h:"\u0686\u0631\u0627 \u0628\u0631\u0686\u0633\u0628\u061F",p:["\u062F\u0631 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0639\u0645\u0648\u0644\u06CC\u060C \u0647\u0631 \u0631\u0648\u062A\u0631 \u0628\u0627\u06CC\u062F \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631 \u06A9\u0627\u0645\u0644 \u0631\u0627 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F \u0648 \u0628\u0631\u0627\u06CC \u0647\u0631 \u0628\u0633\u062A\u0647\u060C \u0637\u0648\u0644\u0627\u0646\u06CC\u200C\u062A\u0631\u06CC\u0646 \u062A\u0637\u0628\u06CC\u0642 \u0631\u0627 \u062D\u0633\u0627\u0628 \u06A9\u0646\u062F. \u062F\u0631 \u0634\u0628\u06A9\u0647 \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u06CC \u0628\u0627 \u0645\u06CC\u0644\u06CC\u0648\u0646\u200C\u0647\u0627 \u0645\u0633\u06CC\u0631\u060C \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0633\u0646\u06AF\u06CC\u0646 \u0627\u0633\u062A. MPLS \u0628\u0647\u200C\u062C\u0627\u06CC \u0627\u06CC\u0646\u060C \u06CC\u06A9 \u0628\u0631\u0686\u0633\u0628 \u06A9\u0648\u062A\u0627\u0647 (\u06F2\u06F0 \u0628\u06CC\u062A) \u0628\u0647 \u0628\u0633\u062A\u0647 \u0645\u06CC\u200C\u0686\u0633\u0628\u0627\u0646\u062F \u0648 \u0631\u0648\u062A\u0631\u0647\u0627\u06CC \u0645\u06CC\u0627\u0646\u06CC \u0641\u0642\u0637 \u0628\u0627 \u062C\u062F\u0648\u0644 \u0628\u0631\u0686\u0633\u0628 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F: \u0628\u0631\u0686\u0633\u0628 \u0631\u0627 \u0639\u0648\u0636 \u06A9\u0646 \u0648 \u0628\u0647 \u067E\u0648\u0631\u062A \u0628\u0639\u062F\u06CC \u0628\u0641\u0631\u0633\u062A (label swap).","\u0645\u0632\u06CC\u062A \u062F\u0648\u0645 \u0648 \u0645\u0647\u0645\u200C\u062A\u0631: \u0628\u0631\u0686\u0633\u0628 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0686\u0646\u062F \u0644\u0627\u06CC\u0647 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F (label stack). \u0627\u06CC\u0646 \u0627\u0645\u06A9\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F \u0686\u0646\u062F \u0633\u0631\u0648\u06CC\u0633 \u0631\u0648\u06CC \u06CC\u06A9 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0627\u062C\u0631\u0627 \u0634\u0648\u062F \u0648 \u0628\u0633\u062A\u0647\u060C \u0647\u0645 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0645\u0633\u06CC\u0631 \u0648 \u0647\u0645 \u0627\u0637\u0644\u0627\u0639\u0627\u062A \u0633\u0631\u0648\u06CC\u0633 (\u0645\u0634\u062A\u0631\u06CC) \u0631\u0627 \u0628\u0627 \u062E\u0648\u062F\u0634 \u062D\u0645\u0644 \u06A9\u0646\u062F. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 MPLS \u067E\u0627\u06CC\u0647 \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627\u06CC \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u06CC (L3VPN\u060C L2VPN\u060C TE) \u0627\u0633\u062A."]},{h:"VRF: \u0686\u0646\u062F \u0631\u0648\u062A\u0631 \u062F\u0631 \u06CC\u06A9 \u0631\u0648\u062A\u0631",p:["\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u06CC\u06A9 \u0627\u067E\u0631\u0627\u062A\u0648\u0631 \u0628\u0647 \u0647\u0632\u0627\u0631 \u0645\u0634\u062A\u0631\u06CC \u0633\u0631\u0648\u06CC\u0633 \u0628\u062F\u0647\u062F\u060C \u0628\u0627\u06CC\u062F \u062C\u062F\u0648\u0644\u200C\u0647\u0627\u06CC \u0645\u0633\u06CC\u0631 \u062C\u062F\u0627 \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F. VRF \u062F\u0642\u06CC\u0642\u0627\u064B \u0647\u0645\u06CC\u0646 \u0627\u0633\u062A: \u06CC\u06A9 \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u0645\u0633\u062A\u0642\u0644 \u0628\u0627 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633\u200C\u0647\u0627\u06CC \u062E\u0648\u062F\u0634. \u0628\u0627 VRF-lite \u0647\u0645 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0628\u062F\u0648\u0646 MPLS\u060C \u0641\u0642\u0637 \u0631\u0648\u06CC \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u0686\u0646\u062F \u062C\u062F\u0648\u0644 \u062C\u062F\u0627 \u062F\u0627\u0634\u062A.","\u0648\u0642\u062A\u06CC \u0686\u0646\u062F VRF \u062F\u0627\u0631\u06CC\u060C \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627\u06CC \u06CC\u06A9\u0633\u0627\u0646 (\u0645\u062B\u0644\u0627\u064B 192.168.1.0/24 \u062F\u0631 \u062F\u0648 \u0645\u0634\u062A\u0631\u06CC) \u0628\u0627\u06CC\u062F \u0627\u0632 \u0647\u0645 \u062A\u0641\u06A9\u06CC\u06A9 \u0634\u0648\u0646\u062F. \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0628\u0627 RD \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u06CC\u06A9 \u0639\u062F\u062F \u06F6\u06F4 \u0628\u06CC\u062A\u06CC \u06A9\u0647 \u0628\u0647 \u0627\u0628\u062A\u062F\u0627\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F \u0645\u06CC\u200C\u0686\u0633\u0628\u062F \u0648 \u0622\u0646 \u0631\u0627 \u06CC\u06A9\u062A\u0627 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0627\u0645\u0627 \u062A\u0635\u0645\u06CC\u0645 \xAB\u06A9\u062F\u0627\u0645 \u0645\u0633\u06CC\u0631 \u0648\u0627\u0631\u062F \u06A9\u062F\u0627\u0645 VRF \u0634\u0648\u062F\xBB \u0628\u0627 RT \u0627\u0633\u062A: \u06CC\u06A9 Community \u06A9\u0647 \u0647\u0646\u06AF\u0627\u0645 export \u0632\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0647\u0646\u06AF\u0627\u0645 import \u0645\u0642\u0627\u06CC\u0633\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0627\u0634\u062A\u0628\u0627\u0647 \u062F\u0631 RT\u060C \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u062F\u0644\u06CC\u0644 \xAB\u0645\u0633\u06CC\u0631 \u0647\u0633\u062A \u0648\u0644\u06CC \u0646\u0635\u0628 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\xBB \u0627\u0633\u062A."],callout:{title:"RD \u0648 RT \u062F\u0631 \u06CC\u06A9 \u062C\u0645\u0644\u0647",text:"RD \u06CC\u06A9\u062A\u0627\u06CC\u06CC \u0645\u06CC\u200C\u062F\u0647\u062F (\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u062C\u062F\u0648\u0644\u200C\u0647\u0627 \u0642\u0627\u0637\u06CC \u0646\u0634\u0648\u0646\u062F)\u060C RT \u0633\u06CC\u0627\u0633\u062A \u0645\u06CC\u200C\u062F\u0647\u062F (\u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u0628\u062F\u0627\u0646\u06CC \u0686\u0647 \u0686\u06CC\u0632\u06CC \u0631\u0627 \u06A9\u062C\u0627 \u0628\u0628\u0631\u06CC)."}},{h:"\u0645\u0633\u06CC\u0631 \u0628\u0633\u062A\u0647 \u062F\u0631 L3VPN",p:["CE (\u0631\u0648\u062A\u0631 \u0645\u0634\u062A\u0631\u06CC) \u0645\u0633\u06CC\u0631 \u0631\u0627 \u0628\u0627 BGP \u06CC\u0627 OSPF \u0628\u0647 PE \u0645\u06CC\u200C\u062F\u0647\u062F. PE \u0622\u0646 \u0631\u0627 \u062F\u0631 VRF \u0645\u0631\u0628\u0648\u0637\u0647 \u0645\u06CC\u200C\u06AF\u0630\u0627\u0631\u062F \u0648 \u0628\u0627 MP-BGP \u0628\u0647\u200C\u0635\u0648\u0631\u062A VPNv4 (\u0628\u0627 RD \u0648 RT) \u0628\u0647 PE \u0645\u0642\u0635\u062F \u0627\u0639\u0644\u0627\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u062F\u0631 \u0647\u0633\u062A\u0647\u060C P\u0647\u0627 \u0647\u06CC\u0686 \u0686\u06CC\u0632\u06CC \u0627\u0632 VRF \u0646\u0645\u06CC\u200C\u062F\u0627\u0646\u0646\u062F\u061B \u0641\u0642\u0637 \u0628\u0631\u0686\u0633\u0628 \u0631\u0627 swap \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F.","\u0631\u0648\u06CC \u0628\u0633\u062A\u0647 \u062F\u0648 \u0628\u0631\u0686\u0633\u0628 \u0645\u06CC\u200C\u0646\u0634\u06CC\u0646\u062F: \u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC \u06A9\u0647 \u0628\u0627 LDP \u06CC\u0627 Segment Routing \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u0633\u062A\u0647 \u0631\u0627 \u062A\u0627 PE \u0645\u0642\u0635\u062F \u0645\u06CC\u200C\u0628\u0631\u062F\u060C \u0648 \u0628\u0631\u0686\u0633\u0628 \u062F\u0627\u062E\u0644\u06CC \u06A9\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u062F\u0631 PE \u0645\u0642\u0635\u062F \u06A9\u062F\u0627\u0645 VRF \u0631\u0627 \u0646\u06AF\u0627\u0647 \u06A9\u0646\u062F. \u062F\u0631 \u0622\u062E\u0631\u06CC\u0646 P\u060C \u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC \u062D\u0630\u0641 \u0645\u06CC\u200C\u0634\u0648\u062F (PHP) \u0648 PE \u0641\u0642\u0637 \u0628\u0627 \u0628\u0631\u0686\u0633\u0628 VPN \u062A\u0635\u0645\u06CC\u0645 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F."],list:["CE \u2192 PE: BGP/OSPF \u0628\u062F\u0648\u0646 \u0628\u0631\u0686\u0633\u0628","PE \u2192 PE: MP-BGP \u0628\u0627 VPNv4 \u0648 \u0628\u0631\u0686\u0633\u0628 VPN","P \u2192 P: \u0641\u0642\u0637 LDP/SR\u060C \u0628\u062F\u0648\u0646 \u0627\u0637\u0644\u0627\u0639 \u0627\u0632 VRF","PE \u2192 CE: \u062D\u0630\u0641 \u0628\u0631\u0686\u0633\u0628 \u0648 \u062A\u062D\u0648\u06CC\u0644 \u062F\u0631 VRF \u062F\u0631\u0633\u062A"]},{h:"\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0633\u0647\u200C\u0644\u0627\u06CC\u0647",p:["\u0647\u0645\u06CC\u0634\u0647 \u0627\u0632 \u067E\u0627\u06CC\u06CC\u0646 \u0628\u0647 \u0628\u0627\u0644\u0627: \u0627\u0648\u0644 \u0622\u06CC\u0627 IGP/LDP \u062F\u0631 \u0647\u0633\u062A\u0647 \u0633\u0627\u0644\u0645 \u0627\u0633\u062A (show mpls ldp neighbor, show mpls forwarding-table)\u061F \u0628\u0639\u062F \u0622\u06CC\u0627 MP-BGP \u0628\u06CC\u0646 PE\u0647\u0627 \u0646\u0634\u0633\u062A \u062F\u0627\u0631\u062F \u0648 \u0645\u0633\u06CC\u0631 VPNv4 \u0631\u062F \u0648 \u0628\u062F\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F (show bgp vpnv4 unicast all summary)\u061F \u0648 \u0622\u062E\u0631 \u0622\u06CC\u0627 RT \u062F\u0631\u0633\u062A import/export \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0645\u0633\u06CC\u0631 \u062F\u0631 \u062C\u062F\u0648\u0644 VRF \u0646\u0635\u0628 \u0634\u062F\u0647 \u0627\u0633\u062A (show ip route vrf)\u061F","\u0627\u06AF\u0631 \u0645\u0633\u06CC\u0631 \u0631\u0648\u06CC RR \u0647\u0633\u062A \u0648\u0644\u06CC \u062F\u0631 VRF \u0646\u06CC\u0633\u062A\u060C \u062A\u0642\u0631\u06CC\u0628\u0627\u064B \u0647\u0645\u06CC\u0634\u0647 \u0645\u0634\u06A9\u0644 RT \u0627\u0633\u062A. \u0627\u06AF\u0631 \u0627\u0635\u0644\u0627\u064B \u0631\u0648\u06CC RR \u0646\u06CC\u0633\u062A\u060C \u0645\u0634\u06A9\u0644 MP-BGP \u06CC\u0627 next-hop \u0627\u0633\u062A."]}],analogy:"MPLS \u0645\u062B\u0644 \u0633\u06CC\u0633\u062A\u0645 \u0628\u0627\u0631\u0628\u0631\u06CC \u0628\u0627 \u06A9\u062F \u0631\u0647\u06AF\u06CC\u0631\u06CC \u0627\u0633\u062A: \u0631\u0627\u0646\u0646\u062F\u0647\u200C\u0647\u0627\u06CC \u0645\u06CC\u0627\u0646\u06CC \u0641\u0642\u0637 \u06A9\u062F \u0631\u0627 \u0645\u06CC\u200C\u062E\u0648\u0627\u0646\u0646\u062F \u0648 \u0628\u0633\u062A\u0647 \u0631\u0627 \u0628\u0647 \u0645\u0631\u06A9\u0632 \u0628\u0639\u062F\u06CC \u0645\u06CC\u200C\u062F\u0647\u0646\u062F\u061B \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A \u0628\u062F\u0627\u0646\u0646\u062F \u062F\u0627\u062E\u0644 \u0628\u0633\u062A\u0647 \u0686\u06CC\u0633\u062A \u06CC\u0627 \u0645\u0627\u0644 \u06A9\u062F\u0627\u0645 \u0645\u0634\u062A\u0631\u06CC \u0627\u0633\u062A. \u06A9\u062F \u0646\u0647\u0627\u06CC\u06CC (\u0628\u0631\u0686\u0633\u0628 VPN) \u0641\u0642\u0637 \u062F\u0631 \u0645\u0631\u06A9\u0632 \u0645\u0642\u0635\u062F \u0628\u0627\u0632 \u0645\u06CC\u200C\u0634\u0648\u062F.",pitfalls:["\u0646\u0627\u0647\u0645\u0627\u0647\u0646\u06AF\u06CC RT \u062F\u0631 \u062F\u0648 \u0637\u0631\u0641: \u0645\u0633\u06CC\u0631 \u062F\u0631 \u062C\u062F\u0648\u0644 VPNv4 \u0647\u0633\u062A \u0648\u0644\u06CC \u062F\u0631 VRF \u0646\u0635\u0628 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u0646\u0628\u0648\u062F send-community extended: RT \u062D\u0645\u0644 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0645\u0633\u06CC\u0631 \u0628\u06CC\u200C\u0641\u0627\u06CC\u062F\u0647 \u0627\u0633\u062A.","\u0646\u0628\u0648\u062F reachability \u0628\u0647 next-hop: \u0645\u0633\u06CC\u0631 \u062F\u0631 BGP \u0647\u0633\u062A \u0648\u0644\u06CC \u0628\u062F\u0648\u0646 next-hop \u0645\u0639\u062A\u0628\u0631 \u0646\u0635\u0628 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F."],exam:["\u0628\u0631\u0686\u0633\u0628 MPLS \u06F2\u06F0 \u0628\u06CC\u062A \u0627\u0633\u062A \u0648 \u0628\u0627\u0632\u0647 \u0645\u0639\u062A\u0628\u0631 \u06F1\u06F6 \u062A\u0627 1048575 \u0627\u0633\u062A.","RD \u06CC\u06A9\u062A\u0627\u0633\u0627\u0632\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C RT \u0633\u06CC\u0627\u0633\u062A import/export.","\u062F\u0648 \u0628\u0631\u0686\u0633\u0628: \u0628\u06CC\u0631\u0648\u0646\u06CC \u0628\u0631\u0627\u06CC Transport\u060C \u062F\u0627\u062E\u0644\u06CC \u0628\u0631\u0627\u06CC VRF."],glossary:[["PE / CE / P","\u0631\u0648\u062A\u0631 \u0644\u0628\u0647 \u0627\u067E\u0631\u0627\u062A\u0648\u0631\u060C \u0631\u0648\u062A\u0631 \u0645\u0634\u062A\u0631\u06CC \u0648 \u0631\u0648\u062A\u0631 \u0647\u0633\u062A\u0647."],["RD","\u0634\u0646\u0627\u0633\u0647 \u06CC\u06A9\u062A\u0627\u0633\u0627\u0632 \u067E\u06CC\u0634\u0648\u0646\u062F \u062F\u0631 VPNv4."],["RT","Community \u06A9\u0646\u062A\u0631\u0644\u200C\u06A9\u0646\u0646\u062F\u0647 \u0648\u0631\u0648\u062F/\u062E\u0631\u0648\u062C \u0645\u0633\u06CC\u0631 \u0628\u0647 VRF."],["PHP","\u062D\u0630\u0641 \u0628\u0631\u0686\u0633\u0628 \u0628\u06CC\u0631\u0648\u0646\u06CC \u062F\u0631 \u0622\u062E\u0631\u06CC\u0646 \u0631\u0648\u062A\u0631 \u0647\u0633\u062A\u0647."]]},dmvpn:{prereq:["static-routing"],related:["ipsec","bgp","sdwan"],title:"GRE \u0648 DMVPN \u2014 \u0647\u0627\u0628 \u0648 \u0627\u0633poke \u0628\u062F\u0648\u0646 \u062A\u0648\u0646\u0644\u200C\u0647\u0627\u06CC \u0628\u06CC\u200C\u0634\u0645\u0627\u0631",tagline:"DMVPN \u06CC\u06A9 \u062A\u0648\u0646\u0644 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F \u06A9\u0647 \u0647\u0645\u0647 \u0634\u0639\u0628 \u0631\u0627 \u0628\u0647 \u0647\u0645 \u0648\u0635\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0634\u0639\u0628\u0647\u200C\u0628\u0647\u200C\u0634\u0639\u0628\u0647 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0645\u06CC\u200C\u0631\u0648\u062F.",minutes:15,goals:["\u062A\u0648\u0636\u06CC\u062D \u0628\u062F\u0647\u06CC GRE \u0686\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0686\u0631\u0627 \u0628\u0631\u0627\u06CC multicast (\u0645\u062B\u0644 \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC) \u0644\u0627\u0632\u0645 \u0627\u0633\u062A","\u0628\u06AF\u0648\u06CC\u06CC NHRP \u0686\u0637\u0648\u0631 \u0646\u0634\u0627\u0646\u06CC \u0648\u0627\u0642\u0639\u06CC \u0647\u0631 \u0634\u0639\u0628\u0647 \u0631\u0627 \u0628\u0647 \u062A\u0648\u0646\u0644 \u062A\u0628\u062F\u06CC\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F","\u062A\u0641\u0627\u0648\u062A \u0641\u0627\u0632 \u06F1\u060C \u06F2 \u0648 \u06F3 DMVPN \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC \u0648 \u0628\u062F\u0627\u0646\u06CC \u0686\u0631\u0627 \u0641\u0627\u0632 \u06F3 \u0631\u0627\u06CC\u062C \u0634\u062F"],sections:[{h:"GRE: \u062A\u0648\u0646\u0644\u06CC \u06A9\u0647 \u0647\u0645\u0647 \u067E\u0631\u0648\u062A\u06A9\u0644\u200C\u0647\u0627 \u0631\u0627 \u062D\u0645\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F",p:["\u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062F\u0627\u062E\u0644\u06CC \u0627\u0632 WAN بانک\u060C \u06CC\u0627 \u0628\u0627\u06CC\u062F \u0622\u0646 \u0631\u0627 \u0631\u0645\u0632 \u06A9\u0631\u062F (IPsec) \u06CC\u0627 \u062F\u0631 \u06CC\u06A9 \u0628\u0633\u062A\u0647 \u062F\u06CC\u06AF\u0631 \u067E\u06CC\u0686\u06CC\u062F (GRE) \u06CC\u0627 \u0647\u0631 \u062F\u0648. GRE \u0645\u0632\u06CC\u062A \u062E\u0627\u0635\u06CC \u062F\u0627\u0631\u062F: \u0686\u0648\u0646 \u06CC\u06A9 \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0633\u0627\u062F\u0647 \u0627\u0633\u062A\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F multicast \u0631\u0627 \u0647\u0645 \u062D\u0645\u0644 \u06A9\u0646\u062F. \u06CC\u0639\u0646\u06CC \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC EIGRP \u06CC\u0627 OSPF \u0631\u0627 \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u0627\u062C\u0631\u0627 \u06A9\u0646\u06CC\u060C \u062F\u0631 \u062D\u0627\u0644\u06CC \u06A9\u0647 IPsec \u0628\u0647\u200C\u062A\u0646\u0647\u0627\u06CC\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0631\u0627 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F.","\u0639\u06CC\u0628 GRE \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u062E\u0648\u062F\u0634 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0646\u062F\u0627\u0631\u062F\u061B \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 \u062F\u0631 \u0639\u0645\u0644 GRE \u0631\u0627 \u0628\u0627 IPsec \u062A\u0631\u06A9\u06CC\u0628 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F. \u062A\u0648\u0646\u0644 GRE \u0631\u0648\u06CC \u0628\u0633\u062A\u0631 \u0648\u0627\u0642\u0639\u06CC \u0644\u0627\u0632\u0645 \u0627\u0633\u062A\u060C \u0648\u0644\u06CC \u062F\u0631 DMVPN \u06CC\u06A9 \u062A\u0648\u0646\u0644 mGRE (\u0686\u0646\u062F\u0645\u0642\u0635\u062F\u0647) \u062F\u0627\u0631\u06CC\u0645: \u06CC\u06A9 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062A\u0648\u0646\u0644 \u0628\u0627 \u0686\u0646\u062F \u0645\u0642\u0635\u062F."]},{h:"NHRP: \u062F\u0641\u062A\u0631\u0686\u0647 \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644",p:["\u062F\u0631 mGRE\u060C \u0631\u0648\u062A\u0631 \u0634\u0639\u0628\u0647 (Spoke) \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u062F\u0627\u0631\u062F (\u0645\u062B\u0644\u0627\u064B 172.16.0.2) \u06A9\u0647 \u0647\u06CC\u0686 \u0631\u0628\u0637\u06CC \u0628\u0647 \u0622\u062F\u0631\u0633 \u0627\u06CC\u0646\u062A\u0631\u0646\u062A\u0634 \u0646\u062F\u0627\u0631\u062F. \u0628\u0631\u0627\u06CC \u0627\u06CC\u0646\u06A9\u0647 \u0628\u062F\u0627\u0646\u06CC \u0627\u06CC\u0646 \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0628\u0647 \u06A9\u062F\u0627\u0645 IP \u0639\u0645\u0648\u0645\u06CC \u0645\u06CC\u200C\u0631\u0633\u062F\u060C \u0627\u0632 NHRP \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645. Spoke \u0628\u0647 \u0647\u0627\u0628 \u062B\u0628\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \xAB\u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0645\u0646\u060C \u067E\u0634\u062A \u0627\u06CC\u0646 IP \u0639\u0645\u0648\u0645\u06CC \u0627\u0633\u062A\xBB \u0648 \u0647\u0627\u0628 \u0627\u06CC\u0646 \u0631\u0627 \u062F\u0631 \u062C\u062F\u0648\u0644\u0634 \u0646\u06AF\u0647 \u0645\u06CC\u200C\u062F\u0627\u0631\u062F.","\u0648\u0642\u062A\u06CC Spoke \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u062F \u0628\u0627 Spoke \u062F\u06CC\u06AF\u0631\u06CC \u062D\u0631\u0641 \u0628\u0632\u0646\u062F\u060C \u0627\u0632 \u0647\u0627\u0628 \u0645\u06CC\u200C\u067E\u0631\u0633\u062F (NHRP Resolution Request) \u0648 \u0647\u0627\u0628 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u0627\u0648 \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F. \u062D\u0627\u0644\u0627 \u062A\u062D\u0648\u06CC\u0644 \u0628\u0633\u062A\u0647 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0628\u062F\u0648\u0646 \u0639\u0628\u0648\u0631 \u0627\u0632 \u0647\u0627\u0628."],callout:{title:"\u0645\u0634\u06A9\u0644 \u06A9\u0644\u0627\u0633\u06CC\u06A9",text:"\u0627\u06AF\u0631 \u06CC\u06A9 Spoke \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u062E\u0648\u062F\u06A9\u0627\u0631 (DHCP) \u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u06A9\u0646\u062F\u060C \u062A\u0627 \u0648\u0642\u062A\u06CC \u062F\u0648\u0628\u0627\u0631\u0647 \u062B\u0628\u062A \u0646\u06A9\u0646\u062F\u060C \u0627\u0631\u062A\u0628\u0627\u0637 \u0642\u0637\u0639 \u0627\u0633\u062A. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 keepalive \u0648 re-registration \u0645\u0647\u0645\u200C\u0627\u0646\u062F."}},{h:"\u0633\u0647 \u0641\u0627\u0632 DMVPN",p:["\u0641\u0627\u0632 \u06F1: \u0641\u0642\u0637 \u0647\u0627\u0628 \u0648 Spoke\u0647\u0627 \u0628\u0627 \u0647\u0645 \u062D\u0631\u0641 \u0645\u06CC\u200C\u0632\u0646\u0646\u062F (\u0633\u062A\u0627\u0631\u0647). \u0633\u0627\u062F\u0647 \u0648\u0644\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0634\u0639\u0628\u0647\u200C\u0628\u0647\u200C\u0634\u0639\u0628\u0647 \u0627\u0632 \u0647\u0627\u0628 \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0641\u0627\u0632 \u06F2: Spoke\u0647\u0627 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u0627 \u0647\u0645 \u062A\u0648\u0646\u0644 \u0645\u06CC\u200C\u0633\u0627\u0632\u0646\u062F (mGRE \u06A9\u0627\u0645\u0644) \u2014 \u0633\u0631\u06CC\u0639\u200C\u062A\u0631 \u0648\u0644\u06CC \u0646\u06CC\u0627\u0632 \u0628\u0647 route summarization \u062F\u0642\u06CC\u0642 \u0648 next-hop \u0627\u0635\u0644\u0627\u062D\u200C\u0634\u062F\u0647 \u062F\u0627\u0631\u062F.","\u0641\u0627\u0632 \u06F3: \u062A\u0631\u06A9\u06CC\u0628\u06CC \u0647\u0648\u0634\u0645\u0646\u062F\u061B Spoke\u0647\u0627 \u0647\u0645\u0686\u0646\u0627\u0646 \u0627\u0632 \u0647\u0627\u0628 \u0645\u0633\u06CC\u0631 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F\u060C \u0648\u0644\u06CC \u0648\u0642\u062A\u06CC \u0644\u0627\u0632\u0645 \u0634\u062F \u0628\u0627 \u06CC\u06A9 \u062A\u063A\u06CC\u06CC\u0631 \u062F\u0631 NHRP \u0648 next-hop\u060C \u0627\u0631\u062A\u0628\u0627\u0637 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u0631\u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0686\u0648\u0646 \u0628\u062F\u0648\u0646 \u0646\u06CC\u0627\u0632 \u0628\u0647 \u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC \u067E\u06CC\u0686\u06CC\u062F\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0627\u0645\u0631\u0648\u0632\u0647 \u0627\u0646\u062A\u062E\u0627\u0628 \u0631\u0627\u06CC\u062C \u0627\u0633\u062A. \u062F\u0631 \u0647\u0645\u0647 \u0641\u0627\u0632\u0647\u0627 IPsec \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 BFD/NHRP \u0647\u0645\u06AF\u0631\u0627\u06CC\u06CC \u0631\u0627 \u0633\u0631\u06CC\u0639 \u0645\u06CC\u200C\u06A9\u0646\u062F."]},{h:"\u0628\u0631\u0631\u0633\u06CC \u0648 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC",p:["show dmvpn \u0647\u0645\u0647 \u0647\u0645\u0633\u0627\u06CC\u0647\u200C\u0647\u0627 \u0631\u0627 \u0628\u0627 \u0648\u0636\u0639\u06CC\u062A (UP/IKE/NHRP) \u0648 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u0648 \u062A\u0639\u062F\u0627\u062F tunnel \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F. show ip nhrp \u0647\u0645\u0627\u0646 \u062C\u062F\u0648\u0644 \u0646\u06AF\u0627\u0634\u062A \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F. \u0627\u06AF\u0631 Spoke \u062F\u0631 \u0648\u0636\u0639\u06CC\u062A IKE \u06AF\u06CC\u0631 \u06A9\u0631\u062F\u0647\u060C \u0645\u0634\u06A9\u0644 IPsec \u0627\u0633\u062A\u061B \u0627\u06AF\u0631 NHRP \u06AF\u06CC\u0631 \u06A9\u0631\u062F\u0647\u060C \u0645\u0634\u06A9\u0644 \u062B\u0628\u062A \u06CC\u0627 \u0622\u062F\u0631\u0633 \u0647\u0627\u0628.","\u0628\u0631\u0627\u06CC \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0645\u0633\u06CC\u0631\u060C show ip route \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u0648 \u0628\u0631\u0631\u0633\u06CC MTU \u062E\u06CC\u0644\u06CC \u0645\u0647\u0645 \u0627\u0633\u062A: GRE \u0633\u0631\u0628\u0627\u0631 \u062F\u0627\u0631\u062F \u0648 \u0627\u06AF\u0631 MTU \u0631\u0627 \u062A\u0646\u0638\u06CC\u0645 \u0646\u06A9\u0646\u06CC\u060C \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0628\u0632\u0631\u06AF (\u0645\u062B\u0644 TLS) \u06AF\u0645 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F \u0648 \u0641\u0642\u0637 \u0628\u0639\u0636\u06CC \u0633\u0627\u06CC\u062A\u200C\u0647\u0627 \u0628\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F."]}],analogy:"DMVPN \u0645\u062B\u0644 \u06CC\u06A9 \u06AF\u0631\u0648\u0647 \u0648\u0627\u062A\u0633\u200C\u0627\u067E \u0628\u0631\u0627\u06CC \u0634\u0639\u0628 \u0627\u0633\u062A: \u0627\u0648\u0644 \u0647\u0645\u0647 \u0634\u0645\u0627\u0631\u0647 (\u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644) \u062E\u0648\u062F\u0634\u0627\u0646 \u0631\u0627 \u0628\u0647 \u0645\u062F\u06CC\u0631 \u06AF\u0631\u0648\u0647 (\u0647\u0627\u0628) \u0645\u06CC\u200C\u062F\u0647\u0646\u062F. \u0628\u0639\u062F \u0647\u0631 \u06A9\u0633 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u0627 \u062F\u06CC\u06AF\u0631\u06CC \u062A\u0645\u0627\u0633 \u0628\u06AF\u06CC\u0631\u062F\u060C \u0628\u062F\u0648\u0646 \u0627\u06CC\u0646\u06A9\u0647 \u0645\u062F\u06CC\u0631 \u06AF\u0631\u0648\u0647 \u062A\u0645\u0627\u0633 \u0631\u0627 \u0645\u0646\u062A\u0642\u0644 \u06A9\u0646\u062F.",pitfalls:["\u062A\u0646\u0638\u06CC\u0645 \u0646\u06A9\u0631\u062F\u0646 MTU/MSS \u0631\u0648\u06CC \u062A\u0648\u0646\u0644: \u0633\u0627\u06CC\u062A\u200C\u0647\u0627\u06CC HTTPS \u0628\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F.","\u0646\u0628\u0648\u062F \u0645\u0633\u06CC\u0631 \u0628\u0647 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC Spoke: NHRP \u062B\u0628\u062A \u0645\u06CC\u200C\u0634\u0648\u062F \u0648\u0644\u06CC \u062A\u0648\u0646\u0644 \u0628\u0631\u0642\u0631\u0627\u0631 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC \u0646\u0627\u062F\u0631\u0633\u062A \u062F\u0631 \u0641\u0627\u0632 \u06F2: Spoke\u0647\u0627 \u0645\u0633\u06CC\u0631 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0646\u0645\u06CC\u200C\u0633\u0627\u0632\u0646\u062F \u0648 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0627\u0632 \u0647\u0627\u0628 \u0645\u06CC\u200C\u0631\u0648\u062F."],exam:["GRE \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0634\u0645\u0627\u0631\u0647 \u06F4\u06F7 \u0627\u0633\u062A \u0648 multicast \u0631\u0627 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F.","NHRP \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0631\u0627 \u0628\u0647 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC \u0646\u06AF\u0627\u0634\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062E\u0648\u062F\u0634 \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0634\u0645\u0627\u0631\u0647 \u06F5\u06F4 \u0627\u0633\u062A.","DMVPN \u0641\u0627\u0632 \u06F3 \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u0637\u0631\u0627\u062D\u06CC \u0627\u0645\u0631\u0648\u0632 \u0627\u0633\u062A."],glossary:[["mGRE","\u062A\u0648\u0646\u0644 GRE \u0686\u0646\u062F\u0645\u0642\u0635\u062F\u0647."],["NHRP","\u067E\u0631\u0648\u062A\u06A9\u0644 \u0646\u06AF\u0627\u0634\u062A \u0622\u062F\u0631\u0633 \u062A\u0648\u0646\u0644 \u0628\u0647 \u0622\u062F\u0631\u0633 \u0639\u0645\u0648\u0645\u06CC."],["Spoke / Hub","\u0631\u0648\u062A\u0631 \u0634\u0639\u0628\u0647 \u0648 \u0631\u0648\u062A\u0631 \u0645\u0631\u06A9\u0632\u06CC."],["Phase 3","\u0645\u062F\u0644 DMVPN \u0628\u0627 \u0645\u0633\u06CC\u0631 \u0627\u0632 \u0647\u0627\u0628 \u0648 \u062A\u0648\u0646\u0644 \u0645\u0633\u062A\u0642\u06CC\u0645 \u0628\u06CC\u0646 \u0634\u0639\u0628."]]},ipsec:{prereq:["static-routing"],related:["dmvpn","sdwan","troubleshooting"],title:"IPsec \u0648 IKEv2 \u2014 \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0648\u0627\u0642\u0639\u06CC \u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u0627\u0632 WAN بانک",tagline:"IPsec \u0633\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0637\u0631\u0641\u06CC\u0646\u060C \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u062F\u0627\u062F\u0647 \u0648 \u062A\u0636\u0645\u06CC\u0646 \u0639\u062F\u0645\u200C\u062A\u063A\u06CC\u06CC\u0631\u061B IKEv2 \u0641\u0642\u0637 \u0645\u0630\u0627\u06A9\u0631\u0647 \u06A9\u0644\u06CC\u062F\u0647\u0627\u0633\u062A.",minutes:16,goals:["\u062F\u0648 \u0641\u0627\u0632 IPsec \u0631\u0627 \u0627\u0632 \u0647\u0645 \u062A\u0641\u06A9\u06CC\u06A9 \u06A9\u0646\u06CC: IKE (\u06A9\u0646\u062A\u0631\u0644) \u0648 ESP (\u062F\u0627\u062F\u0647)","\u0628\u06AF\u0648\u06CC\u06CC ESP \u0648 AH \u0686\u0647 \u062A\u0641\u0627\u0648\u062A\u06CC \u062F\u0627\u0631\u0646\u062F \u0648 \u0686\u0631\u0627 AH \u06A9\u0645\u062A\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F","\u06CC\u06A9 \u062A\u0648\u0646\u0644 \u0633\u0627\u06CC\u062A\u200C\u0628\u0647\u200C\u0633\u0627\u06CC\u062A \u0631\u0627 \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0648 \u0628\u0627 show crypto ikev2 sa \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u06A9\u0646\u06CC"],sections:[{h:"\u0686\u0631\u0627 IPsec \u0628\u0647 IKE \u0646\u06CC\u0627\u0632 \u062F\u0627\u0631\u062F\u061F",p:["\u0628\u0631\u0627\u06CC \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC\u060C \u062F\u0648 \u0637\u0631\u0641 \u0628\u0627\u06CC\u062F \u0631\u0648\u06CC \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645\u060C \u06A9\u0644\u06CC\u062F \u0648 \u0645\u062F\u062A \u0627\u0639\u062A\u0628\u0627\u0631 \u062A\u0648\u0627\u0641\u0642 \u06A9\u0646\u0646\u062F. \u0627\u0646\u062C\u0627\u0645 \u0627\u06CC\u0646 \u062A\u0648\u0627\u0641\u0642 \u062F\u0631 \u0645\u062A\u0646 \u0631\u0648\u0634\u0646 \u062E\u0637\u0631\u0646\u0627\u06A9 \u0627\u0633\u062A\u060C \u067E\u0633 \u06CC\u06A9 \u06A9\u0627\u0646\u0627\u0644 \u0627\u0645\u0646 \u06A9\u0646\u062A\u0631\u0644\u06CC \u0644\u0627\u0632\u0645 \u0627\u0633\u062A: IKE. IKEv2 \u062F\u0631 \u062F\u0648 \u0645\u0631\u062D\u0644\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F: IKE_SA_INIT (\u062A\u0628\u0627\u062F\u0644 \u067E\u06CC\u0634\u0646\u0647\u0627\u062F\u0647\u0627 \u0648 Diffie-Hellman) \u0648 IKE_AUTH (\u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0628\u0627 \u06AF\u0648\u0627\u0647\u06CC \u06CC\u0627 PSK \u0648 \u0633\u0627\u062E\u062A \u0627\u0648\u0644\u06CC\u0646 Child SA).","\u0628\u0639\u062F \u0627\u0632 \u0622\u0646\u060C \u062F\u0627\u062F\u0647 \u0628\u0627 ESP \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u0634\u0648\u062F. \u067E\u0633 \u06CC\u06A9 \u0642\u0627\u0639\u062F\u0647 \u0630\u0647\u0646\u06CC: \u0627\u06AF\u0631 \u062A\u0648\u0646\u0644 \u0628\u0627\u0644\u0627 \u0646\u0645\u06CC\u200C\u0622\u06CC\u062F\u060C \u0627\u0648\u0644 IKE \u0631\u0627 \u0686\u06A9 \u06A9\u0646 (\u0646\u0647 ESP \u0631\u0627). \u062F\u0633\u062A\u0648\u0631 show crypto ikev2 sa \u0648\u0636\u0639\u06CC\u062A \u0648 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645\u200C\u0647\u0627 \u0631\u0627 \u0646\u0634\u0627\u0646 \u0645\u06CC\u200C\u062F\u0647\u062F."]},{h:"ESP \u06CC\u0627 AH\u061F",p:["ESP \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC \u0648 \u062A\u0645\u0627\u0645\u06CC\u062A/\u0627\u062D\u0631\u0627\u0632 \u0627\u0635\u0627\u0644\u062A \u0631\u0627 \u0628\u0627 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645 \u0648 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0645\u0646\u0627\u0633\u0628 \u0641\u0631\u0627\u0647\u0645 \u06A9\u0646\u062F\u061B \u0647\u0631 \u0642\u0627\u0628\u0644\u06CC\u062A \u0631\u0627 \u0646\u0628\u0627\u06CC\u062F \u0628\u062F\u0648\u0646 \u0628\u0631\u0631\u0633\u06CC \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0645\u0641\u0631\u0648\u0636 \u06AF\u0631\u0641\u062A. AH \u062A\u0645\u0627\u0645\u06CC\u062A \u0648 \u0627\u062D\u0631\u0627\u0632 \u0627\u0635\u0627\u0644\u062A \u0645\u06CC\u200C\u062F\u0647\u062F \u0627\u0645\u0627 \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC \u0646\u0645\u06CC\u200C\u062F\u0647\u062F\u061B AH \u0628\u062E\u0634\u200C\u0647\u0627\u06CC \u062A\u063A\u06CC\u06CC\u0631\u0646\u0627\u067E\u0630\u06CC\u0631 \u0633\u0631\u0622\u06CC\u0646\u062F IP \u0631\u0627 \u0646\u06CC\u0632 \u067E\u0648\u0634\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F\u060C \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646 \u062A\u063A\u06CC\u06CC\u0631 \u0622\u062F\u0631\u0633 \u062A\u0648\u0633\u0637 NAT \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0628\u0631\u0631\u0633\u06CC \u0631\u0627 \u0646\u0627\u0645\u0648\u0641\u0642 \u0645\u06CC\u200C\u06A9\u0646\u062F. \u0628\u0647 \u0647\u0645\u06CC\u0646 \u062F\u0644\u06CC\u0644 AH \u06A9\u0645 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0633\u062A.","\u062D\u0627\u0644\u062A\u200C\u0647\u0627\u06CC \u0627\u0646\u062A\u0642\u0627\u0644 (transport) \u0648 \u062A\u0648\u0646\u0644 (tunnel) \u0647\u0645 \u0645\u0647\u0645\u200C\u0627\u0646\u062F: \u062F\u0631 \u062A\u0648\u0646\u0644\u060C \u06A9\u0644 \u0628\u0633\u062A\u0647 \u0627\u0635\u0644\u06CC \u062F\u0627\u062E\u0644 \u06CC\u06A9 \u0628\u0633\u062A\u0647 \u062C\u062F\u06CC\u062F \u067E\u06CC\u0686\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F (\u0628\u0631\u0627\u06CC \u0633\u0627\u06CC\u062A\u200C\u0628\u0647\u200C\u0633\u0627\u06CC\u062A)\u060C \u062F\u0631 \u0627\u0646\u062A\u0642\u0627\u0644 \u0641\u0642\u0637 payload \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u0634\u0648\u062F (\u0628\u0631\u0627\u06CC \u0627\u0631\u062A\u0628\u0627\u0637 \u0645\u06CC\u0632\u0628\u0627\u0646\u200C\u0628\u0647\u200C\u0645\u06CC\u0632\u0628\u0627\u0646)."],list:["IKEv1: \u062F\u0648 \u0641\u0627\u0632\u060C \u067E\u06CC\u0686\u06CC\u062F\u0647\u200C\u062A\u0631\u060C \u0642\u062F\u06CC\u0645\u06CC","IKEv2: \u0633\u0631\u06CC\u0639\u200C\u062A\u0631\u060C \u067E\u0634\u062A\u06CC\u0628\u0627\u0646\u06CC \u0628\u0647\u062A\u0631 \u0627\u0632 \u0645\u0648\u0628\u0627\u06CC\u0644 \u0648 MOBIKE","ESP: \u0645\u062D\u0631\u0645\u0627\u0646\u06AF\u06CC + \u0627\u062D\u0631\u0627\u0632 \xB7 AH: \u0641\u0642\u0637 \u0627\u062D\u0631\u0627\u0632","NAT-T: UDP 4500 \u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u0627\u0632 NAT"]},{h:"\u0645\u062F\u0644\u200C\u0647\u0627\u06CC \u0627\u0633\u062A\u0642\u0631\u0627\u0631",p:["\u0633\u0627\u06CC\u062A\u200C\u0628\u0647\u200C\u0633\u0627\u06CC\u062A (LAN-to-LAN): \u062F\u0648 \u0631\u0648\u062A\u0631 \u0628\u0627 \u0644\u06CC\u0633\u062A \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u062F\u0627\u062E\u0644\u06CC\u060C \u0628\u0633\u062A\u0647\u200C\u0647\u0627\u06CC \u0628\u06CC\u0646 \u062F\u0648 \u0634\u0628\u06A9\u0647 \u0627\u0632 \u062A\u0648\u0646\u0644 \u0645\u06CC\u200C\u0631\u0648\u0646\u062F. \u06AF\u0632\u06CC\u0646\u0647 \u062F\u06CC\u06AF\u0631\u060C \u062A\u0648\u0646\u0644 \u0645\u0628\u062A\u0646\u06CC \u0628\u0631 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 (VTI) \u0627\u0633\u062A \u06A9\u0647 \u0631\u0641\u062A\u0627\u0631 \u0633\u0627\u062F\u0647\u200C\u062A\u0631\u06CC \u062F\u0627\u0631\u062F \u0648 \u0628\u0631\u0627\u06CC \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u062F\u06CC\u0646\u0627\u0645\u06CC\u06A9 \u0631\u0648\u06CC \u062A\u0648\u0646\u0644 \u0628\u0647\u062A\u0631 \u0627\u0633\u062A.","\u062F\u0633\u062A\u0631\u0633\u06CC \u0631\u0627\u0647 \u062F\u0648\u0631 (Remote Access): \u06A9\u0627\u0631\u0628\u0631 \u0628\u0627 AnyConnect/Client \u0627\u0632 \u0647\u0631 \u062C\u0627 \u0648\u0635\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F. \u0648 \u0628\u0631\u0627\u06CC \u0634\u0639\u0628\u0647\u200C\u0647\u0627\u06CC \u0632\u06CC\u0627\u062F\u060C IPsec over DMVPN \u06CC\u0627 SD-WAN \u06A9\u0627\u0645\u0644\u0627\u064B \u0627\u06CC\u0646 \u06A9\u0627\u0631 \u0631\u0627 \u062E\u0648\u062F\u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F."]},{h:"\u0645\u0634\u06A9\u0644\u0627\u062A \u0631\u0627\u06CC\u062C",p:["\u0646\u0634\u0627\u0646\u0647\u200C\u0647\u0627\u06CC \u0645\u0634\u06A9\u0644: \u062A\u0648\u0646\u0644 Phase 1 \u0628\u0627\u0644\u0627 \u0645\u06CC\u200C\u0622\u06CC\u062F \u0648\u0644\u06CC Phase 2 \u0646\u0647 (\u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0639\u062F\u0645 \u062A\u0637\u0627\u0628\u0642 ACL/\u062A\u0631\u0627\u0641\u06CC\u06A9 \u062C\u0627\u0644\u0628 \u06CC\u0627 proxy-identity)\u061B \u062A\u0648\u0646\u0644 \u0628\u0627\u0644\u0627 \u0627\u0633\u062A \u0648\u0644\u06CC \u067E\u06CC\u0646\u06AF \u0631\u062F \u0646\u0645\u06CC\u200C\u0634\u0648\u062F (\u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC \u06CC\u0627 ACL \u06CC\u0627 NAT)\u061B \u0628\u0639\u0636\u06CC \u0633\u0627\u06CC\u062A\u200C\u0647\u0627 \u0628\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F (MTU/MSS).","\u0628\u0631\u0627\u06CC \u062A\u0633\u062A: show crypto ikev2 sa\u060C show crypto ipsec sa\u060C \u0648 debug crypto ikev2 packet. \u0648 \u0647\u0645\u06CC\u0634\u0647 \u06CC\u0627\u062F\u062A \u0628\u0627\u0634\u062F \u06A9\u0647 \u0627\u06AF\u0631 NAT \u0631\u0648\u06CC \u0645\u0633\u06CC\u0631 \u0628\u0627\u0634\u062F\u060C \u0628\u0627\u06CC\u062F NAT-T \u0648 \u0634\u0646\u0627\u0633\u0647\u200C\u0647\u0627\u06CC \u062F\u0631\u0633\u062A \u062A\u0646\u0638\u06CC\u0645 \u0634\u0648\u062F\u060C \u0648\u06AF\u0631\u0646\u0647 \u062A\u0648\u0646\u0644 \u0628\u0647\u200C\u0638\u0627\u0647\u0631 \u0628\u0627\u0644\u0627 \u0646\u0645\u06CC\u200C\u0622\u06CC\u062F."]}],analogy:"IPsec \u0645\u062B\u0644 \u06CC\u06A9 \u067E\u06CC\u06A9 \u0627\u0645\u0646 \u0627\u0633\u062A: \u0627\u0648\u0644 \u067E\u06CC\u06A9 \u0648 \u0646\u06AF\u0647\u0628\u0627\u0646 \u0628\u0627 \u06CC\u06A9 \u062F\u0633\u062A\u200C\u062F\u0627\u062F\u0646 \u0631\u0645\u0632\u06CC \u0647\u0648\u06CC\u062A \u0647\u0645 \u0631\u0627 \u062A\u0623\u06CC\u06CC\u062F \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F (IKE)\u060C \u0628\u0639\u062F \u0628\u0633\u062A\u0647\u200C\u0647\u0627 \u062F\u0631 \u062C\u0639\u0628\u0647 \u0642\u0641\u0644\u200C\u062F\u0627\u0631 \u0628\u0627 \u0645\u0647\u0631 \u0648 \u0645\u0648\u0645 \u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F (ESP). \u0627\u06AF\u0631 \u0645\u0647\u0631 \u0634\u06A9\u0633\u062A\u0647 \u0634\u0648\u062F\u060C \u06AF\u06CC\u0631\u0646\u062F\u0647 \u0645\u06CC\u200C\u0641\u0647\u0645\u062F.",pitfalls:["\u0639\u062F\u0645 \u062A\u0637\u0627\u0628\u0642 \u067E\u06CC\u0634\u0646\u0647\u0627\u062F\u0647\u0627 (encryption/hash/DH): IKE \u0627\u0635\u0644\u0627\u064B \u0628\u0627\u0644\u0627 \u0646\u0645\u06CC\u200C\u0622\u06CC\u062F.","ACL \u062A\u0631\u0627\u0641\u06CC\u06A9 \u062C\u0627\u0644\u0628 \u0646\u0627\u0645\u062A\u0642\u0627\u0631\u0646: \u06CC\u06A9 \u0637\u0631\u0641 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F \u0648 \u0637\u0631\u0641 \u062F\u06CC\u06AF\u0631 \u0646\u0647.","\u0641\u0631\u0627\u0645\u0648\u0634\u200C\u06A9\u0631\u062F\u0646 MSS clamping: \u0633\u0627\u06CC\u062A\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0628\u0633\u062A\u0647 \u0628\u0632\u0631\u06AF \u062F\u0627\u0631\u0646\u062F \u0628\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F."],exam:["IKE \u0631\u0648\u06CC UDP 500\u060C NAT-T \u0631\u0648\u06CC UDP 4500\u060C ESP \u067E\u0631\u0648\u062A\u06A9\u0644 IP \u0634\u0645\u0627\u0631\u0647 \u06F5\u06F0\u060C AH \u0634\u0645\u0627\u0631\u0647 \u06F5\u06F1.","AH \u0631\u0645\u0632\u0646\u06AF\u0627\u0631\u06CC \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F\u061B ESP \u0647\u0645 \u0631\u0645\u0632 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0647\u0645 \u0627\u062D\u0631\u0627\u0632.","IKEv2 \u0628\u0627 IKE_SA_INIT \u0648 IKE_AUTH \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F."],glossary:[["SA","\u0627\u062A\u062D\u0627\u062F \u0627\u0645\u0646\u06CC\u062A\u06CC\u061B \u067E\u0627\u0631\u0627\u0645\u062A\u0631\u0647\u0627\u06CC \u062A\u0648\u0627\u0641\u0642\u200C\u0634\u062F\u0647 \u06CC\u06A9 \u062C\u0647\u062A."],["PSK","\u06A9\u0644\u06CC\u062F \u0645\u0634\u062A\u0631\u06A9 \u0627\u0632 \u067E\u06CC\u0634 \u062A\u0639\u06CC\u06CC\u0646\u200C\u0634\u062F\u0647 \u0628\u0631\u0627\u06CC \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A."],["VTI","\u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 \u062A\u0648\u0646\u0644 \u0645\u062C\u0627\u0632\u06CC \u0628\u0631\u0627\u06CC IPsec."],["MSS clamping","\u06A9\u0627\u0647\u0634 \u0627\u0646\u062F\u0627\u0632\u0647 \u0628\u0633\u062A\u0647 TCP \u0628\u0631\u0627\u06CC \u0639\u0628\u0648\u0631 \u0627\u0632 \u062A\u0648\u0646\u0644."]]},wlan:{prereq:["vlan-trunk"],related:["wifi6e","qos","sda"],title:"WLAN \u0648 WPA3 \u2014 \u0627\u0632 CAPWAP \u062A\u0627 \u0627\u062A\u0635\u0627\u0644 \u0627\u0645\u0646",tagline:"\u062F\u0631 \u0637\u0631\u0627\u062D\u06CC \u0645\u062A\u0645\u0631\u06A9\u0632 \u0633\u0627\u0632\u0645\u0627\u0646\u06CC\u060C AP \u0648 \u06A9\u0646\u062A\u0631\u0644\u0631 \u0648 \u0633\u0631\u0648\u06CC\u0633 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0646\u0642\u0634 \u062F\u0627\u0631\u0646\u062F\u061B \u0645\u0639\u0645\u0627\u0631\u06CC \u0645\u0633\u062A\u0642\u0644 \u06CC\u0627 \u062D\u0627\u0644\u062A\u200C\u0647\u0627\u06CC \u062F\u06CC\u06AF\u0631 \u0647\u0645 \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u0646\u062F.",minutes:16,goals:["\u0628\u06AF\u0648\u06CC\u06CC CAPWAP \u0686\u06CC\u0633\u062A \u0648 \u0686\u0631\u0627 AP \u0628\u062F\u0648\u0646 \u06A9\u0646\u062A\u0631\u0644\u0631 \u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F","\u0645\u0633\u06CC\u0631 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A 802.1X \u0628\u0627 RADIUS \u0631\u0627 \u0642\u062F\u0645\u200C\u0628\u0647\u200C\u0642\u062F\u0645 \u062F\u0646\u0628\u0627\u0644 \u06A9\u0646\u06CC","\u062A\u0641\u0627\u0648\u062A WPA2\u060C WPA3-Personal \u0648 WPA3-Enterprise \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC"],sections:[{h:"\u0645\u0639\u0645\u0627\u0631\u06CC: AP\u060C WLC\u060C ISE",p:["\u062F\u0631 \u0648\u0627\u06CC\u200C\u0641\u0627\u06CC \u0633\u0627\u0632\u0645\u0627\u0646\u06CC\u060C AP \u0641\u0642\u0637 \u0631\u0627\u062F\u06CC\u0648 \u0627\u0633\u062A. \u06A9\u0646\u062A\u0631\u0644\u0631 (WLC) \u062A\u0646\u0638\u06CC\u0645\u0627\u062A\u060C \u0631\u0648\u0645\u06CC\u0646\u06AF \u0648 \u0627\u0645\u0646\u06CC\u062A \u0631\u0627 \u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0628\u06CC\u0646 AP \u0648 WLC \u06CC\u06A9 \u062A\u0648\u0646\u0644 \u06A9\u0646\u062A\u0631\u0644\u06CC \u0628\u0647 \u0646\u0627\u0645 CAPWAP \u0628\u0631\u0642\u0631\u0627\u0631 \u0645\u06CC\u200C\u0634\u0648\u062F (\u06A9\u0646\u062A\u0631\u0644 \u0631\u0648\u06CC UDP 5246\u060C \u062F\u0627\u062F\u0647 \u0631\u0648\u06CC 5247). \u0627\u06AF\u0631 AP \u0646\u062A\u0648\u0627\u0646\u062F \u0628\u0647 WLC \u0628\u0631\u0633\u062F\u060C \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0633\u0631\u0648\u06CC\u0633 \u0646\u0645\u06CC\u200C\u062F\u0647\u062F (\u0645\u06AF\u0631 \u062F\u0631 \u062D\u0627\u0644\u062A FlexConnect \u06A9\u0647 \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u0645\u062D\u0644\u06CC \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F).","\u06A9\u0644\u0627\u06CC\u0646\u062A SSID \u0631\u0627 \u0645\u06CC\u200C\u0628\u06CC\u0646\u062F\u060C \u0628\u0647 AP \u0648\u0635\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u0639\u062F \u0646\u0648\u0628\u062A \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0627\u0633\u062A. \u062F\u0631 \u0634\u0628\u06A9\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06CC\u060C \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0628\u0627 802.1X \u0648 RADIUS (\u0627\u06CC\u0646\u062C\u0627 ISE) \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u06A9\u0644\u0627\u06CC\u0646\u062A \u0648 \u0633\u0631\u0648\u0631 \u0628\u0627 EAP \u06AF\u0641\u062A\u06AF\u0648 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F \u0648 AP \u0641\u0642\u0637 \u067E\u06CC\u0627\u0645\u200C\u0647\u0627 \u0631\u0627 \u0639\u0628\u0648\u0631 \u0645\u06CC\u200C\u062F\u0647\u062F."],list:["CAPWAP: \u062A\u0648\u0646\u0644 \u0628\u06CC\u0646 AP \u0648 WLC (\u06A9\u0646\u062A\u0631\u0644 5246\u060C \u062F\u0627\u062F\u0647 5247)","802.1X: \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u067E\u0648\u0631\u062A\u200C\u0645\u062D\u0648\u0631 \u0628\u0627 EAP","RADIUS: \u067E\u0631\u0648\u062A\u06A9\u0644 \u0628\u06CC\u0646 WLC \u0648 ISE (UDP 1812/1813)","FlexConnect: AP \u0645\u062D\u0644\u06CC \u062A\u0631\u0627\u0641\u06CC\u06A9 \u0631\u0627 \u062A\u062D\u0648\u06CC\u0644 \u0645\u06CC\u200C\u062F\u0647\u062F"]},{h:"WPA2 \u0648 WPA3",p:["\u062F\u0631 WPA2-Personal \u06A9\u0644\u06CC\u062F \u0628\u0627 PSK \u0648 \u0686\u0647\u0627\u0631\u0645\u0631\u062D\u0644\u0647\u200C\u0627\u06CC (4-way handshake) \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0622\u0633\u06CC\u0628\u200C\u067E\u0630\u06CC\u0631\u06CC\u200C\u0627\u0634 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0627\u06AF\u0631 \u06A9\u0633\u06CC handshake \u0631\u0627 \u0636\u0628\u0637 \u06A9\u0646\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F \u0631\u0645\u0632 \u0631\u0627 \u0622\u0641\u0644\u0627\u06CC\u0646 \u062D\u062F\u0633 \u0628\u0632\u0646\u062F. WPA3-Personal \u0627\u06CC\u0646 \u0631\u0627 \u0628\u0627 SAE \u062D\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u062A\u0628\u0627\u062F\u0644 \u06A9\u0644\u06CC\u062F \u0628\u0647\u200C\u0634\u06A9\u0644\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062D\u0645\u0644\u0647 \u0622\u0641\u0644\u0627\u06CC\u0646 \u0645\u0645\u06A9\u0646 \u0646\u06CC\u0633\u062A.","\u062F\u0631 \u0633\u0627\u0632\u0645\u0627\u0646\u060C \u062D\u0627\u0644\u062A Enterprise \u0628\u0627 802.1X \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F: \u0647\u0631 \u06A9\u0627\u0631\u0628\u0631 \u0627\u0639\u062A\u0628\u0627\u0631 \u062E\u0648\u062F\u0634 \u0631\u0627 \u062F\u0627\u0631\u062F (\u0646\u0647 \u06CC\u06A9 \u0631\u0645\u0632 \u0645\u0634\u062A\u0631\u06A9). WPA3-Enterprise 192-bit \u0633\u062E\u062A\u200C\u06AF\u06CC\u0631\u0627\u0646\u0647\u200C\u062A\u0631\u06CC\u0646 \u062D\u0627\u0644\u062A \u0627\u0633\u062A: \u0641\u0642\u0637 EAP-TLS \u0648 \u0627\u0644\u06AF\u0648\u0631\u06CC\u062A\u0645\u200C\u0647\u0627\u06CC Suite-B. \u0627\u0646\u062A\u062E\u0627\u0628 \u062F\u0631\u0633\u062A \u0647\u0645\u06CC\u0634\u0647 \u0628\u0627 \u062A\u0648\u062C\u0647 \u0628\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627\u06CC \u0645\u0648\u062C\u0648\u062F \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F: \u0627\u06AF\u0631 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0642\u062F\u06CC\u0645\u06CC \u062F\u0627\u0631\u06CC\u060C \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0644\u0627\u0632\u0645 \u0628\u0627\u0634\u062F SSID \u062C\u062F\u0627 \u0628\u0633\u0627\u0632\u06CC."],callout:{title:"PMF \u0631\u0627 \u062C\u062F\u06CC \u0628\u06AF\u06CC\u0631",text:"PMF \u06CC\u0627 802.11w \u0627\u0632 \u0641\u0631\u06CC\u0645\u200C\u0647\u0627\u06CC \u0645\u062F\u06CC\u0631\u06CC\u062A\u06CC \u0645\u062D\u0627\u0641\u0638\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u062C\u0644\u0648\u06CC \u062D\u0645\u0644\u0647 Deauth \u062C\u0639\u0644\u06CC \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u062F\u0631 WPA3 \u0627\u0644\u0632\u0627\u0645\u06CC \u0648 \u062F\u0631 WPA2 \u0627\u062E\u062A\u06CC\u0627\u0631\u06CC \u0627\u0633\u062A."}},{h:"\u0631\u0648\u0645\u06CC\u0646\u06AF",p:["\u0648\u0642\u062A\u06CC \u06A9\u0627\u0631\u0628\u0631 \u062D\u0631\u06A9\u062A \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C AP \u0639\u0648\u0636 \u0645\u06CC\u200C\u0634\u0648\u062F. \u062F\u0631 \u0631\u0648\u0645\u06CC\u0646\u06AF \u0633\u0627\u062F\u0647\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u06A9\u0627\u0645\u0644 \u0631\u0627 \u062F\u0648\u0628\u0627\u0631\u0647 \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 \u0628\u0631\u0627\u06CC \u0686\u0646\u062F \u062B\u0627\u0646\u06CC\u0647 \u0642\u0637\u0639 \u0645\u06CC\u200C\u0634\u0648\u062F\u061B \u0628\u0631\u0627\u06CC \u062A\u0645\u0627\u0633 \u0635\u0648\u062A\u06CC \u0627\u06CC\u0646 \u06A9\u0627\u0641\u06CC \u0627\u0633\u062A \u062A\u0627 \u062A\u0645\u0627\u0633 \u0628\u06CC\u0641\u062A\u062F. 802.11r \u06A9\u0644\u06CC\u062F \u0631\u0627 \u0627\u0632 \u0642\u0628\u0644 \u062F\u0631 AP \u062C\u062F\u06CC\u062F \u0622\u0645\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F (Fast Transition) \u0648 \u0642\u0637\u0639\u06CC \u0631\u0627 \u0628\u0647 \u0686\u0646\u062F \u062F\u0647 \u0645\u06CC\u0644\u06CC\u200C\u062B\u0627\u0646\u06CC\u0647 \u0645\u06CC\u200C\u0631\u0633\u0627\u0646\u062F.","802.11k \u0628\u0647 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0641\u0647\u0631\u0633\u062A \u0647\u0645\u0633\u0627\u06CC\u0647\u200C\u0647\u0627 \u0631\u0627 \u0645\u06CC\u200C\u062F\u0647\u062F \u062A\u0627 \u0627\u0633\u06A9\u0646 \u06A9\u0648\u0631\u06A9\u0648\u0631\u0627\u0646\u0647 \u0646\u06A9\u0646\u062F \u0648 802.11v \u067E\u06CC\u0634\u0646\u0647\u0627\u062F \u0645\u0647\u0627\u062C\u0631\u062A \u0645\u06CC\u200C\u062F\u0647\u062F. \u0627\u06CC\u0646 \u0633\u0647 \u0628\u0627 \u0647\u0645\u060C \u062A\u062C\u0631\u0628\u0647 \u0631\u0648\u0645\u06CC\u0646\u06AF \u0631\u0627 \u0631\u0648\u0627\u0646 \u0645\u06CC\u200C\u06A9\u0646\u0646\u062F."]},{h:"\u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0648\u0627\u06CC\u200C\u0641\u0627\u06CC",p:["\u0627\u06AF\u0631 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0648\u0635\u0644 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u062A\u0631\u062A\u06CC\u0628 \u0628\u0631\u0631\u0633\u06CC: \u0622\u06CC\u0627 SSID \u067E\u062E\u0634 \u0645\u06CC\u200C\u0634\u0648\u062F\u061F \u0622\u06CC\u0627 AP \u062F\u0631 WLC \u062B\u0628\u062A \u0627\u0633\u062A (CAPWAP)\u061F \u0622\u06CC\u0627 \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u0645\u06CC\u200C\u0634\u0648\u062F (\u0644\u0627\u06AF ISE)\u061F \u0622\u06CC\u0627 \u0628\u0639\u062F \u0627\u0632 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A\u060C DHCP \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F\u061F \u062A\u0641\u06A9\u06CC\u06A9 \u0627\u06CC\u0646 \u0686\u0647\u0627\u0631 \u0645\u0631\u062D\u0644\u0647\u060C \u06F9\u06F0\u066A \u06A9\u0627\u0631 \u0639\u06CC\u0628\u200C\u06CC\u0627\u0628\u06CC \u0627\u0633\u062A. \u062F\u0633\u062A\u0648\u0631\u0647\u0627\u06CC WLC: show ap summary\u060C show wlan summary\u060C show client detail <mac>."]}],analogy:"\u0648\u0627\u06CC\u200C\u0641\u0627\u06CC \u0633\u0627\u0632\u0645\u0627\u0646\u06CC \u0645\u062B\u0644 \u0648\u0631\u0648\u062F \u0628\u0647 \u0633\u0627\u062E\u062A\u0645\u0627\u0646 \u0627\u062F\u0627\u0631\u06CC \u0627\u0633\u062A: AP \u062F\u0631 \u0648\u0631\u0648\u062F\u06CC (\u06A9\u0627\u0631\u062A\u200C\u062E\u0648\u0627\u0646) \u0627\u0633\u062A\u060C WLC \u0646\u06AF\u0647\u0628\u0627\u0646\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0645\u06CC\u200C\u062F\u0627\u0646\u062F \u0647\u0631 \u067E\u0631\u0633\u0646\u0644 \u0628\u0647 \u06A9\u062F\u0627\u0645 \u0637\u0628\u0642\u0647 \u0628\u0631\u0648\u062F \u0648 ISE \u067E\u0631\u0648\u0646\u062F\u0647 \u067E\u0631\u0633\u0646\u0644\u06CC \u0648 \u0633\u0637\u062D \u062F\u0633\u062A\u0631\u0633\u06CC \u0631\u0627 \u062F\u0627\u0631\u062F.",pitfalls:["\u062B\u0628\u062A\u200C\u0646\u0634\u062F\u0646 AP \u062F\u0631 WLC (\u0645\u0634\u06A9\u0644 CAPWAP \u06CC\u0627 \u06AF\u0648\u0627\u0647\u06CC): SSID \u062F\u0631 \u0622\u0646 \u0646\u0627\u062D\u06CC\u0647 \u067E\u062E\u0634 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u0646\u0628\u0648\u062F RADIUS \u062F\u0631 \u062F\u0633\u062A\u0631\u0633: \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u062D\u0631\u0627\u0632 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0627\u062A\u0635\u0627\u0644 \u0628\u06CC\u200C\u067E\u0627\u06CC\u0627\u0646 \u062A\u0644\u0627\u0634 \u0645\u06CC\u200C\u06A9\u0646\u062F.","SSID \u0628\u0627 \u0627\u0645\u0646\u06CC\u062A \u0646\u0627\u0633\u0627\u0632\u06AF\u0627\u0631 \u0628\u0627 \u062F\u0633\u062A\u06AF\u0627\u0647: \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0641\u0642\u0637 \xAB\u0648\u0635\u0644 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F\xBB \u0628\u062F\u0648\u0646 \u067E\u06CC\u0627\u0645 \u062E\u0637\u0627\u06CC \u0631\u0648\u0634\u0646."],exam:["CAPWAP \u06A9\u0646\u062A\u0631\u0644 UDP 5246 \u0648 \u062F\u0627\u062F\u0647 UDP 5247 \u062F\u0627\u0631\u062F.","802.1X \u0628\u0627 EAP \u0648 RADIUS \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F\u061B RADIUS \u0631\u0648\u06CC 1812/1813 \u0627\u0633\u062A.","WPA3-Personal \u0627\u0632 SAE \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 PMF \u062F\u0631 \u0622\u0646 \u0627\u0644\u0632\u0627\u0645\u06CC \u0627\u0633\u062A."],glossary:[["WLC","\u06A9\u0646\u062A\u0631\u0644\u0631 \u0648\u0627\u06CC\u0631\u0644\u0633."],["CAPWAP","\u067E\u0631\u0648\u062A\u06A9\u0644 \u062A\u0648\u0646\u0644 \u0628\u06CC\u0646 AP \u0648 \u06A9\u0646\u062A\u0631\u0644\u0631."],["SSID","\u0646\u0627\u0645 \u0634\u0628\u06A9\u0647 \u0628\u06CC\u200C\u0633\u06CC\u0645."],["EAP","\u0686\u0627\u0631\u0686\u0648\u0628 \u0627\u062D\u0631\u0627\u0632 \u0647\u0648\u06CC\u062A \u062F\u0631 802.1X."]]},automation:{prereq:[],related:["netconf-yang","catalyst-center","sdwan"],title:"\u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0634\u0628\u06A9\u0647 \u2014 \u0627\u0632 CLI \u062F\u0633\u062A\u06CC \u0628\u0647 API \u0648 \u0642\u0627\u0644\u0628",tagline:"\u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u06CC\u0639\u0646\u06CC \u0647\u0645\u0627\u0646 \u06A9\u0627\u0631\u060C \u0648\u0644\u06CC \u062A\u06A9\u0631\u0627\u0631\u067E\u0630\u06CC\u0631\u060C \u0642\u0627\u0628\u0644 \u0628\u0627\u0632\u0628\u06CC\u0646\u06CC \u0648 \u0628\u062F\u0648\u0646 \u062A\u0627\u06CC\u067E \u0627\u0634\u062A\u0628\u0627\u0647.",minutes:13,goals:["\u062A\u0641\u0627\u0648\u062A \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC CLI \u0628\u0627 \u0645\u062F\u0644\u200C\u0645\u062D\u0648\u0631 (NETCONF/YANG) \u0631\u0627 \u0628\u06AF\u0648\u06CC\u06CC","\u06CC\u06A9 \u062A\u0645\u0627\u0633 \u0633\u0627\u062F\u0647 \u0628\u0627 RESTCONF \u06CC\u0627 API \u0627\u0646\u062C\u0627\u0645 \u0628\u062F\u0647\u06CC \u0648 \u067E\u0627\u0633\u062E \u0631\u0627 \u0628\u062E\u0648\u0627\u0646\u06CC","\u0628\u062F\u0627\u0646\u06CC Ansible\u060C Terraform \u0648 \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06CC \u06A9\u0646\u062A\u0631\u0644\u0631 \u06A9\u062C\u0627 \u0628\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u0622\u06CC\u0646\u062F"],sections:[{h:"\u0686\u0631\u0627 CLI \u0628\u0631\u0627\u06CC \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0645\u0646\u0627\u0633\u0628 \u0646\u06CC\u0633\u062A\u061F",p:["CLI \u0628\u0631\u0627\u06CC \u0627\u0646\u0633\u0627\u0646 \u0637\u0631\u0627\u062D\u06CC \u0634\u062F\u0647\u060C \u0646\u0647 \u0628\u0631\u0646\u0627\u0645\u0647. \u062E\u0631\u0648\u062C\u06CC \u0622\u0646 \u0645\u062A\u0646\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0628\u0627 \u0647\u0631 \u0646\u0633\u062E\u0647 IOS \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0639\u0648\u0636 \u0634\u0648\u062F\u061B \u0647\u06CC\u0686 \u0633\u0627\u062E\u062A\u0627\u0631 \u0645\u0634\u062E\u0635\u06CC \u0646\u062F\u0627\u0631\u062F \u0648 \u0641\u0647\u0645\u06CC\u062F\u0646 \xAB\u0622\u06CC\u0627 \u062A\u063A\u06CC\u06CC\u0631 \u0627\u0639\u0645\u0627\u0644 \u0634\u062F\u061F\xBB \u0633\u062E\u062A \u0627\u0633\u062A. \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0645\u062F\u0631\u0646 \u0631\u0648\u06CC \u0645\u062F\u0644 \u062F\u0627\u062F\u0647 \u06A9\u0627\u0631 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0633\u0627\u062E\u062A\u0627\u0631 \u062F\u0631\u062E\u062A\u06CC YANG \u06A9\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0647\u0631 \u062A\u0646\u0638\u06CC\u0645 \u06A9\u062C\u0627\u0633\u062A \u0648 \u0686\u0647 \u0646\u0648\u0639\u06CC \u062F\u0627\u0631\u062F.","\u0628\u0627 NETCONF (\u0631\u0648\u06CC SSH 830) \u06CC\u0627 RESTCONF (\u0631\u0648\u06CC HTTPS) \u0647\u0645\u0627\u0646 \u062F\u0631\u062E\u062A \u0631\u0627 \u0645\u06CC\u200C\u062E\u0648\u0627\u0646\u06CC \u0648 \u062A\u063A\u06CC\u06CC\u0631 \u0645\u06CC\u200C\u062F\u0647\u06CC. \u0645\u0632\u06CC\u062A \u0628\u0632\u0631\u06AF: \u0627\u06AF\u0631 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0628\u0627 \u0645\u062F\u0644 \u0646\u062E\u0648\u0627\u0646\u062F\u060C \u062F\u0633\u062A\u06AF\u0627\u0647 \u0647\u0645\u0627\u0646 \u0627\u0648\u0644 \u0631\u062F \u0645\u06CC\u200C\u06A9\u0646\u062F (validation) \u0648 \u0634\u0645\u0627 \u0645\u062C\u0628\u0648\u0631 \u0646\u06CC\u0633\u062A\u06CC\u062F \u0628\u0641\u0647\u0645\u06CC\u062F \u0686\u0631\u0627 \u0646\u0635\u0641 \u062A\u0646\u0638\u06CC\u0645\u0627\u062A \u0627\u0639\u0645\u0627\u0644 \u0634\u062F\u0647 \u0627\u0633\u062A."]},{h:"\u0627\u0628\u0632\u0627\u0631\u0647\u0627 \u0648 \u062C\u0627\u06CC \u0647\u0631\u06A9\u062F\u0627\u0645",p:["Ansible \u0628\u0631\u0627\u06CC \xAB\u0627\u062C\u0631\u0627\u06CC \u0648\u0638\u0627\u06CC\u0641\xBB \u062E\u0648\u0628 \u0627\u0633\u062A \u0648 \u0645\u0627\u0698\u0648\u0644\u200C\u0647\u0627\u06CC \u0634\u0628\u06A9\u0647 \u062F\u0627\u0631\u062F (ios_config, ios_command). Terraform \u0628\u0631\u0627\u06CC \xAB\u0645\u062F\u06CC\u0631\u06CC\u062A \u0645\u0646\u0627\u0628\u0639\xBB \u0628\u0647\u200C\u0635\u0648\u0631\u062A \u062D\u0627\u0644\u062A\u200C\u0645\u062D\u0648\u0631 (state) \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u062F\u0631 \u0645\u062D\u06CC\u0637\u200C\u0647\u0627\u06CC \u0627\u0628\u0631\u06CC/\u0645\u062C\u0627\u0632\u06CC \u0639\u0627\u0644\u06CC \u0627\u0633\u062A. \u06A9\u0646\u062A\u0631\u0644\u0631\u0647\u0627 (Catalyst Center\u060C SD-WAN Manager) \u0647\u0645 API \u062F\u0627\u0631\u0646\u062F \u0648 \u0628\u0631\u0627\u06CC \u0645\u0642\u06CC\u0627\u0633 \u0628\u0632\u0631\u06AF \u0627\u0646\u062A\u062E\u0627\u0628 \u0627\u0648\u0644\u200C\u0627\u0646\u062F.","Python \u0628\u0627 \u06A9\u062A\u0627\u0628\u062E\u0627\u0646\u0647\u200C\u0647\u0627\u06CC ncclient \u0648 requests\u060C \u0632\u0628\u0627\u0646 \u0686\u0633\u0628\u200C\u062F\u0647\u0646\u062F\u0647 \u0627\u06CC\u0646\u200C\u0647\u0627\u0633\u062A. \u062F\u0631 \u0639\u0645\u0644\u060C \u0633\u0627\u0632\u0645\u0627\u0646\u200C\u0647\u0627 \u062A\u0631\u06A9\u06CC\u0628\u06CC \u0627\u0632 \u0647\u0645\u0647 \u0631\u0627 \u062F\u0627\u0631\u0646\u062F: \u06A9\u0646\u062A\u0631\u0644\u0631 \u0628\u0631\u0627\u06CC \u0632\u06CC\u0631\u0633\u0627\u062E\u062A\u060C Ansible \u0628\u0631\u0627\u06CC \u0648\u0638\u0627\u06CC\u0641 \u062F\u0648\u0631\u0647\u200C\u0627\u06CC\u060C \u0648 CI/CD \u0628\u0631\u0627\u06CC \u062A\u0633\u062A \u062A\u063A\u06CC\u06CC\u0631\u0627\u062A \u0642\u0628\u0644 \u0627\u0632 \u0627\u0639\u0645\u0627\u0644."],list:["NETCONF/RESTCONF: \u067E\u06CC\u06A9\u0631\u0628\u0646\u062F\u06CC \u0645\u062F\u0644\u200C\u0645\u062D\u0648\u0631","Ansible: \u0648\u0638\u06CC\u0641\u0647\u200C\u0645\u062D\u0648\u0631\u060C \u0633\u0627\u062F\u0647\u060C \u0628\u062F\u0648\u0646 agent","Terraform: \u062D\u0627\u0644\u062A\u200C\u0645\u062D\u0648\u0631\u060C \u0645\u0646\u0627\u0633\u0628 \u0632\u06CC\u0631\u0633\u0627\u062E\u062A \u0627\u0628\u0631\u06CC","gNMI: \u062A\u0644\u0647\u200C\u0645\u062A\u0631\u06CC \u0627\u0633\u062A\u0631\u06CC\u0645 \u0628\u0627 Protobuf"]},{h:"\u06CC\u06A9 \u0646\u0645\u0648\u0646\u0647 \u0648\u0627\u0642\u0639\u06CC",p:["\u0641\u0631\u0636 \u06A9\u0646 \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u06CC \u0631\u0648\u06CC \u06F1\u06F0\u06F0 \u0633\u0648\u0626\u06CC\u0686 NTP \u062A\u0646\u0638\u06CC\u0645 \u06A9\u0646\u06CC. \u062F\u0631 \u0631\u0648\u0634 CLI \u0628\u0627\u06CC\u062F \u062D\u0644\u0642\u0647 \u0628\u0632\u0646\u06CC \u0648 \u06F1\u06F0\u06F0 \u0628\u0627\u0631 \u0648\u0635\u0644 \u0634\u0648\u06CC. \u062F\u0631 \u0631\u0648\u0634 \u0645\u062F\u0644\u200C\u0645\u062D\u0648\u0631\u060C \u06CC\u06A9 \u0642\u0627\u0644\u0628 \u0645\u06CC\u200C\u0646\u0648\u06CC\u0633\u06CC\u060C \u0645\u062A\u063A\u06CC\u0631\u0647\u0627 \u0631\u0627 \u067E\u0631 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u060C \u0648 \u0633\u06CC\u0633\u062A\u0645 \u0647\u0645 \u0627\u0639\u0645\u0627\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F \u0647\u0645 \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0647 \u0631\u0648\u06CC \u0647\u0645\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627 \u06CC\u06A9\u0633\u0627\u0646 \u0627\u0633\u062A (Compliance).","\u0646\u06A9\u062A\u0647\u200C\u0627\u06CC \u06A9\u0647 \u062F\u0631 \u0622\u0632\u0645\u0648\u0646 \u0645\u06CC\u200C\u0622\u06CC\u062F: \u0647\u0645\u06CC\u0634\u0647 \u0628\u062F\u0627\u0646 \u06A9\u062F\u0627\u0645 API \u0686\u0647 \u06A9\u0627\u0631\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F. GET \u0628\u0631\u0627\u06CC \u062E\u0648\u0627\u0646\u062F\u0646\u060C POST \u0628\u0631\u0627\u06CC \u0633\u0627\u062E\u062A\u060C PATCH \u0628\u0631\u0627\u06CC \u062A\u063A\u06CC\u06CC\u0631 \u062C\u0632\u0626\u06CC\u060C PUT \u0628\u0631\u0627\u06CC \u062C\u0627\u06CC\u06AF\u0632\u06CC\u0646\u06CC \u0648 DELETE \u0628\u0631\u0627\u06CC \u062D\u0630\u0641. \u0648 \u062F\u0631 RESTCONF\u060C \u0645\u0633\u06CC\u0631 \u0647\u0645\u0627\u0646 \u062F\u0631\u062E\u062A YANG \u0627\u0633\u062A."],callout:{title:"\u0686\u06A9\u200C\u0644\u06CC\u0633\u062A \u06A9\u0648\u0686\u06A9 \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646",text:"\u06F1) \u0646\u0633\u062E\u0647 \u067E\u0634\u062A\u06CC\u0628\u0627\u0646 \u0642\u0628\u0644 \u0627\u0632 \u062A\u063A\u06CC\u06CC\u0631 \u06F2) \u0627\u062C\u0631\u0627\u06CC dry-run \u06F3) \u0644\u0627\u06AF \u062A\u063A\u06CC\u06CC\u0631 \u06F4) \u0627\u0645\u06A9\u0627\u0646 \u0628\u0627\u0632\u06AF\u0634\u062A \u06F5) \u062A\u0633\u062A \u0628\u0639\u062F \u0627\u0632 \u0627\u0639\u0645\u0627\u0644. \u0647\u0631 \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646\u06CC \u06A9\u0647 \u0627\u06CC\u0646 \u067E\u0646\u062C \u0645\u0648\u0631\u062F \u0631\u0627 \u0646\u062F\u0627\u0634\u062A\u0647 \u0628\u0627\u0634\u062F\u060C \u062F\u0631 \u0639\u0645\u0644 \u062E\u0637\u0631\u0646\u0627\u06A9 \u0627\u0633\u062A."}},{h:"\u0627\u0632 \u0627\u0633\u06A9\u0631\u06CC\u067E\u062A \u062A\u0627 \u062E\u0637 \u0644\u0648\u0644\u0647",p:["\u0627\u0633\u06A9\u0631\u06CC\u067E\u062A\u06CC \u06A9\u0647 \u0631\u0648\u06CC \u0644\u067E\u200C\u062A\u0627\u067E \u06CC\u06A9 \u0646\u0641\u0631 \u0627\u062C\u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0646\u06CC\u0633\u062A\u061B \u06CC\u06A9 \u0627\u0628\u0632\u0627\u0631 \u0634\u062E\u0635\u06CC \u0627\u0633\u062A. \u0627\u062A\u0648\u0645\u0627\u0633\u06CC\u0648\u0646 \u0648\u0627\u0642\u0639\u06CC \u062F\u0631 \u06CC\u06A9 \u062E\u0637 \u0