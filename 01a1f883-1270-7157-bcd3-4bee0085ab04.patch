).","\u06A9\u0644\u0627\u06CC\u0646\u062A ACK \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u062F: \u062A\u0623\u06CC\u06CC\u062F \u06F3\u06F0\u06F1. \u0627\u0632 \u0627\u06CC\u0646 \u0644\u062D\u0638\u0647 \u0627\u062A\u0635\u0627\u0644 \xAB\u0628\u0631\u0642\u0631\u0627\u0631\xBB \u0627\u0633\u062A \u0648 \u062F\u0627\u062F\u0647 \u0631\u062F \u0648 \u0628\u062F\u0644 \u0645\u06CC\u200C\u0634\u0648\u062F.","\u067E\u0627\u06CC\u0627\u0646 \u0645\u062A\u0639\u0627\u0631\u0641 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F FIN\u060C ACK\u060C FIN\u060C ACK \u0628\u0627\u0634\u062F\u061B \u06AF\u0627\u0647\u06CC ACK \u0648 FIN \u06CC\u06A9 \u0637\u0631\u0641 \u062F\u0631 \u06CC\u06A9 \u0633\u06AF\u0645\u0646\u062A \u062A\u0631\u06A9\u06CC\u0628 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F. \u062F\u0631 \u0646\u0645\u0648\u0646\u0647 \u0632\u06CC\u0631 ACK \u0646\u0647\u0627\u06CC\u06CC \u0648 TIME-WAIT \u0631\u0627 \u0647\u0645 \u0628\u0628\u06CC\u0646. RST \u0628\u0647\u200C\u062C\u0627\u06CC \u067E\u0627\u06CC\u0627\u0646 \u0645\u0631\u062A\u0628\u060C \u0627\u062A\u0635\u0627\u0644 \u0631\u0627 \u0628\u0627\u0632\u0646\u0634\u0627\u0646\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F."],table:{head:["\u06AF\u0627\u0645","\u0641\u0631\u0633\u062A\u0646\u062F\u0647","\u0628\u0633\u062A\u0647","\u067E\u0631\u0686\u0645","\u0634\u0645\u0627\u0631\u0647","\u0648\u0636\u0639\u06CC\u062A \u0628\u0639\u062F\u06CC"],rows:[["\u06F1","\u06A9\u0644\u0627\u06CC\u0646\u062A","SYN","SYN=1","Seq=100","SYN-SENT"],["\u06F2","\u0633\u0631\u0648\u0631","SYN-ACK","SYN=1 ACK=1","Seq=300 Ack=101","SYN-RECEIVED"],["\u06F3","\u06A9\u0644\u0627\u06CC\u0646\u062A","ACK","ACK=1","Ack=301","ESTABLISHED"],["\u06F4","\u06A9\u0644\u0627\u06CC\u0646\u062A","\u062F\u0627\u062F\u0647","PSH ACK","Seq=101 Len=1460","ESTABLISHED"],["\u06F5","\u06A9\u0644\u0627\u06CC\u0646\u062A","FIN","FIN ACK","Seq=1561 Ack=301","FIN-WAIT-1"],["\u06F6","\u0633\u0631\u0648\u0631","FIN + ACK","FIN ACK","Seq=301 Ack=1562","LAST-