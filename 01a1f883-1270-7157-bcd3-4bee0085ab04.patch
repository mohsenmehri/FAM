+      "html": "<div style='margin-bottom:8px;padding:8px;background:#020617;border:1px solid #1e293b;border-radius:6px'><code dir='ltr' style='color:#38bdf8;display:block;margin-bottom:4px'>ip access-list extended BLOCK_HTTP</code><span style='font-size:12px;color:#cbd5e1'>ساخت Extended ACL نام‌دار</span></div><div style='margin-bottom:8px;padding:8px;background:#020617;border:1px solid #1e293b;border-radius:6px'><code dir='ltr' style='color:#38bdf8;display:block;margin-bottom:4px'>deny tcp 192.168.10.0 0.0.0.255 host 10.0.0.2 eq 80</code><span style='font-size:12px;color:#cbd5e1'>مسدودکردن ترافیک وب به سرور</span></div><div style='margin-bottom:8px;padding:8px;background:#020617;border:1px solid #1e293b;border-radius:6px'><code dir='ltr' style='color:#38bdf8;display:block;margin-bottom:4px'>permit ip any any</code><span style='font-size:12px;color:#cbd5e1'>اجازه به سایر ترافیک‌ها (جلوگیری از Implicit Deny)</span></div><div style='margin-bottom:8px;padding:8px;background:#020617;border:1px solid #1e293b;border-radius:6px'><code dir='ltr' style='color:#38bdf8;display:block;margin-bottom:4px'>interface GigabitEthernet0/0</code><span style='font-size:12px;color:#cbd5e1'>انتخاب اینترفیس نزدیک به مبدأ</span></div><div style='margin-bottom:8px;padding:8px;background:#020617;border:1px solid #1e293b;border-radius:6px'><code dir='ltr' style='color:#38bdf8;display:block;margin-bottom:4px'>ip access-group BLOCK_HTTP in</code><span style='font-size:12px;color:#cbd5e1'>اعمال ACL در جهت ورودی</span></div>"
