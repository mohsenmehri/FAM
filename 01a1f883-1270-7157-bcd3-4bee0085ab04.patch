+#!/usr/bin/env bash
+# Shared guards for the FAM Academy 157682a manual LAB deployment.
+set -Eeuo pipefail
+
+FAM_ACADEMY_BASE_COMMIT='157682af4e6129dc22ca4b531a6f25a580789e7c'
+FAM_ACADEMY_PAYLOAD_COUNT=135
+FAM_ACADEMY_MIN_DOCKER_FREE=$((512 * 1024 * 1024))
+
+academy_fail() {
+  printf 'STOP: %s\n' "$*" >&2
+  exit 1
+}
+
+academy_note() {
+  printf '%s\n' "$*"
+}
+
+academy_compose() {
+  (cd "$ROOT" && docker compose "$@")
+}
+
+academy_require_scope() {
+  [[ "${FAM_ACADEMY_TARGET:-}" == 'LAB' ]] || academy_fail 'Set FAM_ACADEMY_TARGET=LAB explicitly. Production is out of scope.'
+  [[ "${FAM_ACADEMY_CONFIRM:-}" == 'LAB-ONLY' ]] || academy_fail 'Set FAM_ACADEMY_CONFIRM=LAB-ONLY to confirm this VM is the LAB target.'
+  local lower_root="${ROOT,,}"
+  [[ "$lower_root" != *prod* ]] || academy_fail 'The target path contains "prod"; refusing to operate.'
+  [[ "$lower_root" == *lab* ]] || academy_fail 'The target project path must identify the LAB project.'
+}
+
+academy_require_root() {
+  [[ "$(id -u)" == '0' ]] || academy_fail 'Run this command with sudo/root; no deployment files have been changed.'
+}
+
+academy_resolve_root() {
+  [[ $# -ge 1 && -n "$1" ]] || academy_fail 'Pass the absolute path to the FAM-Linux-Lab project directory.'
+  [[ -d "$1" ]] || academy_fail "Project directory does not exist: $1"
+  ROOT="$(realpath -e -- "$1")"
+  [[ -f "$ROOT/docker-compose.yml" && -f "$ROOT/server/app.py" && -f "$ROOT/server/manage.py" ]] ||
+    academy_fail 'The selected directory does not look like the expected FAM-Linux-Lab project root.'
+  academy_require_scope
+}
+
+academy_bundle_checks() {
+  [[ -f "$BUNDLE_DIR/BASE-COMMIT" ]] || academy_fail 'Bundle BASE-COMMIT file is missing.'
+  [[ "$(tr -d '\r\n' < "$BUNDLE_DIR/BASE-COMMIT")" == "$FAM_ACADEMY_BASE_COMMIT" ]] ||
+    academy_fail 'This package is not pinned to the required 157682a base commit.'
+  [[ -d "$BUNDLE_DIR/payload" && -f "$BUNDLE_DIR/payload.sha256" && -f "$BUNDLE_DIR/baseline.sha256" ]] ||
+    academy_fail 'Bundle payload or checksum manifests are missing.'
+  local count
+  count="$(wc -l < "$BUNDLE_DIR/payload.sha256" | tr -d '[:space:]')"
+  [[ "$count" == "$FAM_ACADEMY_PAYLOAD_COUNT" ]] || academy_fail "Expected $FAM_ACADEMY_PAYLOAD_COUNT payload files, found $count."
+  [[ "$(wc -l < "$BUNDLE_DIR/baseline.sha256" | tr -d '[:space:]')" == '8' ]] ||
+    academy_fail 'Baseline checksum manifest is incomplete.'
+  if find "$BUNDLE_DIR/payload" -type l -print -quit | grep -q .; then
+    academy_fail 'Symlinks are not permitted in the deployment payload.'
+  fi
+  local temp_dir actual expected rel
+  temp_dir="$(mktemp -d)"
+  if ! (
+    cd "$BUNDLE_DIR/payload"
+    sha256sum -c "$BUNDLE_DIR/payload.sha256" >/dev/null
+  ); then
+    rm -rf -- "$temp_dir"
+    academy_fail 'Payload checksum validation failed.'
+  fi
+  find "$BUNDLE_DIR/payload" -type f -printf '%P\n' | LC_ALL=C sort > "$temp_dir/actual"
+  awk '{print $2}' "$BUNDLE_DIR/payload.sha256" | LC_ALL=C sort > "$temp_dir/expected"
+  if ! cmp -s "$temp_dir/actual" "$temp_dir/expected"; then
+    rm -rf -- "$temp_dir"
+    academy_fail 'Payload file list does not exactly match its checksum manifest.'
+  fi
+  while read -r _ rel; do
+    case "$rel" in
+      nginx.conf|server/app.py|server/private_ui/academy.html|server/www/academy-assets/academy-course-library.css|server/www/academy-assets/academy-course-library.js|server/www/academy-assets/academy-reference-shell.js|server/www/academy-content/catalog.json|server/www/academy-content/academy-*.md|server/www/academy-content/images/*.svg)
+        ;;
+      *) rm -rf -- "$temp_dir"; academy_fail "Out-of-scope payload path: $rel" ;;
+    esac
+    [[ "$rel" != /* && "$rel" != *'..'* ]] || { rm -rf -- "$temp_dir"; academy_fail "Unsafe payload path: $rel"; }
+  done < "$BUNDLE_DIR/payload.sha256"
+  rm -rf -- "$temp_dir"
+}
+
+academy_preflight() {
+  academy_require_root
+  academy_bundle_checks
+
+  local required
+  for required in bash docker sha256sum tar gzip find cmp diff awk stat realpath df du python3 \
+    grep sed tr wc sort mktemp install cp chown chmod mv mkdir rm; do
+    command -v "$required" >/dev/null 2>&1 || academy_fail "Required local command is unavailable: $required"
+  done
+
+  [[ "$(uname -s)" == 'Linux' ]] || academy_fail 'This manual package supports the Ubuntu/Linux LAB VM only.'
+  local relative
+  for relative in \
+    '.env' 'Dockerfile' 'docker-compose.yml' 'nginx.conf' \
+    'server/app.py' 'server/manage.py' 'server/private_ui/academy.html' \
+    'server/requirements.txt' 'data'; do
+    [[ -e "$ROOT/$relative" && ! -L "$ROOT/$relative" ]] || academy_fail "Required FAM path is missing or is a symlink: $relative"
+  done
+  [[ -d "$ROOT/data" ]] || academy_fail 'FAM data directory is not a directory.'
+  [[ -d "$ROOT/certs" ]] || academy_fail 'FAM certificates directory is missing.'
+  [[ -f "$ROOT/.env" && -f "$ROOT/Dockerfile" && -f "$ROOT/docker-compose.yml" && -f "$ROOT/nginx.conf" ]] ||
+    academy_fail 'A required configuration path is not a regular file.'
+  [[ -f "$ROOT/certs/fam.crt" && -f "$ROOT/certs/fam.key" ]] || academy_fail 'Expected LAB TLS certificate/key files are missing.'
+  [[ -r "$ROOT/.env" && -r "$ROOT/certs/fam.crt" && -r "$ROOT/certs/fam.key" ]] ||
+    academy_fail 'The current configuration or certificates cannot be read for a restricted backup.'
+  if find "$ROOT/certs" -type l -print -quit | grep -q .; then
+    academy_fail 'Symlinks under certs/ are unsupported by this package; no files were changed.'
+  fi
+  for relative in '.env' 'Dockerfile' 'docker-compose.yml' 'nginx.conf' 'certs'; do
+    [[ ! -L "$ROOT/$relative" ]] || academy_fail "Refusing a symlink in protected config/certificate path: $relative"
+  done
+
+  if git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
+    local actual_commit
+    actual_commit="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
+    [[ "$actual_commit" == "$FAM_ACADEMY_BASE_COMMIT" ]] ||
+      academy_fail 'Git checkout HEAD is not the required 157682a base. No local source was changed.'
+  fi
+  if ! (cd "$ROOT" && sha256sum -c "$BUNDLE_DIR/baseline.sha256" >/dev/null 2>&1); then
+    academy_fail 'One or more baseline files differ from commit 157682a. Review/backup that VM manually; package stopped before changes.'
+  fi
+
+  local services
+  services="$(academy_compose config --services 2>/dev/null | LC_ALL=C sort)" ||
+    academy_fail 'Docker Compose config could not be read. Check .env/compose locally; values were not printed.'
+  [[ "$services" == $'app\nnginx' ]] || academy_fail 'Expected only the baseline app and nginx Compose services.'
+  academy_compose config --quiet >/dev/null 2>&1 ||
+    academy_fail 'Docker Compose preflight failed. No configuration output was exposed.'
+
+  docker image inspect python:3.12-slim >/dev/null 2>&1 || academy_fail 'Offline base image python:3.12-slim is not present locally.'
+  docker image inspect nginx:alpine >/dev/null 2>&1 || academy_fail 'Offline base image nginx:alpine is not present locally.'
+
+  APP_ID="$(academy_compose ps -q app 2>/dev/null)" || academy_fail 'Could not locate the app container.'
+  NGINX_ID="$(academy_compose ps -q nginx 2>/dev/null)" || academy_fail 'Could not locate the nginx container.'
+  [[ -n "$APP_ID" && "$APP_ID" != *$'\n'* ]] || academy_fail 'Expected exactly one running FAM app container.'
+  [[ -n "$NGINX_ID" && "$NGINX_ID" != *$'\n'* ]] || academy_fail 'Expected exactly one running FAM nginx container.'
+  [[ "$(docker inspect --format '{{.State.Running}}' "$APP_ID" 2>/dev/null)" == 'true' ]] || academy_fail 'FAM app container is not running.'
+  [[ "$(docker inspect --format '{{.State.Running}}' "$NGINX_ID" 2>/dev/null)" == 'true' ]] || academy_fail 'FAM nginx container is not running.'
+
+  DB_PATH="$(academy_compose exec -T app python -c 'import os; print(os.environ.get("FAM_DB", ""))' 2>/dev/null | tr -d '\r')"
+  [[ "$DB_PATH" == /data/* && "$DB_PATH" != *'/../'* && "$DB_PATH" != */.. ]] ||
+    academy_fail 'FAM_DB is not an unambiguous path inside the /data volume.'
+  DATA_SOURCE="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Source}}{{end}}{{end}}' "$APP_ID" 2>/dev/null)"
+  [[ -n "$DATA_SOURCE" && -d "$DATA_SOURCE" ]] || academy_fail 'Could not verify the app /data bind mount.'
+  DATA_SOURCE="$(realpath -e -- "$DATA_SOURCE")"
+  [[ "$DATA_SOURCE" == "$(realpath -e -- "$ROOT/data")" ]] ||
+    academy_fail 'The app /data mount does not resolve to this project data/ directory.'
+  DB_BYTES="$(academy_compose exec -T app python -c \
+    'import os,sys; p=sys.argv[1]; assert os.path.isfile(p) and os.path.getsize(p)>0; print(sum(os.path.getsize(x) for x in (p,p+"-wal",p+"-shm") if os.path.isfile(x)))' \
+    "$DB_PATH" 2>/dev/null)" || academy_fail 'FAM_DB is not readable as a non-empty file in the app container.'
+  DB_BYTES="$(tr -d '[:space:]' <<<"$DB_BYTES")"
+  [[ "$DB_BYTES" =~ ^[0-9]+$ ]] || academy_fail 'Could not estimate the database/WAL backup size.'
+  academy_compose exec -T app python /app/server/manage.py backup --help >/dev/null 2>&1 ||
+    academy_fail 'The current manage.py does not expose the expected verified backup interface.'
+
+  local data_free_kb required_data_bytes payload_bytes docker_root docker_free_kb
+  data_free_kb="$(df -Pk "$ROOT/data" | awk 'NR==2 {print $4}')"
+  payload_bytes="$(du -sb "$BUNDLE_DIR/payload" | awk '{print $1}')"
+  [[ "$data_free_kb" =~ ^[0-9]+$ && "$payload_bytes" =~ ^[0-9]+$ ]] || academy_fail 'Could not determine available local disk space.'
+  required_data_bytes=$((DB_BYTES * 2 + payload_bytes + 16 * 1024 * 1024))
+  (( data_free_kb * 1024 >= required_data_bytes )) || academy_fail 'Insufficient free space under data/ for two verified DB copies plus the package.'
+  docker_root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)" || academy_fail 'Docker storage location could not be read.'
+  docker_free_kb="$(df -Pk "$docker_root" | awk 'NR==2 {print $4}')"
+  [[ "$docker_free_kb" =~ ^[0-9]+$ ]] || academy_fail 'Could not determine free Docker storage space.'
+  (( docker_free_kb * 1024 >= FAM_ACADEMY_MIN_DOCKER_FREE )) || academy_fail 'At least 512 MiB of free Docker storage is required for a local offline app rebuild.'
+
+  local targets temp_list rel target
+  targets="$ROOT/data/backups"
+  [[ ! -L "$targets" ]] || academy_fail 'data/backups must not be a symlink.'
+  [[ ! -e "$targets" || -d "$targets" ]] || academy_fail 'data/backups exists but is not a directory.'
+  if [[ -d "$BUNDLE_DIR/payload" ]]; then
+    local -a components
+    while read -r _ rel; do
+      target="$ROOT/$rel"
+      if [[ -L "$target" ]]; then academy_fail "Refusing a symlink at deployment target: $rel"; fi
+      if [[ -e "$target" && ! -f "$target" ]]; then academy_fail "Deployment target is not a regular file: $rel"; fi
+      IFS='/' read -r -a components <<< "$rel"
+      local parent="$ROOT" index
+      for ((index=0; index<${#components[@]}-1; index+=1)); do
+        parent="$parent/${components[index]}"
+        [[ ! -L "$parent" ]] || academy_fail "Refusing a symlink in the deployment path: ${parent#"$ROOT"/}"
+        [[ ! -e "$parent" || -d "$parent" ]] || academy_fail "Deployment parent is not a directory: ${parent#"$ROOT"/}"
+      done
+    done < "$BUNDLE_DIR/payload.sha256"
+  fi
+
+  printf 'Preflight PASS (read-only): LAB target explicitly confirmed; baseline 157682a and payload checksums match.\n'
+  printf 'Docker Compose: app + nginx are running; local offline base images are present.\n'
+  printf 'Database path is readable, manage.py backup interface is available, and local backup space is sufficient.\n'
+  printf 'No FAM data/config/source file has been changed by this preflight.\n'
+}
+
+academy_sha() {
+  sha256sum -- "$1" | awk '{print $1}'
+}
+
+academy_verify_archive() {
+  local archive_path="$1" root_path="$2" check_root="$3" relative
+  tar -tzf "$archive_path" >/dev/null 2>&1 || return 1
+  tar -xzf "$archive_path" -C "$check_root" >/dev/null 2>&1 || return 1
+  while IFS= read -r relative; do
+    [[ -e "$root_path/$relative" && -e "$check_root/$relative" ]] || return 1
+    if [[ -d "$root_path/$relative" ]]; then
+      diff -qr -- "$root_path/$relative" "$check_root/$relative" >/dev/null || return 1
+    else
+      cmp -s -- "$root_path/$relative" "$check_root/$relative" || return 1
+      [[ "$(stat -c '%a' "$root_path/$relative")" == "$(stat -c '%a' "$check_root/$relative")" ]] || return 1
+    fi
+  done < <(tar -tzf "$archive_path" | sed 's#^\./##; s#/$##' | awk 'NF' | LC_ALL=C sort -u)
+}
