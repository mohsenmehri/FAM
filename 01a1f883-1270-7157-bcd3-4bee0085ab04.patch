+  flex: 1 1 12rem;
+  min-width: 0;
+  max-width: 100%;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  line-height: 1.5;
+}
+
+/* Keep selected lesson sections below the fixed and sticky headers. */
+.le-stage-card { scroll-margin-top: 180px; }
+
+/* Educational content components used by the expanded six-stage lesson renderer. */
+.lesson-layer-list,.worked-example{display:grid;gap:10px;margin-top:10px}
