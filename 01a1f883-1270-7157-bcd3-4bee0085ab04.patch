+++ b/FAM-Linux-Lab-vm-backup/FAM-Linux-Lab/nginx.conf
@@ -32,6 +32,27 @@ server {
         try_files $uri =404;
     }
 
+    # Academy course documents and diagrams are authenticated by the app;
+    # never expose this content directory through nginx's static web root.
+    location ^~ /academy-content/ {
+        proxy_pass http://app:8765;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto https;
+    }
+
+    # Keep Academy HTML and its CSS/JS/data in the same app release. The
+    # host-mounted www directory can otherwise serve stale Academy assets
+    # after an app image update (or be missing them entirely).
+    location ^~ /academy-assets/ {
+        proxy_pass http://app:8765;
+        proxy_set_header Host $host;
+        proxy_set_header X-Real-IP $remote_addr;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_set_header X-Forwarded-Proto https;
+    }
+
     location / {
         try_files $uri @app;
     }
