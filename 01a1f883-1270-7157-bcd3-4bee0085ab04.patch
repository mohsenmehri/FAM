2F (/64) \u0648 \u0641\u0644\u06AF\u200C\u0647\u0627\u0633\u062A. \u0627\u06AF\u0631 \u0641\u0644\u06AF A \u0631\u0648\u0634\u0646 \u0628\u0627\u0634\u062F\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A \u06F6\u06F4 \u0628\u06CC\u062A \u0627\u0648\u0644 \u0631\u0627 \u0627\u0632 \u0631\u0627 \u0628\u0647\u200C\u0639\u0644\u0627\u0648\u0647 \u06CC\u06A9 Interface ID (\u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0627\u0632 MAC \u06CC\u0627 \u062A\u0635\u0627\u062F\u0641\u06CC) \u0622\u062F\u0631\u0633 \u0645\u06CC\u200C\u0633\u0627\u0632\u062F. \u0628\u0647 \u0627\u06CC\u0646 SLAAC \u0645\u06CC\u200C\u06AF\u0648\u06CC\u0646\u062F.","\u062F\u0648 \u0641\u0644\u06AF \u0645\u0647\u0645: A (autonomous) \u0627\u062C\u0627\u0632\u0647 SLAAC \u0645\u06CC\u200C\u062F\u0647\u062F \u0648 M (managed) \u0645\u06CC\u200C\u06AF\u0648\u06CC\u062F \u0628\u0631\u0648 \u0627\u0632 DHCPv6 \u0628\u06AF\u06CC\u0631. \u062A\u0631\u06A9\u06CC\u0628\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641\u06CC \u0648\u062C\u0648\u062F \u062F\u0627\u0631\u062F: SLAAC \u062A\u0646\u0647\u0627\u060C DHCPv6 \u0628\u062F\u0648\u0646 SLAAC\u060C \u06CC\u0627 \u0647\u0631 \u062F\u0648 \u0628\u0627 \u0647\u0645 (\u06A9\u0647 \u062F\u0631 \u0622\u0646 \u0622\u062F\u0631\u0633 \u0627\u0632 SLAAC \u0648 DNS \u0627\u0632 DHCPv6 \u06AF\u0631\u0641\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F)."],callout:{title:"RDNSS",text:"\u062F\u0631 \u06AF\u0630\u0634\u062A\u0647 SLAAC \u0622\u062F\u0631\u0633 DNS \u0646\u0645\u06CC\u200C\u062F\u0627\u062F \u0648 \u0628\u0627\u06CC\u062F DHCPv6 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u0634\u062F\u061B \u0627\u0645\u0631\u0648\u0632 \u0628\u0627 RDNSS \u062F\u0631 RA \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0622\u062F\u0631\u0633 DNS \u0631\u0627 \u0647\u0645 \u0628\u062F\u0648\u0646 DHCP \u062F\u0627\u062F. \u0627\u06CC\u0646 \u06AF\u0632\u06CC\u0646\u0647 \u062F\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u062E\u0627\u0646\u06AF\u06CC \u0648 \u0627\u0646\u062F\u0631\u0648\u06CC\u062F \u0627\u0647\u0645\u06CC\u062A \u062F\u0627\u0631\u062F."}},{h:"NDP: \u062C\u0627\u06CC ARP",p:["\u062F\u0631 IPv4 \u0628\u0631\u0627\u06CC \u067E\u06CC\u062F\u0627 \u06A9\u0631\u062F\u0646 MAC \u0627\u0632 ARP \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0631\u062F\u06CC\u0645 \u06A9\u0647 broadcast \u0627\u0633\u062A. IPv6 broadcast \u0646\u062F\u0627\u0631\u062F\u060C \u067E\u0633 \u0627\u0632 Neighbor Discovery \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u062F: \u0628\u0627 \u06CC\u06A9 \u067E\u06CC\u0627\u0645 multicast \u0628\u0647 \u06AF\u0631\u0648\u0647 solicited-node \u0622\u062F\u0631\u0633 \u0645\u0648\u0631\u062F\u0646\u0638\u0631\u060C \u0627\u0632 \u0627\u0648 MAC \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u062F (Neighbor Solicitation) \u0648 \u062C\u0648\u0627\u0628 (Neighbor Advertisement) \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0645\u0632\u06CC\u062A: \u0641\u0642\u0637 \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 \u0622\u062F\u0631\u0633\u0634\u0627\u0646 \u0628\u0647 \u0622\u0646 \u06AF\u0631\u0648\u0647 \u0646\u06AF\u0627\u0634\u062A \u0645\u06CC\u200C\u0634\u0648\u062F \u067E\u06CC\u0627\u0645 \u0631\u0627 \u0645\u06CC\u200C\u0628\u06CC\u0646\u0646\u062F\u060C \u0646\u0647 \u0647\u0645\u0647.","\u06A9\u0627\u0631 \u0645\u0647\u0645 \u062F\u06CC\u06AF\u0631 NDP\u060C Duplicate Address Detection \u0627\u0633\u062A: \u0642\u0628\u0644 \u0627\u0632 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 \u0622\u062F\u0631\u0633\u060C \u06A9\u0644\u0627\u06CC\u0646\u062A \u0627\u0632 \u062E\u0648\u062F\u0634 \u0645\u06CC\u200C\u067E\u0631\u0633\u062F \xAB\u0627\u06CC\u0646 \u0622\u062F\u0631\u0633 \u0622\u0632\u0627\u062F \u0627\u0633\u062A\u061F\xBB \u0627\u06AF\u0631 \u062C\u0648\u0627\u0628\u06CC \u0628\u06AF\u06CC\u0631\u062F\u060C \u0622\u062F\u0631\u0633 \u0631\u0627 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F. \u0627\u06CC\u0646 \u0647\u0645\u0627\u0646 \u0686\u06CC\u0632\u06CC \u0627\u0633\u062A \u06A9\u0647 \u062F\u0631 IPv4 \u0628\u0627 ARP probe \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u062F."]},{h:"\u0645\u0647\u0627\u062C\u0631\u062A \u0648\u0627\u0642\u0639\u06CC",p:["\u062F\u0631 \u0639\u0645\u0644\u060C \u0627\u06A9\u062B\u0631 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627 \xABdual-stack\xBB \u0647\u0633\u062A\u0646\u062F: IPv4 \u0648 IPv6 \u0628\u0627 \u0647\u0645 \u0631\u0648\u06CC \u0647\u0645\u0627\u0646 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633\u200C\u0647\u0627. \u06AF\u0627\u0645\u200C\u0647\u0627\u06CC \u0645\u0646\u0637\u0642\u06CC: \u0627\u0648\u0644 \u0622\u062F\u0631\u0633\u200C\u062F\u0647\u06CC \u0648 RA\u060C \u0628\u0639\u062F \u0645\u0633\u06CC\u0631\u06CC\u0627\u0628\u06CC (OSPFv3 \u06CC\u0627 EIGRPv6\u060C \u06CC\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 MP-BGP)\u060C \u0628\u0639\u062F \u0633\u0631\u0648\u06CC\u0633\u200C\u0647\u0627 (DNS \u0628\u0627 AAAA\u060C \u0648\u0628\u200C\u0633\u0631\u0648\u0631 \u0628\u0627 \u0648\u0627\u06CC\u062A\u0628\u0648\u0631\u062F) \u0648 \u062F\u0631 \u0622\u062E\u0631 \u0627\u0645\u0646\u06CC\u062A (ACLv6 \u0648 IPv6 First-Hop Security \u0645\u062B\u0644 RA Guard).","\u06CC\u06A9 \u0646\u06A9\u062A\u0647 \u0639\u0645\u0644\u06CC: \u0686\u0648\u0646 IPv6 \u0628\u0647\u200C\u0637\u0648\u0631 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0631\u0648\u06CC \u0633\u06CC\u0633\u062A\u0645\u200C\u0639\u0627\u0645\u0644\u200C\u0647\u0627 \u0641\u0639\u0627\u0644 \u0627\u0633\u062A\u060C \u0627\u06AF\u0631 \u0631\u0648\u062A\u0631 \u0634\u0645\u0627 RA \u0627\u0634\u062A\u0628\u0627\u0647 \u0628\u062F\u0647\u062F\u060C \u06A9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u062A\u0631\u0627\u0641\u06CC\u06A9\u0634\u0627\u0646 \u0631\u0627 \u0627\u0632 \u0645\u0633\u06CC\u0631 IPv6 (\u06A9\u0647 \u0634\u0627\u06CC\u062F \u0628\u0647 WAN بانک \u0648\u0635\u0644 \u0646\u0628\u0627\u0634\u062F) \u0628\u0641\u0631\u0633\u062A\u0646\u062F \u0648 \u0634\u0628\u06A9\u0647 \xAB\u06A9\u064F\u0646\u062F\xBB \u0634\u0648\u062F. \u0627\u06CC\u0646 \u06CC\u06A9\u06CC \u0627\u0632 \u0631\u0627\u06CC\u062C\u200C\u062A\u0631\u06CC\u0646 \u062F\u0631\u062F\u0633\u0631\u0647\u0627\u06CC \u0645\u0647\u0627\u062C\u0631\u062A \u0627\u0633\u062A."]}],analogy:"IPv6 \u0645\u062B\u0644 \u0634\u0645\u0627\u0631\u0647 \u062A\u0644\u0641\u0646 \u0628\u0627 \u06A9\u062F \u06A9\u0634\u0648\u0631 \u0637\u0648\u0644\u0627\u0646\u06CC \u0627\u0633\u062A: \u06A9\u0634\u0648\u0631 (\u067E\u06CC\u0634\u0648\u0646\u062F /48)\u060C \u0634\u0647\u0631 (\u0634\u0628\u06A9\u0647 /64) \u0648 \u0634\u0645\u0627\u0631\u0647 \u062F\u0627\u062E\u0644\u06CC (Interface ID). SLAAC \u06CC\u0639\u0646\u06CC \u0634\u0645\u0627 \u062E\u0648\u062F\u062A\u0627\u0646 \u0634\u0645\u0627\u0631\u0647 \u062F\u0627\u062E\u0644\u06CC \u0631\u0627 \u0627\u0646\u062A\u062E\u0627\u0628 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F \u0648 \u0641\u0642\u0637 \u06A9\u062F \u0634\u0647\u0631 \u0631\u0627 \u0627\u0632 \u0645\u062E\u0627\u0628\u0631\u0627\u062A \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC\u062F.",pitfalls:["\u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 /64 \u063A\u06CC\u0631\u0627\u0633\u062A\u0627\u0646\u062F\u0627\u0631\u062F \u062F\u0631 LAN: SLAAC \u06A9\u0627\u0631 \u0646\u0645\u06CC\u200C\u06A9\u0646\u062F \u0648 \u0628\u0639\u0636\u06CC \u062F\u0633\u062A\u06AF\u0627\u0647\u200C\u0647\u0627 \u0622\u062F\u0631\u0633 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F.","\u0641\u0631\u0627\u0645\u0648\u0634 \u06A9\u0631\u062F\u0646 ipv6 unicast-routing \u0631\u0648\u06CC \u0631\u0648\u062A\u0631: \u0647\u06CC\u0686 RA \u0641\u0631\u0633\u062A\u0627\u062F\u0647 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u06A9\u0644\u0627\u06CC\u0646\u062A\u200C\u0647\u0627 \u0622\u062F\u0631\u0633 \u0646\u0645\u06CC\u200C\u06AF\u06CC\u0631\u0646\u062F.","\u0646\u0628\u0648\u062F IPv6 ACL \u062F\u0631 \u0644\u0628\u0647: \u0686\u0648\u0646 IPv6 \u0628\u0647\u200C\u0637\u0648\u0631 \u067E\u06CC\u0634\u200C\u0641\u0631\u0636 \u0641\u0639\u0627\u0644 \u0627\u0633\u062A\u060C \u0633\u06CC\u0627\u0633\u062A\u200C\u0647\u0627\u06CC IPv4 \u0631\u0648\u06CC \u0622\u0646 \u0627\u0639\u0645\u0627\u0644 \u0646\u0645\u06CC\u200C\u0634\u0648\u0646\u062F."],exam:["Link-local \u0647\u0645\u06CC\u0634\u0647 fe80::/10 \u0627\u0633\u062A \u0648 \u0631\u0648\u06CC \u0647\u0631 \u0627\u06CC\u0646\u062A\u0631\u0641\u06CC\u0633 IPv6 \u0641\u0639\u0627\u0644 \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F.","IPv6 broadcast \u0646\u062F\u0627\u0631\u062F\u061B multicast \u062C\u0627\u06CC \u0622\u0646 \u0631\u0627 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u062F.","NDP \u0634\u0627\u0645\u0644 NS/NA (\u0647\u0645\u0633\u0627\u06CC\u0647\u200C\u06CC\u0627\u0628\u06CC)\u060C RS/RA (\u06A9\u0634\u0641 \u0631\u0648\u062A\u0631) \u0648 DAD (\u062A\u0634\u062E\u06CC\u0635 \u0622\u062F\u0631\u0633 \u062A\u06A9\u0631\u0627\u0631\u06CC) \u0627\u0633\u062A."],glossary:[["SLAAC","\u0633\u0627\u062E\u062A \u062E\u0648\u062F\u06A9\u0627\u0631 \u0622\u062F\u0631\u0633 \u0627\u0632 \u067E\u06CC\u0634\u0648\u0646\u062F RA."],["NDP","\u067E\u0631\u0648\u062A\u06A9\u0644 \u06A9\u0634\u0641 \u0647\u0645\u0633\u0627\u06CC\u0647 \u062F\u0631 IPv6."],["RA/RS","\u067E\u06CC\u0627\u0645 \u0631\u0648\u062A\u0631 \u0628\u0631\u0627\u06CC \u0627\u0639\u0644\u0627\u0645 \u067E\u06CC\u0634\u0648\u0646\u062F \u0648 \u062F\u0631\u062E\u0648\u0627\u0633\u062A \u06A9\u0644\u0627\u06CC\u0646\u062A."],["DAD","\u0628\u0631\u0631\u0633\u06CC \u062A\u06A9\u0631\u0627\u0631\u06CC \u0646\u0628\u0648\u062F\u0646 \u0622\u062F\u0631\u0633 \u0642\u0628\u0644 \u0627\u0632 \u0627\u0633\u062A\u0641\u0627\u062F\u0647."]]},subnetting:{prereq:[],related:["static-routing","ipv6","vlan-trunk"],title:"\u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0628\u0646\u062F\u06CC \u0648 VLSM \u2014 \u062A\u0642\u0633\u06CC\u0645 \u06CC\u06A9 \u0634\u0628\u06A9\u0647 \u0628\u0627 \u062D\u0633\u0627\u0628\u200C\u0648\u06A9\u062A\u0627\u0628 \u0633\u0627\u062F\u0647",tagline:"\u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0628\u0646\u062F\u06CC \u062A\u0631\u0633\u0646\u0627\u06A9 \u0646\u06CC\u0633\u062A\u061B \u0641\u0642\u0637 \u0686\u0646\u062F \u062A\u0627 \u062C\u0645\u0639 \u0648 \u062A\u0641\u0631\u06CC\u0642 \u062A\u0648\u0627\u0646 \u062F\u0648 \u0627\u0633\u062A.",minutes:16,goals:["\u0627\u0632 \u06CC\u06A9 \u0634\u0628\u06A9\u0647\u060C \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC\u06CC \u0628\u0627 \u0627\u0646\u062F\u0627\u0632\u0647 \u062F\u0644\u062E\u0648\u0627\u0647 \u0628\u0633\u0627\u0632\u06CC (VLSM)","\u0628\u0631\u0627\u06CC \u0647\u0631 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 \u0622\u062F\u0631\u0633 \u0634\u0628\u06A9\u0647\u060C \u0628\u0631\u062F \u0622\u062F\u0631\u0633\u200C\u0647\u0627\u06CC \u0642\u0627\u0628\u0644 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0648 broadcast \u0631\u0627 \u062D\u0633\u0627\u0628 \u06A9\u0646\u06CC","\u0686\u0646\u062F \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 \u0631\u0627 \u062F\u0631 \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u062E\u0644\u0627\u0635\u0647 (summarize) \u06A9\u0646\u06CC"],sections:[{h:"\u0686\u0631\u0627 \u062A\u0642\u0633\u06CC\u0645 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645\u061F",p:["\u0648\u0642\u062A\u06CC \u0634\u0628\u06A9\u0647 \u0628\u0647 \u062A\u0648 \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u0645\u06CC\u200C\u062F\u0647\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC \u0647\u0645\u0647 \u0631\u0627 \u06CC\u06A9\u062C\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0646\u06CC\u061B \u0648\u0644\u06CC \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0627\u06CC\u0646\u0637\u0648\u0631\u06CC \u0628\u062F \u0627\u0633\u062A. \u0647\u0631 \u0628\u062E\u0634 \u0627\u0632 \u0633\u0627\u0632\u0645\u0627\u0646 \u0627\u0646\u062F\u0627\u0632\u0647 \u062E\u0648\u062F\u0634 \u0631\u0627 \u062F\u0627\u0631\u062F: \u0628\u062E\u0634 \u0641\u0631\u0648\u0634 \u06F5\u06F0 \u062F\u0633\u062A\u06AF\u0627\u0647 \u062F\u0627\u0631\u062F\u060C \u0622\u0632\u0645\u0627\u06CC\u0634\u06AF\u0627\u0647 \u06F6 \u062A\u0627. \u0627\u06AF\u0631 \u0647\u0645\u0647 \u0631\u0627 \u062F\u0631 \u06CC\u06A9 /24 \u0628\u0631\u06CC\u0632\u06CC\u060C \u0647\u0631 \u062F\u0648 \u0645\u0634\u06A9\u0644 \u067E\u06CC\u0634 \u0645\u06CC\u200C\u0622\u06CC\u062F: \u0647\u0645 \u062F\u0627\u0645\u0646\u0647 broadcast \u0628\u0632\u0631\u06AF \u0645\u06CC\u200C\u0634\u0648\u062F\u060C \u0647\u0645 \u0622\u062F\u0631\u0633\u200C\u0647\u0627 \u0647\u062F\u0631 \u0645\u06CC\u200C\u0631\u0648\u0646\u062F.","\u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0628\u0646\u062F\u06CC \u06CC\u0639\u0646\u06CC \u0627\u0632 \u0628\u06CC\u062A\u200C\u0647\u0627\u06CC \u0647\u0627\u0633\u062A \u0642\u0631\u0636 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC \u0648 \u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u06A9\u0648\u0686\u06A9\u200C\u062A\u0631 \u0645\u06CC\u200C\u0633\u0627\u0632\u06CC. \u0647\u0631 \u0628\u06CC\u062A\u06CC \u06A9\u0647 \u0642\u0631\u0636 \u0645\u06CC\u200C\u06AF\u06CC\u0631\u06CC\u060C \u062A\u0639\u062F\u0627\u062F \u0634\u0628\u06A9\u0647\u200C\u0647\u0627 \u0631\u0627 \u062F\u0648 \u0628\u0631\u0627\u0628\u0631 \u0648 \u062A\u0639\u062F\u0627\u062F \u0647\u0627\u0633\u062A \u0647\u0631 \u0634\u0628\u06A9\u0647 \u0631\u0627 \u0646\u0635\u0641 \u0645\u06CC\u200C\u06A9\u0646\u062F."]},{h:"\u062D\u0633\u0627\u0628 \u0633\u0627\u062F\u0647\u200C\u0627\u06CC \u06A9\u0647 \u0647\u0645\u0647 \u0686\u06CC\u0632 \u0631\u0627 \u062D\u0644 \u0645\u06CC\u200C\u06A9\u0646\u062F",p:["\u0628\u0631\u0627\u06CC \u0647\u0631 \u0628\u062E\u0634\u060C \u0627\u0648\u0644 \u062A\u0639\u062F\u0627\u062F \u0647\u0627\u0633\u062A \u0644\u0627\u0632\u0645 \u0631\u0627 \u0645\u0634\u062E\u0635 \u06A9\u0646\u060C \u0628\u0639\u062F \u0646\u0632\u062F\u06CC\u06A9\u200C\u062A\u0631\u06CC\u0646 \u062A\u0648\u0627\u0646 \u062F\u0648 \u0631\u0627 \u067E\u06CC\u062F\u0627 \u06A9\u0646. \u0627\u06AF\u0631 \u0628\u062E\u0634\u06CC \u06F5\u06F0 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u062F\u060C \u06F2 \u0628\u0647 \u062A\u0648\u0627\u0646 \u06F6 \u0645\u06CC\u200C\u0634\u0648\u062F \u06F6\u06F4 \u06A9\u0647 \u06F5\u06F0 \u0631\u0627 \u067E\u0648\u0634\u0634 \u0645\u06CC\u200C\u062F\u0647\u062F\u060C \u067E\u0633 \u06F6 \u0628\u06CC\u062A \u0628\u0631\u0627\u06CC \u0647\u0627\u0633\u062A \u0644\u0627\u0632\u0645 \u0627\u0633\u062A \u0648 \u0645\u0627\u0633\u06A9 /26 \u0645\u06CC\u200C\u0634\u0648\u062F (\u06F3\u06F2 \u0645\u0646\u0647\u0627\u06CC \u06F6). \u0627\u06AF\u0631 \u06F2\u06F0 \u062F\u0633\u062A\u06AF\u0627\u0647 \u0628\u062E\u0648\u0627\u0647\u062F\u060C \u06F2 \u0628\u0647 \u062A\u0648\u0627\u0646 \u06F5 \u0645\u06CC\u200C\u0634\u0648\u062F \u06F3\u06F2\u060C \u067E\u0633 \u0645\u0627\u0633\u06A9 /27.","\u062F\u0631 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0645\u0639\u0645\u0648\u0644 IPv4 \u0628\u0627 \u0637\u0648\u0644 \u067E\u06CC\u0634\u0648\u0646\u062F \u062A\u0627 /30\u060C \u0627\u0648\u0644\u06CC\u0646 \u0622\u062F\u0631\u0633 \u0634\u0646\u0627\u0633\u0647 \u0634\u0628\u06A9\u0647 \u0648 \u0622\u062E\u0631\u06CC\u0646 \u0622\u062F\u0631\u0633 broadcast \u0627\u0633\u062A\u061B \u062A\u0639\u062F\u0627\u062F \u0645\u0639\u0645\u0648\u0644 \u0645\u06CC\u0632\u0628\u0627\u0646 = \u06F2 \u0628\u0647 \u062A\u0648\u0627\u0646 n \u0645\u0646\u0647\u0627\u06CC \u06F2. \u0628\u0631\u0627\u06CC /26 \u0628\u0631\u0627\u0628\u0631 \u06F6\u06F2\u060C \u0628\u0631\u0627\u06CC /27 \u0628\u0631\u0627\u0628\u0631 \u06F3\u06F0 \u0648 \u0628\u0631\u0627\u06CC /28 \u0628\u0631\u0627\u0628\u0631 \u06F1\u06F4 \u0627\u0633\u062A. \u0627\u0633\u062A\u062B\u0646\u0627: \u062F\u0631 \u0644\u06CC\u0646\u06A9 \u0646\u0642\u0637\u0647\u200C\u0628\u0647\u200C\u0646\u0642\u0637\u0647 \u0645\u0637\u0627\u0628\u0642 RFC 3021 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u0627\u0632 \u0647\u0631 \u062F\u0648 \u0622\u062F\u0631\u0633 /31 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u06A9\u0631\u062F\u061B /32 \u06CC\u06A9 \u0645\u0633\u06CC\u0631 \u06CC\u0627 \u0622\u062F\u0631\u0633 \u0645\u0646\u0641\u0631\u062F \u0627\u0633\u062A."],list:["/24 \u2192 \u06F2\u06F5\u06F4 \u0647\u0627\u0633\u062A \xB7 /25 \u2192 \u06F1\u06F2\u06F6 \xB7 /26 \u2192 \u06F6\u06F2 \xB7 /27 \u2192 \u06F3\u06F0 \xB7 /28 \u2192 \u06F1\u06F4 \xB7 /29 \u2192 \u06F6 \xB7 /30 \u2192 \u06F2","\u0622\u062F\u0631\u0633 \u0634\u0628\u06A9\u0647: \u0628\u06CC\u062A\u200C\u0647\u0627\u06CC \u0647\u0627\u0633\u062A \u0647\u0645\u0647 \u0635\u0641\u0631 \xB7 broadcast: \u0628\u06CC\u062A\u200C\u0647\u0627\u06CC \u0647\u0627\u0633\u062A \u0647\u0645\u0647 \u06CC\u06A9","\u0628\u0631\u0627\u06CC \u0644\u06CC\u0646\u06A9 \u0628\u06CC\u0646 \u062F\u0648 \u0631\u0648\u062A\u0631\u060C /30 \u06CC\u0627 /31 (\u062F\u0631 \u062A\u062C\u0647\u06CC\u0632\u0627\u062A \u062C\u062F\u06CC\u062F) \u06A9\u0627\u0641\u06CC \u0627\u0633\u062A"]},{h:"VLSM: \u0628\u0647 \u0647\u0631 \u0628\u062E\u0634 \u0641\u0642\u0637 \u0627\u0646\u062F\u0627\u0632\u0647 \u062E\u0648\u062F\u0634",p:["VLSM \u06CC\u0639\u0646\u06CC \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0647\u0627\u06CC \u0628\u0627 \u0645\u0627\u0633\u06A9 \u0645\u062A\u0641\u0627\u0648\u062A. \u0642\u0627\u0639\u062F\u0647 \u06A9\u0627\u0631: \u0627\u0632 \u0628\u0632\u0631\u06AF\u200C\u062A\u0631\u06CC\u0646 \u0628\u062E\u0634 \u0634\u0631\u0648\u0639 \u06A9\u0646\u060C \u0627\u0648\u0644 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 \u0628\u0632\u0631\u06AF\u200C\u062A\u0631 \u0631\u0627 \u0628\u062F\u0647\u060C \u0648 \u0628\u0647 \u062A\u0631\u062A\u06CC\u0628 \u06A9\u0648\u0686\u06A9\u200C\u062A\u0631\u0647\u0627 \u0631\u0627 \u062F\u0631 \u0641\u0636\u0627\u0647\u0627\u06CC \u0628\u0627\u0642\u06CC\u200C\u0645\u0627\u0646\u062F\u0647 \u0628\u0686\u06CC\u0646. \u0627\u06AF\u0631 \u0628\u0631\u0639\u06A9\u0633 \u0634\u0631\u0648\u0639 \u06A9\u0646\u06CC\u060C \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0641\u0636\u0627 \u062A\u06A9\u0647\u200C\u062A\u06A9\u0647 \u0634\u0648\u062F \u0648 \u0628\u062E\u0634 \u0628\u0632\u0631\u06AF \u062C\u0627 \u0646\u0634\u0648\u062F.","\u0645\u062B\u0627\u0644: \u0627\u0632 192.168.10.0/24 \u0634\u0631\u0648\u0639 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u0645. \u0641\u0631\u0648\u0634 \u06F5\u06F0 \u0647\u0627\u0633\u062A \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u062F \u2192 192.168.10.0/26 (\u0628\u0631\u062F \u06F1 \u062A\u0627 \u06F6\u06F2). \u0628\u0639\u062F \u0622\u0632\u0645\u0627\u06CC\u0634\u06AF\u0627\u0647 \u06F2\u06F0 \u0647\u0627\u0633\u062A \u2192 192.168.10.64/27 (\u0628\u0631\u062F \u06F6\u06F5 \u062A\u0627 \u06F9\u06F4). \u0628\u0639\u062F \u0644\u06CC\u0646\u06A9 \u0631\u0648\u062A\u0631\u0647\u0627 \u06F2 \u0647\u0627\u0633\u062A \u2192 192.168.10.96/30 (\u0628\u0631\u062F \u06F9\u06F7 \u0648 \u06F9\u06F8). \u0628\u0627\u0642\u06CC \u0641\u0636\u0627 \u0628\u0631\u0627\u06CC \u0628\u062E\u0634\u200C\u0647\u0627\u06CC \u0622\u06CC\u0646\u062F\u0647."],callout:{title:"\u0642\u0627\u0639\u062F\u0647 \u0637\u0644\u0627\u06CC\u06CC",text:"\u0647\u0645\u06CC\u0634\u0647 \u0627\u0632 \u0628\u0632\u0631\u06AF \u0628\u0647 \u06A9\u0648\u0686\u06A9. \u0648 \u0628\u0639\u062F \u0627\u0632 \u0647\u0631 \u0627\u062E\u062A\u0635\u0627\u0635\u060C \u062D\u062A\u0645\u0627\u064B \u0622\u062F\u0631\u0633 \u0634\u0628\u06A9\u0647 \u0628\u0639\u062F\u06CC \u0631\u0627 \u062F\u0631\u0633\u062A \u062D\u0633\u0627\u0628 \u06A9\u0646 (\u0627\u0648\u0644\u06CC\u0646 \u0622\u062F\u0631\u0633 \u0628\u0644\u0648\u06A9 \u0628\u0639\u062F\u06CC = \u0622\u062E\u0631\u06CC\u0646 \u0622\u062F\u0631\u0633 \u0628\u0644\u0648\u06A9 \u0642\u0628\u0644\u06CC + \u06F1)."}},{h:"\u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC (Summarization)",p:["\u0648\u0642\u062A\u06CC \u0686\u0646\u062F \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 \u067E\u0634\u062A \u06CC\u06A9 \u0631\u0648\u062A\u0631 \u0647\u0633\u062A\u0646\u062F\u060C \u0644\u0627\u0632\u0645 \u0646\u06CC\u0633\u062A \u0647\u0645\u0647 \u0631\u0627 \u062C\u062F\u0627 \u0627\u0639\u0644\u0627\u0645 \u06A9\u0646\u06CC. \u0627\u06AF\u0631 \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627 \u067E\u0634\u062A \u0633\u0631 \u0647\u0645 \u0628\u0627\u0634\u0646\u062F\u060C \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC \u0622\u0646\u200C\u0647\u0627 \u0631\u0627 \u062F\u0631 \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631 \u062C\u0645\u0639 \u06A9\u0646\u06CC. \u0645\u062B\u0627\u0644: 10.1.0.0/24 \u062A\u0627 10.1.3.0/24 (\u0686\u0647\u0627\u0631 /24 \u067E\u06CC\u0648\u0633\u062A\u0647) \u0631\u0627 \u0645\u06CC\u200C\u0634\u0648\u062F 10.1.0.0/22 \u062E\u0644\u0627\u0635\u0647 \u06A9\u0631\u062F.","\u0631\u0648\u0634 \u0633\u0631\u06CC\u0639: \u0639\u062F\u062F \u0633\u0648\u0645 \u0631\u0627 \u062F\u0631 \u0628\u0627\u06CC\u0646\u0631\u06CC \u0628\u0646\u0648\u06CC\u0633\u061B \u0628\u0628\u06CC\u0646 \u0686\u0646\u062F \u0628\u06CC\u062A \u0645\u0634\u062A\u0631\u06A9 \u0627\u0633\u062A. \u0622\u0646 \u0628\u06CC\u062A\u200C\u0647\u0627 \u0631\u0627 \u0646\u06AF\u0647 \u062F\u0627\u0631 \u0648 \u0628\u0642\u06CC\u0647 \u0631\u0627 \u0635\u0641\u0631 \u06A9\u0646. \u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC \u0647\u0645 \u0627\u0646\u062F\u0627\u0632\u0647 \u062C\u062F\u0648\u0644 \u0645\u0633\u06CC\u0631 \u0631\u0627 \u06A9\u0645 \u0645\u06CC\u200C\u06A9\u0646\u062F\u060C \u0647\u0645 \u067E\u0627\u06CC\u062F\u0627\u0631\u06CC \u0634\u0628\u06A9\u0647 \u0631\u0627 \u0628\u0627\u0644\u0627 \u0645\u06CC\u200C\u0628\u0631\u062F (\u0627\u06AF\u0631 \u06CC\u06A9 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 flapping \u0634\u0648\u062F\u060C \u062E\u0644\u0627\u0635\u0647 \u067E\u0627\u06CC\u062F\u0627\u0631 \u0645\u06CC\u200C\u0645\u0627\u0646\u062F)."]}],analogy:"\u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u200C\u0628\u0646\u062F\u06CC \u0645\u062B\u0644 \u062A\u0642\u0633\u06CC\u0645 \u06CC\u06A9 \u0632\u0645\u06CC\u0646 \u0628\u0632\u0631\u06AF \u0628\u0647 \u0642\u0637\u0639\u0647\u200C\u0647\u0627\u06CC \u06A9\u0648\u0686\u06A9 \u0628\u0631 \u0627\u0633\u0627\u0633 \u0646\u06CC\u0627\u0632 \u0647\u0631 \u062E\u0627\u0646\u0648\u0627\u062F\u0647 \u0627\u0633\u062A. VLSM \u0647\u0645 \u0627\u06CC\u0646 \u0627\u0633\u062A \u06A9\u0647 \u0628\u0647 \u062E\u0627\u0646\u0648\u0627\u062F\u0647 \u067E\u0631\u062C\u0645\u0639\u06CC\u062A \u0632\u0645\u06CC\u0646 \u0628\u0632\u0631\u06AF\u200C\u062A\u0631 \u0628\u062F\u0647\u06CC \u0648 \u0628\u0647 \u0645\u062C\u0631\u062F \u0632\u0645\u06CC\u0646 \u06A9\u0648\u0686\u06A9 \u2014 \u0646\u0647 \u0627\u06CC\u0646\u06A9\u0647 \u0647\u0645\u0647 \u0631\u0627 \u0645\u0633\u0627\u0648\u06CC \u062A\u0642\u0633\u06CC\u0645 \u06A9\u0646\u06CC \u0648 \u0646\u0635\u0641 \u0632\u0645\u06CC\u0646\u200C\u0647\u0627 \u062E\u0627\u0644\u06CC \u0628\u0645\u0627\u0646\u062F.",pitfalls:["\u0641\u0631\u0627\u0645\u0648\u0634 \u06A9\u0631\u062F\u0646 \u062F\u0648 \u0622\u062F\u0631\u0633 \u0631\u0632\u0631\u0648 (\u0634\u0628\u06A9\u0647 \u0648 broadcast) \u0648 \u06A9\u0645 \u0622\u0645\u062F\u0646 \u06CC\u06A9 \u06CC\u0627 \u062F\u0648 \u0622\u062F\u0631\u0633.","\u0634\u0631\u0648\u0639 \u0627\u0632 \u06A9\u0648\u0686\u06A9 \u0628\u0647 \u0628\u0632\u0631\u06AF \u062F\u0631 VLSM: \u0641\u0636\u0627 \u062A\u06A9\u0647\u200C\u062A\u06A9\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648 \u0628\u062E\u0634 \u0628\u0632\u0631\u06AF \u062C\u0627 \u0646\u0645\u06CC\u200C\u0634\u0648\u062F.","\u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC \u0631\u0648\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627\u06CC \u063A\u06CC\u0631\u067E\u06CC\u0648\u0633\u062A\u0647: \u062E\u0644\u0627\u0635\u0647 \u0641\u0639\u0627\u0644 \u0646\u062A\u06CC\u062C\u0647\u200C\u0627\u0634 \u0627\u0639\u0644\u0627\u0645 \u0645\u0633\u06CC\u0631\u0647\u0627\u06CC\u06CC \u0627\u0633\u062A \u06A9\u0647 \u0648\u062C\u0648\u062F \u0646\u062F\u0627\u0631\u0646\u062F."],exam:["/26 = \u06F6\u06F2 \u0647\u0627\u0633\u062A\u060C /27 = \u06F3\u06F0\u060C /28 = \u06F1\u06F4\u060C /30 = \u06F2.","\u0628\u0644\u0648\u06A9 \u0647\u0631 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647 = \u06F2 \u0628\u0647 \u062A\u0648\u0627\u0646 (\u06F3\u06F2 \u0645\u0646\u0647\u0627\u06CC \u0637\u0648\u0644 \u067E\u06CC\u0634\u0648\u0646\u062F).","\u062E\u0644\u0627\u0635\u0647\u200C\u0633\u0627\u0632\u06CC \u0641\u0642\u0637 \u0631\u0648\u06CC \u067E\u06CC\u0634\u0648\u0646\u062F\u0647\u0627\u06CC \u067E\u06CC\u0648\u0633\u062A\u0647 \u0645\u0639\u0646\u06CC \u062F\u0627\u0631\u062F."],glossary:[["VLSM","\u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 \u0645\u0627\u0633\u06A9\u200C\u0647\u0627\u06CC \u0645\u062A\u0641\u0627\u0648\u062A \u062F\u0631 \u06CC\u06A9 \u0634\u0628\u06A9\u0647."],["Block size","\u0627\u0646\u062F\u0627\u0632\u0647 \u0647\u0631 \u0632\u06CC\u0631\u0634\u0628\u06A9\u0647\u061B \u0645\u0628\u0646\u0627\u06CC \u0645\u062D\u0627\u0633\u0628\u0647 \u0633\u0631\u06CC\u0639."],["Summarization","\u062C\u0645\u0639 \u06A9\u0631\u062F\u0646 \u0686\u0646\u062F \u067E\u06CC\u0634\u0648\u0646\u062F \u062F\u0631 \u06CC\u06A9 \u0622\u062F\u0631\u0633 \u06A9\u0648\u062A\u0627\u0647\u200C\u062A\u0631."],["CIDR","\u0646\u0645\u0627\u06CC\u0634 \u0622\u062F\u0631\u0633 \u0628\u0627 \u0637\u0648\u0644 \u067E\u06CC\u0634\u0648\u0646\u062F\u060C \u0645\u062B\u0644 /26."]]},"l2-discovery":{prereq:["vlan-trunk"],related:["stp-rstp","l2-security"],title:"CDP\u060C LLDP \u0648 VTP \u2014 \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06CC \u0633\u0627\u062F\u0647 \u0644\u0627\u06CC\u0647 \u06F2",tagline:"\u062F\u0648 \u062A\u0627 \u0627\u0632 \u0627\u06CC\u0646\u200C\u0647\u0627 \u0628\u0647\u062A\u0631\u06CC\u0646 \u062F\u0648