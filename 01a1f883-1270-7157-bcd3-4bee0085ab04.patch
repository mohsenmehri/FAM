+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+BUNDLE_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
+# shellcheck source=lib.sh
+source "$BUNDLE_DIR/lib.sh"
+
+academy_resolve_root "${1:-}"
+academy_preflight
+umask 077
+
+STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
+BACKUP_ID="fam-academy-157682a-${STAMP}-$$"
+BACKUP_DIR="$ROOT/data/backups/$BACKUP_ID"
+CONTAINER_BACKUP="/data/backups/$BACKUP_ID"
+DB_BACKUP="$CONTAINER_BACKUP/fam.sqlite3"
+[[ ! -e "$BACKUP_DIR" ]] || academy_fail "Unique backup directory already exists: $BACKUP_DIR"
+mkdir -p -m 0700 -- "$ROOT/data/backups"
+[[ ! -L "$ROOT/data/backups" ]] || academy_fail 'data/backups must not be a symlink.'
+mkdir -m 0700 -- "$BACKUP_DIR"
+chmod 0700 "$BACKUP_DIR"
+
+printf 'Creating a FAM-validated SQLite backup before touching Academy files…\n'
+if ! academy_compose exec -T app python /app/server/manage.py backup \
+  --db "$DB_PATH" --output "$DB_BACKUP" >/dev/null 2>&1; then
+  academy_fail "Database backup/validation failed. No project file was copied. Inspect the local DB/permissions; backup workspace: $BACKUP_DIR"
+fi
+[[ -f "$ROOT/data/backups/$BACKUP_ID/fam.sqlite3" ]] ||
+  academy_fail "manage.py reported no usable backup. No project file was copied; backup workspace: $BACKUP_DIR"
+chmod 0600 "$ROOT/data/backups/$BACKUP_ID/fam.sqlite3"
+# Read the resulting backup again with the same FAM validator. The second
+# temporary copy is removed only after it passes and is our write/read check.
+if ! academy_compose exec -T app python /app/server/manage.py backup \
+  --db "$DB_BACKUP" --output "$CONTAINER_BACKUP/.verify.sqlite3" >/dev/null 2>&1; then
+  academy_fail "The new database backup failed independent re-validation. No project file was copied; backup workspace: $BACKUP_DIR"
+fi
+academy_compose exec -T app python -c \
+  'import os,sys; p=sys.argv[1]; assert os.path.isfile(p) and os.path.getsize(p)>0' \
+  "$CONTAINER_BACKUP/.verify.sqlite3" >/dev/null 2>&1 ||
+  academy_fail "The backup verification copy could not be read. No project file was copied; backup workspace: $BACKUP_DIR"
+academy_compose exec -T app python -c \
+  'import os,sys; os.unlink(sys.argv[1])' "$CONTAINER_BACKUP/.verify.sqlite3" >/dev/null 2>&1 ||
+  academy_fail "Could not remove the temporary verification file created by this installer; no project file was copied: $BACKUP_DIR"
+
+printf 'Creating a separately restricted copy of current settings and certificates…\n'
+if ! tar -czpf "$BACKUP_DIR/config-certs.tar.gz" -C "$ROOT" -- \
+  .env Dockerfile docker-compose.yml nginx.conf certs >/dev/null 2>&1; then
+  academy_fail "Settings/certificate archive could not be created. No project file was copied; backup workspace: $BACKUP_DIR"
+fi
+chmod 0600 "$BACKUP_DIR/config-certs.tar.gz"
+CHECK_DIR="$(mktemp -d)"
+(
+  cd "$ROOT"
+  find .env Dockerfile docker-compose.yml nginx.conf certs -printf '%p\n' | LC_ALL=C sort
+) > "$CHECK_DIR/config-expected"
+tar -tzf "$BACKUP_DIR/config-certs.tar.gz" | sed 's#^\./##; s#/$##' | awk 'NF' | LC_ALL=C sort -u > "$CHECK_DIR/config-actual"
+if ! cmp -s "$CHECK_DIR/config-expected" "$CHECK_DIR/config-actual"; then
+  rm -rf -- "$CHECK_DIR"
+  academy_fail "Settings/certificate archive file list is incomplete or unexpected. No project file was copied; backup workspace: $BACKUP_DIR"
+fi
+if ! academy_verify_archive "$BACKUP_DIR/config-certs.tar.gz" "$ROOT" "$CHECK_DIR"; then
+  rm -rf -- "$CHECK_DIR"
+  academy_fail "Settings/certificate archive did not compare byte-for-byte with its sources. No project file was copied; backup workspace: $BACKUP_DIR"
+fi
+rm -rf -- "$CHECK_DIR"
+
+: > "$BACKUP_DIR/target-files.list"
+: > "$BACKUP_DIR/ROLLBACK.tsv"
+while read -r new_sha relative; do
+  target="$ROOT/$relative"
+  if [[ -f "$target" ]]; then
+    old_sha="$(academy_sha "$target")"
+    old_mode="$(stat -c '%a' "$target")"
+    old_uid="$(stat -c '%u' "$target")"
+    old_gid="$(stat -c '%g' "$target")"
+    printf '%s\t1\t%s\t%s\t%s\t%s\t%s\n' \
+      "$relative" "$old_sha" "$new_sha" "$old_mode" "$old_uid" "$old_gid" >> "$BACKUP_DIR/ROLLBACK.tsv"
+    printf '%s\n' "$relative" >> "$BACKUP_DIR/target-files.list"
+  else
+    printf '%s\t0\t-\t%s\t-\t-\t-\n' "$relative" "$new_sha" >> "$BACKUP_DIR/ROLLBACK.tsv"
+  fi
+done < "$BUNDLE_DIR/payload.sha256"
+chmod 0600 "$BACKUP_DIR/ROLLBACK.tsv" "$BACKUP_DIR/target-files.list"
+if [[ -s "$BACKUP_DIR/target-files.list" ]]; then
+  if ! tar -czpf "$BACKUP_DIR/target-files.tar.gz" -C "$ROOT" \
+    -T "$BACKUP_DIR/target-files.list" >/dev/null 2>&1; then
+    academy_fail "Existing Academy target files could not be backed up. No project file was copied; backup workspace: $BACKUP_DIR"
+  fi
+else
+  tar -czf "$BACKUP_DIR/target-files.tar.gz" --files-from /dev/null
+fi
+chmod 0600 "$BACKUP_DIR/target-files.tar.gz"
+CHECK_DIR="$(mktemp -d)"
+LC_ALL=C sort -u "$BACKUP_DIR/target-files.list" > "$CHECK_DIR/target-expected"
+tar -tzf "$BACKUP_DIR/target-files.tar.gz" | sed 's#^\./##; s#/$##' | awk 'NF' | LC_ALL=C sort -u > "$CHECK_DIR/target-actual"
+if ! cmp -s "$CHECK_DIR/target-expected" "$CHECK_DIR/target-actual"; then
+  rm -rf -- "$CHECK_DIR"
+  academy_fail "Existing Academy file backup is incomplete or has unexpected paths. No project file was copied; backup workspace: $BACKUP_DIR"
+fi
+if ! academy_verify_archive "$BACKUP_DIR/target-files.tar.gz" "$ROOT" "$CHECK_DIR"; then
+  rm -rf -- "$CHECK_DIR"
+  academy_fail "Academy target-file archive did not compare byte-for-byte with its sources. No project file was copied; backup workspace: $BACKUP_DIR"
+fi
