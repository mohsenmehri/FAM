+.lesson-layer strong,.lesson-case strong{color:var(--c-brand)}
+.lesson-command{margin:10px 0;padding:10px;border:1px solid var(--c-border);border-radius:var(--r-sm);background:var(--c-surface-2)}
+.lesson-command .cli-block,.lesson-config .cli-block{margin:6px 0;padding:10px;max-width:100%;overflow:auto;white-space:pre}
+.lesson-topology{max-width:100%;overflow-x:auto;margin:10px 0}
