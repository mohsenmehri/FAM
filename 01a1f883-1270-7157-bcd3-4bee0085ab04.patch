+
+def fail(message: str) -> None:
+    raise SystemExit(message)
+
+
+def sha256(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def normalize_title(value: str) -> str:
+    return re.sub(r'[\s\u200c\u200d\u200f]+', ' ', value.replace('ي', 'ی').replace('ى', 'ی').replace('ك', 'ک')).strip()
+
+
+def first_heading(path: Path) -> str:
+    for line in path.read_text(encoding='utf-8').splitlines():
+        match = HEADING_RE.match(line)
+        if match and len(match.group(1)) == 1:
+            return match.group(2).strip()
+    fail(f'No top-level Markdown title: {path.name}')
+
+
+def scan_headings(text: str) -> list[dict[str, object]]:
+    result: list[dict[str, object]] = []
+    fence_char = ''
+    fence_len = 0
+    for line_no, line in enumerate(text.splitlines(), 1):
+        fence = FENCE_RE.match(line)
+        if fence:
+            marker = fence.group(1)
+            if not fence_char:
+                fence_char, fence_len = marker[0], len(marker)
+            elif marker[0] == fence_char and len(marker) >= fence_len and not fence.group(2).strip():
+                fence_char, fence_len = '', 0
+            continue
+        if fence_char:
+            continue
+        heading = HEADING_RE.match(line)
+        if heading:
+            result.append({
+                'line': line_no,
+                'level': len(heading.group(1)),
+                'raw': line.strip(),
+                'title': heading.group(2).strip(),
+                'anchor': f'heading-{len(result) + 1}',
+            })
+    return result
+
+
+def outside_fence_lines(text: str):
+    fence_char = ''
+    fence_len = 0
+    for line_no, line in enumerate(text.splitlines(), 1):
+        fence = FENCE_RE.match(line)
+        if fence:
+            marker = fence.group(1)
+            if not fence_char:
+                fence_char, fence_len = marker[0], len(marker)
+            elif marker[0] == fence_char and len(marker) >= fence_len and not fence.group(2).strip():
+                fence_char, fence_len = '', 0
+            continue
+        if not fence_char:
+            yield line_no, line
+
