# Python / bytecode / virtualenvs / test caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Environment files & private key material
.env
.env.*
!.env.example
*.key
*.crt
*.pem
*.p12
*.pfx
01-خام-پروژه/certs/
02-فایل-های-اجرایی/certs/

# Runtime SQLite databases, WAL temp files, known_hosts & backups
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
backups/
01-خام-پروژه/data/
02-فایل-های-اجرایی/data/

# Large offline Docker image bundles & generated delivery manifest
*.tar
*.tar.gz
02-فایل-های-اجرایی/MANIFEST.sha256

# Duplicated static web directory in delivery skeleton (canonical copy lives in 01-خام-پروژه/server/www)
02-فایل-های-اجرایی/server/
